// void * Type_CrdInfo_Read(struct _cms_typehandler_struct *, cmsIOHANDLER *, cmsUInt32Number *, cmsUInt32Number)

// Helper function to create a dummy cmsHPROFILE.
static cmsHPROFILE create_dummy_profile() {
  cmsHPROFILE hProfile = cmsCreateProfilePlaceholder(NULL);
  if (hProfile) {
    cmsSetPCS(hProfile, cmsSigLabData);
    cmsSetColorSpace(hProfile, cmsSigRgbData);
    cmsSetDeviceClass(hProfile, cmsSigDisplayClass);
  }
  return hProfile;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 2) {
    return 0;
  }

  cmsContext null_ctx = NULL;
  cmsHPROFILE hProfile = create_dummy_profile();
  if (!hProfile) {
    return 0;
  }

  // Fuzz _cmsDefaultICCintents
  cmsUInt32Number intents[1];
  cmsHPROFILE profiles[1];
  cmsBool BPC[1];
  cmsFloat64Number adaptation_states[1];
  intents[0] = data[0] % 4;
  profiles[0] = hProfile;
  BPC[0] = data[1] % 2;
  adaptation_states[0] = (double)data[0] / 255.0;
  cmsPipeline *pipeline = _cmsDefaultICCintents(null_ctx, 1, intents, profiles, BPC, adaptation_states, 0);
  if (pipeline) {
    cmsPipelineFree(pipeline);
  }

  // Fuzz Type_UcrBg_Read
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(null_ctx, (void *)data, size, "r");
  if (io) {
    cmsUInt32Number nItems;
    void *ucrbg = Type_UcrBg_Read(NULL, io, &nItems, size);
    if (ucrbg) {
      // The Type_UcrBg_Free function is not exported, so we have to
      // free the members manually based on the implementation of Type_UcrBg_Read
      cmsUcrBg *u = (cmsUcrBg *)ucrbg;
      if (u->Ucr) {
        cmsFreeToneCurve(u->Ucr);
      }
      if (u->Bg) {
        cmsFreeToneCurve(u->Bg);
      }
      if (u->Desc) {
        cmsMLUfree(u->Desc);
      }
      _cmsFree(null_ctx, ucrbg);
    }
    cmsCloseIOhandler(io);
  }

  // Fuzz Type_vcgt_Read
  io = cmsOpenIOhandlerFromMem(null_ctx, (void *)data, size, "r");
  if (io) {
    cmsUInt32Number nItems;
    void *vcgt = Type_vcgt_Read(NULL, io, &nItems, size);
    if (vcgt) {
      // The Type_vcgt_Free function is not exported, so we have to
      // free the members manually based on the implementation of Type_vcgt_Read
      cmsVideoCardGammaTable *v = (cmsVideoCardGammaTable *)vcgt;
      if (v->GammaRed)
        cmsFreeToneCurve(v->GammaRed);
      if (v->GammaGreen)
        cmsFreeToneCurve(v->GammaGreen);
      if (v->GammaBlue)
        cmsFreeToneCurve(v->GammaBlue);
      _cmsFree(null_ctx, vcgt);
    }
    cmsCloseIOhandler(io);
  }

  // Fuzz Type_ProfileSequenceDesc_Read
  io = cmsOpenIOhandlerFromMem(null_ctx, (void *)data, size, "r");
  if (io) {
    cmsUInt32Number nItems;
    void *seq = Type_ProfileSequenceDesc_Read(NULL, io, &nItems, size);
    if (seq) {
      cmsFreeProfileSequenceDescription(seq);
    }
    cmsCloseIOhandler(io);
  }

  // Fuzz Type_CrdInfo_Read
  io = cmsOpenIOhandlerFromMem(null_ctx, (void *)data, size, "r");
  if (io) {
    cmsUInt32Number nItems;
    void *crd_info = Type_CrdInfo_Read(NULL, io, &nItems, size);
    if (crd_info) {
      // The Type_CrdInfo_Free function is not exported, so we have to
      // free the members manually based on the implementation of Type_CrdInfo_Read
      cmsMLU *mlu = (cmsMLU *)crd_info;
      cmsMLUfree(mlu);
    }
    cmsCloseIOhandler(io);
  }

  cmsCloseProfile(hProfile);
  return 0;
}[0m
