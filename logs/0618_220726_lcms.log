  gamma1 = cmsBuildGamma(context, gamma1_val);
  gamma2 = cmsBuildGamma(context, gamma2_val);
  if (!gamma1 || !gamma2) {
    goto cleanup;
  }

  // Consume data for the number of points for joining curves.
  const uint8_t *points_data = consume_data(&data, &size, sizeof(uint32_t));
  if (!points_data) {
