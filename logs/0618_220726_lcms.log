          cmsHPROFILE hProfile = cmsCreateDeviceLinkFromCubeFile(profile_filename);
          if (hProfile) {
              cmsMD5computeID(hProfile);
              cmsCloseProfile(hProfile);
          }
      }
      remove(profile_filename);
  }

  // --- Fuzz memory and stream functions in a separate block ---
  {
      // Create a standard, known-good profile to test memory/stream functions
      cmsHPROFILE h = cmsCreate_sRGBProfile();
      if (h) {
          cmsUInt32Number profileSize = 0;
          if (cmsSaveProfileToMem(h, NULL, &profileSize)) {
              void *memProfile = malloc(profileSize);
              if (memProfile) {
                  if (cmsSaveProfileToMem(h, memProfile, &profileSize)) {
                      cmsHPROFILE hMemProfile = cmsOpenProfileFromMem(memProfile, profileSize);
                      if (hMemProfile) {
                          char out_filename[L_tmpnam];
                          if (tmpnam(out_filename) != NULL) {
                              FILE *f_out = fopen(out_filename, "wb");
                              if (f_out) {
                                  cmsSaveProfileToStream(hMemProfile, f_out);
                                  fclose(f_out);
                              }
                              remove(out_filename);
                          }
                          cmsCloseProfile(hMemProfile);
                      }
                  }
                  free(memProfile);
              }
          }
          cmsCloseProfile(h);
      }
  }

  // --- Fuzz IT8 functions in a separate, isolated block ---
  char it8_filename[L_tmpnam];
  if (tmpnam(it8_filename) != NULL) {
      if (create_temp_file(it8_filename, data, size)) {
          cmsHANDLE hIT8 = cmsIT8LoadFromFile(NULL, it8_filename);
