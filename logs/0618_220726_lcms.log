      patch_name[128] = '\0';

      memcpy(sample_name, data + 128, 128);
      sample_name[128] = '\0';

      memcpy(&val, data + 256, sizeof(double));

      cmsIT8SetDataDbl(hIT8, patch_name, sample_name, val);
    }

    // Call cmsIT8GetSheetType to exercise sheet type retrieval.
    cmsIT8GetSheetType(hIT8);

    // Added call to cmsIT8SaveToMem to improve coverage.
    // First call with NULL to get the required buffer size.
    cmsUInt32Number bytes_needed = 0;
    cmsIT8SaveToMem(hIT8, NULL, &bytes_needed);
    if (bytes_needed > 0) {
      // Allocate memory for the buffer and call the function again.
      void *mem = malloc(bytes_needed);
      if (mem) {
        cmsIT8SaveToMem(hIT8, mem, &bytes_needed);
        // Free the allocated memory to prevent leaks.
        free(mem);
      }
    }

    // Free the IT8 handle to prevent memory leaks.
    cmsIT8Free(hIT8);
  }

  // Clean up the context to prevent memory leaks.
  cmsDeleteContext(context);
  return 0;
