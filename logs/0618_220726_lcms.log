// Helper function to create a dummy type handler
static cmsTagTypeHandler *CreateDummyTagTypeHandler(cmsContext ContextID) {
  cmsTagTypeHandler *handler =
      (cmsTagTypeHandler *)_cmsMalloc(ContextID, sizeof(cmsTagTypeHandler));
  if (handler == NULL) {
    return NULL;
  }
  memset(handler, 0, sizeof(cmsTagTypeHandler));
  handler->ContextID = ContextID;
  return handler;
}

// Fuzz target for lcms
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 4) {
    return 0;
  }

  // Create a context
  cmsContext context = cmsCreateContext(NULL, NULL);
  if (context == NULL) {
    return 0;
  }

  // Create a memory-based IO handler
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(context, (void *)data, size, "r");
  if (io == NULL) {
    cmsDeleteContext(context);
    return 0;
  }

  // Create a dummy type handler
  cmsTagTypeHandler *handler = CreateDummyTagTypeHandler(context);
  if (handler == NULL) {
    cmsCloseIOhandler(io);
    cmsDeleteContext(context);
    return 0;
  }

  // Fuzz ReadSegmentedCurve
  cmsToneCurve *curve = ReadSegmentedCurve((struct _cms_typehandler_struct *)handler, io);
  if (curve != NULL) {
    cmsFreeToneCurve(curve);
  }

  // Fuzz Type_LUT8_Write and Type_LUT8_Dup
  cmsPipeline *lut = cmsPipelineAlloc(context, 3, 3);
  if (lut != NULL) {
    cmsIOHANDLER *write_io = cmsOpenIOhandlerFromNULL(context);
    if (write_io != NULL) {
      Type_LUT8_Write((struct _cms_typehandler_struct *)handler, write_io, lut, 1);
      cmsCloseIOhandler(write_io);
    }

    void *lut2 = Type_LUT8_Dup((struct _cms_typehandler_struct *)handler, lut, 1);
    if (lut2 != NULL) {
      cmsPipelineFree((cmsPipeline *)lut2);
    }
    cmsPipelineFree(lut);
  }

  // Fuzz ReadMPECurve and WriteMPECurve
  cmsStage *mpe = cmsStageAllocIdentity(context, 3);
  if (mpe != NULL) {
    cmsIOHANDLER *mpe_io = cmsOpenIOhandlerFromNULL(context);
    if (mpe_io != NULL) {
      ReadMPECurve((struct _cms_typehandler_struct *)handler, mpe_io, mpe, 1, 3);
      WriteMPECurve((struct _cms_typehandler_struct *)handler, mpe_io, mpe, 1, 3);
      cmsCloseIOhandler(mpe_io);
    }
    cmsStageFree(mpe);
  }

  // Clean up
  cmsCloseIOhandler(io);
  _cmsFree(context, handler);
  cmsDeleteContext(context);

  return 0;
}[0m
