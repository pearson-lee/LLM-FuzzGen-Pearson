      // Set data in the IT8 handle using fuzzed keys and value.
      cmsIT8SetData(it8, key1, key2, value);
      // Added call to cmsIT8SetDataDbl to improve coverage.
      const uint8_t *dbl_data = consume_data(&data, &size, sizeof(double));
      if (dbl_data) {
