// Fuzzer entry point.
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 2) {
    return 0;
  }

  cmsContext context = cmsCreateContext(NULL, NULL);
  if (context == NULL) {
    return 0;
  }

  // Create a memory-based IO handler to read fuzzer data.
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(context, (void *)data, size, "r");
  if (io == NULL) {
    cmsDeleteContext(context);
    return 0;
  }

  // Read some values from the fuzzer input.
  cmsUInt32Number numProfiles, intents[256], dwFlags;
  cmsBool bpc[256];
  cmsFloat64Number adaptationStates[256];

  if (!_cmsReadUInt32Number(io, &numProfiles)) {
    cmsCloseIOhandler(io);
    cmsDeleteContext(context);
    return 0;
  }
  numProfiles %= 256; // Limit number of profiles to avoid excessive memory usage.

  for (int i = 0; i < numProfiles; i++) {
    if (!_cmsReadUInt32Number(io, &intents[i])) {
      cmsCloseIOhandler(io);
      cmsDeleteContext(context);
      return 0;
    }
    if (!io->Read(io, &bpc[i], sizeof(cmsBool), 1)) {
      cmsCloseIOhandler(io);
      cmsDeleteContext(context);
      return 0;
    }
    if (!_cmsReadFloat64Number(io, &adaptationStates[i])) {
      cmsCloseIOhandler(io);
      cmsDeleteContext(context);
      return 0;
    }
  }

  if (!_cmsReadUInt32Number(io, &dwFlags)) {
    cmsCloseIOhandler(io);
    cmsDeleteContext(context);
    return 0;
  }

  // Create profiles for _cmsBuildKToneCurve.
  cmsHPROFILE profiles[256];
  for (int i = 0; i < numProfiles; i++) {
    profiles[i] = cmsCreateProfilePlaceholder(context);
    if (profiles[i] == NULL) {
      for (int j = 0; j < i; j++) {
        cmsCloseProfile(profiles[j]);
      }
      cmsCloseIOhandler(io);
      cmsDeleteContext(context);
      return 0;
    }
    cmsSetColorSpace(profiles[i], cmsSigCmykData);
    if (i == numProfiles - 1) {
      cmsSetDeviceClass(profiles[i], cmsSigOutputClass);
    }
  }

  // Call the target function.
  cmsToneCurve *toneCurve = _cmsBuildKToneCurve(context, 10, numProfiles, intents, profiles, bpc, adaptationStates, dwFlags);
  if (toneCurve != NULL) {
    cmsFreeToneCurve(toneCurve);
  }

  // Clean up profiles.
  for (int i = 0; i < numProfiles; i++) {
    cmsCloseProfile(profiles[i]);
  }

  // Fuzz cmsPlugin with remaining data.
  size_t remaining_size = io->Tell(io, NULL) < size ? size - io->Tell(io, NULL) : 0;
  if (remaining_size > 0) {
    uint8_t *remaining_data = (uint8_t *)malloc(remaining_size);
    if (remaining_data != NULL) {
      if (io->Read(io, remaining_data, 1, remaining_size)) {
        cmsPlugin(remaining_data);
      }
      free(remaining_data);
    }
  }

  // Clean up.
  cmsCloseIOhandler(io);
  cmsDeleteContext(context);

  return 0;
}[0m
