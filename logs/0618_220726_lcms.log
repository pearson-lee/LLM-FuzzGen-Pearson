#include "/src/lcms/include/lcms2.h"
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

// Fuzzer entry point
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 1) {
    return 0;
  }

  // Create a context
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (ctx == NULL) {
    return 0;
  }

  // Try to open a profile from the fuzzer data.
  // This will exercise the Type_*_Read functions for various tags present in the data.
  cmsHPROFILE hProfile = cmsOpenProfileFromMem(ctx, data, size);
  if (hProfile) {
    // We can try to read some specific tags to guide the fuzzer.
    // The data does not need to contain these tags. cmsReadTag will just return NULL.
    // The returned pointer is temporary and should not be freed.
    cmsReadTag(ctx, hProfile, cmsSigUcrBgTag);
    cmsReadTag(ctx, hProfile, cmsSigCrdInfoTag);
    cmsReadTag(ctx, hProfile, cmsSigVcgtTag);
    cmsReadTag(ctx, hProfile, cmsSigProfileSequenceDescTag);
    cmsReadTag(ctx, hProfile, cmsSigNamedColor2Tag);

    cmsCloseProfile(ctx, hProfile);
  }

  // Now, let's create a new profile and write some tags to it.
  // This will exercise the Type_*_Write functions.
  hProfile = cmsCreateProfilePlaceholder(ctx);
  if (!hProfile) {
    cmsDeleteContext(ctx);
    return 0;
  }

  // Use a single byte from the data to decide which tag to write.
  uint8_t choice = data[0];
  data++;
  size--;

  switch (choice % 5) {
  case 0: {
    // Write cmsSigUcrBgTag
    if (size > 2) {
      cmsToneCurve *ucr = cmsBuildGamma(ctx, data[0] / 25.5);
      cmsToneCurve *bg = cmsBuildGamma(ctx, data[1] / 25.5);
      cmsMLU *desc = cmsMLUalloc(ctx, 1);
      cmsMLUsetASCII(ctx, desc, "en", "US", "fuzzer desc");

      cmsUcrBg ucrbg_data;
      ucrbg_data.Ucr = ucr;
      ucrbg_data.Bg = bg;
      ucrbg_data.Desc = desc;

      cmsWriteTag(ctx, hProfile, cmsSigUcrBgTag, &ucrbg_data);

      // Clean up allocated resources
      cmsFreeToneCurve(ctx, ucr);
      cmsFreeToneCurve(ctx, bg);
      cmsMLUfree(ctx, desc);
    }
    break;
  }
  case 1: {
    // Write cmsSigCrdInfoTag
    if (size > 0) {
      char *str = (char *)malloc(size + 1);
      if (!str)
        break;
      memcpy(str, data, size);
      str[size] = 0;
      cmsMLU *crdinfo = cmsMLUalloc(ctx, 1);
      cmsMLUsetASCII(ctx, crdinfo, "en", "US", str);
      cmsWriteTag(ctx, hProfile, cmsSigCrdInfoTag, crdinfo);
      cmsMLUfree(ctx, crdinfo);
      free(str);
    }
    break;
  }
  case 2: {
    // Write cmsSigVcgtTag
    cmsToneCurve *gamma_curve = cmsBuildGamma(ctx, 2.2);
    if (gamma_curve) {
      cmsWriteTag(ctx, hProfile, cmsSigVcgtTag, gamma_curve);
      cmsFreeToneCurve(ctx, gamma_curve);
    }
    break;
  }
  case 3: {
    // Write cmsSigProfileSequenceDescTag
    cmsSEQ *seq = cmsAllocProfileSequenceDescription(ctx, 1);
    if (seq) {
      seq->seq[0].deviceMfg = cmsSigLcms;
      seq->seq[0].deviceModel = cmsSigLcms;
      cmsMLUsetASCII(ctx, seq->seq[0].Manufacturer, "en", "US", "lcms");
      cmsMLUsetASCII(ctx, seq->seq[0].Model, "en", "US", "fuzzer");
      cmsMLUsetASCII(ctx, seq->seq[0].Description, "en", "US", "test");
      cmsWriteTag(ctx, hProfile, cmsSigProfileSequenceDescTag, seq);
      cmsFreeProfileSequenceDescription(ctx, seq);
    }
    break;
  }
  case 4: {
    // Write cmsSigNamedColor2Tag
    if (size >= 6) {
      cmsNamedColorList *nc =
          cmsAllocNamedColorList(ctx, 1, 3, "prefix", "suffix");
      if (nc) {
        cmsAppendNamedColor(ctx, nc, "a_color", (cmsUInt16Number *)data,
                            (cmsUInt16Number *)data + 3);
        cmsWriteTag(ctx, hProfile, cmsSigNamedColor2Tag, nc);
        cmsFreeNamedColorList(ctx, nc);
      }
    }
    break;
  }
  }

  // To make sure the write operation is performed, we can save the profile to a buffer.
  cmsUInt32Number written = 0;
  cmsSaveProfileToMem(ctx, hProfile, NULL, &written);
  if (written > 0) {
    void *buffer = malloc(written);
    if (buffer) {
      cmsSaveProfileToMem(ctx, hProfile, buffer, &written);
      free(buffer);
    }
  }

  cmsCloseProfile(ctx, hProfile);
  cmsDeleteContext(ctx);

  return 0;
}[0m
