// Helper function to safely consume data from the fuzzing input
static const uint8_t *consume_data(const uint8_t **data, size_t *size, size_t len) {
  if (*size < len) {
    return NULL;
  }
  const uint8_t *ptr = *data;
  *data += len;
  *size -= len;
  return ptr;
}

// Fuzz target entry point
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 1) {
    return 0;
  }

  // Create a context with a null error logger to prevent noisy output
  cmsContext context = cmsCreateContext(NULL, NULL);
  if (!context) {
    return 0;
  }
  cmsSetLogErrorHandler(context, NULL);

  // Consume data for number of profiles
  const uint8_t *num_profiles_ptr = consume_data(&data, &size, sizeof(uint8_t));
  if (!num_profiles_ptr) {
    cmsDeleteContext(context);
    return 0;
  }
  const uint8_t num_profiles = (*num_profiles_ptr % 5) + 1; // 1 to 5 profiles

  // Create profiles
  cmsHPROFILE *profiles = (cmsHPROFILE *)malloc(sizeof(cmsHPROFILE) * num_profiles);
  if (!profiles) {
    cmsDeleteContext(context);
    return 0;
  }
  for (uint8_t i = 0; i < num_profiles; i++) {
    profiles[i] = cmsCreateProfilePlaceholder(context);
    if (!profiles[i]) {
      for (uint8_t j = 0; j < i; j++) {
        cmsCloseProfile(profiles[j]);
      }
      free(profiles);
      cmsDeleteContext(context);
      return 0;
    }
  }

  // Consume data for intents, BPC, adaptation states, and flags
  const size_t intents_size = sizeof(cmsUInt32Number) * num_profiles;
  const uint8_t *intents_ptr = consume_data(&data, &size, intents_size);
  cmsUInt32Number *intents = (cmsUInt32Number *)malloc(intents_size);
  if (intents_ptr && intents) {
    memcpy(intents, intents_ptr, intents_size);
  } else {
    if (intents) free(intents);
    for (uint8_t i = 0; i < num_profiles; i++) {
      cmsCloseProfile(profiles[i]);
    }
    free(profiles);
    cmsDeleteContext(context);
    return 0;
  }

  const size_t bpc_size = sizeof(cmsBool) * num_profiles;
  const uint8_t *bpc_ptr = consume_data(&data, &size, bpc_size);
  cmsBool *bpc = (cmsBool *)malloc(bpc_size);
  if (bpc_ptr && bpc) {
    memcpy(bpc, bpc_ptr, bpc_size);
  } else {
    if (bpc) free(bpc);
    free(intents);
    for (uint8_t i = 0; i < num_profiles; i++) {
      cmsCloseProfile(profiles[i]);
    }
    free(profiles);
    cmsDeleteContext(context);
    return 0;
  }

  const size_t adaptation_states_size = sizeof(cmsFloat64Number) * num_profiles;
  const uint8_t *adaptation_states_ptr = consume_data(&data, &size, adaptation_states_size);
  cmsFloat64Number *adaptation_states = (cmsFloat64Number *)malloc(adaptation_states_size);
  if (adaptation_states_ptr && adaptation_states) {
    memcpy(adaptation_states, adaptation_states_ptr, adaptation_states_size);
  } else {
    if (adaptation_states) free(adaptation_states);
    free(bpc);
    free(intents);
    for (uint8_t i = 0; i < num_profiles; i++) {
      cmsCloseProfile(profiles[i]);
    }
    free(profiles);
    cmsDeleteContext(context);
    return 0;
  }

  const uint8_t *flags_ptr = consume_data(&data, &size, sizeof(cmsUInt32Number));
  cmsUInt32Number flags = flags_ptr ? *(const cmsUInt32Number *)flags_ptr : 0;

  // Call _cmsDefaultICCintents
  cmsPipeline *pipeline = _cmsDefaultICCintents(context, num_profiles, intents, profiles, bpc, adaptation_states, flags);
  if (pipeline) {
    cmsPipelineFree(pipeline);
  }

  // Clean up resources for _cmsDefaultICCintents
  free(adaptation_states);
  free(bpc);
  free(intents);

  // Create an IO handler from the remaining data
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(context, (void *)data, size, "r");
  if (io) {
    cmsUInt32Number items, bytes;
    // These functions are part of the cmstypes.c file and have 0% coverage.
    // We are calling them to increase coverage.
    void *ucrbg = Type_UcrBg_Read(NULL, io, &items, &bytes);
    if (ucrbg)
      free(ucrbg);
    void *vcgt = Type_vcgt_Read(NULL, io, &items, &bytes);
    if (vcgt)
      free(vcgt);
    void *seqid = Type_ProfileSequenceId_Read(NULL, io, &items, &bytes);
    if (seqid)
      free(seqid);

    cmsCloseIOhandler(io);
  }

  // Call _cmsReadFloatOutputTag
  const uint8_t *tag_ptr = consume_data(&data, &size, sizeof(cmsTagSignature));
  if (tag_ptr) {
    cmsTagSignature tag = *(const cmsTagSignature *)tag_ptr;
    cmsPipeline *output_pipeline = _cmsReadFloatOutputTag(profiles[0], tag);
    if (output_pipeline) {
      cmsPipelineFree(output_pipeline);
    }
  }

  // Final cleanup
  for (uint8_t i = 0; i < num_profiles; i++) {
    cmsCloseProfile(profiles[i]);
  }
  free(profiles);
  cmsDeleteContext(context);

  return 0;
}[0m
