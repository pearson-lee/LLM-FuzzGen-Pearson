int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 20) {
    return 0;
  }

  cmsHPROFILE hProfile = cmsOpenProfileFromMem(data, size);
  if (hProfile) {
    // Fuzz tag reading to indirectly call type handlers
    cmsToneCurve* curve = (cmsToneCurve*) cmsReadTag(hProfile, cmsSigRedTRCTag);
    if (curve) {
      cmsFreeToneCurve(curve);
    }

    cmsPipeline* pipeline = (cmsPipeline*) cmsReadTag(hProfile, cmsSigBToA0Tag);
    if (pipeline) {
      cmsPipelineFree(pipeline);
    }

    // This tag's handler was being fuzzed. Let's read it.
    // The memory management for its return value is unclear from the public API.
    // We assume cmsCloseProfile handles it, as there's no cmsFreeVideoCardGamma.
    cmsReadTag(hProfile, cmsSigVideoCardGammaTag);

    // Fuzzing logic that might use _cmsStageAllocLabPrelin
    cmsHPROFILE hLabProfile = cmsCreateLab4Profile(NULL);
    if (hLabProfile) {
      // Create a transform. This will build a pipeline and is likely to call
      // stage allocation functions.
      cmsHTRANSFORM xform = cmsCreateTransform(hLabProfile, TYPE_Lab_8, hProfile, TYPE_BGRA_8, INTENT_PERCEPTUAL, 0);
      if (xform) {
        cmsDeleteTransform(xform);
      }
      cmsCloseProfile(hLabProfile);
    }

    cmsCloseProfile(hProfile);
  }

  // Fuzz cmsDesaturateLab
  if (size >= sizeof(cmsCIELab) + 4 * sizeof(double)) {
    cmsCIELab lab;
    const uint8_t* p = data;
    memcpy(&lab, p, sizeof(cmsCIELab));
    p += sizeof(cmsCIELab);

