// different segment types and complex structures.
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 12) {
    return 0;
  }

  // Create a context.
  cmsContext context = cmsCreateContext(NULL, NULL);
  if (context == NULL) {
    return 0;
  }

  // Create a memory-based IO handler from the fuzzer input.
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(context, (void *)data, size, "r");
  if (io == NULL) {
    cmsDeleteContext(context);
    return 0;
  }

  // Create a dummy type handler.
  struct _cms_typehandler_struct s;
  memset(&s, 0, sizeof(s));
  s.ContextID = context;

  // Call the target function.
  cmsToneCurve *curve = ReadSegmentedCurve(&s, io);

  // Free the returned tone curve.
  if (curve != NULL) {
    cmsFreeToneCurve(curve);
  }

  // Close the IO handler.
  cmsCloseIOhandler(io);

  // Delete the context.
  cmsDeleteContext(context);

  return 0;
}[0m
