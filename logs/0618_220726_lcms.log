  text_data[size] = '\0';

  cmsHANDLE it8 = cmsIT8LoadFromMem(context, (const uint8_t*)text_data, size);
  if (it8) {
    cmsIT8Free(it8);
  }

  free(text_data);
  cmsDeleteContext(context);
}

