      WriteMPECurve((struct _cms_typehandler_struct *)handler, mpe_io, mpe, 1, 3);
      cmsCloseIOhandler(mpe_io);
    }
    cmsStageFree(mpe);
  }

  // Clean up
  cmsCloseIOhandler(io);
  _cmsFree(context, handler);
  cmsDeleteContext(context);

  return 0;
}[0m
