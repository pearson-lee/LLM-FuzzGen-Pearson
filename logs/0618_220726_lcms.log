                cmsSaveProfileToStream(hMemProfile, f_out);
                fclose(f_out);
              }
              remove(out_filename);
            }
            cmsCloseProfile(hMemProfile);
          }
        }
        free(memProfile);
      }
    }

    // If hProfile was not closed above, close it now.
    if (hProfile) {
      cmsCloseProfile(hProfile);
    }
  }

  cmsHANDLE hIT8 = cmsIT8LoadFromFile(NULL, filename);
  if (hIT8) {
    cmsIT8SetTableByLabel(hIT8, "SAMPLE_ID", "1", "1");
