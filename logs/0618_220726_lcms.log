int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size == 0) {
    return 0;
  }

  // Use stack-allocated array for filename to avoid tmpnam static buffer issues.
  char filename[L_tmpnam];
  if (tmpnam(filename) == NULL) {
    return 0;
  }

  FILE *f = fopen(filename, "wb");
  if (!f) {
    remove(filename);
    return 0;
  }

  if (fwrite(data, 1, size, f) != size) {
    fclose(f);
    remove(filename);
    return 0;
  }
  fclose(f);

  cmsHPROFILE hProfile = cmsCreateDeviceLinkFromCubeFile(filename);
  if (hProfile) {
    cmsMD5computeID(hProfile);

    cmsUInt32Number profileSize = 0;
    if (cmsSaveProfileToMem(hProfile, NULL, &profileSize)) {
      void *memProfile = malloc(profileSize);
      if (memProfile) {
        if (cmsSaveProfileToMem(hProfile, memProfile, &profileSize)) {
          // The profile has been saved to memory, we can close the file-based
          // handle and continue with the memory-based one.
          cmsCloseProfile(hProfile);
          hProfile = NULL; // Set to NULL to prevent double-free later.

          cmsHPROFILE hMemProfile = cmsOpenProfileFromMem(memProfile, profileSize);
          if (hMemProfile) {
            // Test saving the memory-based profile to a stream.
            char out_filename[L_tmpnam];
            if (tmpnam(out_filename) != NULL) {
              FILE *f_out = fopen(out_filename, "wb");
