#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include "lcms2.h"
#include "lcms2_plugin.h"
#include <stdio.h>

// Helper function to create a temporary file with the given data.
// Returns 0 on success, -1 on error.
static int create_temp_file_with_data(const uint8_t *data, size_t size, char *filename_out) {
  char* filename = tmpnam(filename_out);
  if (filename == NULL) {
    return -1;
  }

  FILE *f = fopen(filename, "wb");
  if (!f) {
    return -1;
  }

  if (fwrite(data, 1, size, f) != size) {
    fclose(f);
    remove(filename);
    return -1;
  }

  fclose(f);
  return 0;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size == 0) {
    return 0;
  }

  // --- Fuzz profile functions in an isolated block ---
  char profile_filename[L_tmpnam];
  if (create_temp_file_with_data(data, size, profile_filename) == 0) {
    cmsHPROFILE hProfile = cmsCreateDeviceLinkFromCubeFile(profile_filename);
    if (hProfile) {
      cmsMD5computeID(hProfile);

      cmsUInt32Number profileSize = 0;
      if (cmsSaveProfileToMem(hProfile, NULL, &profileSize)) {
        void *memProfile = malloc(profileSize);
        if (memProfile) {
          if (cmsSaveProfileToMem(hProfile, memProfile, &profileSize)) {
            cmsHPROFILE hMemProfile = cmsOpenProfileFromMem(memProfile, profileSize);
            if (hMemProfile) {
              char out_filename[L_tmpnam];
              if (tmpnam(out_filename) != NULL) {
                FILE *f_out = fopen(out_filename, "wb");
                if (f_out) {
                  cmsSaveProfileToStream(hMemProfile, f_out);
                  fclose(f_out);
                }
                remove(out_filename);
              }
              cmsCloseProfile(hMemProfile);
            }
          }
          free(memProfile);
        }
      }
      cmsCloseProfile(hProfile);
    }
    remove(profile_filename);
  }

  // --- Fuzz IT8 functions in a separate, isolated block ---
  char it8_filename[L_tmpnam];
  if (create_temp_file_with_data(data, size, it8_filename) == 0) {
    cmsHANDLE hIT8 = cmsIT8LoadFromFile(NULL, it8_filename);
    if (hIT8) {
      cmsIT8SetTableByLabel(hIT8, "SAMPLE_ID", "1", "1");
      const char **propertyNames;
      cmsUInt32Number propertyCount = cmsIT8EnumPropertyMulti(hIT8, "DESCRIPTOR", &propertyNames);
      if (propertyCount > 0 && propertyNames != NULL) {
      }
      cmsIT8GetDataRowColDbl(hIT8, 0, 0);
      char patchName[256];
      const char* patchNamePtr = cmsIT8GetPatchName(hIT8, 0, patchName);
      if (patchNamePtr) {
      }
      cmsIT8Free(hIT8);
    }
    remove(it8_filename);
  }

  // --- Fuzz cmsMD5 functions ---
  cmsHANDLE hMD5 = cmsMD5alloc(NULL);
  if (hMD5) {
    cmsMD5add(hMD5, data, size);
    cmsProfileID profileID;
    cmsMD5finish(&profileID, hMD5);
  }

  return 0;
}[0m
