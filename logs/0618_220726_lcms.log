#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/src/lcms2_internal.h"
#include <stdint.h>
#include <stdlib.h>

// Fuzzing target for reading and writing various tag types.
// This function will attempt to write and read U16Fixed16, ColorantOrder,
// and VideoSignal tags to exercise the corresponding type handlers.
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  // Create a context.
  cmsContext context = cmsCreateContext(NULL, NULL);
  if (context == NULL) {
    return 0;
  }

  // Create a placeholder profile.
  cmsHPROFILE profile = cmsCreateProfilePlaceholder(context);
  if (profile == NULL) {
    cmsDeleteContext(context);
    return 0;
  }

  // We need at least enough data for one of our types.
  if (size > 0) {
    // Write and read a U16Fixed16 tag.
    if (size >= sizeof(cmsFloat64Number)) {
      cmsWriteTag(profile, cmsSigU16Fixed16ArrayType, data);
      cmsReadTag(profile, cmsSigU16Fixed16ArrayType);
    }

    // Write and read a ColorantOrder tag.
    cmsWriteTag(profile, cmsSigColorantOrderType, data);
    cmsReadTag(profile, cmsSigColorantOrderType);

    // Write and read a VideoSignal tag.
    if (size >= sizeof(cmsVideoSignalType)) {
      cmsWriteTag(profile, cmsSigVideoSignalType, data);
      cmsReadTag(profile, cmsSigVideoSignalType);
    }
  }

  // Clean up resources.
  cmsCloseProfile(profile);
  cmsDeleteContext(context);

  return 0;
}[0m
