// Helper to create a temp file with data. Returns 1 on success, 0 on failure.
static int create_temp_file(const char* name, const uint8_t* data, size_t size) {
    FILE* f = fopen(name, "wb");
    if (!f) return 0;
    int ok = (fwrite(data, 1, size, f) == size);
    fclose(f);
    return ok;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size == 0) {
