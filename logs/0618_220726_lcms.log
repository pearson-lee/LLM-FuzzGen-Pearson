    memcpy(&amax, p, sizeof(double));
    p += sizeof(double);
    memcpy(&amin, p, sizeof(double));
    p += sizeof(double);
    memcpy(&bmax, p, sizeof(double));
    p += sizeof(double);
    memcpy(&bmin, p, sizeof(double));

    cmsDesaturateLab(&lab, amax, amin, bmax, bmin);
  }

  return 0;
}[0m
