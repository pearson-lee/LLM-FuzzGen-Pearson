    // This call determines the required buffer size.
    cmsUInt32Number it8_mem_size = 0;
    if (cmsIT8SaveToMem(it8, NULL, &it8_mem_size)) {
      // If size is determined, allocate buffer and save.
      // This change maintains memory safety by allocating the buffer only if needed
      // and freeing it in the cleanup block.
      it8_mem_buffer = malloc(it8_mem_size);
      if (it8_mem_buffer) {
        cmsIT8SaveToMem(it8, it8_mem_buffer, &it8_mem_size);
      }
    }
  }

cleanup:
  // Free all allocated resources to prevent memory leaks.
  // This block is executed regardless of where the function exits.
  if (it8_mem_buffer) // Free buffer for cmsIT8SaveToMem
    free(it8_mem_buffer);
  if (it8)
    cmsIT8Free(it8);
  if (transform)
    cmsDeleteTransform(transform);
  if (proof_profile)
    cmsCloseProfile(proof_profile);
  if (lab_profile)
    cmsCloseProfile(lab_profile);
  if (rgb_profile)
    cmsCloseProfile(rgb_profile);
  if (joined_curve)
    cmsFreeToneCurve(joined_curve);
  if (gamma2)
    cmsFreeToneCurve(gamma2);
  if (gamma1)
    cmsFreeToneCurve(gamma1);
  // Added cleanup for duplicated context to prevent memory leaks.
  if (dup_context)
    cmsDeleteContext(dup_context);
  if (context)
    cmsDeleteContext(context);

  return 0;
}

