    ucrbg_handler->free(ucrbg_handler, ucrbg);
  } else {
    // If the handler is not found, free the manually allocated structure.
    cmsFreeToneCurve(ucrbg->Ucr);
    cmsFreeToneCurve(ucrbg->Bg);
    cmsMLUfree(ucrbg->Desc);
