#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include "lcms2.h"

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 1) {
    return 0;
  }

  // Create a temporary file with the fuzzer data.
  char filename[256];
  sprintf(filename, "/tmp/fuzzer_input_%d.cube", getpid());
  FILE *fp = fopen(filename, "wb");
  if (!fp) {
    return 0;
  }
  fwrite(data, 1, size, fp);
  fclose(fp);

  // Create a context.
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (!ctx) {
    unlink(filename);
    return 0;
  }

  // Target cmsCreateDeviceLinkFromCubeFileTHR
  cmsHPROFILE profile = cmsCreateDeviceLinkFromCubeFileTHR(ctx, filename);
  if (profile) {
    // Target cmsReadTag
    cmsTagSignature tags[] = {
        cmsSigAToB0Tag, cmsSigAToB1Tag, cmsSigAToB2Tag,
        cmsSigBToA0Tag, cmsSigBToA1Tag, cmsSigBToA2Tag,
        cmsSigGamutTag, cmsSigPreview0Tag, cmsSigPreview1Tag,
        cmsSigPreview2Tag, cmsSigProfileDescriptionTag,
    };
    for (size_t i = 0; i < sizeof(tags) / sizeof(tags[0]); ++i) {
      void *tag_data = cmsReadTag(profile, tags[i]);
      if (tag_data) {
        // The memory returned by cmsReadTag is managed by the profile
        // and should not be freed separately.
      }
    }
    cmsCloseProfile(profile);
  }

  // Target cmsIT8LoadFromMem
  cmsHANDLE it8_handle = cmsIT8Alloc(ctx);
  if (it8_handle) {
    cmsIT8LoadFromMem(it8_handle, data, size);

    // Target cmsIT8SetPropertyDbl
    if (size > sizeof(double)) {
      double d;
      memcpy(&d, data, sizeof(double));
      cmsIT8SetPropertyDbl(it8_handle, "some_property", d);
    }

    // Target cmsIT8SaveToMem
    cmsUInt32Number out_size = 0;
    cmsIT8SaveToMem(it8_handle, NULL, &out_size);
    if (out_size > 0) {
      void *out_buf = malloc(out_size);
      if (out_buf) {
        cmsIT8SaveToMem(it8_handle, out_buf, &out_size);
        free(out_buf);
      }
    }

    cmsIT8Free(it8_handle);
  }

  cmsDeleteContext(ctx);
  unlink(filename);

  return 0;
}[0m
