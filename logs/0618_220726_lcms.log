    if (Segments == NULL) return NULL;

    for (i=0; i < (cmsUInt32Number) nSegments - 1; i++) {
        Segments[i].x0 = PrevBreak;
        if (!_cmsReadFloat32Number(io, &Segments[i].x1)) goto Error;
