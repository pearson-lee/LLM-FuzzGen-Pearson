// Target APIs:
// cmsBool cmsDesaturateLab(cmsCIELab* Lab, double a_star_lim, double b_star_lim, double limit);
// void* Type_vcgt_Read(struct _cms_typehandler_struct* self, cmsIOHANDLER* io, cmsUInt32Number* nItems, cmsUInt32Number SizeOfTag);
// cmsToneCurve* ReadSegmentedCurve(struct _cms_typehandler_struct* self, cmsIOHANDLER* io);
// cmsStage* _cmsStageAllocLabPrelin(cmsContext ContextID);
// cmsBool ReadMPECurve(struct _cms_typehandler_struct* self, cmsIOHANDLER* io, void* Cargo, cmsUInt32Number n, cmsUInt32Number SizeOfTag);

// Helper function to create a tone curve for use in other functions.
static cmsToneCurve *build_tone_curve(const uint8_t **data, size_t *size) {
  if (*size < sizeof(cmsUInt32Number)) {
    return NULL;
  }
  cmsUInt32Number n_entries = *(const cmsUInt32Number *)(*data);
  *data += sizeof(cmsUInt32Number);
  *size -= sizeof(cmsUInt32Number);
  n_entries %= 4096; // Limit to a reasonable size

  if (*size < n_entries * sizeof(cmsUInt16Number)) {
    return NULL;
  }
  cmsToneCurve *curve = cmsBuildTabulatedToneCurve16(NULL, n_entries, (const cmsUInt16Number *)(*data));
  *data += n_entries * sizeof(cmsUInt16Number);
  *size -= n_entries * sizeof(cmsUInt16Number);
  return curve;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 20) {
    return 0;
  }

  // Create a context
  cmsContext context = cmsCreateContext(NULL, NULL);
  if (context == NULL) {
    return 0;
  }

  // Create a memory-based IO handler from the fuzzer data.
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(context, (void *)data, size, "r");
  if (io == NULL) {
    cmsDeleteContext(context);
    return 0;
  }

  // Fuzz Type_vcgt_Read
  cmsUInt32Number items = 0;
  void *vcgt = Type_vcgt_Read(NULL, io, &items, (cmsUInt32Number)size);
  if (vcgt) {
    // The Type_vcgt_Read function returns a pointer to a cmsVEC3 object,
    // which is allocated with _cmsMalloc. We need to free it to avoid leaks.
    _cmsFree(context, vcgt);
  }

  // Fuzz ReadSegmentedCurve
  cmsIOSeek(io, 0); // Rewind the IO handler
  cmsToneCurve *curve = ReadSegmentedCurve(NULL, io);
  if (curve) {
    cmsFreeToneCurve(curve);
  }

  // Fuzz _cmsStageAllocLabPrelin
  cmsStage *stage = _cmsStageAllocLabPrelin(context);
  if (stage) {
    cmsStageFree(stage);
  }

  // Fuzz ReadMPECurve
  cmsIOSeek(io, 0); // Rewind the IO handler
  cmsUInt32Number n = 0;
  if (size > sizeof(cmsUInt32Number)) {
    n = *(const cmsUInt32Number *)data;
    data += sizeof(cmsUInt32Number);
    size -= sizeof(cmsUInt32Number);
  }
  cmsToneCurve *mpe_curve = build_tone_curve(&data, &size);
  if (mpe_curve) {
    ReadMPECurve(NULL, io, mpe_curve, n, (cmsUInt32Number)size);
    cmsFreeToneCurve(mpe_curve);
  }

  // Fuzz cmsDesaturateLab
  if (size >= sizeof(cmsCIELab) + 3 * sizeof(double)) {
    cmsCIELab lab;
    memcpy(&lab, data, sizeof(cmsCIELab));
    data += sizeof(cmsCIELab);
    size -= sizeof(cmsCIELab);

    double a_star_lim, b_star_lim, limit;
    memcpy(&a_star_lim, data, sizeof(double));
    data += sizeof(double);
    size -= sizeof(double);
    memcpy(&b_star_lim, data, sizeof(double));
    data += sizeof(double);
    size -= sizeof(double);
    memcpy(&limit, data, sizeof(double));
    data += sizeof(double);
    size -= sizeof(double);

    cmsDesaturateLab(&lab, a_star_lim, b_star_lim, limit);
  }

  // Clean up
  cmsCloseIOhandler(io);
  cmsDeleteContext(context);

  return 0;
}[0m
