    if (patchNamePtr) {
    }
    cmsIT8Free(hIT8);
  }

  cmsHANDLE hMD5 = cmsMD5alloc(NULL);
  if (hMD5) {
    cmsMD5add(hMD5, data, size);
    cmsProfileID profileID;
    cmsMD5finish(&profileID, hMD5);
  }

  remove(filename);
  return 0;
