        if (cmsSaveProfileToMem(hProfile, memProfile, &profileSize)) {
          // Load the profile from memory
          cmsHPROFILE hMemProfile = cmsOpenProfileFromMem(memProfile, profileSize);
          if (hMemProfile) {
            cmsCloseProfile(hMemProfile);
          }
        }
        free(memProfile);
      }
    }

