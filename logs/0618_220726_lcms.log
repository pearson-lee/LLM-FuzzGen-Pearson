    void *lut2 = Type_LUT8_Dup((struct _cms_typehandler_struct *)handler, lut, 1);
    if (lut2 != NULL) {
      cmsPipelineFree((cmsPipeline *)lut2);
    }
    cmsPipelineFree(lut);
  }

  // Allocate a stage that can hold tone curves to prevent the null-deref
  const cmsUInt32Number n_mpe_curves = 3;
  cmsToneCurve* mpe_curves[n_mpe_curves] = { NULL, NULL, NULL };
  cmsStage *mpe = cmsStageAllocToneCurves(context, n_mpe_curves, (cmsToneCurve* const*)mpe_curves);
