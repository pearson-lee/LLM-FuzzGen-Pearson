// Define a custom deleter for XMLDocument to ensure proper memory management with unique_ptr
struct XMLDocumentDeleter {
    void operator()(tinyxml2::XMLDocument* doc) const {
        if (doc) {
            doc->DeleteChildren(); // Ensure all children are deleted to prevent leaks
            delete doc;
        }
    }
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Use unique_ptr for XMLDocument to ensure automatic memory deallocation
    std::unique_ptr<tinyxml2::XMLDocument, XMLDocumentDeleter> doc(new tinyxml2::XMLDocument());

    // Fuzzing tinyxml2::XMLDocument::Parse(const char* xml, size_t nBytes)
    // This function is well-covered, but we'll use it to parse the initial XML.
    std::string xml_string = fdp.ConsumeRandomLengthString(fdp.remaining_bytes() / 2);
    doc->Parse(xml_string.c_str(), xml_string.length());

    // Fuzzing tinyxml2::XMLDocument::LoadFile(FILE *fp)
    // This function has lower coverage, specifically around file I/O errors and empty files.
    // We'll simulate file input using a temporary buffer and a FILE* stream.
    if (fdp.ConsumeBool()) { // Randomly decide to fuzz LoadFile
        std::string file_content = fdp.ConsumeRemainingBytesAsString();
        // Create a temporary file in memory to simulate a file stream
        FILE* temp_file = fmemopen(const_cast<char*>(file_content.data()), file_content.size(), "rb");
        if (temp_file) {
            doc->LoadFile(temp_file);
            fclose(temp_file); // Close the simulated file
        } else {
            // Attempt to trigger XML_ERROR_FILE_COULD_NOT_BE_OPENED by passing a non-existent file path
            // This path is covered by LoadFile(const char* filename), which then calls LoadFile(FILE* fp)
            // We can't directly control the FILE* fp to be invalid in a way that triggers specific internal errors
            // without a real file system. However, we can ensure the fmemopen fails if memory is an issue,
            // or if the fdp provides an empty string, which will lead to XML_ERROR_EMPTY_DOCUMENT.
        }
    }

    // Fuzzing tinyxml2::XMLPrinter::Print(const char* format, ...)
    // This function has 0% coverage. We will generate various format strings and arguments.
    if (fdp.ConsumeBool()) {
        tinyxml2::XMLPrinter printer;
        std::string format_string = fdp.ConsumeRandomLengthString(50);
        // We need to be careful with variadic functions in fuzzing.
        // For simplicity and safety, we'll use a limited set of format specifiers
        // and provide corresponding arguments from FuzzedDataProvider.
        // This won't cover all possible format string vulnerabilities but will
        // exercise the function's basic parsing and printing logic.
        if (format_string.find("%s") != std::string::npos) {
            printer.Print(format_string.c_str(), fdp.ConsumeRandomLengthString(20).c_str());
        } else if (format_string.find("%d") != std::string::npos) {
            printer.Print(format_string.c_str(), fdp.ConsumeIntegral<int>());
        } else if (format_string.find("%f") != std::string::npos) {
            printer.Print(format_string.c_str(), fdp.ConsumeFloatingPoint<float>());
        } else {
            printer.Print(format_string.c_str());
        }
    }

    // Fuzzing tinyxml2::XMLNode::InsertAfterChild(XMLNode* afterThis, XMLNode* addThis)
    // This function has lower coverage. We'll create elements and try to insert them.
    if (doc->RootElement() && fdp.ConsumeBool()) {
        std::string element_name1 = fdp.ConsumeRandomLengthString(10);
        std::string element_name2 = fdp.ConsumeRandomLengthString(10);

        tinyxml2::XMLElement* elem1 = doc->NewElement(element_name1.c_str());
        tinyxml2::XMLElement* elem2 = doc->NewElement(element_name2.c_str());

        if (elem1 && elem2) {
            doc->RootElement()->InsertEndChild(elem1); // Add elem1 to the document
            // Attempt to insert elem2 after elem1
            doc->RootElement()->InsertAfterChild(elem1, elem2);
        }
    }

    // Fuzzing tinyxml2::XMLDocument::Identify(char* p, XMLNode** node, bool first)
    // This function is critical for parsing and has some uncovered branches.
    // We'll provide various XML-like strings to trigger different identification paths.
    if (fdp.ConsumeBool()) {
        std::string identify_input = fdp.ConsumeRandomLengthString(fdp.remaining_bytes());
        char* buffer = new char[identify_input.length() + 1];
        memcpy(buffer, identify_input.c_str(), identify_input.length());
        buffer[identify_input.length()] = '\0';

        tinyxml2::XMLNode* identified_node = nullptr;
        int curLineNum = 1;
        // The 'first' parameter is true for the first node identified in a document.
        // We'll randomly set it to true or false.
        doc->Identify(buffer, &identified_node, fdp.ConsumeBool());

        // The identified_node is owned by the document's memory pools if successfully parsed.
        // If not, it's a nullptr. No explicit deletion needed here for identified_node.
        delete[] buffer; // Free the temporary buffer
    }

    return 0;
}[0m
