    // This function has lower coverage, specifically around file I/O errors and empty files.
    // We'll simulate file input using a temporary buffer and a FILE* stream.
    if (fdp.ConsumeBool()) { // Randomly decide to fuzz LoadFile
        std::string file_content = fdp.ConsumeRemainingBytesAsString();
        // Create a temporary file in memory to simulate a file stream
        FILE* temp_file = fmemopen(const_cast<char*>(file_content.data()), file_content.size(), "rb");
        if (temp_file) {
            doc->LoadFile(temp_file);
            fclose(temp_file); // Close the simulated file
        } else {
            // fmemopen can fail if memory is an issue or if size is 0.
            // In a fuzzer, this branch is less about specific file errors and more about
            // ensuring the fuzzer doesn't crash if fmemopen returns nullptr.
        }
    }

    // Fuzzing tinyxml2::XMLPrinter
    // The 'Print' method is protected. Instead, we can use XMLDocument::Print()
    // or directly use public methods like PushText, PushAttribute, etc.
    if (fdp.ConsumeBool()) {
        tinyxml2::XMLPrinter printer;
        // Fuzzing XMLDocument::Print which uses XMLPrinter internally
        doc->Print(&printer);

        // Also, directly fuzz some public methods of XMLPrinter
        if (fdp.ConsumeBool()) {
            printer.PushText(fdp.ConsumeRandomLengthString(20).c_str());
        }
        if (fdp.ConsumeBool()) {
            printer.PushAttribute("attr", fdp.ConsumeRandomLengthString(10).c_str());
        }
