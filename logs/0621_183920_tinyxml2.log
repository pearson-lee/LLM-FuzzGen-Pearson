#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <fuzzer/FuzzedDataProvider.h>
#include "/src/tinyxml2/tinyxml2.h" // Include the tinyxml2 header

// Define a custom deleter for XMLDocument to ensure memory safety with unique_ptr
struct XMLDocumentDeleter {
    void operator()(tinyxml2::XMLDocument* doc) const {
        if (doc) {
            doc->Clear(); // Clear the document to release resources
            delete doc;    // Delete the document itself
        }
    }
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a unique_ptr for XMLDocument to ensure automatic memory management
    std::unique_ptr<tinyxml2::XMLDocument, XMLDocumentDeleter> doc(new tinyxml2::XMLDocument());

    // Consume data for XML parsing
    std::string xml_string = fdp.ConsumeRemainingBytesAsString();

    // Parse the XML string
    doc->Parse(xml_string.c_str());

    // Exercise XMLPrinter::Print
    // Create a dummy file for XMLPrinter to write to.
    // This is a common pattern for fuzzing file I/O functions without
    // actually writing to the filesystem during fuzzing.
    // We use a temporary buffer and then a FILE* that writes to it.
    std::vector<char> print_buffer(1024 * 10, 0); // 10KB buffer
    FILE* temp_file = fmemopen(print_buffer.data(), print_buffer.size(), "w");
    if (temp_file) {
        tinyxml2::XMLPrinter printer(temp_file);
        doc->Print(&printer); // Call Print with the printer
        fclose(temp_file);
    }

    // Exercise XMLDocument::LoadFile(_IO_FILE*)
    // Create a temporary in-memory file to simulate loading from a file.
    // This allows us to fuzz LoadFile without actual file system operations.
    if (!xml_string.empty()) {
        FILE* load_file = fmemopen(const_cast<char*>(xml_string.c_str()), xml_string.size(), "r");
        if (load_file) {
            tinyxml2::XMLDocument load_doc;
            load_doc.LoadFile(load_file); // Call LoadFile with the in-memory file
            fclose(load_file);
        }
    }

    // The unique_ptr will automatically delete the XMLDocument when it goes out of scope,
    // ensuring memory safety.

    return 0;
}[0m
