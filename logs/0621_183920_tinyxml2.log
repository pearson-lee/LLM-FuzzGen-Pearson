                // Case 2: Search for a non-existent sibling name
                if (fdp.ConsumeBool()) {
                    std::string non_existent_name = fdp.ConsumeRandomLengthString(32);
                    target_sibling->PreviousSiblingElement(non_existent_name.c_str());
