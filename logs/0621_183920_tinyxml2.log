// Define a helper to manage XMLDocument lifetime using RAII
struct XMLDocumentDeleter {
    void operator()(tinyxml2::XMLDocument* doc) const {
        if (doc) {
            doc->Clear(); // Clear any allocated memory within the document
            delete doc;
        }
    }
};

