            if (!siblings.empty()) {
                tinyxml2::XMLElement* target_sibling = siblings[fdp.ConsumeIntegralInRange<size_t>(0, siblings.size() - 1)];

                // Case 1: Search for an existing sibling by name
                if (fdp.ConsumeBool()) {
                    target_sibling->PreviousSiblingElement(target_sibling->Name());
