// Define a custom deleter for XMLDocument to ensure proper memory management with unique_ptr
struct XMLDocumentDeleter {
    void operator()(tinyxml2::XMLDocument* doc) const {
        if (doc) {
            // tinyxml2::XMLDocument manages its own children, so DeleteChildren() is not needed here.
            // The destructor of XMLDocument handles the cleanup of its nodes.
            delete doc;
        }
    }
};

