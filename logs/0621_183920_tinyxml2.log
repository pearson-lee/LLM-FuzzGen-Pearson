        std::unique_ptr<tinyxml2::XMLElement, std::function<void(tinyxml2::XMLElement*)>> elem2_ptr(
            doc->NewElement(name2.c_str()),
            [](tinyxml2::XMLElement*){ /* Owned by doc */ }
        );
        tinyxml2::XMLElement* elem2 = elem2_ptr.get();

        if (elem1 && elem2) {
