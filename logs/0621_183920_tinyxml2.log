#include "/src/tinyxml2/tinyxml2.h"
#include <fuzzer/FuzzedDataProvider.h>

// Helper function to create a temporary file and write data
// Returns a FILE* to the temporary file, or nullptr on failure.
// The caller is responsible for closing the FILE* and deleting the file.
FILE* createTempFile(FuzzedDataProvider& fdp, const std::string& content) {
    // Create a unique temporary file name
    char filename[] = "/tmp/fuzz_tinyxml2_XXXXXX";
    int fd = mkstemp(filename);
    if (fd == -1) {
        return nullptr;
    }

    // Open the file stream
    FILE* fp = fdopen(fd, "w+");
    if (!fp) {
        close(fd); // Close the file descriptor if fdopen fails
        return nullptr;
    }

    // Write content to the file
    fputs(content.c_str(), fp);
    fflush(fp); // Ensure data is written to disk
    fseek(fp, 0, SEEK_SET); // Reset file pointer to the beginning for reading

    // Unlink the file immediately so it's deleted when closed
    unlink(filename);

    return fp;
}

// Helper function to generate a random string from a specific character set
std::string generateStringFromCharset(FuzzedDataProvider& fdp, size_t max_len, const std::string& charset) {
    std::string result = "";
    size_t len = fdp.ConsumeIntegralInRange<size_t>(0, max_len);
    if (charset.empty()) return result; // Avoid issues if charset is empty
    for (size_t i = 0; i < len; ++i) {
        result += charset[fdp.ConsumeIntegralInRange<size_t>(0, charset.length() - 1)];
    }
    return result;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Use a unique_ptr for XMLDocument to ensure automatic cleanup (RAII)
    // Using new and unique_ptr constructor for C++11 compatibility
    std::unique_ptr<tinyxml2::XMLDocument> doc(new tinyxml2::XMLDocument());

    // 1. Fuzz tinyxml2::XMLDocument::Print(tinyxml2::XMLPrinter*) const
    // Goal: Cover the 'else' branch where the XMLPrinter pointer is NULL.
    // The 'if' branch (streamer is not NULL) is covered by creating a printer.
    if (fdp.ConsumeBool()) {
        // Scenario: Valid XMLPrinter (streamer is not NULL)
        tinyxml2::XMLPrinter printer; // XMLPrinter created on stack, no manual memory management needed
        doc->Print(&printer);
    } else {
        // Scenario: NULL XMLPrinter (streamer is NULL) to hit the uncovered 'else' branch
        doc->Print(nullptr);
    }

    // 2. Fuzz tinyxml2::XMLDocument::LoadFile(_IO_FILE*)
    // Goal: Cover cases where fread might fail (e.g., empty file).
    // Removed the nullptr case as tinyxml2's LoadFile(FILE*) does not handle it gracefully.
    std::string file_content = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 1024));
    FILE* fp = createTempFile(fdp, file_content);
    if (fp) {
        doc->LoadFile(fp);
        fclose(fp); // Close the file stream
    }


    // 3. Fuzz tinyxml2::XMLNode::InsertAfterChild(tinyxml2::XMLNode*, tinyxml2::XMLNode*)
    // Goal: Cover various scenarios for 'addThis' and 'afterThis' (NULL, parent, siblings, same node, different parent).
    {
        // Create a new XMLDocument for this specific fuzzing scenario to isolate state
        std::unique_ptr<tinyxml2::XMLDocument> insert_doc(new tinyxml2::XMLDocument());
        tinyxml2::XMLElement* root = insert_doc->NewElement("root");
        insert_doc->InsertFirstChild(root); // Root element must be linked to the document

        // Create some child elements
        tinyxml2::XMLElement* child1 = insert_doc->NewElement("child1");
        tinyxml2::XMLElement* child2 = insert_doc->NewElement("child2");
        tinyxml2::XMLElement* child3 = insert_doc->NewElement("child3"); // Will be used for insertion

        // Declare other_doc here so its lifetime extends to the end of this block
        std::unique_ptr<tinyxml2::XMLDocument> other_doc;
        tinyxml2::XMLElement* other_child = nullptr; // Declare here to make it accessible outside the case

        // Link child1 and child2 to the root
        root->InsertEndChild(child1);
        root->InsertEndChild(child2);

        // Select a fuzzing scenario for InsertAfterChild
        int scenario = fdp.ConsumeIntegralInRange<int>(0, 7);

        tinyxml2::XMLNode* addThis = nullptr;
        tinyxml2::XMLNode* afterThis = nullptr;

        switch (scenario) {
            case 0: // Scenario: addThis is a valid node, but currently unparented
                addThis = child3; // child3 is created but not yet inserted into 'root'
                afterThis = child1;
                break;
            case 1: // Scenario: addThis has a parent (should return 0)
                addThis = child3;
                root->InsertEndChild(child3); // Give child3 a parent
                afterThis = child1;
                break;
            case 2: // Scenario: addThis == afterThis (should trigger internal DeleteChild and InsertEndChild)
                addThis = child1;
                afterThis = child1;
                break;
            case 3: // Scenario: afterThis is NULL (should call InsertFirstChild)
                addThis = child3;
                afterThis = nullptr;
                break;
            case 4: // Scenario: afterThis has a different parent (should return 0)
                {
                    other_doc.reset(new tinyxml2::XMLDocument()); // Initialize other_doc
                    tinyxml2::XMLElement* other_root = other_doc->NewElement("other_root");
                    other_doc->InsertFirstChild(other_root);
                    other_child = other_doc->NewElement("other_child"); // Assign to the outer-scoped other_child
                    other_root->InsertEndChild(other_child);
                    addThis = child3;
                    afterThis = other_child; // This pointer will now be valid until other_doc is destroyed
                }
                break;
            case 5: // Scenario: addThis has a next sibling (should return 0)
                addThis = child1; // child1 has child2 as next sibling
                afterThis = child2;
                break;
            case 6: // Scenario: addThis has a previous sibling (should return 0)
                addThis = child2; // child2 has child1 as previous sibling
                afterThis = child1;
                break;
            case 7: // Scenario: Normal insertion (add child3 after child1)
                addThis = child3;
                afterThis = child1;
                break;
        }
        root->InsertAfterChild(afterThis, addThis);
    }

    // 4. Fuzz tinyxml2::XMLElement::QueryStringAttribute(char const*, char const**) const
    // Goal: Cover cases where the attribute exists and where it does not.
    {
        std::unique_ptr<tinyxml2::XMLDocument> attr_doc(new tinyxml2::XMLDocument());
        tinyxml2::XMLElement* element = attr_doc->NewElement("testElement");
        attr_doc->InsertFirstChild(element);

        // Add an attribute with a fuzzed name and value
        std::string attr_name_existing = fdp.ConsumeRandomLengthString(10);
        std::string attr_value = fdp.ConsumeRandomLengthString(20);
        element->SetAttribute(attr_name_existing.c_str(), attr_value.c_str());

        // Query for a fuzzed attribute name (could be existing or non-existing)
        std::string query_attr_name = fdp.ConsumeRandomLengthString(10);
        const char* queried_value = nullptr;
        element->QueryStringAttribute(query_attr_name.c_str(), &queried_value);
    }

    // 5. Fuzz tinyxml2::XMLElement::QueryAttribute(char const*, int*) const
    // Goal: Cover cases where the attribute exists, does not exist, and conversion fails (e.g., non-integer value).
    {
        std::unique_ptr<tinyxml2::XMLDocument> attr_doc(new tinyxml2::XMLDocument());
        tinyxml2::XMLElement* element = attr_doc->NewElement("testElement");
        attr_doc->InsertFirstChild(element);

        // Add an integer attribute
        std::string attr_name_int = fdp.ConsumeRandomLengthString(10);
        int attr_value_int = fdp.ConsumeIntegral<int>();
        element->SetAttribute(attr_name_int.c_str(), attr_value_int);

        // Query for the integer attribute (existing or non-existing)
        std::string query_attr_name_int = fdp.ConsumeRandomLengthString(10);
        int queried_value_int = 0;
        element->QueryAttribute(query_attr_name_int.c_str(), &queried_value_int);

        // Add a non-integer attribute to test conversion failure
        std::string attr_name_non_int = fdp.ConsumeRandomLengthString(10);
        std::string attr_value_non_int = fdp.ConsumeRandomLengthString(20);
        element->SetAttribute(attr_name_non_int.c_str(), attr_value_non_int.c_str());

        // Query for the non-integer attribute
        element->QueryAttribute(attr_name_non_int.c_str(), &queried_value_int);
    }

    // 6. Fuzz tinyxml2::XMLDocument::Identify(char*, tinyxml2::XMLNode**, bool)
    // Goal: Cover various input string types (empty, whitespace, BOM, different starts, XML constructs).
    {
        std::unique_ptr<tinyxml2::XMLDocument> identify_doc(new tinyxml2::XMLDocument());
        tinyxml2::XMLNode* identified_node = nullptr;
        int curLineNum = 1; // Line number tracking

        // Generate diverse input strings to hit different branches in Identify
        std::string input_str;
        int identify_scenario = fdp.ConsumeIntegralInRange<int>(0, 8);

        switch (identify_scenario) {
            case 0: // Scenario: Empty string
                input_str = "";
                break;
            case 1: // Scenario: Whitespace only string
                input_str = generateStringFromCharset(fdp, 10, " \t\n\r");
                break;
            case 2: // Scenario: String starting with UTF-8 BOM
                input_str = "\xEF\xBB\xBF" + fdp.ConsumeRandomLengthString(50);
                break;
            case 3: // Scenario: String not starting with '<' or BOM (invalid XML start character)
                {
                    std::string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
                    input_str = alphabet.substr(fdp.ConsumeIntegralInRange<size_t>(0, alphabet.length() - 1), 1) + fdp.ConsumeRandomLengthString(50);
                }
                break;
            case 4: // Scenario: XML Declaration (<?xml)
                input_str = "<?xml version=\"1.0\"?>" + fdp.ConsumeRandomLengthString(50);
                break;
            case 5: // Scenario: XML Comment (<!--)
                input_str = "<!-- some comment -->" + fdp.ConsumeRandomLengthString(50);
                break;
            case 6: // Scenario: CDATA Section (<![CDATA[)
                input_str = "<![CDATA[ some cdata content ]]> " + fdp.ConsumeRandomLengthString(50);
                break;
            case 7: // Scenario: DOCTYPE Declaration (!DOCTYPE)
                input_str = "<!DOCTYPE html>" + fdp.ConsumeRandomLengthString(50);
                break;
            case 8: // Scenario: Unknown Processing Instruction (?)
                input_str = "?some_instruction some_value?" + fdp.ConsumeRandomLengthString(50);
                break;
            default: // Default to a simple XML element
                input_str = "<element>" + fdp.ConsumeRandomLengthString(50) + "</element>";
                break;
        }

        // tinyxml2 functions expect a null-terminated char array that can be modified.
        // Copy the string content into a mutable vector and ensure null-termination.
        std::vector<char> buffer(input_str.begin(), input_str.end());
        buffer.push_back('\0'); // Ensure null-termination

        // Call Identify with the fuzzed input and a fuzzed 'first' boolean
        identify_doc->Identify(buffer.data(), &identified_node, fdp.ConsumeBool());
    }

    return 0;
}[0m
