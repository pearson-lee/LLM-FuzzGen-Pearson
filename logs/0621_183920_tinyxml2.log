        std::unique_ptr<tinyxml2::XMLDocument, XMLDocumentDeleter> clone_doc_ptr(new tinyxml2::XMLDocument());
        tinyxml2::XMLDocument* clone_doc = clone_doc_ptr.get();
        doc->DeepClone(clone_doc);

