// Helper function to create a temporary file and write data
// Returns a FILE* to the temporary file, or nullptr on failure.
// The caller is responsible for closing the FILE* and deleting the file.
FILE* createTempFile(FuzzedDataProvider& fdp, const std::string& content) {
    // Create a unique temporary file name
    char filename[] = "/tmp/fuzz_tinyxml2_XXXXXX";
    int fd = mkstemp(filename);
    if (fd == -1) {
        return nullptr;
    }

    // Open the file stream
    FILE* fp = fdopen(fd, "w+");
    if (!fp) {
        close(fd); // Close the file descriptor if fdopen fails
        return nullptr;
    }

    // Write content to the file
    fputs(content.c_str(), fp);
    fflush(fp); // Ensure data is written to disk
    fseek(fp, 0, SEEK_SET); // Reset file pointer to the beginning for reading

    // Unlink the file immediately so it's deleted when closed
    unlink(filename);

    return fp;
}

// Helper function to generate a random string from a specific character set
std::string generateStringFromCharset(FuzzedDataProvider& fdp, size_t max_len, const std::string& charset) {
    std::string result = "";
    size_t len = fdp.ConsumeIntegralInRange<size_t>(0, max_len);
    if (charset.empty()) return result; // Avoid issues if charset is empty
    for (size_t i = 0; i < len; ++i) {
        result += charset[fdp.ConsumeIntegralInRange<size_t>(0, charset.length() - 1)];
    }
    return result;
}

