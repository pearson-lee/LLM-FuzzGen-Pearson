// Define a custom allocation function for zlib to track allocations
static voidpf z_alloc_func(voidpf opaque, uInt items, uInt size) {
    (void)opaque; // Unused
    return malloc(items * size);
}

// Define a custom free function for zlib to track deallocations
static void z_free_func(voidpf opaque, voidpf address) {
    (void)opaque; // Unused
    free(address);
}

int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    z_stream strm;
