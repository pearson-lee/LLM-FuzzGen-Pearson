    // First, try with an uninitialized stream.
    deflateTune(&strm, 0, 0, 0, 0); // This should return Z_STREAM_ERROR

    // Now, initialize the stream properly and then end it to test deflateTune on an ended stream.
    ret = deflateInit(&strm, Z_DEFAULT_COMPRESSION);
    if (ret == Z_OK) {
        // Call deflateTune with valid parameters on an initialized stream
        deflateTune(&strm, 1, 2, 3, 4);

        // End the stream to put it in a state where deflateTune should return Z_STREAM_ERROR
        deflateEnd(&strm);

        // Call deflateTune again on the ended stream
        deflateTune(&strm, 0, 0, 0, 0); // This should also return Z_STREAM_ERROR
    }

    // No memory leaks to worry about here as deflateInit/deflateEnd handle internal allocations.
    // The custom alloc/free functions are just for demonstration and would be used in a real
    // scenario to track memory usage if needed.

    return 0;
}[0m
