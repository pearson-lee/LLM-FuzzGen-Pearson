    // Initialize z_stream structure
    strm.zalloc = z_alloc_func;
    strm.zfree = z_free_func;
    strm.opaque = Z_NULL;

    // To hit the Z_STREAM_ERROR path in deflateTune, we can call it with an uninitialized stream
