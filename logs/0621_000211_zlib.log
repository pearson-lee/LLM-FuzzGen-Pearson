// Helper variables for consuming fuzzer input
static const uint8_t *g_data;
static size_t g_size;
static size_t g_offset;

// Initializes the fuzzer input consumption mechanism.
static void consume_bytes_init(const uint8_t *Data, size_t Size) {
    g_data = Data;
    g_size = Size;
    g_offset = 0;
}

// Returns the number of remaining bytes in the fuzzer input.
static size_t remaining_bytes() {
    return g_size - g_offset;
}

// Consumes a size_t integral value within a specified range from the fuzzer input.
// Returns min_val if not enough data is available for a full read.
static size_t consume_integral_in_range_size_t(size_t min_val, size_t max_val) {
    size_t bytes_available = remaining_bytes();
    size_t bytes_to_read = (bytes_available < sizeof(size_t)) ? bytes_available : sizeof(size_t);

    if (bytes_to_read == 0) {
        return min_val; // No bytes to read
    }

    size_t val = 0; // Initialize to 0 to avoid uninitialized read
    memcpy(&val, g_data + g_offset, bytes_to_read); // Safe memcpy for unaligned access
    g_offset += bytes_to_read;

    // If we couldn't read a full size_t, treat it as if no data was available for a full value.
    if (bytes_to_read < sizeof(size_t)) {
        return min_val;
    }

    return min_val + (val % (max_val - min_val + 1));
}

// Consumes an int integral value within a specified range from the fuzzer input.
// Returns min_val if not enough data is available for a full read.
static int consume_integral_in_range_int(int min_val, int max_val) {
    size_t bytes_available = remaining_bytes();
    size_t bytes_to_read = (bytes_available < sizeof(int)) ? bytes_available : sizeof(int);

    if (bytes_to_read == 0) {
        return min_val; // No bytes to read
    }

    int val = 0; // Initialize to 0
    memcpy(&val, g_data + g_offset, bytes_to_read); // Safe memcpy for unaligned access
    g_offset += bytes_to_read;

    // If we couldn't read a full int, treat it as if no data was available for a full value.
    if (bytes_to_read < sizeof(int)) {
        return min_val;
    }

    return min_val + (val % (max_val - min_val + 1));
}

// Consumes a specified number of bytes from the fuzzer input.
// Returns a pointer to the consumed bytes, and updates actual_num_bytes with the actual number of bytes consumed.
// The returned pointer is only valid until the next call to LLVMFuzzerTestOneInput.
static const uint8_t *consume_bytes(size_t requested_num_bytes, size_t *actual_num_bytes) {
    size_t bytes_to_consume = requested_num_bytes;
    if (g_offset + bytes_to_consume > g_size) {
        bytes_to_consume = g_size - g_offset; // Clamp to remaining bytes
    }
    const uint8_t *ptr = g_data + g_offset;
    g_offset += bytes_to_consume;
    *actual_num_bytes = bytes_to_consume;
    return ptr;
}


// Consumes a null-terminated string from the fuzzer input up to a maximum length.
// The caller is responsible for freeing the returned string.
static char *consume_string(size_t max_len) {
    size_t requested_len = consume_integral_in_range_size_t(0, max_len);
    size_t actual_len;
    const uint8_t *bytes = consume_bytes(requested_len, &actual_len);
    char *str = (char *)malloc(actual_len + 1);
    if (str) {
        memcpy(str, bytes, actual_len);
        str[actual_len] = '\0';
    }
    return str;
}

