// --- Custom FuzzedDataProvider-like functions for C ---
// This section provides basic functions to consume fuzzer input in a structured way,
// mimicking the functionality of FuzzedDataProvider.h for C.
typedef struct {
    const uint8_t *data;
    size_t size;
    size_t offset;
} FuzzedData;

// Initializes the FuzzedData structure with the fuzzer input.
void FuzzedData_init(FuzzedData *fd, const uint8_t *Data, size_t Size) {
    fd->data = Data;
    fd->size = Size;
    fd->offset = 0;
}

// Returns the number of bytes remaining in the fuzzer input.
size_t FuzzedData_remaining_bytes(FuzzedData *fd) {
    if (fd->offset >= fd->size) {
        return 0;
    }
    return fd->size - fd->offset;
}

// Consumes and returns a pointer to a specified number of bytes from the input.
// If not enough bytes are available, it consumes all remaining bytes.
const uint8_t *FuzzedData_ConsumeBytes(FuzzedData *fd, size_t num_bytes) {
    if (FuzzedData_remaining_bytes(fd) < num_bytes) {
        num_bytes = FuzzedData_remaining_bytes(fd);
    }
    const uint8_t *ptr = fd->data + fd->offset;
    fd->offset += num_bytes;
    return ptr;
}

// Consumes and returns an unsigned int from the input.
// If not enough bytes are available, it consumes remaining bytes and pads with zeros.
unsigned int FuzzedData_ConsumeIntegral_uint(FuzzedData *fd) {
    unsigned int val = 0;
    size_t bytes_to_copy = sizeof(unsigned int);
    if (FuzzedData_remaining_bytes(fd) < bytes_to_copy) {
        bytes_to_copy = FuzzedData_remaining_bytes(fd);
    }
    memcpy(&val, fd->data + fd->offset, bytes_to_copy);
    fd->offset += bytes_to_copy;
    return val;
}

// Consumes and returns an int from the input.
// If not enough bytes are available, it consumes remaining bytes and pads with zeros.
int FuzzedData_ConsumeIntegral_int(FuzzedData *fd) {
    int val = 0;
    size_t bytes_to_copy = sizeof(int);
    if (FuzzedData_remaining_bytes(fd) < bytes_to_copy) {
        bytes_to_copy = FuzzedData_remaining_bytes(fd);
    }
    memcpy(&val, fd->data + fd->offset, bytes_to_copy);
    fd->offset += bytes_to_copy;
    return val;
}

// Consumes and returns a uLong from the input.
// If not enough bytes are available, it consumes remaining bytes and pads with zeros.
uLong FuzzedData_ConsumeIntegral_uLong(FuzzedData *fd) {
    uLong val = 0;
