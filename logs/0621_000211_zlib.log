// Define a simple FuzzedDataProvider-like structure for C
typedef struct {
    const uint8_t *data;
    size_t size;
    size_t offset;
} FuzzedData;

void FuzzedData_init(FuzzedData *fd, const uint8_t *Data, size_t Size) {
    fd->data = Data;
    fd->size = Size;
    fd->offset = 0;
}

size_t FuzzedData_remaining_bytes(FuzzedData *fd) {
    if (fd->offset >= fd->size) {
        return 0;
    }
    return fd->size - fd->offset;
}

// Modified FuzzedData_ConsumeBytes to return the actual number of bytes consumed
const uint8_t *FuzzedData_ConsumeBytes(FuzzedData *fd, size_t requested_bytes, size_t *actual_bytes_consumed) {
    size_t num_bytes_to_consume = requested_bytes;
    if (FuzzedData_remaining_bytes(fd) < num_bytes_to_consume) {
        num_bytes_to_consume = FuzzedData_remaining_bytes(fd);
    }
    const uint8_t *result = fd->data + fd->offset;
    fd->offset += num_bytes_to_consume;
    if (actual_bytes_consumed) {
        *actual_bytes_consumed = num_bytes_to_consume;
    }
    return result;
}

// Helper to consume an integral value and map it to a range
// This is a simplified version, not cryptographically strong or perfectly uniform.
// It's for fuzzing purposes to get values within a range.
static int consume_and_map_int(FuzzedData *fd, int min_val, int max_val) {
    size_t bytes_to_consume = sizeof(int);
    size_t actual_consumed = 0;
    int val = 0; // Initialize to 0 to avoid uninitialized read if not enough bytes
    const uint8_t *consumed_data = FuzzedData_ConsumeBytes(fd, bytes_to_consume, &actual_consumed);
    
    if (actual_consumed > 0) {
        memcpy(&val, consumed_data, actual_consumed);
    } else {
        return min_val; // Not enough data, return min
    }

    if (min_val == max_val) {
        return min_val;
    }
    return min_val + (abs(val) % (max_val - min_val + 1));
}

static size_t consume_and_map_size_t(FuzzedData *fd, size_t min_val, size_t max_val) {
    size_t bytes_to_consume = sizeof(size_t);
    size_t actual_consumed = 0;
    size_t val = 0; // Initialize to 0
    const uint8_t *consumed_data = FuzzedData_ConsumeBytes(fd, bytes_to_consume, &actual_consumed);

    if (actual_consumed > 0) {
        memcpy(&val, consumed_data, actual_consumed);
    } else {
        return min_val;
    }

    if (min_val == max_val) {
        return min_val;
    }
    return min_val + (val % (max_val - min_val + 1));
}

static uLong consume_and_map_uLong(FuzzedData *fd, uLong min_val, uLong max_val) {
    size_t bytes_to_consume = sizeof(uLong);
    size_t actual_consumed = 0;
    uLong val = 0; // Initialize to 0
