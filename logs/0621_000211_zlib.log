    // This function computes the CRC-32 checksum of a data buffer.
    // It has branches related to the input buffer length and endianness.
    uLong initial_crc = 0;
    // Extract initial_crc from fuzzer data. Ensure enough data is available.
    if (current_offset + sizeof(uLong) <= Size) {
