// Please note that in C, you do not need to use `extern "C"` to declare the `LLVMFuzzerTestOneInput` function, as it is a C function, not a C++ function.
// Additionally, in C, you cannot use FuzzedDataProvider.
#include <stdint.h>
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <limits.h> // For ULONG_MAX

#include "/src/zlib/zlib.h"
#include "/src/zlib/zutil.h" // For DEF_MEM_LEVEL and zlibCompileFlags

// Define W based on the size of z_word_t for byte_swap and crc_word_big
// This mimics the conditional compilation in crc32.c
// Moved to global scope as it's used by functions defined outside LLVMFuzzerTestOneInput
typedef unsigned long z_word_t; // Assuming unsigned long aligns with z_word_t in zlib's crc32.c

#if ULONG_MAX == 0xFFFFFFFFUL
#define W 4
#else
#define W 8
#endif

// Dummy crc_big_table for compilation. In a real scenario, this would be
// properly initialized or linked from zlib's crc32.c.
// For fuzzing, we just need it to compile.
// Changed type to z_crc_t as defined in zlib's headers.
z_crc_t crc_big_table[256];

// Implementations of byte_swap and crc_word_big for direct fuzzing.
// These are copied from zlib/crc32.c to make them available to the fuzzer.
// In a real scenario, these might be exposed via a test-only header or
// the fuzzer might be compiled as part of the zlib project.
z_word_t byte_swap(z_word_t word) {
#if W == 8
    return
        (word & 0xff00000000000000) >> 56 |
        (word & 0xff000000000000) >> 40 |
        (word & 0xff0000000000) >> 24 |
        (word & 0xff00000000) >> 8 |
        (word & 0xff000000) << 8 |
        (word & 0xff0000) << 24 |
        (word & 0xff00) << 40 |
        (word & 0xff) << 56;
#else   /* W == 4 */
    return
        (word & 0xff000000) >> 24 |
        (word & 0xff0000) >> 8 |
        (word & 0xff00) << 8 |
        (word & 0xff) << 24;
#endif
}

z_word_t crc_word_big(z_word_t data) {
    int k;
    for (k = 0; k < W; k++)
        data = (data << 8) ^
            crc_big_table[(data >> ((W - 1) << 3)) & 0xff];
    return data;
}


