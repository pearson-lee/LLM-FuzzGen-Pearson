// Define a simple "FuzzedDataProvider" like structure for C
typedef struct {
    const uint8_t *data;
    size_t size;
    size_t offset;
} FuzzedData;

// Initialize the FuzzedData structure
void FuzzedData_init(FuzzedData *fd, const uint8_t *Data, size_t Size) {
    fd->data = Data;
    fd->size = Size;
    fd->offset = 0;
}

// Consume a single byte from the fuzzed data
uint8_t FuzzedData_ConsumeByte(FuzzedData *fd) {
    if (fd->offset < fd->size) {
        return fd->data[fd->offset++];
    }
    return 0; // Default or error value if no more data
}

// Get the number of remaining bytes in the fuzzed data
size_t FuzzedData_remaining_bytes(FuzzedData *fd) {
    return fd->size - fd->offset;
}

// Consume a size_t value from the fuzzed data.
// This is a simplified version, for more robust fuzzing,
// one might want to consume a specific number of bytes and cast.
size_t FuzzedData_ConsumeIntegral_size_t(FuzzedData *fd) {
    size_t val = 0;
    for (int i = 0; i < sizeof(size_t) && FuzzedData_remaining_bytes(fd) > 0; ++i) {
        val = (val << 8) | FuzzedData_ConsumeByte(fd);
    }
    return val;
}

// Consume a specific number of bytes as a buffer
const uint8_t *FuzzedData_ConsumeBytes(FuzzedData *fd, size_t num_bytes, size_t *out_len) {
    size_t bytes_to_consume = num_bytes;
    if (fd->offset + bytes_to_consume > fd->size) {
        bytes_to_consume = fd->size - fd->offset;
    }
    const uint8_t *ptr = fd->data + fd->offset;
    fd->offset += bytes_to_consume;
    if (out_len) {
        *out_len = bytes_to_consume;
    }
    return ptr;
}

// Helper to consume a boolean (0 or 1)
int FuzzedData_ConsumeBool(FuzzedData *fd) {
    return FuzzedData_ConsumeByte(fd) & 1;
}

// Helper to consume an int within a specified range
int FuzzedData_ConsumeIntegralInRange_int(FuzzedData *fd, int min, int max) {
    if (min == max) return min;
    if (min > max) { // Swap if min > max
