    // Test with a custom opaque allocator to cover the `opaque` path.
    z_stream strm_alloc_test = {0}; // Initialize z_stream structure to all zeros.
    strm_alloc_test.zalloc = custom_alloc; // Set custom allocation function.
    strm_alloc_test.zfree = custom_free;   // Set custom free function.
