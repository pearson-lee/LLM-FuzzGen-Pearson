    // Fix: Copy fuzzer input to a new buffer to prevent out-of-bounds reads by zlib.
    Bytef *source_compress = NULL;
    if (source_len_compress > 0) {
        size_t actual_consumed_source_compress = 0;
        const uint8_t *temp_source = FuzzedData_ConsumeBytes(&fd, source_len_compress, &actual_consumed_source_compress);
        source_compress = (Bytef *)malloc(actual_consumed_source_compress);
        if (!source_compress) {
            return 0; // OOM
        }
        memcpy(source_compress, temp_source, actual_consumed_source_compress);
        source_len_compress = actual_consumed_source_compress; // Update source_len_compress to actual consumed size
    }

    // Max possible compressed size is source_len + 0.1% + 12 bytes (for zlib header/footer)
    // For fuzzing, allocate a generous buffer to avoid Z_BUF_ERROR prematurely.
    uLongf dest_len_compress = (uLongf)source_len_compress + (source_len_compress / 1000) + 12 + 1;
    Bytef *dest_compress = (Bytef *)malloc(dest_len_compress);
    if (!dest_compress) {
        if (source_compress) free(source_compress); // Free source_compress if allocated
        return 0; // OOM
    }

    int level = consume_and_map_int(&fd, Z_DEFAULT_COMPRESSION, Z_BEST_COMPRESSION);
    if (FuzzedData_remaining_bytes(&fd) > 0) {
        level = consume_and_map_int(&fd, Z_NO_COMPRESSION, Z_BEST_COMPRESSION);
    }
    if (FuzzedData_remaining_bytes(&fd) > 0) {
        level = consume_and_map_int(&fd, Z_DEFAULT_STRATEGY, Z_FIXED);
    }

    // Call compress2
    // To hit Z_NO_FLUSH and multiple deflate calls, source_len_compress should be large.
    // To hit `left > (uLong)max` and `sourceLen > (uLong)max`, dest_len_compress and source_len_compress
    // should be larger than UINT_MAX. This is not directly possible with size_t if size_t is 64-bit and UINT_MAX is 32-bit.
    // However, the internal logic of compress2 handles chunking, so large inputs will naturally hit those paths.
    (void)compress2(dest_compress, &dest_len_compress, source_compress, (uLong)source_len_compress, level);

