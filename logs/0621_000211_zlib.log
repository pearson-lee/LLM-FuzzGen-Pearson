    if (temp_file) {
        // Open the temporary file as a gzFile.
        gz_file = gzdopen(fileno(temp_file), "wb");
        if (gz_file) {
            // Consume fuzzer input for level and strategy parameters of gzsetparams.
            if (current_size >= sizeof(int) * 2) {
                int level = get_fuzzed_int(&current_data, &current_size) % 10; // 0-9
                if (level < 0) level = 0;
