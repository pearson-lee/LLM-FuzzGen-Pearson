                    }

                    size_t name_len = get_fuzzed_byte(&current_data, &current_size) % (current_size + 1);
                    if (name_len > 0 && current_size >= name_len) {
                        head->name = (Bytef *)malloc(name_len + 1); // +1 for null terminator
                        if (head->name) {
                            memcpy(head->name, current_data, name_len);
                            current_data += name_len;
