    const uint8_t *bytes = FuzzedData_ConsumeBytes(fd, sizeof(unsigned int), &consumed_len);
    if (consumed_len < sizeof(unsigned int)) {
        return min_val;
    }
    memcpy(&val, bytes, sizeof(unsigned int));
    if (min_val == max_val) return min_val;
    return min_val + (val % (max_val - min_val + 1));
}

