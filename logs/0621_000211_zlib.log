// FuzzedDataProvider-like structure and functions (simplified for C)
typedef struct {
    const uint8_t *data;
    size_t size;
    size_t offset;
} FuzzedData;

/**
 * @brief Initializes the FuzzedData structure.
 * @param fd Pointer to the FuzzedData structure.
 * @param data Pointer to the raw fuzzer input data.
 * @param size Size of the raw fuzzer input data.
 */
void FuzzedData_init(FuzzedData *fd, const uint8_t *data, size_t size) {
    fd->data = data;
    fd->size = size;
    fd->offset = 0;
}

/**
 * @brief Returns the number of remaining bytes in the fuzzer input.
 * @param fd Pointer to the FuzzedData structure.
 * @return Number of remaining bytes.
 */
size_t FuzzedData_remaining_bytes(FuzzedData *fd) {
    return fd->size - fd->offset;
}

/**
 * @brief Consumes a specified number of bytes from the fuzzer input.
 * @param fd Pointer to the FuzzedData structure.
 * @param num_bytes The desired number of bytes to consume.
 * @param out_len Optional pointer to store the actual number of bytes consumed.
 * @return Pointer to the consumed bytes, or NULL if not enough data.
 */
const uint8_t *FuzzedData_ConsumeBytes(FuzzedData *fd, size_t num_bytes, size_t *out_len) {
    size_t actual_num_bytes = num_bytes;
    if (fd->offset + actual_num_bytes > fd->size) {
        actual_num_bytes = FuzzedData_remaining_bytes(fd);
    }
    const uint8_t *ptr = fd->data + fd->offset;
    fd->offset += actual_num_bytes;
    if (out_len) {
        *out_len = actual_num_bytes;
    }
    return ptr;
}

/**
 * @brief Consumes a uLong from the fuzzer input.
 * @param fd Pointer to the FuzzedData structure.
 * @return The consumed uLong value. Returns 0 if not enough data.
 */
uLong FuzzedData_ConsumeIntegral_uLong(FuzzedData *fd) {
    uLong val = 0;
    size_t bytes_to_consume = sizeof(uLong);
    if (FuzzedData_remaining_bytes(fd) < bytes_to_consume) {
        bytes_to_consume = FuzzedData_remaining_bytes(fd);
    }
    // Ensure we don't read beyond bounds if bytes_to_consume is 0
    if (bytes_to_consume > 0) {
        memcpy(&val, fd->data + fd->offset, bytes_to_consume);
    }
    fd->offset += bytes_to_consume;
    return val;
}

/**
