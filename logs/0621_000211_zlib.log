 * @param fd Pointer to the FuzzedData structure.
 * @param min Minimum value (inclusive).
 * @param max Maximum value (inclusive).
 * @return The consumed int value within the range. Returns min if not enough data.
 */
int FuzzedData_ConsumeIntegralInRange_int(FuzzedData *fd, int min, int max) {
    if (FuzzedData_remaining_bytes(fd) < sizeof(int)) {
        return min; // Not enough data, return min
    }
    int val;
    memcpy(&val, fd->data + fd->offset, sizeof(int));
    fd->offset += sizeof(int);
    if (max == min) return min;
    return min + (abs(val) % (max - min + 1));
}

/**
