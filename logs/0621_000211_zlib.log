    int val;
    size_t consumed_len;
    const uint8_t *bytes = FuzzedData_ConsumeBytes(fd, sizeof(int), &consumed_len);
    if (consumed_len < sizeof(int)) {
        return min_val;
    }
    memcpy(&val, bytes, sizeof(int));
    // Simple mapping to range, might not be perfectly uniform but provides diversity
    if (min_val == max_val) return min_val;
    return min_val + (abs(val) % (max_val - min_val + 1));
}

