// Define a macro for safe memory deallocation to prevent double-free or use-after-free.
#define SAFE_FREE(ptr) do { if (ptr) { free(ptr); ptr = NULL; } } while(0)

// Helper function to extract an integer from the fuzzer input and advance the data pointer.
// Returns 0 if not enough data is available, ensuring safe consumption.
static int get_fuzzed_int(const uint8_t **data, size_t *size) {
    if (*size < sizeof(int)) {
        return 0; // Not enough data, return a default/safe value (0)
    }
    int val;
    memcpy(&val, *data, sizeof(int));
    *data += sizeof(int);
    *size -= sizeof(int);
    return val;
}

// Helper function to extract a single byte from the fuzzer input and advance the data pointer.
// Returns 0 if no data is available.
static uint8_t get_fuzzed_byte(const uint8_t **data, size_t *size) {
    if (*size == 0) {
        return 0; // Not enough data
    }
    uint8_t val = **data;
    (*data)++;
    (*size)--;
    return val;
}

// LLVMFuzzerTestOneInput is the entry point for the fuzzer.
// It takes raw fuzzer input (Data, Size) and uses it to exercise zlib APIs.
int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    // Create mutable copies of Data and Size to allow consumption by helper functions.
    const uint8_t *current_data = Data;
    size_t current_size = Size;

    // 1. Test zlibCompileFlags
    // This function reports compile-time flags of zlib. Calling it directly
