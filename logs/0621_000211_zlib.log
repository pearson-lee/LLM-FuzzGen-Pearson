// Dummy FuzzedData struct and functions for compilation.
// In a real fuzzing environment, these would be provided by the harness.
typedef struct {
    const uint8_t *data;
    size_t size;
    size_t offset;
} FuzzedData;

void FuzzedData_init(FuzzedData *fd, const uint8_t *Data, size_t Size) {
    fd->data = Data;
    fd->size = Size;
    fd->offset = 0;
}

size_t FuzzedData_remaining_bytes(FuzzedData *fd) {
    if (fd->offset >= fd->size) {
        return 0;
    }
    return fd->size - fd->offset;
}

const uint8_t *FuzzedData_ConsumeBytes(FuzzedData *fd, size_t num_bytes, size_t *consumed_len) {
    if (fd->offset >= fd->size) {
        *consumed_len = 0;
        return NULL;
    }
    size_t bytes_to_consume = num_bytes;
    if (fd->offset + bytes_to_consume > fd->size) {
        bytes_to_consume = fd->size - fd->offset;
    }
    const uint8_t *ptr = fd->data + fd->offset;
    fd->offset += bytes_to_consume;
    *consumed_len = bytes_to_consume;
    return ptr;
}

int FuzzedData_ConsumeIntegralInRange_int(FuzzedData *fd, int min_val, int max_val) {
    if (FuzzedData_remaining_bytes(fd) < sizeof(int)) {
        return min_val;
    }
    int val;
    size_t consumed_len;
    const uint8_t *bytes = FuzzedData_ConsumeBytes(fd, sizeof(int), &consumed_len);
    if (consumed_len < sizeof(int)) {
        return min_val;
    }
    memcpy(&val, bytes, sizeof(int));
    // Simple mapping to range, might not be perfectly uniform but provides diversity
    if (min_val == max_val) return min_val;
    return min_val + (abs(val) % (max_val - min_val + 1));
}

unsigned int FuzzedData_ConsumeIntegralInRange_uint(FuzzedData *fd, unsigned int min_val, unsigned int max_val) {
    if (FuzzedData_remaining_bytes(fd) < sizeof(unsigned int)) {
