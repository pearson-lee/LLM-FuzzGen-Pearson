// Helper to consume data from the fuzzer input
// This is a simplified version of FuzzedDataProvider for C
typedef struct {
    const uint8_t *data;
    size_t size;
    size_t offset;
} FuzzerInput;

void FuzzerInput_Init(FuzzerInput *input, const uint8_t *Data, size_t Size) {
    input->data = Data;
    input->size = Size;
    input->offset = 0;
}

size_t FuzzerInput_RemainingBytes(FuzzerInput *input) {
    if (input->offset >= input->size) {
        return 0;
    }
    return input->size - input->offset;
}

// Modified to return the actual number of bytes consumed
const uint8_t *FuzzerInput_ConsumeBytes(FuzzerInput *input, size_t *num_bytes_ptr) {
    size_t num_bytes = *num_bytes_ptr;
    if (input->offset + num_bytes > input->size) {
        num_bytes = FuzzerInput_RemainingBytes(input);
    }
    const uint8_t *consumed_data = input->data + input->offset;
    input->offset += num_bytes;
    *num_bytes_ptr = num_bytes; // Update the actual number of bytes consumed
    return consumed_data;
}

uint8_t FuzzerInput_ConsumeUint8(FuzzerInput *input) {
    if (FuzzerInput_RemainingBytes(input) == 0) {
        return 0; // Default or error value
    }
    uint8_t value = input->data[input->offset];
    input->offset++;
    return value;
}

int FuzzerInput_ConsumeIntInRange(FuzzerInput *input, int min, int max) {
    if (FuzzerInput_RemainingBytes(input) < sizeof(int)) {
        return min; // Not enough data, return min
    }
    int value;
    memcpy(&value, input->data + input->offset, sizeof(int));
    input->offset += sizeof(int);
    // Map value to range [min, max]
    return min + (abs(value) % (max - min + 1));
}

