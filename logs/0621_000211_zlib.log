#include <string.h>
#include <stdio.h>
#include <stdarg.h> // Required for va_list, va_start, va_end

// Required zlib headers
#include "/src/zlib/zlib.h"
#include "/src/zlib/gzguts.h" // For gz_statep and internal structures

// Custom allocation and free functions for zlib to track memory
static voidpf zlib_alloc_func(voidpf opaque, uInt items, uInt size) {
    (void)opaque;
    return calloc(items, size);
}

static void zlib_free_func(voidpf opaque, voidpf address) {
    (void)opaque;
    free(address);
}

// Helper function to wrap gzvprintf with variadic arguments.
// The original error indicated that gzvprintf expects a va_list, not direct variadic arguments.
// This helper function correctly constructs a va_list and passes it to gzvprintf.
static int my_gzprintf(gzFile file, const char *format, ...) {
    va_list args;
    va_start(args, format);
    int ret = gzvprintf(file, format, args);
    va_end(args);
    return ret;
}

int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    // Ensure there's enough data for basic operations
    if (Size < 10) {
        return 0;
    }

    // Use a temporary file for gzFile operations
    const char *filename = "fuzz_temp.gz";
    gzFile file = NULL;
    char format_buffer[256];
    size_t format_len = Size > 255 ? 255 : Size;

    // Copy fuzzer data to format buffer, ensuring null termination
    memcpy(format_buffer, Data, format_len);
    // Ensure null termination. Size is guaranteed to be >= 10, so format_len >= 10.
    // Thus, format_len - 1 is a safe index.
    format_buffer[format_len - 1] = '\0';

    // Scenario 1: Test with NULL file to hit the 'file == NULL' branch in gzvprintf
    // Using the helper function to correctly pass arguments.
    my_gzprintf(NULL, "%s", "test");

    // Scenario 2: Valid file operations
    file = gzopen(filename, "wb");
    if (file) {
        // Get internal state to manipulate for coverage
        gz_statep state = (gz_statep)file;

        // Test with a simple format string
        my_gzprintf(file, "Hello, %s!\n", "fuzzer");

        // Test with fuzzer-provided data as a string argument, not as a format string.
        // This resolves the "unexpected format specifier" crash by ensuring the format string is always "%s".
        my_gzprintf(file, "%s", format_buffer);

        // Scenario 3: Induce an error state in gzFile to hit 'state->err != Z_OK' branch
        state->err = Z_MEM_ERROR; // Manually set an error
        // Using the helper function to correctly pass arguments.
        my_gzprintf(file, "This should hit an error branch.\n");
        state->err = Z_OK; // Reset error for further operations

        // Scenario 4: Attempt to trigger 'state->seek' branch
        // This requires manipulating internal state not directly exposed by API
        // For demonstration, we'll simulate a seek condition if possible.
        // In a real scenario, a prior gzseek call would set this.
        state->seek = 1;
        state->skip = 10; // Simulate skipping 10 bytes
        // Using the helper function to correctly pass arguments.
        my_gzprintf(file, "This should trigger seek logic.\n");
        state->seek = 0; // Reset

        // Scenario 5: Test large input to potentially exceed buffer size or trigger 'strm->avail_in >= state->size'
        // This is hard to control precisely with gzvprintf alone, as it manages its own buffer.
        // We'll just provide a large string.
        char large_string[1024];
        memset(large_string, 'A', sizeof(large_string) - 1);
        large_string[sizeof(large_string) - 1] = '\0';
        my_gzprintf(file, "%s", large_string);

        // Clean up
        gzclose(file);
    }

    // Clean up the temporary file
    remove(filename);

    return 0;
}[0m
