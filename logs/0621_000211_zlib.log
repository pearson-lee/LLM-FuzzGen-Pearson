// Custom C-style FuzzedDataProvider replacement
// This structure and its functions mimic the behavior of FuzzedDataProvider
// for consuming bytes and integral types from the input data in a C-compatible way.
typedef struct {
    const uint8_t *data;
    size_t size;
    size_t offset;
} FuzzedData;

// Initializes the FuzzedData structure with the input data and size.
static void FuzzedData_init(FuzzedData *fd, const uint8_t *Data, size_t Size) {
    fd->data = Data;
    fd->size = Size;
    fd->offset = 0;
}

// Consumes 'num_bytes' from the input data. Returns a pointer to the consumed
// data or NULL if not enough bytes are available.
static const uint8_t *FuzzedData_ConsumeBytes(FuzzedData *fd, size_t num_bytes) {
    if (fd->offset + num_bytes > fd->size) {
        fd->offset = fd->size; // Mark as consumed all remaining
        return NULL;
    }
    const uint8_t *ptr = fd->data + fd->offset;
    fd->offset += num_bytes;
    return ptr;
}

// Consumes an unsigned int within a specified range.
static unsigned int FuzzedData_ConsumeIntegralInRange_uint(FuzzedData *fd, unsigned int min_val, unsigned int max_val) {
    if (fd->offset + sizeof(unsigned int) > fd->size) {
        fd->offset = fd->size;
        return min_val; // Default to min if not enough data
    }
    unsigned int val;
    memcpy(&val, fd->data + fd->offset, sizeof(unsigned int));
    fd->offset += sizeof(unsigned int);
    return min_val + (val % (max_val - min_val + 1));
}

// Consumes an int within a specified range.
static int FuzzedData_ConsumeIntegralInRange_int(FuzzedData *fd, int min_val, int max_val) {
    if (fd->offset + sizeof(int) > fd->size) {
        fd->offset = fd->size;
        return min_val; // Default to min if not enough data
    }
    int val;
    memcpy(&val, fd->data + fd->offset, sizeof(int));
    fd->offset += sizeof(int);
    return min_val + (val % (max_val - min_val + 1));
}

// Consumes a size_t within a specified range.
static size_t FuzzedData_ConsumeIntegralInRange_size_t(FuzzedData *fd, size_t min_val, size_t max_val) {
    if (fd->offset + sizeof(size_t) > fd->size) {
        fd->offset = fd->size;
        return min_val; // Default to min if not enough data
    }
    size_t val;
    memcpy(&val, fd->data + fd->offset, sizeof(size_t));
    fd->offset += sizeof(size_t);
    return min_val + (val % (max_val - min_val + 1));
}

// Consumes a uLong.
static uLong FuzzedData_ConsumeIntegral_uLong(FuzzedData *fd) {
    if (fd->offset + sizeof(uLong) > fd->size) {
        fd->offset = fd->size;
        return 0; // Default if not enough data
    }
    uLong val;
    memcpy(&val, fd->data + fd->offset, sizeof(uLong));
    fd->offset += sizeof(uLong);
