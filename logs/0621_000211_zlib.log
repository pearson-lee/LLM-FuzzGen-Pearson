        int windowBits_param = get_fuzzed_int(&current_data, &current_size);
        int wrap_type = get_fuzzed_int(&current_data, &current_size) % 3; // 0: raw, 1: zlib, 2: gzip

        int windowBits;
        // Adjust windowBits based on wrap_type to target specific code paths in deflateBound.
        if (wrap_type == 2) { // GZIP wrapper
            windowBits = 16 + MAX_WBITS;
        } else if (wrap_type == 0) { // Raw deflate
            windowBits = -MAX_WBITS;
        } else { // Zlib wrapper
            windowBits = MAX_WBITS;
        }
        // Further fuzz windowBits within a common range (8 to 15) for standard compression.
        windowBits = (windowBits_param % 16) + 8;

        // Initialize the deflate stream.
        ret_deflate = deflateInit2_(&strm_deflate, Z_DEFAULT_COMPRESSION, Z_DEFLATED, windowBits, 8, strategy, ZLIB_VERSION, sizeof(z_stream));

        if (ret_deflate == Z_OK) {
