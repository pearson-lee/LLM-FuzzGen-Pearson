    } else {
        return min_val;
    }

    if (min_val == max_val) {
        return min_val;
    }
    return min_val + (val % (max_val - min_val + 1));
}


// Fuzz target for zlib
int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedData fd;
    FuzzedData_init(&fd, Data, Size);

    // --- 1. Fuzz zlibCompileFlags (no specific input needed, just call) ---
