z_word_t crc_word_big(z_word_t data);

// Fuzz target for zlib
int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    // Ensure we have at least some data to work with
    if (Size < 10) {
        return 0;
    }

    // --- Fuzzing gzgetc_ ---
    // gzgetc_ is a macro that calls gzgetc, which operates on a gzFile.
    // To hit gzgetc_, we need to create a valid gzFile.
    // We'll create a temporary file, write some data, and then read from it.
    char filename[] = "/tmp/fuzz_gzfile_XXXXXX";
    int fd = mkstemp(filename);
    if (fd == -1) {
        return 0;
    }
    gzFile gz_file = gzdopen(fd, "wb"); // Open for writing
    if (gz_file) {
        // Write some data to the gzFile
        gzwrite(gz_file, Data, Size);
        gzclose(gz_file); // Close the file to flush and finalize

        // Reopen the file for reading to test gzgetc_
        gz_file = gzdopen(fd, "rb");
        if (gz_file) {
            // Read a character using gzgetc_
            gzgetc_(gz_file);
            gzclose(gz_file); // Close the file
        }
    }
    unlink(filename); // Clean up the temporary file

    // --- Fuzzing byte_swap and crc_word_big ---
    // These functions operate on z_word_t, which is typically unsigned long.
    // We'll extract a word from the input data and pass it to these functions.
    if (Size >= sizeof(z_word_t)) {
        z_word_t word_to_swap;
        memcpy(&word_to_swap, Data, sizeof(z_word_t));
        byte_swap(word_to_swap);
        crc_word_big(word_to_swap);
    }

    // --- Fuzzing compress2 and uncompress2 ---
    // We'll use a portion of the input data for compression and decompression.
    // Varying the compression level and input size can help hit more branches.
    if (Size > 0) {
        uLongf compressed_len = compressBound(Size);
        Bytef *compressed_data = (Bytef *)malloc(compressed_len);
        if (compressed_data) {
            int level = (Data[0] % 10) - 1; // Z_DEFAULT_COMPRESSION to Z_BEST_COMPRESSION, or Z_NO_COMPRESSION
            if (level < Z_NO_COMPRESSION) level = Z_DEFAULT_COMPRESSION; // Ensure valid level

            // Test compress2
            compress2(compressed_data, &compressed_len, (const Bytef *)Data, Size, level);

            // Test uncompress2
            uLongf uncompressed_len = Size * 2; // Allocate more space for uncompressed data
            Bytef *uncompressed_data = (Bytef *)malloc(uncompressed_len);
            if (uncompressed_data) {
                uncompress2(uncompressed_data, &uncompressed_len, compressed_data, &compressed_len);
                free(uncompressed_data);
            }
            free(compressed_data);
        }
    }

    // --- Fuzzing gzclose, gzclose_r, gzclose_w with various states ---
    // Test gzclose with NULL file to hit the Z_STREAM_ERROR path
    gzclose(NULL);

    // Test gzclose_r with NULL file
    gzclose_r(NULL);

    // Test gzclose_w with NULL file
    gzclose_w(NULL);

    // Test gzclose_r with a valid but potentially invalid state (e.g., wrong mode)
    // This requires creating a gz_state structure and manipulating it.
    // This is more complex and might require internal knowledge of zlib's state machine.
    // For now, we'll rely on the previous gzFile operations to cover valid states.
