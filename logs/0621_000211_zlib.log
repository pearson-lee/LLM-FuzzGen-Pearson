// --- Custom Zlib Allocation/Free Functions for Memory Safety ---
// These functions are passed to zlib to ensure all internal allocations
// are handled by standard library functions, allowing fuzzing tools
// to detect memory errors more effectively.
voidpf zlib_alloc_func(voidpf opaque, uInt items, uInt size) {
    (void)opaque; // Opaque pointer is unused in this context
    // Prevent integer overflow during multiplication
    if (items > (SIZE_MAX / size)) {
        return Z_NULL;
    }
    return calloc(items, size); // Use calloc for zero-initialized memory
}

void zlib_free_func(voidpf opaque, voidpf address) {
    (void)opaque; // Opaque pointer is unused in this context
    free(address);
}

