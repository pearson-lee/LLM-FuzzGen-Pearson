    if (bad_state) {
        bad_state->mode = GZ_WRITE; // Set to write mode for gzclose_r test
        gzclose_r((gzFile)bad_state);
        bad_state->mode = GZ_READ; // Set to read mode for gzclose_w test
        gzclose_w((gzFile)bad_state);
        free(bad_state);
    }
    */

    return 0;
}[0m
