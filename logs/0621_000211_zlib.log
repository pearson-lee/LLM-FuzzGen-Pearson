        deflateEnd(&strm_deflate);
        free(deflate_out);
    }

    // Initialize inflate
    if (inflateInit(&strm_inflate) == Z_OK) {
        // Allocate output buffer for inflate
        size_t inflate_out_size = Size * 2 + 100;
        Bytef *inflate_out = (Bytef *)malloc(inflate_out_size);
        if (inflate_out == NULL) {
            inflateEnd(&strm_inflate);
            return 0;
        }

        strm_inflate.avail_in = Size;
        strm_inflate.next_in = (Bytef *)Data;
        strm_inflate.avail_out = inflate_out_size;
        strm_inflate.next_out = inflate_out;

