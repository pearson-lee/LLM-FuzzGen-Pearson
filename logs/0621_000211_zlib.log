const uint8_t *FuzzedData_ConsumeBytes(FuzzedData *fd, size_t num_bytes, size_t *out_len) {
    if (fd->offset + num_bytes > fd->size) {
        num_bytes = FuzzedData_remaining_bytes(fd);
    }
    const uint8_t *ptr = fd->data + fd->offset;
    fd->offset += num_bytes;
    if (out_len) {
        *out_len = num_bytes;
    }
    return ptr;
}

