            // Ensure enough fuzzer data is available for header fields.
            if (wrap_type == 2 && current_size >= 10) {
                gz_header *head = (gz_header *)malloc(sizeof(gz_header));
                if (head) {
                    memset(head, 0, sizeof(gz_header)); // Initialize header to zero
                    head->text = get_fuzzed_byte(&current_data, &current_size) % 2;
                    head->time = get_fuzzed_int(&current_data, &current_size);
                    head->xflags = get_fuzzed_byte(&current_data, &current_size) % 2;
                    head->os = get_fuzzed_byte(&current_data, &current_size);

                    // Fuzz lengths for extra, name, and comment fields to cover various paths.
                    // Ensure we don't read beyond available fuzzer data.
                    size_t extra_len = get_fuzzed_byte(&current_data, &current_size) % (current_size + 1);
                    if (extra_len > 0 && current_size >= extra_len) {
                        head->extra = (Bytef *)malloc(extra_len);
                        if (head->extra) {
                            memcpy(head->extra, current_data, extra_len);
                            current_data += extra_len;
                            current_size -= extra_len;
                            head->extra_len = extra_len;
                            // head->done_extra = 1; // This member does not exist in gz_header_s
