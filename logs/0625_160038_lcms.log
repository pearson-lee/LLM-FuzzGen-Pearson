  if (segments == NULL) {
    cmsDeleteContext(ctx);
    return 0;
  }

  float last_break = 0.0f;
  for (uint32_t i = 0; i < num_segments; ++i) {
    uint8_t type;
    if (!consume_byte(&f, &type))
      break;

    segments[i].x0 = last_break;
    if (i < num_segments - 1) {
      if (!consume_float(&f, &segments[i].x1))
        break;
      // Ensure breakpoints are monotonic for a valid curve.
      if (segments[i].x1 <= last_break) {
        segments[i].x1 = last_break + 0.1f;
      }
      last_break = segments[i].x1;
    } else {
      segments[i].x1 = 1.0f;
    }

    if (type % 2 == 0) { // Create a sampled segment.
      segments[i].Type = 0;
      uint32_t num_points;
      if (!consume_u32(&f, &num_points))
        break;
      num_points = (num_points % 50) + 2; // Need at least 2 points.

      segments[i].nGridPoints = num_points;
      segments[i].SampledPoints = (cmsFloat32Number *)calloc(num_points, sizeof(cmsFloat32Number));
      if (segments[i].SampledPoints == NULL)
        break;

      for (uint32_t j = 0; j < num_points; ++j) {
        if (!consume_float(&f, &segments[i].SampledPoints[j])) {
          goto end_segment_creation; // Exit if data runs out.
        }
      }
    } else { // Create a formula-based segment.
      uint8_t formula_type;
