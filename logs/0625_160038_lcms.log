#include "lcms2.h"
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

// Fuzzer entry point.
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 1) {
    return 0;
  }

  // Create a memory-based I/O handler for reading profile data.
  // This allows us to treat the fuzzer input as a file in memory.
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(NULL, size, "r", data);
  if (io == NULL) {
    return 0;
  }

  // Attempt to open a profile from the fuzzer-provided data.
  // This is a primary entry point for parsing complex ICC profile structures.
  cmsHPROFILE hProfile = cmsOpenProfileFromIOhandler(NULL, io);

  // The core logic of the fuzzer only proceeds if a valid profile was successfully parsed.
  // This ensures that we are fuzzing deeper functions with valid, complex objects.
  if (hProfile != NULL) {
    // Exercise the API to get the number of tags in the profile.
    cmsGetTagCount(hProfile);

    // Read the media white point tag, which is essential for color calculations.
    // This exercises tag-reading and data conversion functionalities.
    cmsCIEXYZ *whitePoint = (cmsCIEXYZ *)cmsReadTag(hProfile, cmsSigMediaWhitePointTag);
    if (whitePoint != NULL) {
      // If the white point is successfully read, free the allocated structure.
      cmsFreeTag(hProfile, cmsSigMediaWhitePointTag, whitePoint);
    }

    // Read the chromatic adaptation tag, another critical component for transformations.
    cmsMAT3 *chad = (cmsMAT3 *)cmsReadTag(hProfile, cmsSigChromaticAdaptationTag);
    if (chad != NULL) {
      // Free the allocated structure if the read was successful.
      cmsFreeTag(hProfile, cmsSigChromaticAdaptationTag, chad);
    }

    // Attempt to read the AToB1 tag, which contains a lookup table (LUT) for transformations.
    // This is a complex structure and a valuable fuzzing target.
    cmsPipeline *lut = (cmsPipeline *)cmsReadTag(hProfile, cmsSigAToB1Tag);
    if (lut != NULL) {
      // If the LUT is read, duplicate it to test memory management and copying logic.
      cmsPipeline *lutDup = cmsPipelineDup(lut);
      if (lutDup != NULL) {
        // Free the duplicated LUT.
        cmsPipelineFree(lutDup);
      }
      // Free the original LUT.
      cmsPipelineFree(lut);
    }

    // Close the profile handle to release all associated resources.
    cmsCloseProfile(hProfile);
  }

  // Close the I/O handler, which also frees the associated memory.
  cmsCloseIOhandler(io);

  return 0;
}[0m
