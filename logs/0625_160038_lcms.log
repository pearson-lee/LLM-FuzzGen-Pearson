int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (ctx == NULL) {
    return 0;
  }

  // Treat the fuzzer input as a memory buffer containing a full ICC profile.
  cmsHPROFILE hProfile = cmsOpenProfileFromMem(data, size);
  if (hProfile == NULL) {
    // The input was not a valid profile, which is a valid fuzzing outcome.
    cmsDeleteContext(ctx);
    return 0;
  }

  // An array of tag signatures to test their corresponding read handlers.
  // These handlers were the original fuzzing targets.
  cmsTagSignature tags_to_read[] = {
