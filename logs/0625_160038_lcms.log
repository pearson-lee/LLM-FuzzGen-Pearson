#include "lcms2.h"
#include <stdint.h>

// Fuzzer entry point.
// The fuzzer's input data is treated as a potential ICC profile file.
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size == 0) {
    return 0;
  }

  // Attempt to open the data as an in-memory ICC profile.
  // This function is the primary entry point for parsing profile data.
  cmsHPROFILE hProfile = cmsOpenProfileFromMem(NULL, data, size);
  if (hProfile == NULL) {
    return 0; // Not a valid profile, nothing more to do.
  }

  // Target 1: Read the Video Card Gamma Table (vcgt) tag.
  // This exercises the Type_vcgt_Read function.
  // The returned object is an array of 3 tone curves.
  cmsToneCurve **vcgt = (cmsToneCurve **)cmsReadTag(hProfile, cmsSigVcgtTag);
  if (vcgt != NULL) {
    // The caller of cmsReadTag is responsible for freeing the returned data.
    cmsFreeToneCurveTriple(vcgt);
  }

  // Target 2: Read the Profile Sequence Description (pseq) tag.
  // This exercises the Type_ProfileSequenceDesc_Read function.
  cmsSEQ *seq = (cmsSEQ *)cmsReadTag(hProfile, cmsSigProfileSequenceDescTag);
  if (seq != NULL) {
    cmsFreeProfileSequenceDescription(seq);
  }

  // Target 3: Read the Colorant Table (clrt) tag.
  // This exercises the Type_ColorantTable_Read function.
  cmsNamedColorList *clrt =
      (cmsNamedColorList *)cmsReadTag(hProfile, cmsSigColorantTableTag);
  if (clrt != NULL) {
    cmsFreeNamedColorList(clrt);
  }

  // Target 4: Read the Dictionary (dict) tag.
  // This exercises the Type_Dictionary_Read function.
  cmsHANDLE dict = (cmsHANDLE)cmsReadTag(hProfile, cmsSigDictTag);
  if (dict != NULL) {
    cmsDictFree(dict);
  }

  // Target 5: Read the Multi-Process Element (mpe) tag.
  // This exercises the Type_MPE_Read function.
  cmsStage *mpe = (cmsStage *)cmsReadTag(hProfile, cmsSigMpeType);
  if (mpe != NULL) {
    cmsStageFree(mpe);
  }

  // Clean up all resources associated with the profile.
  cmsCloseProfile(hProfile);

  return 0;
}[0m
