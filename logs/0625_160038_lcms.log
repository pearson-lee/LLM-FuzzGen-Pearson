      memcpy(input_buffer, Data + 150, 3);
      cmsDoTransform(hTransform, input_buffer, output_buffer, 1);
      cmsDeleteTransform(hTransform);
    }
    cmsCloseProfile(hLabProfile);
  }

  // --- PostScript Generation ---
  cmsUInt32Number ps_intent = Data[0] % 4;
