  // This is necessary to cover Type_Dictionary_Read/Write functions, which were at 0% coverage.
  cmsPlugin(&cmsPluginDict);

  // Create a context.
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (!ctx) {
    return 0;
  }

  // Suppress error messages.
  cmsSetLogErrorHandler(NULL);

