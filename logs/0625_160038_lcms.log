      case cmsSigAToB0Tag:
        cmsPipelineFree((cmsPipeline *)tag_data);
        break;
      default:
        // Should not be reached.
        break;
      }
    }
  }

  cmsCloseProfile(hProfile);
  cmsDeleteContext(ctx);

  return 0;
}[0m
