// Fuzz target entry point
int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  if (Size < 1) {
    return 0;
  }

  // Use the first byte of the input to select which function to test.
  uint8_t choice = Data[0];
  Data++;
  Size--;

  // Create a lcms context. This is required for memory management and error handling.
  cmsContext context = cmsCreateContext(NULL, NULL);
  if (context == NULL) {
    return 0;
  }

  // The internal _cms_typehandler_struct is used to pass the context to the
  // static-like reading functions. We only need to set the ContextID.
  struct _cms_typehandler_struct handler;
  handler.ContextID = context;
  // Other fields in the handler are not used by the targeted functions.

  // Create an in-memory IO handler from the fuzzer input.
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(context, (cmsUInt8Number *)Data, Size, "r");
  if (io == NULL) {
    cmsDeleteContext(context);
    return 0;
  }

  // Based on the choice byte, call one of the target functions.
  switch (choice % 4) {
  case 0: {
    cmsUInt32Number nItems = 0;
    // The SizeOfTag would normally be read from the profile tag directory.
    // Here we pass the remaining input size.
    void *data = Type_Data_Read(&handler, io, &nItems, Size);
    if (data != NULL) {
      // Type_Data_Read returns a cmsICCData struct allocated with _cmsMalloc.
      // It must be freed with _cmsFree to prevent memory leaks.
      _cmsFree(context, data);
    }
    break;
  }
  case 1: {
    cmsUInt32Number nItems = 0;
    // The videoSignalType tag has a fixed size of 8 bytes for its data.
    // We only call if the input is large enough.
    if (Size >= 8) {
      void *vs = Type_VideoSignal_Read(&handler, io, &nItems, 8);
      if (vs != NULL) {
        // Type_VideoSignal_Read returns a cmsVideoSignalType struct.
        // It must be freed to prevent memory leaks.
        _cmsFree(context, vs);
      }
    }
    break;
  }
  case 2: {
    cmsUInt32Number nItems = 0;
    // Type_MPEcurve_Read parses a multi-process element curve.
    void *mpe = Type_MPEcurve_Read(&handler, io, &nItems, Size);
    if (mpe != NULL) {
      // The function returns a cmsStage object, which must be freed
      // using cmsStageFree.
      cmsStageFree((cmsStage *)mpe);
    }
    break;
  }
  case 3: {
    // ReadSegmentedCurve parses complex segmented curve data.
    cmsToneCurve *curve = ReadSegmentedCurve(&handler, io);
    if (curve != NULL) {
      // The returned tone curve must be freed with cmsFreeToneCurve.
      cmsFreeToneCurve(curve);
    }
    break;
  }
  }

  // Clean up all allocated resources.
  cmsCloseIOhandler(io);
  cmsDeleteContext(context);

  return 0;
