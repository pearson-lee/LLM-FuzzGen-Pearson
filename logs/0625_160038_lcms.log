static
cmsBool ReadPositionTable(struct _cms_typehandler_struct* self,
                          cmsIOHANDLER*      io,
                          cmsUInt32Number    Count,
                          cmsUInt32Number    BaseOffset,
                          void*              Cargo,
                          PositionTableReader Reader)
{
    cmsUInt32Number i;
    cmsUInt32Number *ElementOffsets = NULL, *ElementSizes = NULL;
    cmsUInt32Number currentPos;
    void** Ptr = (void**) Cargo;

    currentPos = io->Tell(io);
    ElementOffsets = (cmsUInt32Number*) _cmsCalloc(self->ContextID, Count, sizeof(cmsUInt32Number));
    if (ElementOffsets == NULL) goto Error;

    ElementSizes = (cmsUInt32Number*) _cmsCalloc(self->ContextID, Count, sizeof(cmsUInt32Number));
    if (ElementSizes == NULL) goto Error;

    for (i=0; i < Count; i++) {
        if (!_cmsReadUInt32Number(io, &ElementOffsets[i])) goto Error;
        if (!_cmsReadUInt32Number(io, &ElementSizes[i])) goto Error;
    }

    for (i=0; i < Count; i++) {
        if (!io->Seek(io, BaseOffset + ElementOffsets[i])) goto Error;
        Ptr[i] = Reader(self, io, NULL, ElementSizes[i]);
        if (Ptr[i] == NULL) goto Error;
    }

    if (ElementOffsets != NULL) _cmsFree(self->ContextID, ElementOffsets);
    if (ElementSizes != NULL) _cmsFree(self->ContextID, ElementSizes);
    io->Seek(io, currentPos + Count * 2 * sizeof(cmsUInt32Number));
    return TRUE;

Error:
    if (ElementOffsets != NULL) _cmsFree(self->ContextID, ElementOffsets);
    if (ElementSizes != NULL) _cmsFree(self->ContextID, ElementSizes);
    return FALSE;
}

