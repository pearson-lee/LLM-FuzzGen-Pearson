  // The duplicated sequence is freed immediately to prevent memory leaks.
  cmsSEQ* dup_seq = cmsDupProfileSequenceDescription(seq);
  if (dup_seq) {
      cmsFreeProfileSequenceDescription(dup_seq);
  }

