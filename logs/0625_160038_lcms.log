      cmsWriteTag(hProfile, cmsSigProfileSequenceDescTag, seq);
      cmsFreeProfileSequenceDescription(seq); // Clean up the sequence object.
    }
  }

  // COVERAGE ENHANCEMENT: Add UCR/BG tag to exercise Type_UcrBg_Write/Read
  // and related tone curve functions in cmsgamma.c, which were poorly covered.
  if ((control & 0x20) && remaining_size > 0) {
    cmsUCRBG *ucrbg = (cmsUCRBG *)malloc(sizeof(cmsUCRBG));
    if (ucrbg) {
      double gamma_ucr = (remaining_size > 1) ? (current_data[0] / 255.0 * 3.0 + 0.1) : 2.2;
      double gamma_bg = (remaining_size > 2) ? (current_data[1] / 255.0 * 3.0 + 0.1) : 1.8;

      ucrbg->Ucr = cmsBuildGamma(ctx, gamma_ucr);
      ucrbg->Bg = cmsBuildGamma(ctx, gamma_bg);
      ucrbg->Desc = cmsMLUalloc(ctx, 1);

      if (ucrbg->Ucr && ucrbg->Bg && ucrbg->Desc) {
