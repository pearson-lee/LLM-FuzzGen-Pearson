        }

        // Free the strings allocated in this loop iteration.
        free(s1);
        free(s2);
        free(s3);
    }

    // Added to cover cmsIT8GetPropertyDbl, which was previously uncovered.
    cmsIT8GetPropertyDbl(hIT8, "NUMBER_OF_FIELDS");

