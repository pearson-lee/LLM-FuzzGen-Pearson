    }

    // Create a pipeline and add the stages.
    cmsPipeline *pipeline = cmsPipelineAlloc(context, 3, 3);
    if (pipeline) {
        if (stage1) cmsPipelineInsertStage(pipeline, cmsAT_END, stage1);
