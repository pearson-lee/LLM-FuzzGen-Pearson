// Helper function to create a dummy profile with the provided data as a tag
static cmsHPROFILE CreateDummyProfile(cmsContext ContextID, const uint8_t *Data, size_t Size) {
  cmsHPROFILE hProfile;
  cmsICCHeader Header;
  cmsTagEntry Tag;
  cmsIOHANDLER *mem;

  // Create an in-memory IO handler
  mem = cmsOpenIOhandlerFromMem(ContextID, NULL, 0, "w");
  if (mem == NULL)
    return NULL;

  // Prepare a dummy header
  memset(&Header, 0, sizeof(Header));
  Header.magic = cmsMagicNumber;
  Header.version = 0x02100000;
  Header.renderingIntent = INTENT_PERCEPTUAL;
  Header.flags = cmsFLAGS_EMBEDDEDPROFILE;
  // This is a fake profile, so we use a fake signature
  Header.profileID.ID32[0] = 0xDEADBEEF;

  if (!_cmsWriteHeader(mem, &Header)) {
    cmsCloseIOhandler(mem);
    return NULL;
  }

  // Prepare a single tag entry
  Tag.sig = cmsSigProfileDescriptionTag; // A placeholder tag
  Tag.offset = sizeof(cmsICCHeader) + sizeof(cmsTagEntry) + sizeof(cmsUInt32Number);
  Tag.size = (cmsUInt32Number)Size;

  // Write tag count and the tag entry
  if (!cmsWriteUInt32Number(mem, 1))
    goto Error;
  if (!cmsWriteTag(mem, &Tag))
    goto Error;

  // Write the actual fuzzer data as the tag's content
  if (!cmsWriteUInt32Number(mem, (cmsUInt32Number)Size))
    goto Error;
  if (!mem->Write(mem, (cmsUInt32Number)Size, (void *)Data))
    goto Error;

  // Get the profile from the memory buffer
  cmsUInt32Number profileSize;
  void *profileData = cmsCloseIOhandler(mem, &profileSize);
  if (profileData == NULL)
    return NULL;

  hProfile = cmsOpenProfileFromMem(ContextID, profileData, profileSize);
  free(profileData); // cmsOpenProfileFromMem makes a copy

  return hProfile;

Error:
  cmsCloseIOhandler(mem);
  return NULL;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (ctx == NULL) {
    return 0;
  }

  // Create a dummy profile with the fuzzer data embedded in a tag.
  // We will then try to read various tag types from this profile.
  cmsHPROFILE hProfile = CreateDummyProfile(ctx, data, size);
  if (hProfile == NULL) {
    cmsDeleteContext(ctx);
    return 0;
  }

  // An array of tag signatures to test their corresponding read handlers
  cmsTagSignature tags_to_read[] = {
      cmsSigDictTag,
      cmsSigProfileSequenceIdTag,
      cmsSigUcrBgTag,
      cmsSigVcgtTag,
      cmsSigMpeCurveTag,
  };

  for (size_t i = 0; i < sizeof(tags_to_read) / sizeof(tags_to_read[0]); i++) {
    // By calling cmsReadTag with different signatures, we trigger the
    // corresponding Type_*_Read internal functions.
    void *tag_data = cmsReadTag(hProfile, tags_to_read[i]);
    if (tag_data != NULL) {
      // Free the data using the appropriate function based on the tag type
      switch (tags_to_read[i]) {
      case cmsSigDictTag:
        cmsDictFree((cmsHANDLE)tag_data);
        break;
      case cmsSigProfileSequenceIdTag:
        cmsFreeProfileSequenceId(tag_data);
        break;
      case cmsSigUcrBgTag:
        cmsFreeUcrBg(tag_data);
        break;
      case cmsSigVcgtTag:
        // vcgt tag returns an array of tone curves
        cmsFreeToneCurve(*(cmsToneCurve **)tag_data);
        break;
      case cmsSigMpeCurveTag:
        cmsStageFree((cmsStage *)tag_data);
        break;
      default:
        // Should not happen
        break;
      }
    }
  }

  cmsCloseProfile(hProfile);
  cmsDeleteContext(ctx);

  return 0;
}[0m
