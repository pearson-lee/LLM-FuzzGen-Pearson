  // Tag 4: Multi-Process Element Tag (e.g., cmsSigDToB0Tag)
  if ((control & 0x08) && remaining_size > 2) {
    cmsPipeline *p = CreateTestPipeline(ctx, current_data, remaining_size);
    if (p) {
