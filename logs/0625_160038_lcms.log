            current_data += 20;
            remaining_size -= 20;
            value_str[20] = '\0';

            cmsMLUsetASCII(mlu_name, "en", "US", name_str);
            cmsMLUsetASCII(mlu_value, "en", "US", value_str);
            
            // Correctly pass MLU as DisplayName (4th arg), not Value (3rd arg)
            cmsDictAddEntry(dict, L"Name", NULL, mlu_name, NULL);
            cmsDictAddEntry(dict, L"Value", NULL, mlu_value, NULL);
        }

        if (mlu_name) cmsMLUfree(mlu_name);
        if (mlu_value) cmsMLUfree(mlu_value);

        cmsWriteTag(hProfile, cmsSigDictType, dict);
        cmsDictFree(dict); // Frees the dictionary and its internal copies.
    }

    // --- Target 2: cmsSigProfileDescriptionTag (triggers Type_ProfileSequenceDesc_Write) ---
    cmsSEQ* seq = cmsAllocProfileSequenceDescription(context, 1);
    if (seq) {
