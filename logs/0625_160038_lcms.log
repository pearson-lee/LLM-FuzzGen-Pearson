// A union to hold any possible plugin type, ensuring the allocated
// buffer is large enough for any of them. This prevents a stack buffer
// overflow when cmsPlugin casts the pointer to a specific plugin type
// based on the fuzzer-controlled 'Type' field.
typedef union {
    cmsPluginBase                 base;
    cmsPluginMemHandler           mem;
    cmsPluginInterpolation        interp;
    cmsPluginParametricCurves     pcurve;
    cmsPluginFormatters           format;
    cmsPluginTagType              tag_type;
    cmsPluginTag                  tag;
    cmsPluginRenderingIntent      intent;
    cmsPluginMultiProcessElement  mpe;
    cmsPluginOptimization         opt;
    cmsPluginTransform            trans;
} cmsPluginAny;

// Fuzz target for a diverse set of lcms APIs with low coverage.
// It covers plugin registration, gamut boundary description, TAC detection,
// and pipeline stage allocation.
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    // Suppress error messages to improve fuzzing performance
    cmsSetLogErrorHandler(NULL);

    const uint8_t *current_data = data;
    size_t remaining_size = size;

    // --- 1. Test cmsPlugin() ---
    // This function has 0% coverage and is critical for the plugin mechanism.
    // We create a plugin structure and fill its type from fuzzer data to
    // explore the switch statement in cmsPluginTHR.
    if (remaining_size > sizeof(cmsUInt32Number)) {
        cmsPluginAny plugin;
        memset(&plugin, 0, sizeof(plugin));
        plugin.base.Magic = cmsPluginMagicNumber;
        plugin.base.ExpectedVersion = LCMS_VERSION;
        
        // Use fuzzer data to specify the plugin type to test different registration paths.
        memcpy(&plugin.base.Type, current_data, sizeof(cmsUInt32Number));
        current_data += sizeof(cmsUInt32Number);
        remaining_size -= sizeof(cmsUInt32Number);

        // Register the plugin. The function pointers are NULL, which may trigger error paths.
        cmsPlugin(&plugin);
    }

    // --- 2. Test cmsDetectTAC() ---
    // This function has low coverage and calls EstimateTAC() which has 0% coverage.
    // It requires a valid profile, which we create from the fuzzer data.
    cmsHPROFILE hProfile = cmsOpenProfileFromMem(current_data, remaining_size);
    if (hProfile) {
        // cmsDetectTAC performs complex operations including creating transforms.
        cmsDetectTAC(hProfile);
        // Ensure the created profile is properly closed to prevent memory leaks.
        cmsCloseProfile(hProfile);
    }

    // --- 3. Test Gamut Boundary Description (GDB) functions ---
    // cmsGDBCheckPoint() has 0% coverage. We test the full GDB lifecycle.
    cmsHANDLE hGDB = cmsGBDAlloc(NULL);
    if (hGDB) {
        int points_added = 0;
        int num_points_to_add = 5;
        for (int i = 0; i < num_points_to_add; i++) {
            if (remaining_size < sizeof(cmsCIELab)) break;
            
            cmsCIELab lab;
            memcpy(&lab, current_data, sizeof(cmsCIELab));
            current_data += sizeof(cmsCIELab);
            remaining_size -= sizeof(cmsCIELab);
            
            // Sanitize all components to be finite numbers.
            if (!isfinite(lab.L)) lab.L = 0;
            if (!isfinite(lab.a)) lab.a = 0;
            if (!isfinite(lab.b)) lab.b = 0;
            lab.L = fabs(lab.L);

            // Perturb the points slightly to prevent them from being identical,
            // collinear, or coplanar, which can cause cmsGDBCompute to create
            // a degenerated grid.
            lab.a += i;
            lab.b -= i;

            cmsGDBAddPoint(hGDB, &lab);
            points_added++;
        }

        // cmsGDBCompute requires at least 4 points to build a valid tetrahedral grid.
        // Only proceed if enough points were added.
        if (points_added >= 4) {
            if (cmsGDBCompute(hGDB, 0)) {
                // Check a point against the computed gamut.
                if (remaining_size >= sizeof(cmsCIELab)) {
                     cmsCIELab lab_check;
                     memcpy(&lab_check, current_data, sizeof(cmsCIELab));
                     current_data += sizeof(cmsCIELab);
                     remaining_size -= sizeof(cmsCIELab);

                     // Sanitize the check point as well.
                     if (!isfinite(lab_check.L)) lab_check.L = 0;
                     if (!isfinite(lab_check.a)) lab_check.a = 0;
                     if (!isfinite(lab_check.b)) lab_check.b = 0;
                     lab_check.L = fabs(lab_check.L);

                     cmsGDBCheckPoint(hGDB, &lab_check);
                } else {
                     // Also test the NULL case for the point.
                     cmsGDBCheckPoint(hGDB, NULL);
                }
            }
        }

        // Free the GDB handle to prevent memory leaks.
        cmsGBDFree(hGDB);
    }

    // --- 4. Test _cmsStageAllocLabPrelin() ---
    // This internal function has 0% coverage and tests stage allocation.
    cmsStage* stage = _cmsStageAllocLabPrelin(NULL);
    if (stage) {
        // Free the allocated stage to prevent memory leaks.
        cmsStageFree(stage);
    }

    return 0;
}[0m
