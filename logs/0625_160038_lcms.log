// This fuzzer targets several uncovered Type_*_Write functions in cmstypes.c
// by creating various tag-specific objects, populating them with fuzzer data,
// and writing them to a placeholder profile.

int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    // We need a reasonable amount of data to construct the various objects.
    if (Size < 256) {
        return 0;
    }

    const uint8_t* current_data = Data;
    size_t remaining_size = Size;

    // Create a context and a placeholder profile to write tags to.
    cmsContext context = cmsCreateContext(NULL, NULL);
    if (context == NULL) {
        return 0;
    }

    cmsHPROFILE hProfile = cmsCreateProfilePlaceholder(context);
    if (hProfile == NULL) {
        cmsDeleteContext(context);
        return 0;
    }

    // --- Target 1: cmsSigDictTag (triggers Type_Dictionary_Write) ---
    cmsDict* dict = cmsDictAlloc(context);
    if (dict) {
        cmsMLU* mlu_name = cmsMLUalloc(context, 1);
        cmsMLU* mlu_value = cmsMLUalloc(context, 1);
        char name_str[21], value_str[21];

        if (mlu_name && mlu_value && remaining_size > 40) {
            memcpy(name_str, current_data, 20);
            current_data += 20;
            remaining_size -= 20;
            name_str[20] = '\0';

            memcpy(value_str, current_data, 20);
            current_data += 20;
            remaining_size -= 20;
            value_str[20] = '\0';

            cmsMLUsetASCII(mlu_name, "en", "US", name_str);
            cmsMLUsetASCII(mlu_value, "en", "US", value_str);
            
            // cmsDictAddEntry duplicates the MLUs, so we free our local copies.
            cmsDictAddEntry(dict, L"Name", mlu_name, NULL, NULL);
            cmsDictAddEntry(dict, L"Value", mlu_value, NULL, NULL);
        }

        if (mlu_name) cmsMLUfree(mlu_name);
        if (mlu_value) cmsMLUfree(mlu_value);

        cmsWriteTag(hProfile, cmsSigDictTag, dict);
        cmsDictFree(dict); // Frees the dictionary and its internal copies.
    }

    // --- Target 2: cmsSigProfileSeqDescTag (triggers Type_ProfileSequenceDesc_Write) ---
    cmsSEQ* seq = cmsAllocProfileSequenceDescription(context, 1);
    if (seq) {
        if (remaining_size > sizeof(cmsProfileID)) {
            memcpy(&seq->seq[0].ProfileID, current_data, sizeof(cmsProfileID));
            current_data += sizeof(cmsProfileID);
            remaining_size -= sizeof(cmsProfileID);

            seq->seq[0].Description = cmsMLUalloc(context, 1);
            if (seq->seq[0].Description && remaining_size > 20) {
                char desc_str[21];
                memcpy(desc_str, current_data, 20);
                current_data += 20;
                remaining_size -= 20;
                desc_str[20] = '\0';
                cmsMLUsetASCII(seq->seq[0].Description, "en", "US", desc_str);
            }
        }
        cmsWriteTag(hProfile, cmsSigProfileSeqDescTag, seq);
        cmsFreeProfileSequenceDescription(seq); // Frees the sequence and all its MLUs.
    }

    // --- Target 3: cmsSigUcrBgTag (triggers Type_UcrBg_Write) ---
    if (remaining_size > (2 * sizeof(double) + 20)) {
        double ucr_gamma, bg_gamma;
        memcpy(&ucr_gamma, current_data, sizeof(double));
        current_data += sizeof(double);
        memcpy(&bg_gamma, current_data, sizeof(double));
        current_data += sizeof(double);
        remaining_size -= (2 * sizeof(double));

        cmsToneCurve* ucr_curve = cmsBuildGamma(context, ucr_gamma);
        cmsToneCurve* bg_curve = cmsBuildGamma(context, bg_gamma);
        cmsMLU* ucrbg_desc = cmsMLUalloc(context, 1);

        if (ucr_curve && bg_curve && ucrbg_desc) {
            char desc_str[21];
            memcpy(desc_str, current_data, 20);
            current_data += 20;
            remaining_size -= 20;
            desc_str[20] = '\0';
            cmsMLUsetASCII(ucrbg_desc, "en", "US", desc_str);

            _cmsUcrBg ucrbg_data = { ucr_curve, bg_curve, ucrbg_desc };
            cmsWriteTag(hProfile, cmsSigUcrBgTag, &ucrbg_data);
        }

        if (ucr_curve) cmsFreeToneCurve(ucr_curve);
        if (bg_curve) cmsFreeToneCurve(bg_curve);
        if (ucrbg_desc) cmsMLUfree(ucrbg_desc);
    }

    // --- Target 4: cmsSigVcgtTag (triggers Type_vcgt_Write) ---
    if (remaining_size > 3 * sizeof(double)) {
        cmsToneCurve* vcgt_curves[3] = { NULL, NULL, NULL };
        double gammas[3];
        memcpy(gammas, current_data, 3 * sizeof(double));
        current_data += 3 * sizeof(double);
