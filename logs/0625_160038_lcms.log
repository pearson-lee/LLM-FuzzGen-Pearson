    uint32_t dwFlags = ConsumeChoice(provider);

    // Use a temporary file to back the IO handler, as memory-based handlers
    // are part of the plugin API and may not be linked.
    FILE* f = tmpfile();
    if (!f) {
        cmsCloseProfile(profile);
        return;
    }

    cmsIOHANDLER* io = cmsOpenIOHandlerFromFile(ctx, f, "w");
    if (!io) {
        fclose(f);
        cmsCloseProfile(profile);
        return;
    }

    cmsGetPostScriptColorResource(ctx, type, profile, intent, dwFlags, io);
    
    // The handler must be closed before the underlying file.
    cmsCloseIOHandler(io);
    fclose(f);

    cmsCloseProfile(profile);
}

