// Added to improve coverage of PostScript generation functions in cmsps2.c
void FuzzPostScript(cmsContext ctx, FuzzDataProvider* provider)
{
    cmsHPROFILE profile = cmsCreateProfilePlaceholder(ctx);
    if (!profile) {
        return;
    }

    uint8_t choice = ConsumeChoice(provider);
