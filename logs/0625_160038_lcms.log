    if (str && pseq->Model) {
      cmsMLUsetASCII(pseq->Model, "en", "US", str);
      free(str);
    }
    str = consume_string(&fuzz_data);
    if (str && pseq->Description) {
      cmsMLUsetASCII(pseq->Description, "en", "US", str);
      free(str);
    }
  }

