      }
      cmsDoTransform(transform, in_pixel, out_pixel, 1);
      cmsDeleteTransform(transform);
    }
  }

  // Cleanup all allocated resources.
  if (tone_curve)
    cmsFreeToneCurve(tone_curve);
  if (gray_profile)
    cmsCloseProfile(gray_profile);
  if (lab_profile)
