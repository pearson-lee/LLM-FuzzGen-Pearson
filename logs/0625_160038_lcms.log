// Target API: cmsIT8LoadFromMem
// This function parses an IT8 (CGATS) file from a memory buffer.
// IT8 files are used for color measurement data and are complex,
// making them a good candidate for fuzzing. We will provide the
// fuzzer data directly to this function.

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  // The target function asserts that the input buffer is not NULL and the size is not 0.
  // We must add a check to prevent the fuzzer from violating these assumptions.
  if (data == NULL || size == 0) {
    return 0;
  }

  // Create a NULL context. The context can be used to register custom plugins
  // and error handlers. For this fuzzer, a NULL context is sufficient,
  // which means lcms will use its default internal state.
  cmsContext null_ctx = NULL;

  // Attempt to load an IT8 object from the fuzzer-provided data.
  // cmsIT8LoadFromMem parses the data and returns a handle to a cmsIT8 object.
  // This handle is used in subsequent operations.
  cmsHANDLE it8 = cmsIT8LoadFromMem(null_ctx, data, size);

  // If the IT8 object was successfully created (i.e., parsing did not
  // immediately fail and return NULL), we proceed to free the allocated resources.
  if (it8) {
    // It is crucial to free the memory associated with the cmsIT8 object
    // to prevent memory leaks. cmsIT8Free handles the deallocation of the
    // object and all its internal structures using the handle.
    cmsIT8Free(it8);
  }

  // The return value of 0 indicates that the fuzzer should continue execution.
  return 0;
}[0m
