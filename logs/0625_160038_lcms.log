      cmsUInt32Number intent_ps = data[0] % 4;
      cmsUInt32Number flags_ps = data[1];
      cmsUInt32Number ps_size_csa = cmsGetPostScriptCSA(NULL, srgbProfile, intent_ps, flags_ps, NULL, 0);
      if (ps_size_csa > 0) {
        void *ps_buffer = malloc(ps_size_csa);
        if (ps_buffer != NULL) {
          cmsGetPostScriptCSA(NULL, srgbProfile, intent_ps, flags_ps, ps_buffer, ps_size_csa);
          free(ps_buffer);
        }
      }
      cmsUInt32Number ps_size_crd = cmsGetPostScriptCRD(NULL, srgbProfile, intent_ps, flags_ps, NULL, 0);
      if (ps_size_crd > 0) {
        void *ps_buffer = malloc(ps_size_crd);
        if (ps_buffer != NULL) {
          cmsGetPostScriptCRD(NULL, srgbProfile, intent_ps, flags_ps, ps_buffer, ps_size_crd);
          free(ps_buffer);
        }
      }
      cmsCloseProfile(srgbProfile);
    }

    // Added to improve coverage of vcgt and ucrbg tag writing/reading.
    // The fuzzer rarely creates profiles with these tags, so we write them
    // explicitly to ensure the Type_*_Write and Type_*_Read functions are hit.
    if (size > sizeof(cmsVideoCardGammaTable)) {
        cmsVideoCardGammaTable* vcgt = (cmsVideoCardGammaTable*) malloc(sizeof(cmsVideoCardGammaTable));
        if (vcgt) {
            memcpy(vcgt, data, sizeof(cmsVideoCardGammaTable));
            vcgt->nChannels = 1; // Force to 1 channel to avoid complexity
            vcgt->nEntries = 256;
            cmsWriteTag(hProfile, cmsSigVcgtTag, vcgt);
            free(vcgt);
