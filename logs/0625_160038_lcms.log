        cmsIT8GetSheetType(hIT8);
        cmsIT8SetPropertyUncooked(hIT8, "DUMMY_KEY", value);

        // Clean up all memory.
        free(prop);
        free(subprop);
        free(value);
        cmsIT8Free(hIT8);
        break;
    }

    case 3: {
