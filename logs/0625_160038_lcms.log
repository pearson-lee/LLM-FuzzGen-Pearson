        remaining_size -= 3 * sizeof(double);

        vcgt_curves[0] = cmsBuildGamma(context, gammas[0]);
        vcgt_curves[1] = cmsBuildGamma(context, gammas[1]);
        vcgt_curves[2] = cmsBuildGamma(context, gammas[2]);

        if (vcgt_curves[0] && vcgt_curves[1] && vcgt_curves[2]) {
