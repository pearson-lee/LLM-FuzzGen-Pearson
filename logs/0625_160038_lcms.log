#include "lcms2.h"
#include "lcms2_internal.h"
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

// We need to define this structure because it's not available in the public
// headers, but it's needed for the type handler functions.
// We only need the ContextID field for the functions we are targeting.
struct _cms_typehandler_struct {
  cmsContext ContextID;
  cmsTagTypeSignature Signature;
  // ... other fields we don't need
};

// Helper to consume data from the fuzzer input
typedef struct {
  const uint8_t *data;
  size_t size;
  size_t offset;
} FuzzData;

static int consume_u32(FuzzData *f, uint32_t *value) {
  if (f->offset + sizeof(uint32_t) > f->size) {
    return 0;
  }
  memcpy(value, f->data + f->offset, sizeof(uint32_t));
  f->offset += sizeof(uint32_t);
  return 1;
}

static int consume_byte(FuzzData *f, uint8_t *value) {
  if (f->offset >= f->size) {
    return 0;
  }
  *value = f->data[f->offset++];
  return 1;
}

static int consume_float(FuzzData *f, float *value) {
  if (f->offset + sizeof(float) > f->size) {
    return 0;
  }
  memcpy(value, f->data + f->offset, sizeof(float));
  f->offset += sizeof(float);
  return 1;
}

// These functions are not part of the public API, so we provide forward
// declarations.
cmsToneCurve *ReadSegmentedCurve(struct _cms_typehandler_struct *self, cmsIOHANDLER *io);
cmsBool WriteSegmentedCurve(cmsIOHANDLER *io, cmsToneCurve *g);
void *Type_MPEcurve_Read(struct _cms_typehandler_struct *self, cmsIOHANDLER *io, cmsUInt32Number *nItems, cmsUInt32Number SizeOfTag);
cmsBool Type_MPEcurve_Write(struct _cms_typehandler_struct *self, cmsIOHANDLER *io, void *Ptr, cmsUInt32Number nItems);

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 20) {
    return 0;
  }

  FuzzData f = {data, size, 0};
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (ctx == NULL) {
    return 0;
  }

  // 1. Create a segmented tone curve from fuzzer data.
  uint32_t num_segments;
  if (!consume_u32(&f, &num_segments)) {
    cmsDeleteContext(ctx);
    return 0;
  }
  num_segments = (num_segments % 5) + 1; // Keep segment count reasonable.

  cmsCurveSegment *segments = (cmsCurveSegment *)calloc(num_segments, sizeof(cmsCurveSegment));
  if (segments == NULL) {
    cmsDeleteContext(ctx);
    return 0;
  }

  float last_break = 0.0f;
  for (uint32_t i = 0; i < num_segments; ++i) {
    uint8_t type;
    if (!consume_byte(&f, &type))
      break;

    segments[i].x0 = last_break;
    if (i < num_segments - 1) {
      if (!consume_float(&f, &segments[i].x1))
        break;
      // Ensure breakpoints are monotonic for a valid curve.
      if (segments[i].x1 <= last_break) {
        segments[i].x1 = last_break + 0.1f;
      }
      last_break = segments[i].x1;
    } else {
      segments[i].x1 = 1.0f;
    }

    if (type % 2 == 0) { // Create a sampled segment.
      segments[i].Type = 0;
      uint32_t num_points;
      if (!consume_u32(&f, &num_points))
        break;
      num_points = (num_points % 50) + 2; // Need at least 2 points.

      segments[i].nGridPoints = num_points;
      segments[i].SampledPoints = (cmsFloat32Number *)calloc(num_points, sizeof(cmsFloat32Number));
      if (segments[i].SampledPoints == NULL)
        break;

      for (uint32_t j = 0; j < num_points; ++j) {
        if (!consume_float(&f, &segments[i].SampledPoints[j])) {
          goto end_segment_creation; // Exit if data runs out.
        }
      }
    } else { // Create a formula-based segment.
      uint8_t formula_type;
      if (!consume_byte(&f, &formula_type))
        break;
      segments[i].Type = (formula_type % 3) + 6; // Valid types are 6, 7, 8.

      int num_params = (segments[i].Type > 6) ? 5 : 4;
      for (int j = 0; j < num_params; ++j) {
        if (!consume_float(&f, (float *)&segments[i].Params[j])) {
          goto end_segment_creation; // Exit if data runs out.
        }
      }
    }
  }
end_segment_creation:;

  cmsToneCurve *curve = cmsBuildSegmentedToneCurve(ctx, num_segments, segments);

  // Clean up the temporary segments structure.
  for (uint32_t i = 0; i < num_segments; ++i) {
    if (segments[i].SampledPoints) {
      free(segments[i].SampledPoints);
    }
  }
  free(segments);

  if (curve == NULL) {
    cmsDeleteContext(ctx);
    return 0;
  }

  // 2. Write and Read the curve using Write/ReadSegmentedCurve.
  char buffer[1024 * 16]; // 16K buffer for serialization.
  cmsIOHANDLER *write_io = cmsOpenIOhandlerFromMem(ctx, buffer, sizeof(buffer), "w");
  if (write_io) {
    if (WriteSegmentedCurve(write_io, curve)) {
      size_t bytes_written = write_io->Tell(write_io);
      cmsCloseIOhandler(write_io); // Flushes and closes the writer.

      // Read the data back to exercise the reader.
      cmsIOHANDLER *read_io = cmsOpenIOhandlerFromMem(ctx, buffer, bytes_written, "r");
      if (read_io) {
        struct _cms_typehandler_struct self;
        self.ContextID = ctx;
        cmsToneCurve *read_curve = ReadSegmentedCurve(&self, read_io);
        if (read_curve) {
          cmsFreeToneCurve(read_curve); // Clean up the read curve.
        }
        cmsCloseIOhandler(read_io);
      }
    } else {
      cmsCloseIOhandler(write_io);
    }
  }

  // 3. Write and Read the curve as an MPE stage.
  cmsStage *mpe_stage = cmsStageAllocToneCurves(ctx, 1, &curve);
  if (mpe_stage) {
    cmsIOHANDLER *mpe_write_io = cmsOpenIOhandlerFromMem(ctx, buffer, sizeof(buffer), "w");
    if (mpe_write_io) {
      struct _cms_typehandler_struct self_write;
      self_write.ContextID = ctx;
      if (Type_MPEcurve_Write(&self_write, mpe_write_io, mpe_stage, 1)) {
        size_t bytes_written = mpe_write_io->Tell(mpe_write_io);
        cmsCloseIOhandler(mpe_write_io);

        // Read the MPE stage back.
        cmsIOHANDLER *mpe_read_io = cmsOpenIOhandlerFromMem(ctx, buffer, bytes_written, "r");
        if (mpe_read_io) {
          struct _cms_typehandler_struct self_read;
          self_read.ContextID = ctx;
          cmsUInt32Number items_read = 0;
          cmsStage *read_stage = (cmsStage *)Type_MPEcurve_Read(&self_read, mpe_read_io, &items_read, bytes_written);
          if (read_stage) {
            cmsStageFree(read_stage); // Clean up the read stage.
          }
          cmsCloseIOhandler(mpe_read_io);
        }
      } else {
        cmsCloseIOhandler(mpe_write_io);
      }
    }
    cmsStageFree(mpe_stage); // Clean up the MPE stage.
  }

  // 4. Final cleanup.
  cmsFreeToneCurve(curve);
  cmsDeleteContext(ctx);
  return 0;
}[0m
