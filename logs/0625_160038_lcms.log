int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  if (Size < 1) {
    return 0;
  }

  // Create a memory-based IO handler from the fuzzer input.
  // This is the primary mechanism for feeding data to the parsing functions.
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(NULL, (void *)Data, Size, "r");
  if (io == NULL) {
    return 0;
  }

  cmsUInt32Number nItems, sizeOfTag;

  // Target 1: Fuzz Type_LUTB2A_Read
  // This function reads and parses a lookup table (LUT) from the IO stream.
  // The returned object is a cmsPipeline, which must be freed.
  void *lut = Type_LUTB2A_Read(NULL, io, &nItems, Size);
  if (lut != NULL) {
    cmsPipelineFree((cmsPipeline *)lut);
  }
  io->Seek(io, 0); // Reset stream for the next function

  // Target 2: Fuzz Type_ProfileSequenceDesc_Read
  // This function reads a sequence of profile descriptions.
  // The returned object is a cmsSEQ, which must be freed.
  void *seq = Type_ProfileSequenceDesc_Read(NULL, io, &nItems, Size);
  if (seq != NULL) {
    cmsFreeProfileSequenceDescription((cmsSEQ *)seq);
  }
  io->Seek(io, 0);

  // Target 3: Fuzz Type_Dictionary_Read
  // This function reads a dictionary (key-value) tag.
  // The returned object is a cmsDICT, which must be freed.
  void *dict = Type_Dictionary_Read(NULL, io, &nItems, Size);
  if (dict != NULL) {
    cmsDictFree((cmsDICT *)dict);
  }
  io->Seek(io, 0);

  // Target 4: Fuzz Type_vcgt_Read
  // This function reads a video card gamma table (vcgt) tag.
  // The returned object is an array of tone curves, freed via cmsFreeToneCurveTriple.
  void *vcgt = Type_vcgt_Read(NULL, io, &nItems, Size);
  if (vcgt != NULL) {
    cmsFreeToneCurveTriple((cmsToneCurve **)vcgt);
  }
  io->Seek(io, 0);

  // Target 5: Fuzz cmsSmoothToneCurve
  // This requires creating a tone curve first. We'll use part of the
  // fuzzing data to construct a tabulated tone curve.
  if (Size > sizeof(cmsUInt16Number) * 256 + sizeof(double)) {
    cmsToneCurve *curve = NULL;
    double smoothing_param;

    // Use the end of the data for the smoothing parameter to avoid overlap
    // with the table data.
    memcpy(&smoothing_param, Data + sizeof(cmsUInt16Number) * 256, sizeof(double));

    // Create a tabulated tone curve with 256 entries from the input data.
    curve = cmsBuildTabulatedToneCurve16(NULL, 256, (cmsUInt16Number *)Data);
    if (curve != NULL) {
      // Call the target function with the created curve and a fuzzer-driven parameter.
      cmsSmoothToneCurve(curve, smoothing_param);
      // Free the allocated tone curve to prevent memory leaks.
      cmsFreeToneCurve(curve);
    }
  }

  // Clean up the IO handler.
  cmsCloseIOhandler(io);

  return 0;
}[0m
