int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  if (Size < 1) {
    return 0;
  }

  // Create a new, empty profile that is safe to write to.
  cmsHPROFILE hProfile = cmsCreateNULLProfile();
  if (hProfile == NULL) {
    return 0;
  }

  // Writing a transform tag (like cmsSigBToA0Tag) to a NULL profile causes a
  // crash because it lacks the necessary pipeline structures.
  // Instead, we write a descriptive tag, which is a safe operation.
  if (Size > 0) {
    cmsMLU *mlu = cmsMLUalloc(NULL, 1);
    if (mlu) {
      // Create a null-terminated string from the fuzzer data.
      char *text = (char *)malloc(Size + 1);
      if (text) {
        memcpy(text, Data, Size);
        text[Size] = '\0';
        cmsMLUsetASCII(mlu, "en", "US", text);
        cmsWriteTag(hProfile, cmsSigProfileDescriptionTag, mlu);
        free(text);
      }
      cmsMLUfree(mlu);
    }
  }

  // Read back various tags. These operations are now safer because the profile
  // is being modified in a valid way.
  cmsReadTag(hProfile, cmsSigBToA0Tag);
  cmsReadTag(hProfile, cmsSigProfileSequenceDescTag);
  cmsReadTag(hProfile, cmsSigMetaTag);
  cmsReadTag(hProfile, cmsSigVcgtTag);
  cmsReadTag(hProfile, cmsSigProfileDescriptionTag);


  // Target 5: Fuzz cmsSmoothToneCurve
  // This part is independent of the profile handle and requires manual memory management.
  if (Size > sizeof(cmsUInt16Number) * 256 + sizeof(double)) {
    cmsToneCurve *curve = NULL;
    double smoothing_param;

    memcpy(&smoothing_param, Data + sizeof(cmsUInt16Number) * 256, sizeof(double));

    curve = cmsBuildTabulatedToneCurve16(NULL, 256, (cmsUInt16Number *)Data);
    if (curve != NULL) {
      cmsSmoothToneCurve(curve, smoothing_param);
      cmsFreeToneCurve(curve);
    }
  }

  // Allocate and free a cmsIT8 handle to exercise that part of the API.
  cmsHANDLE hIT8 = cmsIT8Alloc(NULL);
  if (hIT8) {
      cmsIT8Free(hIT8);
  }


  // Clean up the profile handle and all associated tags.
  cmsCloseProfile(hProfile);

  return 0;
}[0m
