// Fuzzing target for MPE (Multi-Process Element) types
void FuzzMPE(cmsContext ctx, struct _cms_typehandler_struct *handler, cmsIOHANDLER *io_read, size_t size) {
  cmsUInt32Number nItems = 0;

  // Call the static function Type_MPE_Read to parse a cmsPipeline from the input data.
  cmsPipeline *pipeline = (cmsPipeline *)Type_MPE_Read(handler, io_read, &nItems, (cmsUInt32Number)size);

  if (pipeline) {
    // If parsing is successful, we proceed to write the pipeline out.
    cmsIOHANDLER *io_write = cmsOpenIOhandlerFromNULL(ctx);
    if (io_write) {
      Type_MPE_Write(handler, io_write, pipeline, nItems);
      cmsCloseIOhandler(io_write);
    }

    // The object returned by Type_MPE_Read is a cmsPipeline, which must be freed.
    cmsPipelineFree(pipeline);
  }
}

// Fuzzing target for vcgt (Video Card Gamma Table) types
void FuzzVcgt(cmsContext ctx, struct _cms_typehandler_struct *handler, cmsIOHANDLER *io_read, size_t size) {
  cmsUInt32Number nItems = 0;

  // Call the static function Type_vcgt_Read to parse a gamma table.
  _cmsVCGTGAMMA *vcgt = (_cmsVCGTGAMMA *)Type_vcgt_Read(handler, io_read, &nItems, (cmsUInt32Number)size);

  if (vcgt) {
    cmsIOHANDLER *io_write = cmsOpenIOhandlerFromNULL(ctx);
    if (io_write) {
      Type_vcgt_Write(handler, io_write, vcgt, nItems);
      cmsCloseIOhandler(io_write);
    }

    // Type_vcgt_Read allocates a single block for the tables and stores the pointer
    // in Table[0]. This must be freed manually before freeing the vcgt struct itself
    // to prevent a memory leak.
    if (vcgt->Gamma.Table[0] != NULL) {
        _cmsFree(ctx, vcgt->Gamma.Table[0]);
    }
    // Finally, free the container structure itself.
    _cmsFree(ctx, vcgt);
  }
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  // Create a context. All lcms operations are done on a context.
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (!ctx) {
    return 0;
  }

  // Create a memory-based IO handler for reading from the fuzzer input.
  cmsIOHANDLER *io_read = cmsOpenIOhandlerFromMem(ctx, (void *)data, (cmsUInt32Number)size, "r");
  if (!io_read) {
    cmsDeleteContext(ctx);
    return 0;
  }

  // We need a type handler struct to pass to the functions.
  // The functions mainly use the ContextID from it. We can create a dummy one.
  struct _cms_typehandler_struct handler;
  memset(&handler, 0, sizeof(handler));
  handler.ContextID = ctx;

  // Fuzz MPE
  handler.Signature = cmsSigMultiProcessElementType;
  FuzzMPE(ctx, &handler, io_read, size);

  // Rewind the IO handler to reuse the fuzzer input for the next target.
  io_read->Seek(io_read, 0);

  // Fuzz vcgt
  handler.Signature = cmsSigVcgtTag;
  FuzzVcgt(ctx, &handler, io_read, size);

  // Clean up all resources.
  cmsCloseIOhandler(io_read);
  cmsDeleteContext(ctx);

  return 0;
}[0m
