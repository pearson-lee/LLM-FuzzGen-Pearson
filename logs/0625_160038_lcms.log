// Target 2: Type_ProfileSequenceDesc_Write
#ifdef CMS_TYPES_C
void Fuzz_Type_ProfileSequenceDesc_Write(cmsContext ctx, const uint8_t *Data, size_t Size) {
  size_t needed_size = sizeof(cmsSignature) * 2 + sizeof(cmsUInt64Number) + sizeof(cmsTechnologySignature) + sizeof(cmsProfileID);
  if (Size < needed_size) {
    return;
  }
  cmsSEQ *seq = cmsAllocProfileSequenceDescription(ctx, 1);
  if (!seq) {
    return;
  }

  const uint8_t* p = Data;
  memcpy(&seq->seq[0].deviceMfg, p, sizeof(cmsSignature));
  p += sizeof(cmsSignature);
  memcpy(&seq->seq[0].deviceModel, p, sizeof(cmsSignature));
  p += sizeof(cmsSignature);
  memcpy(&seq->seq[0].attributes, p, sizeof(cmsUInt64Number));
  p += sizeof(cmsUInt64Number);
  memcpy(&seq->seq[0].technology, p, sizeof(cmsTechnologySignature));
  p += sizeof(cmsTechnologySignature);
  memcpy(&seq->seq[0].ProfileID, p, sizeof(cmsProfileID));

  cmsIOHANDLER *io = cmsOpenIOhandlerFromNULL(ctx);
  if (!io) {
    cmsFreeProfileSequenceDescription(seq);
    return;
  }

  Type_ProfileSequenceDesc_Write(ctx, io, seq, 1);

  cmsCloseIOhandler(io);
  cmsFreeProfileSequenceDescription(seq);
}
#endif

