  void *ucrbg = Type_UcrBg_Read(&self, io, &nItems, size);
  if (ucrbg != NULL) {
    cmsFreeUcrBg(ucrbg);
  }

  // Reset the IO handler for the next function call
  io->Seek(io, 0);

  // Fuzz Type_vcgt_Read
  void *vcgt = Type_vcgt_Read(&self, io, &nItems, size);
  if (vcgt != NULL) {
    cmsFreeToneCurve(vcgt);
  }

  // Reset the IO handler for the next function call
  io->Seek(io, 0);

  // Fuzz Type_MPEcurve_Read
  void *mpe_curve = Type_MPEcurve_Read(&self, io, &nItems, size);
  if (mpe_curve != NULL) {
    cmsStageFree(mpe_curve);
  }

  // Clean up
  cmsCloseIOhandler(io);
  cmsDeleteContext(ctx);

  return 0;
