      void *buffer = malloc(profileSize);
      if (buffer != NULL) {
        cmsSaveProfileToMem(hProfile, buffer, &profileSize);
        // Free the allocated buffer.
        free(buffer);
      }
    }
  }

  // Clean up the profile handle.
  cmsCloseProfile(hProfile);
  // Clean up the context.
  cmsDeleteContext(ctx);

  return 0;
