// Fuzzer entry point.
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 1) {
    return 0;
  }

  // Create a memory-based I/O handler for reading profile data.
  // This allows us to treat the fuzzer input as a file in memory.
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(NULL, size, "r", data);
  if (io == NULL) {
    return 0;
  }

  // Using an explicit context is the correct way for the modern lcms2 API
  // and resolves potential linker errors from API version mismatches.
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (ctx == NULL) {
    cmsCloseIOhandler(io);
    return 0;
  }

  // Attempt to open a profile from the fuzzer-provided data.
  // The linker error indicates that the thread-safe version 'cmsOpenProfileFromIOhandlerTHR'
  // is the correct function to call in this build environment.
  cmsHPROFILE hProfile = cmsOpenProfileFromIOhandlerTHR(ctx, io);

  // The core logic of the fuzzer only proceeds if a valid profile was successfully parsed.
  // This ensures that we are fuzzing deeper functions with valid, complex objects.
  if (hProfile != NULL) {
    // Exercise the API to get the number of tags in the profile.
    cmsGetTagCount(hProfile);

    // Read the media white point tag. The memory for the returned pointer is
    // managed by the profile handle and should not be freed manually.
    cmsReadTag(hProfile, cmsSigMediaWhitePointTag);

    // Read the chromatic adaptation tag. The type 'cmsMAT3' is internal.
    // We call the read function to exercise the code but don't use the result
    // to avoid dependencies on internal headers. The memory is also managed by the profile.
    cmsReadTag(hProfile, cmsSigChromaticAdaptationTag);

    // Attempt to read the AToB1 tag, which contains a lookup table (LUT).
    // For pipeline tags, cmsReadTag transfers ownership of the allocated object.
    cmsPipeline *lut = (cmsPipeline *)cmsReadTag(hProfile, cmsSigAToB1Tag);
    if (lut != NULL) {
      // If the LUT is read, duplicate it to test memory management and copying logic.
      cmsPipeline *lutDup = cmsPipelineDup(lut);
      if (lutDup != NULL) {
        // Free the duplicated LUT.
        cmsPipelineFree(lutDup);
      }
      // Free the original LUT, as its ownership was transferred to us.
      cmsPipelineFree(lut);
    }

    // Close the profile handle to release all associated resources.
    cmsCloseProfile(hProfile);
  }

  // Close the I/O handler, which also frees the associated memory.
  cmsCloseIOhandler(io);
  // Delete the context to release its resources.
  cmsDeleteContext(ctx);

  return 0;
}[0m
