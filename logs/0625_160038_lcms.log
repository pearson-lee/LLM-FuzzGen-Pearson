        cmsToneCurve* ucr_curve = cmsBuildGamma(context, ucr_gamma);
        cmsToneCurve* bg_curve = cmsBuildGamma(context, bg_gamma);
        cmsMLU* ucrbg_desc = cmsMLUalloc(context, 1);
        cmsUcrBg* ucrbg_data = NULL;

        if (ucr_curve && bg_curve && ucrbg_desc) {
