#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/src/lcms2_internal.h"
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

// cmsSigDictTag is defined in the internal header, but we define it
// here as well to ensure the fuzzer compiles even if headers change.
#if !defined(cmsSigDictTag)
#define cmsSigDictTag ((cmsTagSignature)0x64696374) // 'dict'
#endif

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (ctx == NULL) {
    return 0;
  }

  // Treat the fuzzer input as a memory buffer containing a full ICC profile.
  cmsHPROFILE hProfile = cmsOpenProfileFromMem(data, size);
  if (hProfile == NULL) {
    // The input was not a valid profile, which is a valid fuzzing outcome.
    cmsDeleteContext(ctx);
    return 0;
  }

  // An array of tag signatures to test their corresponding read handlers.
  cmsTagSignature tags_to_read[] = {
      cmsSigDictTag,
      cmsSigProfileSequenceIdTag,
      cmsSigUcrBgTag,
      cmsSigVcgtTag,
      cmsSigAToB0Tag, // This tag can contain MPEs (Multi Process Elements)
  };

  for (size_t i = 0; i < sizeof(tags_to_read) / sizeof(tags_to_read[0]); i++) {
    void *tag_data = cmsReadTag(hProfile, tags_to_read[i]);
    if (tag_data != NULL) {
      switch (tags_to_read[i]) {
      case cmsSigDictTag:
        cmsDictFree((cmsHANDLE)tag_data);
        break;
      case cmsSigProfileSequenceIdTag: {
        // cmsFreeProfileSequenceId is static, so we replicate its logic here.
        cmsSEQ *seq = (cmsSEQ *)tag_data;
        cmsPSEQDESC *p = seq->seq;
        while (p != NULL) {
          cmsPSEQDESC *next = p->next;
          if (p->Description)
            cmsMLUfree(p->Description);
          _cmsFree(ctx, p);
          p = next;
        }
        _cmsFree(ctx, seq);
      } break;
      case cmsSigUcrBgTag: {
        // cmsFreeUcrBg is static, so we replicate its logic here.
        _cmsUcrBg *ucrbg = (_cmsUcrBg *)tag_data;
        if (ucrbg->Ucr)
          cmsFreeToneCurve(ucrbg->Ucr);
        if (ucrbg->Bg)
          cmsFreeToneCurve(ucrbg->Bg);
        _cmsFree(ctx, ucrbg);
      } break;
      case cmsSigVcgtTag: {
        cmsToneCurve **curves = (cmsToneCurve **)tag_data;
        if (curves[0])
          cmsFreeToneCurve(curves[0]);
        if (curves[1])
          cmsFreeToneCurve(curves[1]);
        if (curves[2])
          cmsFreeToneCurve(curves[2]);
        _cmsFree(ctx, tag_data);
      } break;
      case cmsSigAToB0Tag:
        cmsPipelineFree((cmsPipeline *)tag_data);
        break;
      default:
        break;
      }
    }
  }

  cmsCloseProfile(hProfile);
  cmsDeleteContext(ctx);

  return 0;
}[0m
