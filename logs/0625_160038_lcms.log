          cmsReadTag(hProfileRead, cmsSigUcrBgTag);
          cmsReadTag(hProfileRead, cmsSigMpeCurveType);

          cmsCloseProfile(hProfileRead);
        }
      }
      free(ProfileData);
    }
  }

  // Clean up resources.
  cmsCloseProfile(hProfile);
  cmsDeleteContext(ctx);

  return 0;
}[0m
