            memcpy(&seq->seq[0].ProfileID, current_data, sizeof(cmsProfileID));
            current_data += sizeof(cmsProfileID);
            remaining_size -= sizeof(cmsProfileID);

            seq->seq[0].Description = cmsMLUalloc(context, 1);
            if (seq->seq[0].Description && remaining_size > 20) {
                char desc_str[21];
