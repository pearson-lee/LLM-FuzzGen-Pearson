// Helper to consume data from the fuzzer input
typedef struct {
  const uint8_t *data;
  size_t size;
  size_t offset;
} FuzzData;

static int consume_u32(FuzzData *f, uint32_t *value) {
  if (f->offset + sizeof(uint32_t) > f->size) {
    return 0;
  }
  memcpy(value, f->data + f->offset, sizeof(uint32_t));
  f->offset += sizeof(uint32_t);
  return 1;
}

static int consume_byte(FuzzData *f, uint8_t *value) {
  if (f->offset >= f->size) {
    return 0;
  }
  *value = f->data[f->offset++];
  return 1;
}

static int consume_float(FuzzData *f, float *value) {
  if (f->offset + sizeof(float) > f->size) {
    return 0;
  }
  memcpy(value, f->data + f->offset, sizeof(float));
  f->offset += sizeof(float);
  return 1;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 20) {
    return 0;
  }

  FuzzData f = {data, size, 0};
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (ctx == NULL) {
    return 0;
  }

  // 1. Create a segmented tone curve from fuzzer data.
  uint32_t num_segments;
  if (!consume_u32(&f, &num_segments)) {
    cmsDeleteContext(ctx);
    return 0;
  }
  num_segments = (num_segments % 5) + 1; // Keep segment count reasonable.

  cmsCurveSegment *segments = (cmsCurveSegment *)calloc(num_segments, sizeof(cmsCurveSegment));
  if (segments == NULL) {
    cmsDeleteContext(ctx);
    return 0;
  }

  float last_break = 0.0f;
  for (uint32_t i = 0; i < num_segments; ++i) {
    uint8_t type;
    if (!consume_byte(&f, &type))
      break;

    segments[i].x0 = last_break;
    if (i < num_segments - 1) {
      if (!consume_float(&f, &segments[i].x1))
        break;
      // Ensure breakpoints are monotonic for a valid curve.
      if (segments[i].x1 <= last_break) {
        segments[i].x1 = last_break + 0.1f;
      }
      last_break = segments[i].x1;
    } else {
      segments[i].x1 = 1.0f;
    }

    if (type % 2 == 0) { // Create a sampled segment.
      segments[i].Type = 0;
      uint32_t num_points;
      if (!consume_u32(&f, &num_points))
        break;
      num_points = (num_points % 50) + 2; // Need at least 2 points.

      segments[i].nGridPoints = num_points;
      segments[i].SampledPoints = (cmsFloat32Number *)calloc(num_points, sizeof(cmsFloat32Number));
      if (segments[i].SampledPoints == NULL)
        break;

      for (uint32_t j = 0; j < num_points; ++j) {
        if (!consume_float(&f, &segments[i].SampledPoints[j])) {
          goto end_segment_creation; // Exit if data runs out.
        }
      }
    } else { // Create a formula-based segment.
      uint8_t formula_type;
      if (!consume_byte(&f, &formula_type))
        break;
      segments[i].Type = (formula_type % 3) + 6; // Valid types are 6, 7, 8.

      int num_params = (segments[i].Type > 6) ? 5 : 4;
      for (int j = 0; j < num_params; ++j) {
        if (!consume_float(&f, (float *)&segments[i].Params[j])) {
          goto end_segment_creation; // Exit if data runs out.
        }
      }
    }
  }
end_segment_creation:;

  cmsToneCurve *curve = cmsBuildSegmentedToneCurve(ctx, num_segments, segments);

  // Clean up the temporary segments structure.
  for (uint32_t i = 0; i < num_segments; ++i) {
    if (segments[i].SampledPoints) {
      free(segments[i].SampledPoints);
    }
  }
  free(segments);

  if (curve == NULL) {
    cmsDeleteContext(ctx);
    return 0;
  }

  // 2. Write and Read the curve using Write/ReadSegmentedCurve.
  char buffer[1024 * 16]; // 16K buffer for serialization.
  cmsIOHANDLER *write_io = cmsOpenIOhandlerFromMem(ctx, buffer, sizeof(buffer), "w");
  if (write_io) {
