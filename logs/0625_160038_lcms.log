// Helper to consume data from the fuzzer input
typedef struct {
  const uint8_t *data;
  size_t size;
  size_t offset;
} FuzzData;

static int consume_u32(FuzzData *f, uint32_t *value) {
  if (f->offset + sizeof(uint32_t) > f->size) {
    return 0;
  }
  memcpy(value, f->data + f->offset, sizeof(uint32_t));
  f->offset += sizeof(uint32_t);
  return 1;
}

static int consume_byte(FuzzData *f, uint8_t *value) {
  if (f->offset >= f->size) {
    return 0;
  }
  *value = f->data[f->offset++];
  return 1;
}

static int consume_float(FuzzData *f, float *value) {
  if (f->offset + sizeof(float) > f->size) {
    return 0;
  }
  memcpy(value, f->data + f->offset, sizeof(float));
  f->offset += sizeof(float);
  return 1;
}

