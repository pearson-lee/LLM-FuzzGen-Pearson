        memcpy(&sig, current_data, sizeof(cmsSignature));
        cmsWriteTag(hProfile, cmsSigSignatureType, &sig);
    }

    // Final cleanup of the main profile and context objects.
    cmsCloseProfile(hProfile);
    cmsDeleteContext(context);

    return 0;
}[0m
