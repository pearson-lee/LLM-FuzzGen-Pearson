int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  if (Size < 1) {
    return 0;
  }

  // Create a writable placeholder profile instead of a read-only sRGB profile.
  // This prevents a use-after-free crash when cmsWriteTag is called, as placeholder
  // profiles are designed to be populated with new tags.
  cmsHPROFILE hProfile = cmsCreatePlaceholderProfile(NULL);
  if (hProfile == NULL) {
    return 0;
  }

  // Write a tag to the profile, then read it back.
  // This ensures the tag exists and allows the fuzzer to reach the
  // previously uncovered Type_LUTB2A_Read function.
  if (Size > 0) {
    cmsWriteTag(hProfile, cmsSigBToA0Tag, Data);
  }
  cmsReadTag(hProfile, cmsSigBToA0Tag);

  // The existing fuzz target already calls these, but they will now be more
  // effective as the profile is valid and writable.
  cmsReadTag(hProfile, cmsSigProfileSequenceDescTag);
  cmsReadTag(hProfile, cmsSigMetaTag);
  cmsReadTag(hProfile, cmsSigVcgtTag);

  // Target 5: Fuzz cmsSmoothToneCurve
  // This part is independent of the profile handle and requires manual memory management.
  if (Size > sizeof(cmsUInt16Number) * 256 + sizeof(double)) {
    cmsToneCurve *curve = NULL;
    double smoothing_param;

    memcpy(&smoothing_param, Data + sizeof(cmsUInt16Number) * 256, sizeof(double));

    curve = cmsBuildTabulatedToneCurve16(NULL, 256, (cmsUInt16Number *)Data);
    if (curve != NULL) {
      cmsSmoothToneCurve(curve, smoothing_param);
      cmsFreeToneCurve(curve);
    }
  }

  // Allocate and free a cmsIT8 handle to exercise that part of the API.
  // We use the public API which deals with opaque cmsHANDLE types.
  // We pass NULL to cmsIT8Alloc to use the default context.
  cmsHANDLE hIT8 = cmsIT8Alloc(NULL);
  if (hIT8) {
      cmsIT8Free(hIT8);
  }


  // Clean up the profile handle and all associated tags.
  cmsCloseProfile(hProfile);

  return 0;
}[0m
