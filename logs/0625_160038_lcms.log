                free(csaBuffer);
            }
        }

        // We do the same for cmsGetPostScriptCRD.
        cmsUInt32Number crdSize = cmsGetPostScriptCRD(NULL, hProfile, 0, 0, NULL, 0);
        if (crdSize > 0) {
            void *crdBuffer = malloc(crdSize);
            if (crdBuffer) {
