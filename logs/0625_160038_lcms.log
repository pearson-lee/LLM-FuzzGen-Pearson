    io->seek(io, 0);

    // Target: Type_MPEcurve_Read (0% coverage)
    // This function reads a multi-process element curve tag.
    void *mpe_curve = Type_MPEcurve_Read(&s, io, &nItems, (cmsUInt32Number)size);
    if (mpe_curve != NULL) {
        // The returned object is a cmsStage*. It must be freed.
        cmsStageFree((cmsStage*)mpe_curve);
    }
    io->seek(io, 0);

    // Target: Type_vcgt_Read (0% coverage)
