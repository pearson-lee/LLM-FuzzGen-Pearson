// Target 4: cmsGetPostScriptCSA with NamedColor profile
// The coverage report for cmsGetPostScriptCSA shows that the case for
// cmsSigNamedColorClass profiles is never hit. This function creates such a
// profile to exercise the code path for writing named colors to a
// PostScript Color Space Applet (CSA).
static void Fuzz_cmsGetPostScriptCSA(const uint8_t **Data, size_t *Size) {
    if (*Size < 2) return;

    // Create a named color profile.
    cmsHPROFILE hNamed = cmsCreateProfilePlaceholder(NULL);
    if (!hNamed) return;

    cmsSetDeviceClass(hNamed, cmsSigNamedColorClass);
    cmsSetColorSpace(hNamed, cmsSigCmykData);
    cmsSetPCS(hNamed, cmsSigLabData);

    // Allocate a named color list.
    cmsNAMEDCOLORLIST* ncl = cmsAllocNamedColorList(NULL, 1, 4, "prefix", "suffix");
    if (!ncl) {
        cmsCloseProfile(hNamed);
        return;
    }

    cmsUInt16Number PCS[3] = { 0x8000, 0x8000, 0x8000 }; // Some fixed Lab value
    cmsUInt16Number Device[4];
    Device[0] = (*Data)[0] << 8 | (*Data)[0];
    Device[1] = (*Data)[1] << 8 | (*Data)[1];
    Device[2] = 0;
    Device[3] = 0;
    *Data += 2; *Size -= 2;

    if (!cmsAppendNamedColor(ncl, "a_color", PCS, Device)) {
        cmsFreeNamedColorList(ncl);
        cmsCloseProfile(hNamed);
        return;
    }

    // Write the tag. This duplicates the list, so we can free ours.
    if (!cmsWriteTag(hNamed, cmsSigNamedColor2Tag, ncl)) {
        cmsFreeNamedColorList(ncl);
        cmsCloseProfile(hNamed);
        return;
    }
    cmsFreeNamedColorList(ncl);

    // Call the target function.
    char buffer[256];
    cmsGetPostScriptCSA(NULL, hNamed, INTENT_PERCEPTUAL, 0, buffer, sizeof(buffer));

    // Cleanup.
    cmsCloseProfile(hNamed);
}

