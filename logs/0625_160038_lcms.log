#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/src/lcms2_internal.h"
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

// Helper structure to manage fuzzer data consumption
typedef struct {
  const uint8_t *data;
  size_t size;
  size_t offset;
} FuzzData;

// Helper function to safely extract a chunk of data from the fuzzer input
static int GetFuzzData(FuzzData *fuzz_data, void *dest, size_t size) {
  if (fuzz_data->offset + size > fuzz_data->size || size == 0) {
    return 0; // Not enough data or invalid size
  }
  memcpy(dest, fuzz_data->data + fuzz_data->offset, size);
  fuzz_data->offset += size;
  return 1;
}

// Entry point for the fuzzer
int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzData fuzz_data = {Data, Size, 0};
  cmsContext context = cmsCreateContext(NULL, NULL);
  if (!context) {
    return 0;
  }

  // 1. Profile Parsing: Attempt to open a profile from the raw fuzzer data.
  // This is a primary vector for fuzzing the various Type_*_Read handlers.
  cmsHPROFILE hProfile = cmsOpenProfileFromMem(Data, Size);
  if (hProfile) {
    // 2. Black Point Detection: If the profile is valid, use it to call
    // cmsDetectDestinationBlackPoint, a function with low coverage.
    cmsCIEXYZ black_point;
    uint32_t intent;
    if (GetFuzzData(&fuzz_data, &intent, sizeof(intent))) {
      // The intent value is fuzzed to explore different code paths.
      cmsDetectDestinationBlackPoint(&black_point, hProfile, intent % 5, 0);
    }

    // 5. PostScript Output: Exercise the PostScript generation code.
    char buffer[2048];
    uint32_t ps_intent, ps_flags;
    if (GetFuzzData(&fuzz_data, &ps_intent, sizeof(ps_intent)) && GetFuzzData(&fuzz_data, &ps_flags, sizeof(ps_flags))) {
      // Fuzz the intent and flags to cover more branches.
      cmsGetPostScriptCSA(context, hProfile, ps_intent % 5, ps_flags, buffer, sizeof(buffer));
    }
    // The profile handle must be closed to prevent memory leaks.
    cmsCloseProfile(hProfile);
  }

  // 3. Tone Curve Creation: Build a segmented tone curve with fuzzed parameters.
  uint8_t num_segments_u8;
  if (GetFuzzData(&fuzz_data, &num_segments_u8, sizeof(num_segments_u8))) {
    int num_segments = (num_segments_u8 % 10) + 1; // Keep segment count reasonable
    cmsCurveSegment *segments = (cmsCurveSegment *)malloc(num_segments * sizeof(cmsCurveSegment));
    if (segments) {
      for (int i = 0; i < num_segments; i++) {
        // Fuzz all parameters for each segment.
        if (!GetFuzzData(&fuzz_data, &segments[i].x0, sizeof(segments[i].x0)) || !GetFuzzData(&fuzz_data, &segments[i].x1, sizeof(segments[i].x1)) || !GetFuzzData(&fuzz_data, &segments[i].Type, sizeof(segments[i].Type)) || !GetFuzzData(&fuzz_data, &segments[i].Params, sizeof(segments[i].Params))) {
          num_segments = i; // Stop if data runs out
          break;
        }
        // Ensure x0 <= x1 as required by the API.
        if (segments[i].x0 > segments[i].x1) {
          float temp = segments[i].x0;
          segments[i].x0 = segments[i].x1;
          segments[i].x1 = temp;
        }
        // Clamp type to a valid range [1, 6] to avoid out-of-bounds access
        // on the TypeHandlers array in cmsgamma.c.
        segments[i].Type = (segments[i].Type % 6) + 1;
      }

      if (num_segments > 0) {
        // Fixup segments to be well-formed (contiguous, start at 0, end at 1)
        segments[0].x0 = 0.0f;
        for (int i = 0; i < num_segments - 1; i++) {
            segments[i].x1 = segments[i+1].x0;
        }
        segments[num_segments - 1].x1 = 1.0f;

        cmsToneCurve *curve = cmsBuildSegmentedToneCurve(context, num_segments, segments);
        if (curve) {
          // Free the created tone curve to prevent leaks.
          cmsFreeToneCurve(curve);
        }
      }
      // Free the memory allocated for the segments array.
      free(segments);
    }
  }

  // 4. Device Link Profile Creation: Test cmsCreateInkLimitingDeviceLink.
  uint32_t color_space;
  double limit;
  if (GetFuzzData(&fuzz_data, &color_space, sizeof(color_space)) && GetFuzzData(&fuzz_data, &limit, sizeof(limit))) {
    // Fuzz the color space and limit to explore different behaviors.
    cmsHPROFILE hInkLimitProfile = cmsCreateInkLimitingDeviceLinkTHR(context, color_space, limit);
    if (hInkLimitProfile) {
      // Close the created profile handle.
      cmsCloseProfile(hInkLimitProfile);
    }
  }

  // Clean up the context at the end.
  cmsDeleteContext(context);
  return 0;
}[0m
