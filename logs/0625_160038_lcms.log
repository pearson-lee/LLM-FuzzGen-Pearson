int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < sizeof(cmsUInt32Number)) {
    return 0;
  }

  // Use a null context, as these low-level functions do not require a full context.
  cmsContext null_context = NULL;

  // Create an in-memory IO handler to simulate reading from a file.
  // The fuzzer's input data will be treated as the file content.
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(null_context, (void *)data, size, "r");
  if (io == NULL) {
    return 0;
  }

  // The type handler struct is required by the target functions.
  // We can use a dummy struct since its members are not directly accessed in a way
  // that would crash the fuzzer. The functions primarily use the context from it.
  struct _cms_typehandler_struct self;
  self.ContextID = null_context;

  cmsUInt32Number items = 0;
  cmsUInt32Number offset = 0;

  // Consume some of the fuzzing data to determine the offset.
  if (size > sizeof(cmsUInt32Number)) {
      offset = *(const cmsUInt32Number*)data;
  }

  // --- Target Function 1: Type_MPEcurve_Read ---
  // This function reads and parses a Multi-Process Element curve tag.
  void *mpe_curve = Type_MPEcurve_Read(&self, io, &items, offset);
  if (mpe_curve != NULL) {
    // The returned object is a cmsPipeline. We must free it to prevent memory leaks.
    cmsPipelineFree((cmsPipeline *)mpe_curve);
  }
  // Reset the IO handler to the beginning for the next function call.
  io->Seek(io, 0);

  // --- Target Function 2: Type_VideoSignal_Read ---
  // This function reads and parses a video signal tag.
  void *video_signal = Type_VideoSignal_Read(&self, io, &items, offset);
  if (video_signal != NULL) {
    // The returned object is a cmsVideoSignalType. We must free it.
    _cmsFree(null_context, video_signal);
  }
  io->Seek(io, 0);

  // --- Target Function 3: Type_Data_Read ---
  // This function reads a generic data tag.
  void *data_tag = Type_Data_Read(&self, io, &items, offset);
  if (data_tag != NULL) {
    // The returned object is a cmsICCData struct. We must free it.
    _cmsFree(null_context, data_tag);
  }
  io->Seek(io, 0);

  // --- Target Function 4: ReadSegmentedCurve ---
  // This function reads a complex segmented curve. It's another completely uncovered function.
  cmsToneCurve *segmented_curve = ReadSegmentedCurve(&self, io);
  if (segmented_curve != NULL) {
    // The returned object is a cmsToneCurve. We must free it.
    cmsFreeToneCurve(segmented_curve);
  }

  // Clean up the IO handler to prevent resource leaks.
  cmsCloseIOhandler(io);

  return 0;
}[0m
