  // Tag 5: Profile Sequence Description Tag (cmsSigProfileSequenceDescTag)
  if ((control & 0x10) && remaining_size > 1) {
    cmsUInt32Number n_seq = (current_data[0] % 3) + 1; // 1 to 4 sequences
    current_data++;
