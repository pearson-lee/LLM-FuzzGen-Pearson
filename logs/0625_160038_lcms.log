// Fuzz the IT8 (CGATS) parsing and writing functionality.
// This targets a separate parsing module from the main ICC profile handling.
void FuzzIT8(const uint8_t *Data, size_t Size) {
    // The library asserts on zero-sized inputs, so we avoid them.
    if (Size == 0) return;
    // Attempt to load an IT8 object from the fuzzer-provided data.
    cmsHANDLE it8 = cmsIT8LoadFromMem(NULL, Data, Size);
    if (it8) {
        // If loading is successful, exercise the writing logic as well.
        // First, determine the required size for the output buffer.
        cmsUInt32Number bytes_needed = 0;
        cmsIT8SaveToMem(it8, NULL, &bytes_needed);
        if (bytes_needed > 0) {
            void* buffer = malloc(bytes_needed);
            if (buffer) {
                // Write the IT8 data into the allocated buffer.
                cmsIT8SaveToMem(it8, buffer, &bytes_needed);
                free(buffer);
            }
        }
        // Clean up the allocated IT8 object.
        cmsIT8Free(it8);
    }
}

// Fuzz the core ICC profile parsing, transformation, and PostScript generation.
void FuzzTransform(const uint8_t *Data, size_t Size) {
    // Require a minimum size for control data and two non-empty profiles.
    if (Size < 16) return;

    // Use the first 8 bytes of data for format specifiers and flags.
    // The rest of the data will be treated as profile data.
    uint32_t inFormat = *(const uint32_t*)(Data);
    uint32_t outFormat = *(const uint32_t*)(Data + 4);
    Data += 8;
    Size -= 8;

    // Split the remaining data to act as two separate ICC profiles.
    size_t size1 = Size / 2;
    size_t size2 = Size - size1;
    const uint8_t* data1 = Data;
    const uint8_t* data2 = Data + size1;

    // Attempt to open the two profiles from the memory buffers.
    cmsHPROFILE hIn = cmsOpenProfileFromMem(data1, size1);
    cmsHPROFILE hOut = cmsOpenProfileFromMem(data2, size2);

    if (hIn) {
        // To improve coverage of tag parsing, explicitly read tags from the profile.
        // This triggers the various Type_*_Read functions in cmstypes.c.
        cmsUInt32Number tag_count = cmsGetTagCount(hIn);
        // Limit the number of tags to read to prevent timeouts on complex profiles.
        if (tag_count > 20) tag_count = 20;
        for (cmsUInt32Number i = 0; i < tag_count; i++) {
            cmsTagSignature sig = cmsGetTagSignature(hIn, i);
            // The pointer returned by cmsReadTag is owned by the profile and
            // is freed when cmsCloseProfile is called.
            cmsReadTag(hIn, sig);
        }
    }

    // Proceed if both profiles were opened successfully.
    if (hIn && hOut) {
        // Derive intent and flags from the control data.
        uint32_t intent = inFormat % 16;
        uint32_t flags = outFormat;

        // Create a color transform between the two profiles. This exercises
        // the pipeline and optimization logic.
        cmsHTRANSFORM hTransform = cmsCreateTransform(hIn, inFormat, hOut, outFormat, intent, flags);
        if (hTransform) {
            // If the transform is created, exercise it by transforming one pixel.
            // This triggers the format packing/unpacking functions in cmspack.c.
            uint8_t in_buf[256];
            uint8_t out_buf[256];
            memset(in_buf, 0xAB, sizeof(in_buf));
            cmsDoTransform(hTransform, in_buf, out_buf, 1);
            // Clean up the transform object.
            cmsDeleteTransform(hTransform);
        }
        
        // Exercise the PostScript generation for the input profile.
        // This targets the code in cmsps2.c.
        // First, get the required buffer size for the Color Space Array (CSA).
        cmsUInt32Number ps_size_csa = cmsGetPostScriptCSA(NULL, hIn, 0, 0, NULL, 0);
        if (ps_size_csa > 0) {
            void* ps_buffer = malloc(ps_size_csa);
            if (ps_buffer) {
                cmsGetPostScriptCSA(NULL, hIn, 0, 0, ps_buffer, ps_size_csa);
                free(ps_buffer);
            }
        }
        
        // Then, get the required buffer size for the Color Rendering Dictionary (CRD).
        cmsUInt32Number ps_size_crd = cmsGetPostScriptCRD(NULL, hIn, 0, 0, NULL, 0);
        if (ps_size_crd > 0) {
            void* ps_buffer = malloc(ps_size_crd);
            if (ps_buffer) {
                cmsGetPostScriptCRD(NULL, hIn, 0, 0, ps_buffer, ps_size_crd);
                free(ps_buffer);
            }
        }
    }

    // Clean up the profile handles.
    if (hIn) cmsCloseProfile(hIn);
    if (hOut) cmsCloseProfile(hOut);
}

