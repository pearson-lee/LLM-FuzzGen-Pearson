// Fuzzer-specific header for FuzzedDataProvider
#include <fuzzer/FuzzedDataProvider.h>

// lcms headers - using full project-relative paths as specified
#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/src/lcms2_internal.h" // For _cmsStageAllocLabPrelin and other internal functions

// Custom IO handler for fuzzing
// This structure holds the fuzzed data and current offset for reading.
typedef struct {
    const uint8_t* data;
    size_t size;
    size_t offset;
} FuzzIOHandlerData;

// Read function for cmsIOHANDLER
static cmsUInt32Number FuzzIORead(cmsIOHANDLER* io, void* Buffer, cmsUInt32Number Size, cmsUInt32Number Count) {
    FuzzIOHandlerData* fhd = (FuzzIOHandlerData*)io->ContextID;
    size_t bytes_to_read = Size * Count;
    if (fhd->offset + bytes_to_read > fhd->size) {
        bytes_to_read = fhd->size - fhd->offset;
    }
    memcpy(Buffer, fhd->data + fhd->offset, bytes_to_read);
    fhd->offset += bytes_to_read;
    return (cmsUInt32Number)(bytes_to_read / Size);
}

// Seek function for cmsIOHANDLER
static cmsBool FuzzIOSeek(cmsIOHANDLER* io, cmsUInt32Number Offset, cmsUInt32Number Origin) {
    FuzzIOHandlerData* fhd = (FuzzIOHandlerData*)io->ContextID;
    size_t new_offset;

    switch (Origin) {
        case SEEK_SET:
            new_offset = Offset;
            break;
        case SEEK_CUR:
            new_offset = fhd->offset + Offset;
            break;
        case SEEK_END:
            new_offset = fhd->size + Offset;
            break;
        default:
            return FALSE;
    }

    if (new_offset > fhd->size) {
        return FALSE; // Cannot seek beyond end of data
    }
    fhd->offset = new_offset;
    return TRUE;
}

// Close function for cmsIOHANDLER (no-op for fuzzer)
static cmsBool FuzzIOClose(cmsIOHANDLER* io) {
    // No resources to free here as data is owned by the fuzzer
    return TRUE;
}

// Tell function for cmsIOHANDLER
static cmsUInt32Number FuzzIOTell(cmsIOHANDLER* io) {
    FuzzIOHandlerData* fhd = (FuzzIOHandlerData*)io->ContextID;
    return (cmsUInt32Number)fhd->offset;
}

// Write function for cmsIOHANDLER (no-op for fuzzer, as we are reading)
static cmsUInt32Number FuzzIOWrite(cmsIOHANDLER* io, cmsUInt32Number Size, cmsUInt32Number Count, const void* Buffer) {
    // Not used for reading, so this can be a no-op or return 0
    return 0;
}

// Global context for lcms, initialized once.
// This helps avoid repeated context creation/destruction overhead per fuzzing iteration.
static cmsContext global_context = NULL;

// Custom error handler for lcms to prevent exiting on errors
static void FuzzErrorHandler(cmsContext ContextID, cmsUInt32Number ErrorCode, const char *Text) {
    // Suppress error messages to stdout/stderr during fuzzing
    (void)ContextID;
    (void)ErrorCode;
    (void)Text;
}

// LLVMFuzzerInitialize is called once at the beginning of the fuzzing process.
// It's used for one-time setup, like initializing the lcms context.
extern "C" int LLVMFuzzerInitialize(int *argc, char ***argv) {
    // Set a custom error handler to prevent lcms from exiting on errors.
    // This is crucial for continuous fuzzing.
    global_context = cmsCreateContext(NULL, NULL);
    if (global_context) {
        cmsSetLogErrorHandler(FuzzErrorHandler);
    }
    return 0;
}

// LLVMFuzzerTestOneInput is the main fuzzing function called for each input.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    // Ensure the global context was successfully created.
    if (!global_context) {
        return 0;
    }

    // Create a FuzzedDataProvider to extract structured data from the raw input.
    FuzzedDataProvider fdp(Data, Size);

    // Initialize custom IO handler data
    FuzzIOHandlerData fhd = {fdp.data(), fdp.remaining_bytes(), 0};

    // Create a cmsIOHANDLER instance for the fuzzed data.
    // This allows lcms functions that expect an IO handler to read from our fuzzed input.
    cmsIOHANDLER* io_handler = cmsCreateIOhandler(global_context, &fhd, FuzzIORead, FuzzIOWrite, FuzzIOSeek, FuzzIOTell, FuzzIOClose);
    if (!io_handler) {
        return 0;
    }

    // --- API Call 1: cmsOpenProfileFromIOhandler2THR ---
    // This function opens an ICC profile from an IO handler.
    // It's critical for processing ICC profiles and can expose parsing vulnerabilities.
    // Parameters: cmsContext, cmsIOHANDLER*, cmsBool (read_only)
    cmsBool read_only = fdp.ConsumeBool();
    cmsHPROFILE profile = cmsOpenProfileFromIOhandler2THR(global_context, io_handler, read_only);

    // If a profile was successfully opened, we can try to extract some information from it.
    // This helps exercise more code paths within the profile handling logic.
    if (profile) {
        // --- API Call 2: cmsGetProfileInfo ---
        // Retrieves information about the profile.
        // Parameters: cmsHPROFILE, cmsInfoType, const char* (Locale), const char* (DisplayName), wchar_t* (Buffer), cmsUInt32Number (BufferSize)
        cmsInfoType info_type = fdp.ConsumeEnum<cmsInfoType>(); // Fuzz the info type
        char locale_str[4]; // e.g., "en", "es", "fr"
        fdp.ConsumeData(&locale_str, sizeof(locale_str));
        locale_str[3] = '\0'; // Ensure null termination

        // Use a small buffer for the display name to test boundary conditions
        wchar_t display_name_buffer[64];
        cmsUInt32Number buffer_size = sizeof(display_name_buffer) / sizeof(wchar_t);

        cmsGetProfileInfo(profile, info_type, locale_str, NULL, display_name_buffer, buffer_size);

        // --- API Call 3: cmsFormatterForPCSOfProfile ---
        // Determines the formatter for the Profile Connection Space (PCS) of a profile.
        // Parameters: cmsHPROFILE, cmsUInt32Number (nFormatter), cmsBool (bInput)
        cmsUInt32Number nFormatter = fdp.ConsumeIntegral<cmsUInt32Number>();
        cmsBool bInput = fdp.ConsumeBool();
        cmsFormatterForPCSOfProfile(profile, nFormatter, bInput);

        // --- API Call 4: _cmsReadProfileSequence ---
        // Reads the profile sequence tag from a profile.
        // This is an internal function, but it's good for exercising deeper parsing logic.
        // Parameters: cmsHPROFILE
        cmsSEQ* seq = _cmsReadProfileSequence(profile);
        if (seq) {
            cmsFreeProfileSequence(seq); // Free the allocated sequence
        }

        // Close the profile to release resources.
        cmsCloseProfile(profile);
    }

    // --- API Call 5: _cmsStageAllocLabPrelin ---
    // Allocates a LabPrelin stage, which is a fundamental component in color transformations.
    // This function is internal and helps exercise memory allocation and stage creation.
    // Parameters: cmsContext
    cmsStage* lab_prelin_stage = _cmsStageAllocLabPrelin(global_context);
    if (lab_prelin_stage) {
        cmsStageFree(lab_prelin_stage); // Free the allocated stage
    }

    // Always close the IO handler to free its internal resources.
    cmsCloseIOhandler(io_handler);

    return 0; // Fuzzing successful
}[0m
