    // Use 8 bytes for the source length.
    if (offset + sizeof(uLong) <= size) {
        uLong sourceLen;
        memcpy(&sourceLen, data + offset, sizeof(sourceLen));
        offset += sizeof(sourceLen);
        (void)deflateBound(&strm, sourceLen);
    }

    // Target 4: _tr_tally
    // This is an internal function and requires the stream to be in an active
    // state. We will perform a small deflate operation to achieve this.
    if (strm.state && offset + sizeof(unsigned int) * 2 <= size) {
        unsigned dist, len;
        memcpy(&dist, data + offset, sizeof(dist));
        offset += sizeof(dist);
        memcpy(&len, data + offset, sizeof(len));
        offset += sizeof(len);

