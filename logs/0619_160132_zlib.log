    // Use one byte from the input as a character to push back.
    int c = data[offset++];
    gzungetc(c, file);

    // Target 2: gzseek (which in turn calls the uncovered gz_skip)
    // Use 8 bytes for the offset.
    if (offset + sizeof(long) <= size) {
        long seek_offset;
        memcpy(&seek_offset, data + offset, sizeof(seek_offset));
        offset += sizeof(seek_offset);
        // Seeking from the current position is a good way to exercise gz_skip.
        gzseek(file, seek_offset, SEEK_CUR);
    }

    // Clean up the gzFile and temporary file.
    gzclose(file);
    remove(filename);


