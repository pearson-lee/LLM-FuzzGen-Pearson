int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    if (size < 10) {
        return 0;
    }

    // Create a temporary file for writing compressed data.
    char filename[256];
    if (tmpnam(filename) == NULL) {
        return 0;
    }

    // Consume data for gzsetparams
    int level = data[0] % 10;
    int strategy = data[1] % 5;
    data += 2;
    size -= 2;

    // Open the temporary file for writing.
    gzFile f_write = gzopen(filename, "wb");
    if (f_write == NULL) {
        return 0;
    }

    // Use gzsetparams to set compression parameters.
    gzsetparams(f_write, level, strategy);

    // Use gzprintf to write a portion of the input data to the compressed file.
    // The format string is also taken from the input data.
    if (size > 2) {
        char format[3];
        format[0] = '%';
        format[1] = 's';
        format[2] = '\0';
        gzprintf(f_write, format, data);
    }

    // Close the file to finish writing.
    gzclose(f_write);

    // Open the temporary file for reading.
    gzFile f_read = gzopen(filename, "rb");
    if (f_read != NULL) {
        // Use gzgets to read back the data.
        char buffer[256];
        gzgets(f_read, buffer, sizeof(buffer));
        gzclose(f_read);
    }

    // Remove the temporary file.
    remove(filename);

    // Target deflateBound.
    if (size > 4) {
        z_stream strm;
        strm.zalloc = Z_NULL;
        strm.zfree = Z_NULL;
        strm.opaque = Z_NULL;
        if (deflateInit(&strm, level) == Z_OK) {
            uLong sourceLen = *(const uLong*)data;
            deflateBound(&strm, sourceLen);
            deflateEnd(&strm);
        }
    }

    // Target zlibCompileFlags.
    zlibCompileFlags();

    return 0;
}[0m
