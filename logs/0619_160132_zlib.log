#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <unistd.h>

#include "/src/zlib/zlib.h"

// Fuzz target for zlib's gzip file access functions.
// This fuzzer targets the following functions, with a focus on low-coverage areas:
// - gzsetparams: To test different compression levels and strategies.
// - gzseek64: To test seeking, which internally calls the uncovered gz_skip function.
// - gzungetc: To test pushing characters back to the stream.
// - gzwrite, gzread, gzgets: To perform basic I/O operations.
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    if (size < 16) {
        return 0;
    }

    // Create a temporary file to write to and read from.
    // Using a file descriptor allows us to test the gzdopen interface.
    char tmpfilename[256];
    sprintf(tmpfilename, "/tmp/libfuzzer.%d", getpid());

    FILE *tmp = fopen(tmpfilename, "wb+");
    if (!tmp) {
        return 0;
    }
    int fd = fileno(tmp);

    // Consume data for parameters
    int level = data[0] % 10;
    int strategy = data[1] % 5;
    data += 2;
    size -= 2;

    z_off64_t seek_offset = 0;
    if (size > sizeof(z_off64_t)) {
        memcpy(&seek_offset, data, sizeof(z_off64_t));
        data += sizeof(z_off64_t);
        size -= sizeof(z_off64_t);
    }
    int seek_whence = data[0] % 3;
    data += 1;
    size -= 1;

    if (size == 0) {
        fclose(tmp);
        remove(tmpfilename);
        return 0;
    }
    
    // Write data to the temporary file in gzip format
    gzFile writeFile = gzdopen(dup(fd), "wb");
    if (!writeFile) {
        fclose(tmp);
        remove(tmpfilename);
        return 0;
    }

    // Set compression parameters, targeting gzsetparams
    gzsetparams(writeFile, level, strategy);

    // Write a chunk of the data
    int bytes_to_write = size / 2;
    gzwrite(writeFile, data, bytes_to_write);
    gzclose(writeFile);

    // Rewind the file to read from the beginning
    rewind(tmp);

    // Read data back from the gzip file
    gzFile readFile = gzdopen(dup(fd), "rb");
    if (!readFile) {
        fclose(tmp);
        remove(tmpfilename);
        return 0;
    }

    // Seek within the file, targeting gzseek64 and the underlying gz_skip
    gzseek64(readFile, seek_offset, seek_whence);

    char buffer[256];
    gzread(readFile, buffer, sizeof(buffer));

    // Push a character back to the stream, targeting gzungetc
    if (size > 1) {
        gzungetc(data[0], readFile);
    }

    // Read again after ungetc
    gzgets(readFile, buffer, sizeof(buffer));

    gzclose(readFile);

    // Clean up the temporary file
    fclose(tmp);
    remove(tmpfilename);

    return 0;
}[0m
