// We will target:
// 1. gzungetc - Pushes a character back to the stream.
// 2. gzseek (to trigger gz_skip) - Seeks in a compressed stream.
// 3. deflateBound - Calculates the upper bound of compressed data.
// 4. _tr_tally - An internal function for the deflate algorithm.
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    if (size < 20) {
        // Need enough data to perform all operations.
        return 0;
    }

    // A simple way to consume data from the fuzzer input.
    size_t offset = 0;

    // --- gzFile Operations ---

    // Create a temporary file to work with gzFile APIs.
    char filename[256];
    sprintf(filename, "/tmp/zlib_fuzz_%d", getpid());

    FILE *fp = fopen(filename, "wb");
    if (!fp) {
        return 0;
    }
    // Write the fuzz data to the file.
    fwrite(data, 1, size, fp);
    fclose(fp);

    // Open the file for reading with gzopen.
    gzFile file = gzopen(filename, "rb");
