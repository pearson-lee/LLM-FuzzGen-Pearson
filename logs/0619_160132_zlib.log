// Fuzzer entry point.
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 3) {
    return 0;
  }

  // Call zlibCompileFlags to improve its coverage.
  zlibCompileFlags();

  // Create a temporary file to write compressed data to.
  // This is a safe way to create a temporary file that is automatically
  // removed when the program exits.
  FILE *tmp = tmpfile();
  if (!tmp) {
    return 0;
  }
  int fd = fileno(tmp);

  // Open the file with gzdopen for writing.
  gzFile file = gzdopen(fd, "wb");
  if (file == NULL) {
    fclose(tmp);
    return 0;
  }

  // Use a byte from the input to determine the compression level.
  int level = data[0] % 10;

  // Use another byte for the strategy.
  int strategy = data[1] % 5;

  // Set compression parameters to exercise gzsetparams.
  gzsetparams(file, level, strategy);

  // Write the rest of the data to the compressed file.
  gzwrite(file, data + 2, size - 2);

  // Close the file. This does not close the underlying file descriptor.
  gzclose(file);

  // Rewind the temporary file to read from the beginning.
  rewind(tmp);
  fd = fileno(tmp);

  // Re-open the file for reading.
  file = gzdopen(fd, "rb");
  if (file == NULL) {
    fclose(tmp);
    return 0;
  }

  // Read from the file char by char to exercise gzgetc and gzgetc_.
  while (gzgetc(file) != -1) {
  }

  // Close the file again.
  gzclose(file);

  // Close and automatically delete the temporary file.
  fclose(tmp);

  // Now, let's exercise deflateBound and inflateReset.
  z_stream strm;
  strm.zalloc = Z_NULL;
  strm.zfree = Z_NULL;
  strm.opaque = Z_NULL;

  // Initialize for deflation.
  if (deflateInit(&strm, level) != Z_OK) {
    return 0;
  }

  // Get the deflate bound to exercise deflateBound.
  uLong bound = deflateBound(&strm, size);

  // Allocate buffer for compressed data.
  unsigned char *compr = (unsigned char *)malloc(bound);
  if (compr == NULL) {
    deflateEnd(&strm);
    return 0;
  }

  strm.avail_in = size;
  strm.next_in = (Bytef *)data;
  strm.avail_out = bound;
  strm.next_out = compr;

  // Deflate the data.
  deflate(&strm, Z_FINISH);
  uLong comprLen = strm.total_out;
  deflateEnd(&strm);

  // Initialize for inflation.
  if (inflateInit(&strm) != Z_OK) {
    free(compr);
    return 0;
  }

  // Allocate buffer for decompressed data.
  unsigned char *uncompr = (unsigned char *)malloc(size);
  if (uncompr == NULL) {
    inflateEnd(&strm);
    free(compr);
    return 0;
  }

  strm.avail_in = comprLen;
  strm.next_in = compr;
  strm.avail_out = size;
  strm.next_out = uncompr;

  // Inflate the data.
  inflate(&strm, Z_NO_FLUSH);

  // Reset the inflation stream to exercise inflateReset.
  inflateReset(&strm);

  // Try to inflate again from the beginning.
  strm.avail_in = comprLen;
  strm.next_in = compr;
  strm.avail_out = size;
  strm.next_out = uncompr;
  inflate(&strm, Z_FINISH);

  inflateEnd(&strm);

  // Clean up allocated memory.
  free(compr);
  free(uncompr);

  return 0;
}[0m
