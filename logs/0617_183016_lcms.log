            primaries.Green.x = fdp.ConsumeFloatingPoint<double>();
            primaries.Green.y = fdp.ConsumeFloatingPoint<double>();
            primaries.Green.Y = fdp.ConsumeFloatingPoint<double>();
            primaries.Blue.x = fdp.ConsumeFloatingPoint<double>();
