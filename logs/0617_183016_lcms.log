#include <fuzzer/FuzzedDataProvider.h>
#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <memory>
#include <cstdio> // For FILE operations and mkstemp
#include <unistd.h> // For close() and unlink()

// Include lcms2 headers
#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/src/lcms2_internal.h" // Added for _cmsContext_struct and _cms_curve_struct definitions

// Custom deleter for cmsHPROFILE to ensure proper deallocation using cmsCloseProfile.
struct ProfileDeleter {
    // This 'using pointer = cmsHPROFILE;' is crucial for std::unique_ptr to correctly
    // manage opaque void* types like cmsHPROFILE. It tells unique_ptr that its
    // internal pointer type is cmsHPROFILE, allowing direct assignment from functions
    // returning cmsHPROFILE.
    using pointer = cmsHPROFILE;
    void operator()(cmsHPROFILE p) const {
        if (p) {
            cmsCloseProfile(p);
        }
    }
};

// Custom deleter for cmsContext to ensure proper deallocation using cmsDeleteContext.
struct ContextDeleter {
    // cmsContext is typedef'd as 'struct _cmsContext_struct*', so unique_ptr should
    // manage the underlying struct type '_cmsContext_struct'.
    // The operator() correctly takes 'cmsContext' (which is '_cmsContext_struct*').
    void operator()(cmsContext c) const {
        if (c) {
            cmsDeleteContext(c);
        }
    }
};

// Custom deleter for cmsToneCurve to ensure proper deallocation using cmsFreeToneCurve.
struct ToneCurveDeleter {
    // cmsToneCurve is typedef'd as 'struct _cms_curve_struct', so unique_ptr should
    // manage 'cmsToneCurve'. The operator() correctly takes 'cmsToneCurve*'.
    void operator()(cmsToneCurve* tc) const {
        if (tc) {
            cmsFreeToneCurve(tc);
        }
    }
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a context for lcms operations. This context will be automatically
    // deleted when it goes out of scope thanks to std::unique_ptr and ContextDeleter.
    // We manage the underlying struct type '_cmsContext_struct' as cmsContext is a pointer to it.
    std::unique_ptr<_cmsContext_struct, ContextDeleter> context(cmsCreateContext(NULL, NULL));
    if (!context) {
        // If context creation fails, there's nothing more we can do.
        return 0;
    }

    // Randomly pick one of the target APIs to exercise to maximize diversity
    // across fuzzing runs and explore different code paths within the library.
    uint32_t api_choice = fdp.ConsumeIntegralInRange<uint32_t>(0, 4);

    switch (api_choice) {
        case 0: {
            // Target API 1: cmsCreateDeviceLinkFromCubeFile
            // This function takes a file path. We'll create a temporary file
            // and fill it with fuzzed data to simulate various file contents,
            // including malformed or unexpected data.
            std::string temp_filename_template = "/tmp/fuzz-cube-XXXXXX";
            // mkstemp modifies the template string, so we need a mutable buffer.
            std::vector<char> temp_filename_buffer(temp_filename_template.begin(), temp_filename_template.end());
            temp_filename_buffer.push_back('\0'); // Ensure null-termination for C-style string functions.

            int fd = mkstemp(temp_filename_buffer.data());
            if (fd != -1) {
                FILE* temp_file = fdopen(fd, "wb");
                if (temp_file) {
                    // Consume remaining fuzzer data to write into the temporary file.
                    std::vector<uint8_t> file_content = fdp.ConsumeRemainingBytes<uint8_t>();
                    fwrite(file_content.data(), 1, file_content.size(), temp_file);
                    fclose(temp_file); // Close the FILE* stream to flush data.

                    // Call the target API with the path to the fuzzed temporary file.
                    // The returned cmsHPROFILE (void*) will be managed by std::unique_ptr.
                    std::unique_ptr<void, ProfileDeleter> profile(
                        cmsCreateDeviceLinkFromCubeFile(temp_filename_buffer.data())
                    );
                } else {
                    // If fdopen fails, close the file descriptor directly.
                    close(fd);
                }
                // Clean up the temporary file from the filesystem to avoid clutter.
                remove(temp_filename_buffer.data());
            }
            break;
        }

        case 1: {
            // Target API 2: cmsCreateRGBProfile
            // This function creates an RGB profile from colorimetric data,
            // requiring cmsCIExyY (white point), cmsCIExyYTRIPLE (primaries),
            // and an array of cmsToneCurve (gamma curves).

            // Fuzz the white point (cmsCIExyY) with arbitrary double values.
            cmsCIExyY white_point;
            white_point.x = fdp.ConsumeFloatingPoint<double>();
            white_point.y = fdp.ConsumeFloatingPoint<double>();
            white_point.Y = fdp.ConsumeFloatingPoint<double>();

            // Fuzz the primaries (cmsCIExyYTRIPLE) with arbitrary double values.
            cmsCIExyYTRIPLE primaries;
            primaries.Red.x = fdp.ConsumeFloatingPoint<double>();
            primaries.Red.y = fdp.ConsumeFloatingPoint<double>();
            primaries.Red.Y = fdp.ConsumeFloatingPoint<double>();
            primaries.Green.x = fdp.ConsumeFloatingPoint<double>();
            primaries.Green.y = fdp.ConsumeFloatingPoint<double>();
            primaries.Green.Y = fdp.ConsumeFloatingPoint<double>();
            primaries.Blue.x = fdp.ConsumeFloatingPoint<double>();
            primaries.Blue.y = fdp.ConsumeFloatingPoint<double>();
            primaries.Blue.Y = fdp.ConsumeFloatingPoint<double>();

            // Fuzz the number of tone curves to create (up to a small limit for performance).
            // cmsCreateRGBProfile expects an array of exactly 3 cmsToneCurve* pointers.
            size_t num_curves = fdp.ConsumeIntegralInRange<size_t>(0, 3);
            std::vector<std::unique_ptr<cmsToneCurve, ToneCurveDeleter>> tone_curves_ptrs;
            cmsToneCurve* curves_for_api[3] = {nullptr, nullptr, nullptr}; // Initialize with nullptr

            for (size_t i = 0; i < num_curves && i < 3; ++i) { // Ensure we don't exceed 3 curves
                double gamma = fdp.ConsumeFloatingPoint<double>();
                // Clamp gamma to a reasonable range to prevent extreme values
                // that might lead to very long computations or resource exhaustion.
                if (gamma < 0.001) gamma = 0.001;
                if (gamma > 100.0) gamma = 100.0;

                // Create a simple gamma tone curve using the fuzzed gamma value.
                // context.get() returns _cmsContext_struct*, which is cmsContext.
                cmsToneCurve* curve = cmsBuildGamma(context.get(), gamma);
                if (curve) {
                    tone_curves_ptrs.emplace_back(curve); // Managed by unique_ptr for automatic cleanup.
                    curves_for_api[i] = curve; // Assign to the C-style array for the API call.
                }
            }

            // Call the target API.
            // The returned cmsHPROFILE (void*) will be managed by std::unique_ptr.
            std::unique_ptr<void, ProfileDeleter> profile(
                cmsCreateRGBProfile(&white_point, &primaries, curves_for_api)
            );

            // The `tone_curves_ptrs` vector of unique_ptr will automatically deallocate
            // the cmsToneCurve objects when it goes out of scope, ensuring memory safety.
            break;
        }

        case 2: {
            // Target API 3: cmsOpenProfileFromStream
            // This function opens a profile from a FILE* stream. We'll create a
            // temporary file, write fuzzed content, and then attempt to open it
            // with various fuzzed file modes.
            std::string temp_filename_template = "/tmp/fuzz-stream-XXXXXX";
            std::vector<char> temp_filename_buffer(temp_filename_template.begin(), temp_filename_template.end());
            temp_filename_buffer.push_back('\0'); // Null-terminate.

            int fd = mkstemp(temp_filename_buffer.data());
            if (fd != -1) {
                // Consume remaining fuzzer data for the file content.
                std::vector<uint8_t> file_content = fdp.ConsumeRemainingBytes<uint8_t>();
                
                // Fuzz the file mode string (e.g., "r", "rb", "w", "wb", "r+", "wb+").
                // Corrected PickValueInArray to use an initializer list.
                std::string mode_str = fdp.PickValueInArray({
                    "r", "rb", "w", "wb", "a", "ab", "r+", "rb+", "w+", "wb+", "a+", "ab+"
                });

                FILE* temp_file = fopen(temp_filename_buffer.data(), mode_str.c_str());
                if (temp_file) {
                    // Only write to the file if the mode allows it (contains 'w', 'a', or '+').
                    if (mode_str.find('w') != std::string::npos || mode_str.find('a') != std::string::npos || mode_str.find('+') != std::string::npos) {
                        fwrite(file_content.data(), 1, file_content.size(), temp_file);
                    }
                    // If the mode allows reading, seek to the beginning of the file
                    // to ensure the API reads from the start of the fuzzed content.
                    if (mode_str.find('r') != std::string::npos || mode_str.find('+') != std::string::npos) {
                        fseek(temp_file, 0, SEEK_SET);
                    }

                    // Call the target API. The returned cmsHPROFILE (void*) will be managed by unique_ptr.
                    std::unique_ptr<void, ProfileDeleter> profile(
                        cmsOpenProfileFromStream(temp_file, mode_str.c_str())
                    );
                    fclose(temp_file); // Close the FILE* stream.
                }
                // Clean up the temporary file from the filesystem.
                remove(temp_filename_buffer.data());
            }
            break;
        }

        case 3: {
            // Target API 4: cmsDupContext
            // This function duplicates an existing cmsContext. Fuzzing this
            // can uncover issues related to context copying and resource management.
            // Create a source context. It will be automatically deleted by unique_ptr.
            std::unique_ptr<_cmsContext_struct, ContextDeleter> src_context(cmsCreateContext(NULL, NULL));
            if (src_context) {
                // Fuzz the user_data parameter, which can be nullptr or a fuzzed address.
                // This tests how the duplication handles various user data pointers.
                void* user_data = fdp.ConsumeBool() ? nullptr : reinterpret_cast<void*>(fdp.ConsumeIntegral<uintptr_t>());

                // Call the target API. The duplicated context will also be managed by unique_ptr.
                // src_context.get() returns _cmsContext_struct*, which is cmsContext.
                std::unique_ptr<_cmsContext_struct, ContextDeleter> dup_context(
                    cmsDupContext(src_context.get(), user_data)
                );
            }
            // Both src_context and dup_context are automatically cleaned up by unique_ptr,
            // ensuring no memory leaks.
            break;
        }

        case 4: {
            // Target API 5: cmsGetProfileInfoUTF8
            // This function retrieves profile information as UTF8. Fuzzing this
            // can expose issues with string handling, buffer overflows, or
            // incorrect information retrieval.
            // First, create a simple dummy profile to query information from.
            // This ensures we have a valid profile handle for the API call.
            cmsCIExyY white_point = {0.95047, 1.0, 1.08883}; // Standard D50 white point
            cmsCIExyYTRIPLE primaries = {
                {0.64, 0.33, 1.0}, // Red primary
                {0.30, 0.60, 1.0}, // Green primary
                {0.15, 0.06, 1.0}  // Blue primary
            };
            // context.get() returns _cmsContext_struct*, which is cmsContext.
            cmsToneCurve* gamma_curve = cmsBuildGamma(context.get(), 2.2);
            std::unique_ptr<cmsToneCurve, ToneCurveDeleter> gamma_curve_ptr(gamma_curve);
            
            // cmsCreateRGBProfile expects an array of exactly 3 cmsToneCurve* pointers.
            cmsToneCurve* curves_for_api[3] = {nullptr, nullptr, nullptr};
            if (gamma_curve) {
                curves_for_api[0] = gamma_curve;
            }

            // The returned cmsHPROFILE (void*) will be managed by std::unique_ptr.
            std::unique_ptr<void, ProfileDeleter> profile(
                cmsCreateRGBProfile(&white_point, &primaries, curves_for_api)
            );

            if (profile) {
                // Fuzz cmsInfoType (an enum). This explores different types of profile information.
                // Assuming a small range covers common info types for fuzzing.
