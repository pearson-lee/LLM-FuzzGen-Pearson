    }
    if (fdp.ConsumeBool()) {
        ss << "SCIENTIFIC_NUMBER " << fdp.ConsumeFloatingPoint<cmsFloat64Number>() << "E" << fdp.ConsumeIntegralInRange<int>(-5, 5) << "\n"; // Scientific notation
    }
    // Added to hit the '\r\n' newline sequence branch in InSymbol (cmscgats.c)
    if (fdp.ConsumeBool()) {
        ss << "LINE_FEED\r\n";
    }
