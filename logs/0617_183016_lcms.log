fuzz target: 
#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <memory> // For std::unique_ptr
#include <cstdio> // For tmpfile, fclose, remove, mkstemp, fdopen
#include <unistd.h> // For close

// Include necessary lcms headers with full project-relative paths
#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/include/lcms2_plugin.h"
#include "/src/lcms/src/lcms2_internal.h"

#include <fuzzer/FuzzedDataProvider.h>

// Custom deleter for cmsHPROFILE to ensure proper cleanup with std::unique_ptr.
// This prevents memory leaks for cmsHPROFILE objects.
struct ProfileDeleter {
    void operator()(cmsHPROFILE p) const {
        if (p) {
            cmsCloseProfile(p);
        }
    }
};

// Custom deleter for cmsIT8 to ensure proper cleanup with std::unique_ptr.
// This prevents memory leaks for cmsIT8 objects.
struct IT8Deleter {
    void operator()(cmsIT8* p) const {
        if (p) {
            cmsIT8Free((cmsHANDLE)p);
        }
    }
};

// Custom deleter for cmsToneCurve to ensure proper cleanup with std::unique_ptr.
// This prevents memory leaks for cmsToneCurve objects.
struct ToneCurveDeleter {
    void operator()(cmsToneCurve* p) const {
        if (p) {
            cmsFreeToneCurve(p);
        }
    }
};

// Custom deleter for cmsContext to ensure proper cleanup with std::unique_ptr.
// This prevents memory leaks for cmsContext objects.
struct ContextDeleter {
    void operator()(cmsContext ctx) const {
        if (ctx) {
            cmsDeleteContext(ctx);
        }
    }
};

// Custom deleter for cmsHTRANSFORM to ensure proper cleanup with std::unique_ptr.
// This prevents memory leaks for cmsHTRANSFORM objects.
struct TransformDeleter {
    void operator()(cmsHTRANSFORM t) const {
        if (t) {
            cmsDeleteTransform(t);
        }
    }
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a new context for each fuzz run to isolate state and ensure memory safety.
    // The unique_ptr with ContextDeleter ensures cmsDeleteContext is called automatically.
    std::unique_ptr<void, ContextDeleter> context_ptr(cmsCreateContext(NULL, NULL));
    cmsContext ctx = static_cast<cmsContext>(context_ptr.get());
    if (!ctx) {
        // If context creation fails, there's nothing more we can do.
        return 0;
    }

    // --- API 1: cmsCreateRGBProfile ---
    // This function creates an RGB profile from given white point, primaries, and tone curves.
    // It's selected to exercise complex data structures and profile generation logic.
    cmsCIExyY whitePoint;
    whitePoint.x = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    whitePoint.y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    whitePoint.Y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);

    cmsCIExyYTRIPLE primaries;
    // Fuzz each component of the primaries (Red, Green, Blue)
    primaries.Red.x = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    primaries.Red.y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    primaries.Red.Y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);

    primaries.Green.x = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    primaries.Green.y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    primaries.Green.Y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);

    primaries.Blue.x = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    primaries.Blue.y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    primaries.Blue.Y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);

    // Generate tone curves. We need 3 tone curves for RGB (one for each channel).
    std::vector<std::unique_ptr<cmsToneCurve, ToneCurveDeleter>> toneCurves;
    std::vector<cmsToneCurve*> toneCurvePointers;
    for (int i = 0; i < 3; ++i) {
        // Use cmsBuildGammaTable for simplicity, fuzzing the gamma value.
        cmsFloat64Number gamma = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.1, 5.0);
        std::unique_ptr<cmsToneCurve, ToneCurveDeleter> curve(cmsBuildGammaTable(ctx, gamma));
        if (curve) {
            toneCurves.push_back(std::move(curve));
            toneCurvePointers.push_back(toneCurves.back().get());
        } else {
            // If curve creation fails, push a nullptr. cmsCreateRGBProfile should handle this gracefully.
            toneCurvePointers.push_back(nullptr);
        }
    }

    // Ensure the array of tone curve pointers always has 3 elements, even if some are null.
    while (toneCurvePointers.size() < 3) {
        toneCurvePointers.push_back(nullptr);
    }
    const cmsToneCurve** curves_array = toneCurvePointers.data();

    // Call cmsCreateRGBProfile. The returned profile is managed by unique_ptr.
    std::unique_ptr<cmsHPROFILE, ProfileDeleter> rgb_profile(
        cmsCreateRGBProfile(ctx, &whitePoint, &primaries, curves_array));

    // --- API 2: cmsCreateProofingTransform ---
    // This function creates a transform for proofing, requiring multiple profiles.
    // It tests the interaction between different profile types and intents.

    // Create dummy input, output, and proofing profiles.
    // Use the RGB profile created above if valid, otherwise create placeholders.
    std::unique_ptr<cmsHPROFILE, ProfileDeleter> input_profile;
    std::unique_ptr<cmsHPROFILE, ProfileDeleter> output_profile;
    std::unique_ptr<cmsHPROFILE, ProfileDeleter> proofing_profile;

    if (rgb_profile) {
        // Duplicate the RGB profile to use as input, output, and proofing profiles.
        // cmsDupProfile creates a new profile that needs to be closed independently.
        input_profile.reset(cmsDupProfile(rgb_profile.get()));
        output_profile.reset(cmsDupProfile(rgb_profile.get()));
        proofing_profile.reset(cmsDupProfile(rgb_profile.get()));
    } else {
        // If RGB profile creation failed, create generic placeholder profiles.
        input_profile.reset(cmsCreateProfilePlaceholder(ctx));
        output_profile.reset(cmsCreateProfilePlaceholder(ctx));
        proofing_profile.reset(cmsCreateProfilePlaceholder(ctx));
    }

    // Only proceed if we have valid profiles for the transform.
    if (input_profile && output_profile && proofing_profile) {
        cmsUInt32Number inputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
        cmsUInt32Number outputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
        // Fuzz intent values within a valid range (0-3 for perceptual, relative, saturation, absolute).
        cmsUInt32Number nIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
        cmsUInt32Number proofingIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
        cmsUInt32Number dwFlags = fdp.ConsumeIntegral<cmsUInt32Number>();

        // Call cmsCreateProofingTransform. The returned transform is managed by unique_ptr.
        std::unique_ptr<cmsHTRANSFORM, TransformDeleter> proofing_transform(
            cmsCreateProofingTransform(input_profile.get(), inputFormat,
                                       output_profile.get(), outputFormat,
                                       proofing_profile.get(), nIntent,
                                       proofingIntent, dwFlags));
    }

    // --- API 3: cmsCreateDeviceLinkFromCubeFileTHR ---
    // This function parses a .cube file and creates a device link profile.
    // It's excellent for fuzzing file parsing and profile creation from external data,
    // which often exposes vulnerabilities.
    std::string cube_file_content = fdp.ConsumeRandomLengthString(1024 * 10); // Max 10KB cube file content
    if (!cube_file_content.empty()) {
        // Create a temporary file to write the fuzzed .cube content.
        char filename_template[] = "/tmp/fuzz-cube-XXXXXX";
        int fd = mkstemp(filename_template); // Securely creates a unique temporary file
        if (fd != -1) {
            FILE* temp_file = fdopen(fd, "w+"); // Open the file descriptor as a FILE* stream
            if (temp_file) {
                fwrite(cube_file_content.data(), 1, cube_file_content.size(), temp_file);
                fclose(temp_file); // Close the file, flushing content

                // Call cmsCreateDeviceLinkFromCubeFileTHR with the temporary file path.
                // The returned profile is managed by unique_ptr.
                std::unique_ptr<cmsHPROFILE, ProfileDeleter> cube_profile(
                    cmsCreateDeviceLinkFromCubeFileTHR(ctx, filename_template));

                remove(filename_template); // Clean up the temporary file
            } else {
                close(fd); // Close the file descriptor if fdopen fails
                remove(filename_template); // Still attempt to remove the file
            }
        }
    }

    // --- API 4: cmsIT8SetData & cmsIT8SetDataDbl ---
    // These functions set data within an IT8 object, good for string parsing and internal data handling.
    std::unique_ptr<cmsIT8, IT8Deleter> it8_handle(cmsIT8Alloc(ctx));
    if (it8_handle) {
        std::string sheet = fdp.ConsumeRandomLengthString(100);
        std::string property = fdp.ConsumeRandomLengthString(100);
        std::string value = fdp.ConsumeRandomLengthString(200);

        // Test cmsIT8SetData with string values.
        cmsIT8SetData(it8_handle.get(), sheet.c_str(), property.c_str(), value.c_str());

        // Test cmsIT8SetDataDbl with double values.
        cmsFloat64Number double_value = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        cmsIT8SetDataDbl(it8_handle.get(), sheet.c_str(), property.c_str(), double_value);
    }

    // --- API 5: cmsSaveProfileToStream ---
    // This function saves a profile to a stream, testing serialization logic.
    // This is crucial for ensuring data integrity and can expose issues if profile data is malformed.
    // We'll use the rgb_profile created earlier, or a placeholder if it failed.
    std::unique_ptr<cmsHPROFILE, ProfileDeleter> profile_to_save;
    if (rgb_profile) {
        // Duplicate the RGB profile to save, ensuring the original is not affected.
        profile_to_save.reset(cmsDupProfile(rgb_profile.get()));
    } else {
        // If RGB profile creation failed, create a generic placeholder profile to save.
        profile_to_save.reset(cmsCreateProfilePlaceholder(ctx));
    }

    if (profile_to_save) {
        // Create a temporary file to save the profile data.
        char filename_template_save[] = "/tmp/fuzz-profile-XXXXXX";
        int fd_save = mkstemp(filename_template_save);
        if (fd_save != -1) {
            FILE* temp_file_save = fdopen(fd_save, "w+");
            if (temp_file_save) {
                // Call cmsSaveProfileToStream.
                cmsSaveProfileToStream(profile_to_save.get(), temp_file_save);
                fclose(temp_file_save); // Close the file
                remove(filename_template_save); // Clean up the temporary file
            } else {
                close(fd_save);
                remove(filename_template_save);
            }
        }
    }

    // All resources managed by std::unique_ptr (profiles, IT8 handles, tone curves, context, transforms)
    // will be automatically deallocated when they go out of scope at the end of LLVMFuzzerTestOneInput,
    // ensuring comprehensive memory safety and preventing leaks.
    return 0;
}[0m
