#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <memory> // For std::unique_ptr
#include <cstdio> // For tmpfile, fclose, remove, mkstemp, fdopen
#include <unistd.h> // For close

// Include necessary lcms headers with full project-relative paths
#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/include/lcms2_plugin.h"
#include "/src/lcms/src/lcms2_internal.h"

#include <fuzzer/FuzzedDataProvider.h>

// Custom deleter for cmsHPROFILE to ensure proper cleanup with std::unique_ptr.
// This prevents memory leaks for cmsHPROFILE objects.
struct ProfileDeleter {
    void operator()(void* p) const { // Changed cmsHPROFILE to void*
        if (p) {
            cmsCloseProfile(static_cast<cmsHPROFILE>(p));
        }
    }
};

// Custom deleter for cmsIT8 to ensure proper cleanup with std::unique_ptr.
// This prevents memory leaks for cmsIT8 objects.
struct IT8Deleter {
    void operator()(void* p) const { // Changed cmsIT8* to void*
        if (p) {
            cmsIT8Free(static_cast<cmsHANDLE>(p));
        }
    }
};

// Custom deleter for cmsToneCurve to ensure proper cleanup with std::unique_ptr.
// This prevents memory leaks for cmsToneCurve objects.
struct ToneCurveDeleter {
    void operator()(cmsToneCurve* p) const {
        if (p) {
            cmsFreeToneCurve(p);
        }
    }
};

// Custom deleter for cmsContext to ensure proper cleanup with std::unique_ptr.
// This prevents memory leaks for cmsContext objects.
struct ContextDeleter {
    void operator()(void* ctx) const { // Changed cmsContext to void*
        if (ctx) {
            cmsDeleteContext(static_cast<cmsContext>(ctx));
        }
    }
};

// Custom deleter for cmsHTRANSFORM to ensure proper cleanup with std::unique_ptr.
// This prevents memory leaks for cmsHTRANSFORM objects.
struct TransformDeleter {
    void operator()(void* t) const { // Changed cmsHTRANSFORM to void*
        if (t) {
            cmsDeleteTransform(static_cast<cmsHTRANSFORM>(t));
        }
    }
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a new context for each fuzz run to isolate state and ensure memory safety.
    // The unique_ptr with ContextDeleter ensures cmsDeleteContext is called automatically.
    std::unique_ptr<void, ContextDeleter> context_ptr(cmsCreateContext(NULL, NULL));
    cmsContext ctx = static_cast<cmsContext>(context_ptr.get());
    if (!ctx) {
        // If context creation fails, there's nothing more we can do.
        return 0;
    }

    // --- API 1: cmsCreateRGBProfile ---
    // This function creates an RGB profile from given white point, primaries, and tone curves.
    // It's selected to exercise complex data structures and profile generation logic.
    cmsCIExyY whitePoint;
    whitePoint.x = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    whitePoint.y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    whitePoint.Y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);

    cmsCIExyYTRIPLE primaries;
    // Fuzz each component of the primaries (Red, Green, Blue)
    primaries.Red.x = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    primaries.Red.y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    primaries.Red.Y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);

    primaries.Green.x = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    primaries.Green.y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    primaries.Green.Y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);

    primaries.Blue.x = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    primaries.Blue.y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
    primaries.Blue.Y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);

    // Generate tone curves. We need 3 tone curves for RGB (one for each channel).
    std::vector<std::unique_ptr<cmsToneCurve, ToneCurveDeleter>> toneCurves;
    std::vector<cmsToneCurve*> toneCurvePointers;
    for (int i = 0; i < 3; ++i) {
        // Use cmsBuildGamma for simplicity, fuzzing the gamma value.
        cmsFloat64Number gamma = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.1, 5.0);
        std::unique_ptr<cmsToneCurve, ToneCurveDeleter> curve(cmsBuildGamma(ctx, gamma)); // Fixed: cmsBuildGammaTable -> cmsBuildGamma
        if (curve) {
            toneCurves.push_back(std::move(curve));
            toneCurvePointers.push_back(toneCurves.back().get());
        } else {
            // If curve creation fails, push a nullptr. cmsCreateRGBProfile should handle this gracefully.
            toneCurvePointers.push_back(nullptr);
        }
    }

    // Ensure the array of tone curve pointers always has 3 elements, even if some are null.
    while (toneCurvePointers.size() < 3) {
        toneCurvePointers.push_back(nullptr);
    }
    const cmsToneCurve* const* curves_array = toneCurvePointers.data(); // Fixed: const correctness

    // Call cmsCreateRGBProfileTHR. The returned profile is managed by unique_ptr.
    std::unique_ptr<void, ProfileDeleter> rgb_profile( // Fixed: cmsHPROFILE -> void
        cmsCreateRGBProfileTHR(ctx, &whitePoint, &primaries, curves_array)); // Fixed: cmsCreateRGBProfile -> cmsCreateRGBProfileTHR

    // --- API 2: cmsCreateProofingTransform ---
    // This function creates a transform for proofing, requiring multiple profiles.
    // It tests the interaction between different profile types and intents.

    // Create dummy input, output, and proofing profiles.
    // Always create new placeholder profiles to avoid issues with cmsDupProfile.
    std::unique_ptr<void, ProfileDeleter> input_profile(cmsCreateProfilePlaceholder(ctx)); // Fixed: cmsHPROFILE -> void, removed cmsDupProfile
    std::unique_ptr<void, ProfileDeleter> output_profile(cmsCreateProfilePlaceholder(ctx)); // Fixed: cmsHPROFILE -> void, removed cmsDupProfile
    std::unique_ptr<void, ProfileDeleter> proofing_profile(cmsCreateProfilePlaceholder(ctx)); // Fixed: cmsHPROFILE -> void, removed cmsDupProfile

    // Only proceed if we have valid profiles for the transform.
    if (input_profile && output_profile && proofing_profile) {
        cmsUInt32Number inputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
        cmsUInt32Number outputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
        // Fuzz intent values within a valid range (0-3 for perceptual, relative, saturation, absolute).
        cmsUInt32Number nIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
