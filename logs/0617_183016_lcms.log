// Custom deleters for lcms handles to ensure memory safety with unique_ptr.
// These deleters are crucial for preventing memory leaks by automatically
// freeing lcms-allocated resources when the unique_ptr goes out of scope.
struct ContextDeleter {
    void operator()(cmsContext ctx) const {
        if (ctx) {
            cmsDeleteContext(ctx);
        }
    }
};

struct IOHandlerDeleter {
    void operator()(cmsIOHANDLER* io) const {
        if (io) {
            cmsCloseIOhandler(io);
        }
    }
};

struct ProfileDeleter {
    void operator()(cmsHPROFILE profile) const {
        if (profile) {
            cmsCloseProfile(profile);
        }
    }
};

struct TransformDeleter {
    void operator()(cmsHTRANSFORM transform) const {
        if (transform) {
            cmsDeleteTransform(transform);
        }
    }
};

