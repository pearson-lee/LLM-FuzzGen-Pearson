        case 1: count_for_create_int_array = 0; break;
        case 2: count_for_create_int_array = int_vec_data.size(); break;
        default: count_for_create_int_array = fdp.ConsumeIntegralInRange<int>(0, (int)int_vec_alloc_size + 2); break; // Can be > actual size
