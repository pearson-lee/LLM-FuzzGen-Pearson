#include <cstdint>
#include <memory>
#include <sstream>
#include <vector>

#include <fuzzer/FuzzedDataProvider.h>

// Include libtiff headers with full path as required.
// tiffio.h provides the core C API.
#include "/src/libtiff/libtiff/tiffio.h"
// tiffio.hxx provides the C++ stream support for TIFF I/O.
#include "/src/libtiff/libtiff/tiffio.hxx"

// A custom deleter for std::unique_ptr to ensure TIFF handles are closed.
// This provides RAII-style resource management for the TIFF object.
struct TiffDeleter {
  void operator()(TIFF *tif) {
    if (tif) {
      TIFFClose(tif);
    }
  }
};
using TiffUniquePtr = std::unique_ptr<TIFF, TiffDeleter>;

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzedDataProvider fdp(Data, Size);

  // Use a stringstream for in-memory TIFF I/O, avoiding the filesystem.
  std::stringstream tiff_stream;

  // --- Write Pass ---
  // This block creates a TIFF structure in memory.
  {
    // Open the TIFF stream for writing. TIFFStreamOpen is targeted to exercise
    // C++ stream-based I/O functions.
    TiffUniquePtr tif_write(TIFFStreamOpen(
        "fuzz_write.tif", static_cast<std::ostream *>(&tiff_stream)));
    if (!tif_write) {
      return 0;
    }

    // Consume randomized parameters for TIFF tags from the fuzzer.
    const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 1024);
    const uint32_t length = fdp.ConsumeIntegralInRange<uint32_t>(1, 1024);
    const uint16_t bps = fdp.PickValueInArray<uint16_t>({1, 2, 4, 8, 16});
    const uint16_t spp = fdp.ConsumeIntegralInRange<uint16_t>(1, 4);
    const uint16_t photometric = fdp.PickValueInArray<uint16_t>(
        {PHOTOMETRIC_MINISWHITE, PHOTOMETRIC_MINISBLACK, PHOTOMETRIC_RGB});
    const uint16_t planarconfig = fdp.PickValueInArray<uint16_t>(
        {PLANARCONFIG_CONTIG, PLANARCONFIG_SEPARATE});
    const uint16_t compression = fdp.PickValueInArray<uint16_t>(
        {COMPRESSION_NONE, COMPRESSION_PACKBITS, COMPRESSION_LZW});
    const uint32_t rowsperstrip =
        fdp.ConsumeIntegralInRange<uint32_t>(1, length);

    // Set fundamental TIFF fields to create a valid image structure.
    TIFFSetField(tif_write.get(), TIFFTAG_IMAGEWIDTH, width);
    TIFFSetField(tif_write.get(), TIFFTAG_IMAGELENGTH, length);
    TIFFSetField(tif_write.get(), TIFFTAG_BITSPERSAMPLE, bps);
    TIFFSetField(tif_write.get(), TIFFTAG_SAMPLESPERPIXEL, spp);
    TIFFSetField(tif_write.get(), TIFFTAG_PHOTOMETRIC, photometric);
    TIFFSetField(tif_write.get(), TIFFTAG_PLANARCONFIG, planarconfig);
    TIFFSetField(tif_write.get(), TIFFTAG_COMPRESSION, compression);
    TIFFSetField(tif_write.get(), TIFFTAG_ROWSPERSTRIP, rowsperstrip);

    // Write a directory, which is necessary before writing strip data.
    TIFFWriteDirectory(tif_write.get());

    // Calculate strip size and consume data to write.
    tmsize_t strip_size = TIFFStripSize(tif_write.get());
    if (strip_size > 0 && strip_size <= fdp.remaining_bytes()) {
      std::vector<uint8_t> strip_data = fdp.ConsumeBytes<uint8_t>(strip_size);

      // Target TIFFWriteEncodedStrip to write the first strip.
      TIFFWriteEncodedStrip(tif_write.get(), 0, strip_data.data(),
                            strip_data.size());
    }

    // Flush all pending data to the stringstream before closing.
    TIFFFlush(tif_write.get());
  } // tif_write is automatically closed here by the TiffUniquePtr destructor.

  std::string tiff_data = tiff_stream.str();
  if (tiff_data.empty()) {
    return 0;
  }

  // --- Read Pass ---
  // This block reads the TIFF data we just created.
  std::stringstream ss_read(tiff_data);
  {
    // Open the generated TIFF data for reading.
    TiffUniquePtr tif_read(
        TIFFStreamOpen("fuzz_read.tif", static_cast<std::istream *>(&ss_read)));
    if (!tif_read) {
      return 0;
    }

    uint32_t read_width = 0;
    uint32_t read_length = 0;
    TIFFGetField(tif_read.get(), TIFFTAG_IMAGEWIDTH, &read_width);
    TIFFGetField(tif_read.get(), TIFFTAG_IMAGELENGTH, &read_length);

    // TIFFReadRGBAStripExt has 0% coverage and is a key fuzzing target.
    if (read_width > 0 && read_length > 0) {
      uint32_t rps = 0;
      TIFFGetFieldDefaulted(tif_read.get(), TIFFTAG_ROWSPERSTRIP, &rps);
      if (rps == 0 || rps > read_length) {
        rps = read_length;
      }

      // Avoid excessive memory allocation to prevent OOM errors.
      if (read_width > 4096 || rps > 4096) {
        return 0;
      }

      // The raster buffer must be large enough for TIFFReadRGBAStripExt.
      tmsize_t raster_size = (tmsize_t)read_width * rps * sizeof(uint32_t);
      if (raster_size > 0) {
        // Use libtiff's own memory allocator as is best practice.
        uint32_t *raster = (uint32_t *)_TIFFmalloc(raster_size);
        if (raster) {
          // Call the target function with a fuzzer-controlled error flag.
          TIFFReadRGBAStripExt(tif_read.get(), 0, raster, fdp.ConsumeBool());
          // Free the buffer allocated by libtiff's memory management.
          _TIFFfree(raster);
        }
      }
    }
  } // tif_read is automatically closed here.

  return 0;
}[0m
