#include <cstdint>
#include <vector>
#include <fuzzer/FuzzedDataProvider.h>
#include "tiffio.h"

// Structure to hold in-memory TIFF data and its current position for I/O.
struct TiffData {
    std::vector<uint8_t> buffer;
    tmsize_t pos;
};

// Custom read function for libtiff to read from our in-memory buffer.
// This is required by TIFFClientOpen.
tmsize_t readProc(thandle_t handle, void* data, tmsize_t size) {
    TiffData* tiffData = reinterpret_cast<TiffData*>(handle);
    if (tiffData->pos + size > tiffData->buffer.size()) {
        size = tiffData->buffer.size() - tiffData->pos;
    }
    if (size > 0) {
        memcpy(data, tiffData->buffer.data() + tiffData->pos, size);
        tiffData->pos += size;
    }
    return size;
}

// Custom write function for libtiff to write to our in-memory buffer.
tmsize_t writeProc(thandle_t handle, void* data, tmsize_t size) {
    TiffData* tiffData = reinterpret_cast<TiffData*>(handle);
    size_t new_size = tiffData->pos + size;
    if (new_size > tiffData->buffer.size()) {
        tiffData->buffer.resize(new_size);
    }
    memcpy(tiffData->buffer.data() + tiffData->pos, data, size);
    tiffData->pos += size;
    return size;
}

// Custom seek function for libtiff to seek within our in-memory buffer.
toff_t seekProc(thandle_t handle, toff_t offset, int whence) {
    TiffData* tiffData = reinterpret_cast<TiffData*>(handle);
    toff_t new_pos = tiffData->pos;
    switch (whence) {
        case SEEK_SET:
            new_pos = offset;
            break;
        case SEEK_CUR:
            new_pos += offset;
            break;
        case SEEK_END:
            new_pos = tiffData->buffer.size() + offset;
            break;
    }
    if (new_pos < 0) {
        return -1;
    }
    tiffData->pos = new_pos;
    return tiffData->pos;
}

// Custom close function for libtiff. For in-memory, this is a no-op.
int closeProc(thandle_t) {
    return 0;
}

// Custom size function for libtiff to get the size of our in-memory buffer.
toff_t sizeProc(thandle_t handle) {
    TiffData* tiffData = reinterpret_cast<TiffData*>(handle);
    return tiffData->buffer.size();
}

// Dummy map/unmap functions, required by TIFFClientOpen but not used.
int mapProc(thandle_t, void**, toff_t*) {
    return 0;
}
void unmapProc(thandle_t, void*, toff_t) {}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
    if (size < 100) {
        return 0;
    }

    FuzzedDataProvider fdp(data, size);
    TiffData tiffData;
    tiffData.pos = 0;

    // Suppress error/warning messages to avoid spamming the console during fuzzing.
    TIFFSetErrorHandler(nullptr);
    TIFFSetWarningHandler(nullptr);

    // --- Writing Phase ---
    // Use TIFFClientOpen to work with an in-memory buffer instead of a real file.
    TIFF* tif_write = TIFFClientOpen("fuzz_write", "w",
                                     reinterpret_cast<thandle_t>(&tiffData),
                                     readProc, writeProc, seekProc, closeProc, sizeProc,
                                     mapProc, unmapProc);
    if (!tif_write) {
        return 0;
    }

    // Configure the TIFF directory with fuzzed, but plausible, values.
    uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
    uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
    uint16_t bpp = fdp.PickValueInArray<uint16_t>({1, 2, 4, 8, 16});
    uint16_t spp = fdp.PickValueInArray<uint16_t>({1, 3, 4});
    uint16_t planarconfig = fdp.PickValueInArray<uint16_t>({PLANARCONFIG_CONTIG, PLANARCONFIG_SEPARATE});
    uint16_t compression = fdp.PickValueInArray<uint16_t>({
        COMPRESSION_NONE, COMPRESSION_LZW, COMPRESSION_PACKBITS,
        COMPRESSION_DEFLATE, COMPRESSION_ADOBE_DEFLATE
    });
    uint16_t photometric = fdp.PickValueInArray<uint16_t>({
        PHOTOMETRIC_MINISWHITE, PHOTOMETRIC_MINISBLACK, PHOTOMETRIC_RGB,
        PHOTOMETRIC_PALETTE, PHOTOMETRIC_SEPARATED, PHOTOMETRIC_YCBCR
    });

    TIFFSetField(tif_write, TIFFTAG_IMAGEWIDTH, width);
    TIFFSetField(tif_write, TIFFTAG_IMAGELENGTH, height);
    TIFFSetField(tif_write, TIFFTAG_BITSPERSAMPLE, bpp);
    TIFFSetField(tif_write, TIFFTAG_SAMPLESPERPIXEL, spp);
    TIFFSetField(tif_write, TIFFTAG_PLANARCONFIG, planarconfig);
    TIFFSetField(tif_write, TIFFTAG_COMPRESSION, compression);
    TIFFSetField(tif_write, TIFFTAG_PHOTOMETRIC, photometric);
    TIFFSetField(tif_write, TIFFTAG_ROWSPERSTRIP, fdp.ConsumeIntegralInRange<uint32_t>(1, height));

    // Call TIFFWriteCheck to validate the directory before writing pixel data.
    bool is_tile = fdp.ConsumeBool();
    TIFFWriteCheck(tif_write, is_tile, "fuzz_write_check");

    // Write scanline data if the configuration is valid and buffer is available.
    tmsize_t scanline_size = TIFFScanlineSize(tif_write);
    if (scanline_size > 0 && scanline_size < fdp.remaining_bytes()) {
        std::vector<uint8_t> scanline_buf = fdp.ConsumeBytes<uint8_t>(scanline_size);
        if (scanline_buf.size() == scanline_size) {
            for (uint32_t row = 0; row < height; ++row) {
                if (TIFFWriteScanline(tif_write, scanline_buf.data(), row, 0) < 0) {
                    break;
                }
            }
        }
    }

    // Close the TIFF handle to flush all data and free resources.
    TIFFClose(tif_write);

    // --- Reading Phase ---
    if (tiffData.buffer.empty()) {
        return 0;
    }

    tiffData.pos = 0; // Reset position for reading from the start of the buffer.
    TIFF* tif_read = TIFFClientOpen("fuzz_read", "r",
                                    reinterpret_cast<thandle_t>(&tiffData),
                                    readProc, writeProc, seekProc, closeProc, sizeProc,
                                    mapProc, unmapProc);

    if (tif_read) {
        // Call TIFFRGBAImageOK to check if the image is valid for reading with the RGBA interface.
        char emsg[1024] = {0};
        TIFFRGBAImageOK(tif_read, emsg);

        // Also call TIFFWriteCheck on the read-only handle to hit uncovered error paths.
        TIFFWriteCheck(tif_read, is_tile, "fuzz_read_check");

        // Close the read handle to free its resources.
        TIFFClose(tif_read);
    }

    return 0;
}[0m
