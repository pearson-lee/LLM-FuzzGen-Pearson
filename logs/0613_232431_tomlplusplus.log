#include <stdexcept> // Required for std::out_of_range

// Main header for tomlplusplus, expected to be in a "toml++" subdirectory
// This should provide access to all necessary toml types and functions.
#include "toml++/toml.hpp" 
#include <fuzzer/FuzzedDataProvider.h>

// This fuzz target aims to exercise the following 0%-coverage APIs (or their effects)
// by creating and manipulating TOML objects and structures:
// 1. `toml::v3::key::~key(...)` - Exercised by creating toml::key objects.
// 2. `toml::v3::value<std::string>::~value(...)` (and other value types) - Exercised by creating toml::value objects.
// 3. `toml::v3::ex::parse_error::~~parse_error()` - Exercised by the try-catch block around toml::parse.
// 4. `toml::v3::toml_formatter::~~toml_formatter()` - Exercised by creating and using toml::toml_formatter.
// 5. `struct source_region & toml::v3::source_region::operator=(...)` - Exercised by assigning toml::source_region objects.
//
// Additionally, creating toml::array and toml::table and adding elements to them will
// indirectly exercise `toml::v3::impl::array_init_elem::~array_init_elem` and
// `toml::v3::impl::table_init_pair::~table_init_pair` respectively.

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Consume data to generate a TOML string for parsing.
    std::string toml_string = fdp.ConsumeRandomLengthString(Size); // Use a portion for the string
    
    toml::table tbl;
    bool parsed_ok = false;

    // 1. Attempt to parse the TOML string.
    try {
        tbl = toml::parse(toml_string);
        parsed_ok = true;
    } catch (const toml::parse_error& err) {
        if (fdp.ConsumeBool()) {
            toml::source_region sr1 = err.source(); 
            toml::source_region sr2;
            sr2 = sr1; 
        }
        // Exercise parse_error description() and operator<<
        (void)err.description(); // Added to cover err.description()
        std::ostringstream err_ss; err_ss << err; // Added to cover err.operator<<
    } catch (...) {
        // Catch any other exceptions to prevent crashes.
    }

    // 2. Exercise `toml::key` creation and destruction.
    if (fdp.ConsumeBool()) {
        std::string key_name = fdp.ConsumeRandomLengthString(32);
        if (!key_name.empty()) { 
             toml::key k(key_name); 
             // Exercise additional toml::key APIs based on coverage report
             (void)k.length(); (void)k.empty(); (void)k.data(); (void)k.str();
             (void)static_cast<std::string_view>(k); // operator string_view

             toml::source_region dummy_sr{}; // For testing constructors with source_region
             if (fdp.ConsumeBool()) { toml::key k_sr_const_ref(key_name, dummy_sr); (void)k_sr_const_ref; }
             if (fdp.ConsumeBool()) { toml::key k_sr_rval_ref(key_name, std::move(dummy_sr)); (void)k_sr_rval_ref; }
             
             toml::key k2(fdp.ConsumeRandomLengthString(10));
             (void)(k == k2); (void)(k != k2); (void)(k < k2); (void)(k <= k2); (void)(k > k2); (void)(k >= k2);
             std::string_view sv_for_k_cmp = key_name;
             (void)(k == sv_for_k_cmp); (void)(sv_for_k_cmp == k); // Cover key comparisons with string_view
             (void)k.begin(); (void)k.end();
             std::ostringstream key_ss; key_ss << k; // Cover key operator<<
        }
    }

    // 3. Exercise `toml::value` creation and destruction for various types.
    if (fdp.ConsumeBool()) {
        std::string str_val = fdp.ConsumeRandomLengthString(64);
        toml::value<std::string> v_str(str_val);
        // Exercise toml::value<std::string> APIs based on coverage
        (void)v_str.is_string(); (void)v_str.is_integer(); (void)v_str.as_string(); (void)v_str.as_integer();
        (void)v_str.get(); (void)*v_str;
        if (fdp.ConsumeBool()) { toml::value<std::string> v_str2(fdp.ConsumeRandomLengthString(10)); (void)(v_str == v_str2); (void)(v_str == str_val);}
    }
    if (fdp.ConsumeBool()) {
        toml::value<int64_t> v_int(fdp.ConsumeIntegral<int64_t>());
        // Exercise toml::value<int64_t> APIs
        (void)v_int.is_integer(); (void)v_int.is_string(); (void)v_int.as_integer(); (void)v_int.as_string();
        if (fdp.ConsumeBool()) { toml::value<int64_t> v_int2(fdp.ConsumeIntegral<int64_t>()); (void)(v_int == v_int2); (void)(v_int == v_int.get());}
    }
    if (fdp.ConsumeBool()) {
        toml::value<double> v_double(fdp.ConsumeFloatingPoint<double>());
        // Exercise toml::value<double> APIs
        (void)v_double.is_floating_point(); (void)v_double.as_floating_point();
        if (fdp.ConsumeBool()) { toml::value<double> v_double2(fdp.ConsumeFloatingPoint<double>());(void)(v_double == v_double2); (void)(v_double == v_double.get());}
    }
    if (fdp.ConsumeBool()) {
        toml::value<bool> v_bool(fdp.ConsumeBool());
        // Exercise toml::value<bool> APIs
        (void)v_bool.is_boolean(); (void)v_bool.as_boolean();
        if (fdp.ConsumeBool()) { toml::value<bool> v_bool2(fdp.ConsumeBool()); (void)(v_bool == v_bool2); (void)(v_bool == v_bool.get());}
    }
    if (fdp.ConsumeBool()) {
        toml::date d_val(fdp.ConsumeIntegralInRange<uint16_t>(1, 9999), fdp.ConsumeIntegralInRange<uint8_t>(1, 12), fdp.ConsumeIntegralInRange<uint8_t>(1, 28));
        toml::value<toml::date> v_date(d_val);
        // Exercise toml::date and toml::value<date> APIs
        (void)v_date.is_date(); (void)v_date.as_date();
        toml::date d2{fdp.ConsumeIntegralInRange<uint16_t>(1, 9999), fdp.ConsumeIntegralInRange<uint8_t>(1, 12), fdp.ConsumeIntegralInRange<uint8_t>(1, 28)};
        (void)(d_val == d2); (void)(d_val != d2); (void)(d_val < d2); (void)(d_val <= d2); (void)(d_val > d2); (void)(d_val >= d2);
        std::ostringstream date_ss; date_ss << d_val; // Cover date operator<<
        if (fdp.ConsumeBool()) { toml::value<toml::date> v_date2(d2); (void)(v_date == v_date2); (void)(v_date == d_val);}
    }
    if (fdp.ConsumeBool()) {
        toml::time t_val(fdp.ConsumeIntegralInRange<uint8_t>(0, 23), fdp.ConsumeIntegralInRange<uint8_t>(0, 59), fdp.ConsumeIntegralInRange<uint8_t>(0, 59), fdp.ConsumeIntegralInRange<uint32_t>(0, 999999999));
        toml::value<toml::time> v_time(t_val);
        // Exercise toml::time and toml::value<time> APIs
        (void)v_time.is_time(); (void)v_time.as_time();
        toml::time t2{fdp.ConsumeIntegralInRange<uint8_t>(0, 23), fdp.ConsumeIntegralInRange<uint8_t>(0, 59), fdp.ConsumeIntegralInRange<uint8_t>(0, 59)};
        (void)(t_val == t2); (void)(t_val != t2); (void)(t_val < t2); (void)(t_val <= t2); (void)(t_val > t2); (void)(t_val >= t2);
        std::ostringstream time_ss; time_ss << t_val; // Cover time operator<<
        if (fdp.ConsumeBool()) { toml::value<toml::time> v_time2(t2); (void)(v_time == v_time2); (void)(v_time == t_val);}
    }
     if (fdp.ConsumeBool()) {
        toml::date dt_date_part{fdp.ConsumeIntegralInRange<uint16_t>(1, 9999), fdp.ConsumeIntegralInRange<uint8_t>(1, 12), fdp.ConsumeIntegralInRange<uint8_t>(1, 28)};
        toml::time dt_time_part{fdp.ConsumeIntegralInRange<uint8_t>(0, 23), fdp.ConsumeIntegralInRange<uint8_t>(0, 59), fdp.ConsumeIntegralInRange<uint8_t>(0, 59)};
        toml::date_time dt_val(dt_date_part, dt_time_part);
        if (fdp.ConsumeBool()) { 
            toml::time_offset temp_offset; 
            temp_offset.minutes = fdp.ConsumeIntegralInRange<int16_t>(-1439, 1439); 
            dt_val.offset = temp_offset;
        }
        toml::value<toml::date_time> v_datetime(dt_val);
        // Exercise toml::date_time and toml::value<date_time> APIs
        (void)v_datetime.is_date_time(); (void)v_datetime.as_date_time(); (void)dt_val.is_local();
        toml::date_time dt2{dt_date_part, dt_time_part};
        (void)(dt_val == dt2); (void)(dt_val != dt2); (void)(dt_val < dt2); (void)(dt_val <= dt2); (void)(dt_val > dt2); (void)(dt_val >= dt2);
        std::ostringstream dt_ss; dt_ss << dt_val; // Cover date_time operator<<
        if (fdp.ConsumeBool()) { toml::date_time dt_from_d(dt_date_part); (void)dt_from_d; } // Cover date_time from date ctor
        if (fdp.ConsumeBool()) { toml::date_time dt_from_t(dt_time_part); (void)dt_from_t; } // Cover date_time from time ctor
        if (fdp.ConsumeBool()) { toml::value<toml::date_time> v_dt2(dt2); (void)(v_datetime == v_dt2); (void)(v_datetime == dt_val);}
    }
    // Exercise toml::time_offset operators
    if (fdp.ConsumeBool()) {
        toml::time_offset to1; to1.minutes = fdp.ConsumeIntegralInRange<int16_t>(-1439, 1439);
        toml::time_offset to2; to2.minutes = fdp.ConsumeIntegralInRange<int16_t>(-1439, 1439);
        (void)(to1 == to2); (void)(to1 != to2); (void)(to1 < to2); (void)(to1 <= to2); (void)(to1 > to2); (void)(to1 >= to2);
        std::ostringstream to_ss; to_ss << to1; // Cover time_offset operator<<
    }


    if (parsed_ok) {
        if (!tbl.empty() && fdp.ConsumeBool()) {
            auto it = tbl.begin(); 
            if (it != tbl.end()) {
                const toml::node* n_ptr = &(it->second); 
                if (n_ptr) {
                    toml::source_region sr_node1 = n_ptr->source(); 
                    toml::source_region sr_node2;
                    sr_node2 = sr_node1; 
                    // Exercise node::as<T>()
                    (void)n_ptr->as<toml::table>(); (void)n_ptr->as<toml::array>(); (void)n_ptr->as<std::string>();
                }
            }
            // Exercise node::operator=
            if (tbl.size() > 1 && fdp.ConsumeBool()) {
                 auto it1 = tbl.begin();
                 auto it2 = tbl.begin();
                 std::advance(it2,1); // Ensure it2 is different if possible
                 if (it1 != tbl.end() && it2 != tbl.end()) {
                    it1->second = it2->second; // Cover node copy assignment
                 }
            }
        }

        if (fdp.ConsumeBool()) {
            std::string new_key_str = fdp.ConsumeRandomLengthString(10);
            if (!new_key_str.empty()) { 
                tbl.insert_or_assign(new_key_str, fdp.ConsumeRandomLengthString(20));
            }
        }
        if (fdp.ConsumeBool()) { // Add boolean for formatter branch coverage
            std::string bool_key_str = fdp.ConsumeRandomLengthString(10);
            if (!bool_key_str.empty()) {
                 tbl.insert_or_assign(bool_key_str, fdp.ConsumeBool());
            }
        }
        if (fdp.ConsumeBool()) {
            std::string arr_key_str = fdp.ConsumeRandomLengthString(10);
            if (!arr_key_str.empty()) { 
                toml::array arr; 
                if (fdp.ConsumeBool()) arr.push_back(fdp.ConsumeIntegral<int64_t>());
                if (fdp.ConsumeBool()) arr.push_back(fdp.ConsumeRandomLengthString(5));
                if (fdp.ConsumeBool()) arr.push_back(fdp.ConsumeBool()); // For is_homogeneous tests

                // Exercise toml::array APIs based on coverage report
                if (fdp.ConsumeBool()) {
                    (void)arr.is_array(); (void)arr.is_table(); (void)arr.is_value(); // etc.
                    (void)arr.as_array(); (void)arr.as_table(); (void)arr.as_string(); // etc.
                    if (!arr.empty()) {
                        (void)arr.front(); (void)arr.back();
                        (void)arr[0];
                        try { (void)arr.at(0); } catch (const std::out_of_range&) {} // Cover array::at()
                        (void)arr.get(0);
                    }
                    (void)arr.cbegin(); (void)arr.cend(); (void)arr.max_size();
                    toml::node* first_nonmatch = nullptr;
                    toml::array empty_arr_for_homog_test;
                    (void)empty_arr_for_homog_test.is_homogeneous(toml::node_type::none, first_nonmatch); // Cover is_homogeneous empty case
                    (void)arr.is_homogeneous(toml::node_type::none, first_nonmatch);      // Cover is_homogeneous ntype=none
                    (void)arr.is_homogeneous(toml::node_type::integer, first_nonmatch); // Cover is_homogeneous specific type (match/mismatch)
                    
                    toml::array arr2; if (fdp.ConsumeBool()) arr2.push_back(10);
                    (void)(arr == arr2); (void)(arr != arr2); // Cover array comparison
                    std::ostringstream arr_ss; arr_ss << arr; // Cover array streaming

                    toml::array arr_copy_assign_target; arr_copy_assign_target = arr; // Cover copy assignment
                    toml::array arr_move_assign_target; arr_move_assign_target = std::move(arr_copy_assign_target); // Cover move assignment
                    
                    if (fdp.ConsumeBool() && !arr_move_assign_target.empty()) arr_move_assign_target.pop_back();
                    if (fdp.ConsumeBool()) arr_move_assign_target.truncate(arr_move_assign_target.size() / 2);
                    if (fdp.ConsumeBool() && !arr_move_assign_target.empty()) arr_move_assign_target.erase(arr_move_assign_target.begin());
                    arr_move_assign_target.shrink_to_fit();
                    if (fdp.ConsumeBool()) arr_move_assign_target.clear();
                }
                tbl.insert_or_assign(arr_key_str, arr); 
            }
        }
    } else {
        if (fdp.ConsumeBool()) {
            std::string key1 = fdp.ConsumeRandomLengthString(5);
            if (!key1.empty()) {
                 tbl.insert_or_assign(key1, "default_value");
            }
        }
    }
    
    // Exercise toml::path and at_path APIs based on coverage report
    if (fdp.ConsumeBool()) {
        std::string path_str1 = fdp.ConsumeRandomLengthString(15);
        if (fdp.ConsumeBool() && !tbl.empty() && tbl.begin() != tbl.end()) path_str1 = tbl.begin()->first.str(); // Use an existing key for better chance of finding node
        else if (fdp.ConsumeBool()) path_str1 = "a.b.c"; 
        
        if (!path_str1.empty()) {
            (void)tbl.at_path(path_str1); // Cover at_path(string_view)
            (void)static_cast<const toml::table&>(tbl).at_path(path_str1); // Cover const at_path(string_view)
        }

        toml::path p1(path_str1);
        toml::path p2(fdp.ConsumeRandomLengthString(10));
        if (fdp.ConsumeBool()) p2 = "d[0].e";


        (void)tbl.at_path(p1); // Cover at_path(path)
        (void)static_cast<const toml::table&>(tbl).at_path(p1); // Cover const at_path(path)

        (void)p1.empty(); (void)p1.size(); (void)p1.str();
        if (!p1.empty()) {
            const toml::path_component& comp = p1[0]; // Cover path::operator[]
            (void)comp.type();
            if (comp.type() == toml::path_component_type::key) (void)comp.key(); else if (comp.type() == toml::path_component_type::array_index) (void)comp.index();
        }
        
        (void)(p1 == p2); (void)(p1 != p2); // Cover path comparison
        std::ostringstream path_ss; path_ss << p1; // Cover path streaming

        toml::path p_assign_sv; p_assign_sv = "new.path.val"; (void)p_assign_sv; // Cover path::operator=(string_view)
        toml::path p_assign_path; p_assign_path = p1; (void)p_assign_path; // Cover path copy assignment
        toml::path p_move_path; p_move_path = std::move(p_assign_path); (void)p_move_path; // Cover path move assignment
        
        p_move_path.append("segment1"); p_move_path.prepend("root_seg"); // Cover append/prepend
        if (fdp.ConsumeBool()) p_move_path.clear(); // Cover clear
    }


    if (fdp.ConsumeBool()) {
        std::ostringstream ss;
        toml::toml_formatter formatter{tbl}; 
        ss << formatter;                     
    }
    
    if (fdp.ConsumeBool()) {
        std::ostringstream ss;
        toml::json_formatter json_fmt{tbl}; 
        ss << json_fmt;                     
    }
    if (fdp.ConsumeBool()) {
        std::ostringstream ss;
        toml::yaml_formatter yaml_fmt{tbl}; 
        ss << yaml_fmt;                     
    }

    return 0;
