extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
    FuzzedDataProvider fdp(data, size);
    
    // Main TOML table for operations.
    // Memory: toml::table manages its own resources using RAII. Contained nodes
    // (strings, numbers, nested tables/arrays) are also managed via RAII (e.g. std::string)
    // or smart pointers (std::unique_ptr<toml::node> within table/array).
    toml::table tbl;
    bool parsed_successfully = false;

    // === 1. Parsing TOML Data ===
    // Objective: Exercise the TOML parsing capabilities, including UTF-8 decoding,
    // various value type parsing, and error handling. This targets:
    // - `toml::parse()`
    // - Internals: `toml::v3::impl::utf8_decoder`, `toml::v3::impl::parse_key_buffer`
    // - Error handling: `toml::parse_error` (including its destructor)
    if (fdp.ConsumeBool()) { // Decide whether to attempt parsing
        std::string toml_string_content = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 2048));
        try {
            toml::parse_result result;
            if (fdp.ConsumeBool()) { // Parse from string_view
                result = toml::parse(toml_string_content);
            } else { // Parse from istream
                std::stringbuf buffer(toml_string_content);
                std::istream stream(&buffer);
                // The path_hint is used in error messages. Its string data is copied by the library if needed.
                result = toml::parse(stream, fdp.ConsumeRandomLengthString(32));
            }

            if (result) {
                tbl = std::move(result).table(); // Move the parsed table into tbl.
                parsed_successfully = true;
            } else {
                // Access error to potentially exercise parse_error members/destructor.
                // The error object is managed by parse_result.
                (void)result.error().description(); 
            }
        } catch (const toml::parse_error& e) {
            // Catch parse_error specifically. The object 'e' is RAII, destructor called on scope exit.
            (void)e.description(); 
        } catch (...) {
            // Catch any other potential exceptions during parsing.
        }
    }

    // === 2. Manual Table/Array/Value Construction & Manipulation ===
    // Objective: Exercise creation and manipulation of TOML data structures programmatically.
    // This targets constructors and destructors for:
    // - `toml::key`, `toml::value<T>`, `toml::array`, `toml::table`
    // - Implicitly: `toml::impl::table_init_pair`, `toml::impl::array_init_elem`
    // Also tests insertion, modification, and RAII memory management.
    if (fdp.ConsumeBool() || !parsed_successfully) { // Augment existing table or build one if parsing failed/skipped.
        size_t num_elements_to_add = fdp.ConsumeIntegralInRange<size_t>(0, 4);
        for (size_t i = 0; i < num_elements_to_add; ++i) {
            if (fdp.remaining_bytes() < 30) break; 
            std::string key_str = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(1, 24));
            if (key_str.empty() || key_str.find_first_of(".[]#\"'") != std::string::npos) {
                 key_str = "fuzz_gen_key_" + std::to_string(i);
            }
            
            try {
                toml::key current_key(key_str); // Exercises toml::key ctor/dtor.
                // create_random_node returns unique_ptr, ensuring node memory is managed.
                std::unique_ptr<toml::node> random_node = create_random_node(fdp, 0);
                if (random_node) {
                    // emplace_or_assign moves the node into the table. The table now owns the node.
                    tbl.emplace_or_assign(current_key, std::move(*random_node));
                }
            } catch (...) { /* Ignore errors in key/node creation or insertion */ }
        }
    }
    
    // === 3. Path Access ===
    // Objective: Exercise node access using TOML paths.
    // This targets `toml::table::at_path()` and `toml::path` objects, potentially hitting
    // 0%-coverage `operator()` in `at_path.inl` or `path.inl`.
    if (!tbl.empty() && fdp.ConsumeBool()) {
        std::string path_string = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 48));
        try {
            toml::path p(path_string); // Exercises toml::path constructor.
            toml::node_view<toml::node> node_at_p = tbl.at_path(p); // or tbl.at_path(path_string)
            if (node_at_p) {
                (void)node_at_p.type(); // Interact with the node_view.
                if (node_at_p.is_string()) {
                    // Accessing value via value<T>() exercises std::optional usage.
                    (void)node_at_p.value<std::string>();
                }
            }
        } catch (const std::out_of_range&) {
            // Expected if path not found.
        } catch (const toml::parse_error&) {
            // Expected if path syntax is invalid.
        } catch (...) {
            // Other exceptions.
        }
    }

    // === 4. Formatting TOML Data ===
    // Objective: Exercise TOML data serialization using formatters.
    // This targets `toml::toml_formatter`, `toml::json_formatter`, `toml::yaml_formatter`
    // (including their print methods and destructors).
    if (!tbl.empty() && fdp.ConsumeBool()) {
        std::ostringstream ss; // Output stream for the formatter.
        uint8_t formatter_type = fdp.ConsumeIntegralInRange<uint8_t>(0, 2);
        try {
            if (formatter_type == 0) {
                // toml_formatter is RAII, destructor called on scope exit.
                toml::toml_formatter formatter{tbl}; 
                ss << formatter;
            } else if (formatter_type == 1) {
                toml::json_formatter formatter{tbl};
                if (fdp.ConsumeBool()) formatter.flags(toml::json_formatter_flags::indentation);
                ss << formatter;
            } else {
                toml::yaml_formatter formatter{tbl};
                ss << formatter;
            }
            (void)ss.str(); // "Use" the formatted string.
        } catch (...) {
            // Catch exceptions during formatting.
        }
    }

    // === 5. Source Region Manipulation ===
    // Objective: Exercise `toml::source_region` creation and assignment.
    // This targets `toml::source_region::operator=`, constructors, and destructors.
    // Memory: `source_region` can hold a `std::shared_ptr<const std::string>` for the file path,
    // ensuring shared ownership and proper deallocation of the path string.
    if (fdp.ConsumeBool()) {
        try {
            toml::source_location begin_loc = {
                fdp.ConsumeIntegralInRange<uint32_t>(1, 100), 
                fdp.ConsumeIntegralInRange<uint32_t>(1, 100)
            };
            toml::source_location end_loc = {
                begin_loc.line + fdp.ConsumeIntegralInRange<uint32_t>(0, 5),
                begin_loc.column + fdp.ConsumeIntegralInRange<uint32_t>(0, 40)
            };
            if (end_loc.line == begin_loc.line && end_loc.column < begin_loc.column) {
                end_loc.column = begin_loc.column; 
            }

            // Create a shared_ptr for the path string. This manages the string's memory.
            auto source_file_path = std::make_shared<const std::string>(
                fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 32))
            );

            toml::source_region sr1(begin_loc, end_loc, source_file_path);
            toml::source_region sr2 = sr1; // Copy constructor.
            toml::source_region sr3;
            sr3 = sr1; // Assignment operator.

            if (parsed_successfully && !tbl.empty()) {
                auto it = tbl.cbegin();
                if (it != tbl.cend()) {
                    // Get source region from a parsed node.
                    const toml::source_region& node_sr = it->second.source();
                    sr3 = node_sr; // Assign from an existing source_region.
                }
            }
        } catch (...) {
            // Catch exceptions during source_region manipulation.
        }
    }

    // All TOML++ objects (tbl, keys, values, nodes, formatters, source_regions)
    // are designed with RAII principles. Their destructors will be called automatically
    // when they go out of scope, ensuring that all dynamically allocated memory
    // (e.g., strings, nodes within tables/arrays via unique_ptrs, shared_ptr for source_path)
    // is correctly deallocated. No manual delete calls are needed for these objects.

    return 0;
