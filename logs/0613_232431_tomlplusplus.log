                // Coverage: Add date, time, date_time cases for table emplace
                case 6: // Date
                    {
                        toml::date d_val{
                            fdp.ConsumeIntegralInRange<uint16_t>(1, 9999),
                            fdp.ConsumeIntegralInRange<uint8_t>(1, 12),
