        );
    }

    // BEGIN: Enhanced toml::array coverage
    if (fdp.ConsumeBool()) { 
        toml::array arr_enh; // Create an array for enhancement testing
        if (fdp.ConsumeBool()) arr_enh.push_back(fdp.ConsumeIntegral<int64_t>());
        if (fdp.ConsumeBool()) arr_enh.push_back(fdp.ConsumeRandomLengthString(3)); // Add another element
        
        // Call accessors only if array is not empty to prevent out-of-bounds access
        if (!arr_enh.empty()) {
            (void)arr_enh.front(); // Covers non-const toml::v3::array::front()
            (void)arr_enh.back();  // Covers non-const toml::v3::array::back()
            (void)arr_enh.at(0);   // Covers non-const toml::v3::array::at(unsigned long)
            (void)arr_enh[0];      // Covers non-const toml::v3::array::operator[](unsigned long)
        }
