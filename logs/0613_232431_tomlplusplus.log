// Forward declaration for recursive use in create_random_node
static std::unique_ptr<toml::node> create_random_node(FuzzedDataProvider& fdp, int current_depth);

// Helper function to create a random toml::node.
// This function is essential for populating tables and arrays with diverse TOML data types,
// thereby exercising the constructors, destructors, and manipulation methods for
// toml::value<T>, toml::array, and toml::table.
// Memory management: Returns a std::unique_ptr<toml::node>, ensuring that the created node's
// lifetime is managed. This unique_ptr is typically moved into a parent TOML structure
// (like toml::array or toml::table), which then takes ownership.
static std::unique_ptr<toml::node> create_random_node(FuzzedDataProvider& fdp, int current_depth) {
    constexpr int max_recursion_depth = 3; // Limit recursion to prevent stack overflow or excessive complexity.

    if (current_depth >= max_recursion_depth || fdp.remaining_bytes() < 5) {
        // Base case for recursion or insufficient data: create a simple string value.
        // Memory for std::string is managed by the string object itself.
        return std::make_unique<toml::value<std::string>>(fdp.ConsumeRandomLengthString(10));
    }

    std::unique_ptr<toml::node> node_ptr;
    // ConsumeIntegralInRange ensures that 'type' is within a defined bound.
    uint8_t type = fdp.ConsumeIntegralInRange<uint8_t>(0, 7);

    try {
        switch (type) {
            case 0: // String
                // Memory for std::string is managed by the string object.
                node_ptr = std::make_unique<toml::value<std::string>>(fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 64)));
                break;
            case 1: // Integer
