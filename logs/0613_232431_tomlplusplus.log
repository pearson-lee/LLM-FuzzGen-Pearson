                        fdp.ConsumeIntegralInRange<uint32_t>(0, 999999999)
                    });
                    break;
                case 8: // DateTime
                    {
                        toml::date d_tbl{
                            fdp.ConsumeIntegralInRange<uint16_t>(1, 9999),
