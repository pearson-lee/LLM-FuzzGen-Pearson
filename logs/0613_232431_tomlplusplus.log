// 3. toml::at_path(node&, const path&) and toml::at_path(node&, string_view)
// 4. toml::array::flatten()
// 5. toml::json_formatter (via operator<< to exercise its printing logic)

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider data_provider(data, size);

