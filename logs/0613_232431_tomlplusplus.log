                break;
            default: 
                node_ptr = std::make_unique<toml::value<std::string>>(fdp.ConsumeRandomLengthString(10));
                break;
        }
    } catch (...) {
        node_ptr = std::make_unique<toml::value<std::string>>("fallback_node_creation_error");
    }
    return node_ptr;
}


