                                        fdp.ConsumeIntegralInRange<uint8_t>(1, 12),   // month
                                        fdp.ConsumeIntegralInRange<uint8_t>(1, 28)    // day
                                    });
                                    break;
                                case 5: // Coverage: Add time to array
                                    arr.emplace_back(toml::time{
