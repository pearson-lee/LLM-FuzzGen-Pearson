#include "/src/tomlplusplus/include/toml++/toml.hpp" // Main library header for toml++
#include <fuzzer/FuzzedDataProvider.h>
#include <string>
#include <vector>
#include <sstream>  // For std::ostringstream
#include <memory>   // For std::unique_ptr, std::make_shared

// Forward declaration for recursive use in create_random_node
static std::unique_ptr<toml::node> create_random_node(FuzzedDataProvider& fdp, int current_depth);

// Helper function to create a random toml::node.
static std::unique_ptr<toml::node> create_random_node(FuzzedDataProvider& fdp, int current_depth) {
    constexpr int max_recursion_depth = 3; 

    if (current_depth >= max_recursion_depth || fdp.remaining_bytes() < 5) {
        return std::make_unique<toml::value<std::string>>(fdp.ConsumeRandomLengthString(10));
    }

    std::unique_ptr<toml::node> node_ptr;
    uint8_t type = fdp.ConsumeIntegralInRange<uint8_t>(0, 7);

    try {
        switch (type) {
            case 0: 
                node_ptr = std::make_unique<toml::value<std::string>>(fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 64)));
                break;
            case 1: 
                node_ptr = std::make_unique<toml::value<int64_t>>(fdp.ConsumeIntegral<int64_t>());
                break;
            case 2: 
                node_ptr = std::make_unique<toml::value<double>>(fdp.ConsumeFloatingPoint<double>());
                break;
            case 3: 
                node_ptr = std::make_unique<toml::value<bool>>(fdp.ConsumeBool());
                break;
            case 4: 
                node_ptr = std::make_unique<toml::value<toml::date>>(
                    fdp.ConsumeIntegralInRange<uint16_t>(1, 9999), 
                    fdp.ConsumeIntegralInRange<uint8_t>(1, 12),  
                    fdp.ConsumeIntegralInRange<uint8_t>(1, 28)   
                );
                break;
            case 5: 
                node_ptr = std::make_unique<toml::value<toml::time>>(
                    fdp.ConsumeIntegralInRange<uint8_t>(0, 23), 
                    fdp.ConsumeIntegralInRange<uint8_t>(0, 59),  
                    fdp.ConsumeIntegralInRange<uint8_t>(0, 59),  
                    fdp.ConsumeIntegralInRange<uint32_t>(0, 999999999) 
                );
                break;
            case 6: 
                {
                    auto arr = std::make_unique<toml::array>();
                    size_t array_size = fdp.ConsumeIntegralInRange<size_t>(0, 3); 
                    for (size_t i = 0; i < array_size; ++i) {
                        if (fdp.remaining_bytes() > 10) { 
                             auto child_node = create_random_node(fdp, current_depth + 1);
                             if (child_node) {
                                arr->push_back(std::move(*child_node));
                             }
                        } else {
                            break;
                        }
                    }
                    node_ptr = std::move(arr); 
                }
                break;
            case 7: 
                {
                    auto tbl_nested = std::make_unique<toml::table>();
                    size_t table_size = fdp.ConsumeIntegralInRange<size_t>(0, 2); 
                    for (size_t i = 0; i < table_size; ++i) {
                        if (fdp.remaining_bytes() > 20) { 
                            std::string key_str = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(1, 16));
                            if (key_str.empty() || key_str.find_first_of(".[]#\"'") != std::string::npos) {
                                key_str = "fuzz_key_" + std::to_string(i);
                            }
                            
                            toml::key k(key_str); 
                            auto child_node = create_random_node(fdp, current_depth + 1);
                            if (child_node) {
                                tbl_nested->insert(k, std::move(*child_node));
                            }
                        } else {
                            break;
                        }
                    }
                    node_ptr = std::move(tbl_nested); 
                }
                break;
            default: 
                node_ptr = std::make_unique<toml::value<std::string>>(fdp.ConsumeRandomLengthString(10));
                break;
        }
    } catch (...) {
        node_ptr = std::make_unique<toml::value<std::string>>("fallback_node_creation_error");
    }
    return node_ptr;
}


extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
    FuzzedDataProvider fdp(data, size);
    
    toml::table tbl;
    bool parsed_successfully = false;

    // === 1. Parsing TOML Data ===
    if (fdp.ConsumeBool()) { 
        std::string toml_string_content = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 2048));
        try {
            toml::table result_data; 
            if (fdp.ConsumeBool()) { 
                result_data = toml::parse(toml_string_content);
            } else { 
                std::stringbuf buffer(toml_string_content);
                std::istream stream(&buffer);
                result_data = toml::parse(stream, fdp.ConsumeRandomLengthString(32));
            }

            if (!result_data.empty()) { 
                tbl = std::move(result_data); 
                parsed_successfully = true;
            } else {
                // If TOML_EXCEPTIONS=0, parsing failure results in an empty table.
            }
        } catch (const toml::parse_error& e) {
