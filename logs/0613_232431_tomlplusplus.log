    } \
    if (const_node_obj.type_check_method()) { /* Exercise const node APIs */ \
        const toml::value<value_type>* const_val_ptr = const_node_obj.type_cast_method(); \
        if (const_val_ptr) { /* Coverage: Hit true branch for const node::as_X() */ \
