    // Generate a TOML string from fuzzer data.
    std::string toml_string = fdp.ConsumeRandomLengthString(2048);
    // Generate a source path string from fuzzer data.
    std::string source_path_string = fdp.ConsumeRandomLengthString(100);

    // Call toml::parse. This is a primary API and will exercise many internal components
    // like node, table, array, value, and key creation/destruction.
    // Memory for the parsed result is managed by the 'result' object (RAII).
    toml::parse_result result = toml::parse(toml_string, source_path_string);

    if (result) {
        // Parsing was successful.
        toml::table& tbl = result.table(); // Get the parsed table.

        // 2. Exercise toml::node::source() and toml::source_region::operator=
        // Get source_region from the parsed table (toml::table inherits from toml::node).
        toml::source_region sr_from_table = tbl.source();
        toml::source_region sr_assigned;

        // Exercise assignment operator for source_region.
        // This targets: struct source_region & toml::v3::source_region::operator=(struct source_region *, const struct source_region &)
        sr_assigned = sr_from_table;

        // Create a source_region with fuzzed data and assign it.
        // toml::source_index is uint32_t.
        toml::source_position pos_begin{fdp.ConsumeIntegral<toml::source_index>(), fdp.ConsumeIntegral<toml::source_index>()};
        toml::source_position pos_end{fdp.ConsumeIntegral<toml::source_index>(), fdp.ConsumeIntegral<toml::source_index>()};
        
        // Create a shared_ptr for the path, ensuring memory safety for source_region's path member.
        auto fuzzed_path_for_sr = std::make_shared<const std::string>(fdp.ConsumeRandomLengthString(50));
        toml::source_region sr_fuzzed{pos_begin, pos_end, fuzzed_path_for_sr};
        
        sr_assigned = sr_fuzzed; // Exercise assignment again with a fully fuzzed source_region.

        // 3. Exercise toml::at_path
        // Generate a TOML path string from fuzzer data.
        std::string path_str = fdp.ConsumeRandomLengthString(64);
        try {
            // Construct toml::path. This can throw toml::parse_error for invalid path syntax.
            toml::path toml_p(path_str); 
            
            // Call toml::at_path to retrieve a node_view.
            // This targets: node_view<toml::v3::node> toml::v3::at_path(node &, const path &)
            if (auto node_view = toml::at_path(tbl, toml_p)) {
                // Successfully found a node.
                // Further exercise: get its source region and assign it.
                toml::source_region node_at_path_sr = node_view->source();
                sr_assigned = node_at_path_sr; 
            }
        } catch (const toml::parse_error&) {
            // Catch parsing errors from invalid path strings. This is expected.
        } catch (const std::exception&) {
            // Catch other potential exceptions during path operations.
        }

        // 4. Exercise toml::json_formatter and its print method
        std::ostringstream oss; // Output stream for the formatter.
        
        // Construct toml::json_formatter. It takes a pointer to the node.
        // The 'tbl' (from 'result') outlives this formatter instance.
        toml::json_formatter formatter{oss, &tbl};
        try {
            // Call the print method to format the TOML table as JSON.
            // This targets: void toml::v3::json_formatter::print()
            formatter.print(); 
        } catch (const std::exception&) {
            // Catch potential exceptions during formatting.
        }
        // std::string json_output = oss.str(); // Optionally use the output.
        // (void)json_output; // To prevent unused variable warning.

    } else {
        // Parsing failed.
        // Exercise toml::parse_error::source() and source_region assignment.
        const toml::parse_error& err = result.error();
        toml::source_region error_sr = err.source();
        toml::source_region sr_assigned_err;
        sr_assigned_err = error_sr; // Exercise assignment with error's source region.
    }

    // All resources are managed by RAII (std::string, std::shared_ptr, toml::parse_result, etc.),
    // ensuring no memory leaks.
    return 0;
}[0m
