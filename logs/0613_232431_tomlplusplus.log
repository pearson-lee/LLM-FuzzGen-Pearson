    } else if (fdp.ConsumeProbability<double>() < 0.05) {
        toml_string += std::string(1, (char)0xC2); // Incomplete 2-byte sequence (needs one more byte)
    } else if (fdp.ConsumeProbability<double>() < 0.05) {
