            if (!tbl.empty() && fdp.ConsumeBool()) {
                const toml::table& const_tbl_for_iter = tbl;
                auto cit_b = const_tbl_for_iter.begin(); 
                auto cit_e = const_tbl_for_iter.end();   
                if (cit_b != cit_e) {
                    (void)cit_b->first.str();
                    (void)cit_b->second.type();
                }
                auto ccit_b = const_tbl_for_iter.cbegin(); 
                auto ccit_e = const_tbl_for_iter.cend();   
                 if (ccit_b != ccit_e) {
