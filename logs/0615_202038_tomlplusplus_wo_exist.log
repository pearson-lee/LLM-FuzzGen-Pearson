        // Coverage: Target toml::node::at_path and toml::at_path
        if (fdp.ConsumeBool()) {
            std::string path_str = fdp.ConsumeRandomLengthString(30);
            if (fdp.ConsumeBool() && path_str.length() > 1) { // Try to make it slightly structured
