                            // Coverage: Calls range erase on an array using const_iterators to hit array.inl lines 235-237.
                            // The original fuzzer used non-const iterators here.
                            if (arr_ptr->size() >= 1 && fdp.ConsumeBool()) { // Allow erasing the whole array or parts of it
                                size_t first_idx = fdp.ConsumeIntegralInRange<size_t>(0, arr_ptr->size());
                                size_t count = 0;
                                if (first_idx < arr_ptr->size()) { // only pick count if first_idx is not already at end
