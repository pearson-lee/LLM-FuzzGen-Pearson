                    switch (node_val.type()) {
                        case toml::node_type::string:
                            if (node_val.is_string()) { auto vp = node_val.as_string(); if (vp) { (void)vp->get(); }}
                            break;
                        case toml::node_type::integer:
                            if (node_val.is_integer()) { auto vp = node_val.as_integer(); if (vp) { (void)vp->get(); }}
                            break;
                        case toml::node_type::floating_point:
                            if (node_val.is_floating_point()) { auto vp = node_val.as_floating_point(); if (vp) { (void)vp->get(); }}
                            break;
                        case toml::node_type::boolean:
                            if (node_val.is_boolean()) { auto vp = node_val.as_boolean(); if (vp) { (void)vp->get(); }}
                            break;
                        case toml::node_type::date:
                            if (node_val.is_date()) { auto vp = node_val.as_date(); if (vp) { (void)vp->get(); }}
                            break;
                        case toml::node_type::time:
                            if (node_val.is_time()) { auto vp = node_val.as_time(); if (vp) { (void)vp->get(); }}
                            break;
                        case toml::node_type::date_time:
                            if (node_val.is_date_time()) { auto vp = node_val.as_date_time(); if (vp) { (void)vp->get(); }}
                            break;
                        case toml::node_type::array: // Array operations are handled in the loop below
                            if (node_val.is_array()) { const auto* arr = node_val.as_array(); if (arr) { (void)arr->size(); }}
                            break;
                        case toml::node_type::table:
                            if (node_val.is_table()) { const auto* stbl = node_val.as_table(); if (stbl) { (void)stbl->size(); }}
                            break;
                        case toml::node_type::none:
                            break;
                    }
                } catch (const std::out_of_range&) { /* Expected */ }
            }

            if (fdp.ConsumeBool()) {
                for (auto&& [current_key_sv, current_node_ref] : tbl) {
                    toml::node* current_node_ptr = &current_node_ref;
                    if (current_node_ptr && current_node_ptr->is_array()) {
                        toml::array* arr_ptr = current_node_ptr->as_array();
                        if (arr_ptr && !arr_ptr->empty()) {
                            // Original erase (iterator)
                            if (fdp.ConsumeFloatingPointInRange<double>(0.0, 1.0) < 0.2) {
                                size_t erase_idx = fdp.ConsumeIntegralInRange<size_t>(0, arr_ptr->size() - 1);
                                auto it_to_erase = arr_ptr->begin(); // non-const iterator
                                std::advance(it_to_erase, erase_idx);
                                arr_ptr->erase(it_to_erase);
                                if (fdp.ConsumeBool()) break;
                            }

                            // Coverage: Target array::erase(const_iterator pos)
                            if ((fdp.ConsumeFloatingPointInRange<double>(0.0, 1.0) < 0.2) && !arr_ptr->empty()) { // Re-check empty
                                size_t erase_cidx = fdp.ConsumeIntegralInRange<size_t>(0, arr_ptr->size() - 1);
                                auto cit_to_erase = arr_ptr->cbegin(); // const_iterator
                                std::advance(cit_to_erase, erase_cidx);
                                arr_ptr->erase(cit_to_erase);
                                if (fdp.ConsumeBool()) break;
                            }

                            // Coverage: Target array::erase(const_iterator first, const_iterator last)
                            if ((fdp.ConsumeFloatingPointInRange<double>(0.0, 1.0) < 0.2) && !arr_ptr->empty()) { // Re-check empty
                                size_t first_idx = fdp.ConsumeIntegralInRange<size_t>(0, arr_ptr->size() - 1);
                                auto it_first = arr_ptr->cbegin();
                                std::advance(it_first, first_idx);
                                auto it_last = it_first;
                                ptrdiff_t remaining_elements = std::distance(it_first, arr_ptr->cend());
                                if (remaining_elements >= 0) { // distance can be 0 if it_first is cend
                                     ptrdiff_t count_to_erase = fdp.ConsumeIntegralInRange<ptrdiff_t>(0, remaining_elements);
                                     std::advance(it_last, count_to_erase);
                                     arr_ptr->erase(it_first, it_last);
                                     if (fdp.ConsumeBool()) break;
                                }
                            }

                            // Coverage: Target array_iterator<false>::operator+=
                            if ((fdp.ConsumeFloatingPointInRange<double>(0.0, 1.0) < 0.2) && !arr_ptr->empty()) { // Re-check empty
                                auto arr_it = arr_ptr->begin(); // non-const iterator
                                ptrdiff_t max_offset = std::distance(arr_it, arr_ptr->end());
                                if (max_offset > 0) {
