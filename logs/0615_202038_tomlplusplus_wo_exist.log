                            if (!arr_ptr->empty() && fdp.ConsumeBool()) { (void)arr_ptr->front().type(); }
                            if (!arr_ptr->empty() && fdp.ConsumeBool()) { (void)arr_ptr->back().type(); }
                            if (!arr_ptr->empty() && fdp.ConsumeBool()) {
