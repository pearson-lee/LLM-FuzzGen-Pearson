                        case toml::node_type::integer: if (node_val.is_integer()) { auto vp = node_val.as_integer(); if (vp) { (void)vp->get(); }} break;
                        case toml::node_type::floating_point: if (node_val.is_floating_point()) { auto vp = node_val.as_floating_point(); if (vp) { (void)vp->get(); }} break;
                        case toml::node_type::boolean: if (node_val.is_boolean()) { auto vp = node_val.as_boolean(); if (vp) { (void)vp->get(); }} break;
                        case toml::node_type::date: if (node_val.is_date()) { auto vp = node_val.as_date(); if (vp) { (void)vp->get(); }} break;
                        case toml::node_type::time: if (node_val.is_time()) { auto vp = node_val.as_time(); if (vp) { (void)vp->get(); }} break;
                        case toml::node_type::date_time: if (node_val.is_date_time()) { auto vp = node_val.as_date_time(); if (vp) { (void)vp->get(); }} break;
                        case toml::node_type::array: if (node_val.is_array()) { auto ap = node_val.as_array(); if (ap) { (void)ap->size(); }} break;
                        case toml::node_type::table: if (node_val.is_table()) { auto tp = node_val.as_table(); if (tp) { (void)tp->size(); }} break;
