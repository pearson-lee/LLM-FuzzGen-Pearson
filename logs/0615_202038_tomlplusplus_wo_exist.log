// 7. toml::v3::array::pop_back()
// 8. toml::v3::array::erase(const_iterator, const_iterator) (range erase)
// 9. toml::v3::array::erase(const_iterator) (const_iterator overload)
// 10. toml::v3::array::front(), toml::v3::array::back() (non-const)
