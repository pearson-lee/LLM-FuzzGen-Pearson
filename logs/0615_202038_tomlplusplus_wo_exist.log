                tbl.erase(key_for_ops_str); // Modifies table, memory managed by tbl.
            }

            // Target: toml::v3::table::clear()
            // Coverage: Calls clear() on the table.
            if (fdp.ConsumeBool() && !tbl.empty()) { // Check !tbl.empty() to make clear meaningful
                tbl.clear(); // Modifies table, memory managed by tbl.
            }
            
            // Target: toml::v3::table::operator[](std::string_view) const
            // Coverage: Accesses element by key using const operator[].
            if (fdp.ConsumeBool()) {
                const toml::table& const_tbl = tbl;
