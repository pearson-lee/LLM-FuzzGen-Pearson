                            (void)arr_ptr->is_boolean(); (void)arr_ptr->is_date(); (void)arr_ptr->is_time(); (void)arr_ptr->is_date_time();
                            (void)arr_ptr->as_array(); (void)static_cast<const toml::array&>(*arr_ptr).as_array();
                            // ... other as_<type> for array mostly return nullptr
                            (void)arr_ptr->as_string(); (void)arr_ptr->as_integer(); (void)arr_ptr->as_floating_point();


                            if (!arr_ptr->empty()) {
                                // Coverage for front(), back()
                                (void)arr_ptr->front(); (void)arr_ptr->back();
                                // Coverage for at(idx) and operator[](idx)
                                size_t arr_idx = fdp.ConsumeIntegralInRange<size_t>(0, arr_ptr->size() - 1);
                                try { (void)arr_ptr->at(arr_idx); } catch (const std::out_of_range&) {}
                                (void)(*arr_ptr)[arr_idx];
