            }
            if (fdp.ConsumeBool()) { // Call const versions
                const toml::table& const_tbl_ref = tbl; // Ensure it's const
                toml::node_view<const toml::node> nv3 = const_tbl_ref.at_path(path_str);
                if (nv3) { (void)nv3.type(); }
            }
        }

    } catch (const toml::parse_error&) {
    } catch (const std::exception&) {
    } catch (...) {
    }

    return 0;
}[0m
