            (void)tbl.as_table(); (void)static_cast<const toml::table&>(tbl).as_table();
            (void)tbl.as_array(); (void)static_cast<const toml::table&>(tbl).as_array(); // Returns nullptr
            // ... other as_<type> for table mostly return nullptr, calling them for coverage.
            (void)tbl.as_string(); (void)tbl.as_integer(); (void)tbl.as_floating_point(); (void)tbl.as_boolean();
            (void)tbl.as_date(); (void)tbl.as_time(); (void)tbl.as_date_time();


            // Array operations loop (original and new)
            if (fdp.ConsumeBool()) { 
                for (auto&& [current_key_sv, current_node_ref] : tbl) { 
                    toml::node* current_node_ptr = &current_node_ref; 
                    if (current_node_ptr && current_node_ptr->is_array()) {
                        toml::array* arr_ptr = current_node_ptr->as_array(); 
                        if (arr_ptr) { // Ensure arr_ptr is not null
                            // Coverage for toml::array::size() and empty()
                            (void)arr_ptr->size(); (void)arr_ptr->empty();

