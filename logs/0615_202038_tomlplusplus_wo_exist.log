// 7. toml::v3::array::erase(const_iterator pos) - specific overload
// 8. toml::v3::array::erase(const_iterator first, const_iterator last)
// 9. toml::v3::impl::array_iterator<false>::operator+=
// 10. toml::v3::impl::table_iterator<false>::operator--
// 11. toml::v3::array::is_homogeneous()

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    FuzzedDataProvider fdp(data, size);
    std::string toml_string = fdp.ConsumeRemainingBytesAsString();

    try {
        toml::table tbl = toml::parse(toml_string);

        int num_ops = fdp.ConsumeIntegralInRange<int>(1, 10); // Increased ops for more chances
        for (int op_count = 0; op_count < num_ops; ++op_count) {
            if (tbl.empty() && fdp.ConsumeBool()) {
                break;
