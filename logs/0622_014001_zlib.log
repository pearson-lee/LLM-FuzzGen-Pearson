                strm.next_out = out_buf;

                // Fuzz 'flush' parameter for deflate
                int flush = FuzzedDataProvider_ConsumeIntegralInRange_int(&fdp, Z_NO_FLUSH, Z_FINISH);

                deflate(&strm, flush);

