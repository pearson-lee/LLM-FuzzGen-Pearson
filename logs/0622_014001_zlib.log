// Please note that in C, you do not need to use `extern "C"` to declare the `LLVMFuzzerTestOneInput` function, as it is a C function, not a C++ function.
// Additionally, in C, you cannot use FuzzedDataProvider.
#include <stdint.h>
#include <stddef.h>
#include <stdlib.h> // Required for calloc and free, used by custom allocators
#include <string.h> // Required for memcpy, memset if used by zlib internals

// Include zlib headers
// Always emit #include with the full project-relative path in quotes.
#include "/src/zlib/zlib.h"
#include "/src/zlib/gzguts.h" // For gzFile and related structures, though not directly used in final selection
#include "/src/zlib/zutil.h" // For zlibCompileFlags

// Custom allocator function to exercise the 'opaque' branch in zcalloc.
// When z_stream.zalloc is set to a non-NULL function, zlib will use it.
// This allows us to control the 'opaque' parameter.
voidpf custom_alloc(voidpf opaque, uInt items, uInt size) {
    // The 'opaque' parameter passed here is the z_stream.opaque value.
    // By making it non-NULL, we ensure the 'if (opaque)' branch in zcalloc is taken.
    (void)opaque; // Cast to void to suppress unused parameter warning
    return calloc(items, size);
}

// Custom free function to pair with custom_alloc.
void custom_free(voidpf opaque, voidpf address) {
    (void)opaque; // Cast to void to suppress unused parameter warning
    free(address);
}

int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    // A minimum size is established to ensure there's enough fuzzer input
    // to derive meaningful parameters for the various API calls.
    if (Size < 30) {
        return 0;
    }

    // --- 1. Exercise compress2 ---
    // This function compresses a block of data.
    // We allocate memory for the destination buffer and ensure it's freed.
    // The source data comes directly from the fuzzer input.
    uLong sourceLen_compress = Size / 2;
    // compressBound provides an upper limit for the compressed size, preventing buffer overflows.
    uLong destLen_compress = compressBound(sourceLen_compress);
    Bytef *source_compress = (Bytef *)Data;
    Bytef *dest_compress = (Bytef *)malloc(destLen_compress);

    if (dest_compress != NULL) {
        // Use a byte from fuzzer input to determine the compression level (0-9).
        int level_compress = Data[0] % 10;
        compress2(dest_compress, &destLen_compress, source_compress, sourceLen_compress, level_compress);
        free(dest_compress); // Free allocated memory to prevent leaks
    }

    // --- 2. Exercise deflateSetDictionary ---
    // This function sets a preset dictionary for deflation.
    // A z_stream object is initialized, and custom allocators are used to hit
    // the 'opaque' branch in zcalloc.
    z_stream strm_deflate_dict;
    strm_deflate_dict.zalloc = custom_alloc; // Use custom allocator
    strm_deflate_dict.zfree = custom_free;   // Use custom free
    strm_deflate_dict.opaque = (voidpf)1;   // Provide a non-NULL opaque pointer

    // Initialize the deflate stream.
    int ret_deflate_init = deflateInit(&strm_deflate_dict, Z_DEFAULT_COMPRESSION);
    if (ret_deflate_init == Z_OK) {
        // Use a portion of the fuzzer input as the dictionary.
        // Ensure dictLength does not exceed available fuzzer input.
