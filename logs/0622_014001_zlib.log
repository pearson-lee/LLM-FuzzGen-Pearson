                    const uint8_t *name_data = FuzzedDataProvider_ConsumeBytes(&fdp, 99, &name_len);
                    if (name_len > 0) {
                        gzhead->name = (Bytef *)malloc(name_len + 1);
                        if (gzhead->name != Z_NULL) {
