      std::vector<uint8_t> tile_data = fdp.ConsumeBytes<uint8_t>(tile_size);
      uint32_t x = fdp.ConsumeIntegralInRange<uint32_t>(0, width - 1);
      uint32_t y = fdp.ConsumeIntegralInRange<uint32_t>(0, height - 1);
