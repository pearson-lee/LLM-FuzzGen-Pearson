            fields[i].field_readcount = fdp.ConsumeIntegral<int>();
            fields[i].field_writecount = fdp.ConsumeIntegral<int>();
            fields[i].field_type = static_cast<TIFFDataType>(fdp.ConsumeIntegralInRange<int>(0, TIFF_IFD8));
