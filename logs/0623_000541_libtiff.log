    LogLuvDecodeStrip(tif, decode_strip_buf.data(), decode_strip_buf.size(), decode_sample);

    // Target _TIFFFindOrRegisterField
    uint32_t tag = fdp.ConsumeIntegral<uint32_t>();
    TIFFDataType dt = static_cast<TIFFDataType>(fdp.ConsumeIntegralInRange<int>(0, TIFF_LAST));
    _TIFFFindOrRegisterField(tif, tag, dt);

    // Clean up the TIFF handle.
    TIFFClose(tif);

