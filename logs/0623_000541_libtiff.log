#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>

#include <fuzzer/FuzzedDataProvider.h>
#include "tiffio.h"
#include "zlib.h"

// Custom memory management functions for libtiff
static tmsize_t _tiffReadProc(thandle_t fd, void *buf, tmsize_t size) {
  std::vector<uint8_t> *in_buffer = reinterpret_cast<std::vector<uint8_t> *>(fd);
  if (in_buffer->empty()) {
    return 0;
  }
  tmsize_t bytes_to_read = size;
  if (bytes_to_read > in_buffer->size()) {
    bytes_to_read = in_buffer->size();
  }
  memcpy(buf, in_buffer->data(), bytes_to_read);
  in_buffer->erase(in_buffer->begin(), in_buffer->begin() + bytes_to_read);
  return bytes_to_read;
}

static tmsize_t _tiffWriteProc(thandle_t fd, void *buf, tmsize_t size) {
  std::vector<uint8_t> *out_buffer =
      reinterpret_cast<std::vector<uint8_t> *>(fd);
  out_buffer->insert(out_buffer->end(), (uint8_t *)buf, (uint8_t *)buf + size);
  return size;
}

static toff_t _tiffSeekProc(thandle_t fd, toff_t off, int whence) {
  // This fuzzer does not require seek functionality.
  return off;
}

static int _tiffCloseProc(thandle_t fd) {
  // This fuzzer manages its own memory, so this is a no-op.
  return 0;
}

static toff_t _tiffSizeProc(thandle_t fd) {
  std::vector<uint8_t> *in_buffer = reinterpret_cast<std::vector<uint8_t> *>(fd);
  return in_buffer->size();
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Suppress error and warning messages from libtiff.
  TIFFSetErrorHandler(nullptr);
  TIFFSetWarningHandler(nullptr);

  std::vector<uint8_t> in_buffer = fdp.ConsumeRemainingBytes<uint8_t>();
  TIFF *tif = TIFFClientOpen("fuzz", "w",
                             reinterpret_cast<thandle_t>(&in_buffer),
                             _tiffReadProc, _tiffWriteProc, _tiffSeekProc,
                             _tiffCloseProc, _tiffSizeProc, nullptr, nullptr);

  if (!tif) {
    return 0;
  }

  // Generate image parameters from the fuzzer.
  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint16_t samples_per_pixel = fdp.ConsumeIntegralInRange<uint16_t>(1, 4);
  const uint16_t bits_per_sample = fdp.PickValueInArray<uint16_t>({8, 12, 16});
  const uint16_t photometric = fdp.PickValueInArray<uint16_t>(
      {PHOTOMETRIC_MINISBLACK, PHOTOMETRIC_RGB, PHOTOMETRIC_CIELAB,
       PHOTOMETRIC_LOGL, PHOTOMETRIC_LOGLUV});
  const uint16_t compression = fdp.PickValueInArray<uint16_t>({
      COMPRESSION_NONE,
      COMPRESSION_OJPEG,
      COMPRESSION_JPEG,
      COMPRESSION_DEFLATE,
      COMPRESSION_LOGLUV,
  });

  TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(tif, TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
  TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
  TIFFSetField(tif, TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(tif, TIFFTAG_COMPRESSION, compression);
  TIFFSetField(tif, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);

  // Write a single scanline of random data.
  std::vector<uint8_t> scanline_buf =
      fdp.ConsumeBytes<uint8_t>(TIFFScanlineSize(tif));
  if (!scanline_buf.empty()) {
    TIFFWriteScanline(tif, scanline_buf.data(), 0, 0);
  }

  // Fuzz _TIFFFindOrRegisterField
  if (fdp.ConsumeBool()) {
    const uint32_t tag = fdp.ConsumeIntegral<uint32_t>();
    const TIFFDataType type =
        fdp.PickValueInArray<TIFFDataType>({TIFF_BYTE, TIFF_SHORT, TIFF_LONG});
    _TIFFFindOrRegisterField(tif, tag, type);
  }

  // Fuzz deflateSetDictionary
  if (compression == COMPRESSION_DEFLATE && fdp.ConsumeBool()) {
    z_stream strm;
    strm.zalloc = Z_NULL;
    strm.zfree = Z_NULL;
    strm.opaque = Z_NULL;
    if (deflateInit(&strm, Z_DEFAULT_COMPRESSION) == Z_OK) {
      std::string dictionary = fdp.ConsumeRandomLengthString(1024);
      deflateSetDictionary(&strm,
                           reinterpret_cast<const Bytef *>(dictionary.c_str()),
                           dictionary.length());
      deflateEnd(&strm);
