// Custom memory stream for libtiff
struct TiffStream {
  const uint8_t* data;
  size_t size;
  size_t offset;
};

static tmsize_t read_from_memory(thandle_t handle, void* buffer, tmsize_t size) {
  TiffStream* stream = reinterpret_cast<TiffStream*>(handle);
  tmsize_t available = stream->size - stream->offset;
  tmsize_t to_read = size < available ? size : available;
  if (to_read > 0) {
    memcpy(buffer, stream->data + stream->offset, to_read);
    stream->offset += to_read;
  }
  return to_read;
}

static tmsize_t write_to_memory(thandle_t, void*, tmsize_t) {
  // This fuzzer only reads from the TIFF file, so we don't need to implement write.
  return 0;
}

static toff_t seek_in_memory(thandle_t handle, toff_t offset, int whence) {
  TiffStream* stream = reinterpret_cast<TiffStream*>(handle);
  if (whence == SEEK_SET) {
    stream->offset = offset;
  } else if (whence == SEEK_CUR) {
    stream->offset += offset;
  } else if (whence == SEEK_END) {
    stream->offset = stream->size + offset;
  }
  return stream->offset;
}

static int close_memory(thandle_t) {
  return 0;
}

static toff_t size_of_memory(thandle_t handle) {
  TiffStream* stream = reinterpret_cast<TiffStream*>(handle);
  return stream->size;
}

