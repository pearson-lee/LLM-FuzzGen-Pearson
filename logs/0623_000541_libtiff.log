#include <cstddef>
#include <cstdint>
#include <fuzzer/FuzzedDataProvider.h>
#include "tiffio.h"
#include "tif_dir.h"

// Custom data structure to hold in-memory file information.
struct TiffClientData {
    const uint8_t* data;
    tmsize_t size;
    tmsize_t pos;
};

// Callback for reading data from the in-memory file.
static tmsize_t read_proc(thandle_t handle, void* buf, tmsize_t size) {
    TiffClientData* client_data = reinterpret_cast<TiffClientData*>(handle);
    tmsize_t available = client_data->size - client_data->pos;
    tmsize_t to_read = size < available ? size : available;
    if (to_read > 0) {
        memcpy(buf, client_data->data + client_data->pos, to_read);
        client_data->pos += to_read;
    }
    return to_read;
}

// Callback for writing data to the in-memory file (no-op for this fuzzer).
static tmsize_t write_proc(thandle_t, void*, tmsize_t) {
    return 0;
}

// Callback for seeking within the in-memory file.
static toff_t seek_proc(thandle_t handle, toff_t offset, int whence) {
    TiffClientData* client_data = reinterpret_cast<TiffClientData*>(handle);
    toff_t new_pos = client_data->pos;
    if (whence == SEEK_SET) {
        new_pos = offset;
    } else if (whence == SEEK_CUR) {
        new_pos += offset;
    } else if (whence == SEEK_END) {
        new_pos = client_data->size + offset;
    }
    if (new_pos < 0 || new_pos > client_data->size) {
        return -1;
    }
    client_data->pos = new_pos;
    return new_pos;
}

// Callback for closing the in-memory file (no-op).
static int close_proc(thandle_t) {
    return 0;
}

// Callback for getting the size of the in-memory file.
static toff_t size_proc(thandle_t handle) {
    TiffClientData* client_data = reinterpret_cast<TiffClientData*>(handle);
    return client_data->size;
}

// Dummy map and unmap functions.
static int map_proc(thandle_t, void**, toff_t*) {
    return 0;
}
static void unmap_proc(thandle_t, void*, toff_t) {}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
    FuzzedDataProvider fdp(data, size);

    // Initialize the in-memory TIFF file.
    TiffClientData client_data = {data, size, 0};
    TIFF* tif = TIFFClientOpen("fuzz", "w", reinterpret_cast<thandle_t>(&client_data),
                               read_proc, write_proc, seek_proc, close_proc, size_proc,
                               map_proc, unmap_proc);
    if (!tif) {
        return 0;
    }

    // Set some basic TIFF tags.
    TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, fdp.ConsumeIntegral<uint32_t>());
    TIFFSetField(tif, TIFFTAG_IMAGELENGTH, fdp.ConsumeIntegral<uint32_t>());
    TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, 8);
    TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, 3);
    TIFFSetField(tif, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
    TIFFSetField(tif, TIFFTAG_COMPRESSION, COMPRESSION_NONE);
    TIFFSetField(tif, TIFFTAG_PHOTOMETRIC, PHOTOMETRIC_RGB);

    // Create an EXIF directory.
    TIFFCreateEXIFDirectory(tif);

    // Fuzz _TIFFsetByteArray.
    uint32_t byte_array_count = fdp.ConsumeIntegralInRange<uint32_t>(0, 1024);
    std::vector<uint8_t> byte_array = fdp.ConsumeBytes<uint8_t>(byte_array_count);
    void* byte_array_ptr = byte_array.data();
    _TIFFsetByteArray(&byte_array_ptr, byte_array.data(), byte_array_count);

    // Fuzz _TIFFsetLongArrayExt.
    uint32_t long_array_count = fdp.ConsumeIntegralInRange<uint32_t>(0, 256);
    std::vector<uint32_t> long_array_data = fdp.ConsumeBytes<uint32_t>(long_array_count);
    uint32_t* long_array_ptr = long_array_data.data();
    _TIFFsetLongArrayExt(tif, &long_array_ptr, long_array_data.data(), long_array_count);

    // Fuzz _TIFFFindOrRegisterField.
    uint32_t tag = fdp.ConsumeIntegral<uint32_t>();
    TIFFDataType type = static_cast<TIFFDataType>(fdp.ConsumeIntegralInRange<int>(0, TIFF_LAST));
    _TIFFFindOrRegisterField(tif, tag, type);

    // Write the directory.
    TIFFWriteDirectory(tif);

    // Clean up.
    TIFFClose(tif);

    return 0;
}[0m
