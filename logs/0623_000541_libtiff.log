#include <cstddef>
#include <cstdint>
#include <vector>

#include <fuzzer/FuzzedDataProvider.h>

#include "tiffio.h"
#include "tiffiop.h"

// Forward declare internal function from tif_dirinfo.c as we cannot include
// the internal tif_dir.h header.
extern "C" const TIFFField* _TIFFFindOrRegisterField(TIFF *, uint32_t, TIFFDataType);

// The main fuzzing entry point.
// It creates a TIFF image in memory, sets various properties using fuzzed data,
// and writes scanlines to trigger different compression codecs.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size == 0) {
    return 0;
  }
  FuzzedDataProvider fdp(data, size);

  // Create a TIFF file in memory for writing.
  // The filename is arbitrary as we are not writing to disk.
  TIFF *tif = TIFFOpen("fuzz.tif", "w");
  if (!tif) {
    return 0;
  }

  // Set some basic image metadata fields.
  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(tif, TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, 8);
  TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, 3);
  TIFFSetField(tif, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
  TIFFSetField(tif, TIFFTAG_PHOTOMETRIC, PHOTOMETRIC_RGB);

  // Use fuzzed data to select a compression type to exercise different encoders.
  // We focus on SGILOG and DEFLATE as they have functions with 0% coverage.
  const auto compression = fdp.PickValueInArray<uint16_t>({
      COMPRESSION_NONE,
      COMPRESSION_SGILOG,
      COMPRESSION_SGILOG24,
      COMPRESSION_ADOBE_DEFLATE,
  });
  TIFFSetField(tif, TIFFTAG_COMPRESSION, compression);

  // Target _TIFFFindOrRegisterField to test custom tag handling.
  const uint32_t tag = fdp.ConsumeIntegral<uint32_t>();
  const auto type = fdp.PickValueInArray<TIFFDataType>({
      TIFF_BYTE, TIFF_ASCII, TIFF_SHORT, TIFF_LONG, TIFF_RATIONAL,
      TIFF_SBYTE, TIFF_UNDEFINED, TIFF_SSHORT, TIFF_SLONG, TIFF_SRATIONAL,
      TIFF_FLOAT, TIFF_DOUBLE, TIFF_IFD, TIFF_LONG8, TIFF_SLONG8, TIFF_IFD8
  });
  _TIFFFindOrRegisterField(tif, tag, type);

  // Target _TIFFsetByteArray to test setting custom byte arrays.
  void *byte_array_ptr = nullptr;
  std::vector<uint8_t> byte_vector =
      fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 128));
  if (!byte_vector.empty()) {
    _TIFFsetByteArray(&byte_array_ptr, byte_vector.data(),
                      byte_vector.size());
    // _TIFFsetByteArray allocates memory that must be freed.
    _TIFFfree(byte_array_ptr);
  }

  // Target _TIFFsetLongArrayExt to test setting custom long arrays.
  uint32_t *long_array_ptr = nullptr;
  std::vector<uint32_t> long_vector;
  const size_t long_vector_size = fdp.ConsumeIntegralInRange<size_t>(0, 32);
  for (size_t i = 0; i < long_vector_size; ++i) {
    long_vector.push_back(fdp.ConsumeIntegral<uint32_t>());
  }
  if (!long_vector.empty()) {
    _TIFFsetLongArrayExt(tif, &long_array_ptr, long_vector.data(),
                         long_vector.size());
    // _TIFFsetLongArrayExt allocates memory that must be freed.
    _TIFFfree(long_array_ptr);
  }

  // Write scanline data to trigger the selected compression encoder.
  const tmsize_t scanline_size = TIFFScanlineSize(tif);
  if (scanline_size > 0 && scanline_size < 4096) {
    std::vector<uint8_t> scanline_buf(scanline_size);
    // Fill the buffer with fuzzed data if available.
    if (scanline_size <= fdp.remaining_bytes()) {
      std::vector<uint8_t> fuzz_bytes =
          fdp.ConsumeBytes<uint8_t>(scanline_size);
      memcpy(scanline_buf.data(), fuzz_bytes.data(), fuzz_bytes.size());
    }
    // Write each scanline.
    for (uint32_t row = 0; row < height; ++row) {
      if (TIFFWriteScanline(tif, scanline_buf.data(), row, 0) < 0) {
        break;
      }
    }
  }

  // TIFFClose flushes all data to the in-memory buffer and cleans up resources.
  TIFFClose(tif);

  return 0;
}[0m
