    uint32_t tag = fdp.ConsumeIntegral<uint32_t>();
    TIFFDataType type = static_cast<TIFFDataType>(fdp.ConsumeIntegralInRange<int>(0, TIFF_IFD8));
    _TIFFFindOrRegisterField(tif, tag, type);

    // Write the directory.
    TIFFWriteDirectory(tif);

    // Clean up.
    TIFFClose(tif);

    return 0;
