  if (fdp.ConsumeBool()) {
      TIFFWriteDirectory(tif_write);
      TIFFSetField(tif_write, TIFFTAG_IMAGEWIDTH, fdp.ConsumeIntegralInRange<uint32_t>(1, 512));
      TIFFSetField(tif_write, TIFFTAG_IMAGELENGTH, fdp.ConsumeIntegralInRange<uint32_t>(1, 512));
      TIFFSetField(tif_write, TIFFTAG_BITSPERSAMPLE, fdp.PickValueInArray<uint16_t>({1, 2, 4, 8, 16, 32}));
      TIFFSetField(tif_write, TIFFTAG_SAMPLESPERPIXEL, fdp.PickValueInArray<uint16_t>({1, 3, 4}));
      TIFFSetField(tif_write, TIFFTAG_COMPRESSION, COMPRESSION_NONE);
      uint64_t dir_offset = 0;
      TIFFSetSubDirectory(tif_write, dir_offset);
  }

  // Close the TIFF handle, which flushes all written data.
  TIFFClose(tif_write);

  // Re-open the file for reading.
  int read_fd = open(filename, O_RDONLY);
  if (read_fd < 0) {
    unlink(filename);
    return 0;
  }

  TIFF *tif_read = TIFFFdOpen(read_fd, filename, "r");
  if (tif_read) {
    if (fdp.ConsumeBool()) {
      // Exercise TIFFReadRGBAImage
      uint32_t read_width, read_height;
      TIFFGetField(tif_read, TIFFTAG_IMAGEWIDTH, &read_width);
      TIFFGetField(tif_read, TIFFTAG_IMAGELENGTH, &read_height);
      if (read_width > 0 && read_height > 0) {
