    TIFFReInitJPEG_12(tif, &other_settings, fdp.ConsumeIntegral<int>(),
                      fdp.ConsumeBool());
  }

  // Fuzz OJPEGReadSecondarySos
  if (fdp.ConsumeBool()) {
    OJPEGReadSecondarySos(tif, fdp.ConsumeIntegral<uint16_t>());
  }

  // Fuzz LogLuvDecodeStrip
  if (fdp.ConsumeBool()) {
    std::vector<uint8_t> strip_buffer =
        fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 1024));
    LogLuvDecodeStrip(tif, strip_buffer.data(), strip_buffer.size(),
                      fdp.ConsumeIntegral<uint16_t>());
  }

  // Fuzz _TIFFFindOrRegisterField
  if (fdp.ConsumeBool()) {
    _TIFFFindOrRegisterField(
        tif, fdp.ConsumeIntegral<uint32_t>(),
        static_cast<TIFFDataType>(
            fdp.ConsumeIntegralInRange<int>(0, TIFF_LAST)));
  }

  // Clean up the TIFF object
  TIFFCleanup(tif);

  return 0;
}[0m
