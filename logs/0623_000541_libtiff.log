#include <cstddef>
#include <cstdint>
#include <vector>
#include <fuzzer/FuzzedDataProvider.h>
#include "tiffio.h"
#include "tiff.h"

// Custom data structure for in-memory TIFF processing.
struct TiffFuzzData {
    FuzzedDataProvider* fdp;
    std::vector<uint8_t> buffer;
    tmsize_t pos;
};

// Custom read function for libtiff to read from the in-memory buffer.
static tmsize_t read_func(thandle_t handle, void* data, tmsize_t size) {
    TiffFuzzData* tiff_data = reinterpret_cast<TiffFuzzData*>(handle);
    if (tiff_data->pos + size > tiff_data->buffer.size()) {
        size = tiff_data->buffer.size() - tiff_data->pos;
    }
    if (size > 0) {
        memcpy(data, tiff_data->buffer.data() + tiff_data->pos, size);
    }
    tiff_data->pos += size;
    return size;
}

// Custom write function for libtiff to write to the in-memory buffer.
static tmsize_t write_func(thandle_t handle, void* data, tmsize_t size) {
    TiffFuzzData* tiff_data = reinterpret_cast<TiffFuzzData*>(handle);
    if (tiff_data->pos + size > tiff_data->buffer.capacity()) {
        tiff_data->buffer.reserve(tiff_data->pos + size);
    }
    if (tiff_data->pos + size > tiff_data->buffer.size()) {
        tiff_data->buffer.resize(tiff_data->pos + size);
    }
    memcpy(tiff_data->buffer.data() + tiff_data->pos, data, size);
    tiff_data->pos += size;
    return size;
}

// Custom seek function for libtiff to seek within the in-memory buffer.
static toff_t seek_func(thandle_t handle, toff_t offset, int whence) {
    TiffFuzzData* tiff_data = reinterpret_cast<TiffFuzzData*>(handle);
    toff_t new_pos;
    if (whence == SEEK_SET) {
        new_pos = offset;
    } else if (whence == SEEK_CUR) {
        new_pos = tiff_data->pos + offset;
    } else if (whence == SEEK_END) {
        new_pos = tiff_data->buffer.size() + offset;
    } else {
        return -1;
    }
    if (new_pos < 0) {
        return -1;
    }
    tiff_data->pos = new_pos;
    return new_pos;
}

// Custom close function for libtiff.
static int close_func(thandle_t) {
    return 0;
}

// Custom size function for libtiff.
static toff_t size_func(thandle_t handle) {
    TiffFuzzData* tiff_data = reinterpret_cast<TiffFuzzData*>(handle);
    return tiff_data->buffer.size();
}

