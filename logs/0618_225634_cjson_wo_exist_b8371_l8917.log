#include <cstddef>
#include <cstdint>
#include <memory>
#include <string>
#include <fuzzer/FuzzedDataProvider.h>

#include "/src/cjson/cJSON.h"

// Custom deleter for cJSON objects to ensure proper memory management.
struct CJSONDeleter {
  void operator()(cJSON* ptr) const { cJSON_Delete(ptr); }
};

// Custom deleter for memory allocated by cJSON_malloc.
struct CJSONMallocDeleter {
  void operator()(void* ptr) const { cJSON_free(ptr); }
};

// Fuzz target entry point.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Create a JSON object to manipulate.
  std::unique_ptr<cJSON, CJSONDeleter> root(cJSON_CreateObject());
  if (!root) {
    return 0;
  }

  // Add a random number of items to the object.
  for (int i = 0; i < fdp.ConsumeIntegralInRange<int>(1, 5); ++i) {
    std::string key = fdp.ConsumeRandomLengthString(10);
    std::string value = fdp.ConsumeRandomLengthString(20);
    cJSON_AddItemToObject(root.get(), key.c_str(),
                          cJSON_CreateString(value.c_str()));
  }

  // Fuzz cJSON_ReplaceItemInObject.
  if (fdp.ConsumeBool()) {
    std::string key_to_replace = fdp.ConsumeRandomLengthString(10);
    std::unique_ptr<cJSON, CJSONDeleter> replacement(
        cJSON_CreateString(fdp.ConsumeRandomLengthString(20).c_str()));
    if (replacement) {
      cJSON_ReplaceItemInObject(root.get(), key_to_replace.c_str(),
                                replacement.release());
    }
  }

  // Fuzz cJSON_Print and ensure.
  if (fdp.ConsumeBool()) {
    // The returned buffer from cJSON_Print must be freed with cJSON_free.
    std::unique_ptr<char, CJSONMallocDeleter> printed_json(
        cJSON_Print(root.get()));
  }

  // Fuzz cJSON_PrintUnformatted.
  if (fdp.ConsumeBool()) {
    // The returned buffer from cJSON_PrintUnformatted must be freed with
    // cJSON_free.
    std::unique_ptr<char, CJSONMallocDeleter> printed_unformatted_json(
        cJSON_PrintUnformatted(root.get()));
  }

  // Fuzz cJSON_Delete.
  if (fdp.ConsumeBool()) {
    cJSON* detached_item = cJSON_DetachItemFromObject(
        root.get(), fdp.ConsumeRandomLengthString(10).c_str());
    // cJSON_Delete will handle the case where detached_item is null.
    cJSON_Delete(detached_item);
  }

  return 0;
}[0m
