    const std::string key = fdp.ConsumeRandomLengthString(50);

    // Replace an item in the object. This may add the item if the key doesn't exist.
    // cJSON_replace_item_in_object takes ownership of the new_item, so we release it from the unique_ptr.
    cJSON_replace_item_in_object(root.get(), key.c_str(), new_item.release());

    // Duplicate the modified object.
    cJSONUniquePtr duplicated_root(cJSON_Duplicate(root.get(), fdp.ConsumeBool()));

    if (duplicated_root) {
      // Compare the original and duplicated objects.
      cJSON_Compare(root.get(), duplicated_root.get(), fdp.ConsumeBool());
    }

    // Print the modified object to a buffer.
    const int buffer_size = fdp.ConsumeIntegralInRange<int>(1, 1024);
    const bool format = fdp.ConsumeBool();
    // The returned buffer must be freed with cJSON_free.
    CJSONMallocUniquePtr printed_json((char*)cJSON_PrintBuffered(root.get(), buffer_size, format));
  }

  return 0;
}[0m
