#include <cstddef>
#include <cstdint>
#include <memory>
#include <string>
#include <fuzzer/FuzzedDataProvider.h>

#include "/src/cjson/cJSON.h"

// Custom deleter for cJSON objects
struct CJSONDeleter {
  void operator()(cJSON* ptr) const {
    cJSON_Delete(ptr);
  }
};

// Custom deleter for memory allocated by cJSON_malloc
struct CJSONFree {
  void operator()(void* ptr) const {
    cJSON_free(ptr);
  }
};

using cJSONUniquePtr = std::unique_ptr<cJSON, CJSONDeleter>;
using CJSONCharUniquePtr = std::unique_ptr<char, CJSONFree>;

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Create a cJSON object to manipulate
  cJSONUniquePtr root(cJSON_CreateObject());
  if (!root) {
    return 0;
  }

  // Add a string item to the object
  std::string key1 = fdp.ConsumeRandomLengthString(16);
  std::string value1 = fdp.ConsumeRandomLengthString(32);
  cJSON_AddItemToObject(root.get(), key1.c_str(), cJSON_CreateString(value1.c_str()));

  // Add a number item to the object
  std::string key2 = fdp.ConsumeRandomLengthString(16);
  double value2 = fdp.ConsumeFloatingPoint<double>();
  cJSON_AddItemToObject(root.get(), key2.c_str(), cJSON_CreateNumber(value2));

  // Create a replacement item
  cJSONUniquePtr replacement(cJSON_CreateString(fdp.ConsumeRandomLengthString(32).c_str()));
  if (!replacement) {
    return 0;
  }

  // Decide which key to replace and whether to be case-sensitive
  std::string key_to_replace = fdp.PickValueInArray({key1, key2, fdp.ConsumeRandomLengthString(16)});
  bool case_sensitive = fdp.ConsumeBool();

  // The ownership of the replacement is transferred to the root object if the call is successful.
  // Therefore, we should release the unique_ptr to avoid a double free.
  if (replace_item_in_object(root.get(), key_to_replace.c_str(), replacement.get(), case_sensitive)) {
    replacement.release();
  }

  // Test error case: replacing with a NULL item
  replace_item_in_object(root.get(), key_to_replace.c_str(), nullptr, case_sensitive);

  // Test error case: replacing with a NULL key
  cJSONUniquePtr another_replacement(cJSON_CreateNumber(fdp.ConsumeIntegral<int>()));
  if (another_replacement) {
      if (replace_item_in_object(root.get(), nullptr, another_replacement.get(), case_sensitive)) {
          another_replacement.release();
      }
  }

  // Use cJSON_PrintBuffered to exercise the 'ensure' function
  size_t buffer_size = fdp.ConsumeIntegralInRange<size_t>(0, 1024);
  CJSONCharUniquePtr buffered_print(cJSON_PrintBuffered(root.get(), buffer_size, fdp.ConsumeBool()));

  // Use cJSON_PrintUnformatted as another path for printing
  CJSONCharUniquePtr unformatted_print(cJSON_PrintUnformatted(root.get()));

  return 0;
}

// Helper function for cJSON_bool replace_item_in_object
bool replace_item_in_object(cJSON* object, const char* string, cJSON* replacement, cJSON_bool case_sensitive) {
    if (!case_sensitive) {
        return cJSON_ReplaceItemInObject(object, string, replacement);
    }
    return cJSON_ReplaceItemInObjectCaseSensitive(object, string, replacement);
}[0m
