#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <fuzzer/FuzzedDataProvider.h>
#include "/src/cjson/cJSON.h"

// Custom deleter for cJSON objects to be used with std::unique_ptr
struct cJSONDeleter {
  void operator()(cJSON* ptr) const {
    cJSON_Delete(ptr);
  }
};

// Custom deleter for memory allocated by cJSON_malloc
struct cJSONMallocDeleter {
  void operator()(void* ptr) const {
    cJSON_free(ptr);
  }
};

// Helper function to create a cJSON object from fuzzed data
cJSON* CreateCJSONObject(FuzzedDataProvider& fdp) {
  if (fdp.remaining_bytes() == 0) {
    return nullptr;
  }
  switch (fdp.ConsumeIntegralInRange<int>(0, 6)) {
    case 0:
      return cJSON_CreateNull();
    case 1:
      return cJSON_CreateBool(fdp.ConsumeBool());
    case 2:
      return cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>());
    case 3:
      return cJSON_CreateString(fdp.ConsumeRandomLengthString(100).c_str());
    case 4: {
      cJSON* array = cJSON_CreateArray();
      if (array) {
        int num_elements = fdp.ConsumeIntegralInRange<int>(0, 5);
        for (int i = 0; i < num_elements; ++i) {
          cJSON* item = CreateCJSONObject(fdp);
          if (item) {
            cJSON_AddItemToArray(array, item);
          }
        }
      }
      return array;
    }
    case 5: {
      cJSON* object = cJSON_CreateObject();
      if (object) {
        int num_elements = fdp.ConsumeIntegralInRange<int>(0, 5);
        for (int i = 0; i < num_elements; ++i) {
          std::string key = fdp.ConsumeRandomLengthString(20);
          cJSON* item = CreateCJSONObject(fdp);
          if (item) {
            cJSON_AddItemToObject(object, key.c_str(), item);
          }
        }
      }
      return object;
    }
    case 6:
        return cJSON_CreateRaw(fdp.ConsumeRandomLengthString(100).c_str());
  }
  return nullptr;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Create a cJSON object using the helper function.
  // std::unique_ptr with a custom deleter ensures memory is freed.
  std::unique_ptr<cJSON, cJSONDeleter> obj1(CreateCJSONObject(fdp));

  if (obj1) {
    // Test cJSON_Duplicate
    std::unique_ptr<cJSON, cJSONDeleter> obj2(cJSON_Duplicate(obj1.get(), fdp.ConsumeBool()));

    // Test cJSON_Compare
    if (obj2) {
      cJSON_Compare(obj1.get(), obj2.get(), fdp.ConsumeBool());
    }

    // Test cJSON_ReplaceItemInObject
    if (obj1->type == cJSON_Object) {
      std::string key = fdp.ConsumeRandomLengthString(20);
      std::unique_ptr<cJSON, cJSONDeleter> replacement(CreateCJSONObject(fdp));
      if (replacement) {
        // cJSON_ReplaceItemInObject takes ownership of the replacement object,
        // so we release it from the unique_ptr.
        cJSON_ReplaceItemInObject(obj1.get(), key.c_str(), replacement.release());
      }
    }

    // Test cJSON_Print and by extension ensure
    std::unique_ptr<char, cJSONMallocDeleter> printed_obj(cJSON_Print(obj1.get()));
  }

  return 0;
}[0m
