  }
  return cJSON_CreateNull();
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Consume data for cJSON_ParseWithOpts
  const std::string json_str = fdp.ConsumeRandomLengthString(1000);
  const char* json_c_str = json_str.c_str();
  const char* parse_end = nullptr;
  const bool require_null_terminated = fdp.ConsumeBool();

  // Parse the input data into a cJSON object.
  // Using a unique_ptr for automatic memory management.
  cJSONUniquePtr root(cJSON_ParseWithOpts(json_c_str, &parse_end, require_null_terminated));

  if (root && cJSON_IsObject(root.get())) {
    // Create a random cJSON item to replace/add.
    cJSONUniquePtr new_item(create_random_cjson_item(fdp));
    if (!new_item) {
      return 0;
