// Alias for unique_ptr with our custom deleters
using cJSONUniquePtr = std::unique_ptr<cJSON, CJSONDeleter>;
using CJSONMallocUniquePtr = std::unique_ptr<char, CJSONMallocDeleter>;

// Function to create a cJSON object of a random type
cJSON* create_random_cjson_item(FuzzedDataProvider& fdp) {
  switch (fdp.ConsumeIntegralInRange<uint8_t>(0, 6)) {
