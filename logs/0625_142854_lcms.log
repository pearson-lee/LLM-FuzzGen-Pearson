// A helper struct to safely consume data from the fuzzer input buffer.
typedef struct {
  const uint8_t *data;
  size_t size;
  size_t offset;
} DataProvider;

// Safely reads a specified number of bytes from the fuzz data buffer.
// Returns 1 on success, 0 if there's not enough data.
static int read_from_data(DataProvider *dp, void *dest, size_t len) {
  if (dp->offset + len > dp->size) {
    return 0;
  }
  memcpy(dest, dp->data + dp->offset, len);
  dp->offset += len;
  return 1;
}

// Main fuzzing entry point.
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  DataProvider dp = {data, size, 0};

  // Target 1: cmsSmoothToneCurve (from cmsgamma.c, 0% coverage)
  // This requires a cmsToneCurve object, which we can create with cmsBuildGamma.
  double gamma, lambda;
  if (read_from_data(&dp, &gamma, sizeof(gamma)) &&
      read_from_data(&dp, &lambda, sizeof(lambda))) {
    cmsToneCurve *curve = cmsBuildGamma(NULL, gamma);
    if (curve) {
      // Call the target function to exercise its code paths.
      cmsSmoothToneCurve(curve, lambda);
      // Clean up the created tone curve.
      cmsFreeToneCurve(curve);
    }
  }

  // Target 2: cmsCreateLinearizationDeviceLinkTHR (from cmsvirt.c, 0% coverage)
  // This function creates a linearization profile from a set of tone curves.
  cmsColorSpaceSignature colorSpace;
  double curve_gamma;
  if (read_from_data(&dp, &colorSpace, sizeof(colorSpace)) &&
      read_from_data(&dp, &curve_gamma, sizeof(curve_gamma))) {
    cmsToneCurve *curves[3];
    // Create the necessary tone curves.
    curves[0] = cmsBuildGamma(NULL, curve_gamma);
    curves[1] = cmsBuildGamma(NULL, curve_gamma);
    curves[2] = cmsBuildGamma(NULL, curve_gamma);

    // The function expects a cmsToneCurve**, so we pass the address of our array.
    cmsHPROFILE linProfile =
        cmsCreateLinearizationDeviceLinkTHR(NULL, colorSpace, (const cmsToneCurve **)curves);

    // Clean up all allocated resources.
    if (curves[0])
      cmsFreeToneCurve(curves[0]);
    if (curves[1])
      cmsFreeToneCurve(curves[1]);
    if (curves[2])
      cmsFreeToneCurve(curves[2]);
    if (linProfile)
      cmsCloseProfile(linProfile);
  }

  // Target 3: cmsGetPostScriptCRD (from cmsps2.c, 0% coverage)
