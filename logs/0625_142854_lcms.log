  if (read_from_data(&dp, &nLutPoints_u8, sizeof(nLutPoints_u8)) &&
      read_from_data(&dp, &b, sizeof(b)) &&
      read_from_data(&dp, &c, sizeof(c)) &&
      read_from_data(&dp, &h, sizeof(h)) &&
      read_from_data(&dp, &s, sizeof(s)) &&
      read_from_data(&dp, &tempSrc, sizeof(tempSrc)) &&
