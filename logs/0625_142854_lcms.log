    }


    // --- Cleanup ---
    // All created resources must be freed to avoid memory leaks.
    if (transform) {
        cmsDeleteTransform(transform);
    }
    if (rgb_profile) {
        cmsCloseProfile(rgb_profile);
    }
    if (null_profile) {
        cmsCloseProfile(null_profile);
    }
    if (devicelink_profile) {
        cmsCloseProfile(devicelink_profile);
    }

    return 0;
}[0m
