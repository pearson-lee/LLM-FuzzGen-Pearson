fuzz target: 
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/include/lcms2_plugin.h"

// A simple structure to help consume data from the fuzzer input buffer.
typedef struct {
  const uint8_t *data;
  size_t size;
  size_t offset;
} FuzzerData;

// Helper function to consume a block of data of a given size.
static const uint8_t *ConsumeData(FuzzerData *fz, size_t size) {
  if (fz->offset + size > fz->size) {
    return NULL;
  }
  const uint8_t *ptr = fz->data + fz->offset;
  fz->offset += size;
  return ptr;
}

// Helper function to consume a value of a specific type.
#define CONSUME_AS(fz, type) \
  (type *)ConsumeData(fz, sizeof(type))

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzerData fz = {data, size, 0};

  // Fuzz cmsCreateBCHSWabstractProfile
  const cmsUInt32Number *nWPoints = CONSUME_AS(&fz, cmsUInt32Number);
  const cmsFloat64Number *Brightness = CONSUME_AS(&fz, cmsFloat64Number);
  const cmsFloat64Number *Contrast = CONSUME_AS(&fz, cmsFloat64Number);
  const cmsFloat64Number *Hue = CONSUME_AS(&fz, cmsFloat64Number);
  const cmsFloat64Number *Saturation = CONSUME_AS(&fz, cmsFloat64Number);
  const cmsUInt32Number *TempSrc = CONSUME_AS(&fz, cmsUInt32Number);
  const cmsUInt32Number *TempDest = CONSUME_AS(&fz, cmsUInt32Number);

  if (!nWPoints || !Brightness || !Contrast || !Hue || !Saturation || !TempSrc || !TempDest) {
    return 0;
  }

  cmsHPROFILE bchsw_profile = cmsCreateBCHSWabstractProfile(*nWPoints, *Brightness, *Contrast, *Hue, *Saturation, *TempSrc, *TempDest);

  if (bchsw_profile) {
    // Fuzz cmsMD5computeID
    cmsMD5computeID(bchsw_profile);

    // Fuzz cmsGetProfileInfo
    wchar_t info_buffer[256];
    cmsGetProfileInfo(bchsw_profile, cmsInfoDescription, "en", "US", info_buffer, 255);

    // Fuzz cmsFormatterForPCSOfProfile
    const uint8_t *nBytes = CONSUME_AS(&fz, uint8_t);
    const uint8_t *isFloat = CONSUME_AS(&fz, uint8_t);
    if (nBytes && isFloat) {
      cmsFormatterForPCSOfProfile(bchsw_profile, *nBytes % 4, *isFloat % 2);
    }

    cmsCloseProfile(bchsw_profile);
  }

  // Fuzz cmsCreateLinearizationDeviceLink
  const uint8_t *color_space_selector = CONSUME_AS(&fz, uint8_t);
  if (!color_space_selector) {
    return 0;
  }

  cmsColorSpaceSignature color_spaces[] = {cmsSigGrayData, cmsSigRgbData, cmsSigCmykData};
  cmsColorSpaceSignature color_space = color_spaces[*color_space_selector % 3];
  int num_channels = cmsChannelsOf(color_space);

  if (num_channels > 0 && num_channels <= 16) {
    cmsToneCurve *curves[16] = {0};
    int curves_created = 0;
    for (int i = 0; i < num_channels; i++) {
      const cmsFloat64Number *gamma = CONSUME_AS(&fz, cmsFloat64Number);
      if (!gamma) {
        break;
      }
      curves[i] = cmsBuildGamma(NULL, *gamma);
      if (curves[i]) {
        curves_created++;
      }
    }

    if (curves_created == num_channels) {
      cmsHPROFILE lin_profile = cmsCreateLinearizationDeviceLink(color_space, (const cmsToneCurve **)curves);
      if (lin_profile) {
        cmsCloseProfile(lin_profile);
      }
    }

    for (int i = 0; i < num_channels; i++) {
      if (curves[i]) {
        cmsFreeToneCurve(curves[i]);
      }
    }
  }

  return 0;
}[0m
