fuzz target: 
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include "/src/lcms/include/lcms2.h"

// This fuzzer targets several currently uncovered functions to improve overall library coverage.
// The chosen functions represent different areas of the API:
// 1. cmsCreateBCHSWabstractProfile: Creates a Brightness/Contrast/Hue/Saturation abstract profile.
// 2. cmsCreateLinearizationDeviceLink: Creates a linearization profile from tone curves.
// 3. cmsIT8SetDataDbl: Sets a floating-point value in a CGATS IT8 data structure.
// 4. cmsGetProfileInfo: Retrieves information from a profile's header.
// 5. cmsMD5computeID: Computes an MD5 checksum for a profile.
//
// The fuzzer generates parameters for these functions from the input data,
// creates the necessary objects (profiles, tone curves, IT8 handles), calls the
// target functions, and then meticulously cleans up all allocated resources to
// prevent memory leaks.

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    if (size < 100) {
        // Need a minimum amount of data to be useful.
        return 0;
    }

    // --- Data Consumption Setup ---
    const uint8_t* current_data = data;
    size_t remaining_size = size;

    // Helper macro to safely consume data from the input buffer.
    // It checks for sufficient size before copying and advances the pointers.
    #define CONSUME_DATA(target, type) \
        if (remaining_size < sizeof(type)) { goto cleanup; } \
        memcpy(&target, current_data, sizeof(type)); \
        remaining_size -= sizeof(type); \
        current_data += sizeof(type);

    cmsHPROFILE bchsProfile = NULL;
    cmsHPROFILE linProfile = NULL;
    cmsToneCurve *curves[3] = {NULL, NULL, NULL};
    cmsHANDLE hIT8 = NULL;

    // --- Target: cmsCreateBCHSWabstractProfile ---
    cmsUInt32Number nEntries;
    cmsFloat64Number Brightness, Contrast, Hue, Saturation;
    cmsUInt32Number TempSrc, TempDest;

    CONSUME_DATA(nEntries, cmsUInt32Number);
    CONSUME_DATA(Brightness, cmsFloat64Number);
    CONSUME_DATA(Contrast, cmsFloat64Number);
    CONSUME_DATA(Hue, cmsFloat64Number);
    CONSUME_DATA(Saturation, cmsFloat64Number);
    CONSUME_DATA(TempSrc, cmsUInt32Number);
    CONSUME_DATA(TempDest, cmsUInt32Number);

    // To avoid creating huge profiles that will slow down the fuzzer and cause timeouts.
    nEntries = (nEntries % 4095) + 1; // Ensure nEntries is at least 1.

    bchsProfile = cmsCreateBCHSWabstractProfile(nEntries, Brightness, Contrast, Hue, Saturation, TempSrc, TempDest);

    // --- Target: cmsCreateLinearizationDeviceLink ---
    cmsColorSpaceSignature colorSpace;
    double gamma;
    CONSUME_DATA(colorSpace, cmsColorSpaceSignature);
    CONSUME_DATA(gamma, double);

    // cmsBuildGamma requires a positive gamma value.
    if (gamma <= 0) {
        gamma = 1.0;
    }

    // Create tone curves needed for the linearization profile.
    curves[0] = cmsBuildGamma(NULL, gamma);
    curves[1] = cmsBuildGamma(NULL, gamma);
    curves[2] = cmsBuildGamma(NULL, gamma);

    if (curves[0] && curves[1] && curves[2]) {
        linProfile = cmsCreateLinearizationDeviceLink(colorSpace, (const cmsToneCurve **)curves);
    }

    // --- Target: cmsIT8SetDataDbl ---
    hIT8 = cmsIT8Alloc(NULL);
    if (hIT8) {
        char patch[33];
        char sample[33];
        cmsFloat64Number val;

        // Safely create null-terminated strings for patch and sample names.
        size_t str_len = remaining_size > 32 ? 32 : remaining_size;
        memcpy(patch, current_data, str_len);
        patch[str_len] = '\0';
        current_data += str_len;
        remaining_size -= str_len;

        str_len = remaining_size > 32 ? 32 : remaining_size;
        memcpy(sample, current_data, str_len);
        sample[str_len] = '\0';
        current_data += str_len;
        remaining_size -= str_len;

        CONSUME_DATA(val, cmsFloat64Number);

        cmsIT8SetDataDbl(hIT8, patch, sample, val);
    }

    // --- Target: cmsGetProfileInfo and cmsMD5computeID ---
    // Exercise these functions on the profiles created earlier.
    if (bchsProfile) {
        wchar_t buffer[256];
        cmsGetProfileInfo(bchsProfile, cmsInfoDescription, "en", "US", buffer, 255);
        cmsMD5computeID(bchsProfile);
    }

    if (linProfile) {
        wchar_t buffer[256];
        cmsGetProfileInfo(linProfile, cmsInfoManufacturer, "en", "US", buffer, 255);
        cmsMD5computeID(linProfile);
    }

cleanup:
    // --- Resource Management ---
    // It is crucial to free all allocated resources to prevent memory leaks.
    if (bchsProfile) {
        cmsCloseProfile(bchsProfile);
    }
    if (linProfile) {
        cmsCloseProfile(linProfile);
    }
    if (curves[0]) {
        cmsFreeToneCurve(curves[0]);
    }
    if (curves[1]) {
        cmsFreeToneCurve(curves[1]);
    }
    if (curves[2]) {
        cmsFreeToneCurve(curves[2]);
    }
    if (hIT8) {
        cmsIT8Free(hIT8);
    }

    return 0;
}[0m
