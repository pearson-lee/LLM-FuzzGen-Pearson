    //                             cmsUInt32Number InputColorant, cmsUInt32Number OutputColorant,
    //                             const cmsUInt32Number GamutTable[], const cmsHPROFILE hProfiles[],
    //                             const cmsBool lIsLinear[], const cmsFloat64Number DesiredBlack[],
    //                             cmsUInt32Number dwFlags)
    if (fdp.ConsumeBool()) {
        cmsUInt32Number nProfiles_chain = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 3);
        
        std::vector<CmsProfileUniquePtr> profiles_chain_vec;
        std::vector<cmsHPROFILE> hProfiles_chain_raw;
        profiles_chain_vec.reserve(nProfiles_chain);
        hProfiles_chain_raw.reserve(nProfiles_chain);

        bool chain_profiles_ok = true;
        for (cmsUInt32Number i = 0; i < nProfiles_chain; ++i) {
            cmsHPROFILE p = cmsCreateNULLProfileTHR(ctx);
            if (p) {
                profiles_chain_vec.emplace_back(p, CmsProfileDeleter());
