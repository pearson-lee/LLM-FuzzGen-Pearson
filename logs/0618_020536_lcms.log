        std::vector<cmsHPROFILE> profiles_for_k_curve_local; // Profiles for this specific call
        std::vector<cmsBool> is_input_data;
        std::vector<cmsFloat64Number> gammas_data;
        bool k_curve_profiles_ok = true;

