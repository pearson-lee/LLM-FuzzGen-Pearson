    FuzzedDataProvider fdp(Data, Size);

    // Create an LCMS context, managed by unique_ptr for RAII.
    UniqueContext context_ptr(cmsCreateContext(NULL, NULL));
    if (!context_ptr) {
        return 0; // Cannot proceed without a context
    }
    cmsContext context = context_ptr.get();

    // Target 1: Replicate _cmsStageAllocLabPrelin functionality using public APIs
    if (fdp.ConsumeBool()) {
        cmsToneCurve* identityCurves[3] = {nullptr, nullptr, nullptr};
        bool curves_ok = true;

        identityCurves[0] = cmsBuildGamma(context, 1.0);
        if (!identityCurves[0]) curves_ok = false;

        if (curves_ok) {
            identityCurves[1] = cmsBuildGamma(context, 1.0);
            if (!identityCurves[1]) curves_ok = false;
        }

        if (curves_ok) {
            identityCurves[2] = cmsBuildGamma(context, 1.0);
            if (!identityCurves[2]) curves_ok = false;
        }

        if (curves_ok) {
            // cmsStageAllocToneCurves duplicates the curves internally.
            // Pass identityCurves directly; cmsToneCurve** is compatible with cmsToneCurve* const Curves[]
            UniqueStage stage(cmsStageAllocToneCurves(context, 3, identityCurves));
            // The stage now owns its copies of the curves.
        }

        // Free the original curves we allocated.
        if (identityCurves[0]) cmsFreeToneCurve(identityCurves[0]);
        if (identityCurves[1]) cmsFreeToneCurve(identityCurves[1]);
        if (identityCurves[2]) cmsFreeToneCurve(identityCurves[2]);
    }

    // Prepare profile data from fuzzer input.
    std::vector<uint8_t> profile_data_vec;
    if (fdp.remaining_bytes() > 0) {
        size_t profile_size = fdp.ConsumeIntegralInRange<size_t>(1, fdp.remaining_bytes());
        profile_data_vec = fdp.ConsumeBytes<uint8_t>(profile_size);
    }
    
    UniqueProfile hProfile(cmsOpenProfileFromMemTHR(context, profile_data_vec.data(), profile_data_vec.size()));

    if (hProfile) { // Proceed only if a profile was successfully opened
        // Target 2: Exercise Type_Dictionary_Read
        if (fdp.ConsumeBool()) {
            cmsReadTag(hProfile.get(), static_cast<cmsTagSignature>(cmsSigDictType));
        }

        // Target 3: Exercise Type_vcgt_Read
        if (fdp.ConsumeBool()) {
            cmsReadTag(hProfile.get(), cmsSigVcgtTag); // cmsSigVcgtTag is already cmsTagSignature
        }

        // Target 4: Exercise Type_ProfileSequenceDesc_Write
        if (fdp.ConsumeBool()) {
            const cmsSEQ* existing_seq = (const cmsSEQ*)cmsReadTag(hProfile.get(), static_cast<cmsTagSignature>(cmsSigProfileSequenceDescTag));
            if (existing_seq && fdp.ConsumeBool()) {
                 cmsWriteTag(hProfile.get(), static_cast<cmsTagSignature>(cmsSigProfileSequenceDescTag), existing_seq);
            } 
            else {
                cmsUInt32Number num_seq_entries = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
                if (num_seq_entries > 0) {
                    cmsSEQ* seq_data_raw = cmsAllocProfileSequenceDescription(context, num_seq_entries);
                    if (seq_data_raw) {
                        std::unique_ptr<cmsSEQ, ProfileSequenceDeleter> seq_data(seq_data_raw, ProfileSequenceDeleter());
                        for (cmsUInt32Number i = 0; i < num_seq_entries; ++i) {
                            if (fdp.ConsumeBool()) {
                                fdp.ConsumeData(&seq_data->seq[i].ProfileID, sizeof(cmsProfileID));
                            }
                            if (fdp.ConsumeBool()) {
                                cmsMLU* mlu = cmsMLUalloc(context, fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 2));
                                if (mlu) {
                                    std::string lang_code = fdp.ConsumeBytesAsString(2);
                                    std::string country_code = fdp.ConsumeBytesAsString(2);
                                    std::string text_content = fdp.ConsumeRandomLengthString(20);
                                    cmsMLUsetASCII(mlu, lang_code.c_str(), country_code.c_str(), text_content.c_str());
                                    seq_data->seq[i].Description = mlu; 
                                } else {
                                     // If mlu allocation fails, ensure seq_data->seq[i].Description is NULL
                                     // or handle as appropriate. cmsAllocProfileSequenceDescription should zero-init.
                                }
                            }
                        }
                        cmsWriteTag(hProfile.get(), static_cast<cmsTagSignature>(cmsSigProfileSequenceDescTag), seq_data.get());
                    }
                }
            }
        }

        // Target 5: Exercise Type_MPEcurve_Read
        if (fdp.ConsumeBool()) {
            cmsTagSignature lut_tags[] = {
                static_cast<cmsTagSignature>(cmsSigLutAtoBType),
                static_cast<cmsTagSignature>(cmsSigLutBtoAType), 
                static_cast<cmsTagSignature>(cmsSigLut8Type),
                static_cast<cmsTagSignature>(cmsSigLut16Type)
            };
            
            // Ensure the array has elements before trying to access it.
            // (sizeof(lut_tags)/sizeof(lut_tags[0])) will be 4 here.
            if ((sizeof(lut_tags)/sizeof(lut_tags[0])) > 0) {
                cmsTagSignature tag_to_read = lut_tags[fdp.ConsumeIntegralInRange<size_t>(0, (sizeof(lut_tags)/sizeof(lut_tags[0])) - 1)];
                cmsReadTag(hProfile.get(), tag_to_read);
            }
        }
    }
    return 0;
