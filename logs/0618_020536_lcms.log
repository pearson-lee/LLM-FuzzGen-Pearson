            if (io_mpe_read) {
                void* mpe_ptr = local_handler.ReadPtr(&local_handler, io_mpe_read, &items_read_mpe, size_of_tag_mpe);
                if (mpe_ptr) {
                    local_handler.FreePtr(&local_handler, mpe_ptr);
                }
                cmsCloseIOhandler(io_mpe_read);
            }
