// Helper to convert std::string to wchar_t*.
// Returns a newly allocated wide string that must be freed by the caller using free().
// Returns nullptr on allocation failure.
// On mbstowcs conversion error, returns an empty wide string L"" (which also needs to be freed).
wchar_t* StringToWchar(const std::string& str) {
    wchar_t* wstr = nullptr;
    size_t wlen = mbstowcs(NULL, str.c_str(), 0);

    if (wlen == (size_t)-1) { // Invalid multibyte sequence
        wstr = (wchar_t*)malloc(sizeof(wchar_t));
        if (wstr) {
            wstr[0] = L'\0';
        }
        return wstr;
    }

    wstr = (wchar_t*)malloc((wlen + 1) * sizeof(wchar_t));
    if (!wstr) {
        return nullptr; // Allocation failure
    }

    size_t written_len = mbstowcs(wstr, str.c_str(), wlen + 1);
    if (written_len == (size_t)-1) {
        free(wstr); // Free the initially allocated buffer
        wstr = (wchar_t*)malloc(sizeof(wchar_t)); // Fallback to L""
        if (wstr) {
            wstr[0] = L'\0';
        }
        return wstr;
    }
    return wstr;
}

