// Custom deleter for cmsSEQ (Profile Sequence Description data)
// Manages the memory of a cmsSEQ structure, including its internal MLU objects and array.
struct ProfileSequenceDeleter {
    cmsContext ctx; // Store context for freeing operations using _cmsFree
    ProfileSequenceDeleter(cmsContext c) : ctx(c) {}
    void operator()(cmsSEQ* p) {
        if (p) {
            // This logic mimics _cmsFreeProfileSequenceDescription internal function
            if (p->seq) {
                for (cmsUInt32Number i = 0; i < p->n; i++) {
