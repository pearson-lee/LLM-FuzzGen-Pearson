            if (io_psd) {
                cmsUInt32Number items_read = 0;
                cmsUInt32Number size_of_tag = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 1024);
                void* psd_data = psd_handler->ReadPtr(
