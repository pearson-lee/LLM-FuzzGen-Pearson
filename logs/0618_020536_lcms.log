                cmsFreeProfileSequenceDescription(ctx, static_cast<cmsSEQ*>(psd_data));
            }
        }
        // io_api5 is automatically freed.
    }
    
    // ctx_ptr is automatically deleted, which calls cmsDeleteContext.
    return 0;
