                gamutTableData[i] = fdp.ConsumeIntegral<cmsUInt32Number>();
                lIsLinearData[i] = fdp.ConsumeBool();
                desiredBlackData[i] = fdp.ConsumeProbability<cmsFloat64Number>();
            }
            cmsUInt32Number dwFlags = fdp.ConsumeIntegral<cmsUInt32Number>();

            CmsToneCurveUniquePtr toneCurve(
                _cmsBuildKToneCurve(ctx, nPoints, nProfiles_ktone, gamutTableData.data(),
                                    hProfiles_ktone_raw.data(), lIsLinearData.data(),
                                    desiredBlackData.data(), dwFlags)
            );
            // toneCurve is automatically freed by unique_ptr.
        }
        // profiles_ktone_vec elements are automatically freed.
