    cmsContext context = nullptr;       // LCMS context (C type from lcms2.h)
    cmsIOHANDLER *io = nullptr;         // LCMS IO Handler (C type from lcms2.h)
    cmsTagTypeHandler type_handler_instance; // LCMS type handler (C type from lcms2_plugin.h)

    // All LCMS API calls are C functions. Their declarations are within the extern "C" block above.
    context = cmsCreateContext(nullptr, nullptr);
    if (!context) {
        return 0; 
    }

    type_handler_instance = initialize_type_handler(context); // Call C++ helper

