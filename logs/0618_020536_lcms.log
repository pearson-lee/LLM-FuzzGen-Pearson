    // Create a pipeline. This will be the data for several cmsWriteTag calls.
    // cmsPipeline is managed by std::unique_ptr.
    cmsUInt32Number inputChannels = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 8);  // Keep channel count reasonable for fuzzing
    cmsUInt32Number outputChannels = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 8); // Keep channel count reasonable for fuzzing
    std::unique_ptr<cmsPipeline, PipelineDeleter> pipeline_ptr(cmsPipelineAlloc(contextID, inputChannels, outputChannels));
    
    if (!pipeline_ptr) {
        // If pipeline allocation fails, cannot proceed with tag writing.
        return 0; 
    }
    cmsPipeline* pipeline = pipeline_ptr.get();


    // Optionally add the labStage to the pipeline if compatible and created.
    // _cmsStageAllocLabPrelin creates a 3-channel stage.
    if (labStage_ptr && pipeline && cmsPipelineInputChannels(pipeline) == 3 && fdp.ConsumeBool()) {
        // cmsPipelineInsertStage duplicates the stage. The labStage_ptr still owns the original stage,
        // which will be freed automatically when labStage_ptr goes out of scope.
        cmsPipelineInsertStage(pipeline, cmsAT_END, labStage_ptr.get());
    }

    // Add a fuzzed tone curve stage to the pipeline to make it more complex.
    // This helps in testing Type_MPEcurve_Write indirectly when the MPE tag is written.
    if (fdp.ConsumeBool() && pipeline) {
        cmsUInt32Number currentPipelineStageChannels = 0;
        if (cmsPipelineStageCount(pipeline) == 0) {
            currentPipelineStageChannels = cmsPipelineInputChannels(pipeline);
        } else {
            currentPipelineStageChannels = cmsPipelineOutputChannels(pipeline);
        }
        
        // Limit channels to a practical number for fuzzing to avoid excessive allocations.
        currentPipelineStageChannels = std::min(currentPipelineStageChannels, static_cast<cmsUInt32Number>(4));

        if (currentPipelineStageChannels > 0) {
            std::vector<cmsToneCurve*> curvesVec(currentPipelineStageChannels, nullptr);
            bool allCurvesAllocated = true;
            for (cmsUInt32Number i = 0; i < currentPipelineStageChannels; ++i) {
                if (fdp.ConsumeBool()) {
                    curvesVec[i] = cmsBuildGamma(contextID, fdp.ConsumeFloatingPointInRange<double>(0.1, 3.0));
                } else {
                    cmsUInt16Number nEntries = fdp.ConsumeIntegralInRange<cmsUInt16Number>(2, 16); // Small nEntries for fuzzing
                    std::vector<cmsUInt16Number> entries(nEntries);
                    for(cmsUInt16Number k=0; k<nEntries; ++k) entries[k] = fdp.ConsumeIntegral<cmsUInt16Number>();
                    curvesVec[i] = cmsBuildTabulatedToneCurve16(contextID, nEntries, entries.data());
