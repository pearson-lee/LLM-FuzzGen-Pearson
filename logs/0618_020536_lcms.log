// Helper to convert std::string to wchar_t*.
// Returns a newly allocated wide string that must be freed by the caller using free().
// Returns nullptr on allocation failure.
// On mbstowcs conversion error, returns an empty wide string L"" (which also needs to be freed).
wchar_t* StringToWchar(const std::string& str) {
    wchar_t* wstr = nullptr;
    size_t wlen = mbstowcs(NULL, str.c_str(), 0);

    if (wlen == (size_t)-1) { // Invalid multibyte sequence
        wstr = (wchar_t*)malloc(sizeof(wchar_t)); 
        if (wstr) {
            wstr[0] = L'\0';
        }
        return wstr; 
    }

    wstr = (wchar_t*)malloc((wlen + 1) * sizeof(wchar_t));
    if (!wstr) {
        return nullptr; // Allocation failure
    }

    size_t written_len = mbstowcs(wstr, str.c_str(), wlen + 1);
    if (written_len == (size_t)-1) { 
        free(wstr); // Free the initially allocated buffer
        wstr = (wchar_t*)malloc(sizeof(wchar_t)); // Fallback to L""
        if (wstr) {
            wstr[0] = L'\0';
        }
        return wstr;
    }
    return wstr;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a context, essential for most lcms operations.
    // It will be cleaned up at the end.
    cmsContext context = cmsCreateContext(NULL, NULL);
    if (!context) {
        return 0;
    }

    // Prepare a dummy _cms_typehandler_struct.
    // The Type_XXX_Read/Write functions are implementations of a type handler's
    // ReadPtr/WritePtr. They primarily use ContextID from this struct.
    _cms_typehandler_struct type_handler_dummy;
    memset(&type_handler_dummy, 0, sizeof(type_handler_dummy));
    type_handler_dummy.ContextID = context;
    // ICCVersion might be used by some handlers, fuzz it.
    type_handler_dummy.ICCVersion = fdp.ConsumeIntegral<cmsUInt32Number>();

    // API 1: Type_Dictionary_Read
    if (fdp.ConsumeBool()) {
        cmsUInt32Number items_read = 0;
        // Fuzz the SizeOfTag parameter.
        cmsUInt32Number size_of_tag = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 2048);
        
        // Consume data for the IO stream.
        size_t dict_data_len = fdp.ConsumeIntegralInRange<size_t>(0, 4096);
        std::vector<uint8_t> dict_data = fdp.ConsumeBytes<uint8_t>(dict_data_len);

        // Create an IO handler for reading from memory.
        cmsIOHANDLER* io_dict_read = cmsOpenIOhandlerFromMem(context, 
                                                             dict_data.empty() ? NULL : dict_data.data(), 
                                                             dict_data.size(), "r");
        if (io_dict_read) {
            // Call the target API.
            void* dict_ptr = Type_Dictionary_Read(&type_handler_dummy, io_dict_read, &items_read, size_of_tag);
            if (dict_ptr) {
                // Free the returned dictionary.
                cmsDictFree((cmsHANDLE)dict_ptr);
            }
            // Close the IO handler.
            cmsCloseIOhandler(io_dict_read);
        }
    }
    
    // API 2: Type_Dictionary_Write (along with cmsDictAlloc, cmsDictAddEntry)
    if (fdp.ConsumeBool()) {
        // Allocate a new dictionary.
        cmsHANDLE dict_to_write = cmsDictAlloc(context);
        if (dict_to_write) {
            // Add a fuzzed number of entries to the dictionary.
            int num_entries = fdp.ConsumeIntegralInRange<int>(0, 5);
            for (int i = 0; i < num_entries; ++i) {
                std::string name_str = fdp.ConsumeRandomLengthString(32);
                std::string value_str = fdp.ConsumeRandomLengthString(32);
                
                wchar_t* w_name = StringToWchar(name_str);
                wchar_t* w_value = StringToWchar(value_str);

                if (w_name && w_value) { // Check for successful conversion/allocation
                    // Add entry. For simplicity, DisplayName and DisplayValue are NULL.
                    cmsDictAddEntry(dict_to_write, w_name, w_value, NULL, NULL);
                }
                // Free the wide strings allocated by StringToWchar.
                free(w_name); 
                free(w_value);
            }

            // Use a NULL IO handler for writing; it discards data but exercises write logic.
            cmsIOHANDLER* io_dict_write = cmsOpenIOhandlerToNULL(context);
            if (io_dict_write) {
                // Call the target API. nItems for Type_Dictionary_Write is usually 1.
                Type_Dictionary_Write(&type_handler_dummy, io_dict_write, dict_to_write, 1);
                // Close the IO handler.
                cmsCloseIOhandler(io_dict_write);
            }
            // Free the dictionary.
            cmsDictFree(dict_to_write);
        }
    }

    // API 3: Type_ProfileSequenceDesc_Read
    if (fdp.ConsumeBool()) {
        cmsUInt32Number items_read_psd = 0;
        cmsUInt32Number size_of_tag_psd = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 2048);
        
        size_t psd_data_len = fdp.ConsumeIntegralInRange<size_t>(0, 4096);
        std::vector<uint8_t> psd_data = fdp.ConsumeBytes<uint8_t>(psd_data_len);

        cmsIOHANDLER* io_psd_read = cmsOpenIOhandlerFromMem(context, 
                                                            psd_data.empty() ? NULL : psd_data.data(), 
                                                            psd_data.size(), "r");
        if (io_psd_read) {
            // Call the target API.
            void* psd_ptr = Type_ProfileSequenceDesc_Read(&type_handler_dummy, io_psd_read, &items_read_psd, size_of_tag_psd);
            if (psd_ptr) {
                // Free the returned profile sequence description.
                cmsFreeProfileSequenceDescription((cmsSEQ*)psd_ptr);
            }
            cmsCloseIOhandler(io_psd_read);
        }
    }

    // API 4: Type_MPEcurve_Read (MultiProcessElement curve)
    if (fdp.ConsumeBool()) {
        cmsUInt32Number items_read_mpe = 0;
        cmsUInt32Number size_of_tag_mpe = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 2048);

        size_t mpe_data_len = fdp.ConsumeIntegralInRange<size_t>(0, 4096);
        std::vector<uint8_t> mpe_data = fdp.ConsumeBytes<uint8_t>(mpe_data_len);
        
        cmsIOHANDLER* io_mpe_read = cmsOpenIOhandlerFromMem(context, 
                                                            mpe_data.empty() ? NULL : mpe_data.data(), 
                                                            mpe_data.size(), "r");
        if (io_mpe_read) {
            // Call the target API. Type_MPEcurve_Read returns a cmsPipeline*.
            void* mpe_ptr = Type_MPEcurve_Read(&type_handler_dummy, io_mpe_read, &items_read_mpe, size_of_tag_mpe);
            if (mpe_ptr) {
                // Free the returned pipeline.
                cmsPipelineFree((cmsPipeline*)mpe_ptr);
            }
            cmsCloseIOhandler(io_mpe_read);
        }
    }
    
    // API 5: _cmsStageAllocLabPrelin
    if (fdp.ConsumeBool()) {
        // Call the target API to allocate a stage.
        cmsStage* stage = _cmsStageAllocLabPrelin(context);
        if (stage) {
            // Free the allocated stage.
            cmsStageFree(stage);
        }
    }

    // Clean up the context.
    cmsDeleteContext(context);
    return 0;
}[0m
