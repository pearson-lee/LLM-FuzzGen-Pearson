            }
        }
    }

    if (mpe_stage_data) {
        cmsStageFree(static_cast<cmsStage*>(mpe_stage_data));
    }
    if (dict_data_void) {
        cmsDictFree(static_cast<cmsHANDLE>(dict_data_void));
    }

    if (labPrelinStage) {
        cmsStageFree(labPrelinStage);
    }

    if (io) {
        cmsCloseIOhandler(io);
    }

    if (context) {
        cmsDeleteContext(context);
    }

