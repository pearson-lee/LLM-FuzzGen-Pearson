#include "/src/lcms/include/lcms2.h"

// Wrap the include of lcms2_internal.h in extern "C" to ensure C linkage
// for the functions causing linker errors.
extern "C" {
#include "/src/lcms/src/lcms2_internal.h" // For _cmsGetTagTypeHandler, _cmsContextGetClientChunk, MPEPlugin, _cmsStageAllocLabPrelin, cmsTagTypeHandler, etc.
}

#include <fuzzer/FuzzedDataProvider.h>
#include <cstddef>
#include <cstdint>
#include <vector>
#include <algorithm> // For std::min

// Helper to create a cmsIOHANDLER from fuzzer data for reading
cmsIOHANDLER* CreateReadIOHandler(FuzzedDataProvider& fdp, cmsContext context, size_t max_chunk_size) {
    size_t data_size = fdp.ConsumeIntegralInRange<size_t>(0, std::min(max_chunk_size, fdp.remaining_bytes()));
    std::vector<uint8_t> io_data = fdp.ConsumeBytes<uint8_t>(data_size);
    
    if (io_data.empty()) {
        io_data.assign({0, 0, 0, 0}); 
    }
    return cmsOpenIOhandlerFromMem(context, io_data.data(), io_data.size(), "r");
}

// Helper to create a writable cmsIOHANDLER
cmsIOHANDLER* CreateWriteIOHandler(cmsContext context) {
    return cmsOpenIOhandlerFromNULL(context);
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    cmsContext context = cmsCreateContext(NULL, NULL);
    if (!context) {
        return 0; 
    }

    // --- Test 1: Exercise Type_MPEcurve_Read by reading a cmsSigMultiProcessElementType tag ---
    if (fdp.ConsumeBool()) {
        cmsTagTypeHandler* mpe_handler = _cmsGetTagTypeHandler(context, cmsSigMultiProcessElementType);
        if (mpe_handler && mpe_handler->ReadPtr) {
            cmsIOHANDLER* io_mpe = CreateReadIOHandler(fdp, context, 2048); 
            if (io_mpe) {
                cmsUInt32Number items_read = 0;
                cmsUInt32Number size_of_tag = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 2048); 
                
                void* mpe_data = mpe_handler->ReadPtr(
                    mpe_handler, 
                    io_mpe,
                    &items_read,
                    size_of_tag
                );

                if (mpe_data && mpe_handler->FreePtr) {
                    mpe_handler->FreePtr(mpe_handler, mpe_data);
                }
                cmsCloseIOhandler(io_mpe); 
            }
        }
    }

    // --- Test 2: Type_ProfileSequenceDesc_Read ---
    if (fdp.ConsumeBool()) {
        cmsTagTypeHandler* psd_handler = _cmsGetTagTypeHandler(context, cmsSigProfileSequenceDescType);
        if (psd_handler && psd_handler->ReadPtr) {
            cmsIOHANDLER* io_psd = CreateReadIOHandler(fdp, context, 1024);
            if (io_psd) {
                cmsUInt32Number items_read = 0;
                cmsUInt32Number size_of_tag = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 1024);
                void* psd_data = psd_handler->ReadPtr(
                    psd_handler,
                    io_psd,
                    &items_read,
                    size_of_tag
                );
                if (psd_data && psd_handler->FreePtr) {
                    psd_handler->FreePtr(psd_handler, psd_data);
                }
                cmsCloseIOhandler(io_psd); 
            }
        }
    }

    // --- Test 3: Replicate _cmsStageAllocLabPrelin to avoid its internal leak ---
    if (fdp.ConsumeBool()) {
        cmsToneCurve* lab_table[3] = {NULL, NULL, NULL}; 
        cmsFloat64Number params[1] = {2.4};
        bool curves_ok = true;

        lab_table[0] = cmsBuildGamma(context, 1.0);
        if (!lab_table[0]) {
            curves_ok = false;
        }

        if (curves_ok) {
            lab_table[1] = cmsBuildParametricToneCurve(context, 108, params); 
            if (!lab_table[1]) {
                if (lab_table[0]) cmsFreeToneCurve(lab_table[0]);
                lab_table[0] = NULL; 
                curves_ok = false;
            }
        }

        if (curves_ok) {
            lab_table[2] = cmsBuildParametricToneCurve(context, 108, params); 
            if (!lab_table[2]) {
                if (lab_table[0]) cmsFreeToneCurve(lab_table[0]);
                lab_table[0] = NULL;
                if (lab_table[1]) cmsFreeToneCurve(lab_table[1]);
                lab_table[1] = NULL;
                curves_ok = false;
            }
        }

        if (curves_ok) {
            cmsStage* stage_lab_prelin_manual = cmsStageAllocToneCurves(context, 3, (cmsToneCurve* const*)lab_table); 
            
            if (lab_table[0]) cmsFreeToneCurve(lab_table[0]);
            if (lab_table[1]) cmsFreeToneCurve(lab_table[1]);
            if (lab_table[2]) cmsFreeToneCurve(lab_table[2]);

            if (stage_lab_prelin_manual) {
                cmsStageFree(stage_lab_prelin_manual);
            }
        }
    }

    // --- Test 4: Type_Dictionary_Read ---
    if (fdp.ConsumeBool()) {
        cmsTagTypeHandler* dict_handler = _cmsGetTagTypeHandler(context, cmsSigDictType);
        if (dict_handler && dict_handler->ReadPtr) {
            cmsIOHANDLER* io_dict = CreateReadIOHandler(fdp, context, 2048);
            if (io_dict) {
                cmsUInt32Number items_read = 0;
                cmsUInt32Number size_of_tag = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 2048);
                void* dict_data = dict_handler->ReadPtr(
                    dict_handler,
                    io_dict,
                    &items_read,
                    size_of_tag
                );
                if (dict_data && dict_handler->FreePtr) {
                    dict_handler->FreePtr(dict_handler, dict_data);
                }
                cmsCloseIOhandler(io_dict); 
            }
        }
    }

    // --- Test 5: Type_LUT8_Write ---
    if (fdp.ConsumeBool()) {
        cmsTagTypeHandler* lut8_handler = _cmsGetTagTypeHandler(context, cmsSigLut8Type);
        if (lut8_handler && lut8_handler->WritePtr) {
            cmsIOHANDLER* io_lut8_write = CreateWriteIOHandler(context); 
            if (io_lut8_write) {
                cmsUInt32Number input_channels = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, cmsMAXCHANNELS); // Allow 0 channels
                cmsUInt32Number output_channels = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, cmsMAXCHANNELS); // Allow 0 channels
                cmsPipeline* lut_to_write = cmsPipelineAlloc(context, input_channels, output_channels);

                if (lut_to_write) {
                    if (input_channels == 3 && output_channels == 3 && fdp.ConsumeBool()) {
                         cmsFloat64Number identity_matrix[9] = {1,0,0, 0,1,0, 0,0,1};
                         cmsStage* matrix_stage = cmsStageAllocMatrix(context, 3, 3, identity_matrix, NULL);
                         if (matrix_stage) { 
                            cmsPipelineInsertStage(lut_to_write, cmsAT_BEGIN, matrix_stage);
                         } 
                    }

                    cmsToneCurve* id_curves_in[cmsMAXCHANNELS];
                    for (cmsUInt32Number i = 0; i < cmsMAXCHANNELS; ++i) id_curves_in[i] = NULL;
                    bool prelin_curves_ok = true;
                    if (input_channels > 0) {
                        for (cmsUInt32Number i = 0; i < input_channels; ++i) {
                            id_curves_in[i] = cmsBuildGamma(context, 1.0); 
                            if (!id_curves_in[i]) {
                                prelin_curves_ok = false;
                                for (cmsUInt32Number k = 0; k < i; ++k) { 
                                    if(id_curves_in[k]) cmsFreeToneCurve(id_curves_in[k]);
                                    id_curves_in[k] = NULL;
                                }
                                break;
                            }
                        }
                        if (prelin_curves_ok) { 
                            cmsStage* prelin_stage = cmsStageAllocToneCurves(context, input_channels, (cmsToneCurve* const*)id_curves_in); 
                            if (prelin_stage) {
                                cmsPipelineInsertStage(lut_to_write, cmsAT_END, prelin_stage);
                            }
                        }
                    }
                    for (cmsUInt32Number i = 0; i < input_channels; ++i) { // Free originals
                        if(id_curves_in[i]) cmsFreeToneCurve(id_curves_in[i]); 
                    }

                    cmsToneCurve* id_curves_out[cmsMAXCHANNELS];
                    for (cmsUInt32Number i = 0; i < cmsMAXCHANNELS; ++i) id_curves_out[i] = NULL;
                    bool postlin_curves_ok = true;
                    if (output_channels > 0) {
                        for (cmsUInt32Number i = 0; i < output_channels; ++i) {
                            id_curves_out[i] = cmsBuildGamma(context, 1.0); 
                            if (!id_curves_out[i]) {
                                postlin_curves_ok = false;
                                for (cmsUInt32Number k = 0; k < i; ++k) { 
                                    if(id_curves_out[k]) cmsFreeToneCurve(id_curves_out[k]);
                                    id_curves_out[k] = NULL;
                                }
                                break;
                            }
                        }
                        if (postlin_curves_ok) { 
                            cmsStage* postlin_stage = cmsStageAllocToneCurves(context, output_channels, (cmsToneCurve* const*)id_curves_out); 
                            if (postlin_stage) {
                                cmsPipelineInsertStage(lut_to_write, cmsAT_END, postlin_stage);
                            }
                        }
                    }
                    for (cmsUInt32Number i = 0; i < output_channels; ++i) { // Free originals
                        if(id_curves_out[i]) cmsFreeToneCurve(id_curves_out[i]); 
                    }
                    
                    lut8_handler->WritePtr(
                        lut8_handler,
                        io_lut8_write,
                        lut_to_write,
                        1 
                    );
                    cmsPipelineFree(lut_to_write); 
                }
                cmsCloseIOhandler(io_lut8_write); 
            }
        }
    }

    cmsDeleteContext(context);
    return 0;
}[0m
