// Helper to initialize a _cmsTagTypeHandler structure.
// The 'self' parameter in Type_*_Read/Write functions points to such a structure,
// and these functions may access self->ContextID.
static _cmsTagTypeHandler initialize_type_handler(cmsContext context_id) {
    _cmsTagTypeHandler handler;
    // Zero out the structure first.
    std::memset(&handler, 0, sizeof(_cmsTagTypeHandler));
    // Set the ContextID, which is used by the type handling functions.
    handler.ContextID = context_id;
    return handler;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);
    cmsContext context = nullptr;
    cmsIOHANDLER *io = nullptr; // Reusable IO handler pointer
    _cmsTagTypeHandler type_handler_instance;

    // Create an LCMS context. Most LCMS operations require a context.
    // Memory Management: cmsDeleteContext must be called at the end.
    context = cmsCreateContext(nullptr, nullptr);
    if (!context) {
        return 0; // Cannot proceed without a context.
    }

    // Initialize the custom type handler structure with the created context.
    // This is passed as 'self' to the Type_* functions.
    type_handler_instance = initialize_type_handler(context);

    cmsStage *labPrelinStage = nullptr;
    void *mpe_stage_data = nullptr; // Will hold cmsStage* from Type_MPEcurve_Read
    void *dict_data = nullptr;      // Will hold cmsDICT* from Type_Dictionary_Read

    // API 1: cmsStage * _cmsStageAllocLabPrelin(cmsContext ContextID)
    // Allocates a Lab prelinearization stage. Part of lcms's internal API.
    if (fdp.ConsumeBool()) {
        labPrelinStage = _cmsStageAllocLabPrelin(context);
        // Memory Management: labPrelinStage must be freed using cmsStageFree if not NULL.
    }

    // --- MPE Curve (cmsStage) Operations ---
    // Type_MPEcurve_Read/Write handle "Multi Process Element" curve types, which are cmsStage objects.
    if (fdp.ConsumeBool()) {
        // Prepare input data for Type_MPEcurve_Read from the fuzzer.
        std::vector<uint8_t> mpe_read_input_data = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 1024));
        if (!mpe_read_input_data.empty()) {
            // API 2: void * Type_MPEcurve_Read(...)
            // Reads an MPE curve set (a cmsStage) from an IO handler.
            io = cmsOpenIOhandlerFromMem(context, mpe_read_input_data.data(), mpe_read_input_data.size(), "r");
            if (io) {
                cmsUInt32Number items_read_mpe = 0;
                cmsUInt32Number size_of_tag_mpe = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 10000); // Fuzzed size for the tag data
                mpe_stage_data = Type_MPEcurve_Read(&type_handler_instance, io, &items_read_mpe, size_of_tag_mpe);
                // Memory Management: mpe_stage_data (which is a cmsStage*) must be freed using cmsStageFree.
                cmsCloseIOhandler(io); // Close the IO handler.
                io = nullptr;          // Reset pointer.
            }
        }

        // API 3: cmsBool Type_MPEcurve_Write(..., void* Ptr, cmsUInt32Number nItems)
        // Writes an MPE curve set (a cmsStage) to an IO handler. Ptr is cmsStage*. nItems is typically 1.
        if (fdp.ConsumeBool()) {
            cmsStage* stage_to_write_mpe = static_cast<cmsStage*>(mpe_stage_data); // Use read data if available
            cmsStage* temp_alloc_stage_mpe = nullptr; // For locally allocated stage

            if (!stage_to_write_mpe && fdp.ConsumeBool()) { // If no data from read, try to create a simple one
                temp_alloc_stage_mpe = cmsStageAllocIdentity(context, fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 3));
                stage_to_write_mpe = temp_alloc_stage_mpe;
            }

            if (stage_to_write_mpe) {
                std::vector<uint8_t> mpe_write_buffer(2048); // Buffer for writing output
                io = cmsOpenIOhandlerFromMem(context, mpe_write_buffer.data(), mpe_write_buffer.size(), "w");
                if (io) {
                    // nItems for Type_MPEcurve_Write is the number of elements of this type, usually 1 for a single stage.
                    Type_MPEcurve_Write(&type_handler_instance, io, stage_to_write_mpe, 1);
                    cmsCloseIOhandler(io);
                    io = nullptr;
                }
            }
            // Memory Management: Free the temporarily allocated stage if one was created for writing.
            if (temp_alloc_stage_mpe) {
                cmsStageFree(temp_alloc_stage_mpe);
            }
        }
    }

    // --- Dictionary (cmsDICT) Operations ---
    // Type_Dictionary_Read/Write handle dictionary tag types.
    if (fdp.ConsumeBool()) {
        // Prepare input data for Type_Dictionary_Read.
        std::vector<uint8_t> dict_read_input_data = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 1024));
         if (!dict_read_input_data.empty()) {
            // API 4: void * Type_Dictionary_Read(...)
            // Reads a dictionary (cmsDICT) from an IO handler.
            io = cmsOpenIOhandlerFromMem(context, dict_read_input_data.data(), dict_read_input_data.size(), "r");
            if (io) {
                cmsUInt32Number items_read_dict = 0;
                cmsUInt32Number size_of_tag_dict = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 10000); // Fuzzed size
                dict_data = Type_Dictionary_Read(&type_handler_instance, io, &items_read_dict, size_of_tag_dict);
                // Memory Management: dict_data (cmsDICT*) must be freed using cmsDictFree.
                cmsCloseIOhandler(io);
                io = nullptr;
            }
        }

        // API 5: cmsBool Type_Dictionary_Write(..., void* Ptr, cmsUInt32Number nItems)
        // Writes a dictionary (cmsDICT) to an IO handler. Ptr is cmsDICT*. nItems is the count of entries.
        if (fdp.ConsumeBool()) {
            cmsDICT* dict_to_write = static_cast<cmsDICT*>(dict_data); // Use read data if available
            cmsDICT* temp_alloc_dict = nullptr; // For locally allocated dictionary

            if (!dict_to_write && fdp.ConsumeBool()) { // If no data from read, create a simple one
                temp_alloc_dict = cmsDictAlloc(context);
                if (temp_alloc_dict && fdp.ConsumeBool()) { // Optionally add a fuzzed entry
                    cmsMLU* mlu_disp_name = cmsMLUalloc(context, 1);
                    cmsMLU* mlu_disp_val = cmsMLUalloc(context, 1);
                    if (mlu_disp_name && mlu_disp_val) {
                        // Populate MLUs with fuzzed ASCII strings.
                        cmsMLUsetASCII(mlu_disp_name, "en", "US", fdp.ConsumeRandomLengthString(10).c_str());
                        cmsMLUsetASCII(mlu_disp_val, "en", "US", fdp.ConsumeRandomLengthString(10).c_str());
                        
                        // Generate a fuzzed wide string for the dictionary key.
                        std::wstring name_key = fdp.ConsumeRandomLengthStringAsWstring(fdp.ConsumeIntegralInRange<size_t>(1, 8));
                        
                        // cmsDictAddEntry copies Name/Value strings and duplicates MLUs.
                        // So, original MLUs must be freed after the call.
                        cmsDictAddEntry(temp_alloc_dict, name_key.c_str(), nullptr, mlu_disp_name, mlu_disp_val);
                        
                        cmsMLUfree(mlu_disp_name); 
                        cmsMLUfree(mlu_disp_val);
                    } else { // Handle partial MLU allocation
                        if (mlu_disp_name) cmsMLUfree(mlu_disp_name);
                        if (mlu_disp_val) cmsMLUfree(mlu_disp_val);
                    }
                }
                dict_to_write = temp_alloc_dict;
            }

            if (dict_to_write) {
                std::vector<uint8_t> dict_write_buffer(2048); // Buffer for writing output
                io = cmsOpenIOhandlerFromMem(context, dict_write_buffer.data(), dict_write_buffer.size(), "w");
                if (io) {
                    cmsUInt32Number num_dict_entries = cmsDictGetEntryCount(dict_to_write);
                    Type_Dictionary_Write(&type_handler_instance, io, dict_to_write, num_dict_entries);
                    cmsCloseIOhandler(io);
                    io = nullptr;
                }
            }
            // Memory Management: Free the temporarily allocated dictionary if one was created for writing.
            if (temp_alloc_dict) {
                cmsDictFree(temp_alloc_dict);
            }
        }
    }

    // Final Cleanup Phase
    // Free data obtained from Read functions that hasn't been freed yet.
    if (mpe_stage_data) {
        cmsStageFree(static_cast<cmsStage*>(mpe_stage_data));
    }
    if (dict_data) {
        cmsDictFree(static_cast<cmsDICT*>(dict_data));
    }

    // Free the Lab prelinearization stage if it was allocated by API 1.
    if (labPrelinStage) {
        cmsStageFree(labPrelinStage);
    }

    // Ensure IO handler is closed if any operation failed mid-way and left it open.
    // This is a safeguard, as individual operations should ideally close their IO handlers.
    if (io) {
        cmsCloseIOhandler(io);
    }

    // Delete the LCMS context, freeing all associated resources.
    cmsDeleteContext(context);

    return 0;
}[0m
