    if (fdp.ConsumeBool() && pipeline) {
        cmsWriteTag(hProfile.get(), cmsSigMultiProcessElementType, pipeline);
    }

    // All LCMS objects (context, hProfile, pipeline_ptr, labStage_ptr) are automatically
    // cleaned up by their respective std::unique_ptr deleters when they go out of scope.
    // Tone curves created temporarily within loops are explicitly freed.
    return 0;
