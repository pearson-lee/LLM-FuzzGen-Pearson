            }

            if (dict_to_write) {
                std::vector<uint8_t> dict_write_buffer(2048); 
                io = cmsOpenIOhandlerFromMem(context, dict_write_buffer.data(), dict_write_buffer.size(), "w");
                if (io) {
                    cmsUInt32Number num_dict_entries = 0;
