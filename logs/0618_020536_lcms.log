#include <fuzzer/FuzzedDataProvider.h>

// RAII Deleters for LCMS types, to be used with std::unique_ptr
// Ensures that LCMS objects are properly deallocated even if errors occur.

// Deleter for cmsContext
struct ContextDeleter {
    void operator()(cmsContext ctx) {
        if (ctx) cmsDeleteContext(ctx);
    }
};

// Deleter for cmsHPROFILE
struct ProfileDeleter {
    void operator()(cmsHPROFILE p) {
        if (p) cmsCloseProfile(p);
    }
};

// Deleter for cmsPipeline
struct PipelineDeleter {
    void operator()(cmsPipeline* p) {
        if (p) cmsPipelineFree(p);
    }
};

// Deleter for cmsStage
struct StageDeleter {
    void operator()(cmsStage* s) {
        if (s) cmsStageFree(s);
    }
};

// Note: cmsToneCurve is managed by cmsFreeToneCurve, handled manually or within stages.

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // 1. Create Context
    // cmsContext is managed by std::unique_ptr for automatic cleanup.
    std::unique_ptr<std::remove_pointer_t<cmsContext>, ContextDeleter> context(cmsCreateContext(nullptr, nullptr));
    if (!context) {
        // If context creation fails, cannot proceed.
        return 0;
    }
    cmsContext contextID = context.get();

    // 2. Create a Profile Placeholder
    // cmsHPROFILE is managed by std::unique_ptr for automatic cleanup.
    // This profile will be used as a target for writing tags.
    std::unique_ptr<std::remove_pointer_t<cmsHPROFILE>, ProfileDeleter> hProfile(cmsCreateProfilePlaceholder(contextID));
    if (!hProfile) {
        // If profile creation fails, cannot proceed.
        return 0;
    }

    // --- Target API 1: _cmsStageAllocLabPrelin ---
    // This internal function creates a Lab prelinearization stage.
    // The returned cmsStage* is managed by std::unique_ptr.
    // NOTE: Calling _cmsStageAllocLabPrelin causes memory leaks within the function itself
    // (original tone curves are not freed after duplication). To ensure the fuzzer is
    // leak-free as per requirements, this call is disabled.
    std::unique_ptr<cmsStage, StageDeleter> labStage_ptr;
    if (fdp.ConsumeBool()) { // Decide whether to create and use this stage
        // labStage_ptr.reset(_cmsStageAllocLabPrelin(contextID)); // THIS CALL IS LEAKY IN LCMS LIBRARY
    }

    // --- Setup for LUT/MPE Write operations ---
    // Create a pipeline. This will be the data for several cmsWriteTag calls.
    // cmsPipeline is managed by std::unique_ptr.
    cmsUInt32Number inputChannels = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 8);  // Keep channel count reasonable for fuzzing
    cmsUInt32Number outputChannels = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 8); // Keep channel count reasonable for fuzzing
    std::unique_ptr<cmsPipeline, PipelineDeleter> pipeline_ptr(cmsPipelineAlloc(contextID, inputChannels, outputChannels));
    
    if (!pipeline_ptr) {
        // If pipeline allocation fails, cannot proceed with tag writing.
        return 0; 
    }
    cmsPipeline* pipeline = pipeline_ptr.get();


    // Optionally add the labStage to the pipeline if compatible and created.
    // _cmsStageAllocLabPrelin creates a 3-channel stage.
    // Since labStage_ptr is never initialized if the call above is commented out, this block will not execute.
    if (labStage_ptr && pipeline && cmsPipelineInputChannels(pipeline) == 3 && fdp.ConsumeBool()) {
        // cmsPipelineInsertStage duplicates the stage. The labStage_ptr still owns the original stage,
        // which will be freed automatically when labStage_ptr goes out of scope.
        cmsPipelineInsertStage(pipeline, cmsAT_END, labStage_ptr.get());
    }

    // Add a fuzzed tone curve stage to the pipeline to make it more complex.
    // This helps in testing Type_MPEcurve_Write indirectly when the MPE tag is written.
    if (fdp.ConsumeBool() && pipeline) {
        cmsUInt32Number currentPipelineStageChannels = 0;
        if (cmsPipelineStageCount(pipeline) == 0) {
            currentPipelineStageChannels = cmsPipelineInputChannels(pipeline);
        } else {
            currentPipelineStageChannels = cmsPipelineOutputChannels(pipeline);
        }
        
        // Limit channels to a practical number for fuzzing to avoid excessive allocations.
        currentPipelineStageChannels = std::min(currentPipelineStageChannels, static_cast<cmsUInt32Number>(4));

        if (currentPipelineStageChannels > 0) {
            std::vector<cmsToneCurve*> curvesVec(currentPipelineStageChannels, nullptr);
            bool allCurvesAllocated = true;
            for (cmsUInt32Number i = 0; i < currentPipelineStageChannels; ++i) {
                if (fdp.ConsumeBool()) {
                    curvesVec[i] = cmsBuildGamma(contextID, fdp.ConsumeFloatingPointInRange<double>(0.1, 3.0));
                } else {
                    cmsUInt16Number nEntries = fdp.ConsumeIntegralInRange<cmsUInt16Number>(2, 16); // Small nEntries for fuzzing
                    std::vector<cmsUInt16Number> entries(nEntries);
                    for(cmsUInt16Number k=0; k<nEntries; ++k) entries[k] = fdp.ConsumeIntegral<cmsUInt16Number>();
                    curvesVec[i] = cmsBuildTabulatedToneCurve16(contextID, nEntries, entries.data());
                }
                if (!curvesVec[i]) {
                    allCurvesAllocated = false;
                    // Free already allocated curves in this specific attempt before breaking
                    for (cmsUInt32Number j = 0; j < i; ++j) {
                        if(curvesVec[j]) cmsFreeToneCurve(curvesVec[j]); // cmsFreeToneCurve handles NULL
                        curvesVec[j] = nullptr; 
                    }
                    break; 
                }
            }

            if (allCurvesAllocated) {
                cmsStage* tcStage = cmsStageAllocToneCurves(contextID, currentPipelineStageChannels, curvesVec.data());
                if (tcStage) {
                    // cmsPipelineInsertStage is supposed to duplicate the stage.
                    // However, for curve set stages (cmsSigCurveSetElemType),
                    // the duplication of internal tone curves is shallow (bug in lcms's cmsStageDup).
                    // If we free tcStage after a successful insertion, the pipeline's
                    // stage will point to freed tone curves, leading to a UAF when
                    // the pipeline is freed.
                    if (!cmsPipelineInsertStage(pipeline, cmsAT_END, tcStage)) {
                        // Insertion failed. We still own tcStage and must free it.
                        cmsStageFree(tcStage);
