extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    cmsContext ctx = cmsCreateContext(NULL, NULL);
    if (!ctx) {
        return 0;
    }

    _cms_typehandler_struct handler_struct;
    memset(&handler_struct, 0, sizeof(_cms_typehandler_struct));
    handler_struct.ContextID = ctx;
    handler_struct.ICCVersion = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0x02000000, 0x04400000);

    if (fdp.ConsumeBool()) {
        cmsStage* stage = _cmsStageAllocLabPrelin(ctx); // Declared in lcms2_internal.h
        if (stage) {
            cmsStageFree(stage);
        }
    }

    cmsSEQ* profile_seq_desc_read_result = nullptr;

    if (fdp.ConsumeBool()) {
        std::vector<uint8_t> psd_read_data = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, fdp.remaining_bytes() / 3));
        if (!psd_read_data.empty()) {
            cmsIOHANDLER* io_read_psd = cmsOpenIOhandlerFromMem(ctx, (void*)psd_read_data.data(), psd_read_data.size(), "r");
            if (io_read_psd) {
                cmsUInt32Number nItems_psd = 0;
                cmsUInt32Number size_of_tag_psd = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, static_cast<cmsUInt32Number>(psd_read_data.size()));
                
                profile_seq_desc_read_result = (cmsSEQ*)Type_ProfileSequenceDesc_Read(&handler_struct, io_read_psd, &nItems_psd, size_of_tag_psd);
                
                cmsCloseIOhandler(io_read_psd);
            }
        }
    }

    if (fdp.ConsumeBool()) {
        cmsSEQ* seq_to_write = nullptr;
        bool new_seq_allocated_for_write = false;

        if (profile_seq_desc_read_result != nullptr && fdp.ConsumeBool()) {
            seq_to_write = profile_seq_desc_read_result;
        } else {
            cmsUInt32Number num_desc_entries = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
            seq_to_write = cmsAllocProfileSequenceDescription(ctx, num_desc_entries);
            if (seq_to_write) {
                new_seq_allocated_for_write = true;
                for (cmsUInt32Number i = 0; i < num_desc_entries; ++i) {
                     if (i < seq_to_write->n) { // Check against actual allocated count
                        seq_to_write->seq[i].deviceMfg = fdp.ConsumeIntegral<cmsUInt32Number>();
                        seq_to_write->seq[i].deviceModel = fdp.ConsumeIntegral<cmsUInt32Number>();
                        seq_to_write->seq[i].attributes = fdp.ConsumeIntegral<cmsUInt64Number>();
                        seq_to_write->seq[i].technology = (cmsTechnologySignature)fdp.ConsumeIntegral<cmsUInt32Number>();
                        
                        seq_to_write->seq[i].Manufacturer = cmsMLUalloc(ctx, 1); 
                        if (seq_to_write->seq[i].Manufacturer) {
                            cmsMLUsetASCII(seq_to_write->seq[i].Manufacturer, fdp.ConsumeBytesAsString(2).c_str(), fdp.ConsumeBytesAsString(2).c_str(), fdp.ConsumeRandomLengthString(10).c_str());
                        }
                        seq_to_write->seq[i].Model = cmsMLUalloc(ctx, 1);
                         if (seq_to_write->seq[i].Model) {
                            cmsMLUsetASCII(seq_to_write->seq[i].Model, fdp.ConsumeBytesAsString(2).c_str(), fdp.ConsumeBytesAsString(2).c_str(), fdp.ConsumeRandomLengthString(10).c_str());
                        }
                    }
                }
            }
        }

        if (seq_to_write) {
            size_t write_buffer_size = fdp.ConsumeIntegralInRange<size_t>(128, 2048);
            std::vector<uint8_t> write_buffer(write_buffer_size);
            cmsIOHANDLER* io_write_psd = cmsOpenIOhandlerFromMem(ctx, write_buffer.data(), write_buffer.size(), "w");
            if (io_write_psd) {
                Type_ProfileSequenceDesc_Write(&handler_struct, io_write_psd, seq_to_write, 1);
                cmsCloseIOhandler(io_write_psd);
            }

            if (new_seq_allocated_for_write) {
                for (cmsUInt32Number i = 0; i < seq_to_write->n; ++i) {
                    if (seq_to_write->seq[i].Manufacturer) cmsMLUfree(seq_to_write->seq[i].Manufacturer);
                    if (seq_to_write->seq[i].Model) cmsMLUfree(seq_to_write->seq[i].Model);
                }
                cmsFreeProfileSequenceDescription(seq_to_write);
            }
        }
    }

    if (profile_seq_desc_read_result) {
        cmsFreeProfileSequenceDescription(profile_seq_desc_read_result);
    }

    if (fdp.ConsumeBool()) {
        std::vector<uint8_t> dict_read_data = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, fdp.remaining_bytes() / 2));
        if (!dict_read_data.empty()) {
            cmsIOHANDLER* io_read_dict = cmsOpenIOhandlerFromMem(ctx, (void*)dict_read_data.data(), dict_read_data.size(), "r");
            if (io_read_dict) {
                cmsUInt32Number nItems_dict = 0;
                cmsUInt32Number size_of_tag_dict = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, static_cast<cmsUInt32Number>(dict_read_data.size()));
                
                cmsHANDLE dict_handle = (cmsHANDLE)Type_Dictionary_Read(&handler_struct, io_read_dict, &nItems_dict, size_of_tag_dict);
                
                cmsCloseIOhandler(io_read_dict);
                if (dict_handle) {
                    cmsDictFree(dict_handle); // cmsDictFree expects cmsHANDLE (which is void*)
                }
            }
        }
    }

    if (fdp.ConsumeBool()) {
        std::vector<uint8_t> vcgt_read_data = fdp.ConsumeRemainingBytes<uint8_t>();
        if (!vcgt_read_data.empty()) {
            cmsIOHANDLER* io_read_vcgt = cmsOpenIOhandlerFromMem(ctx, (void*)vcgt_read_data.data(), vcgt_read_data.size(), "r");
            if (io_read_vcgt) {
                cmsUInt32Number nItems_vcgt = 0;
                cmsUInt32Number size_of_tag_vcgt = fdp.ConsumeBool() ? static_cast<cmsUInt32Number>(vcgt_read_data.size()) : 0;

                cmsToneCurve** vcgt_curves = (cmsToneCurve**)Type_vcgt_Read(&handler_struct, io_read_vcgt, &nItems_vcgt, size_of_tag_vcgt);
                
                cmsCloseIOhandler(io_read_vcgt);
                if (vcgt_curves) {
                    cmsFreeToneCurveTriple(vcgt_curves);
                }
            }
        }
    }

    cmsDeleteContext(ctx);

    return 0;
}[0m
