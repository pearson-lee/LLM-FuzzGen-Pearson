// that arise from including C definitions directly into a C++ translation unit.
// We rely on the lcms library to provide the definitions for _cmsStageAllocLabPrelin
// and _cmsGetTagTypeHandler, which are declared with C linkage in lcms2_internal.h.

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    FuzzedDataProvider fdp(data, size);

    // cmsCreateContext will call _cmsRegisterBuiltInTagTypes (from the library's cmstypes.c)
    // which registers handlers for cmsSigProfileSequenceDescType, cmsSigDictType, etc.
    cmsContext ctx = cmsCreateContext(nullptr, nullptr);
