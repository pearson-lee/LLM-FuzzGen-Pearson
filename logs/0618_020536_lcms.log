                }
            }
            // Free all tone curves created in this block (curvesVec).
            // cmsStageAllocToneCurves duplicates them, so the originals always need freeing.
            for (cmsUInt32Number i = 0; i < currentPipelineStageChannels; ++i) {
                if (curvesVec[i]) cmsFreeToneCurve(curvesVec[i]);
            }
        }
    }

    // --- Target API 2: Type_MPEcurve_Write (indirectly) ---
    // This function is involved in writing curve set elements within a MultiProcessElements tag.
    // It will be exercised if a pipeline containing curve stages is written as a suitable tag type.
    // This is covered by the cmsWriteTag call for cmsSigAToB2Tag (or similar MPE tag) below.

    // --- Target API 3: Type_LUT8_Write (via cmsWriteTag with cmsSigAToB0Tag) ---
    if (fdp.ConsumeBool() && pipeline) {
        // cmsWriteTag uses the provided pipeline to generate the tag data.
        // Internally, LCMS dispatches to the appropriate type handler (e.g., Type_LUT8_Write).
        // The pipeline itself is managed by pipeline_ptr and freed at the end of scope.
        cmsWriteTag(hProfile.get(), cmsSigAToB0Tag, pipeline);
    }

    // --- Target API 4: Type_LUT16_Write (via cmsWriteTag with cmsSigAToB1Tag) ---
    if (fdp.ConsumeBool() && pipeline) {
        // Similar to LUT8, cmsWriteTag dispatches to Type_LUT16_Write for appropriate tags.
        cmsWriteTag(hProfile.get(), cmsSigAToB1Tag, pipeline);
    }

    // --- Target API 5: Type_MPE_Write (via cmsWriteTag with cmsSigAToB2Tag) ---
    // This function writes a MultiProcessElements tag, which can contain various stages.
    // If the pipeline includes curve stages, this will also indirectly exercise Type_MPEcurve_Write.
    if (fdp.ConsumeBool() && pipeline) {
        cmsWriteTag(hProfile.get(), cmsSigAToB2Tag, pipeline);
    }

    // All LCMS objects (context, hProfile, pipeline_ptr, labStage_ptr) are automatically
    // cleaned up by their respective std::unique_ptr deleters when they go out of scope.
    // Tone curves created temporarily within loops are explicitly freed.
    return 0;
