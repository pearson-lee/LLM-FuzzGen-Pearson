                if (cmsWriteRawTag(h_profile_dict, cmsSigMetaTag, data_chunk.data(), data_chunk.size())) {
                    void* dict_result_ptr = cmsReadTag(h_profile_dict, cmsSigMetaTag);
                    if (dict_result_ptr) {
                        // Type_Dictionary_Read returns a cmsDICT*, which is a cmsHANDLE
                        cmsDictFree(static_cast<cmsHANDLE>(dict_result_ptr));
                    }
                }
            }
        }
    }

    // --- Target 2: VCGT (via cmsReadTag with cmsSigVcgtTag) ---
    if (fdp.ConsumeBool()) {
        std::unique_ptr<std::remove_pointer_t<cmsHPROFILE>, decltype(profile_deleter)> h_profile_vcgt_ptr(
            cmsCreateProfilePlaceholder(cms_ctx),
            profile_deleter
        );
        cmsHPROFILE h_profile_vcgt = h_profile_vcgt_ptr.get();
        if (h_profile_vcgt) {
            std::vector<uint8_t> data_chunk = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 2048));
            if (!data_chunk.empty()) {
                if (cmsWriteRawTag(h_profile_vcgt, cmsSigVcgtTag, data_chunk.data(), data_chunk.size())) {
                    void* vcgt_raw_result = cmsReadTag(h_profile_vcgt, cmsSigVcgtTag);
                    if (vcgt_raw_result) {
                        cmsToneCurve** vcgt_curves = static_cast<cmsToneCurve**>(vcgt_raw_result);
                        cmsFreeToneCurveTriple(vcgt_curves); 
                        _cmsFree(cms_ctx, vcgt_curves);      
                    }
                }
            }
        }
    }
    
    // --- Target 3: UcrBg (via cmsReadTag with cmsSigUcrBgTag) ---
    if (fdp.ConsumeBool()) {
        std::unique_ptr<std::remove_pointer_t<cmsHPROFILE>, decltype(profile_deleter)> h_profile_ucrbg_ptr(
            cmsCreateProfilePlaceholder(cms_ctx),
            profile_deleter
        );
        cmsHPROFILE h_profile_ucrbg = h_profile_ucrbg_ptr.get();

        if (h_profile_ucrbg) {
            std::vector<uint8_t> data_chunk = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 2048));
            if (!data_chunk.empty()) {
                if (cmsWriteRawTag(h_profile_ucrbg, cmsSigUcrBgTag, data_chunk.data(), data_chunk.size())) {
                    void* ucrbg_raw_result = cmsReadTag(h_profile_ucrbg, cmsSigUcrBgTag);
                    if (ucrbg_raw_result) {
