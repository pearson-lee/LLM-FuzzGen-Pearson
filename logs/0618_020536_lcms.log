            cmsStage* temp_alloc_stage_mpe = nullptr; 

            if (!stage_to_write_mpe && fdp.ConsumeBool()) { 
                temp_alloc_stage_mpe = cmsStageAllocIdentity(context, fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 3));
                stage_to_write_mpe = temp_alloc_stage_mpe;
            }

            if (stage_to_write_mpe) {
                std::vector<uint8_t> mpe_write_buffer(2048); 
                io = cmsOpenIOhandlerFromMem(context, mpe_write_buffer.data(), mpe_write_buffer.size(), "w");
                if (io) {
                    // Type_MPEcurve_Write is defined in cmstypes.c, included above within extern "C"
                    Type_MPEcurve_Write(&type_handler_instance, io, stage_to_write_mpe, 1);
                    cmsCloseIOhandler(io);
                    io = nullptr;
