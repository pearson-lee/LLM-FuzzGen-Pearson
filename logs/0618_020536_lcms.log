        // stage is automatically freed.
    }

    // API 5: Type_ProfileSequenceDesc_Read (called via _cmsProfileSequenceDescHandler.ReadPtr)
    // void* ReadPtr(struct _cms_typehandler_struct* self, cmsIOHANDLER* io,
