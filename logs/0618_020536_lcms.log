// Helper to ensure gamma values are positive for cmsBuildGamma
double consume_positive_gamma(FuzzedDataProvider& fdp) {
    double gamma = fdp.ConsumeFloatingPointInRange<double>(0.01, 10.0);
    if (gamma <= 0) {
        gamma = 1.0;
    }
    return gamma;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    cmsContext context = cmsCreateContext(nullptr, nullptr);
    if (!context) {
        return 0;
    }

    // API 1: Stage allocation
    if (fdp.ConsumeBool()) {
        cmsToneCurve* prelinCurve = cmsBuildGamma(context, 1.0); 
        if (prelinCurve) {
            cmsToneCurve* curves[] = {prelinCurve}; 
            cmsStage* stage = cmsStageAllocToneCurves(context, 1, curves);
            if (stage) {
                cmsStageFree(stage);
            }
            cmsFreeToneCurve(prelinCurve);
        }
    }

    cmsUInt32Number num_profiles = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
    std::vector<cmsHPROFILE> hProfiles(num_profiles);
    bool profiles_ok = true;
    if (num_profiles > 0) {
        for (cmsUInt32Number i = 0; i < num_profiles; ++i) {
            hProfiles[i] = cmsCreate_sRGBProfileTHR(context);
            if (!hProfiles[i]) {
                for (cmsUInt32Number k = 0; k < i; ++k) {
                    if (hProfiles[k]) cmsCloseProfile(hProfiles[k]);
                }
                cmsDeleteContext(context);
                profiles_ok = false;
                return 0;
            }
        }
    }

    cmsToneCurve* built_curve = nullptr;

    // API 2: Tone curve building
    if (profiles_ok && num_profiles > 0 && fdp.ConsumeBool()) {
        built_curve = cmsBuildGamma(context, consume_positive_gamma(fdp));
    }

    // API 3: Transform creation
    if (profiles_ok && num_profiles > 0 && fdp.ConsumeBool()) {
        std::vector<cmsUInt32Number> intent_data(num_profiles);
        std::vector<cmsBool> bpc_data(num_profiles);
        std::vector<cmsFloat64Number> adaptation_data(num_profiles);
        cmsUInt32Number dwFlags_transform = fdp.ConsumeIntegral<cmsUInt32Number>();

        for (cmsUInt32Number i = 0; i < num_profiles; ++i) {
            intent_data[i] = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
            bpc_data[i] = fdp.ConsumeBool();
            adaptation_data[i] = fdp.ConsumeProbability<cmsFloat64Number>();
        }
        
        cmsHTRANSFORM transform = cmsCreateExtendedTransform(context,
                                                            num_profiles,
                                                            hProfiles.data(),
                                                            bpc_data.data(),
                                                            intent_data.data(),
                                                            adaptation_data.data(),
                                                            NULL, 0, 
                                                            TYPE_RGB_DBL, 
                                                            TYPE_Lab_DBL, 
                                                            dwFlags_transform);
        if (transform) {
            cmsDeleteTransform(transform);
        }
    }

    std::vector<uint8_t> io_buffer_data = fdp.ConsumeRemainingBytes<uint8_t>();
    cmsIOHANDLER* io = nullptr;
    if (!io_buffer_data.empty()) {
         io = cmsOpenIOhandlerFromMem(context, (void*)io_buffer_data.data(), io_buffer_data.size(), "r");
    }

    // API 4: Type_ProfileSequenceDesc_Read
    if (io && fdp.ConsumeBool()) {
        // Use public cmsGetTagTypeHandler (no context)
        cmsTagTypeHandler* psd_handler = cmsGetTagTypeHandler(cmsSigProfileSequenceDescType);
        if (psd_handler && psd_handler->ReadPtr && io->Seek) {
            cmsUInt32Number nItems = 0;
            io->Seek(io, 0); 
            cmsUInt32Number sizeOfTag = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, (cmsUInt32Number)io_buffer_data.size());
            void* data = psd_handler->ReadPtr(psd_handler, io, &nItems, sizeOfTag);
            if (data) {
                cmsFreeProfileSequenceDescription((cmsSEQ*)data);
            }
        }
    }

    cmsToneCurve* curve_to_dup = nullptr;
    bool locally_created_curve_for_dup = false;

    if (built_curve && fdp.ConsumeBool()) {
        curve_to_dup = built_curve;
    } else if (fdp.ConsumeBool()) {
        curve_to_dup = cmsBuildGamma(context, consume_positive_gamma(fdp));
        if (curve_to_dup) {
            locally_created_curve_for_dup = true;
        }
    }

    // API 5: Type_Curve_Dup
    if (curve_to_dup) {
        // Use public cmsGetTagTypeHandler (no context)
        cmsTagTypeHandler* curve_handler = cmsGetTagTypeHandler(cmsSigCurveType);
        if (curve_handler && curve_handler->DupPtr) {
            cmsUInt32Number n_dup_param = 1;
            cmsToneCurve* duplicated_curve = (cmsToneCurve*)curve_handler->DupPtr(curve_handler, curve_to_dup, n_dup_param);
            if (duplicated_curve) {
                cmsFreeToneCurve(duplicated_curve);
            }
        }
    }

    if (built_curve) {
        cmsFreeToneCurve(built_curve);
    }
    if (locally_created_curve_for_dup && curve_to_dup) {
        cmsFreeToneCurve(curve_to_dup);
    }

    if (io) {
        cmsCloseIOhandler(io);
    }

    if (profiles_ok) {
        for (cmsUInt32Number i = 0; i < num_profiles; ++i) {
            if (hProfiles[i]) {
                cmsCloseProfile(hProfiles[i]);
            }
        }
    }

    cmsDeleteContext(context);
    return 0;
}[0m
