    // NULL for error logger means use the default.
    cmsContext context = cmsCreateContext(NULL, NULL);
    if (!context) {
        return 0; // Cannot proceed without context
    }

    // --- Test 1: Exercise Type_MPEcurve_Read by reading a cmsSigMultiProcessElementType tag ---
    // Type_MPEcurve_Read is a reader for cmsSigCurveSetElemType within an MPE tag.
    // We target it by fuzzing the reading of a cmsSigMultiProcessElementType tag.
    if (fdp.ConsumeBool()) {
        cmsTagTypeHandler* mpe_handler = _cmsGetTagTypeHandler(context, cmsSigMultiProcessElementType);
        if (mpe_handler && mpe_handler->ReadPtr) {
            cmsIOHANDLER* io_mpe = CreateReadIOHandler(fdp, context, 2048); 
            if (io_mpe) {
                cmsUInt32Number items_read = 0;
                // SizeOfTag for the whole MPE tag, fuzzed.
                cmsUInt32Number size_of_tag = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 2048); 
                
                // This call, if the IO data contains a CurveSet element, will exercise Type_MPEcurve_Read.
                void* mpe_data = mpe_handler->ReadPtr(
                    mpe_handler, 
                    io_mpe,
                    &items_read,
                    size_of_tag
                );

                if (mpe_data && mpe_handler->FreePtr) {
                    // mpe_data is a cmsPipeline* as Type_MPE_Read returns a pipeline.
                    // The FreePtr for cmsSigMultiProcessElementType will call cmsPipelineFree.
                    mpe_handler->FreePtr(mpe_handler, mpe_data);
                }
                cmsCloseIOhandler(io_mpe); // Close the IO handler
            }
        }
    }

    // --- Test 2: Type_ProfileSequenceDesc_Read ---
    if (fdp.ConsumeBool()) {
        cmsTagTypeHandler* psd_handler = _cmsGetTagTypeHandler(context, cmsSigProfileSequenceDescType);
        if (psd_handler && psd_handler->ReadPtr) {
            cmsIOHANDLER* io_psd = CreateReadIOHandler(fdp, context, 1024);
            if (io_psd) {
                cmsUInt32Number items_read = 0;
                cmsUInt32Number size_of_tag = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 1024);
                void* psd_data = psd_handler->ReadPtr(
                    psd_handler,
                    io_psd,
                    &items_read,
                    size_of_tag
                );
                if (psd_data && psd_handler->FreePtr) {
                    // Data is cmsSEQ*. FreePtr for cmsSigProfileSequenceDescType calls cmsFreeProfileSequenceDescription.
                    psd_handler->FreePtr(psd_handler, psd_data);
                }
                cmsCloseIOhandler(io_psd); // Close the IO handler
            }
        }
    }

    // --- Test 3: _cmsStageAllocLabPrelin ---
    if (fdp.ConsumeBool()) {
        // _cmsStageAllocLabPrelin allocates a stage for Lab prelinearization.
        cmsStage* stage_lab_prelin = _cmsStageAllocLabPrelin(context);
        if (stage_lab_prelin) {
            cmsStageFree(stage_lab_prelin); // Free the allocated stage
        }
    }

    // --- Test 4: Type_Dictionary_Read ---
    if (fdp.ConsumeBool()) {
        cmsTagTypeHandler* dict_handler = _cmsGetTagTypeHandler(context, cmsSigDictType);
        if (dict_handler && dict_handler->ReadPtr) {
            cmsIOHANDLER* io_dict = CreateReadIOHandler(fdp, context, 2048);
            if (io_dict) {
                cmsUInt32Number items_read = 0;
                cmsUInt32Number size_of_tag = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 2048);
                void* dict_data = dict_handler->ReadPtr(
                    dict_handler,
                    io_dict,
                    &items_read,
                    size_of_tag
                );
                if (dict_data && dict_handler->FreePtr) {
                    // Data is cmsHANDLE (cmsDict*). FreePtr for cmsSigDictType calls cmsDictFree.
                    dict_handler->FreePtr(dict_handler, dict_data);
                }
                cmsCloseIOhandler(io_dict); // Close the IO handler
            }
        }
    }

    // --- Test 5: Type_LUT8_Write ---
    if (fdp.ConsumeBool()) {
        cmsTagTypeHandler* lut8_handler = _cmsGetTagTypeHandler(context, cmsSigLut8Type);
        if (lut8_handler && lut8_handler->WritePtr) {
            cmsIOHANDLER* io_lut8_write = CreateWriteIOHandler(context); 
            if (io_lut8_write) {
                cmsUInt32Number input_channels = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, cmsMAXCHANNELS);
                cmsUInt32Number output_channels = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, cmsMAXCHANNELS);
                cmsPipeline* lut_to_write = cmsPipelineAlloc(context, input_channels, output_channels);

                if (lut_to_write) {
                    // Populate with some basic stages to make it a valid LUT8 structure
                    if (input_channels == 3 && output_channels == 3 && fdp.ConsumeBool()) {
                         cmsFloat64Number identity_matrix[9] = {1,0,0, 0,1,0, 0,0,1};
                         cmsStage* matrix_stage = cmsStageAllocMatrix(context, 3, 3, identity_matrix, NULL);
                         if (matrix_stage) { // cmsStageAllocMatrix is unlikely to fail with valid params
                            cmsPipelineInsertStage(lut_to_write, cmsAT_BEGIN, matrix_stage);
                         } 
                    }

                    cmsToneCurve* id_curves_in[cmsMAXCHANNELS];
                    bool prelin_curves_ok = true;
                    for (cmsUInt32Number i = 0; i < input_channels; ++i) {
                        id_curves_in[i] = cmsBuildGamma(context, 1.0); // Identity curve
                        if (!id_curves_in[i]) {
                            prelin_curves_ok = false;
                            // Free already allocated curves before breaking
                            for (cmsUInt32Number k = 0; k < i; ++k) {
                                if(id_curves_in[k]) cmsFreeToneCurve(id_curves_in[k]);
                            }
                            break;
                        }
                    }
                    if (prelin_curves_ok) {
                        cmsStage* prelin_stage = cmsStageAllocToneCurves(context, input_channels, (cmsToneCurve**)id_curves_in); // Cast to cmsToneCurve**
                        if (prelin_stage) {
                            cmsPipelineInsertStage(lut_to_write, cmsAT_END, prelin_stage);
                        }
                    }
                    for (cmsUInt32Number i = 0; i < input_channels; ++i) {
                        if(id_curves_in[i]) cmsFreeToneCurve(id_curves_in[i]); // cmsStageAllocToneCurves dups them
                    }

                    cmsToneCurve* id_curves_out[cmsMAXCHANNELS];
                    bool postlin_curves_ok = true;
                    for (cmsUInt32Number i = 0; i < output_channels; ++i) {
                        id_curves_out[i] = cmsBuildGamma(context, 1.0); // Identity curve
                        if (!id_curves_out[i]) {
                            postlin_curves_ok = false;
                             // Free already allocated curves before breaking
                            for (cmsUInt32Number k = 0; k < i; ++k) {
                                if(id_curves_out[k]) cmsFreeToneCurve(id_curves_out[k]);
                            }
                            break;
                        }
                    }
                     if (postlin_curves_ok) {
                        cmsStage* postlin_stage = cmsStageAllocToneCurves(context, output_channels, (cmsToneCurve**)id_curves_out); // Cast to cmsToneCurve**
                        if (postlin_stage) {
                            cmsPipelineInsertStage(lut_to_write, cmsAT_END, postlin_stage);
                        }
                    }
                    for (cmsUInt32Number i = 0; i < output_channels; ++i) {
                        if(id_curves_out[i]) cmsFreeToneCurve(id_curves_out[i]); // cmsStageAllocToneCurves dups them
                    }
                    
                    // nItems for LUTs is typically 1
                    lut8_handler->WritePtr(
                        lut8_handler,
                        io_lut8_write,
                        lut_to_write,
                        1 // nItems
                    );
                    cmsPipelineFree(lut_to_write); // Free the pipeline
                }
                cmsCloseIOhandler(io_lut8_write); // Close the IO handler
            }
        }
    }

    // Clean up the context
    cmsDeleteContext(context);

    return 0;
}[0m
