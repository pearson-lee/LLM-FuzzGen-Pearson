#include <fuzzer/FuzzedDataProvider.h>
#include <cstddef>
#include <cstdint>
#include <vector>
#include <string>
#include <cstdlib> // For mbstowcs, free, malloc
#include <cstring> // For memset

// Helper to convert std::string to wchar_t*.
// Returns a newly allocated wide string that must be freed by the caller using free().
// Returns nullptr on allocation failure.
// On mbstowcs conversion error, returns an empty wide string L"" (which also needs to be freed).
wchar_t* StringToWchar(const std::string& str) {
    wchar_t* wstr = nullptr;
    size_t wlen = mbstowcs(NULL, str.c_str(), 0);

    if (wlen == (size_t)-1) { // Invalid multibyte sequence
        wstr = (wchar_t*)malloc(sizeof(wchar_t));
        if (wstr) {
            wstr[0] = L'\0';
        }
        return wstr;
    }

    wstr = (wchar_t*)malloc((wlen + 1) * sizeof(wchar_t));
    if (!wstr) {
        return nullptr; // Allocation failure
    }

    size_t written_len = mbstowcs(wstr, str.c_str(), wlen + 1);
    if (written_len == (size_t)-1) {
        free(wstr); // Free the initially allocated buffer
        wstr = (wchar_t*)malloc(sizeof(wchar_t)); // Fallback to L""
        if (wstr) {
            wstr[0] = L'\0';
        }
        return wstr;
    }
    return wstr;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    cmsContext main_context = cmsCreateContext(NULL, NULL);
    if (!main_context) {
        return 0;
    }

    cmsUInt32Number fuzzed_icc_version = fdp.ConsumeIntegral<cmsUInt32Number>();

    // API 1: Dictionary Read
    if (fdp.ConsumeBool()) {
        cmsTagTypeHandler* global_handler = _cmsGetTagTypeHandler(main_context, cmsSigDictType);
        if (global_handler) {
            cmsTagTypeHandler local_handler = *global_handler; 
            local_handler.ContextID = main_context;                 
            local_handler.ICCVersion = fuzzed_icc_version;     

            cmsUInt32Number items_read = 0;
            cmsUInt32Number size_of_tag = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 2048);
            
            size_t dict_data_len = fdp.ConsumeIntegralInRange<size_t>(0, 4096);
            std::vector<uint8_t> dict_data = fdp.ConsumeBytes<uint8_t>(dict_data_len);

            cmsIOHANDLER* io_dict_read = cmsOpenIOhandlerFromMem(main_context, 
                                                                 dict_data.empty() ? NULL : dict_data.data(), 
                                                                 dict_data.size(), "r");
            if (io_dict_read) {
                void* dict_ptr = local_handler.ReadPtr(&local_handler, io_dict_read, &items_read, size_of_tag);
                if (dict_ptr) {
                    local_handler.FreePtr(&local_handler, dict_ptr);
                }
                cmsCloseIOhandler(io_dict_read);
            }
        }
    }
    
    // API 2: Dictionary Write
    if (fdp.ConsumeBool()) {
        cmsHANDLE dict_to_write = cmsDictAlloc(main_context);
        if (dict_to_write) {
            int num_entries = fdp.ConsumeIntegralInRange<int>(0, 5);
            for (int i = 0; i < num_entries; ++i) {
                std::string name_str = fdp.ConsumeRandomLengthString(32);
                std::string value_str = fdp.ConsumeRandomLengthString(32);
                
                wchar_t* w_name = StringToWchar(name_str);
                wchar_t* w_value = StringToWchar(value_str);

                if (w_name && w_value) {
                    cmsDictAddEntry(dict_to_write, w_name, w_value, NULL, NULL);
                }
                free(w_name); 
                free(w_value);
            }

            cmsTagTypeHandler* global_handler = _cmsGetTagTypeHandler(main_context, cmsSigDictType);
            if (global_handler) {
                cmsTagTypeHandler local_handler = *global_handler; 
                local_handler.ContextID = main_context;                 
                local_handler.ICCVersion = fuzzed_icc_version;     

                cmsIOHANDLER* io_dict_write = cmsOpenIOhandlerFromNULL(main_context);
                if (io_dict_write) {
                    local_handler.WritePtr(&local_handler, io_dict_write, dict_to_write, 1);
                    cmsCloseIOhandler(io_dict_write);
                }
            }
            cmsDictFree(dict_to_write);
        }
    }

    // API 3: ProfileSequenceDesc Read
    if (fdp.ConsumeBool()) {
        cmsTagTypeHandler* global_handler = _cmsGetTagTypeHandler(main_context, cmsSigProfileSequenceDescType);
        if (global_handler) {
            cmsTagTypeHandler local_handler = *global_handler; 
            local_handler.ContextID = main_context;                 
            local_handler.ICCVersion = fuzzed_icc_version;     

            cmsUInt32Number items_read_psd = 0;
            cmsUInt32Number size_of_tag_psd = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 2048);
            
            size_t psd_data_len = fdp.ConsumeIntegralInRange<size_t>(0, 4096);
            std::vector<uint8_t> psd_data = fdp.ConsumeBytes<uint8_t>(psd_data_len);

            cmsIOHANDLER* io_psd_read = cmsOpenIOhandlerFromMem(main_context, 
                                                                psd_data.empty() ? NULL : psd_data.data(), 
                                                                psd_data.size(), "r");
            if (io_psd_read) {
                void* psd_ptr = local_handler.ReadPtr(&local_handler, io_psd_read, &items_read_psd, size_of_tag_psd);
                if (psd_ptr) {
                    local_handler.FreePtr(&local_handler, psd_ptr);
                }
                cmsCloseIOhandler(io_psd_read);
            }
        }
    }

    // API 4: MPE Read (using cmsSigLutAtoBType as an example MPE container)
    if (fdp.ConsumeBool()) {
