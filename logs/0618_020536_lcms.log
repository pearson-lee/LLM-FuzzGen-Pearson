// Wrap C header and source file includes in extern "C".
// This ensures that declarations from lcms2_internal.h and definitions from
// the .c files are all processed with C linkage by the C++ compiler.
// This is intended to resolve linker errors by providing local definitions
// for functions not exported by the static library.
extern "C" {
    // lcms2_internal.h declares _cmsStageAllocLabPrelin, _cmsGetTagTypeHandler, etc.
