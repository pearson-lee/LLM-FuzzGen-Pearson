            cmsHPROFILE hP = cmsCreateProfilePlaceholder(context); // cmsCreateProfilePlaceholder takes context
            if (hP) {
                profiles_for_k_curve_local.push_back(hP);
                created_placeholder_profiles.push_back(hP); // Add to global list for cleanup
            } else {
                k_curve_profiles_ok = false; // Failed to create a required profile
                break;
            }
            is_input_data.push_back(fdp.ConsumeBool());
            gammas_data.push_back(fdp.ConsumeFloatingPoint<cmsFloat64Number>());
        }
        
        if (k_curve_profiles_ok && profiles_for_k_curve_local.size() == nProfilesKCurve) {
            cmsUInt32Number k_curve_flags = fdp.ConsumeIntegral<cmsUInt32Number>();
            // _cmsBuildKToneCurve takes context
            cmsToneCurve *tcK = _cmsBuildKToneCurve(context, nGridPoints, nProfilesKCurve,
                                                    tab_data.data(), profiles_for_k_curve_local.data(),
                                                    is_input_data.data(), gammas_data.data(), k_curve_flags);
            if (tcK) {
                // --- API 5: cmsGetToneCurveEstimatedTable (used synergistically here) ---
                // This public API retrieves the estimated table from a tone curve.
                // It tests data access from a created cmsToneCurve object.
                if (fdp.ConsumeBool()) {
                    // The returned pointer is to internal data of tcK and must not be freed by the caller.
                    // It becomes invalid after tcK is freed.
                    (void)cmsGetToneCurveEstimatedTable(tcK); // cmsGetToneCurveEstimatedTable does not take context
                }
                cmsFreeToneCurve(tcK); // cmsFreeToneCurve does not take context
            }
        }
        // Placeholder profiles are cleaned up at the end.
    }

    // --- API 2: _cmsChain2Lab ---
    // This internal API creates a transform to Lab color space using a chain of profiles.
    // It tests transform creation logic and handling of multiple profiles.
    if (fdp.ConsumeBool()) {
        cmsUInt32Number nProfilesChain = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 3); // Number of profiles in the chain.
        std::vector<cmsUInt32Number> intents_data;
        std::vector<cmsHPROFILE> profiles_for_chain_local; // Profiles for this specific call
        std::vector<cmsBool> bpc_data;
        std::vector<cmsFloat64Number> adaptation_data;
        bool chain_profiles_ok = true;

        for (cmsUInt32Number i = 0; i < nProfilesChain; ++i) {
            intents_data.push_back(fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3)); // Intents (0-3)
            cmsHPROFILE hP = cmsCreateProfilePlaceholder(context); // cmsCreateProfilePlaceholder takes context
             if (hP) {
                profiles_for_chain_local.push_back(hP);
                created_placeholder_profiles.push_back(hP); // Add to global list for cleanup
            } else {
                chain_profiles_ok = false; // Failed to create a required profile
                break;
            }
            bpc_data.push_back(fdp.ConsumeBool()); // Black Point Compensation flags
            adaptation_data.push_back(fdp.ConsumeFloatingPoint<cmsFloat64Number>()); // Adaptation states
        }

        if (chain_profiles_ok && profiles_for_chain_local.size() == nProfilesChain) {
            cmsUInt32Number input_colorant = fdp.ConsumeIntegral<cmsUInt32Number>(); // Fuzzed input colorant
            cmsUInt32Number output_colorant = fdp.ConsumeIntegral<cmsUInt32Number>(); // Fuzzed output colorant
            cmsUInt32Number chain_flags = fdp.ConsumeIntegral<cmsUInt32Number>(); // Fuzzed flags

            // _cmsChain2Lab takes context
            cmsHTRANSFORM hTransform = _cmsChain2Lab(context, nProfilesChain, input_colorant, output_colorant,
                                                     intents_data.data(), profiles_for_chain_local.data(),
                                                     bpc_data.data(), adaptation_data.data(), chain_flags);
            if (hTransform) {
                cmsDeleteTransform(hTransform); // cmsDeleteTransform does not take context
            }
        }
        // Placeholder profiles are cleaned up at the end.
    }

    // --- API 3: _cmsStageAllocLabPrelin ---
    // This internal API allocates a Lab prelinearization stage.
    // It tests resource allocation for LUT stages.
    if (fdp.ConsumeBool()) {
        cmsStage *stage = _cmsStageAllocLabPrelin(context); // _cmsStageAllocLabPrelin takes context
        if (stage) {
