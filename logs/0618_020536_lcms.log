            }
        }

        if (chain_profiles_ok && hProfiles_chain_raw.size() == nProfiles_chain) {
            cmsUInt32Number inputColorant = fdp.PickValueInArray({PT_GRAY, PT_RGB, PT_CMYK, PT_Lab});
            cmsUInt32Number outputColorant = PT_Lab; // Fixed to Lab as per function name
            std::vector<cmsUInt32Number> gamutTableData(nProfiles_chain);
            std::vector<cmsBool> lIsLinearData(nProfiles_chain);
            std::vector<cmsFloat64Number> desiredBlackData(nProfiles_chain);
            for (cmsUInt32Number i = 0; i < nProfiles_chain; ++i) {
                gamutTableData[i] = fdp.ConsumeIntegral<cmsUInt32Number>();
                lIsLinearData[i] = fdp.ConsumeBool();
                desiredBlackData[i] = fdp.ConsumeProbability<cmsFloat64Number>();
            }
            cmsUInt32Number dwFlags = fdp.ConsumeIntegral<cmsUInt32Number>();

            CmsTransformUniquePtr transform(
                _cmsChain2Lab(ctx, nProfiles_chain, inputColorant, outputColorant,
                              gamutTableData.data(), hProfiles_chain_raw.data(),
                              lIsLinearData.data(), desiredBlackData.data(), dwFlags)
            );
            // transform is automatically freed.
        }
        // profiles_chain_vec elements are automatically freed.
    }

    // API 3: _cmsReadProfileSequence
    // cmsSEQ* _cmsReadProfileSequence(cmsHPROFILE hProfile)
    if (fdp.ConsumeBool() && fdp.remaining_bytes() > 20) {
        size_t profile_data_size = fdp.ConsumeIntegralInRange<size_t>(20, 2048);
        if (profile_data_size > fdp.remaining_bytes()) profile_data_size = fdp.remaining_bytes();
        std::vector<uint8_t> profile_bytes = fdp.ConsumeBytes<uint8_t>(profile_data_size);
        
        CmsProfileUniquePtr hProf_api3(cmsOpenProfileFromMemTHR(ctx, profile_bytes.data(), profile_bytes.size()));
        if (hProf_api3) {
