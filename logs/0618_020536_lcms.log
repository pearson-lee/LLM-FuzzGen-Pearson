    // Provides the definition for _cmsGetTagTypeHandler and related plugin infrastructure.
    // cmsplugin.c also includes lcms2_internal.h.
    #include "/src/lcms/src/cmsplugin.c"

    // We do NOT include cmstypes.c due to previous C++ compilation errors.
