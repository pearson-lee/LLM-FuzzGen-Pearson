}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    FuzzedDataProvider fdp(data, size);

    cmsContext ctx = cmsCreateContext(nullptr, nullptr);
    if (!ctx) {
        return 0;
    }

    // API 1: _cmsStageAllocLabPrelin (definition now included from cmslut.c)
    if (fdp.ConsumeBool()) {
        cmsStage* stage = _cmsStageAllocLabPrelin(ctx);
        if (stage) {
            cmsStageFree(stage);
        }
    }

    // Fuzzing ProfileSequenceDesc type handling
    // _cmsGetTagTypeHandler (definition now included from cmsplugin.c)
    cmsTagTypeHandler* psd_handler_ptr = _cmsGetTagTypeHandler(ctx, cmsSigProfileSequenceDescType);
    if (psd_handler_ptr && psd_handler_ptr->ReadPtr && psd_handler_ptr->WritePtr && psd_handler_ptr->FreePtr) {
        size_t psd_input_data_size = fdp.ConsumeIntegralInRange<size_t>(0, std::min(fdp.remaining_bytes(), (size_t)10240));
        std::vector<uint8_t> psd_input_bytes = fdp.ConsumeBytes<uint8_t>(psd_input_data_size);
        
        if (!psd_input_bytes.empty()) {
            cmsIOHANDLER* psd_io_read = cmsOpenIOhandlerFromMem(ctx, psd_input_bytes.data(), psd_input_bytes.size(), "r");
            if (psd_io_read) {
                cmsUInt32Number psd_nItems = 0;
                void* psd_data_ptr = psd_handler_ptr->ReadPtr(psd_handler_ptr, psd_io_read, &psd_nItems, (cmsUInt32Number)psd_input_bytes.size());

                if (psd_data_ptr) {
                    std::vector<uint8_t> psd_output_buffer(32768); 
                    cmsIOHANDLER* psd_io_write = cmsOpenIOhandlerFromMem(ctx, psd_output_buffer.data(), psd_output_buffer.size(), "w");
                    if (psd_io_write) {
                        psd_handler_ptr->WritePtr(psd_handler_ptr, psd_io_write, psd_data_ptr, psd_nItems);
                        cmsCloseIOhandler(psd_io_write);
                    }
                    psd_handler_ptr->FreePtr(psd_handler_ptr, psd_data_ptr);
                }
                cmsCloseIOhandler(psd_io_read);
            }
        }
    }

    // Fuzzing Dictionary type handling
    cmsTagTypeHandler* dict_handler_ptr = _cmsGetTagTypeHandler(ctx, cmsSigDictType);
    if (dict_handler_ptr && dict_handler_ptr->ReadPtr && dict_handler_ptr->WritePtr && dict_handler_ptr->FreePtr) {
        size_t dict_input_data_size = fdp.ConsumeIntegralInRange<size_t>(0, std::min(fdp.remaining_bytes(), (size_t)10240));
        std::vector<uint8_t> dict_input_bytes = fdp.ConsumeBytes<uint8_t>(dict_input_data_size);

        if (!dict_input_bytes.empty()) {
            cmsIOHANDLER* dict_io_read = cmsOpenIOhandlerFromMem(ctx, dict_input_bytes.data(), dict_input_bytes.size(), "r");
            if (dict_io_read) {
                cmsUInt32Number dict_nItems = 0;
                void* dict_data_ptr = dict_handler_ptr->ReadPtr(dict_handler_ptr, dict_io_read, &dict_nItems, (cmsUInt32Number)dict_input_bytes.size());

                if (dict_data_ptr) {
                    std::vector<uint8_t> dict_output_buffer(32768);
                    cmsIOHANDLER* dict_io_write = cmsOpenIOhandlerFromMem(ctx, dict_output_buffer.data(), dict_output_buffer.size(), "w");
                    if (dict_io_write) {
                        dict_handler_ptr->WritePtr(dict_handler_ptr, dict_io_write, dict_data_ptr, dict_nItems);
                        cmsCloseIOhandler(dict_io_write);
                    }
                    dict_handler_ptr->FreePtr(dict_handler_ptr, dict_data_ptr);
                }
                cmsCloseIOhandler(dict_io_read);
            }
        }
    }

    cmsDeleteContext(ctx);
    return 0;
}[0m
