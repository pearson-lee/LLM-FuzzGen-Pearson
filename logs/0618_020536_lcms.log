// Helper to create a _cms_typehandler_struct (cmsTagTypeHandler) instance.
// The primary field used by the targeted Read/Dup/Write functions from 'self' is often 'self->ContextID'.
// The actual function pointers (ReadPtr, WritePtr, etc.) within this struct are not strictly
// necessary for these direct calls, as we are calling their implementations directly.
_cms_typehandler_struct create_lcms_type_handler(cmsContext context_id) {
    _cms_typehandler_struct handler;
    // Initialize the handler structure to zero.
    std::memset(&handler, 0, sizeof(_cms_typehandler_struct));
    // Set the context ID, which is used by the type handling functions.
    handler.ContextID = context_id;
    return handler;
}

