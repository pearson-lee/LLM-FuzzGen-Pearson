    for (cmsHPROFILE hP : created_placeholder_profiles) {
        if (hP) {
            cmsCloseProfile(hP); // cmsCloseProfile does not take context
        }
    }
    created_placeholder_profiles.clear();

    // Delete the lcms context at the very end.
    cmsDeleteContext(context); // cmsDeleteContext takes context
    return 0;
