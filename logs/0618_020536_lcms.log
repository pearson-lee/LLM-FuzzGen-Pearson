    // This tests color transformation logic.
    if (profiles_ok && num_profiles > 0 && fdp.ConsumeBool()) {
        // InputColorant and OutputColorant are likely indices or flags for color components.
        // cmsMAXCHANNELS is 16, so 0-15 is a reasonable range.
        cmsUInt32Number input_colorant = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 15);
        cmsUInt32Number output_colorant = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 15);
        std::vector<cmsUInt32Number> intent_data(num_profiles);
        std::vector<cmsBool> bpc_data(num_profiles); // Black Point Compensation flags
        std::vector<cmsFloat64Number> adaptation_data(num_profiles); // Adaptation states (0.0-1.0)

        for (cmsUInt32Number i = 0; i < num_profiles; ++i) {
            intent_data[i] = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3); // Standard rendering intents
            bpc_data[i] = fdp.ConsumeBool();
            adaptation_data[i] = fdp.ConsumeProbability<cmsFloat64Number>();
