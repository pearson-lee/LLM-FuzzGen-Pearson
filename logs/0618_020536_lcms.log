struct ContextDeleter {
    void operator()(cmsContext p) {
        if (p) cmsDeleteContext(p); // Frees the LCMS context
    }
};
using UniqueContext = std::unique_ptr<std::remove_pointer_t<cmsContext>, ContextDeleter>;

// Custom deleter for cmsHPROFILE
// Ensures cmsCloseProfile is called for RAII.
struct ProfileDeleter {
    void operator()(cmsHPROFILE p) {
        if (p) cmsCloseProfile(p); // Closes the LCMS profile handle
