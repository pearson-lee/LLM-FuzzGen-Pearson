        cmsHPROFILE h_profile_seq = h_profile_seq_ptr.get();

        if (h_profile_seq) {
            std::vector<uint8_t> desc_tag_data = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 1024));
            if (!desc_tag_data.empty()) {
                cmsWriteRawTag(h_profile_seq, cmsSigProfileSequenceDescTag, desc_tag_data.data(), desc_tag_data.size());
