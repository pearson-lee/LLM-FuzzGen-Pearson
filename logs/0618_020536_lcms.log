// Helper to ensure gamma values are positive for cmsBuildGamma
double consume_positive_gamma(FuzzedDataProvider& fdp) {
    double gamma = fdp.ConsumeFloatingPointInRange<double>(0.01, 10.0);
    // Ensure gamma is strictly positive, as 0 or negative can be problematic
    if (gamma <= 0) {
        gamma = 1.0;
    }
    return gamma;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a CMS context. All LCMS operations require a context.
    // The context is created once and passed to most LCMS functions.
    // It's deleted at the end of the test case.
    cmsContext context = cmsCreateContext(nullptr, nullptr);
    if (!context) {
        return 0; // Cannot proceed without a context
    }

    // API 1: _cmsStageAllocLabPrelin
    // Allocates a Lab prelinearization stage.
    // This tests a part of the LUT (Look-Up Table) creation/manipulation logic.
    if (fdp.ConsumeBool()) {
        cmsStage* stage = _cmsStageAllocLabPrelin(context);
        if (stage) {
            // The allocated stage must be freed to prevent memory leaks.
            cmsStageFree(context, stage);
        }
    }

    // Prepare common data for _cmsBuildKToneCurve and _cmsChain2Lab: profiles.
    // These functions operate on an array of profiles.
    cmsUInt32Number num_profiles = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3); // 0 to 3 profiles
    std::vector<cmsHPROFILE> hProfiles(num_profiles);
    bool profiles_ok = true;
    if (num_profiles > 0) {
        for (cmsUInt32Number i = 0; i < num_profiles; ++i) {
            // Create simple sRGB profiles for testing. These are commonly used profiles.
            // THR version allows specifying a context.
            hProfiles[i] = cmsCreateSRGBProfileTHR(context);
            if (!hProfiles[i]) {
                // If a profile creation fails, clean up already created ones and stop.
                for (cmsUInt32Number k = 0; k < i; ++k) {
                    if (hProfiles[k]) cmsCloseProfile(context, hProfiles[k]);
                }
                cmsDeleteContext(context);
                profiles_ok = false;
                return 0;
            }
        }
    }


    cmsToneCurve* built_curve = nullptr; // To store curve from _cmsBuildKToneCurve for potential reuse

    // API 2: _cmsBuildKToneCurve
    // Builds a K (black) tone curve, often used in CMYK separations.
    // This function has complex logic involving multiple profiles and parameters.
    if (profiles_ok && num_profiles > 0 && fdp.ConsumeBool()) {
        cmsUInt32Number nGridPoints = fdp.ConsumeIntegralInRange<cmsUInt32Number>(2, 256);
        std::vector<cmsUInt32Number> tab_data(num_profiles);
        std::vector<cmsBool> is_input_data(num_profiles);
        std::vector<cmsFloat64Number> gammas_data(num_profiles);

        for (cmsUInt32Number i = 0; i < num_profiles; ++i) {
            // Tab[i] must be a valid index into hProfiles.
            tab_data[i] = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, num_profiles - 1);
            is_input_data[i] = fdp.ConsumeBool();
            gammas_data[i] = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        }
        cmsUInt32Number dwFlags_curve = fdp.ConsumeIntegral<cmsUInt32Number>();

        built_curve = _cmsBuildKToneCurve(context, nGridPoints, num_profiles,
                                          tab_data.data(), hProfiles.data(),
                                          is_input_data.data(), gammas_data.data(), dwFlags_curve);
        // `built_curve` will be freed later, after potential use in Type_Curve_Dup.
    }

    // API 3: _cmsChain2Lab
    // Creates a transform that chains multiple profiles to convert to Lab color space.
    // This tests color transformation logic.
    if (profiles_ok && num_profiles > 0 && fdp.ConsumeBool()) {
        // InputColorant and OutputColorant are likely indices or flags for color components.
        // cmsMAXCHANNELS is 16, so 0-15 is a reasonable range.
