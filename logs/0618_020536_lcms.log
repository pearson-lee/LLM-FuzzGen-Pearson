        bool ktone_profiles_ok = true;
        for (cmsUInt32Number i = 0; i < nProfiles_ktone; ++i) {
            // Using NULL profiles for simplicity and stability.
            cmsHPROFILE p = cmsCreateNULLProfileTHR(ctx);
            if (p) {
                profiles_ktone_vec.emplace_back(p, CmsProfileDeleter());
                hProfiles_ktone_raw.push_back(p);
            } else {
                ktone_profiles_ok = false;
                break;
            }
