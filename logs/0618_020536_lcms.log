                cmsUInt32Number items_read_dict = 0;
                cmsUInt32Number size_of_tag_dict = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 10000); 
                dict_data_void = Type_Dictionary_Read(&type_handler_instance, io, &items_read_dict, size_of_tag_dict);
                cmsCloseIOhandler(io);
                io = nullptr;
            }
