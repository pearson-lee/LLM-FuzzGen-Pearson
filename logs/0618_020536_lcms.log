            cmsUInt32Number output_colorant = fdp.ConsumeIntegral<cmsUInt32Number>(); 
            cmsUInt32Number chain_flags = fdp.ConsumeIntegral<cmsUInt32Number>(); 

            cmsHTRANSFORM hTransform = _cmsChain2Lab(context, nProfilesChain, input_colorant, output_colorant,
