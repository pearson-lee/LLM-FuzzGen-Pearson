extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Initialize lcms context. This is required by most lcms functions.
    cmsContext ctx = cmsCreateContext(NULL, NULL);
    if (!ctx) {
        return 0; // Cannot proceed without a context.
    }

    // Initialize a _cms_typehandler_struct. This is passed to Type_*_Read/Write functions.
    // It primarily provides ContextID and ICCVersion, which can affect parsing/writing logic.
    _cms_typehandler_struct handler_struct;
    memset(&handler_struct, 0, sizeof(_cms_typehandler_struct));
    handler_struct.ContextID = ctx;
    // Fuzz ICC version, as it can change behavior (e.g., in SaveDescription called by Type_ProfileSequenceDesc_Write)
    handler_struct.ICCVersion = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0x02000000, 0x04400000); // Common ICC versions (e.g., v2.0 to v4.4)

    // API 1: _cmsStageAllocLabPrelin from cmslut.c
    // Tests allocation and deallocation of a specific cmsStage type (Lab prelinearization).
    // This API contributes to functional diversity by targeting LUT manipulation aspects.
    if (fdp.ConsumeBool()) {
        cmsStage* stage = _cmsStageAllocLabPrelin(ctx);
        if (stage) {
            // The stage is allocated. For a more thorough test, one could inspect its properties
            // or use it in a pipeline. Here, we focus on robust alloc/free.
            cmsStageFree(stage); // Memory management: Free the allocated stage.
        }
    }

    cmsSEQ* profile_seq_desc_read_result = nullptr;

    // API 2: Type_ProfileSequenceDesc_Read from cmstypes.c
    // Tests reading a Profile Sequence Descriptor tag, a complex structure.
    // Exercises parsing logic for profile metadata.
    if (fdp.ConsumeBool()) {
        // Consume a portion of fuzzer data for this read operation.
        std::vector<uint8_t> psd_read_data = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, fdp.remaining_bytes() / 3));
        if (!psd_read_data.empty()) {
            cmsIOHANDLER* io_read_psd = cmsOpenIOhandlerFromMem(ctx, (void*)psd_read_data.data(), psd_read_data.size(), "r");
            if (io_read_psd) {
                cmsUInt32Number nItems_psd = 0; // Output parameter, number of items read.
                // SizeOfTag is a hint for the parser, related to the tag data size. Fuzz its value.
                cmsUInt32Number size_of_tag_psd = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, static_cast<cmsUInt32Number>(psd_read_data.size()));
                
                profile_seq_desc_read_result = (cmsSEQ*)Type_ProfileSequenceDesc_Read(&handler_struct, io_read_psd, &nItems_psd, size_of_tag_psd);
                
                cmsCloseIOhandler(io_read_psd); // Memory management: Close IO handler.
                // profile_seq_desc_read_result (if not null) will be freed later to ensure proper resource cleanup.
            }
        }
    }

    // API 3: Type_ProfileSequenceDesc_Write from cmstypes.c
    // Tests writing a Profile Sequence Descriptor tag. This is synergistic with the Read operation.
    // It can use the result from the Read operation or a newly fuzzer-generated one.
    if (fdp.ConsumeBool()) {
        cmsSEQ* seq_to_write = nullptr;
        bool new_seq_allocated_for_write = false;

        // Decide whether to use the previously read sequence (if available and valid) or create a new one.
        if (profile_seq_desc_read_result != nullptr && fdp.ConsumeBool()) {
            seq_to_write = profile_seq_desc_read_result; // Reuse existing data.
        } else {
            // Allocate and populate a new cmsSEQ structure for writing.
            cmsUInt32Number num_desc_entries = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3); // Limit entries to keep it manageable.
            seq_to_write = cmsAllocProfileSequenceDescription(ctx, num_desc_entries);
            if (seq_to_write) {
                new_seq_allocated_for_write = true;
                // Populate the sequence with fuzzed data.
                for (cmsUInt32Number i = 0; i < num_desc_entries; ++i) {
                    seq_to_write->seq[i].deviceMfg = fdp.ConsumeIntegral<cmsUInt32Number>();
                    seq_to_write->seq[i].deviceModel = fdp.ConsumeIntegral<cmsUInt32Number>();
                    seq_to_write->seq[i].attributes = fdp.ConsumeIntegral<cmsUInt64Number>();
                    seq_to_write->seq[i].technology = (cmsTechnologySignature)fdp.ConsumeIntegral<cmsUInt32Number>();
                    
                    // Manufacturer and Model are cmsMLU*. Allocate and populate them with fuzzed strings.
                    seq_to_write->seq[i].Manufacturer = cmsMLUalloc(ctx, 1); 
                    if (seq_to_write->seq[i].Manufacturer) {
                        cmsMLUsetASCII(seq_to_write->seq[i].Manufacturer, fdp.ConsumeBytesAsString(2).c_str(), fdp.ConsumeBytesAsString(2).c_str(), fdp.ConsumeRandomLengthString(10).c_str());
                    }
                    seq_to_write->seq[i].Model = cmsMLUalloc(ctx, 1);
                     if (seq_to_write->seq[i].Model) {
                        cmsMLUsetASCII(seq_to_write->seq[i].Model, fdp.ConsumeBytesAsString(2).c_str(), fdp.ConsumeBytesAsString(2).c_str(), fdp.ConsumeRandomLengthString(10).c_str());
                    }
                }
            }
        }

        if (seq_to_write) {
            // Prepare a buffer for the write operation.
            size_t write_buffer_size = fdp.ConsumeIntegralInRange<size_t>(128, 2048); // Reasonable buffer size for writing.
            std::vector<uint8_t> write_buffer(write_buffer_size);
            cmsIOHANDLER* io_write_psd = cmsOpenIOhandlerFromMem(ctx, write_buffer.data(), write_buffer.size(), "w");
            if (io_write_psd) {
                // nItems for Write is typically 1 for the entire sequence object.
                Type_ProfileSequenceDesc_Write(&handler_struct, io_write_psd, seq_to_write, 1);
                cmsCloseIOhandler(io_write_psd); // Memory management: Close IO handler.
            }

            if (new_seq_allocated_for_write) {
                // If we allocated this sequence specifically for writing, free its components and itself.
                for (cmsUInt32Number i = 0; i < seq_to_write->n; ++i) {
                    if (seq_to_write->seq[i].Manufacturer) cmsMLUfree(seq_to_write->seq[i].Manufacturer); // Free MLU
                    if (seq_to_write->seq[i].Model) cmsMLUfree(seq_to_write->seq[i].Model); // Free MLU
                }
                cmsFreeProfileSequenceDescription(seq_to_write); // Memory management: Free the allocated sequence.
            }
        }
    }

    // Free the result from Type_ProfileSequenceDesc_Read if it was allocated.
    // This handles cases where it wasn't used by Write, or if Write used it without taking ownership for freeing.
    if (profile_seq_desc_read_result) {
        cmsFreeProfileSequenceDescription(profile_seq_desc_read_result); // Memory management.
    }

    // API 4: Type_Dictionary_Read from cmstypes.c
    // Tests reading a Dictionary tag, another type of complex metadata structure.
    if (fdp.ConsumeBool()) {
        std::vector<uint8_t> dict_read_data = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, fdp.remaining_bytes() / 2));
        if (!dict_read_data.empty()) {
            cmsIOHANDLER* io_read_dict = cmsOpenIOhandlerFromMem(ctx, (void*)dict_read_data.data(), dict_read_data.size(), "r");
            if (io_read_dict) {
                cmsUInt32Number nItems_dict = 0; // Output parameter.
                cmsUInt32Number size_of_tag_dict = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, static_cast<cmsUInt32Number>(dict_read_data.size()));
                
                cmsDICT* dict = (cmsDICT*)Type_Dictionary_Read(&handler_struct, io_read_dict, &nItems_dict, size_of_tag_dict);
                
                cmsCloseIOhandler(io_read_dict); // Memory management.
                if (dict) {
                    cmsDictFree(dict); // Memory management: Free the dictionary using the specific plugin API.
                }
            }
        }
    }

    // API 5: Type_vcgt_Read from cmstypes.c
    // Tests reading a Video Card Gamma Table (vcgt) tag, which often involves arrays of tone curves.
    if (fdp.ConsumeBool()) {
