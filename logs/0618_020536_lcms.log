    cmsUInt32Number psd_items_read = 0;

    if (io_psd_read) {
        cmsUInt32Number psd_size_of_tag = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, static_cast<cmsUInt32Number>(psd_io_data.size()));
        if (fdp.ConsumeBool()) {
            psd_ptr = Type_ProfileSequenceDesc_Read(&type_handler, io_psd_read, &psd_items_read, psd_size_of_tag);
