// Helper for string conversion
static std::wstring StringToWString(const std::string& str) {
    std::wstring_convert<std::codecvt_utf8_utf16<wchar_t>> converter;
    try {
        return converter.from_bytes(str);
    } catch (const std::range_error& e) {
        return L""; // Return empty or default on error
    }
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    cmsContext context = cmsCreateContext(nullptr, nullptr);
    if (!context) {
        return 0;
    }

    std::vector<cmsHPROFILE> created_placeholder_profiles;

    // --- API 1: _cmsBuildKToneCurve ---
    if (fdp.ConsumeBool()) {
        cmsUInt32Number nGridPoints = fdp.ConsumeIntegralInRange<cmsUInt32Number>(2, 100);
        cmsUInt32Number nProfilesKCurve = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 3);

        std::vector<cmsUInt32Number> tab_data;
        std::vector<cmsHPROFILE> profiles_for_k_curve_local;
        std::vector<cmsBool> is_input_data;
        std::vector<cmsFloat64Number> gammas_data;
        bool k_curve_profiles_ok = true;

        for (cmsUInt32Number i = 0; i < nProfilesKCurve; ++i) {
            tab_data.push_back(fdp.ConsumeIntegral<cmsUInt32Number>());
            cmsHPROFILE hP = cmsCreateProfilePlaceholder(context);
            if (hP) {
                profiles_for_k_curve_local.push_back(hP);
                created_placeholder_profiles.push_back(hP);
            } else {
                k_curve_profiles_ok = false;
                break;
            }
            is_input_data.push_back(fdp.ConsumeBool());
            gammas_data.push_back(fdp.ConsumeFloatingPoint<cmsFloat64Number>());
        }

        if (k_curve_profiles_ok && profiles_for_k_curve_local.size() == nProfilesKCurve && nProfilesKCurve > 0) {
            // Coverage: Ensure profiles have CMYK color space and last profile is OutputClass
            // to pass initial checks in _cmsBuildKToneCurve (lines 151-156 in cmslut.c).
            cmsSetColorSpace(profiles_for_k_curve_local[0], cmsSigCmykData);
            cmsSetColorSpace(profiles_for_k_curve_local[nProfilesKCurve-1], cmsSigCmykData);
            cmsSetDeviceClass(profiles_for_k_curve_local[nProfilesKCurve-1], cmsSigOutputClass);

            cmsUInt32Number k_curve_flags = fdp.ConsumeIntegral<cmsUInt32Number>();
            cmsToneCurve *tcK = _cmsBuildKToneCurve(context, nGridPoints, nProfilesKCurve,
                                                    tab_data.data(), profiles_for_k_curve_local.data(),
                                                    is_input_data.data(), gammas_data.data(), k_curve_flags);
            if (tcK) {
                if (fdp.ConsumeBool()) {
                    (void)cmsGetToneCurveEstimatedTable(tcK);
                }
                cmsFreeToneCurve(tcK);
            }
        }
    }

    // --- API 2: _cmsChain2Lab ---
    if (fdp.ConsumeBool()) {
        cmsUInt32Number nProfilesChain = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 3);
        std::vector<cmsUInt32Number> intents_data;
        std::vector<cmsHPROFILE> profiles_for_chain_local;
        std::vector<cmsBool> bpc_data;
        std::vector<cmsFloat64Number> adaptation_data;
        bool chain_profiles_ok = true;

        for (cmsUInt32Number i = 0; i < nProfilesChain; ++i) {
            intents_data.push_back(fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3));
            cmsHPROFILE hP = cmsCreateProfilePlaceholder(context);
             if (hP) {
                profiles_for_chain_local.push_back(hP);
                created_placeholder_profiles.push_back(hP);

                // Coverage: Set profile version to V4 sometimes for _cmsLinkProfiles line 1132 (cmsccnvrt.c).
                if (fdp.ConsumeBool()) {
                    cmsSetProfileVersion(hP, 4.3);
                } else {
                    cmsSetProfileVersion(hP, 2.1);
                }

                // Coverage: Write colorant and TRC tags for the first profile to help _cmsReadInputLUT
                // succeed, which is called by DefaultICCintents (cmscnvrt.c).
                if (i == 0) {
                    cmsCIEXYZ colorant_data;
                    colorant_data.X = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
                    colorant_data.Y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
                    colorant_data.Z = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
                    cmsWriteTag(hP, cmsSigRedColorantTag, &colorant_data);
                    colorant_data.X = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
                    colorant_data.Y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
                    colorant_data.Z = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
                    cmsWriteTag(hP, cmsSigGreenColorantTag, &colorant_data);
                    colorant_data.X = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
                    colorant_data.Y = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
                    colorant_data.Z = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
                    cmsWriteTag(hP, cmsSigBlueColorantTag, &colorant_data);

                    cmsToneCurve* trc = cmsBuildGamma(context, fdp.ConsumeFloatingPointInRange<double>(0.1, 3.0));
                    if (trc) {
                        cmsWriteTag(hP, cmsSigRedTRCTag, trc);
                        cmsWriteTag(hP, cmsSigGreenTRCTag, trc); // Can reuse for simplicity or fuzz different ones
                        cmsWriteTag(hP, cmsSigBlueTRCTag, trc);
                        cmsFreeToneCurve(trc); // cmsWriteTag duplicates the data
                    }
                }

            } else {
                chain_profiles_ok = false;
                break;
            }
            bpc_data.push_back(fdp.ConsumeBool());
            adaptation_data.push_back(fdp.ConsumeFloatingPoint<cmsFloat64Number>());
        }

        if (chain_profiles_ok && profiles_for_chain_local.size() == nProfilesChain) {
            cmsUInt32Number input_colorant = fdp.ConsumeIntegral<cmsUInt32Number>();
            cmsUInt32Number output_colorant = fdp.ConsumeIntegral<cmsUInt32Number>();
            cmsUInt32Number chain_flags = fdp.ConsumeIntegral<cmsUInt32Number>();

            // Coverage: Add cmsFLAGS_NONEGATIVES to hit uncovered branch in DefaultICCintents (cmscnvrt.c line 627)
            if (fdp.ConsumeBool()) {
                chain_flags |= cmsFLAGS_NONEGATIVES;
            }

            cmsHTRANSFORM hTransform = _cmsChain2Lab(context, nProfilesChain, input_colorant, output_colorant,
                                                     intents_data.data(), profiles_for_chain_local.data(),
                                                     bpc_data.data(), adaptation_data.data(), chain_flags);
            if (hTransform) {
                cmsDeleteTransform(hTransform);
            }
        }
    }

    // --- API for _cmsHandleExtraChannels coverage (via cmsDoTransform) ---
    // Goal: Improve coverage in _cmsHandleExtraChannels (cmsxform.c lines 558-648)
    // Strategy: Call cmsCreateTransform with formats having extra channels and cmsFLAGS_COPY_ALPHA.
    // Then call cmsDoTransform.
    if (fdp.ConsumeBool()) {
        cmsHPROFILE hInput = cmsCreateProfilePlaceholder(context);
        cmsHPROFILE hOutput = cmsCreateProfilePlaceholder(context);
        if (hInput && hOutput) {
            // Add profiles to cleanup list; cmsCloseProfile handles freeing.
            created_placeholder_profiles.push_back(hInput);
            created_placeholder_profiles.push_back(hOutput);

            cmsUInt32Number input_cs_enum = fdp.PickValueInArray<cmsUInt32Number>({PT_CMYK, PT_RGB, PT_GRAY});
            cmsUInt32Number output_cs_enum = fdp.PickValueInArray<cmsUInt32Number>({PT_CMYK, PT_RGB, PT_GRAY});
            
            cmsUInt32Number bytes_in_idx = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 2); // 0: float, 1: 8-bit, 2: 16-bit
            cmsUInt32Number bytes_out_idx = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 2);

            cmsUInt32Number extra_channels = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 2); // Target nExtra > 0

            cmsUInt32Number channels_in = 0;
            switch (input_cs_enum) {
                case PT_CMYK: channels_in = 4; break;
                case PT_RGB: channels_in = 3; break;
                case PT_GRAY: channels_in = 1; break;
            }
            cmsUInt32Number channels_out = 0;
            switch (output_cs_enum) {
                case PT_CMYK: channels_out = 4; break;
                case PT_RGB: channels_out = 3; break;
                case PT_GRAY: channels_out = 1; break;
            }

            if (channels_in > 0 && channels_out > 0) {
                cmsUInt32Number input_format = COLORSPACE_SH(input_cs_enum) | CHANNELS_SH(channels_in) | EXTRA_SH(extra_channels);
                cmsUInt32Number output_format = COLORSPACE_SH(output_cs_enum) | CHANNELS_SH(channels_out) | EXTRA_SH(extra_channels); // Ensure T_EXTRA(in) == T_EXTRA(out)

                if (bytes_in_idx == 0) input_format |= FLOAT_SH(1) | BYTES_SH(0); // Float
                else input_format |= BYTES_SH(bytes_in_idx); // 1 for 8-bit, 2 for 16-bit

                if (bytes_out_idx == 0) output_format |= FLOAT_SH(1) | BYTES_SH(0); // Float
                else output_format |= BYTES_SH(bytes_out_idx); // 1 for 8-bit, 2 for 16-bit
                
                // Ensure input and output base types are compatible for _cmsGetFormatterAlpha
                if (fdp.ConsumeBool()) { // Sometimes make byte depths the same
                    if (bytes_in_idx == 0) output_format = (output_format & ~(BYTES_SH(3)|FLOAT_SH(1))) | FLOAT_SH(1) | BYTES_SH(0);
                    else output_format = (output_format & ~(BYTES_SH(3)|FLOAT_SH(1))) | BYTES_SH(bytes_in_idx);
                }


                cmsUInt32Number transform_flags = cmsFLAGS_COPY_ALPHA; // Essential for _cmsHandleExtraChannels
                if (fdp.ConsumeBool()) transform_flags |= cmsFLAGS_NOCACHE;

                cmsHTRANSFORM hTransform = cmsCreateTransform(hInput, input_format,
                                                              hOutput, output_format,
                                                              INTENT_PERCEPTUAL, transform_flags);
                // cmsCreateTransform is memory safe; hTransform needs cmsDeleteTransform.
                // hInput, hOutput are added to created_placeholder_profiles.
                if (hTransform) {
                    size_t bytes_per_sample_in = T_BYTES(input_format);
                    if (T_FLOAT(input_format) && bytes_per_sample_in == 0) bytes_per_sample_in = sizeof(float); 
                    else if (bytes_per_sample_in == 0) bytes_per_sample_in = 1; 


                    size_t bytes_per_pixel_in = (channels_in + extra_channels) * bytes_per_sample_in;

                    size_t bytes_per_sample_out = T_BYTES(output_format);
                     if (T_FLOAT(output_format) && bytes_per_sample_out == 0) bytes_per_sample_out = sizeof(float);
                    else if (bytes_per_sample_out == 0) bytes_per_sample_out = 1;


                    size_t bytes_per_pixel_out = (channels_out + extra_channels) * bytes_per_sample_out;
                    
                    if (bytes_per_pixel_in > 0 && bytes_per_pixel_out > 0) { // Avoid division by zero if channels somehow become 0
                        size_t num_pixels = fdp.ConsumeIntegralInRange<size_t>(1, 10);
                        std::vector<uint8_t> in_buf_data(num_pixels * bytes_per_pixel_in);
                        std::vector<uint8_t> out_buf_data(num_pixels * bytes_per_pixel_out);
                        fdp.ConsumeData(in_buf_data.data(), in_buf_data.size());

                        cmsDoTransform(hTransform, in_buf_data.data(), out_buf_data.data(), num_pixels);
                    }
                    cmsDeleteTransform(hTransform); 
                }
            }
        }
    }


    // --- API 4: cmsReadTag ---
    // Original path with random profile data
    if (fdp.ConsumeBool()) {
        size_t profile_data_size = fdp.ConsumeIntegralInRange<size_t>(10, 2048);
        profile_data_size = std::min(profile_data_size, fdp.remaining_bytes());
        std::vector<uint8_t> profile_data_vec = fdp.ConsumeBytes<uint8_t>(profile_data_size);

        cmsHPROFILE hProfileForTag = cmsOpenProfileFromMem(profile_data_vec.data(), profile_data_vec.size());

        if (hProfileForTag) {
            if (fdp.ConsumeBool()) {
                cmsSEQ *seq = (cmsSEQ *)cmsReadTag(hProfileForTag, cmsSigProfileSequenceDescTag);
                if (seq) {
                    // Data from cmsReadTag is owned by the profile; do not free here.
                }
            }

            if (fdp.ConsumeBool()) {
                cmsUcrBg *ucrbg = (cmsUcrBg *)cmsReadTag(hProfileForTag, cmsSigUcrBgTag);
                if (ucrbg) {
                    // Data from cmsReadTag is owned by the profile.
                }
            }
            cmsCloseProfile(hProfileForTag);
        }
    }

    // Added path: Write known tags then read them to improve cmsReadTag coverage,
    // especially for IsTypeSupported checks (cmsio1.c line 1713).
    if (fdp.ConsumeBool()) {
        cmsHPROFILE hProfileForTagWriteRead = cmsCreateProfilePlaceholder(context);
        if (hProfileForTagWriteRead) {
            created_placeholder_profiles.push_back(hProfileForTagWriteRead);

            // Test cmsSigProfileSequenceDescTag
            if (fdp.ConsumeBool()) {
                cmsSEQ* seq_write = cmsAllocProfileSequenceDescription(context, 1);
                if (seq_write) {
                    seq_write->seq[0].deviceMfg = fdp.ConsumeIntegral<cmsUInt32Number>();
                    seq_write->seq[0].deviceModel = fdp.ConsumeIntegral<cmsUInt32Number>();
                    seq_write->seq[0].attributes = fdp.ConsumeIntegral<cmsUInt64Number>();
                    for (int k=0; k < 16; ++k) {
                        seq_write->seq[0].ProfileID.ID8[k] = fdp.ConsumeIntegral<uint8_t>();
                    }

                    seq_write->seq[0].Description = cmsMLUalloc(context, 1);
                    if (seq_write->seq[0].Description) {
                        cmsMLUsetWide(seq_write->seq[0].Description, "en", "US", StringToWString(fdp.ConsumeRandomLengthString(20)).c_str());
                    }
                    seq_write->seq[0].Manufacturer = cmsMLUalloc(context, 1);
                    if (seq_write->seq[0].Manufacturer) {
                         cmsMLUsetWide(seq_write->seq[0].Manufacturer, "en", "US", StringToWString(fdp.ConsumeRandomLengthString(10)).c_str());
                    }
                    seq_write->seq[0].Model = cmsMLUalloc(context, 1);
                    if (seq_write->seq[0].Model) {
                        cmsMLUsetWide(seq_write->seq[0].Model, "en", "US", StringToWString(fdp.ConsumeRandomLengthString(10)).c_str());
                    }

                    if (cmsWriteTag(hProfileForTagWriteRead, cmsSigProfileSequenceDescTag, seq_write)) {
                        cmsSEQ *seq_read = (cmsSEQ *)cmsReadTag(hProfileForTagWriteRead, cmsSigProfileSequenceDescTag);
                        if (seq_read) {
                            // Data from cmsReadTag is owned by the profile.
                        }
                    }
                    // cmsWriteTag duplicates the data, so we must free what we allocated.
                    cmsFreeProfileSequenceDescription(seq_write);
                }
            }

            // Test cmsSigUcrBgTag
            if (fdp.ConsumeBool()) {
                cmsUcrBg* ucrbg_write = (cmsUcrBg*)_cmsMalloc(context, sizeof(cmsUcrBg));
                if (ucrbg_write) {
                    // Initialize to NULL to prevent freeing uninitialized pointers in case of partial allocation
                    ucrbg_write->Ucr = NULL;
                    ucrbg_write->Bg = NULL;
                    ucrbg_write->Desc = NULL;

                    ucrbg_write->Ucr = cmsBuildGamma(context, fdp.ConsumeFloatingPointInRange<double>(0.1, 3.0));
