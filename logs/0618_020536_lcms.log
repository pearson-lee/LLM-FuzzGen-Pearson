    std::memset(&handler, 0, sizeof(cmsTagTypeHandler));
    handler.ContextID = context_id; // cmsContext is a pointer type, direct assignment is fine.
    return handler;
}

// LLVMFuzzerTestOneInput is the C entry point for the fuzzer.
