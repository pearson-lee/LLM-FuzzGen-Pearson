        std::string obj_name = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 32));
        cJSON_AddNullToObject(root_object.get(), obj_name.c_str());
        cJSON_AddTrueToObject(root_object.get(), obj_name.c_str());
        cJSON_AddFalseToObject(root_object.get(), obj_name.c_str());
        cJSON_AddBoolToObject(root_object.get(), obj_name.c_str(), fdp.ConsumeBool());
        cJSON_AddNumberToObject(root_object.get(), obj_name.c_str(), fdp.ConsumeFloatingPoint<double>());
        cJSON_AddStringToObject(root_object.get(), obj_name.c_str(), fdp.ConsumeRandomLengthString(64).c_str());
