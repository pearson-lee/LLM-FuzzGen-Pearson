            cJSON_HasObjectItem(root_object.get(), key_c_str);
            cJSON_free(key_c_str); // Free immediately
        }
    }

    // Fuzzing cJSON_AddItemToObjectCS
    {
        // Added call to cJSON_AddItemToObjectCS to cover case-sensitive item addition.
