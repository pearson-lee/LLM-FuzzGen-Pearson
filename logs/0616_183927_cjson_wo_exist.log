    // Coverage Rationale: Targets uncovered cJSON_Minify.
    if (printed_unformatted_str) { // Use the string from cJSON_PrintUnformatted
        size_t len = strlen(printed_unformatted_str);
        minifiable_json_string = (char*)malloc(len + 1); 
