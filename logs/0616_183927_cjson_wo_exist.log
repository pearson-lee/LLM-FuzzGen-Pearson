        std::unique_ptr<cJSON, CJSONDeleter> original_object(cJSON_CreateObject());
        if (original_object) {
            std::unique_ptr<cJSON, CJSONDeleter> object_ref(cJSON_CreateObjectReference(original_object.get()));
