                    std::unique_ptr<cJSON, decltype(&SafeCJSONDelete)> duplicated_non_recursive_ptr(duplicated_non_recursive, &SafeCJSONDelete);
                }

                // Document: Test cJSON_Duplicate with a cJSON_StringIsConst item (via reference).
                std::string const_str_val = fdp.ConsumeRandomLengthString(std::min((size_t)64, fdp.remaining_bytes()));
                cJSON* const_str_item = cJSON_CreateStringReference(const_str_val.c_str());
                std::unique_ptr<cJSON, decltype(&SafeCJSONDelete)> const_str_item_ptr(const_str_item, &SafeCJSONDelete);
                if (const_str_item != nullptr) {
                    cJSON* duplicated_const_str = cJSON_Duplicate(const_str_item, true);
                    std::unique_ptr<cJSON, decltype(&SafeCJSONDelete)> duplicated_const_str_ptr(duplicated_const_str, &SafeCJSONDelete);
                }

