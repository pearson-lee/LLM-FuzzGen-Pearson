            case 10: { // New operation: cJSON_Duplicate
                // Document: Added to cover cJSON_Duplicate branches.
                cJSON* original_item = nullptr;
                uint8_t item_type = fdp.ConsumeIntegralInRange<uint8_t>(0, 2); // 0: object, 1: array, 2: string

                if (item_type == 0) { // Create a fuzzed object
