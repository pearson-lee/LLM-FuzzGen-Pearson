            managed_strings.emplace_back(name_c_str); // Add to our managed list

            std::unique_ptr<cJSON, CJSONDeleter> item_to_add(cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>()));
            if (item_to_add) {
