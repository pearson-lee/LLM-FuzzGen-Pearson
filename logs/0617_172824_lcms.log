#include "/src/lcms/include/lcms2_plugin.h"
#include "/src/lcms/src/lcms2_internal.h" // For internal functions if needed

// Define a custom deleter for cmsHPROFILE to ensure proper deallocation
struct ProfileDeleter {
    void operator()(cmsHPROFILE p) const {
        if (p) {
            cmsCloseProfile(p);
        }
    }
};

// Define a custom deleter for cmsHTRANSFORM to ensure proper deallocation
struct TransformDeleter {
    void operator()(cmsHTRANSFORM t) const {
        if (t) {
            cmsDeleteTransform(t);
        }
    }
};

// Define a custom deleter for cmsContext to ensure proper deallocation
struct ContextDeleter {
    void operator()(cmsContext ctx) const {
        if (ctx) {
            cmsDeleteContext(ctx);
        }
    }
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Fuzzing cmsDupContext
    // This function duplicates a context, which can be useful for testing
    // context-specific behaviors and memory management.
    {
        // Create a base context. cmsCreateContext can return NULL, so check it.
        std::unique_ptr<void, ContextDeleter> base_context(cmsCreateContext(NULL, NULL));
        if (base_context) {
            // Duplicate the context with some random user data
            std::vector<uint8_t> user_data_vec = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(0, 128));
            std::unique_ptr<void, ContextDeleter> duplicated_context(cmsDupContext(static_cast<cmsContext>(base_context.get()), user_data_vec.empty() ? nullptr : user_data_vec.data()));
            // The unique_ptr will handle deletion of duplicated_context
        }
    }

    // Fuzzing cmsCreateRGBProfile
    // This function creates an RGB profile, which involves several color-related parameters.
    {
        cmsCIExyY whitePoint;
        whitePoint.x = fdp.ConsumeFloatingPoint<double>();
        whitePoint.y = fdp.ConsumeFloatingPoint<double>();
        whitePoint.Y = fdp.ConsumeFloatingPoint<double>();

        cmsCIExyYTRIPLE primaries;
        primaries.Red.x = fdp.ConsumeFloatingPoint<double>();
        primaries.Red.y = fdp.ConsumeFloatingPoint<double>();
        primaries.Red.Y = fdp.ConsumeFloatingPoint<double>();
        primaries.Green.x = fdp.ConsumeFloatingPoint<double>();
        primaries.Green.y = fdp.ConsumeFloatingPoint<double>();
        primaries.Green.Y = fdp.ConsumeFloatingPoint<double>();
        primaries.Blue.x = fdp.ConsumeFloatingPoint<double>();
        primaries.Blue.y = fdp.ConsumeFloatingPoint<double>();
        primaries.Blue.Y = fdp.ConsumeFloatingPoint<double>();

        // Tone curves can be complex. For fuzzing, we can create simple linear curves or NULL.
        cmsToneCurve* transferFunction[3] = {nullptr, nullptr, nullptr};
        if (fdp.ConsumeBool()) {
            transferFunction[0] = cmsBuildGamma(NULL, fdp.ConsumeFloatingPoint<double>());
        }
        if (fdp.ConsumeBool()) {
            transferFunction[1] = cmsBuildGamma(NULL, fdp.ConsumeFloatingPoint<double>());
        }
        if (fdp.ConsumeBool()) {
            transferFunction[2] = cmsBuildGamma(NULL, fdp.ConsumeFloatingPoint<double>());
        }

        // Create the RGB profile
        std::unique_ptr<void, ProfileDeleter> rgb_profile(cmsCreateRGBProfile(&whitePoint, &primaries, transferFunction));

        // Clean up tone curves
        for (int i = 0; i < 3; ++i) {
            if (transferFunction[i]) {
                cmsFreeToneCurve(transferFunction[i]);
            }
        }
    }

    // Fuzzing cmsCreateProofingTransform
    // This function creates a proofing transform, which is critical for color management workflows.
    {
        // Create dummy profiles for input, output, and proofing.
        // In a real scenario, these would be valid profiles. For fuzzing,
        // we'll create minimal valid profiles or use nullptr to test error paths.
        std::unique_ptr<void, ProfileDeleter> input_profile(cmsCreate_sRGBProfile());
        std::unique_ptr<void, ProfileDeleter> output_profile(cmsCreate_sRGBProfile());
        std::unique_ptr<void, ProfileDeleter> proofing_profile(cmsCreate_sRGBProfile());

        cmsUInt32Number inputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
        cmsUInt32Number outputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
        cmsUInt32Number nIntent = fdp.ConsumeIntegral<cmsUInt32Number>();
        cmsUInt32Number proofingIntent = fdp.ConsumeIntegral<cmsUInt32Number>();
        cmsUInt32Number dwFlags = fdp.ConsumeIntegral<cmsUInt32Number>();

        // Call the target function
        std::unique_ptr<void, TransformDeleter> proofing_transform(
            cmsCreateProofingTransform(
                static_cast<cmsHPROFILE>(input_profile.get()), inputFormat,
                static_cast<cmsHPROFILE>(output_profile.get()), outputFormat,
                static_cast<cmsHPROFILE>(proofing_profile.get()), nIntent,
                proofingIntent, dwFlags
            )
        );
    }

    // Fuzzing cmsOpenProfileFromStream and cmsSaveProfileToStream
    // These functions handle profile I/O, which is a common source of vulnerabilities.
    {
        // Create a temporary file for testing stream operations
        char filename[] = "/tmp/fuzz_profile_XXXXXX";
        int fd = mkstemp(filename);
        if (fd != -1) {
            FILE* fp = fdopen(fd, "w+b");
            if (fp) {
                // Create a dummy profile to save
                std::unique_ptr<void, ProfileDeleter> profile_to_save(cmsCreate_sRGBProfile());
                if (profile_to_save) {
                    // Save the profile to the stream
