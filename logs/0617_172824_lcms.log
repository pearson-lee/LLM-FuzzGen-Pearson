extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // cmsContext for managing memory and plugins.
    // Using std::unique_ptr with a custom deleter for automatic memory management.
    std::unique_ptr<_cmsContext_struct, ContextDeleter> context(cmsDupContext(nullptr, nullptr));
    if (!context) {
        return 0; // Unable to create context, nothing to do.
    }

    // API 1: cmsCreateRGBProfile
    // This function creates an RGB color profile. It's a good candidate as it involves
    // color space definitions and tone curves, which can have complex interactions.
    // It also allows us to exercise the cmsToneCurve and cmsCIExyY structures.
    {
        cmsCIExyY whitePoint;
        whitePoint.x = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        whitePoint.y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        whitePoint.Y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();

        cmsCIExyYTRIPLE primaries;
        primaries.Red.x = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Red.y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Red.Y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Green.x = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Green.y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Green.Y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Blue.x = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Blue.y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Blue.Y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();

        // Create tone curves. We'll create simple gamma curves for fuzzing.
        // Using std::unique_ptr with a custom deleter for automatic memory management.
        std::unique_ptr<cmsToneCurve, ToneCurveDeleter> toneCurveR(cmsBuildGamma(context.get(), fdp.ConsumeFloatingPoint<cmsFloat64Number>()));
        std::unique_ptr<cmsToneCurve, ToneCurveDeleter> toneCurveG(cmsBuildGamma(context.get(), fdp.ConsumeFloatingPoint<cmsFloat64Number>()));
        std::unique_ptr<cmsToneCurve, ToneCurveDeleter> toneCurveB(cmsBuildGamma(context.get(), fdp.ConsumeFloatingPoint<cmsFloat64Number>()));

        cmsToneCurve* transferFunction[3] = {toneCurveR.get(), toneCurveG.get(), toneCurveB.get()};

        // Call the target API
        // Using std::unique_ptr with a custom deleter for automatic memory management.
        std::unique_ptr<void, ProfileDeleter> rgbProfile(cmsCreateRGBProfile(&whitePoint, &primaries, transferFunction));
    }

    // API 2: cmsCreateProofingTransform
    // This function creates a color transform for proofing. It's complex as it involves
    // multiple profiles and intents, providing good opportunities for diverse input combinations.
    {
        // Create dummy profiles for the transform. In a real scenario, these would be loaded from files.
        // For fuzzing, we can create simple sRGB profiles.
        // Using std::unique_ptr with a custom deleter for automatic memory management.
        std::unique_ptr<void, ProfileDeleter> inputProfile(cmsCreate_sRGBProfile());
        std::unique_ptr<void, ProfileDeleter> outputProfile(cmsCreate_sRGBProfile());
        std::unique_ptr<void, ProfileDeleter> proofingProfile(cmsCreate_sRGBProfile());

        if (inputProfile && outputProfile && proofingProfile) {
            cmsUInt32Number inputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
            cmsUInt32Number outputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
            cmsUInt32Number nIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3); // Intents are usually 0-3
            cmsUInt32Number proofingIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
            cmsUInt32Number dwFlags = fdp.ConsumeIntegral<cmsUInt32Number>();

            // Call the target API
            // Using std::unique_ptr with a custom deleter for automatic memory management.
            std::unique_ptr<void, TransformDeleter> proofingTransform(cmsCreateProofingTransform(
                inputProfile.get(), inputFormat,
                outputProfile.get(), outputFormat,
                proofingProfile.get(), nIntent, proofingIntent, dwFlags));
        }
    }

    // API 3 & 4: cmsOpenProfileFromStream and cmsSaveProfileToStream
    // These functions handle profile I/O from/to streams. Fuzzing them with various
    // data can expose parsing and serialization issues.
    {
        // Create a dummy profile to save and then open.
        // Using std::unique_ptr with a custom deleter for automatic memory management.
        std::unique_ptr<void, ProfileDeleter> profileToSave(cmsCreate_sRGBProfile());
        if (profileToSave) {
            // Create a temporary file for stream operations
            char filename[] = "/tmp/fuzz_profile_XXXXXX";
            int fd = mkstemp(filename);
            if (fd != -1) {
                FILE* fp = fdopen(fd, "w+b");
                if (fp) {
                    // Save the profile to the stream
                    cmsSaveProfileToStream(profileToSave.get(), fp);

                    // Rewind the file pointer to read from the beginning
                    fseek(fp, 0, SEEK_SET);

                    // Open the profile from the stream
                    // cmsOpenProfileFromStream takes ownership of fp and closes it.
                    std::unique_ptr<void, ProfileDeleter> openedProfile(cmsOpenProfileFromStream(fp, "r"));
                }
                remove(filename); // Clean up the temporary file
            }
        }
    }

    // API 5: cmsDupContext
    // This function duplicates a cmsContext. Fuzzing it can help uncover issues
    // related to context management and resource duplication.
    {
        // Create a dummy user data pointer.
        // The actual content of this data is not important for fuzzing cmsDupContext itself,
        // but its existence and proper handling by cmsDupContext is.
        std::vector<uint8_t> userDataBuffer = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange(0, 128));
        void* newUserData = userDataBuffer.empty() ? nullptr : userDataBuffer.data();

        // Call the target API
        // Using std::unique_ptr with a custom deleter for automatic memory management.
        std::unique_ptr<_cmsContext_struct, ContextDeleter> duplicatedContext(cmsDupContext(context.get(), newUserData));
    }

    return 0;
