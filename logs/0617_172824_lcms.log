                }

                // Rewind the file pointer to read from the beginning
                fseek(fp, 0, SEEK_SET);

                // Open the profile from the stream
                std::unique_ptr<void, ProfileDeleter> opened_profile(cmsOpenProfileFromStream(fp, "r"));

                fclose(fp);
            }
            unlink(filename); // Clean up the temporary file
        }
    }

    return 0;
