        primaries.Red.y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Red.Y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Green.x = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Green.y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Green.Y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Blue.x = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Blue.y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Blue.Y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();

        // Create tone curves. We'll create simple gamma curves for fuzzing.
        // Using std::unique_ptr with a custom deleter for automatic memory management.
        std::unique_ptr<cmsToneCurve, ToneCurveDeleter> toneCurveR(cmsBuildGamma(context.get(), fdp.ConsumeFloatingPoint<cmsFloat64Number>()));
        std::unique_ptr<cmsToneCurve, ToneCurveDeleter> toneCurveG(cmsBuildGamma(context.get(), fdp.ConsumeFloatingPoint<cmsFloat64Number>()));
        std::unique_ptr<cmsToneCurve, ToneCurveDeleter> toneCurveB(cmsBuildGamma(context.get(), fdp.ConsumeFloatingPoint<cmsFloat64Number>()));

        cmsToneCurve* transferFunction[3] = {toneCurveR.get(), toneCurveG.get(), toneCurveB.get()};

        // Call the target API
        // Using std::unique_ptr with a custom deleter for automatic memory management.
        std::unique_ptr<void, ProfileDeleter> rgbProfile(cmsCreateRGBProfile(&whitePoint, &primaries, transferFunction));
    }

    // API 2: cmsCreateProofingTransform
    // This function creates a color transform for proofing. It's complex as it involves
    // multiple profiles and intents, providing good opportunities for diverse input combinations.
    {
        // Create dummy profiles for the transform. In a real scenario, these would be loaded from files.
        // For fuzzing, we can create simple sRGB profiles.
        // Using std::unique_ptr with a custom deleter for automatic memory management.
        std::unique_ptr<void, ProfileDeleter> inputProfile(cmsCreate_sRGBProfile());
        std::unique_ptr<void, ProfileDeleter> outputProfile(cmsCreate_sRGBProfile());
        std::unique_ptr<void, ProfileDeleter> proofingProfile(cmsCreate_sRGBProfile());

        if (inputProfile && outputProfile && proofingProfile) {
            cmsUInt32Number inputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
            cmsUInt32Number outputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
            cmsUInt32Number nIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3); // Intents are usually 0-3
            cmsUInt32Number proofingIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
            cmsUInt32Number dwFlags = fdp.ConsumeIntegral<cmsUInt32Number>();

