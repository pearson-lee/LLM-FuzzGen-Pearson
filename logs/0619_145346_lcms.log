          key[key_len] = '\0';
          data += key_len;
          size -= key_len;

          if (size > 0) {
            char *buffer = (char *)malloc(size + 1);
            if (buffer) {
              memcpy(buffer, data, size);
              buffer[size] = '\0';
              cmsIT8SetPropertyUncooked(hIT8, key, buffer);
              free(buffer);
