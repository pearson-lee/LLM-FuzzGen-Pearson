#include "/src/lcms/include/lcms2.h"
#include <stdint.h>
#include <stdlib.h>

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 1) {
    return 0;
  }

  cmsContext ContextID = cmsCreateContext(NULL, NULL);
  if (ContextID == NULL) {
    return 0;
  }

  // cmsOpenProfileFromMem does not take a context ID.
  cmsHPROFILE hProfile = cmsOpenProfileFromMem(data, size);
  if (hProfile == NULL) {
    cmsDeleteContext(ContextID);
    return 0;
  }

  // Test reading various tags using the public API with correct tag signatures.
  void *tag_data;

  // Read a tag that contains a pipeline (LutAtoB).
  tag_data = cmsReadTag(hProfile, cmsSigAToB0Tag);
  if (tag_data != NULL) {
    cmsPipelineFree((cmsPipeline *)tag_data);
  }

  // Read a tag that contains a tone curve.
  tag_data = cmsReadTag(hProfile, cmsSigRedTRCTag);
  if (tag_data != NULL) {
    cmsFreeToneCurve((cmsToneCurve *)tag_data);
  }

  // Read the colorant order tag.
  tag_data = cmsReadTag(hProfile, cmsSigColorantOrderTag);
  if (tag_data != NULL) {
    // cmsReadTag uses the context's memory manager.
    // Since context is created with NULL, it uses malloc/free.
    free(tag_data);
  }

  // Read the video signal tag.
  tag_data = cmsReadTag(hProfile, cmsSigVideoSignalTag);
  if (tag_data != NULL) {
    free(tag_data);
  }

  cmsCloseProfile(hProfile);
  cmsDeleteContext(ContextID);

  return 0;
}[0m
