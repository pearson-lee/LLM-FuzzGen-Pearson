  if (size > 24 * sizeof(cmsUInt16Number) + 12 * sizeof(double)) {
    cmsHPROFILE hProfileWrite = cmsCreateProfilePlaceholder(NULL);
    if (hProfileWrite) {
      cmsPipeline *lut = cmsPipelineAlloc(NULL, 3, 3);
