// Dummy type handler structure
static struct _cms_typehandler_struct Global_Type_Handler;

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 1) {
    return 0;
  }

  // Create a context that uses the default memory manager (malloc/free)
  cmsContext ContextID = cmsCreateContext(NULL, NULL);
  if (ContextID == NULL) {
    return 0;
  }

  // Create a memory-based IO handler from the fuzzer input
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(ContextID, (void *)data, size, "r");
  if (io == NULL) {
    cmsDeleteContext(ContextID);
    return 0;
  }

  // Initialize a dummy type handler
  memset(&Global_Type_Handler, 0, sizeof(Global_Type_Handler));
  Global_Type_Handler.ContextID = ContextID;

  cmsUInt32Number nItems;

  // Call the target APIs with the fuzzer-controlled IO handler
  void *lut = Type_LUTA2B_Read(&Global_Type_Handler, io, &nItems, (cmsUInt32Number)size);
  if (lut) {
    // The returned object is a cmsPipeline, free it.
    cmsPipelineFree((cmsPipeline *)lut);
  }

  // Rewind the IO handler to reuse the data for the next API call
  io->Seek(io, 0);

  void *mpeCurve = Type_MPEcurve_Read(&Global_Type_Handler, io, &nItems, (cmsUInt32Number)size);
  if (mpeCurve) {
    // The returned object is a cmsStage, free it.
    cmsStageFree((cmsStage *)mpeCurve);
  }

  io->Seek(io, 0);

  void *parametricCurve = Type_ParametricCurve_Read(&Global_Type_Handler, io, &nItems, (cmsUInt32Number)size);
  if (parametricCurve) {
    // The returned object is a cmsToneCurve, free it.
    cmsFreeToneCurve((cmsToneCurve *)parametricCurve);
  }

  io->Seek(io, 0);

  void *colorantOrder = Type_ColorantOrderType_Read(&Global_Type_Handler, io, &nItems, (cmsUInt32Number)size);
  if (colorantOrder) {
    // The default memory manager uses standard free.
    free(colorantOrder);
  }

  io->Seek(io, 0);

  void *videoSignal = Type_VideoSignal_Read(&Global_Type_Handler, io, &nItems, (cmsUInt32Number)size);
  if (videoSignal) {
    // The default memory manager uses standard free.
    free(videoSignal);
  }

  // Clean up resources
  cmsCloseIOhandler(io);
  cmsDeleteContext(ContextID);

  return 0;
}[0m
