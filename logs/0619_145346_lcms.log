  if (size > sizeof(cmsUInt16Number) * 3 + sizeof(cmsUInt16Number) * 16) {
    cmsHPROFILE hProfileWrite = cmsCreateProfilePlaceholder(NULL);
    if (hProfileWrite) {
      cmsNAMEDCOLORLIST *nc = cmsAllocNamedColorList(NULL, 1, 4, "p", "s");
      if (nc) {
