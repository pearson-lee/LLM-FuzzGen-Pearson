int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < sizeof(int) * 2 + sizeof(cmsCIELab) + 2) {
    return 0;
  }

  // cmsIT8 calls
  cmsHANDLE hIT8 = cmsIT8Alloc(NULL);
  if (hIT8) {
    int row = *(int *)data;
    data += sizeof(int);
    size -= sizeof(int);
    int col = *(int *)data;
    data += sizeof(int);
    size -= sizeof(int);

    char *val = (char *)malloc(size + 1);
    if (val) {
      memcpy(val, data, size);
      val[size] = '\0';
      cmsIT8SetDataRowCol(hIT8, row, col, val);
      free(val);
    }

    if (size > 2) {
      size_t key_len = data[0];
      data++;
