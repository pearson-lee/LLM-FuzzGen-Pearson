// A simple data provider to consume data from the fuzzer input.
typedef struct {
  const uint8_t *data;
  size_t size;
  size_t offset;
} FuzzData;

// Initializes the data provider.
static void FuzzDataInit(FuzzData *f, const uint8_t *data, size_t size) {
  f->data = data;
  f->size = size;
  f->offset = 0;
