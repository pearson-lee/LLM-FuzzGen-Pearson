int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 4) {
    return 0;
  }

  // Create a memory-based IO handler
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(NULL, (void *)data, size, "r");
  if (io == NULL) {
    return 0;
  }

  // Read the LUT A to B type
  cmsUInt32Number nItems;
  struct _cms_typehandler_struct s;
  memset(&s, 0, sizeof(s));
  s.ContextID = NULL;
  void *lut = Type_LUTA2B_Read(&s, io, &nItems, size);
  if (lut != NULL) {
    // Free the LUT
    cmsPipelineFree((cmsPipeline *)lut);
  }

  // Close the IO handler
  cmsCloseIOhandler(io);

  return 0;
}[0m
