          if (size > 0) {
            char *buffer = (char *)malloc(size + 1);
            if (buffer) {
              memcpy(buffer, data, size);
              buffer[size] = '\0';
              cmsIT8SetPropertyUncooked(hIT8, key, buffer);
              free(buffer);
            }
          }
          free(key);
        }
      }
    }
    cmsIT8Free(hIT8);
  }

  // cmsGDB calls
  cmsHANDLE hGDB = cmsGDBAlloc(NULL);
  if (hGDB) {
    if (size >= sizeof(cmsCIELab)) {
      cmsCIELab lab;
      memcpy(&lab, data, sizeof(cmsCIELab));
      cmsGDBCheckPoint(hGDB, &lab);
    }
    cmsGBDFree(hGDB);
  }

  // Profile sequence calls
  cmsHPROFILE hProfile = cmsCreateProfilePlaceholder(NULL);
  if (hProfile) {
    cmsSEQ *seq = _cmsReadProfileSequence(hProfile);
    if (seq) {
      cmsFreeProfileSequence(seq);
    }
    cmsCloseProfile(hProfile);
  }

  return 0;
}[0m
