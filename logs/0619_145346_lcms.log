#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/src/lcms2_internal.h"
#include <stdint.h>
#include <stdlib.h>

// By including the C file at the end, we get access to static functions.
// This is a common technique for fuzzing static functions.
// We forward-declare the functions we want to test for clarity.
// The declarations must be static to match the definitions in cmstypes.c
static void *Type_LUTA2B_Read(struct _cms_typehandler_struct *self, cmsIOHANDLER *io, cmsUInt32Number *nItems, cmsUInt32Number SizeOfTag);
static void Type_LUTA2B_Free(struct _cms_typehandler_struct *self, void *Ptr);
static void *Type_MPEcurve_Read(struct _cms_typehandler_struct *self, cmsIOHANDLER *io, cmsUInt32Number *nItems, cmsUInt32Number SizeOfTag);
static void GenericMPEfree(struct _cms_typehandler_struct *self, void *Ptr);
static cmsToneCurve *ReadSegmentedCurve(struct _cms_typehandler_struct *self, cmsIOHANDLER *io);
static void *Type_ColorantOrderType_Read(struct _cms_typehandler_struct *self, cmsIOHANDLER *io, cmsUInt32Number *nItems, cmsUInt32Number SizeOfTag);
static void Type_ColorantOrderType_Free(struct _cms_typehandler_struct *self, void *Ptr);
static void *Type_XYZ_Read(struct _cms_typehandler_struct *self, cmsIOHANDLER *io, cmsUInt32Number *nItems, cmsUInt32Number SizeOfTag);
static void Type_XYZ_Free(struct _cms_typehandler_struct *self, void *Ptr);

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  // Create a context.
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (!ctx) {
    return 0;
  }

  // Create a memory-based IO handler from the fuzzer data.
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(ctx, (void *)data, size, "r");
  if (!io) {
    cmsDeleteContext(ctx);
    return 0;
  }

  // A dummy type handler is sufficient to call the static functions.
  struct _cms_typehandler_struct dummy_handler;
  dummy_handler.ContextID = ctx;
  cmsUInt32Number nItems;

  // Fuzz Type_LUTA2B_Read
  void *lut = Type_LUTA2B_Read(&dummy_handler, io, &nItems, (cmsUInt32Number)size);
  if (lut) {
    // Free the returned object to prevent memory leaks.
    Type_LUTA2B_Free(&dummy_handler, lut);
  }
  // Rewind the IO handler for the next function call.
  cmsIOSeek(io, 0);

  // Fuzz Type_MPEcurve_Read
  void *mpe_curve = Type_MPEcurve_Read(&dummy_handler, io, &nItems, (cmsUInt32Number)size);
  if (mpe_curve) {
    // Free the returned object.
    GenericMPEfree(&dummy_handler, mpe_curve);
  }
  cmsIOSeek(io, 0);

  // Fuzz ReadSegmentedCurve
  cmsToneCurve *segmented_curve = ReadSegmentedCurve(&dummy_handler, io);
  if (segmented_curve) {
    // Free the tone curve.
    cmsFreeToneCurve(segmented_curve);
  }
  cmsIOSeek(io, 0);

  // Fuzz Type_ColorantOrderType_Read
  void *colorant_order = Type_ColorantOrderType_Read(&dummy_handler, io, &nItems, (cmsUInt32Number)size);
  if (colorant_order) {
    // Free the returned object.
    Type_ColorantOrderType_Free(&dummy_handler, colorant_order);
  }
  cmsIOSeek(io, 0);

  // Fuzz Type_XYZ_Read
  void *xyz = Type_XYZ_Read(&dummy_handler, io, &nItems, (cmsUInt32Number)size);
  if (xyz) {
    // Free the returned object.
    Type_XYZ_Free(&dummy_handler, xyz);
  }

  // Clean up resources.
  cmsCloseIOhandler(io);
  cmsDeleteContext(ctx);

  return 0;
}

