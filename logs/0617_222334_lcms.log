#include <stdint.h>
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h> // For malloc/free
#include <string.h> // For strncpy

#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/include/lcms2_plugin.h" // For _cmsDefaultICCintents
#include "/src/lcms/src/lcms2_internal.h" // For _cmsChain2Lab

#include <fuzzer/FuzzedDataProvider.h>

// Fuzz target for lcms library
// This target aims to exercise multiple diverse APIs to maximize code coverage.
// Selected APIs:
// 1. cmsOpenProfileFromIOhandler2THR: Profile loading/parsing from memory.
// 2. _cmsDefaultICCintents: Internal pipeline setup, handling arrays of profiles/intents.
// 3. _cmsChain2Lab: Complex transform creation, chaining profiles.
// 4. cmsIT8LoadFromMem: IT8 data parsing from memory.
// 5. cmsGetProfileInfo: Profile metadata access and string handling.

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzedDataProvider fdp(Data, Size);

  // Initialize cmsContext
  // cmsCreateContext creates a new context for lcms operations.
  // It's the first step to ensure thread-safety and proper resource management.
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (!ctx) {
    return 0; // Failed to create context, nothing to do
  }

  // --- API 1: cmsOpenProfileFromIOhandler2THR ---
  // This function opens a profile from an IO handler, which is crucial for
  // processing ICC profiles. We'll create an in-memory IO handler to provide
  // fuzzed data as if it were a profile file.
  cmsHPROFILE hProfile = NULL;
  cmsIOHANDLER* io_handler = NULL;

  // Consume data for the in-memory IO handler. The size is fuzzed to test
  // various input lengths, from empty to a reasonable maximum.
  size_t io_data_size = fdp.ConsumeIntegralInRange<size_t>(0, fdp.remaining_bytes());
  std::vector<uint8_t> io_data = fdp.ConsumeBytes<uint8_t>(io_data_size);

  // Create an in-memory IO handler using the fuzzed data.
  io_handler = cmsOpenIOhandlerFromMemTHR(ctx, io_data.data(), io_data.size(), "r");
  if (io_handler) {
    // Fuzz the 'write' access boolean.
    cmsBool write_access = fdp.ConsumeBool();
    // Attempt to open the profile. The returned hProfile will be NULL on failure.
    hProfile = cmsOpenProfileFromIOhandler2THR(ctx, io_handler, write_access);
  }

  // --- API 2: _cmsDefaultICCintents ---
  // This function deals with default ICC intents, involving arrays of parameters.
  // Fuzzing this helps test internal pipeline setup and array handling logic.
  cmsPipeline* pipeline = NULL;
  // Limit the number of profiles to prevent excessive memory allocation and
  // to keep fuzzing efficient.
  cmsUInt32Number num_profiles_intent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 10); 
  
  // Allocate vectors to hold fuzzed array data.
  std::vector<cmsUInt32Number> the_intents(num_profiles_intent);
  std::vector<cmsHPROFILE> h_profiles_intent(num_profiles_intent);
  std::vector<cmsBool> bpc_intent(num_profiles_intent);
  std::vector<cmsFloat64Number> adaptation_states_intent(num_profiles_intent);

  // Fill arrays with fuzzed data.
  for (cmsUInt32Number i = 0; i < num_profiles_intent; ++i) {
    the_intents[i] = fdp.ConsumeIntegral<cmsUInt32Number>();
    // Re-use the hProfile opened earlier if available, otherwise pass NULL.
    // This tests scenarios with and without a valid profile.
    h_profiles_intent[i] = hProfile; 
    bpc_intent[i] = fdp.ConsumeBool();
    adaptation_states_intent[i] = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
  }

  cmsUInt32Number dwFlags_intent = fdp.ConsumeIntegral<cmsUInt32Number>();

  // Call the target API. The returned pipeline will be NULL on failure.
  pipeline = _cmsDefaultICCintents(ctx, num_profiles_intent,
                                   the_intents.data(), h_profiles_intent.data(),
                                   bpc_intent.data(), adaptation_states_intent.data(),
                                   dwFlags_intent);

  // --- API 3: _cmsChain2Lab ---
  // This function creates a complex transform by chaining profiles to Lab space.
  // This tests complex transformation logic and multi-profile handling.
  cmsHTRANSFORM hTransform = NULL;
  // Limit the number of profiles for efficiency.
  cmsUInt32Number num_profiles_chain = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 10); 

  // Allocate vectors for fuzzed array data.
  std::vector<cmsUInt32Number> intents_chain(num_profiles_chain);
  std::vector<cmsHPROFILE> h_profiles_chain(num_profiles_chain);
  std::vector<cmsBool> bpc_chain(num_profiles_chain);
  std::vector<cmsFloat64Number> adaptation_states_chain(num_profiles_chain);

  // Fill arrays with fuzzed data.
  for (cmsUInt32Number i = 0; i < num_profiles_chain; ++i) {
    intents_chain[i] = fdp.ConsumeIntegral<cmsUInt32Number>();
    // Re-use the hProfile opened earlier if available, otherwise pass NULL.
    h_profiles_chain[i] = hProfile; 
    bpc_chain[i] = fdp.ConsumeBool();
    adaptation_states_chain[i] = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
  }

  cmsUInt32Number input_format = fdp.ConsumeIntegral<cmsUInt32Number>();
  cmsUInt32Number output_format = fdp.ConsumeIntegral<cmsUInt32Number>();
  cmsUInt32Number dwFlags_chain = fdp.ConsumeIntegral<cmsUInt32Number>();

  // Call the target API. The returned transform will be NULL on failure.
  hTransform = _cmsChain2Lab(ctx, num_profiles_chain,
                             input_format, output_format,
                             intents_chain.data(), h_profiles_chain.data(),
                             bpc_chain.data(), adaptation_states_chain.data(),
                             dwFlags_chain);

  // --- API 4: cmsIT8LoadFromMem ---
  // This function loads IT8 data from memory, testing data parsing for a
  // specific data format.
  cmsHANDLE hIT8 = NULL;
  // Consume data for the IT8 parser.
  size_t it8_data_size = fdp.ConsumeIntegralInRange<size_t>(0, fdp.remaining_bytes());
  std::vector<uint8_t> it8_data = fdp.ConsumeBytes<uint8_t>(it8_data_size);

  // Attempt to load IT8 data. The returned handle will be NULL on failure.
  hIT8 = cmsIT8LoadFromMem(ctx, it8_data.data(), it8_data.size());

  // --- API 5: cmsGetProfileInfo ---
  // This function retrieves information from a profile. This tests access to
  // profile metadata and string handling.
  if (hProfile) { // Only call if a profile was successfully opened.
    // cmsInfoType is an enum, consume an integral and cast it.
    // Ensure the value is within the valid range of cmsInfoType enum values.
    cmsInfoType info_type = static_cast<cmsInfoType>(fdp.ConsumeIntegralInRange<int>(0, 3)); // cmsInfoDescription to cmsInfoCopyright
    
    // Language and Country codes (2-char + null terminator).
    // Consume 2 bytes as string and then copy to a fixed-size char array,
    // ensuring null termination.
    std::string lang_code_str = fdp.ConsumeBytesAsString(2);
    std::string country_code_str = fdp.ConsumeBytesAsString(2);
    
    char lang_code[3] = {0};
    char country_code[3] = {0};
    if (lang_code_str.length() == 2) {
        strncpy(lang_code, lang_code_str.c_str(), 2);
    }
    if (country_code_str.length() == 2) {
        strncpy(country_code, country_code_str.c_str(), 2);
    }

    // Allocate a buffer for the wide character output. Fuzz the buffer size
    // to test various buffer overflow/underflow scenarios.
    size_t buffer_size = fdp.ConsumeIntegralInRange<size_t>(0, 1024); 
    wchar_t* buffer = (wchar_t*)malloc(buffer_size * sizeof(wchar_t));
    if (buffer) {
      // Call the API to get profile information.
      cmsGetProfileInfo(hProfile, info_type, lang_code, country_code, buffer, buffer_size);
      free(buffer); // Free the allocated buffer.
    }
  }

  // --- Cleanup ---
  // Meticulously free all allocated resources to prevent memory leaks.
  // Resources are freed in reverse order of allocation where dependencies exist.
  if (hIT8) {
    cmsIT8Free(hIT8);
  }
  if (hTransform) {
    cmsDeleteTransform(hTransform);
  }
  if (pipeline) {
    cmsPipelineFree(pipeline);
  }
  if (hProfile) {
    cmsCloseProfile(hProfile);
  }
  if (io_handler) {
    cmsCloseIOhandler(io_handler);
  }
  // Delete the context last, as it manages other lcms objects.
  cmsDeleteContext(ctx);

  return 0;
}[0m
