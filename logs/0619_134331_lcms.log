char* ConsumeString(const uint8_t** DataPos, size_t* RemainingSize, size_t max_len, size_t min_len) {
    size_t len_byte_size = sizeof(uint8_t); // Use a byte to determine length
    if (*RemainingSize < len_byte_size) {
