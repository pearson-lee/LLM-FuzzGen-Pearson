#include "/src/lcms/include/lcms2.h"
#include <fuzzer/FuzzedDataProvider.h>
#include <stdlib.h>

// Define a helper function to consume data for cmsCIExyY
// Consumes 3 cmsFloat64Number values from the fuzzer data to create a cmsCIExyY struct.
cmsCIExyY consumeCIExyY(FuzzedDataProvider* provider) {
    cmsCIExyY xyY;
    xyY.x = provider->ConsumeFloatingPoint<cmsFloat64Number>();
    xyY.y = provider->ConsumeFloatingPoint<cmsFloat64Number>();
    xyY.Y = provider->ConsumeFloatingPoint<cmsFloat64Number>();
    return xyY;
}

// Define a helper function to consume data for cmsToneCurve
// Consumes data to build a tabulated tone curve.
cmsToneCurve* consumeToneCurve(FuzzedDataProvider* provider, cmsContext Context) {
    // Fuzz the number of points in the tone curve, limiting to a reasonable range.
    size_t num_points = provider->ConsumeIntegralInRange<size_t>(2, 1024);
    // Ensure enough data is available for the specified number of points.
    if (provider->remaining_bytes() < num_points * sizeof(cmsUInt16Number)) {
        return NULL;
    }
    cmsUInt16Number* values = (cmsUInt16Number*)malloc(num_points * sizeof(cmsUInt16Number));
    if (!values) {
        return NULL;
    }
    // Consume data for each point in the tone curve.
    for (size_t i = 0; i < num_points; ++i) {
        values[i] = provider->ConsumeIntegral<cmsUInt16Number>();
    }
    // Build the tone curve and free the temporary values array.
    cmsToneCurve* curve = cmsBuildTabulatedToneCurve16(Context, num_points, values);
    free(values);
    return curve;
}

