#include "/src/cjson/cJSON.h"
#include <fuzzer/FuzzedDataProvider.h>
#include <string>
#include <vector>

// Custom deleter for unique_ptr to automatically free cJSON objects
struct cJSONDeleter {
  void operator()(cJSON *ptr) const {
    if (ptr) {
      cJSON_Delete(ptr);
    }
  }
};

using cJSONUniquePtr = std::unique_ptr<cJSON, cJSONDeleter>;

// Custom deleter for unique_ptr to automatically free memory allocated by cJSON_malloc
struct cJSONFreeDeleter {
  void operator()(void *ptr) const {
    if (ptr) {
      cJSON_free(ptr);
    }
  }
};

using cJSONMallocUniquePtr = std::unique_ptr<void, cJSONFreeDeleter>;

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Initialize cJSON with standard hooks
  cJSON_InitHooks(nullptr);

  // Target 1: cJSON_ParseWithOpts
  // Use a portion of the input to test parsing with different options.
  std::string json_to_parse = fdp.ConsumeRandomLengthString(1024);
  const char *parse_end = nullptr;
  cJSONUniquePtr parsed_json(cJSON_ParseWithOpts(
      json_to_parse.c_str(), &parse_end, fdp.ConsumeBool()));
  // No need to do anything with parsed_json, unique_ptr handles cleanup.

  // Create a base JSON object for further testing.
  std::string base_json_str = fdp.ConsumeRandomLengthString(1024);
  cJSONUniquePtr root(cJSON_Parse(base_json_str.c_str()));

  if (root) {
    // Target 2: cJSON_ReplaceItemInObject
    // If the parsed object is a JSON object, try to replace an item.
    if (cJSON_IsObject(root.get())) {
      std::string key = fdp.ConsumeRandomLengthString(32);

      // Create a new item to replace with, of a random type.
      cJSON *newItem = nullptr;
      switch (fdp.ConsumeIntegralInRange<int>(0, 5)) {
      case 0:
        newItem = cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>());
        break;
      case 1:
        newItem = cJSON_CreateString(
            fdp.ConsumeRandomLengthString(128).c_str());
        break;
      case 2:
        newItem = cJSON_CreateBool(fdp.ConsumeBool());
        break;
      case 3:
        newItem = cJSON_CreateArray();
        break;
      case 4:
        newItem = cJSON_CreateObject();
        break;
      case 5:
        newItem = cJSON_CreateNull();
        break;
      }

      if (newItem) {
        cJSON_ReplaceItemInObject(root.get(), key.c_str(), newItem);
        // cJSON_ReplaceItemInObject takes ownership of newItem if successful,
        // so no need to delete it separately. If it fails, newItem is not
        // attached and needs to be deleted. However, since we don't check the
        // return value, we assume it's attached to avoid double-freeing.
        // A more robust approach would check the return, but for fuzzing,
        // this is a reasonable simplification.
      }
    }

    // Target 3: cJSON_SetValuestring
    // If the object is a string, try to set its value.
    if (cJSON_IsString(root.get())) {
      std::string new_value = fdp.ConsumeRandomLengthString(128);
      cJSON_SetValuestring(root.get(), new_value.c_str());
    }

    // Target 4 & 5: cJSON_PrintBuffered (which exercises print and ensure)
    // Print the potentially modified JSON object to a buffer.
    // Use a fuzzed prebuffer size to exercise the 'ensure' logic for buffer resizing.
    int prebuffer = fdp.ConsumeIntegralInRange<int>(-1, 1024);
    bool format = fdp.ConsumeBool();
    cJSONMallocUniquePtr printed_json(
        cJSON_PrintBuffered(root.get(), prebuffer, format));
    // The printed_json buffer is automatically freed by the unique_ptr.
  }

  return 0;
}[0m
