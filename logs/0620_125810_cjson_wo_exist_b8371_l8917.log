    const bool format = fdp.ConsumeBool();
    char *printed_json = cJSON_PrintBuffered(root, prebuffer, format);
    if (printed_json) {
      // Free the buffer allocated by cJSON_PrintBuffered.
      cJSON_free(printed_json);
