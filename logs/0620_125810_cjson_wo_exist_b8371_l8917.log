#include "/src/cjson/cJSON.h"
#include <fuzzer/FuzzedDataProvider.h>
#include <string>
#include <vector>

// Fuzz target for cJSON library, focusing on parsing, modification, and printing functions.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    FuzzedDataProvider fdp(data, size);

    // Consume data for cJSON_ParseWithOpts
    // This function is targeted due to its low code coverage.
    std::string json_string = fdp.ConsumeRandomLengthString(1000);
    const char *parse_end = nullptr;
    bool require_null_terminated = fdp.ConsumeBool();

    // Create a cJSON object from the fuzzer input.
    // This object will be used to test other API functions.
    cJSON *root = cJSON_ParseWithOpts(json_string.c_str(), &parse_end, require_null_terminated);

    // If parsing fails, there's nothing more to do.
    if (root == nullptr) {
        return 0;
    }

    // Target cJSON_Duplicate to test object duplication.
    // This is selected for its moderately low coverage and its importance in resource management.
    cJSON *root_dup = cJSON_Duplicate(root, fdp.ConsumeBool());
    if (root_dup == nullptr) {
        // Clean up the original object if duplication fails.
        cJSON_Delete(root);
        return 0;
    }

    // Target cJSON_SetValuestring to test value modification.
    // This function has several branches related to memory management of strings.
    if (cJSON_IsObject(root) && cJSON_GetArraySize(root) > 0) {
        cJSON *first_item = root->child;
        if (first_item != nullptr && first_item->string != nullptr) {
            // Generate a random string to set as the new value.
            cJSON_SetValuestring(first_item, fdp.ConsumeRandomLengthString(100).c_str());
        }
    }

    // Target cJSON_ReplaceItemInObject for object modification.
    // This function has complex logic for replacing items in a JSON object.
    if (cJSON_IsObject(root_dup) && cJSON_GetArraySize(root_dup) > 0) {
        cJSON *item_to_replace = root_dup->child;
        if (item_to_replace != nullptr && item_to_replace->string != nullptr) {
            std::string key_to_replace = item_to_replace->string;
            // Create a new cJSON item to be the replacement.
            cJSON *new_item = cJSON_CreateString(fdp.ConsumeRandomLengthString(100).c_str());
            if (new_item != nullptr) {
                // cJSON_ReplaceItemInObject takes ownership of new_item upon success.
                // If it fails, we must manually deallocate new_item.
                if (!cJSON_ReplaceItemInObject(root_dup, key_to_replace.c_str(), new_item)) {
                    cJSON_Delete(new_item);
                }
            }
        }
    }

    // Target cJSON_PrintBuffered to test printing functionality.
    // This function has low coverage and involves buffer allocation and management.
    int buffer_size = fdp.ConsumeIntegralInRange<int>(10, 1000);
    bool format = fdp.ConsumeBool();
    
    // Print the original, possibly modified, object.
    char *printed_root = cJSON_PrintBuffered(root, buffer_size, format);
    if (printed_root != nullptr) {
        // The returned buffer must be freed.
        cJSON_free(printed_root);
    }

    // Print the duplicated and modified object.
    char *printed_dup = cJSON_PrintBuffered(root_dup, buffer_size, format);
    if (printed_dup != nullptr) {
        // The returned buffer must be freed.
        cJSON_free(printed_dup);
    }

    // Clean up all allocated cJSON objects.
    // cJSON_Delete recursively frees all child items.
    cJSON_Delete(root);
    cJSON_Delete(root_dup);

    return 0;
}[0m
