  // If the duplicated object is a string, modify its value.
  if (cJSON_IsString(dup_obj)) {
      // cJSON_SetValuestring handles memory allocation for the new string.
      cJSON_SetValuestring(dup_obj, new_valuestring.c_str());
  }

  // 5. Target: cJSON_PrintBuffered
  // Print the (potentially modified) duplicated object to a buffer.
  char *printed_buffer = cJSON_PrintBuffered(dup_obj, prebuffer_size, format_print);
  if (printed_buffer != nullptr) {
    // IMPORTANT: The buffer returned by cJSON_PrintBuffered must be freed
    // using the library's free function to prevent memory leaks.
    cJSON_free(printed_buffer);
  }

