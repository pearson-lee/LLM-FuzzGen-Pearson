#include <cstddef>
#include <cstdint>
#include <string>
#include <memory>
#include <fuzzer/FuzzedDataProvider.h>
#include "/src/cjson/cJSON.h"

// Custom deleter for cJSON objects to be used with std::unique_ptr.
// This ensures that cJSON_Delete is called to free the memory, preventing leaks.
struct cJSON_Deleter {
    void operator()(cJSON* ptr) const {
        cJSON_Delete(ptr);
    }
};

// Alias for a unique_ptr with the custom cJSON deleter.
using cJSON_ptr = std::unique_ptr<cJSON, cJSON_Deleter>;

// Custom deleter for memory allocated by cJSON_PrintUnformatted (which uses malloc).
struct cJSON_Print_Deleter {
    void operator()(char* ptr) const {
        free(ptr);
    }
};

// Alias for a unique_ptr with the custom print deleter.
using cJSON_Print_ptr = std::unique_ptr<char, cJSON_Print_Deleter>;

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    FuzzedDataProvider fdp(data, size);

    // Consume data for parsing.
    const char *parse_end = nullptr;
    std::string json_string = fdp.ConsumeRandomLengthString(1000);
    
    // Create a cJSON object by parsing the fuzzed string.
    // Using cJSON_ptr for automatic memory management.
    cJSON_ptr root(cJSON_ParseWithOpts(json_string.c_str(), &parse_end, fdp.ConsumeBool()));

    if (root) {
        // Create a second cJSON object to use for replacement and adding items.
        cJSON_ptr replacement(cJSON_CreateObject());
        if (replacement) {
            // Add a string item to the replacement object.
            std::string key1 = fdp.ConsumeRandomLengthString(10);
            std::string value1 = fdp.ConsumeRandomLengthString(20);
            cJSON_AddItemToObject(replacement.get(), key1.c_str(), cJSON_CreateString(value1.c_str()));

            // Add a number item to the replacement object.
            std::string key2 = fdp.ConsumeRandomLengthString(10);
            cJSON_AddItemToObject(replacement.get(), key2.c_str(), cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>()));

            // Add a boolean item to the replacement object.
            std::string key3 = fdp.ConsumeRandomLengthString(10);
            cJSON_AddItemToObject(replacement.get(), key3.c_str(), cJSON_CreateBool(fdp.ConsumeBool()));

            // Replace an item in the root object with the replacement object.
            std::string replace_key = fdp.ConsumeRandomLengthString(10);
            if (cJSON_HasObjectItem(root.get(), replace_key.c_str())) {
                // The object is owned by root after this call, so we release the unique_ptr.
                cJSON_ReplaceItemInObject(root.get(), replace_key.c_str(), replacement.release());
            }
        }

        // Duplicate the (potentially modified) root object.
        cJSON_ptr clone(cJSON_Duplicate(root.get(), fdp.ConsumeBool()));

        // Print the original and cloned objects.
        // The returned string must be freed, which is handled by cJSON_Print_ptr.
        if (root) {
            cJSON_Print_ptr printed_root(cJSON_PrintUnformatted(root.get()));
        }
        if (clone) {
            cJSON_Print_ptr printed_clone(cJSON_PrintUnformatted(clone.get()));
        }
    }

    return 0;
}[0m
