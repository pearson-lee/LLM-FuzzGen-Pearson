// Fuzz target entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzedDataProvider fdp(Data, Size);

  // Consume data for API inputs
  const std::string json_string = fdp.ConsumeRandomLengthString(1024);
  const bool require_null_terminated = fdp.ConsumeBool();
  const bool recurse_duplicate = fdp.ConsumeBool();
  const std::string replacement_key = fdp.ConsumeRandomLengthString(32);
  const std::string replacement_value = fdp.ConsumeRandomLengthString(128);
  const bool case_sensitive_replace = fdp.ConsumeBool();
  const int prebuffer_size = fdp.ConsumeIntegralInRange<int>(0, 1024);
  const bool format_print = fdp.ConsumeBool();
  const std::string new_valuestring = fdp.ConsumeRandomLengthString(128);

  // 1. Target: cJSON_ParseWithOpts
  // Attempt to parse the fuzzer-provided string.
  cJSON *root_obj = cJSON_ParseWithOpts(json_string.c_str(), nullptr, require_null_terminated);
  if (root_obj == nullptr) {
    return 0; // Invalid JSON, exit early.
  }

  // 2. Target: cJSON_Duplicate
  // Create a duplicate of the parsed object to modify it without affecting the original.
  cJSON *dup_obj = cJSON_Duplicate(root_obj, recurse_duplicate);
  if (dup_obj == nullptr) {
    cJSON_Delete(root_obj); // Clean up original object
    return 0;
  }

  // 3. Target: cJSON_ReplaceItemInObject / cJSON_ReplaceItemInObjectCaseSensitive
  // Only attempt replacement if the duplicated object is an object type.
  if (cJSON_IsObject(dup_obj)) {
    cJSON *replacement_item = cJSON_CreateString(replacement_value.c_str());
    if (replacement_item != nullptr) {
      cJSON_bool replaced = false;
      // The replacement_item is owned by dup_obj only if the replacement succeeds.
      if (case_sensitive_replace) {
        replaced = cJSON_ReplaceItemInObjectCaseSensitive(dup_obj, replacement_key.c_str(), replacement_item);
      } else {
        replaced = cJSON_ReplaceItemInObject(dup_obj, replacement_key.c_str(), replacement_item);
      }
      if (!replaced) {
        // If replacement fails, we must free the item ourselves.
        cJSON_Delete(replacement_item);
      }
    }
  }

  // 4. Target: cJSON_SetValuestring
  // If the duplicated object is a string, modify its value.
  if (cJSON_IsString(dup_obj)) {
      // cJSON_SetValuestring handles memory allocation for the new string.
      cJSON_SetValuestring(dup_obj, new_valuestring.c_str());
  }

  // 5. Target: cJSON_PrintBuffered
  // Print the (potentially modified) duplicated object to a buffer.
  char *printed_buffer = cJSON_PrintBuffered(dup_obj, prebuffer_size, format_print);
  if (printed_buffer != nullptr) {
    // IMPORTANT: The buffer returned by cJSON_PrintBuffered must be freed
    // using the library's free function to prevent memory leaks.
    cJSON_free(printed_buffer);
  }

  // Cleanup: Free all allocated cJSON objects.
  // This is crucial to prevent memory leaks.
  cJSON_Delete(root_obj);
  cJSON_Delete(dup_obj);

  return 0;
}[0m
