// Fuzz target entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Consume data for creating a JSON string to parse.
  std::string json_string = fdp.ConsumeRandomLengthString(1000);
  const char *error_ptr = nullptr;

  // Target cJSON_ParseWithOpts to create a cJSON object.
  // The require_null_terminated flag is fuzzed.
  cJSON *json = cJSON_ParseWithOpts(json_string.c_str(), &error_ptr, fdp.ConsumeBool());

  if (json) {
    // If parsing is successful, proceed with further operations.

    // Target cJSON_Print and cJSON_PrintUnformatted to exercise printing logic.
    // The returned strings must be freed to prevent memory leaks.
    char *printed_formatted = cJSON_Print(json);
    if (printed_formatted) {
      free(printed_formatted);
    }
    char *printed_unformatted = cJSON_PrintUnformatted(json);
    if (printed_unformatted) {
      free(printed_unformatted);
    }

    // Target cJSON_Duplicate to test cloning of JSON objects.
    // The cloned object must be deleted to prevent memory leaks.
    cJSON *json_clone = cJSON_Duplicate(json, fdp.ConsumeBool());
    if (json_clone) {
      cJSON_Delete(json_clone);
    }

    // Target cJSON_AddItemToObject and cJSON_ReplaceItemInObject for modification.
    if (cJSON_IsObject(json)) {
      std::string key_to_add = fdp.ConsumeRandomLengthString(32);
      std::string value_to_add = fdp.ConsumeRandomLengthString(64);
      // cJSON_AddItemToObject takes ownership of the created string item.
      cJSON_AddItemToObject(json, key_to_add.c_str(), cJSON_CreateString(value_to_add.c_str()));

      std::string key_to_replace = fdp.ConsumeRandomLengthString(32);
      std::string value_to_replace = fdp.ConsumeRandomLengthString(64);
      cJSON *replacement = cJSON_CreateString(value_to_replace.c_str());

      // cJSON_ReplaceItemInObject takes ownership of the replacement item on success.
      // If it fails (e.g., key not found), the replacement item must be deleted manually.
      if (!cJSON_ReplaceItemInObject(json, key_to_replace.c_str(), replacement)) {
        cJSON_Delete(replacement);
      }
    }

    // Clean up the original JSON object.
    cJSON_Delete(json);
  }

  return 0;
}[0m
