// Custom deleter for unique_ptr to manage cJSON objects
struct cJSON_Deleter {
  void operator()(cJSON* ptr) const {
    if (ptr) {
      cJSON_Delete(ptr);
    }
  }
};

// Custom deleter for unique_ptr to manage memory from cJSON_Print
struct cJSON_Print_Deleter {
  void operator()(char* ptr) const {
    if (ptr) {
      cJSON_free(ptr);
    }
  }
};

using cJSON_ptr = std::unique_ptr<cJSON, cJSON_Deleter>;
using cJSON_Print_ptr = std::unique_ptr<char, cJSON_Print_Deleter>;

// Fuzz target entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Consume data for parsing
  const std::string json_string = fdp.ConsumeRandomLengthString(1024);
  const bool require_null_terminated = fdp.ConsumeBool();

  // Target: cJSON_ParseWithOpts - low coverage parsing function
  // Attempt to parse the fuzzed input string into a cJSON object.
  const char* parse_end = nullptr;
  cJSON_ptr root(cJSON_ParseWithOpts(json_string.c_str(), &parse_end, require_null_terminated));

  // If parsing fails, we can't proceed with the rest of the APIs.
  if (!root) {
    return 0;
  }

  // Target: cJSON_Duplicate - low coverage duplication function
  // Test the duplication logic with both recursive and non-recursive duplication.
  const bool recurse_duplicate = fdp.ConsumeBool();
  cJSON_ptr duplicated_item(cJSON_Duplicate(root.get(), recurse_duplicate));
  // The duplicated_item will be automatically deallocated by its unique_ptr.

  // Target: cJSON_ReplaceItemInObject - low coverage object modification
  // This also implicitly tests object creation functions.
  if (cJSON_IsObject(root.get())) {
    const std::string key_to_replace = fdp.ConsumeRandomLengthString(32);

    // Create a new item to replace an existing one.
    // This diversifies the types of items being inserted.
    cJSON* new_item = nullptr;
    switch (fdp.ConsumeIntegralInRange<uint8_t>(0, 2)) {
      case 0:
        new_item = cJSON_CreateString(fdp.ConsumeRandomLengthString(64).c_str());
        break;
      case 1:
        new_item = cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>());
        break;
      case 2:
        new_item = cJSON_CreateBool(fdp.ConsumeBool());
        break;
    }

    // If the new item was created, attempt the replacement.
    if (new_item) {
      // cJSON_ReplaceItemInObject takes ownership of new_item on success.
      // If it fails, we must delete new_item ourselves.
      if (!cJSON_ReplaceItemInObject(root.get(), key_to_replace.c_str(), new_item)) {
        cJSON_Delete(new_item);
      }
    }
  }

  // Target: cJSON_PrintBuffered - targets low-coverage 'print' and 'ensure'
  // Test the buffered printing functionality with various buffer sizes and formatting.
  const int prebuffer = fdp.ConsumeIntegralInRange<int>(0, 1024);
  const bool format_print = fdp.ConsumeBool();
  cJSON_Print_ptr printed_json(cJSON_PrintBuffered(root.get(), prebuffer, format_print));
  // The printed_json buffer is automatically deallocated by its unique_ptr.

  // The root cJSON object and its children are automatically deallocated
  // by the cJSON_ptr's custom deleter at the end of the scope.
  return 0;
}[0m
