#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <fuzzer/FuzzedDataProvider.h>
#include <memory> // For std::unique_ptr
#include <algorithm> // For std::min
#include <cstring> // For strcpy, strlen

// Include the cJSON header with its full project-relative path.
#include "/src/cjson/cJSON.h"

// Custom deleter for cJSON pointers to use with std::unique_ptr for robust memory management.
// This ensures cJSON_Delete is called when the unique_ptr goes out of scope.
struct CJSONDeleter {
  void operator()(cJSON* ptr) const {
    cJSON_Delete(ptr);
  }
};

// Custom deleter for memory allocated by cJSON_Print and cJSON_PrintUnformatted, which use cJSON_free.
// This ensures that memory allocated by cJSON's printing functions is deallocated using the
// library's own free function, preventing potential memory mismatches.
struct CJSONPrintDeleter {
    void operator()(char* ptr) const {
        cJSON_free(ptr);
    }
};


// LLVMFuzzerTestOneInput is the entry point for the fuzzer.
// It takes raw fuzzer input data and its size.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    // Initialize FuzzedDataProvider to consume the input data.
    FuzzedDataProvider fdp(Data, Size);

    // Use unique_ptr with custom deleters for automatic memory management of cJSON objects and printed strings.
    // This RAII (Resource Acquisition Is Initialization) approach ensures that memory is freed
    // even if the fuzzer exits prematurely due to an error or an early return.
    std::unique_ptr<cJSON, CJSONDeleter> root_json = nullptr;
    std::unique_ptr<cJSON, CJSONDeleter> item_to_add = nullptr;
    std::unique_ptr<cJSON, CJSONDeleter> replacement_item = nullptr;
    std::unique_ptr<char, CJSONPrintDeleter> printed_json_formatted = nullptr;
    std::unique_ptr<char, CJSONPrintDeleter> printed_json_unformatted = nullptr;


    // --- API 1: cJSON_ParseWithOpts ---
    // Description: Parses a JSON string with specified options. This tests the core parsing logic.
    // Input Strategy: Consume a string from the fuzzer data to be parsed as JSON.
    //                 Consume a boolean to decide if the input must be null-terminated.
    // Memory Management: cJSON_ParseWithOpts allocates a new cJSON object if successful,
    //                    which is managed by the root_json unique_ptr.
    std::string json_to_parse = fdp.ConsumeRandomLengthString(std::min((size_t)4096, fdp.remaining_bytes()));
    const char *parse_end_ptr = nullptr; // Optional: to see where parsing stopped.
    cJSON_bool require_null_terminated_parse = fdp.ConsumeBool();
    root_json.reset(cJSON_ParseWithOpts(json_to_parse.c_str(), &parse_end_ptr, require_null_terminated_parse));

    // Exercise cJSON_GetErrorPtr after parsing to check error reporting.
    cJSON_GetErrorPtr();

    // Continue performing fuzzing operations if parsing was successful.
    if (root_json) {

        // --- API 4: cJSON_CreateString ---
        // Description: Creates a new cJSON string item. This tests item creation.
        // Input Strategy: Consume a string from the fuzzer data for the value of the JSON string.
        // Memory Management: cJSON_CreateString allocates a new cJSON object,
        //                    managed by the item_to_add unique_ptr.
        std::string string_value_for_item = fdp.ConsumeRandomLengthString(std::min((size_t)128, fdp.remaining_bytes()));
        item_to_add.reset(cJSON_CreateString(string_value_for_item.c_str()));

        // --- API 5: cJSON_CreateNumber ---
        // Description: Creates a cJSON number item.
        // Input Strategy: Consume a double value from fuzzer data.
        // Memory Management: cJSON_CreateNumber allocates a cJSON object,
        //                    managed by the replacement_item unique_ptr initially.
        double num_value_for_item = fdp.ConsumeFloatingPoint<double>();
        replacement_item.reset(cJSON_CreateNumber(num_value_for_item));


        // --- API 3: cJSON_ReplaceItemInObject ---
        // Description: Replaces an item in a cJSON object. If key doesn't exist, it adds.
        // Input Strategy: If root_json is an object and replacement_item was created,
        //                 consume a string for the key and attempt to replace using either
        //                 case-sensitive or case-insensitive replacement.
        // Memory Management: If successful, root_json takes ownership of replacement_item.
        //                    If unsuccessful, replacement_item remains owned by its unique_ptr.
        if (cJSON_IsObject(root_json.get()) && replacement_item) {
            std::string key_for_replacement = fdp.ConsumeRandomLengthString(std::min((size_t)32, fdp.remaining_bytes()));
            cJSON_bool case_sensitive_replace = fdp.ConsumeBool();

            // Release ownership from the unique_ptr before passing to the replace function,
            // as the replace function takes ownership on success.
            cJSON* released_replacement_item = replacement_item.release();

            cJSON_bool replace_success;
            if (case_sensitive_replace) {
                replace_success = cJSON_ReplaceItemInObjectCaseSensitive(root_json.get(), key_for_replacement.c_str(), released_replacement_item);
            } else {
                replace_success = cJSON_ReplaceItemInObject(root_json.get(), key_for_replacement.c_str(), released_replacement_item);
            }

            if (!replace_success) {
                // If replacement failed, the item was not adopted by the parent, so we must delete it manually.
                cJSON_Delete(released_replacement_item);
            }
        }

        // --- API 2: cJSON_Print and cJSON_PrintUnformatted ---
        // Description: Prints a cJSON item to a string with or without formatting.
        // Input Strategy: Use the root_json object.
        // Memory Management: The returned char* buffer is managed by unique_ptr with CJSONPrintDeleter.
        printed_json_formatted.reset(cJSON_Print(root_json.get()));
        printed_json_unformatted.reset(cJSON_PrintUnformatted(root_json.get()));
    }

    // The destructors of root_json, item_to_add, replacement_item, printed_json_formatted, and printed_json_unformatted
    // unique_ptrs will automatically call their respective deleters (SafeCJSONDelete or CJSONPrintDeleter),
    // ensuring all allocated memory is properly freed.

    return 0; // Indicate successful execution to the fuzzer.
}[0m
