             // SafeCJSONDelete(obj); return nullptr;
             // But sticking to minimal changes, and current logic of addItemToObj, this is fine.
        }


        int num_array_elements = fdp.ConsumeIntegralInRange<int>(0, 3);
        for (int i = 0; i < num_array_elements; ++i) {
            cJSON* arr_elem = nullptr;
            switch(fdp.ConsumeIntegralInRange<int>(0,2)) {
                case 0: arr_elem = cJSON_CreateString(fdp.ConsumeRandomLengthString(5).c_str()); break;
                case 1: arr_elem = cJSON_CreateNumber(fdp.ConsumeIntegral<int>()); break; // This is fine, CreateNumber takes double, int promotes.
                case 2: arr_elem = cJSON_CreateBool(fdp.ConsumeBool()); break;
            }
            if (!addItemToArrayAndCheck(arr, arr_elem)) { // arr_elem is now owned by arr if non-null
                SafeCJSONDelete(obj); return nullptr; // If element creation or addition fails
            }
        }
    }
    return obj;
}

