// Include the main cJSON header as specified with project-relative path.
// This provides standard cJSON types and functions.
#include "/src/cjson/cJSON.h"

// Forward declarations for the custom target APIs from cjson_wo_exist's cJSON.c,
// as they are not declared in its cJSON.h and are causing linker errors.
// These declarations assume C linkage.
extern "C" {
    // Custom print function from cJSON.c as per API list.
    // Signature: `unsigned char * print(const cJSON *, cJSON_bool, const struct internal_hooks *)`
    // Assuming `const const cJSON*` is a typo for `const cJSON*`.
    // Assuming `internal_hooks` is an opaque struct type; we will pass nullptr for the hooks parameter.
    struct internal_hooks; // Forward declaration for the opaque struct type.
    unsigned char* print(const cJSON *item, cJSON_bool format, const struct internal_hooks *hooks);

    // Custom replace_item_in_object function from cJSON.c as per API list.
    // Signature: `cJSON_bool replace_item_in_object(cJSON *, const char *, cJSON *, cJSON_bool)`
    cJSON_bool replace_item_in_object(cJSON *object, const char *string, cJSON *replacement, cJSON_bool custom_param_bool);
}

// Helper function to create a diverse cJSON item using FuzzedDataProvider.
// This helps in generating varied structures for testing.
// 'depth' controls recursion to prevent overly complex objects.
static cJSON* CreateFuzzedCJSONObject(FuzzedDataProvider& fdp, int depth) {
    // Base case for recursion depth to prevent stack overflow or excessively large objects.
    if (depth <= 0) {
        return cJSON_CreateString(fdp.ConsumeRandomLengthString(16).c_str());
    }

    // Consume an integer to decide the type of cJSON item to create.
    uint8_t type = fdp.ConsumeIntegralInRange<uint8_t>(0, 5);
    switch (type) {
        case 0: // Null
            return cJSON_CreateNull();
        case 1: // Bool
            return cJSON_CreateBool(fdp.ConsumeBool());
        case 2: // Number (double)
            return cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>());
        case 3: // String
            return cJSON_CreateString(fdp.ConsumeRandomLengthString(32).c_str());
        case 4: { // Array
            cJSON* arr = cJSON_CreateArray();
            if (!arr) return nullptr; // Allocation failed
            int num_items = fdp.ConsumeIntegralInRange<uint8_t>(0, 3); // Limit items in array
            for (int i = 0; i < num_items; ++i) {
                cJSON* item = CreateFuzzedCJSONObject(fdp, depth - 1); // Recursively create items
                if (item) {
                    cJSON_AddItemToArray(arr, item); // cJSON_AddItemToArray takes ownership of item.
                }
            }
            return arr;
        }
        case 5: // Object
        default: { // Default to Object
            cJSON* obj = cJSON_CreateObject();
            if (!obj) return nullptr; // Allocation failed
            int num_items = fdp.ConsumeIntegralInRange<uint8_t>(0, 3); // Limit items in object
            for (int i = 0; i < num_items; ++i) {
                std::string key = fdp.ConsumeRandomLengthString(16);
                // Ensure key is not empty if we intend to add multiple distinct items,
                // though cJSON might handle empty keys in specific ways.
                if (key.empty() && num_items > 1) {
                    key = "fallback_key";
                }
                cJSON* item = CreateFuzzedCJSONObject(fdp, depth - 1); // Recursively create items
                if (item) {
                    cJSON_AddItemToObject(obj, key.c_str(), item); // cJSON_AddItemToObject takes ownership of item.
                }
            }
            return obj;
        }
    }
}

// Main fuzzing entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // 1. Create a root cJSON object to operate on.
    cJSON *root = cJSON_CreateObject();
    if (!root) {
        // If root creation fails, cannot proceed.
        return 0;
    }

    // Optionally, add some initial fuzzed items to the root object.
    // This provides a more complex base state for `replace_item_in_object`.
    int initial_items_count = fdp.ConsumeIntegralInRange<uint8_t>(0, 2);
    for (int i = 0; i < initial_items_count; ++i) {
        std::string key = fdp.ConsumeRandomLengthString(10);
        if (key.empty() && initial_items_count > 1) key = "initial_key"; // Basic handling for empty keys
        if (!key.empty()) {
             cJSON* item = CreateFuzzedCJSONObject(fdp, 2); // Create a random item with limited depth
             if (item) {
                // cJSON_AddItemToObject takes ownership of 'item'.
                // No separate deletion of 'item' is needed.
                cJSON_AddItemToObject(root, key.c_str(), item);
             }
        }
    }

    // 2. Prepare for and call `replace_item_in_object`.
    std::string replace_key = fdp.ConsumeRandomLengthString(20);
    // Create a new cJSON item to be used as the replacement.
    cJSON *replacement_item = CreateFuzzedCJSONObject(fdp, 2); // Limited depth

    // The `replacement_item` is "given away" to `replace_item_in_object` if it's not NULL.
    // `replace_item_in_object` takes ownership of `replacement_item`.
    // The old item at `replace_key` (if any) is deleted by `replace_item_in_object`.
    // The fourth parameter's meaning is unknown, so we fuzz it as a boolean.
    cJSON_bool custom_param_bool_val = fdp.ConsumeBool();
    replace_item_in_object(root, replace_key.c_str(), replacement_item, custom_param_bool_val);
    // After this call, `replacement_item` (if not NULL) is owned by `root`.
    // It should not be deleted separately. If `replacement_item` was NULL, that's also handled.

    // 3. Call the custom `print` function on the potentially modified `root` object.
    // The `hooks` parameter is passed as nullptr, assuming default behavior or opaque type.
    cJSON_bool format_print_output = fdp.ConsumeBool();
    unsigned char *printed_json_uchars = print(root, format_print_output, nullptr);

    // Memory Management: The string returned by `print` must be freed.
    if (printed_json_uchars) {
        // Use standard `cJSON_free` for freeing memory from cJSON's print functions.
        cJSON_free(printed_json_uchars);
        printed_json_uchars = nullptr; // Best practice after freeing.
    }

    // 4. Clean up: Call standard `cJSON_Delete` on the root cJSON object.
    // This function is responsible for recursively deleting `root` and all its children,
    // including `replacement_item` if it was successfully added/replaced.
    cJSON_Delete(root);
    root = nullptr; // Best practice after deleting.

    return 0;
}[0m
