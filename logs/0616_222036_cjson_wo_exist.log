// cJSON.h is expected to declare cJSON_Delete.
extern "C" {
    // API from /src/cjson/cJSON.c
    // Signature: cJSON_bool replace_item_in_object(cJSON *, const char *, cJSON *, cJSON_bool)
    cJSON_bool replace_item_in_object(cJSON *object, const char *string, cJSON *replacement, cJSON_bool case_sensitive);

    // API from /src/cjson/cJSON.c
    // Signature: unsigned char * print(const const cJSON *, cJSON_bool, const const internal_hooks *)
    // Interpreted as:
    unsigned char* print(const cJSON *item, cJSON_bool format, const struct internal_hooks *hooks);
