// Main fuzzing entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    std::function<cJSON*(FuzzedDataProvider&, int)> create_fuzzed_json_item =
        [&](FuzzedDataProvider& provider, int depth) -> cJSON* {
        if (depth > 3) {
            return cJSON_CreateNull();
        }

        uint8_t type_selector = provider.ConsumeIntegralInRange<uint8_t>(0, 5);
        switch (type_selector) {
            case 0:
                return cJSON_CreateNull();
            case 1:
                return cJSON_CreateBool(provider.ConsumeBool());
            case 2:
                return cJSON_CreateNumber(provider.ConsumeFloatingPointInRange<double>(-1e10, 1e10));
            case 3:
                return cJSON_CreateString(provider.ConsumeRandomLengthString(64).c_str());
            case 4:
                {
                    cJSON* arr = cJSON_CreateArray();
                    if (!arr) return nullptr;
                    int num_items = provider.ConsumeIntegralInRange<int>(0, 3);
                    for (int i = 0; i < num_items; ++i) {
                        cJSON* item = create_fuzzed_json_item(provider, depth + 1);
                        if (item) {
                            cJSON_AddItemToArray(arr, item);
                        }
                    }
                    return arr;
                }
            case 5:
                 {
                    cJSON* obj = cJSON_CreateObject();
                    if (!obj) return nullptr;
                    int num_items = provider.ConsumeIntegralInRange<int>(0, 3);
                    for (int i = 0; i < num_items; ++i) {
                        std::string item_key = provider.ConsumeRandomLengthString(16);
                        cJSON* item = create_fuzzed_json_item(provider, depth + 1);
                        if (item) {
                            cJSON_AddItemToObject(obj, item_key.c_str(), item);
                        }
                    }
                    return obj;
                }
            default:
                return cJSON_CreateNull();
        }
    };

    cJSON *root_obj = cJSON_CreateObject();
    if (!root_obj) {
        return 0;
    }

    cJSON *replacement_item = create_fuzzed_json_item(fdp, 0);
    if (!replacement_item) {
        cJSON_Delete(root_obj); // Use cJSON_Delete instead of SafeCJSONDelete
        return 0;
    }

    std::string key_str = fdp.ConsumeRandomLengthString(32);
    cJSON_bool replace_case_sensitive = fdp.ConsumeBool();

    cJSON_bool replaced_successfully = replace_item_in_object(root_obj, key_str.c_str(), replacement_item, replace_case_sensitive);

    if (!replaced_successfully) {
        cJSON_Delete(replacement_item); // Use cJSON_Delete instead of SafeCJSONDelete
    }

    cJSON_bool format_print = fdp.ConsumeBool();
    unsigned char *printed_json_uchars = print(root_obj, format_print, nullptr);

    if (printed_json_uchars) {
        free(reinterpret_cast<void*>(printed_json_uchars)); // Use free instead of SafeCJSONFree
    }

    cJSON_Delete(root_obj); // Use cJSON_Delete instead of SafeCJSONDelete

    return 0;
}[0m
