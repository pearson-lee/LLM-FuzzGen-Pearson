    }

    // Add a null field
    if (fdp.ConsumeBool()) {
        if (!addItemToObj(fdp.ConsumeRandomLengthString(5).c_str(), cJSON_CreateNull())) {
            SafeCJSONDelete(obj); return nullptr;
        }
    }
    
    // Add an array field with some elements
    if (fdp.ConsumeBool()) {
        cJSON* arr = cJSON_CreateArray();
        if (!arr) {
            SafeCJSONDelete(obj); return nullptr;
        }
        // Add array to object; arr is now owned by obj
        if (!addItemToObj(fdp.ConsumeRandomLengthString(5).c_str(), arr)) {
             // This block is effectively unreachable if arr is non-null, as addItemToObj would return true.
             // If arr were null, it's caught above. If cJSON_AddItemToObject fails internally (e.g. null key),
             // cJSON handles it, but addItemToObj would still return true.
             // For safety, if addItemToObj were to fail for other reasons, this would be a leak of 'arr'.
             // However, given its definition, this path shouldn't be taken if arr is non-null.
             // To be absolutely safe under hypothetical modifications to addItemToObj or cJSON_AddItemToObject behavior:
