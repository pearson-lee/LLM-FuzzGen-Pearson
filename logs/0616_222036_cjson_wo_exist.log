            cJSON_Delete(obj); return nullptr;
        }
    }

    if (fdp.ConsumeBool()) {
        if (!addItemToObj(fdp.ConsumeRandomLengthString(5).c_str(), cJSON_CreateNull())) {
            cJSON_Delete(obj); return nullptr;
        }
    }
    
    if (fdp.ConsumeBool()) {
        cJSON* arr = cJSON_CreateArray();
        if (!arr) {
            cJSON_Delete(obj); return nullptr;
        }
        if (!addItemToObj(fdp.ConsumeRandomLengthString(5).c_str(), arr)) {
            // This case implies 'arr' was null, which is checked above, or AddItemToObject failed internally.
            // If arr was non-null but AddItemToObject failed to add it, arr would leak if not owned by obj.
            // However, AddItemToObject takes ownership. If it failed before that, cJSON_Delete(arr) would be needed.
            // Given current logic, if arr is non-null, it's added.
            // If addItemToObj itself failed (e.g. key was null for cJSON_AddItemToObject), obj might be partially built.
            // The original SafeCJSONDelete(obj) would be called. We use cJSON_Delete(obj).
            cJSON_Delete(obj); return nullptr;
