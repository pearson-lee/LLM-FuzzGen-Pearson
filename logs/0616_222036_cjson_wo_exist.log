        case 2: // Number (double)
            return cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>());
        case 3: // String
            return cJSON_CreateString(fdp.ConsumeRandomLengthString(32).c_str());
        case 4: { // Array
            cJSON* arr = cJSON_CreateArray();
            if (!arr) return nullptr; // Allocation failed
            int num_items = fdp.ConsumeIntegralInRange<uint8_t>(0, 3); // Limit items in array
