// Helper function to create a cJSON object with some متنوع content.
// Uses SafeCJSONDelete for cleanup on failure, as it's the library's designated deleter.
cJSON* CreateDiverseJSONObject(FuzzedDataProvider &fdp) {
    cJSON *obj = cJSON_CreateObject();
    if (!obj) {
        return nullptr;
    }

    // Lambda to simplify adding items and handling potential allocation failures.
    auto addItemToObj = [&](const char* key, cJSON* item_to_add) -> bool {
        if (!item_to_add) { // If item creation failed
            // SafeCJSONDelete(obj); // obj will be deleted by the caller if this helper returns nullptr
            return false;
        }
        cJSON_AddItemToObject(obj, key, item_to_add); // cJSON_AddItemToObject takes ownership of item_to_add
        return true;
    };
    
    auto addItemToArrayAndCheck = [&](cJSON* array_obj, cJSON* item_to_add) -> bool {
        if (!item_to_add) {
            return false;
        }
        cJSON_AddItemToArray(array_obj, item_to_add);
        return true;
    };


    // Add a string field
    if (fdp.ConsumeBool()) {
        if (!addItemToObj(fdp.ConsumeRandomLengthString(5).c_str(), cJSON_CreateString(fdp.ConsumeRandomLengthString(20).c_str()))) {
            SafeCJSONDelete(obj); return nullptr;
        }
    }

    // Add a number field
    if (fdp.ConsumeBool()) {
        if (!addItemToObj(fdp.ConsumeRandomLengthString(5).c_str(), cJSON_CreateNumber(fdp.ConsumeIntegral<double>()))) {
            SafeCJSONDelete(obj); return nullptr;
        }
    }

    // Add a boolean field
    if (fdp.ConsumeBool()) {
        if (!addItemToObj(fdp.ConsumeRandomLengthString(5).c_str(), cJSON_CreateBool(fdp.ConsumeBool()))) {
            SafeCJSONDelete(obj); return nullptr;
        }
    }

    // Add a null field
    if (fdp.ConsumeBool()) {
        if (!addItemToObj(fdp.ConsumeRandomLengthString(5).c_str(), cJSON_CreateNull())) {
            SafeCJSONDelete(obj); return nullptr;
        }
    }
    
    // Add an array field with some elements
    if (fdp.ConsumeBool()) {
        cJSON* arr = cJSON_CreateArray();
        if (!arr) {
            SafeCJSONDelete(obj); return nullptr;
        }
        // Add array to object; arr is now owned by obj
        if (!addItemToObj(fdp.ConsumeRandomLengthString(5).c_str(), arr)) {
             // If addItemToObj fails here, it means 'arr' (as item_to_add) was null, which we checked.
             // Or, if addItemToObj itself had a different failure mode.
             // cJSON_AddItemToObject would have handled arr if it was null.
             // If arr was not null but addItemToObj failed before adding, arr would leak.
             // However, addItemToObj's contract is that it takes ownership or returns false if item_to_add is null.
