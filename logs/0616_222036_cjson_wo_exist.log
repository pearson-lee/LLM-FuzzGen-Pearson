    if (fdp.ConsumeBool()) {
        if (!addItemToObj(fdp.ConsumeRandomLengthString(5).c_str(), cJSON_CreateString(fdp.ConsumeRandomLengthString(20).c_str()))) {
            SafeCJSONDelete(obj); return nullptr;
        }
    }

    // Add a number field
    if (fdp.ConsumeBool()) {
        if (!addItemToObj(fdp.ConsumeRandomLengthString(5).c_str(), cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>()))) {
            SafeCJSONDelete(obj); return nullptr;
        }
    }

