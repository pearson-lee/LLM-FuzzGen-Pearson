                cJSON* item = CreateFuzzedCJSONObject(fdp, depth - 1); // Recursively create items
                if (item) {
                    cJSON_AddItemToArray(arr, item); // cJSON_AddItemToArray takes ownership of item.
                }
            }
            return arr;
        }
        case 5: // Object
        default: { // Default to Object
            cJSON* obj = cJSON_CreateObject();
            if (!obj) return nullptr; // Allocation failed
            int num_items = fdp.ConsumeIntegralInRange<uint8_t>(0, 3); // Limit items in object
            for (int i = 0; i < num_items; ++i) {
                std::string key = fdp.ConsumeRandomLengthString(16);
