// List of core cJSON API functionalities exercised by this fuzzer:
// 1. Object Creation: cJSON_CreateObject()
// 2. Item Creation: cJSON_CreateString(), cJSON_CreateNumber(), cJSON_CreateBool()
// 3. Object Modification:
//    - cJSON_AddItemToObject()
//    - cJSON_ReplaceItemInObject() (covers case-insensitive replacement logic)
//    - cJSON_ReplaceItemInObjectCaseSensitive() (covers case-sensitive replacement logic)
// 4. Serialization/Printing:
//    - cJSON_PrintUnformatted() (exercises internal print logic, including buffer management like 'ensure')
//    - cJSON_Print() (exercises internal print logic with formatting)
// 5. Memory Management:
//    - cJSON_Delete() (handles deletion of cJSON objects and their children, covering CJSONDeleter/SafeCJSONDelete concepts)
//    - cJSON_free() (frees memory allocated by cJSON, e.g., for strings from print functions, covering SafeCJSONFree concepts)
//
// These functions collectively cover the functionalities mentioned in the API information,
// particularly 'print', 'replace_item_in_object', and various deletion/free mechanisms.

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // 1. Create a root JSON object.
    // This is a foundational step for most object-based operations.
    cJSON *root = cJSON_CreateObject();
    if (!root) {
        // If creation fails (e.g., out of memory), nothing more to do.
        return 0;
    }

    // Determine number of operations to simulate diverse interactions and complex states.
    int num_operations = fdp.ConsumeIntegralInRange<int>(1, 10); // Modest number of ops to balance depth and breadth

    for (int i = 0; i < num_operations; ++i) {
        // Consume a choice for which operation to perform to ensure diverse API usage.
        uint8_t operation_choice = fdp.ConsumeIntegralInRange<uint8_t>(0, 5);

        // Generate a key for object operations. Max length 32.
        // Allow empty or unusual keys to test cJSON's robustness.
        std::string key = fdp.ConsumeRandomLengthString(32);

        switch (operation_choice) {
            case 0: {
                // Add a string item to the object.
                std::string value_str = fdp.ConsumeRandomLengthString(64); // Max length 64 for string value.
                cJSON *item_to_add = cJSON_CreateString(value_str.c_str());
                if (item_to_add) {
                    // cJSON_AddItemToObject takes ownership of item_to_add.
                    // No need to manually delete item_to_add if this call is made.
                    cJSON_AddItemToObject(root, key.c_str(), item_to_add);
                }
                break;
            }
            case 1: {
                // Replace an item in the object (case-insensitive by default for this function).
                std::string new_value_str = fdp.ConsumeRandomLengthString(64);
                cJSON *new_item = cJSON_CreateString(new_value_str.c_str());
                if (new_item) {
                    // cJSON_ReplaceItemInObject takes ownership of new_item.
                    // It also handles deletion of the old item if one is replaced.
                    cJSON_ReplaceItemInObject(root, key.c_str(), new_item);
                }
                break;
            }
            case 2: {
                // Replace an item in the object (case-sensitive).
                // This addresses the 'cJSON_bool case_sensitive' aspect from the API list.
                std::string new_value_cs_str = fdp.ConsumeRandomLengthString(64);
                cJSON *new_item_cs = cJSON_CreateString(new_value_cs_str.c_str());
                if (new_item_cs) {
                    cJSON_ReplaceItemInObjectCaseSensitive(root, key.c_str(), new_item_cs);
                }
                break;
            }
            case 3: {
                // Add a number item to the object.
                double num_val = fdp.ConsumeBool() ? static_cast<double>(fdp.ConsumeIntegral<int>()) : fdp.ConsumeFloatingPoint<double>();
                cJSON* num_item = cJSON_CreateNumber(num_val);
                if (num_item) {
                    // cJSON_AddItemToObject takes ownership of num_item.
                    cJSON_AddItemToObject(root, key.c_str(), num_item);
                }
                break;
            }
            case 4: {
                // Add a boolean item to the object.
                cJSON* bool_item = cJSON_CreateBool(fdp.ConsumeBool());
                if (bool_item) {
                     cJSON_AddItemToObject(root, key.c_str(), bool_item);
                }
                break;
            }
            case 5: {
                // Add a null item to the object.
                cJSON* null_item = cJSON_CreateNull();
                if (null_item) {
                    cJSON_AddItemToObject(root, key.c_str(), null_item);
                }
                break;
            }
        }
    }

    // Serialize the JSON object to a string (unformatted).
    // This exercises the internal printing logic (e.g., 'print' and 'ensure' from API list).
    char *printed_json_unformatted = cJSON_PrintUnformatted(root);
    if (printed_json_unformatted) {
        // Memory management: The string returned by cJSON_PrintUnformatted must be freed.
        // cJSON_free is the appropriate function. This covers SafeCJSONFree functionality.
        cJSON_free(printed_json_unformatted);
    }

    // Serialize the JSON object to a string (formatted).
    // This exercises different paths in the internal printing logic (related to 'cJSON_bool fmt').
    char *printed_json_formatted = cJSON_Print(root);
    if (printed_json_formatted) {
        // Memory management: Also free this string.
        cJSON_free(printed_json_formatted);
    }

    // Delete the root JSON object and all its children.
    // This is crucial for memory safety and cleans up all cJSON items created and added to 'root'.
    // This covers the functionality of CJSONDeleter and SafeCJSONDelete.
    cJSON_Delete(root);

    return 0;
}[0m
