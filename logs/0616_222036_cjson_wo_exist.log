// Helper function to create a cJSON item of a random type.
// This function is responsible for creating cJSON items that will be managed (added to parent or deleted) by the caller.
cJSON* CreateRandomJsonItem(FuzzedDataProvider& fdp) {
    // Ensure there's enough data to make meaningful choices and create items.
    // This also acts as a simple mechanism to control recursion depth if this function were to call itself.
    if (fdp.remaining_bytes() < 20 && fdp.ConsumeIntegralInRange<uint8_t>(0,3) > 0) { // Probabilistically return null if low on data
        return nullptr;
    }

    // Consume a byte to determine the type of cJSON item to create.
    uint8_t type_choice = fdp.ConsumeIntegralInRange<uint8_t>(0, 5);

    switch (type_choice) {
        case 0: // Create a cJSON String item
            return cJSON_CreateString(fdp.ConsumeRandomLengthString(32).c_str());
        case 1: // Create a cJSON Number item
            return cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>());
        case 2: // Create a cJSON Boolean item
            return cJSON_CreateBool(fdp.ConsumeBool());
        case 3: // Create a cJSON Null item
            return cJSON_CreateNull();
        case 4: // Create a cJSON Array item
        {
            cJSON* arr = cJSON_CreateArray();
            if (!arr) return nullptr; // Allocation failed
            // Add a small number of simple items to the array to keep complexity manageable.
            int num_array_items = fdp.ConsumeIntegralInRange<int>(0, 2);
            for (int i = 0; i < num_array_items; ++i) {
                cJSON* arr_item = nullptr;
                // Create simple, non-nested items for the array.
                if (fdp.ConsumeBool()) {
                    arr_item = cJSON_CreateString(fdp.ConsumeRandomLengthString(10).c_str());
                } else {
                    arr_item = cJSON_CreateNumber(fdp.ConsumeIntegral<int32_t>());
                }
                if (arr_item) {
                    // cJSON_AddItemToArray takes ownership of arr_item if successful.
                    cJSON_AddItemToArray(arr, arr_item);
                }
            }
            return arr;
        }
        case 5: // Create a cJSON Object item
        {
            cJSON* obj = cJSON_CreateObject();
            if (!obj) return nullptr; // Allocation failed
            // Add a small number of simple items to the object.
            int num_obj_items = fdp.ConsumeIntegralInRange<int>(0, 2);
            for (int i = 0; i < num_obj_items; ++i) {
                std::string item_key = fdp.ConsumeRandomLengthString(10);
                // Ensure key is not an empty pointer if string is empty, though cJSON might handle ""
                // Using .c_str() on an empty std::string is safe and returns a pointer to '\0'.
                
                cJSON* obj_item = nullptr;
                // Create simple, non-nested items for the object.
                if (fdp.ConsumeBool()) {
                    obj_item = cJSON_CreateString(fdp.ConsumeRandomLengthString(10).c_str());
                } else {
                    obj_item = cJSON_CreateNumber(fdp.ConsumeIntegral<int32_t>());
                }

                if (obj_item) {
                    // cJSON_AddItemToObject takes ownership of obj_item if successful.
                    cJSON_AddItemToObject(obj, item_key.c_str(), obj_item);
                }
            }
            return obj;
        }
        default:
            // Should not happen with ConsumeIntegralInRange, but as a fallback:
            return cJSON_CreateNull();
    }
}

// Fuzz target entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // 1. Create a root cJSON object.
    cJSON *root = cJSON_CreateObject();
    if (!root) {
        // If root creation fails, nothing else can be done.
        return 0;
    }

    // 2. Add some initial items to the object.
    // Keys are stored to potentially be used in cJSON_ReplaceItemInObject.
    std::vector<std::string> keys;
    int num_initial_items = fdp.ConsumeIntegralInRange<int>(0, 4); // Max 4 initial items
    for (int i = 0; i < num_initial_items; ++i) {
        std::string key = fdp.ConsumeRandomLengthString(16); // Generate a key for the item
        keys.push_back(key); // Store key regardless of whether item creation succeeds

        cJSON *item = CreateRandomJsonItem(fdp); // Create a random cJSON item
        if (item) {
            // cJSON_AddItemToObject takes ownership of 'item' upon successful addition.
            // If it fails (e.g. due to memory), 'item' is not added and remains our responsibility.
            // However, cJSON_AddItemToObject doesn't have a clear failure return for this case,
            // assuming it succeeds if item and root are valid.
            cJSON_AddItemToObject(root, key.c_str(), item);
        }
        // If 'item' is null (creation failed), nothing is added for this iteration.
    }

    // 3. Attempt to replace an item in the object using cJSON_ReplaceItemInObject.
    // This targets the 'replace_item_in_object' static function.
    if (fdp.ConsumeBool()) { // Decide whether to attempt replacement
        cJSON *new_item = CreateRandomJsonItem(fdp); // Create a new item for replacement
        if (new_item) {
            std::string key_to_replace;
            if (!keys.empty() && fdp.ConsumeBool()) {
                // Try to replace an existing key
                key_to_replace = fdp.PickValueInArray(keys);
            } else {
                // Try to replace a (potentially) non-existent key
                key_to_replace = fdp.ConsumeRandomLengthString(16);
            }

            // cJSON_ReplaceItemInObject takes ownership of new_item if successful (returns true).
            // If it fails (e.g., key not found, or new_item is invalid type for context),
            // new_item is NOT added, and we must delete it.
            // The old item associated with key_to_replace (if any) is deleted by cJSON_ReplaceItemInObject.
            if (!cJSON_ReplaceItemInObject(root, key_to_replace.c_str(), new_item)) {
                cJSON_Delete(new_item); // new_item was not taken by root, so we delete it.
            }
        }
    }

    // 4. Print the resulting JSON object.
    // This targets the static 'print' function and indirectly 'ensure' for buffer management.
    if (fdp.ConsumeBool()) { // Test cJSON_PrintUnformatted
        // cJSON_PrintUnformatted allocates a string.
        char *printed_json_unformatted = cJSON_PrintUnformatted(root);
        if (printed_json_unformatted) {
            // The returned string must be freed using cJSON_free (or the custom free if hooks are used).
            cJSON_free(printed_json_unformatted);
        }
    }
    
    if (fdp.ConsumeBool()) { // Test cJSON_PrintBuffered
        int buffer_size = fdp.ConsumeIntegralInRange<int>(1, 1024); // Initial buffer size
        cJSON_bool format_json = fdp.ConsumeBool(); // Whether to format the output
        // cJSON_PrintBuffered also allocates a string.
        char *printed_json_buffered = cJSON_PrintBuffered(root, buffer_size, format_json);
        if (printed_json_buffered) {
            // The returned string must be freed.
            cJSON_free(printed_json_buffered);
        }
    }


    // 5. Delete the root cJSON object.
    // This recursively deletes all items that were successfully added to it,
    // including those added by cJSON_AddItemToObject and successful cJSON_ReplaceItemInObject calls.
    cJSON_Delete(root);

    return 0;
}[0m
