#include "/src/cjson/cJSON.h" // Required for cJSON functions
#include <fuzzer/FuzzedDataProvider.h>

#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>

// Assume these are provided by the cjson_wo_exist library environment.
// Based on "API Information" with 0% coverage, these are targeted.
// The signature for SafeCJSONFree was `void SafeCJSONFree(void &*)` which is not valid C/C++.
// Assuming it's `void SafeCJSONFree(void* ptr)` similar to `free` or `cJSON_free`.
extern "C" {
void SafeCJSONDelete(cJSON* item);
void SafeCJSONFree(void* ptr);
}

// Maximum depth for recursively creating JSON objects to prevent stack overflow or excessive complexity.
const int MAX_JSON_DEPTH = 3;

// Helper function to create a cJSON object with random type and content.
// This function is recursive for creating nested arrays and objects.
// Memory management: cJSON objects created here are either returned (caller owns)
// or attached to a parent cJSON object (parent owns).
cJSON* CreateRandomCJSONObject(FuzzedDataProvider& fdp, int depth) {
    // Base case for recursion: if max depth is reached, create a simple type.
    if (depth <= 0) {
        uint8_t simple_type = fdp.ConsumeIntegralInRange<uint8_t>(0, 3);
        switch (simple_type) {
            case 0:
                return cJSON_CreateNull();
            case 1:
                return cJSON_CreateBool(fdp.ConsumeBool());
            case 2:
                return cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>());
            case 3:
            default: {
                std::string str_val = fdp.ConsumeRandomLengthString(32);
                return cJSON_CreateString(str_val.c_str());
            }
        }
    }

    // Choose a random cJSON type to create.
    uint8_t type = fdp.ConsumeIntegralInRange<uint8_t>(0, 5);
    switch (type) {
        case 0: // Null
            return cJSON_CreateNull();
        case 1: // Bool
            return cJSON_CreateBool(fdp.ConsumeBool());
        case 2: // Number
            return cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>());
        case 3: // String
        {
            std::string str_val = fdp.ConsumeRandomLengthString(100);
            return cJSON_CreateString(str_val.c_str());
        }
        case 4: // Array
        {
            cJSON* arr = cJSON_CreateArray();
            if (!arr) return nullptr; // Allocation failed
            int num_items = fdp.ConsumeIntegralInRange<int>(0, 3); // Limit items
            for (int i = 0; i < num_items; ++i) {
                cJSON* item = CreateRandomCJSONObject(fdp, depth - 1);
                if (item) {
                    cJSON_AddItemToArray(arr, item); // AddItemToArray takes ownership of 'item'.
                }
            }
            return arr;
        }
        case 5: // Object
        {
            cJSON* obj = cJSON_CreateObject();
            if (!obj) return nullptr; // Allocation failed
            int num_items = fdp.ConsumeIntegralInRange<int>(0, 3); // Limit items
            for (int i = 0; i < num_items; ++i) {
                std::string key = fdp.ConsumeRandomLengthString(20);
                // cJSON_AddItemToObject requires a non-NULL key.
                // An empty string is a valid key.
                // To be safe, and ensure we always try to add if possible:
                if (key.empty() && fdp.ConsumeBool()) { // Occasionally use a default key if empty
                    key = "default_key";
                }
                cJSON* item = CreateRandomCJSONObject(fdp, depth - 1);
                if (item) {
                    // AddItemToObject takes ownership of 'item'.
                    cJSON_AddItemToObject(obj, key.c_str(), item);
                }
            }
            return obj;
        }
        default: // Should not be reached
            return cJSON_CreateNull();
    }
}

// Fuzz target entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Scenario 1: Parse a JSON string, then manipulate and print it.
    std::string json_to_parse = fdp.ConsumeRandomLengthString(512);
    cJSON *root1 = cJSON_Parse(json_to_parse.c_str());

    if (root1) {
        // Test cJSON_PrintUnformatted (exercises 'print' and 'ensure' internals)
        char *printed_json1 = cJSON_PrintUnformatted(root1);
        if (printed_json1) {
            // The string returned by cJSON_PrintUnformatted must be freed.
            SafeCJSONFree(printed_json1);
        }

        // Test manipulation APIs if the root is an object.
        if (cJSON_IsObject(root1)) {
            // Test cJSON_AddItemToObject
            std::string key_to_add = fdp.ConsumeRandomLengthString(32);
            // cJSON_AddItemToObject requires a non-NULL key.
            // An empty string is a valid key.
            if (fdp.ConsumeBool() || !key_to_add.empty()) { // Allow empty keys sometimes, but ensure key is not accidentally NULL
                 cJSON *item_to_add = CreateRandomCJSONObject(fdp, MAX_JSON_DEPTH -1); // Create an item to add
                 if (item_to_add) {
                    // cJSON_AddItemToObject takes ownership of item_to_add.
                    cJSON_AddItemToObject(root1, key_to_add.c_str(), item_to_add);
                 }
            }


            // Test cJSON_ReplaceItemInObject (from API list)
            std::string key_to_replace = fdp.ConsumeRandomLengthString(32);
            if (fdp.ConsumeBool() || !key_to_replace.empty()) {
                cJSON *new_item_for_replacement = CreateRandomCJSONObject(fdp, MAX_JSON_DEPTH -1); // Create a new item for replacement
                if (new_item_for_replacement) {
                    // cJSON_ReplaceItemInObject takes ownership of new_item_for_replacement if successful,
                    // and deletes the old item.
                    if (!cJSON_ReplaceItemInObject(root1, key_to_replace.c_str(), new_item_for_replacement)) {
                        // If replacement failed (e.g., key not found), new_item_for_replacement was not attached
                        // and needs to be deleted to prevent a memory leak.
                        SafeCJSONDelete(new_item_for_replacement);
                    }
                }
            }
        }
        // Clean up the parsed cJSON object.
        SafeCJSONDelete(root1);
    }

    // Scenario 2: Programmatically create a JSON object, then manipulate and print it.
    cJSON *root2 = CreateRandomCJSONObject(fdp, MAX_JSON_DEPTH); // Create a random JSON structure
    if (root2) {
        // Test cJSON_PrintUnformatted
        char *printed_json2 = cJSON_PrintUnformatted(root2);
        if (printed_json2) {
            SafeCJSONFree(printed_json2); // Free the printed string.
        }

        // Test manipulation APIs if the root is an object.
        if (cJSON_IsObject(root2)) {
            // Test cJSON_AddItemToObject
            std::string key_to_add2 = fdp.ConsumeRandomLengthString(32);
            if (fdp.ConsumeBool() || !key_to_add2.empty()) {
                cJSON *item_to_add2 = CreateRandomCJSONObject(fdp, MAX_JSON_DEPTH -1);
                if (item_to_add2) {
                    cJSON_AddItemToObject(root2, key_to_add2.c_str(), item_to_add2);
                }
            }

            // Test cJSON_ReplaceItemInObject
            std::string key_to_replace2 = fdp.ConsumeRandomLengthString(32);
            if (fdp.ConsumeBool() || !key_to_replace2.empty()) {
                cJSON *new_item_for_replacement2 = CreateRandomCJSONObject(fdp, MAX_JSON_DEPTH-1);
                if (new_item_for_replacement2) {
                    if (!cJSON_ReplaceItemInObject(root2, key_to_replace2.c_str(), new_item_for_replacement2)) {
                        SafeCJSONDelete(new_item_for_replacement2); // Delete if not attached.
                    }
                }
            }
        }
        // Clean up the programmatically created cJSON object.
        SafeCJSONDelete(root2);
    }

    return 0;
}[0m
