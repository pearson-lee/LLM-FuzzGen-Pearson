    // This addresses 'Branch (179:13): [True: 0, False: 140]' in the fuzz target coverage.
    cmsHPROFILE hInputProfile = cmsCreate_sRGBProfile(); // Use sRGB profile
    cmsHPROFILE hOutputProfile = cmsCreate_sRGBProfile(); // Use sRGB profile
    cmsHPROFILE hProofingProfile = cmsCreate_sRGBProfile(); // Use sRGB profile

    // Only proceed if all dummy profiles were successfully created.
    if (hInputProfile && hOutputProfile && hProofingProfile) {
        cmsUInt32Number input_format = FuzzedData_ConsumeUInt32(&fd);
        cmsUInt32Number output_format = FuzzedData_ConsumeUInt32(&fd);
        cmsUInt32Number intent = FuzzedData_ConsumeUInt8(&fd) % 4; // Rendering intents are typically 0-3.
        cmsUInt32Number proofing_intent = FuzzedData_ConsumeUInt8(&fd) % 4;
        cmsUInt32Number dwFlags = FuzzedData_ConsumeUInt32(&fd);

        // Try to use common formats to increase success rate
        if (fd.offset < fd.size && FuzzedData_ConsumeUInt8(&fd) % 2 == 0) {
            input_format = TYPE_RGB_8;
            output_format = TYPE_RGB_8;
        } else {
            input_format = TYPE_CMYK_8;
            output_format = TYPE_CMYK_8;
        }

        cmsHTRANSFORM hTransform = cmsCreateProofingTransform(hInputProfile, input_format,
                                                              hOutputProfile, output_format,
                                                              hProofingProfile, intent,
                                                              proofing_intent, dwFlags);
        if (hTransform) {
