// Define a simple "FuzzedDataProvider" like structure for C
// This helps in consuming fuzzer input data in a structured way.
typedef struct {
    const uint8_t *data;
    size_t size;
    size_t offset;
} FuzzedData;

// Helper function to consume a single byte from fuzzer data.
// Returns 0 if no more data is available.
uint8_t FuzzedData_ConsumeUInt8(FuzzedData *fd) {
    if (fd->offset < fd->size) {
        return fd->data[fd->offset++];
    }
    return 0;
}

// Helper function to consume a 32-bit unsigned integer from fuzzer data.
// Bytes are consumed in big-endian order. Returns 0 if not enough data.
uint32_t FuzzedData_ConsumeUInt32(FuzzedData *fd) {
    uint32_t val = 0;
    size_t bytes_to_read = 4;
    if (fd->offset + bytes_to_read > fd->size) {
        bytes_to_read = fd->size - fd->offset; // Consume remaining bytes
    }
    for (size_t i = 0; i < bytes_to_read; ++i) {
        val = (val << 8) | fd->data[fd->offset++];
    }
    return val;
}

// Helper function to consume an 8-byte double from fuzzer data.
// This directly interprets 8 bytes as a double. This can produce
// unusual floating-point values (NaN, Inf), which is good for fuzzing.
double FuzzedData_ConsumeDouble(FuzzedData *fd) {
    uint64_t val_u64 = 0;
    size_t bytes_to_read = 8;
    if (fd->offset + bytes_to_read > fd->size) {
        bytes_to_read = fd->size - fd->offset; // Consume remaining bytes
    }
    for (size_t i = 0; i < bytes_to_read; ++i) {
        val_u64 = (val_u64 << 8) | fd->data[fd->offset++];
    }
    // Use a union or memcpy for type-punning to avoid strict aliasing issues
    union {
        uint64_t u;
        double d;
    } u_val;
    u_val.u = val_u64;
    return u_val.d;
}

// Helper function to consume a limited-length null-terminated string.
// Returns a pointer to a newly allocated string, which must be freed by the caller.
// Returns NULL if not enough data or if the fuzzed length is zero.
char* FuzzedData_ConsumeSizedString(FuzzedData *fd, size_t max_chars) {
    if (fd->offset >= fd->size) return NULL;

    size_t bytes_to_consume = FuzzedData_ConsumeUInt8(fd); // Use one byte for length
    if (bytes_to_consume == 0) return NULL; // Avoid zero-length strings

    if (bytes_to_consume > max_chars) bytes_to_consume = max_chars;

    size_t remaining_data = fd->size - fd->offset;
    if (bytes_to_consume > remaining_data) {
        bytes_to_consume = remaining_data;
    }

    if (bytes_to_consume == 0) return NULL; // Still might be zero if remaining_data was too small

    char* str = (char*)malloc(bytes_to_consume + 1);
    if (!str) return NULL;

    memcpy(str, fd->data + fd->offset, bytes_to_consume);
    str[bytes_to_consume] = '\0';
    fd->offset += bytes_to_consume;
    return str;
}


