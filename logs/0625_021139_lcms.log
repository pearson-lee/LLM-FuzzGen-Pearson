// The file is automatically deleted when closed or on program exit.
FILE* create_temp_file(const uint8_t *data, size_t size) {
    FILE *f = tmpfile();
    if (f) {
        fwrite(data, 1, size, f);
        rewind(f); // Rewind to the beginning for reading
    }
    return f;
}

