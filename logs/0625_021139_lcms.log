    // Moved up to increase chances of execution.
    if (current_size > (32 + 32 + sizeof(cmsFloat64Number) + 32 + 32 + 64)) { // Enough data for two IT8 operations
        cmsHANDLE hIT8 = cmsIT8Alloc(ContextID); // Allocate an IT8 handle
