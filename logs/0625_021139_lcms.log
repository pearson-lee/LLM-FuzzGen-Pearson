char* get_fuzzed_string(const uint8_t** Data, size_t* Size, size_t max_len) {
    if (*Size == 0) {
        return NULL;
    }
    size_t len = *Size > max_len ? max_len : *Size;
    char* str = (char*)malloc(len + 1);
    if (str == NULL) {
        return NULL;
    }
    memcpy(str, *Data, len);
    str[len] = '\0';
    *Data += len;
    *Size -= len;
    return str;
}

