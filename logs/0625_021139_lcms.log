fuzz target: 
// This fuzz target for the lcms library aims to maximize code coverage by
// strategically exercising five diverse API functions:
// 1. cmsCreateLinearizationDeviceLink: Creates a linearization device link profile.
// 2. cmsCreateBCHSWabstractProfile: Creates an abstract profile with brightness, contrast, hue, and saturation adjustments.
// 3. cmsIT8Alloc and cmsIT8SetDataRowColDbl: Allocates an IT8 handle and sets data in it.
// 4. cmsGetProfileInfo: Retrieves information from a profile.
// 5. cmsCreateRGBProfile: Creates an RGB profile.
//
// Memory Safety: All allocated resources (profiles, tone curves, IT8 handles, strings)
// are meticulously freed to prevent memory leaks.
//
// Input Strategy: FuzzedDataProvider-like helper functions are used to
// consume structured input from the fuzzer's data buffer. Various input
// combinations are generated to trigger different code paths, including
// error conditions and edge cases, based on coverage analysis.

#include <stdint.h>
#include <stddef.h>
#include <stdlib.h> // For malloc, free, calloc
#include <string.h> // For memcpy

// Include lcms headers with full project-relative paths
#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/src/lcms2_internal.h" // Required for some internal structures/functions if directly used, though public APIs are preferred.

// Global lcms context to avoid re-creating it for each fuzzer input.
// In a real fuzzer setup, the harness might manage this.
static cmsContext gContext = NULL;

// --- FuzzedDataProvider-like Helper Functions for C ---
// These functions consume bytes from the fuzzer's input data buffer
// and convert them into various data types, simulating the behavior
// of FuzzedDataProvider in C++. They include bounds checks to prevent
// reading past the end of the input buffer.

typedef struct {
    const uint8_t *data;
    size_t size;
    size_t offset;
} FuzzedData;

// Consumes a single 8-bit unsigned integer.
uint8_t FuzzedData_ConsumeUInt8(FuzzedData *fd) {
    if (fd->offset + sizeof(uint8_t) > fd->size) {
        return 0; // Not enough data, return default
    }
    uint8_t val = fd->data[fd->offset];
    fd->offset += sizeof(uint8_t);
    return val;
}

// Consumes a single 32-bit unsigned integer.
uint32_t FuzzedData_ConsumeUInt32(FuzzedData *fd) {
    if (fd->offset + sizeof(uint32_t) > fd->size) {
        return 0; // Not enough data, return default
    }
    uint32_t val;
    // Ensure proper byte order if necessary, for simplicity direct copy
    // is assumed to work on the fuzzer's architecture.
    memcpy(&val, fd->data + fd->offset, sizeof(uint32_t));
    fd->offset += sizeof(uint32_t);
    return val;
}

// Consumes a single double-precision floating-point number.
double FuzzedData_ConsumeDouble(FuzzedData *fd) {
    if (fd->offset + sizeof(double) > fd->size) {
        return 0.0; // Not enough data, return default
    }
    double val;
    memcpy(&val, fd->data + fd->offset, sizeof(double));
    fd->offset += sizeof(double);
    return val;
}

// Consumes a boolean value (0 or 1).
cmsBool FuzzedData_ConsumeBool(FuzzedData *fd) {
    return FuzzedData_ConsumeUInt8(fd) % 2;
}

// Consumes a null-terminated string. Allocates memory that must be freed by the caller.
char* FuzzedData_ConsumeString(FuzzedData *fd, size_t max_len) {
    size_t len = FuzzedData_ConsumeUInt8(fd) % (max_len + 1); // Length up to max_len
    if (fd->offset + len > fd->size) {
        len = fd->size - fd->offset; // Adjust length if it exceeds remaining data
    }
    char* str = (char*)malloc(len + 1); // Allocate space for string + null terminator
    if (str) {
        memcpy(str, fd->data + fd->offset, len);
        str[len] = '\0'; // Null-terminate the string
        fd->offset += len;
    }
    return str;
}

// Consumes a null-terminated wide string (wchar_t). Allocates memory that must be freed by the caller.
wchar_t* FuzzedData_ConsumeWideString(FuzzedData *fd, size_t max_len) {
    size_t len = FuzzedData_ConsumeUInt8(fd) % (max_len + 1); // Length up to max_len
    if (fd->offset + len * sizeof(wchar_t) > fd->size) {
        len = (fd->size - fd->offset) / sizeof(wchar_t); // Adjust length if it exceeds remaining data
    }
    wchar_t* wstr = (wchar_t*)malloc((len + 1) * sizeof(wchar_t)); // Allocate space for wide string + null terminator
    if (wstr) {
        memcpy(wstr, fd->data + fd->offset, len * sizeof(wchar_t));
        wstr[len] = L'\0'; // Null-terminate the wide string
        fd->offset += len * sizeof(wchar_t);
    }
    return wstr;
}

// Consumes an array of cmsToneCurve pointers. Allocates memory for the array and individual curves.
// The array and individual curves must be freed by the caller.
cmsToneCurve** FuzzedData_ConsumeToneCurveArray(FuzzedData *fd, cmsContext ContextID, size_t num_curves) {
    if (num_curves == 0) return NULL;

    cmsToneCurve** curves = (cmsToneCurve**)calloc(num_curves, sizeof(cmsToneCurve*));
    if (!curves) return NULL; // Handle allocation failure

    for (size_t i = 0; i < num_curves; ++i) {
        // Fuzz the type of tone curve to create to maximize coverage of cmsBuild*ToneCurve functions
        uint8_t curve_type = FuzzedData_ConsumeUInt8(fd) % 3; // 0: parametric, 1: tabulated 16bit, 2: tabulated float

        if (curve_type == 0) { // Parametric Tone Curve
            // Fuzz parametric type (0-17 are valid types)
            uint32_t parametric_type = FuzzedData_ConsumeUInt8(fd) % 18;
            double params[10]; // Max 10 parameters for parametric curves
            for (int j = 0; j < 10; ++j) {
                params[j] = FuzzedData_ConsumeDouble(fd);
            }
            curves[i] = cmsBuildParametricToneCurve(ContextID, parametric_type, params);
        } else if (curve_type == 1) { // Tabulated 16-bit Tone Curve
            uint32_t num_entries = FuzzedData_ConsumeUInt8(fd) % 256; // Fuzz number of entries (0-255)
            if (num_entries > 0) {
                cmsUInt16Number* table = (cmsUInt16Number*)calloc(num_entries, sizeof(cmsUInt16Number));
                if (table) {
                    for (uint32_t j = 0; j < num_entries; ++j) {
                        // Consume two bytes for each 16-bit entry
                        table[j] = FuzzedData_ConsumeUInt8(fd) | (FuzzedData_ConsumeUInt8(fd) << 8);
                    }
                    curves[i] = cmsBuildTabulatedToneCurve16(ContextID, num_entries, table);
                    free(table); // Free the temporary table data
                }
            }
        } else { // Tabulated Float Tone Curve
            uint32_t num_entries = FuzzedData_ConsumeUInt8(fd) % 256; // Fuzz number of entries (0-255)
            if (num_entries > 0) {
                cmsFloat32Number* table = (cmsFloat32Number*)calloc(num_entries, sizeof(cmsFloat32Number));
                if (table) {
                    for (uint32_t j = 0; j < num_entries; ++j) {
                        table[j] = (cmsFloat32Number)FuzzedData_ConsumeDouble(fd);
                    }
                    curves[i] = cmsBuildTabulatedToneCurveFloat(ContextID, num_entries, table);
                    free(table); // Free the temporary table data
                }
            }
        }
    }
    return curves;
}

// --- LLVMFuzzerTestOneInput ---
// Main fuzzer entry point, called by the fuzzing engine for each input.
// It initializes the lcms context (if not already done) and then calls
// various lcms API functions with fuzzed inputs.
int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedData fd = {Data, Size, 0};

    // Initialize lcms context once for all fuzzer runs.
    // This avoids repeated setup/teardown overhead and potential issues with
    // context-specific global states.
    if (gContext == NULL) {
        gContext = cmsCreateContext(NULL, NULL);
        if (gContext == NULL) {
            return 0; // Cannot proceed without a context
        }
    }

    // Fuzz Target 1: cmsCreateLinearizationDeviceLink
    // This function creates a device link profile for linearization.
    // We aim to cover various color spaces and ensure error paths are hit.
    {
        cmsHPROFILE hProfile = NULL;
        cmsToneCurve** transferFunctions = NULL;
        // Fuzz color space signature
        cmsColorSpaceSignature colorSpace = FuzzedData_ConsumeUInt32(&fd);
        // Fuzz number of curves (typically 1 for gray, 3 for RGB)
        size_t num_curves = FuzzedData_ConsumeUInt8(&fd) % 4; // 0 to 3 curves
        if (num_curves > 0) {
            transferFunctions = FuzzedData_ConsumeToneCurveArray(&fd, gContext, num_curves);
        }

        // Call the target API
        hProfile = cmsCreateLinearizationDeviceLink(colorSpace, (const cmsToneCurve**)transferFunctions);
        if (hProfile) {
            cmsCloseProfile(hProfile); // Free the created profile
        }

        // Clean up allocated tone curves and the array of pointers
        if (transferFunctions) {
            for (size_t i = 0; i < num_curves; ++i) {
                if (transferFunctions[i]) {
                    cmsFreeToneCurve(transferFunctions[i]);
                }
            }
            free(transferFunctions);
        }
    }

    // Fuzz Target 2: cmsCreateBCHSWabstractProfile
    // This function creates an abstract profile with brightness, contrast, hue, and saturation adjustments.
    // We aim to cover different `nProfiles` values (1, 3, and others for error) and various float parameters.
    {
        cmsHPROFILE hProfile = NULL;
        // Fuzz nProfiles to hit branches: 1, 3, and other values for error.
        cmsUInt32Number nProfiles = FuzzedData_ConsumeUInt8(&fd) % 5; // Generates 0, 1, 2, 3, 4
        cmsFloat64Number brightness = FuzzedData_ConsumeDouble(&fd);
        cmsFloat64Number contrast = FuzzedData_ConsumeDouble(&fd);
        cmsFloat64Number hue = FuzzedData_ConsumeDouble(&fd);
        cmsFloat64Number saturation = FuzzedData_ConsumeDouble(&fd);
        cmsUInt32Number dwFlags = FuzzedData_ConsumeUInt32(&fd);
        cmsUInt32Number intent = FuzzedData_ConsumeUInt32(&fd);

        // Call the target API
        hProfile = cmsCreateBCHSWabstractProfile(nProfiles, brightness, contrast, hue, saturation, dwFlags, intent);
        if (hProfile) {
            cmsCloseProfile(hProfile); // Free the created profile
        }
    }

    // Fuzz Target 3: cmsIT8Alloc and cmsIT8SetDataRowColDbl
    // This section tests IT8 handle allocation and setting data by row/column.
    // It specifically tries to trigger invalid row/column error paths.
