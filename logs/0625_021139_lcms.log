    // Ensure channel numbers are positive and reasonable.
    cmsUInt32Number input_channels = FuzzedData_ConsumeUInt8(&fd) % 10 + 1; // 1 to 10 channels
    cmsUInt32Number output_channels = FuzzedData_ConsumeUInt8(&fd) % 10 + 1; // 1 to 10 channels

    cmsHPROFILE hBCHSWProfile = cmsCreateBCHSWabstractProfileTHR(ctx, flags, brightness, contrast, hue, saturation, input_channels, output_channels);
