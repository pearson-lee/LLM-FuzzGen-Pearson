// Please note that in C, you do not need to use `extern "C"` to declare the `LLVMFuzzerTestOneInput` function, as it is a C function, not a C++ function.
// Additionally, in C, you cannot use FuzzedDataProvider.
#include <stdint.h>
#include <stddef.h>
#include <stdio.h>
#include <string.h>
#include <stdlib.h> // For tmpfile, fclose, malloc, free
#include <math.h>   // For fabs

// Include lcms headers with full project-relative paths
#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/include/lcms2_plugin.h"
// Include internal header for cmsCIECAM02 struct and functions
// Note: While cmsCIECAM02 is an internal struct, its functions are exposed via cmsHANDLE.
// The original code tried to use cmsCIECAM02 directly, which caused undeclared identifier errors.
// The fix involves using cmsHANDLE for the CAM02 model and cmsViewingConditions for initialization.
#include "/src/lcms/src/lcms2_internal.h"

// Define a simple "FuzzedDataProvider" like structure for C
// This helps in consuming fuzzer input data in a structured way.
typedef struct {
    const uint8_t *data;
    size_t size;
    size_t offset;
} FuzzedData;

// Helper function to consume a single byte from fuzzer data.
// Returns 0 if no more data is available.
uint8_t FuzzedData_ConsumeUInt8(FuzzedData *fd) {
    if (fd->offset < fd->size) {
        return fd->data[fd->offset++];
    }
    return 0;
}

// Helper function to consume a 32-bit unsigned integer from fuzzer data.
// Bytes are consumed in big-endian order. Returns 0 if not enough data.
uint32_t FuzzedData_ConsumeUInt32(FuzzedData *fd) {
    uint32_t val = 0;
    size_t bytes_to_read = 4;
    if (fd->offset + bytes_to_read > fd->size) {
        bytes_to_read = fd->size - fd->offset; // Consume remaining bytes
    }
    for (size_t i = 0; i < bytes_to_read; ++i) {
        val = (val << 8) | fd->data[fd->offset++];
    }
    return val;
}

// Helper function to consume an 8-byte double from fuzzer data.
// This directly interprets 8 bytes as a double. This can produce
// unusual floating-point values (NaN, Inf), which is good for fuzzing.
double FuzzedData_ConsumeDouble(FuzzedData *fd) {
    uint64_t val_u64 = 0;
    size_t bytes_to_read = 8;
    if (fd->offset + bytes_to_read > fd->size) {
        bytes_to_read = fd->size - fd->offset; // Consume remaining bytes
    }
    for (size_t i = 0; i < bytes_to_read; ++i) {
        val_u64 = (val_u64 << 8) | fd->data[fd->offset++];
    }
    // Use a union or memcpy for type-punning to avoid strict aliasing issues
    union {
        uint64_t u;
        double d;
    } u_val;
    u_val.u = val_u64;
    return u_val.d;
}

// Helper function to consume a limited-length null-terminated string.
// Returns a pointer to a newly allocated string, which must be freed by the caller.
// Returns NULL if not enough data or if the fuzzed length is zero.
char* FuzzedData_ConsumeSizedString(FuzzedData *fd, size_t max_chars) {
    if (fd->offset >= fd->size) return NULL;

    size_t bytes_to_consume = FuzzedData_ConsumeUInt8(fd); // Use one byte for length
    if (bytes_to_consume == 0) return NULL; // Avoid zero-length strings

    if (bytes_to_consume > max_chars) bytes_to_consume = max_chars;

    size_t remaining_data = fd->size - fd->offset;
    if (bytes_to_consume > remaining_data) {
        bytes_to_consume = remaining_data;
    }

    if (bytes_to_consume == 0) return NULL; // Still might be zero if remaining_data was too small

    char* str = (char*)malloc(bytes_to_consume + 1);
    if (!str) return NULL;

    memcpy(str, fd->data + fd->offset, bytes_to_consume);
    str[bytes_to_consume] = '\0';
    fd->offset += bytes_to_consume;
    return str;
}


// Function to create a temporary file and write fuzzer data to it.
// The file is automatically deleted when closed or on program exit.
FILE* create_temp_file(const uint8_t *data, size_t size) {
    FILE *f = tmpfile();
    if (f) {
        fwrite(data, 1, size, f);
        rewind(f); // Rewind to the beginning for reading
    }
    return f;
}

// Main fuzzing function required by libFuzzer.
// It takes raw fuzzer input data and its size.
int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    // Initialize our custom FuzzedData provider
    FuzzedData fd = {Data, Size, 0};

    // Create a default lcms context. This is essential for most lcms operations.
    // The context needs to be deleted at the end to prevent memory leaks.
    cmsContext ctx = cmsCreateContext(NULL, NULL);
    if (!ctx) {
        return 0; // If context creation fails, we cannot proceed.
    }

    // --- Fuzzing cmsOpenProfileFromStreamTHR (read mode) ---
    // Create a new temporary file for each test.
    // cmsOpenProfileFromStreamTHR takes ownership of the FILE* and closes it
    // via cmsCloseProfile, regardless of success or failure.
    FILE *temp_file_r = create_temp_file(Data, Size);
    if (temp_file_r) {
        // Enhancement: To hit the success path of cmsOpenProfileFromStreamTHR (read mode),
        // we first save a valid NULL profile to the file, then try to open it.
        // This addresses the 'Branch (90:13): [True: 0, False: 140]' in the fuzz target coverage.
        cmsHPROFILE hNullProfileForRead = cmsCreateNULLProfile();
        if (hNullProfileForRead) {
            // Save the NULL profile to the temporary file.
            // cmsSaveProfileToStream does not close the stream, so we need to rewind.
            if (cmsSaveProfileToStream(hNullProfileForRead, temp_file_r) != 0) {
                rewind(temp_file_r); // Rewind to the beginning for reading
                cmsHPROFILE hProfile_r = NULL;
                char access_mode_r[2] = {'r', '\0'};
                hProfile_r = cmsOpenProfileFromStreamTHR(ctx, temp_file_r, access_mode_r);
                if (hProfile_r) {
                    // If a profile was successfully opened, close it to free resources.
                    // This also closes the underlying FILE* stream.
                    cmsCloseProfile(hProfile_r);
                }
            }
            cmsCloseProfile(hNullProfileForRead); // Memory safety: Free the NULL profile created for saving
        }
        // cmsOpenProfileFromStreamTHR takes ownership of the FILE* and closes it.
        // So, no explicit fclose(temp_file_r) is needed here.
    }

    // --- Fuzzing cmsOpenProfileFromStreamTHR (write mode) ---
    // Create another new temporary file for the write test.
    FILE *temp_file_w = create_temp_file(Data, Size);
    if (temp_file_w) {
        cmsHPROFILE hProfile_w = NULL;
        char access_mode_w[2] = {'w', '\0'};
        hProfile_w = cmsOpenProfileFromStreamTHR(ctx, temp_file_w, access_mode_w);
        if (hProfile_w) {
            // If a profile was successfully opened, close it to free resources.
            // This also closes the underlying FILE* stream.
            cmsCloseProfile(hProfile_w);
        }
        // No explicit fclose(temp_file_w) needed here, as lcms handles it.
    }

    // --- Fuzzing cmsMD5computeID ---
    // This function computes the MD5 ID of an ICC profile.
    // We create a simple NULL profile for this purpose.
    cmsHPROFILE hNullProfile = cmsCreateNULLProfile();
    if (hNullProfile) {
        // cmsMD5computeID takes only one argument (cmsHPROFILE).
        // The profileID is computed and stored internally within the profile.
        cmsMD5computeID(hNullProfile);
        // Close the NULL profile to free its resources.
        cmsCloseProfile(hNullProfile);
    }

    // --- Fuzzing cmsCreateBCHSWabstractProfileTHR ---
    // This function creates a virtual profile for Brightness, Contrast, Hue, Saturation, White Point.
    // We generate parameters using fuzzer data.
    cmsUInt32Number flags = FuzzedData_ConsumeUInt32(&fd);
    cmsFloat64Number brightness = FuzzedData_ConsumeDouble(&fd);
    cmsFloat64Number contrast = FuzzedData_ConsumeDouble(&fd);
    cmsFloat64Number hue = FuzzedData_ConsumeDouble(&fd);
    cmsFloat64Number saturation = FuzzedData_ConsumeDouble(&fd);
    // Ensure channel numbers are positive and reasonable.
    cmsUInt32Number input_channels = FuzzedData_ConsumeUInt8(&fd) % 10 + 1; // 1 to 10 channels
    cmsUInt32Number output_channels = FuzzedData_ConsumeUInt8(&fd) % 10 + 1; // 1 to 10 channels

    cmsHPROFILE hBCHSWProfile = cmsCreateBCHSWabstractProfileTHR(ctx, flags, brightness, contrast, hue, saturation, input_channels, output_channels);
    if (hBCHSWProfile) {
        // Close the created profile to prevent memory leaks.
        cmsCloseProfile(hBCHSWProfile);
    }

    // --- Fuzzing cmsSmoothToneCurve ---
    // This function smooths a tone curve.
    // First, create a tone curve using cmsBuildGamma.
    cmsFloat64Number gamma_val = FuzzedData_ConsumeDouble(&fd);
