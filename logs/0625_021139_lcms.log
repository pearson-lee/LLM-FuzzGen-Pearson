    }
    // Use a union or memcpy for type-punning to avoid strict aliasing issues
    union {
        uint64_t u;
        double d;
    } u_val;
    u_val.u = val_u64;
    return u_val.d;
}

// Helper function to consume a limited-length null-terminated string.
// Returns a pointer to a newly allocated string, which must be freed by the caller.
// Returns NULL if not enough data or if the fuzzed length is zero.
char* FuzzedData_ConsumeSizedString(FuzzedData *fd, size_t max_chars) {
    if (fd->offset >= fd->size) return NULL;

    size_t bytes_to_consume = FuzzedData_ConsumeUInt8(fd); // Use one byte for length
    if (bytes_to_consume == 0) return NULL; // Avoid zero-length strings

    if (bytes_to_consume > max_chars) bytes_to_consume = max_chars;

    size_t remaining_data = fd->size - fd->offset;
    if (bytes_to_consume > remaining_data) {
        bytes_to_consume = remaining_data;
    }

    if (bytes_to_consume == 0) return NULL; // Still might be zero if remaining_data was too small

    char* str = (char*)malloc(bytes_to_consume + 1);
