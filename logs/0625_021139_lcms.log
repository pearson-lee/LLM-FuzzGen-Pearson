            if (current_size >= sizeof(cmsUInt32Number) * 2) { // For InfoType and Locale
                cmsInfoType InfoType = get_fuzzed_uint32(&current_data, &current_size) % 4; // 0=Description, 1=Manufacturer, 2=Model, 3=Copyright
                cmsUInt32Number Locale = get_fuzzed_uint32(&current_data, &current_size); // Fuzzed locale code

                wchar_t BufferW[256];
                char BufferA[256];

                // Corrected cmsGetProfileInfo call (first argument should be hProfile)
                cmsGetProfileInfo(hProfile_ps, InfoType, Locale, BufferW, 256);
                // Corrected cmsGetProfileInfoASCII call (missing LanguageCode and CountryCode)
                cmsGetProfileInfoASCII(hProfile_ps, InfoType, "en", "US", BufferA, 256);
            }

            cmsCloseProfile(hProfile_ps); // Free the created profile
        }
    }

    // --- Fuzzing cmsIT8SetDataDbl and cmsIT8SetData ---
