extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 1) {
    return 0;
  }

  FuzzedDataProvider fdp(data, size);

  // Initialize codec
  vpx_codec_ctx_t codec;
  vpx_codec_dec_cfg_t cfg = {0};
  cfg.w = fdp.ConsumeIntegralInRange<unsigned int>(16, 4096);
  cfg.h = fdp.ConsumeIntegralInRange<unsigned int>(16, 4096);
  cfg.threads = 1;
  if (vpx_codec_dec_init(&codec, vpx_codec_vp8_dx(), &cfg, 0)) {
    return 0;
  }

  VP8_COMMON *cm = (VP8_COMMON *)vpx_codec_get_priv(&codec, NULL);
  if (!cm) {
    vpx_codec_destroy(&codec);
    return 0;
  }

  // Allocate frame buffers
  if (vp8_alloc_frame_buffers(cm, cfg.w, cfg.h)) {
    vpx_codec_destroy(&codec);
    return 0;
  }

  // Initialize MACROBLOCKD
  MACROBLOCKD mbd;
  memset(&mbd, 0, sizeof(mbd));
  vp8_build_block_doffsets(&mbd);

  // Fuzz target functions
  const int frame_type = fdp.ConsumeBool() ? KEY_FRAME : INTER_FRAME;
  const int filter_level = fdp.ConsumeIntegralInRange<int>(0, 63);

  // Fuzz vp8_loop_filter_frame and related functions
  vp8_loop_filter_frame(cm, &mbd, filter_level);
  vp8_loop_filter_frame_yonly(cm, &mbd, filter_level);
  vp8_loop_filter_partial_frame(cm, &mbd, filter_level);

  // Fuzz vp8_multiframe_quality_enhance
  vp8_multiframe_quality_enhance(cm);

  // Fuzz vp8_post_proc_frame
  vp8_postproc_cfg_t pp_cfg;
  memset(&pp_cfg, 0, sizeof(pp_cfg));
  pp_cfg.post_proc_flag = fdp.ConsumeIntegral<int>();
  pp_cfg.deblocking_level = fdp.ConsumeIntegralInRange<int>(0, 16);
  pp_cfg.noise_level = fdp.ConsumeIntegralInRange<int>(0, 16);
  
  vp8_ppflags_t flags = {0};
  flags.post_proc_flag = pp_cfg.post_proc_flag;
  flags.deblocking_level = pp_cfg.deblocking_level;
  flags.noise_level = pp_cfg.noise_level;

  vp8_post_proc_frame(cm, &cm->post_proc_buffer, &flags);

  // Clean up
  vp8_de_alloc_frame_buffers(cm);
  vpx_codec_destroy(&codec);

  return 0;
}[0m
