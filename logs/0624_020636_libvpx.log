  // Initialize codec
  vpx_codec_ctx_t codec;
  vpx_codec_dec_cfg_t cfg = {0};
  cfg.w = fdp.ConsumeIntegralInRange<unsigned int>(16, 4096);
  cfg.h = fdp.ConsumeIntegralInRange<unsigned int>(16, 4096);
  cfg.threads = 1;
  if (vpx_codec_dec_init(&codec, vpx_codec_vp8_dx(), &cfg, 0)) {
    return 0;
  }

  VP8_COMMON *cm = (VP8_COMMON *)codec.priv;
  if (!cm) {
    vpx_codec_destroy(&codec);
