static void FuzzVP8(FuzzedDataProvider& fdp) {
    #include "vpx/vpx_decoder.h"
    #include "vpx/vp8dx.h"
    #include "vpx/vp8.h"
    #include "/src/libvpx/vpx_scale/yv12config.h"
    #include "/src/libvpx/vp8/common/onyxc_int.h"
    #include "/src/libvpx/vp8/common/postproc.h"
    #include "/src/libvpx/vp8/common/loopfilter.h"

    vpx_codec_iface_t *codec_iface = vpx_codec_vp8_dx();
    vpx_codec_ctx_t codec_ctx;
    if (vpx_codec_dec_init(&codec_ctx, codec_iface, NULL, 0)) {
        return;
    }

    VP8_COMMON vp8_cm;
    memset(&vp8_cm, 0, sizeof(VP8_COMMON));
    vp8_cm.frame_type = fdp.PickValueInArray({KEY_FRAME, INTER_FRAME});
    vp8_cm.mb_rows = fdp.ConsumeIntegralInRange<int>(1, 68);
    vp8_cm.mb_cols = fdp.ConsumeIntegralInRange<int>(1, 68);
    vp8_cm.base_qindex = fdp.ConsumeIntegralInRange<int>(0, 127);
    vp8_cm.postproc_state.last_base_qindex = fdp.ConsumeIntegralInRange<int>(0, 127);

    YV12_BUFFER_CONFIG frame_to_show;
    memset(&frame_to_show, 0, sizeof(YV12_BUFFER_CONFIG));
    if (vpx_alloc_frame_buffer(&frame_to_show, 128, 128, 1, 1, 0, 16, 16)) {
        vpx_codec_destroy(&codec_ctx);
        return;
    }
    vp8_cm.frame_to_show = &frame_to_show;

    memset(&vp8_cm.post_proc_buffer, 0, sizeof(YV12_BUFFER_CONFIG));
    if (vpx_alloc_frame_buffer(&vp8_cm.post_proc_buffer, 128, 128, 1, 1, 0, 16, 16)) {
        vpx_free_frame_buffer(&frame_to_show);
        vpx_codec_destroy(&codec_ctx);
        return;
    }

    const size_t mode_info_size = vp8_cm.mb_rows * vp8_cm.mb_cols;
    if (mode_info_size > 0) {
        vp8_cm.mi = (MODE_INFO *)calloc(mode_info_size, sizeof(MODE_INFO));
        if (!vp8_cm.mi) {
            vpx_free_frame_buffer(&frame_to_show);
            vpx_free_frame_buffer(&vp8_cm.post_proc_buffer);
            vpx_codec_destroy(&codec_ctx);
            return;
        }
    } else {
        vp8_cm.mi = nullptr;
    }

    vp8_multiframe_quality_enhance(&vp8_cm);

    MACROBLOCKD mb_d;
    memset(&mb_d, 0, sizeof(MACROBLOCKD));
    vp8_loop_filter_frame(&vp8_cm, &mb_d, fdp.ConsumeIntegralInRange<int>(0, 2));

    vpx_ref_frame_t ref_frame;
    memset(&ref_frame, 0, sizeof(vpx_ref_frame_t));
    vpx_codec_control(&codec_ctx, VP8_SET_REFERENCE, &ref_frame);

    if (vp8_cm.mi) {
        free(vp8_cm.mi);
    }
    vpx_free_frame_buffer(&frame_to_show);
    vpx_free_frame_buffer(&vp8_cm.post_proc_buffer);
    vpx_codec_destroy(&codec_ctx);
}

static void FuzzVP9(FuzzedDataProvider& fdp) {
    #include "vpx/vpx_decoder.h"
