// The RTCD initialization function is not always exposed in a public header,
// but it is linked into the final binary. Declaring it extern allows us to
// call it directly to ensure the DSP function pointers are initialized.
extern "C" void vpx_dsp_rtcd(void);

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);
  if (size < 1) {
    return 0;
  }

  // Initialize the RTCD function pointers. This is the critical step to
  // prevent null pointer dereferences in the DSP functions.
  vpx_dsp_rtcd();

  // Use a custom deleter to ensure vp8_remove_common is called automatically.
  auto cm = std::unique_ptr<VP8_COMMON, decltype(&vp8_remove_common)>(
      new VP8_COMMON(), &vp8_remove_common);
  if (!cm) {
    return 0;
  }
  vp8_create_common(cm.get());

  const int width = fdp.ConsumeIntegralInRange<int>(16, 1024) & ~15;
  const int height = fdp.ConsumeIntegralInRange<int>(16, 1024) & ~15;
  if (width == 0 || height == 0) {
    return 0;
  }

  if (vp8_alloc_frame_buffers(cm.get(), width, height)) {
    return 0; // Allocation failed
  }

  // Set fields required by the fuzzed functions to avoid undefined behavior.
  cm->current_video_frame = 11;
  cm->base_qindex = 30;
  cm->postproc_state.last_frame_valid = 1;
  cm->postproc_state.last_base_qindex = 5;

  auto mbd = std::unique_ptr<MACROBLOCKD>(new MACROBLOCKD());
  if (!mbd) {
    return 0;
  }
  memset(mbd.get(), 0, sizeof(MACROBLOCKD));

  // The destination buffer for post-processing.
  auto dest = std::unique_ptr<YV12_BUFFER_CONFIG>(new YV12_BUFFER_CONFIG());
  if (!dest) {
    return 0;
  }
  if (vp8_yv12_alloc_frame_buffer(dest.get(), width, height, VP8BORDERINPIXELS) < 0) {
    return 0;
  }
  cm->post_proc_buffer = *dest.get();

  // Fuzz vp8_loop_filter_frame
  vp8_loop_filter_frame(cm.get(), mbd.get(), fdp.ConsumeIntegral<int>());

  // Fuzz vp8_multiframe_quality_enhance
  vp8_multiframe_quality_enhance(cm.get());

  // Fuzz vp8_deblock
  vp8_deblock(cm.get(), cm->frame_to_show, dest.get(), fdp.ConsumeIntegral<int>());
  
  vp8_yv12_de_alloc_frame_buffer(dest.get());

  return 0;
}[0m
