#include "vp8/common/postproc.h"

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Initialize VP8_COMMON structure
  VP8_COMMON cm;
  std::memset(&cm, 0, sizeof(cm));
  vp8_create_common(&cm);

  // Initialize MACROBLOCKD structure
  MACROBLOCKD mbd;
  std::memset(&mbd, 0, sizeof(mbd));
  mbd.mode_info_context = nullptr;
  mbd.frame_type = static_cast<FRAME_TYPE>(fdp.ConsumeIntegralInRange<int>(0, 1));
  cm.frame_type = mbd.frame_type;

  // Allocate and initialize frame buffer
  YV12_BUFFER_CONFIG frame;
  std::memset(&frame, 0, sizeof(frame));
  frame.y_width = fdp.ConsumeIntegralInRange<int>(16, 1024);
  frame.y_height = fdp.ConsumeIntegralInRange<int>(16, 1024);
  frame.uv_width = frame.y_width / 2;
  frame.uv_height = frame.y_height / 2;
  frame.y_stride = frame.y_width;
  frame.uv_stride = frame.uv_width;
  frame.border = fdp.ConsumeIntegralInRange<int>(0, 32);

  const size_t y_size = (frame.y_height + 2 * frame.border) * frame.y_stride;
  const size_t uv_size = (frame.uv_height + frame.border) * frame.uv_stride;
  if (y_size == 0 || uv_size == 0) {
    vp8_remove_common(&cm);
    return 0;
  }
  std::vector<uint8_t> y_buffer(y_size);
  std::vector<uint8_t> u_buffer(uv_size);
  std::vector<uint8_t> v_buffer(uv_size);
  fdp.ConsumeData(y_buffer.data(), y_size);
  fdp.ConsumeData(u_buffer.data(), uv_size);
  fdp.ConsumeData(v_buffer.data(), uv_size);

  frame.y_buffer = y_buffer.data();
  frame.u_buffer = u_buffer.data();
  frame.v_buffer = v_buffer.data();

  cm.frame_to_show = &frame;
  cm.mb_rows = frame.y_height / 16;
  cm.mb_cols = frame.y_width / 16;
  if (cm.mb_rows == 0 || cm.mb_cols == 0) {
    vp8_remove_common(&cm);
    return 0;
  }
  cm.filter_type = static_cast<LOOPFILTERTYPE>(fdp.ConsumeIntegralInRange<int>(0, 1));

  // Allocate mode_info. The +1 is for the border.
  const int mi_size = cm.mb_rows * (cm.mb_cols + 1);
  cm.mi = (MODE_INFO *)std::calloc(mi_size, sizeof(MODE_INFO));
  if (!cm.mi) {
    vp8_remove_common(&cm);
    return 0;
  }
  cm.mip = cm.mi;
  mbd.mode_info_context = cm.mi;

  // Allocate buffer for post-processing, which is used by mfqe
  const size_t post_proc_buffer_size = y_size + 2 * uv_size;
  uint8_t* post_proc_buffer = (uint8_t*)std::malloc(post_proc_buffer_size);
  if (!post_proc_buffer) {
    std::free(cm.mi);
    vp8_remove_common(&cm);
    return 0;
  }
  cm.post_proc_buffer.y_buffer = post_proc_buffer;
  cm.post_proc_buffer.u_buffer = post_proc_buffer + y_size;
  cm.post_proc_buffer.v_buffer = post_proc_buffer + y_size + uv_size;
  cm.post_proc_buffer.y_width = frame.y_width;
  cm.post_proc_buffer.y_height = frame.y_height;
  cm.post_proc_buffer.uv_width = frame.uv_width;
  cm.post_proc_buffer.uv_height = frame.uv_height;
  cm.post_proc_buffer.y_stride = frame.y_stride;
  cm.post_proc_buffer.uv_stride = frame.uv_stride;
  cm.post_proc_buffer.border = frame.border;


  // Call target APIs
  vp8_loop_filter_frame(&cm, &mbd, cm.frame_type);
  vp8_loop_filter_frame_yonly(&cm, &mbd, fdp.ConsumeIntegral<int>());
  vp8_multiframe_quality_enhance(&cm);

  // Call simple memory copy functions
  std::vector<uint8_t> src(256);
  std::vector<uint8_t> dst(256);
  fdp.ConsumeData(src.data(), 256);
  vp8_copy_mem16x16_c(src.data(), 16, dst.data(), 16);
  vp8_copy_mem8x8_c(src.data(), 8, dst.data(), 8);

  std::free(post_proc_buffer);
  std::free(cm.mi);
  vp8_remove_common(&cm);
  
  return 0;
}[0m
