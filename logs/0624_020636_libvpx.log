    cm.height = fdp.ConsumeIntegralInRange<int>(16, 1024);
    cm.mb_rows = (cm.height + 15) / 16;
    cm.mb_cols = (cm.width + 15) / 16;
    cm.frame_type = fdp.PickValueInArray({KEY_FRAME, INTER_FRAME});
    cm.base_qindex = fdp.ConsumeIntegralInRange<int>(0, 127);
    cm.postproc_state.last_base_qindex = fdp.ConsumeIntegralInRange<int>(0, 127);

    // Allocate and initialize frame_to_show and post_proc_buffer
    YV12_BUFFER_CONFIG frame_to_show;
    YV12_BUFFER_CONFIG post_proc_buffer;
    alloc_yv12_buffer(fdp, frame_to_show, cm.width, cm.height);
    alloc_yv12_buffer(fdp, post_proc_buffer, cm.width, cm.height);
    cm.frame_to_show = &frame_to_show;
    cm.post_proc_buffer = post_proc_buffer;

    // Allocate and initialize MODE_INFO
    const int mode_info_count = (cm.mb_rows + 1) * (cm.mb_cols + 1);
    std::vector<MODE_INFO> mode_info(mode_info_count);
