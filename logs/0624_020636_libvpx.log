#include "vpx/vpx_decoder.h"
#include "vp9/common/vp9_loopfilter.h"
#include "vp9/common/vp9_onyxc_int.h"
#include "vp9/decoder/vp9_decoder.h"

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Initialize VP8 decoder
  vpx_codec_ctx_t vp8_codec;
  vpx_codec_dec_cfg_t vp8_cfg = {0};
  if (vpx_codec_dec_init(&vp8_codec, vpx_codec_vp8_dx(), &vp8_cfg, 0)) {
    return 0;
  }

  // Get VP8 common and macroblockd structures
  VP8D_COMP *pbi = (VP8D_COMP *)vp8_codec.priv;
  VP8_COMMON *cm = &pbi->common;
  MACROBLOCKD *mbd = &pbi->mb;

  // Initialize VP9 decoder
  vpx_codec_ctx_t vp9_codec;
  vpx_codec_dec_cfg_t vp9_cfg = {0};
  if (vpx_codec_dec_init(&vp9_codec, vpx_codec_vp9_dx(), &vp9_cfg, 0)) {
    vpx_codec_destroy(&vp8_codec);
    return 0;
  }

  // Get VP9 common and decoder structures
  VP9_COMMON *vp9_cm = ((VP9D_COMP *)vp9_codec.priv)->common;
  VP9Decoder *pbi_vp9 = (VP9Decoder *)vp9_codec.priv;

  // Allocate a frame buffer
  const int width = fdp.ConsumeIntegralInRange<int>(16, 4096);
  const int height = fdp.ConsumeIntegralInRange<int>(16, 4096);
  YV12_BUFFER_CONFIG frame;
  if (vpx_alloc_frame_buffer(&frame, width, height, 16, 16, 16, 0, 0)) {
    vpx_codec_destroy(&vp8_codec);
    vpx_codec_destroy(&vp9_codec);
    return 0;
  }

  // Fuzz vp8_loop_filter_frame
  cm->frame_to_show = &frame;
  cm->filter_type = fdp.ConsumeBool() ? NORMAL_LOOPFILTER : SIMPLE_LOOPFILTER;
  cm->mb_rows = height / 16;
  cm->mb_cols = width / 16;
  cm->mi = (MODE_INFO *)calloc(cm->mb_rows * cm->mb_cols, sizeof(MODE_INFO));
  if (cm->mi) {
    for (int i = 0; i < cm->mb_rows * cm->mb_cols; ++i) {
      cm->mi[i].mbmi.mode = fdp.ConsumeEnum<MB_PREDICTION_MODE>();
      cm->mi[i].mbmi.mb_skip_coeff = fdp.ConsumeBool();
    }
    vp8_loop_filter_frame(cm, mbd, fdp.ConsumeEnum<FRAME_TYPE>());
    free(cm->mi);
    cm->mi = nullptr;
  }

  // Fuzz vp9_loop_filter_frame
  vp9_cm->mi_rows = height >> 3;
  vp9_cm->mi_cols = width >> 3;
  vp9_loop_filter_frame(&frame, vp9_cm, &pbi_vp9->mb,
                        fdp.ConsumeIntegral<int>(), fdp.ConsumeBool(),
                        fdp.ConsumeBool());

  // Fuzz vp9_set_reference_dec and vp9_copy_reference_dec
  YV12_BUFFER_CONFIG ref_frame;
  if (vpx_alloc_frame_buffer(&ref_frame, width, height, 16, 16, 16, 0, 0) == 0) {
    vp9_set_reference_dec(vp9_cm, fdp.ConsumeEnum<vpx_ref_frame_type_t>(),
                          &ref_frame);
    vp9_copy_reference_dec(pbi_vp9, fdp.ConsumeEnum<vpx_ref_frame_type_t>(),
                           &ref_frame);
    vpx_free_frame_buffer(&ref_frame);
  }

  // Cleanup
  vpx_free_frame_buffer(&frame);
  vpx_codec_destroy(&vp8_codec);
  vpx_codec_destroy(&vp9_codec);

  return 0;
}[0m
