  vp8_multiframe_quality_enhance(cm.get());

  // Fuzz vp8_deblock
  vp8_deblock(cm.get(), show.get(), dest.get(), fdp.ConsumeIntegral<int>());

  free(cm->mi);

  return 0;
}[0m
