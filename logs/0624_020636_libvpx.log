  cm.mb_rows = fdp.ConsumeIntegralInRange<int>(1, 10);
  cm.mb_cols = fdp.ConsumeIntegralInRange<int>(1, 10);
  cm.Width = cm.mb_cols * 16;
  cm.Height = cm.mb_rows * 16;
  cm.base_qindex = fdp.ConsumeIntegralInRange<int>(0, 127);
  cm.postproc_state.last_base_qindex = fdp.ConsumeIntegralInRange<int>(0, 127);

  // Allocate and initialize frame_to_show and post_proc_buffer
  YV12_BUFFER_CONFIG frame_to_show;
  YV12_BUFFER_CONFIG post_proc_buffer;
  memset(&frame_to_show, 0, sizeof(frame_to_show));
  memset(&post_proc_buffer, 0, sizeof(post_proc_buffer));

  frame_to_show.y_width = cm.Width;
  frame_to_show.y_height = cm.Height;
  frame_to_show.uv_width = cm.Width / 2;
  frame_to_show.uv_height = cm.Height / 2;
  frame_to_show.y_stride = fdp.ConsumeIntegralInRange<int>(frame_to_show.y_width, frame_to_show.y_width + 256);
  frame_to_show.uv_stride = fdp.ConsumeIntegralInRange<int>(frame_to_show.uv_width, frame_to_show.uv_width + 128);

  post_proc_buffer.y_width = frame_to_show.y_width;
  post_proc_buffer.y_height = frame_to_show.y_height;
  post_proc_buffer.uv_width = frame_to_show.uv_width;
  post_proc_buffer.uv_height = frame_to_show.uv_height;
  post_proc_buffer.y_stride = frame_to_show.y_stride;
  post_proc_buffer.uv_stride = frame_to_show.uv_stride;

  const int y_size = frame_to_show.y_height * frame_to_show.y_stride;
  const int uv_size = frame_to_show.uv_height * frame_to_show.uv_stride;
  std::vector<uint8_t> y_buffer(y_size);
  std::vector<uint8_t> u_buffer(uv_size);
  std::vector<uint8_t> v_buffer(uv_size);
  std::vector<uint8_t> yd_buffer(y_size);
  std::vector<uint8_t> ud_buffer(uv_size);
  std::vector<uint8_t> vd_buffer(uv_size);

  frame_to_show.y_buffer = y_buffer.data();
  frame_to_show.u_buffer = u_buffer.data();
  frame_to_show.v_buffer = v_buffer.data();
  post_proc_buffer.y_buffer = yd_buffer.data();
  post_proc_buffer.u_buffer = ud_buffer.data();
  post_proc_buffer.v_buffer = vd_buffer.data();
  cm.frame_to_show = &frame_to_show;
  cm.post_proc_buffer = post_proc_buffer;

  // Initialize MODE_INFO
  const int mi_size = (cm.mb_rows + 1) * (cm.mb_cols + 1);
