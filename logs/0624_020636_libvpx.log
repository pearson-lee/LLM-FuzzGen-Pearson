#include "/src/libvpx/vp8/common/onyxc_int.h"
#include "/src/libvpx/vp8/common/blockd.h"
#include "/src/libvpx/vpx_scale/yv12config.h"

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Initialize VP8_COMMON structure
  VP8_COMMON cm;
  memset(&cm, 0, sizeof(cm));
  cm.width = fdp.ConsumeIntegralInRange<int>(16, 4096);
  cm.height = fdp.ConsumeIntegralInRange<int>(16, 4096);
  cm.mb_rows = (cm.height + 15) / 16;
  cm.mb_cols = (cm.width + 15) / 16;
  cm.mi = static_cast<MODE_INFO *>(calloc(cm.mb_rows * cm.mb_cols, sizeof(MODE_INFO)));
  if (!cm.mi) {
    return 0;
  }
  cm.frame_to_show = static_cast<YV12_BUFFER_CONFIG *>(calloc(1, sizeof(YV12_BUFFER_CONFIG)));
  if (!cm.frame_to_show) {
    free(cm.mi);
    return 0;
  }
  cm.frame_to_show->y_width = cm.width;
  cm.frame_to_show->y_height = cm.height;
  cm.frame_to_show->uv_width = cm.width / 2;
  cm.frame_to_show->uv_height = cm.height / 2;
  cm.frame_to_show->y_stride = fdp.ConsumeIntegralInRange<int>(cm.width, cm.width * 2);
  cm.frame_to_show->uv_stride = fdp.ConsumeIntegralInRange<int>(cm.frame_to_show->uv_width, cm.frame_to_show->uv_width * 2);
  const size_t y_size = cm.frame_to_show->y_stride * cm.frame_to_show->y_height;
  const size_t uv_size = cm.frame_to_show->uv_stride * cm.frame_to_show->uv_height;
  cm.frame_to_show->y_buffer = static_cast<uint8_t *>(malloc(y_size));
  cm.frame_to_show->u_buffer = static_cast<uint8_t *>(malloc(uv_size));
  cm.frame_to_show->v_buffer = static_cast<uint8_t *>(malloc(uv_size));
  if (!cm.frame_to_show->y_buffer || !cm.frame_to_show->u_buffer || !cm.frame_to_show->v_buffer) {
    free(cm.mi);
    free(cm.frame_to_show->y_buffer);
    free(cm.frame_to_show->u_buffer);
    free(cm.frame_to_show->v_buffer);
    free(cm.frame_to_show);
    return 0;
  }
  fdp.ConsumeData(cm.frame_to_show->y_buffer, y_size);
  fdp.ConsumeData(cm.frame_to_show->u_buffer, uv_size);
  fdp.ConsumeData(cm.frame_to_show->v_buffer, uv_size);

  cm.filter_type = fdp.ConsumeBool() ? NORMAL_LOOPFILTER : SIMPLE_LOOPFILTER;
  cm.sharpness_level = fdp.ConsumeIntegralInRange<int>(0, 7);
  cm.last_sharpness_level = fdp.ConsumeIntegralInRange<int>(0, 7);
  cm.frame_type = fdp.ConsumeEnum<FRAME_TYPE>();

  // Initialize MACROBLOCKD structure
  MACROBLOCKD mbd;
  memset(&mbd, 0, sizeof(mbd));
  mbd.segmentation_enabled = fdp.ConsumeBool();
  if (mbd.segmentation_enabled) {
    mbd.mb_segment_abs_delta = fdp.ConsumeBool();
    for (int i = 0; i < MAX_MB_SEGMENTS; ++i) {
      for (int j = 0; j < 4; ++j) {
        mbd.segment_feature_data[j][i] = fdp.ConsumeIntegral<int8_t>();
      }
    }
  }
  mbd.mode_ref_lf_delta_enabled = fdp.ConsumeBool();
  if (mbd.mode_ref_lf_delta_enabled) {
    for (int i = 0; i < MAX_REF_FRAMES; ++i) {
      mbd.ref_lf_deltas[i] = fdp.ConsumeIntegral<int8_t>();
    }
    for (int i = 0; i < 4; ++i) {
      mbd.mode_lf_deltas[i] = fdp.ConsumeIntegral<int8_t>();
    }
  }

  // Fuzz the target functions
  vp8_loop_filter_frame(&cm, &mbd, cm.frame_type);
  vp8_loop_filter_frame_yonly(&cm, &mbd, fdp.ConsumeIntegralInRange<int>(0, 63));
  vp8_loop_filter_partial_frame(&cm, &mbd, fdp.ConsumeIntegralInRange<int>(0, 63));

  // Free allocated memory
  free(cm.mi);
  free(cm.frame_to_show->y_buffer);
  free(cm.frame_to_show->u_buffer);
  free(cm.frame_to_show->v_buffer);
  free(cm.frame_to_show);

  return 0;
}[0m
