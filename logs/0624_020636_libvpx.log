  frame_to_show.y_stride = fdp.ConsumeIntegralInRange<int>(16, 32);
  frame_to_show.uv_stride = fdp.ConsumeIntegralInRange<int>(8, 16);
  post_proc_buffer.y_stride = frame_to_show.y_stride;
  post_proc_buffer.uv_stride = frame_to_show.uv_stride;

  const int y_size = cm.mb_rows * 16 * frame_to_show.y_stride;
  const int uv_size = cm.mb_rows * 8 * frame_to_show.uv_stride;
  std::vector<uint8_t> y_buffer(y_size);
  std::vector<uint8_t> u_buffer(uv_size);
  std::vector<uint8_t> v_buffer(uv_size);
  std::vector<uint8_t> yd_buffer(y_size);
  std::vector<uint8_t> ud_buffer(uv_size);
  std::vector<uint8_t> vd_buffer(uv_size);

  frame_to_show.y_buffer = y_buffer.data();
  frame_to_show.u_buffer = u_buffer.data();
  frame_to_show.v_buffer = v_buffer.data();
  post_proc_buffer.y_buffer = yd_buffer.data();
  post_proc_buffer.u_buffer = ud_buffer.data();
  post_proc_buffer.v_buffer = vd_buffer.data();
  cm.frame_to_show = &frame_to_show;
  cm.post_proc_buffer = post_proc_buffer;

  // Initialize MODE_INFO
  const int mi_size = (cm.mb_rows + 1) * (cm.mb_cols + 1);
  std::vector<MODE_INFO> mi(mi_size);
  cm.mi = mi.data();

  // Fuzz vp8_multiframe_quality_enhance
  vp8_multiframe_quality_enhance(&cm);

  // Initialize MACROBLOCKD
  MACROBLOCKD mbd;
  memset(&mbd, 0, sizeof(mbd));
  mbd.subsampling_x = 1;
  mbd.subsampling_y = 1;

  // Fuzz vp8_loop_filter_frame
  vp8_loop_filter_frame(&cm, &mbd, fdp.ConsumeIntegralInRange<int>(0, 63));

  // Fuzz vp8_loop_filter_frame_yonly
  vp8_loop_filter_frame_yonly(&cm, &mbd, fdp.ConsumeIntegralInRange<int>(0, 63));

  // Fuzz vp8_loop_filter_partial_frame
  vp8_loop_filter_partial_frame(&cm, &mbd, fdp.ConsumeIntegralInRange<int>(0, 63));

  // Initialize VP9_COMMON
  VP9_COMMON vp9_cm;
  memset(&vp9_cm, 0, sizeof(vp9_cm));
  vp9_cm.mi_rows = cm.mb_rows;
  vp9_cm.mi_cols = cm.mb_cols;
  vp9_cm.mi = cm.mi;

  // Fuzz vp9_append_sub8x8_mvs_for_idx
  int_mv mv;
  int_mv best_mv;
  uint8_t ref_frame_offset = fdp.ConsumeIntegral<uint8_t>();
  vp9_append_sub8x8_mvs_for_idx(&vp9_cm, &mbd, 0, 0, 0, 0, &mv, &best_mv, &ref_frame_offset);

  return 0;
}[0m
