  if (!cm.frame_to_show) {
    free(cm.mi);
    return 0;
  }
  cm.frame_to_show->y_width = cm.Width;
  cm.frame_to_show->y_height = cm.Height;
  cm.frame_to_show->uv_width = cm.Width / 2;
  cm.frame_to_show->uv_height = cm.Height / 2;
  cm.frame_to_show->y_stride = fdp.ConsumeIntegralInRange<int>(cm.Width, cm.Width * 2);
  cm.frame_to_show->uv_stride = fdp.ConsumeIntegralInRange<int>(cm.frame_to_show->uv_width, cm.frame_to_show->uv_width * 2);
  const size_t y_size = cm.frame_to_show->y_stride * cm.frame_to_show->y_height;
  const size_t uv_size = cm.frame_to_show->uv_stride * cm.frame_to_show->uv_height;
  cm.frame_to_show->y_buffer = static_cast<uint8_t *>(malloc(y_size));
  cm.frame_to_show->u_buffer = static_cast<uint8_t *>(malloc(uv_size));
  cm.frame_to_show->v_buffer = static_cast<uint8_t *>(malloc(uv_size));
  if (!cm.frame_to_show->y_buffer || !cm.frame_to_show->u_buffer || !cm.frame_to_show->v_buffer) {
    free(cm.mi);
    free(cm.frame_to_show->y_buffer);
    free(cm.frame_to_show->u_buffer);
    free(cm.frame_to_show->v_buffer);
    free(cm.frame_to_show);
    return 0;
  }
  fdp.ConsumeData(cm.frame_to_show->y_buffer, y_size);
  fdp.ConsumeData(cm.frame_to_show->u_buffer, uv_size);
  fdp.ConsumeData(cm.frame_to_show->v_buffer, uv_size);

  cm.filter_type = fdp.ConsumeBool() ? NORMAL_LOOPFILTER : SIMPLE_LOOPFILTER;
  cm.sharpness_level = fdp.ConsumeIntegralInRange<int>(0, 7);
  cm.last_sharpness_level = fdp.ConsumeIntegralInRange<int>(0, 7);
