  std::unique_ptr<MACROBLOCKD> mbd = std::make_unique<MACROBLOCKD>();
  if (!mbd) {
    return 0;
  }
  memset(mbd.get(), 0, sizeof(MACROBLOCKD));

  // Initialize YV12_BUFFER_CONFIG structures
  std::unique_ptr<YV12_BUFFER_CONFIG> show = std::make_unique<YV12_BUFFER_CONFIG>();
  if (!show) {
    return 0;
  }
  memset(show.get(), 0, sizeof(YV12_BUFFER_CONFIG));

  std::unique_ptr<YV12_BUFFER_CONFIG> dest = std::make_unique<YV12_BUFFER_CONFIG>();
  if (!dest) {
    return 0;
  }
  memset(dest.get(), 0, sizeof(YV12_BUFFER_CONFIG));

  // Allocate memory for buffers
  const int width = fdp.ConsumeIntegralInRange<int>(16, 1024);
  const int height = fdp.ConsumeIntegralInRange<int>(16, 1024);
  const int stride = width;
  std::vector<uint8_t> y_buffer(stride * height);
  std::vector<uint8_t> u_buffer(stride * height / 4);
  std::vector<uint8_t> v_buffer(stride * height / 4);
  show->y_buffer = y_buffer.data();
  show->u_buffer = u_buffer.data();
  show->v_buffer = v_buffer.data();
  show->y_width = width;
  show->uv_width = width / 2;
  show->y_height = height;
  show->uv_height = height / 2;
  show->y_stride = stride;
  show->uv_stride = stride / 2;

  std::vector<uint8_t> yd_buffer(stride * height);
  std::vector<uint8_t> ud_buffer(stride * height / 4);
  std::vector<uint8_t> vd_buffer(stride * height / 4);
  dest->y_buffer = yd_buffer.data();
  dest->u_buffer = ud_buffer.data();
  dest->v_buffer = vd_buffer.data();
  dest->y_width = width;
  dest->uv_width = width / 2;
  dest->y_height = height;
  dest->uv_height = height / 2;
  dest->y_stride = stride;
  dest->uv_stride = stride / 2;

  cm->frame_to_show = show.get();
  cm->post_proc_buffer = *dest;
  cm->mb_rows = height / 16;
  cm->mb_cols = width / 16;
  cm->mi = (MODE_INFO *)calloc(cm->mb_rows * cm->mb_cols, sizeof(MODE_INFO));
  if (!cm->mi) {
    return 0;
