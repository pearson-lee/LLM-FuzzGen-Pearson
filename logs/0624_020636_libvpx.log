static void FuzzVP9(FuzzedDataProvider& fdp) {
    vpx_codec_iface_t *codec_iface = vpx_codec_vp9_dx();
    vpx_codec_ctx_t codec_ctx;
    if (vpx_codec_dec_init(&codec_ctx, codec_iface, NULL, 0)) {
        return;
    }

    VP9D_COMP pbi;
    memset(&pbi, 0, sizeof(VP9D_COMP));
    pbi.common.width = 128;
    pbi.common.height = 128;
    pbi.common.subsampling_x = 1;
    pbi.common.subsampling_y = 1;

    YV12_BUFFER_CONFIG frame_to_show;
    memset(&frame_to_show, 0, sizeof(YV12_BUFFER_CONFIG));
    if (vpx_alloc_frame_buffer(&frame_to_show, 128, 128, 1, 1, 0, 16, 16)) {
        vpx_codec_destroy(&codec_ctx);
        return;
    }

    if (vpx_realloc_frame_buffer(
            &pbi.common.new_fb, 128, 128, 1, 1, 0, 16, 16, NULL, NULL, NULL)) {
        vpx_free_frame_buffer(&frame_to_show);
        vpx_codec_destroy(&codec_ctx);
        return;
    }
    pbi.common.frame_to_show = &pbi.common.new_fb;

    vp9_build_mask_frame(&pbi.common, fdp.ConsumeIntegralInRange<int>(0, 1), fdp.ConsumeIntegralInRange<int>(0, 1));

    vp9_set_reference_dec(&pbi.common, fdp.ConsumeIntegralInRange<int>(0, 7), &frame_to_show);

    vpx_free_frame_buffer(&pbi.common.new_fb);
    vpx_free_frame_buffer(&frame_to_show);
    vpx_codec_destroy(&codec_ctx);
}[0m
