// Helper function to allocate and initialize a YV12_BUFFER_CONFIG structure.
static void alloc_yv12_buffer(FuzzedDataProvider& fdp, YV12_BUFFER_CONFIG& buf, int width, int height) {
    buf.y_width = width;
    buf.y_height = height;
    buf.uv_width = width / 2;
    buf.uv_height = height / 2;
    buf.y_stride = width;
    buf.uv_stride = width / 2;
    buf.border = 16;
    buf.corrupted = 0;

    const int frame_size = (width + 2 * buf.border) * (height + 2 * buf.border);
    const int uv_frame_size = (width / 2 + 2 * (buf.border / 2)) * (height / 2 + 2 * (buf.border / 2));

    std::vector<uint8_t> y_buffer = fdp.ConsumeBytes<uint8_t>(frame_size);
    std::vector<uint8_t> u_buffer = fdp.ConsumeBytes<uint8_t>(uv_frame_size);
    std::vector<uint8_t> v_buffer = fdp.ConsumeBytes<uint8_t>(uv_frame_size);

    buf.y_buffer = y_buffer.data();
    buf.u_buffer = u_buffer.data();
    buf.v_buffer = v_buffer.data();
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
