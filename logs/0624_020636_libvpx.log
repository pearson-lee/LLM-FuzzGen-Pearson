#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>

#include "vpx/vpx_decoder.h"
#include "vpx/vp8dx.h"
#include "vpx_ports/mem.h"
#include "vp8/common/postproc.h"
#include "vp8/common/loopfilter.h"
#include "fuzzer/FuzzedDataProvider.h"
#include "vp8/common/onyxc_int.h"
#include "vpx_scale/yv12config.h"
#include "vp8/common/blockd.h"
#include "vpx_mem/vpx_mem.h"

extern "C" void vp8_create_common(VP8_COMMON *cm);
extern "C" void vp8_remove_common(VP8_COMMON *cm);

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Create and initialize a VP8_COMMON struct.
  VP8_COMMON cm;
  vp8_create_common(&cm);

  // Initialize the VP8_COMMON struct with random data.
  cm.Width = fdp.ConsumeIntegralInRange<int>(1, 1920);
  cm.Height = fdp.ConsumeIntegralInRange<int>(1, 1080);
  cm.horiz_scale = fdp.ConsumeIntegralInRange<int>(0, 2);
  cm.vert_scale = fdp.ConsumeIntegralInRange<int>(0, 2);
  cm.mb_rows = (cm.Height + 15) / 16;
  cm.mb_cols = (cm.Width + 15) / 16;
  if (cm.mb_rows == 0 || cm.mb_cols == 0) {
    vp8_remove_common(&cm);
    return 0;
  }
  cm.frame_type = static_cast<FRAME_TYPE>(fdp.ConsumeIntegralInRange<int>(0, 1));
  cm.base_qindex = fdp.ConsumeIntegralInRange<int>(0, 127);
  cm.filter_level = fdp.ConsumeIntegralInRange<int>(0, 63);
  cm.postproc_state.last_base_qindex = fdp.ConsumeIntegralInRange<int>(0, 127);
  cm.current_video_frame = fdp.ConsumeIntegral<unsigned int>();
  cm.postproc_state.last_frame_valid = fdp.ConsumeBool();

  // Create a YV12_BUFFER_CONFIG struct for the frame to show.
  YV12_BUFFER_CONFIG show_frame;
  memset(&show_frame, 0, sizeof(show_frame));
  if (vp8_yv12_alloc_frame_buffer(&show_frame, cm.Width, cm.Height, VP8BORDERINPIXELS)) {
    vp8_remove_common(&cm);
    return 0;
  }
  cm.frame_to_show = &show_frame;

  // Create a YV12_BUFFER_CONFIG struct for the post-processing buffer.
  if (vp8_yv12_alloc_frame_buffer(&cm.post_proc_buffer, cm.Width, cm.Height, VP8BORDERINPIXELS)) {
    vp8_yv12_de_alloc_frame_buffer(&show_frame);
    vp8_remove_common(&cm);
    return 0;
  }

  // Create a MODE_INFO array.
  cm.mi = (MODE_INFO*) vpx_calloc((cm.mb_rows + 1) * (cm.mb_cols + 1), sizeof(MODE_INFO));
  if (!cm.mi) {
    vp8_yv12_de_alloc_frame_buffer(&cm.post_proc_buffer);
    vp8_yv12_de_alloc_frame_buffer(&show_frame);
    vp8_remove_common(&cm);
    return 0;
  }
  cm.mode_info_stride = cm.mb_cols + 1;

  // Allocate deblocking limits buffer.
  cm.pp_limits_buffer = (unsigned char *)vpx_calloc(24 * cm.mb_cols, sizeof(unsigned char));
  if (!cm.pp_limits_buffer) {
    vpx_free(cm.mi);
    vp8_yv12_de_alloc_frame_buffer(&cm.post_proc_buffer);
    vp8_yv12_de_alloc_frame_buffer(&show_frame);
    vp8_remove_common(&cm);
    return 0;
  }

  // Setup post-processing flags.
  vp8_ppflags_t ppflags;
  memset(&ppflags, 0, sizeof(ppflags));
  ppflags.post_proc_flag = fdp.ConsumeIntegral<int>();
  ppflags.deblocking_level = fdp.ConsumeIntegralInRange<int>(0, 10);
  ppflags.noise_level = fdp.ConsumeIntegralInRange<int>(0, 10);

  YV12_BUFFER_CONFIG dest;
  memset(&dest, 0, sizeof(dest));

  // Call the function to be fuzzed.
  vp8_post_proc_frame(&cm, &dest, &ppflags);

  // Cleanup. Let vp8_remove_common handle all deallocations.
  vp8_remove_common(&cm);

  return 0;
}[0m
