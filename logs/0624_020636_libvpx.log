  // This leads to a crash when freeing memory later.
  // To avoid this, we only call the functions when mode_ref_lf_delta_enabled is 1.
  if (mbd.mode_ref_lf_delta_enabled) {
    vp8_loop_filter_frame(&cm, &mbd, cm.frame_type);
    vp8_loop_filter_frame_yonly(&cm, &mbd, fdp.ConsumeIntegralInRange<int>(0, 63));
    vp8_loop_filter_partial_frame(&cm, &mbd, fdp.ConsumeIntegralInRange<int>(0, 63));
  }

  // Free allocated memory
  free(cm.mi);
  free(cm.frame_to_show->y_buffer);
  free(cm.frame_to_show->u_buffer);
  free(cm.frame_to_show->v_buffer);
  free(cm.frame_to_show);

  return 0;
}[0m
