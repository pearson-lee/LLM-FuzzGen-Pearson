#include <cstddef>
#include <cstdint>
#include <fuzzer/FuzzedDataProvider.h>
#include "vpx/vpx_decoder.h"
#include "vpx/vp8dx.h"
#include "vp9/decoder/vp9_decoder.h"
#include "vp9/common/vp9_loopfilter.h"
#include "vp9/common/vp9_onyxc_int.h"

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  const int width = fdp.ConsumeIntegralInRange<int>(16, 4096);
  const int height = fdp.ConsumeIntegralInRange<int>(16, 4096);

  // Manually create and initialize decoder structures instead of using the API,
  // to ensure all necessary buffers are allocated for the standalone function calls.
  VP9Decoder pbi_vp9;
  memset(&pbi_vp9, 0, sizeof(pbi_vp9));
  VP9_COMMON *vp9_cm = &pbi_vp9.common;
  MACROBLOCKD *mbd = &pbi_vp9.mb;

  // Allocate a frame buffer
  YV12_BUFFER_CONFIG frame;
  if (vpx_alloc_frame_buffer(&frame, width, height, 16, 16, 16, 0, 0)) {
    return 0;
  }
  // Link the frame buffer to the macroblockd so the loop filter knows
  // where to write.
  mbd->plane[0].dst.buf = frame.y_buffer;
  mbd->plane[0].dst.stride = frame.y_stride;

  // Set up common structure fields.
  vp9_cm->width = width;
  vp9_cm->height = height;
  vp9_cm->mi_rows = (height + 7) >> 3;
  vp9_cm->mi_cols = (width + 7) >> 3;
  vp9_cm->mi_stride = vp9_cm->mi_cols;

  // Allocate the mode info buffer, which is essential for the loop filter.
  const int mi_size = vp9_cm->mi_rows * vp9_cm->mi_stride;
  if (mi_size > 0) {
    vp9_cm->mi = (MODE_INFO *)calloc(mi_size, sizeof(MODE_INFO));
  }
  if (!vp9_cm->mi) {
    vpx_free_frame_buffer(&frame);
    return 0;
  }

  // Set default segmentation and loop filter state.
  vp9_setup_past_independence(vp9_cm);

  // Fuzz vp9_loop_filter_frame
  vp9_loop_filter_frame(&frame, vp9_cm, mbd, fdp.ConsumeIntegral<int>(),
                        fdp.ConsumeBool(), fdp.ConsumeBool());

  // Fuzz vp9_set_reference_dec and vp9_copy_reference_dec
  YV12_BUFFER_CONFIG ref_frame;
  if (vpx_alloc_frame_buffer(&ref_frame, width, height, 16, 16, 16, 0, 0) == 0) {
    vp9_set_reference_dec(vp9_cm,
                          static_cast<VP9_REFFRAME>(fdp.ConsumeIntegralInRange(0, 2)),
                          &ref_frame);
    vp9_copy_reference_dec(&pbi_vp9,
                           static_cast<VP9_REFFRAME>(fdp.ConsumeIntegralInRange(0, 2)),
                           &ref_frame);
    vpx_free_frame_buffer(&ref_frame);
  }

  // Cleanup
  free(vp9_cm->mi);
  vpx_free_frame_buffer(&frame);

  return 0;
}[0m
