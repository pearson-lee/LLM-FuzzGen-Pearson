  VP8_COMMON cm;
  vp8_create_common(&cm);

  // Initialize MACROBLOCKD structure
  MACROBLOCKD mbd;
  mbd.subpixels_x = fdp.ConsumeIntegral<int>();
  mbd.subpixels_y = fdp.ConsumeIntegral<int>();
