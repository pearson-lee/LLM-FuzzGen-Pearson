    // Fuzz each target function with a portion of the input data.
    Fuzz_cmsCreateLinearizationDeviceLinkTHR(context, &data, &size);
    Fuzz_cmsCreateBCHSWabstractProfileTHR(context, &data, &size);
    Fuzz_cmsIT8SetDataDbl(context, &data, &size);
    Fuzz_cmsGetPostScriptCRD(context, &data, &size);
    Fuzz_cmsDefaultICCintents(context, &data, &size);

    // Clean up the context object.
    cmsDeleteContext(context);
    return 0;
}[0m
