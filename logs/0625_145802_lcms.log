#include <stdint.h>
#include <stddef.h>
#include <stdlib.h>
#include <string.h>

// All required APIs are in the main header file.
#include "/src/lcms/include/lcms2.h"

// Helper function to safely consume data from the fuzzing input.
// It advances the data pointer and decrements the size.
// Returns a pointer to the consumed data on success, or NULL if not enough data is available.
static const void* consume_data(const uint8_t** data, size_t* size, size_t len) {
    if (*size < len) {
        return NULL;
    }
    const void* ptr = *data;
    *data += len;
    *size -= len;
    return ptr;
}

// Helper function to create a randomized cmsToneCurve.
// This allows exercising functions that require tone curves as input.
static cmsToneCurve* CreateRandomToneCurve(const uint8_t** data, size_t* size) {
    const uint8_t* type_flag_ptr = consume_data(data, size, 1);
    if (!type_flag_ptr) return NULL;

    // Based on a fuzz byte, decide which type of tone curve to create.
    if (*type_flag_ptr % 2 == 0) {
        // Create a gamma-based tone curve.
        const double* gamma_ptr = consume_data(data, size, sizeof(double));
        if (!gamma_ptr) return NULL;
        
        // Clamp gamma to a reasonable range to avoid extreme/invalid values.
        double gamma = *gamma_ptr;
        if (gamma < 0.1) gamma = 0.1;
        if (gamma > 10.0) gamma = 10.0;
        return cmsBuildGamma(NULL, gamma);
    } else {
        // Create a tabulated tone curve.
        const uint16_t* n_entries_ptr = consume_data(data, size, sizeof(uint16_t));
        if (!n_entries_ptr) return NULL;
        
        // Keep the number of entries small to avoid excessive memory allocation.
        uint32_t n_entries = (*n_entries_ptr % 4094) + 2;

        const uint16_t* values = (const uint16_t*)consume_data(data, size, n_entries * sizeof(uint16_t));
        if (!values) return NULL;
        
        // cmsBuildTabulatedToneCurve16 creates an internal copy of the values,
        // so we don't need to worry about the lifetime of the 'values' pointer.
        return cmsBuildTabulatedToneCurve16(NULL, n_entries, values);
    }
}

// The main fuzzing entry point.
int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    // Create a local copy of the data pointer and size for consumption.
    const uint8_t* data = Data;
    size_t size = Size;

    // Fuzz Target 1: cmsCreateBCHSWabstractProfile
    // This function creates a profile for Brightness/Contrast/Hue/Saturation adjustments.
    {
        // Consume all required parameters from the fuzzing data.
        const uint32_t* nEntries_ptr = (const uint32_t*)consume_data(&data, &size, sizeof(uint32_t));
        const double* brightness_ptr = (const double*)consume_data(&data, &size, sizeof(double));
        const double* contrast_ptr = (const double*)consume_data(&data, &size, sizeof(double));
        const double* hue_ptr = (const double*)consume_data(&data, &size, sizeof(double));
        const double* saturation_ptr = (const double*)consume_data(&data, &size, sizeof(double));
        const uint32_t* tempSrc_ptr = (const uint32_t*)consume_data(&data, &size, sizeof(uint32_t));
        const uint32_t* tempDest_ptr = (const uint32_t*)consume_data(&data, &size, sizeof(uint32_t));

        // Proceed only if all parameters were successfully consumed.
        if (nEntries_ptr && brightness_ptr && contrast_ptr && hue_ptr && saturation_ptr && tempSrc_ptr && tempDest_ptr) {
            // Keep nEntries small to prevent large allocations.
            uint32_t nEntries = *nEntries_ptr % 11;

            cmsHPROFILE bchsProfile = cmsCreateBCHSWabstractProfile(nEntries, *brightness_ptr, *contrast_ptr, *hue_ptr, *saturation_ptr, *tempSrc_ptr, *tempDest_ptr);
            if (bchsProfile) {
                // If profile creation is successful, use it with other APIs.
                // Fuzz Target 4: cmsGetProfileInfo
                wchar_t info_buffer[256];
                cmsGetProfileInfo(bchsProfile, cmsInfoDescription, "en", "US", info_buffer, 256);
                
                // Fuzz Target 5: cmsMD5computeID
                cmsMD5computeID(bchsProfile);
                
                // IMPORTANT: Close the profile to free allocated memory.
                cmsCloseProfile(bchsProfile);
            }
        }
    }

    // Fuzz Target 2: cmsCreateLinearizationDeviceLink
    // This function creates a linearization profile from a set of tone curves.
    {
        const uint8_t* flag_ptr = (const uint8_t*)consume_data(&data, &size, 1);
        if (flag_ptr) {
            // Decide the color space and number of curves based on a fuzz byte.
            cmsColorSpaceSignature colorSpace = (*flag_ptr % 2 == 0) ? cmsSigLabData : cmsSigGrayData;
            int num_curves = (colorSpace == cmsSigLabData) ? 3 : 1;

            cmsToneCurve* curves[3] = {NULL, NULL, NULL};
            int curves_created = 0;
            for (int i = 0; i < num_curves; ++i) {
                curves[i] = CreateRandomToneCurve(&data, &size);
                if (curves[i]) {
                    curves_created++;
                } else {
                    break; // Stop if we run out of data.
                }
            }

            // Only call the target function if all required curves were created.
            if (curves_created == num_curves) {
                cmsHPROFILE linProfile = cmsCreateLinearizationDeviceLink(colorSpace, (const cmsToneCurve**)curves);
                if (linProfile) {
                    // IMPORTANT: Close the profile to free allocated memory.
                    cmsCloseProfile(linProfile);
                }
            }

            // IMPORTANT: Free all tone curves that were created.
            for (int i = 0; i < curves_created; ++i) {
                cmsFreeToneCurve(curves[i]);
            }
        }
    }

    // Fuzz Target 3: cmsIT8SetDataDbl and related functions.
    // These functions handle CGATS.17 (IT8) data.
    {
        cmsHANDLE hIT8 = cmsIT8Alloc(NULL);
        if (hIT8) {
            // Consume data for patch name, sample name, and a double value.
            const char* patch = (const char*)consume_data(&data, &size, 10);
            const char* sample = (const char*)consume_data(&data, &size, 10);
            const double* value_ptr = (const double*)consume_data(&data, &size, sizeof(double));

            if (patch && sample && value_ptr) {
                // Copy the fuzzer data to null-terminated buffers for safety.
                char patch_buf[11];
                char sample_buf[11];
                memcpy(patch_buf, patch, 10);
                memcpy(sample_buf, sample, 10);
                patch_buf[10] = '\0';
                sample_buf[10] = '\0';

                cmsIT8SetDataDbl(hIT8, patch_buf, sample_buf, *value_ptr);
            }

            // Also exercise saving the IT8 object to memory.
            cmsUInt32Number len = 0;
            cmsIT8SaveToMem(hIT8, NULL, &len); // First call to get the required size.
            if (len > 0) {
                void* mem = malloc(len);
                if (mem) {
                    cmsIT8SaveToMem(hIT8, mem, &len); // Second call to write to the buffer.
                    free(mem); // IMPORTANT: Free the allocated buffer.
                }
            }

            // IMPORTANT: Free the IT8 handle to prevent memory leaks.
            cmsIT8Free(hIT8);
        }
    }

    return 0;
}[0m
