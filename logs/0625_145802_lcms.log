#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include "lcms2.h"

// Helper structure to manage the fuzz data buffer.
// This avoids the complexity of FuzzedDataProvider in a C environment.
typedef struct {
  const uint8_t *data;
  size_t size;
  size_t offset;
} FuzzData;

// Helper function to safely extract a value of a given size from the fuzz data.
// Returns 1 on success, 0 on failure (not enough data).
static int GetValue(FuzzData *fuzz_data, void *target, size_t size) {
  if (fuzz_data->offset + size > fuzz_data->size) {
    return 0;
  }
  memcpy(target, fuzz_data->data + fuzz_data->offset, size);
  fuzz_data->offset += size;
  return 1;
}

// Helper function to safely extract a string from the fuzz data.
// The first byte of the data determines the length of the string.
// The string is heap-allocated and must be freed by the caller.
static char *GetString(FuzzData *fuzz_data, size_t max_len) {
  uint8_t len_u8;
  if (!GetValue(fuzz_data, &len_u8, sizeof(len_u8))) {
    return NULL;
  }
  size_t len = len_u8 % (max_len + 1);

  if (fuzz_data->offset + len > fuzz_data->size) {
    return NULL;
  }

  char *str = (char *)malloc(len + 1);
  if (!str) {
    return NULL;
  }

  memcpy(str, fuzz_data->data + fuzz_data->offset, len);
  str[len] = '\0';
  fuzz_data->offset += len;
  return str;
}

// Fuzz target entry point
int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzData fuzz_data = {Data, Size, 0};

  // Use a single context for all lcms operations.
  // Using NULL for the user data pointer.
  cmsContext ctx = cmsCreateContext(NULL, NULL);
  if (!ctx) {
    return 0;
  }

  cmsHPROFILE hBCHSWProfile = NULL;
  cmsHPROFILE hLinProfile = NULL;

  // --- Target 1: cmsCreateBCHSWabstractProfileTHR ---
  // This function creates a profile for Brightness, Contrast, Hue, and Saturation
  // adjustments. It's a good way to generate a valid profile object.
  uint32_t nEntries;
  double brightness, contrast, hue, saturation;
  uint32_t tempSrc, tempDst;

  if (GetValue(&fuzz_data, &nEntries, sizeof(nEntries)) &&
      GetValue(&fuzz_data, &brightness, sizeof(brightness)) &&
      GetValue(&fuzz_data, &contrast, sizeof(contrast)) &&
      GetValue(&fuzz_data, &hue, sizeof(hue)) &&
      GetValue(&fuzz_data, &saturation, sizeof(saturation)) &&
      GetValue(&fuzz_data, &tempSrc, sizeof(tempSrc)) &&
      GetValue(&fuzz_data, &tempDst, sizeof(tempDst))) {
    // Limit nEntries to a reasonable value to prevent excessive memory allocation.
    nEntries = (nEntries % 4096) + 1;
    hBCHSWProfile = cmsCreateBCHSWabstractProfileTHR(
        ctx, nEntries, brightness, contrast, hue, saturation, tempSrc, tempDst);
  }

  // --- Target 2: cmsCreateLinearizationDeviceLinkTHR ---
  // This function creates a linearization profile, which requires tone curves.
  // This tests the creation of more complex profiles.
  uint32_t colorSpaceInt;
  if (GetValue(&fuzz_data, &colorSpaceInt, sizeof(colorSpaceInt))) {
    // Select a color space based on fuzzer input.
    cmsColorSpaceSignature sigs[] = {cmsSigGrayData, cmsSigRgbData,
                                     cmsSigCmykData, cmsSigLabData};
    cmsColorSpaceSignature colorSpace =
        sigs[colorSpaceInt % (sizeof(sigs) / sizeof(sigs[0]))];
    int numChannels = cmsChannelsOfColorSpace(colorSpace);

    const int MAX_CHANNELS = 15; // From cmsMAX_CHANNELS
    if (numChannels > 0 && numChannels <= MAX_CHANNELS) {
      cmsToneCurve *curves[MAX_CHANNELS];
      const cmsToneCurve *curve_ptrs[MAX_CHANNELS];
      int curves_created_count = 0;

      // Create the required number of tone curves.
      for (int i = 0; i < numChannels; i++) {
        double gamma;
        if (GetValue(&fuzz_data, &gamma, sizeof(gamma))) {
          curves[i] = cmsBuildGamma(ctx, gamma);
          if (curves[i]) {
            curve_ptrs[i] = curves[i];
            curves_created_count++;
          } else {
            break; // Stop if a curve creation fails.
          }
        } else {
          break; // Stop if we run out of fuzz data.
        }
      }

      // If all curves were created, create the device link profile.
      if (curves_created_count == numChannels) {
        hLinProfile =
            cmsCreateLinearizationDeviceLinkTHR(ctx, colorSpace, curve_ptrs);
      }

      // Clean up all created tone curves.
      for (int i = 0; i < curves_created_count; i++) {
        cmsFreeToneCurve(curves[i]);
      }
    }
  }

  // --- Target 3: cmsIT8SetDataDbl ---
  // This function is part of the IT8 API for handling color data tables.
  cmsHANDLE hIT8 = cmsIT8Alloc(ctx);
  if (hIT8) {
    char *patch = GetString(&fuzz_data, 32);
    char *sample = GetString(&fuzz_data, 32);
    double val;

    if (patch && sample && GetValue(&fuzz_data, &val, sizeof(val))) {
      cmsIT8SetDataDbl(hIT8, patch, sample, val);
    }

    // Clean up allocated strings and the IT8 handle.
    free(patch);
    free(sample);
    cmsIT8Free(hIT8);
  }

  // --- Target 4: cmsMD5computeID ---
  // This function computes an MD5 hash of a profile's contents.
  // It's a simple utility function that operates on a profile handle.
  if (hBCHSWProfile) {
    cmsMD5computeID(hBCHSWProfile);
  }
  if (hLinProfile) {
    cmsMD5computeID(hLinProfile);
  }

  // --- Target 5: cmsGetPostScriptCRD ---
  // This function generates a PostScript Color Rendering Dictionary.
  // Use one of the previously created profiles as input.
  cmsHPROFILE profile_to_use = hBCHSWProfile ? hBCHSWProfile : hLinProfile;
  if (profile_to_use) {
    uint32_t intent, flags;
    if (GetValue(&fuzz_data, &intent, sizeof(intent)) &&
        GetValue(&fuzz_data, &flags, sizeof(flags))) {
      // First, call with a NULL buffer to get the required size.
      cmsUInt32Number bufferSize =
          cmsGetPostScriptCRD(ctx, profile_to_use, intent, flags, NULL, 0);
      if (bufferSize > 0) {
        // Allocate the buffer and call again to get the data.
        void *buffer = malloc(bufferSize);
        if (buffer) {
          cmsGetPostScriptCRD(ctx, profile_to_use, intent, flags, buffer,
                              bufferSize);
          // Free the buffer after use.
          free(buffer);
        }
      }
    }
  }

  // --- Cleanup ---
  // Free all allocated resources to prevent memory leaks.
  if (hBCHSWProfile) {
    cmsCloseProfile(hBCHSWProfile);
  }
  if (hLinProfile) {
    cmsCloseProfile(hLinProfile);
  }
  cmsDeleteContext(ctx);

  return 0;
}[0m
