// Target 1: cmsCreateLinearizationDeviceLinkTHR
// This function creates a linearization device link profile. We fuzz it by
// creating tone curves for various color spaces.
void Fuzz_cmsCreateLinearizationDeviceLinkTHR(cmsContext context, const uint8_t **data, size_t *size) {
    if (*size < 1 + sizeof(double)) return;

    uint8_t cs_choice;
    CONSUME_DATA(uint8_t, cs_choice, data, size);
    
    cmsColorSpaceSignature color_space;
    switch (cs_choice % 3) {
        case 0: color_space = cmsSigGrayData; break;
        case 1: color_space = cmsSigRgbData; break;
        default: color_space = cmsSigCmykData; break;
    }

    uint32_t n_channels = cmsChannelsOfColorSpace(color_space);
    if (n_channels == 0 || n_channels > 16) return;

    cmsToneCurve* curves[16];
    double gamma;
    CONSUME_DATA(double, gamma, data, size);

    for (uint32_t i = 0; i < n_channels; i++) {
        curves[i] = cmsBuildGamma(context, 1.0 + (gamma / 10.0));
        if (!curves[i]) {
            for (uint32_t j = 0; j < i; j++) {
                cmsFreeToneCurve(curves[j]);
            }
            return;
        }
    }

    cmsHPROFILE hProfile = cmsCreateLinearizationDeviceLinkTHR(context, color_space, (const cmsToneCurve**)curves);
    if (hProfile) {
        cmsCloseProfile(hProfile);
    }

    for (uint32_t i = 0; i < n_channels; i++) {
        cmsFreeToneCurve(curves[i]);
    }
}

// Target 2: cmsCreateBCHSWabstractProfileTHR
// This function creates a profile for Brightness/Contrast/Hue/Saturation adjustments.
// We fuzz its parameters to test the color manipulation logic.
void Fuzz_cmsCreateBCHSWabstractProfileTHR(cmsContext context, const uint8_t **data, size_t *size) {
    if (*size < sizeof(uint8_t) + 4 * sizeof(double) + 2 * sizeof(uint32_t)) return;

    uint8_t nLutPoints;
    double brightness, contrast, hue, saturation;
    uint32_t temp_src, temp_dest;

    CONSUME_DATA(uint8_t, nLutPoints, data, size);
    CONSUME_DATA(double, brightness, data, size);
    CONSUME_DATA(double, contrast, data, size);
    CONSUME_DATA(double, hue, data, size);
    CONSUME_DATA(double, saturation, data, size);
    CONSUME_DATA(uint32_t, temp_src, data, size);
    CONSUME_DATA(uint32_t, temp_dest, data, size);

    cmsHPROFILE hProfile = cmsCreateBCHSWabstractProfileTHR(context, (nLutPoints % 32) + 2, brightness, contrast, hue, saturation, temp_src, temp_dest);
    if (hProfile) {
        cmsCloseProfile(hProfile);
    }
}

// Target 3: cmsIT8SetDataDbl
// This function sets data in an IT8 object, which is used for color communication.
// We fuzz the patch/sample names and the data value.
void Fuzz_cmsIT8SetDataDbl(cmsContext context, const uint8_t **data, size_t *size) {
    if (*size < 20 + sizeof(double)) return;

    char patch[11];
    char sample[11];
    memcpy(patch, *data, 10);
    patch[10] = '\0';
    *data += 10;
    *size -= 10;

    memcpy(sample, *data, 10);
    sample[10] = '\0';
    *data += 10;
    *size -= 10;
    
    double val;
    CONSUME_DATA(double, val, data, size);

    cmsHANDLE hIT8 = cmsIT8Alloc(context);
    if (hIT8) {
        cmsIT8SetDataDbl(hIT8, patch, sample, val);
        cmsIT8Free(hIT8);
    }
}

// Target 4: cmsGetPostScriptCRD
// This function generates a PostScript Color Rendering Dictionary. We fuzz the
// intent and flags to test different generation paths.
void Fuzz_cmsGetPostScriptCRD(cmsContext context, const uint8_t **data, size_t *size) {
    if (*size < sizeof(uint32_t) * 2) return;

    uint32_t intent, flags;
    CONSUME_DATA(uint32_t, intent, data, size);
    CONSUME_DATA(uint32_t, flags, data, size);

    cmsHPROFILE hProfile = cmsCreate_sRGBProfileTHR(context);
    if (hProfile) {
        cmsUInt32Number crd_size = cmsGetPostScriptCRD(context, hProfile, intent, flags, NULL, 0);
        if (crd_size > 0 && crd_size < 100000) { // Limit allocation size
            void* buffer = malloc(crd_size);
            if (buffer) {
                cmsGetPostScriptCRD(context, hProfile, intent, flags, buffer, crd_size);
                free(buffer);
            }
        }
        cmsCloseProfile(hProfile);
    }
}

