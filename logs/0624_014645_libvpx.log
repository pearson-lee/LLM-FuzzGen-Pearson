    vp9_cm.mi_rows = fdp.ConsumeIntegralInRange<int>(1, 100);
    vp9_cm.mi_cols = fdp.ConsumeIntegralInRange<int>(1, 100);

    MACROBLOCKD xd;
    memset(&xd, 0, sizeof(xd));
    for (int i = 0; i < MAX_MB_PLANE; ++i) {
      xd.plane[i].subsampling_x = 0;
      xd.plane[i].subsampling_y = 0;
    }

    YV12_BUFFER_CONFIG frame;
    memset(&frame, 0, sizeof(frame));
    frame.y_width = vp9_cm.mi_cols * 8;
    frame.y_height = vp9_cm.mi_rows * 8;
    frame.uv_width = frame.y_width / 2;
    frame.uv_height = frame.y_height / 2;
    frame.y_stride = frame.y_width;
    frame.uv_stride = frame.uv_width;
    frame.y_buffer = (uint8_t *)malloc(frame.y_width * frame.y_height);
    frame.u_buffer = (uint8_t *)malloc(frame.uv_width * frame.uv_height);
    frame.v_buffer = (uint8_t *)malloc(frame.uv_width * frame.uv_height);

    if (frame.y_buffer && frame.u_buffer && frame.v_buffer) {
        vp9_loop_filter_frame_init(&vp9_cm, filter_level);
        vp9_loop_filter_frame(&frame, &vp9_cm, &xd, filter_level, fdp.ConsumeBool(), fdp.ConsumeBool());
    }

    free(frame.y_buffer);
    free(frame.u_buffer);
    free(frame.v_buffer);
  }

  // vp9_find_mv_refs
  if (fdp.remaining_bytes() > 1000) {
    VP9_COMMON cm;
    memset(&cm, 0, sizeof(cm));
    MACROBLOCKD xd;
    memset(&xd, 0, sizeof(xd));
    MODE_INFO mi;
    memset(&mi, 0, sizeof(mi));
    MV_REFERENCE_FRAME ref_frame = (MV_REFERENCE_FRAME)fdp.ConsumeIntegralInRange<int>(0, 3);
    int_mv mv_ref_list[MAX_MV_REF_CANDIDATES];
    uint8_t mode_context[MAX_REF_FRAMES];
    vp9_find_mv_refs(&cm, &xd, &mi, ref_frame, mv_ref_list, fdp.ConsumeIntegral<int>(), fdp.ConsumeIntegral<int>(), mode_context);
  }

  // vp9_build_inter_predictors_sb
  if (fdp.remaining_bytes() > 1000) {
    MACROBLOCKD xd;
    memset(&xd, 0, sizeof(xd));
    BLOCK_SIZE bsize = (BLOCK_SIZE)fdp.ConsumeIntegralInRange<int>(0, BLOCK_SIZES - 1);
    vp9_build_inter_predictors_sb(&xd, fdp.ConsumeIntegral<int>(), fdp.ConsumeIntegral<int>(), bsize);
  }

  return 0;
}[0m
