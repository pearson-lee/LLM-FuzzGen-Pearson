#include <cstddef>
#include <cstdint>
#include <fuzzer/FuzzedDataProvider.h>
#include "vpx/vpx_decoder.h"
#include "vpx/vp8dx.h"
#include "vp8/common/onyxd.h"
#include "vp8/common/loopfilter.h"
#include "vp8/common/postproc.h"
#include "vp9/common/vp9_loopfilter.h"
#include "vp9/common/vp9_reconinter.h"
#include "vp9/common/vp9_mvref_common.h"

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // vp8_loop_filter_frame
  if (fdp.remaining_bytes() > 1000) {
    VP8_COMMON vp8_cm;
    memset(&vp8_cm, 0, sizeof(vp8_cm));
    vp8_cm.frame_type = (FRAME_TYPE)fdp.ConsumeIntegralInRange<int>(0, 1);
    vp8_cm.filter_type = (LOOPFILTERTYPE)fdp.ConsumeIntegralInRange<int>(0, 1);
    vp8_cm.sharpness_level = fdp.ConsumeIntegralInRange<int>(0, 7);
    vp8_cm.last_sharpness_level = fdp.ConsumeIntegralInRange<int>(0, 7);
    vp8_cm.mb_rows = fdp.ConsumeIntegralInRange<int>(1, 100);
    vp8_cm.mb_cols = fdp.ConsumeIntegralInRange<int>(1, 100);
    vp8_cm.base_qindex = fdp.ConsumeIntegralInRange<int>(0, 127);
    vp8_cm.postproc_state.last_base_qindex = fdp.ConsumeIntegralInRange<int>(0, 127);

    MACROBLOCKD mbd;
    memset(&mbd, 0, sizeof(mbd));
    mbd.segmentation_enabled = fdp.ConsumeBool();
    mbd.mb_segment_abs_delta = fdp.ConsumeBool();
    mbd.mode_ref_lf_delta_enabled = fdp.ConsumeBool();

    YV12_BUFFER_CONFIG yv12_buffer;
    memset(&yv12_buffer, 0, sizeof(yv12_buffer));
    yv12_buffer.y_width = vp8_cm.mb_cols * 16;
    yv12_buffer.y_height = vp8_cm.mb_rows * 16;
    yv12_buffer.uv_width = yv12_buffer.y_width / 2;
    yv12_buffer.uv_height = yv12_buffer.y_height / 2;
    yv12_buffer.y_stride = yv12_buffer.y_width;
    yv12_buffer.uv_stride = yv12_buffer.uv_width;
    yv12_buffer.y_buffer = (uint8_t *)malloc(yv12_buffer.y_width * yv12_buffer.y_height);
    yv12_buffer.u_buffer = (uint8_t *)malloc(yv12_buffer.uv_width * yv12_buffer.uv_height);
    yv12_buffer.v_buffer = (uint8_t *)malloc(yv12_buffer.uv_width * yv12_buffer.uv_height);
    vp8_cm.frame_to_show = &yv12_buffer;

    vp8_loop_filter_frame(&vp8_cm, &mbd, vp8_cm.frame_type);
    free(yv12_buffer.y_buffer);
    free(yv12_buffer.u_buffer);
    free(yv12_buffer.v_buffer);
  }

  // vp9_loop_filter_frame
  if (fdp.remaining_bytes() > 1000) {
    VP9_COMMON vp9_cm;
    memset(&vp9_cm, 0, sizeof(vp9_cm));
    vp9_cm.frame_type = (FRAME_TYPE)fdp.ConsumeIntegralInRange<int>(0, 1);
    vp9_cm.filter_level = fdp.ConsumeIntegralInRange<int>(0, 63);
    vp9_cm.mi_rows = fdp.ConsumeIntegralInRange<int>(1, 100);
    vp9_cm.mi_cols = fdp.ConsumeIntegralInRange<int>(1, 100);

    MACROBLOCKD xd;
    memset(&xd, 0, sizeof(xd));

    YV12_BUFFER_CONFIG frame;
    memset(&frame, 0, sizeof(frame));
    frame.y_width = vp9_cm.mi_cols * 8;
    frame.y_height = vp9_cm.mi_rows * 8;
    frame.uv_width = frame.y_width / 2;
    frame.uv_height = frame.y_height / 2;
    frame.y_stride = frame.y_width;
    frame.uv_stride = frame.uv_width;
    frame.y_buffer = (uint8_t *)malloc(frame.y_width * frame.y_height);
    frame.u_buffer = (uint8_t *)malloc(frame.uv_width * frame.uv_height);
    frame.v_buffer = (uint8_t *)malloc(frame.uv_width * frame.uv_height);

    vp9_loop_filter_frame(&frame, &vp9_cm, &xd, vp9_cm.filter_level, fdp.ConsumeBool(), fdp.ConsumeBool());
    free(frame.y_buffer);
    free(frame.u_buffer);
    free(frame.v_buffer);
  }

  // vp8_multiframe_quality_enhance
  if (fdp.remaining_bytes() > 1000) {
    VP8_COMMON cm;
    memset(&cm, 0, sizeof(cm));
    cm.frame_type = (FRAME_TYPE)fdp.ConsumeIntegralInRange<int>(0, 1);
    cm.mb_rows = fdp.ConsumeIntegralInRange<int>(1, 100);
    cm.mb_cols = fdp.ConsumeIntegralInRange<int>(1, 100);
    cm.base_qindex = fdp.ConsumeIntegralInRange<int>(0, 127);
    cm.postproc_state.last_base_qindex = fdp.ConsumeIntegralInRange<int>(0, 127);

    YV12_BUFFER_CONFIG show;
    memset(&show, 0, sizeof(show));
    show.y_width = cm.mb_cols * 16;
    show.y_height = cm.mb_rows * 16;
    show.uv_width = show.y_width / 2;
    show.uv_height = show.y_height / 2;
    show.y_stride = show.y_width;
    show.uv_stride = show.uv_width;
    show.y_buffer = (uint8_t *)malloc(show.y_width * show.y_height);
    show.u_buffer = (uint8_t *)malloc(show.uv_width * show.uv_height);
    show.v_buffer = (uint8_t *)malloc(show.uv_width * show.uv_height);
    cm.frame_to_show = &show;

    YV12_BUFFER_CONFIG dest;
    memset(&dest, 0, sizeof(dest));
    dest.y_width = cm.mb_cols * 16;
    dest.y_height = cm.mb_rows * 16;
    dest.uv_width = dest.y_width / 2;
    dest.uv_height = dest.y_height / 2;
    dest.y_stride = dest.y_width;
    dest.uv_stride = dest.uv_width;
    dest.y_buffer = (uint8_t *)malloc(dest.y_width * dest.y_height);
    dest.u_buffer = (uint8_t *)malloc(dest.uv_width * dest.uv_height);
    dest.v_buffer = (uint8_t *)malloc(dest.uv_width * dest.uv_height);
    cm.post_proc_buffer = dest;

    vp8_multiframe_quality_enhance(&cm);
    free(show.y_buffer);
    free(show.u_buffer);
    free(show.v_buffer);
    free(dest.y_buffer);
    free(dest.u_buffer);
    free(dest.v_buffer);
  }

  // vp9_find_mv_refs
  if (fdp.remaining_bytes() > 1000) {
    VP9_COMMON cm;
    memset(&cm, 0, sizeof(cm));
    MACROBLOCKD xd;
    memset(&xd, 0, sizeof(xd));
    MODE_INFO mi;
    memset(&mi, 0, sizeof(mi));
    MV_REFERENCE_FRAME ref_frame = (MV_REFERENCE_FRAME)fdp.ConsumeIntegralInRange<int>(0, 3);
    int_mv mv_ref_list[MAX_MV_REF_CANDIDATES];
    uint8_t mode_context[MAX_REF_FRAMES];
    vp9_find_mv_refs(&cm, &xd, &mi, ref_frame, mv_ref_list, fdp.ConsumeIntegral<int>(), fdp.ConsumeIntegral<int>(), mode_context);
  }

  // vp9_build_inter_predictors_sb
  if (fdp.remaining_bytes() > 1000) {
    MACROBLOCKD xd;
    memset(&xd, 0, sizeof(xd));
    BLOCK_SIZE bsize = (BLOCK_SIZE)fdp.ConsumeIntegralInRange<int>(0, BLOCK_SIZES - 1);
    vp9_build_inter_predictors_sb(&xd, fdp.ConsumeIntegral<int>(), fdp.ConsumeIntegral<int>(), bsize);
  }

  return 0;
}[0m
