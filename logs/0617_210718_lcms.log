    io_handler.ContextID = &fuzzer_io_context;
    io_handler.Read = ReadFn;
    io_handler.Seek = SeekFn;
    io_handler.Close = CloseFn;
    io_handler.Tell = TellFn;
    io_handler.Open = OpenFn;
    io_handler.ReportError = ReportErrorFn;

    cmsBool open_fast = fdp.ConsumeBool(); // Fuzz the 'open_fast' parameter

    // Call the API and use unique_ptr for cmsHPROFILE to ensure it's closed.
    std::unique_ptr<void, ProfileDeleter> profile_ptr(
        cmsOpenProfileFromIOhandler2THR(ctx, &io_handler, open_fast)
    );
    cmsHPROFILE hProfile = static_cast<cmsHPROFILE>(profile_ptr.get());

    // --- API 2: _cmsDefaultICCintents ---
    // This function creates a pipeline for default ICC intents.
    // It requires a cmsHPROFILE, which we get from the previous call.
    cmsUInt32Number nProfiles = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 5); // Fuzz number of profiles
    std::vector<cmsUInt32Number> intents(nProfiles);
    std::vector<cmsHPROFILE> profiles(nProfiles);
    std::vector<cmsBool> bcmm(nProfiles);
    std::vector<cmsFloat64Number> adaptationStates(nProfiles);

    // Populate the arrays with fuzzed data.
    for (cmsUInt32Number i = 0; i < nProfiles; ++i) {
        intents[i] = fdp.ConsumeIntegral<cmsUInt32Number>();
        profiles[i] = hProfile; // Use the opened profile (can be NULL if opening failed)
        bcmm[i] = fdp.ConsumeBool();
        adaptationStates[i] = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
    }
    cmsUInt32Number flags = fdp.ConsumeIntegral<cmsUInt32Number>();

    // Call the API and use unique_ptr for cmsPipeline to ensure it's freed.
    std::unique_ptr<void, PipelineDeleter> pipeline_ptr(
        _cmsDefaultICCintents(ctx, nProfiles, intents.data(), profiles.data(), bcmm.data(), adaptationStates.data(), flags)
    );

    // --- API 3: _cmsChain2Lab ---
    // This function chains profiles to Lab color space.
    cmsUInt32Number nProfilesChain = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 5);
    cmsUInt32Number InputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
    cmsUInt32Number OutputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
    
    std::vector<cmsUInt32Number> intentsChain(nProfilesChain);
    std::vector<cmsHPROFILE> profilesChain(nProfilesChain);
    std::vector<cmsBool> bcmmChain(nProfilesChain);
    std::vector<cmsFloat64Number> adaptationStatesChain(nProfilesChain);

    // Populate the arrays with fuzzed data.
    for (cmsUInt32Number i = 0; i < nProfilesChain; ++i) {
        intentsChain[i] = fdp.ConsumeIntegral<cmsUInt32Number>();
        profilesChain[i] = hProfile; // Use the opened profile
        bcmmChain[i] = fdp.ConsumeBool();
        adaptationStatesChain[i] = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
    }
    cmsUInt32Number flagsChain = fdp.ConsumeIntegral<cmsUInt32Number>();

    // Call the API and use unique_ptr for cmsHTRANSFORM to ensure it's deleted.
    std::unique_ptr<void, TransformDeleter> transform_ptr(
        _cmsChain2Lab(ctx, nProfilesChain, InputFormat, OutputFormat, intentsChain.data(), profilesChain.data(), bcmmChain.data(), adaptationStatesChain.data(), flagsChain)
    );

    // --- API 4: _cmsBuildKToneCurve ---
    // This function builds a tone curve.
    cmsUInt32Number nSegments = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 10);
    cmsUInt32Number nPoints = fdp.ConsumeIntegralInRange<cmsUInt32Number>(2, 256); // Tone curves typically need at least 2 points

    std::vector<cmsUInt32Number> segments(nSegments);
    std::vector<cmsHPROFILE> profilesCurve(nSegments);
    std::vector<cmsBool> bcmmCurve(nSegments);
    std::vector<cmsFloat64Number> adaptationStatesCurve(nSegments);

    // Populate the arrays with fuzzed data.
    for (cmsUInt32Number i = 0; i < nSegments; ++i) {
        segments[i] = fdp.ConsumeIntegral<cmsUInt32Number>();
        profilesCurve[i] = hProfile; // Use the opened profile
        bcmmCurve[i] = fdp.ConsumeBool();
        adaptationStatesCurve[i] = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
    }
    cmsUInt32Number flagsCurve = fdp.ConsumeIntegral<cmsUInt32Number>();

    // Call the API and use unique_ptr for cmsToneCurve to ensure it's freed.
    std::unique_ptr<void, ToneCurveDeleter> tone_curve_ptr(
        _cmsBuildKToneCurve(ctx, nSegments, nPoints, segments.data(), profilesCurve.data(), bcmmCurve.data(), adaptationStatesCurve.data(), flagsCurve)
    );

