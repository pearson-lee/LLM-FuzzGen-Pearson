#include <cstddef>
#include <cstdint>
#include <vector>
#include <algorithm>
#include <memory> // For std::unique_ptr
#include <string>

#include <fuzzer/FuzzedDataProvider.h>

// lcms headers
// Always emit #include with the full project-relative path in quotes.
#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/include/lcms2_plugin.h"
#include "/src/lcms/src/lcms2_internal.h" // For internal structures like cmsIOHANDLER

// Custom IO handler for fuzzing
// This struct holds the FuzzedDataProvider instance and current offset,
// allowing lcms functions to read fuzzed data.
struct FuzzerIOHandler {
    FuzzedDataProvider* fdp;
    cmsUInt32Number current_offset;
};

// Read function for the custom IO handler.
// It consumes bytes from the FuzzedDataProvider and copies them to the buffer.
static cmsUInt32Number ReadFn(cmsIOHANDLER* io, void* Buffer, cmsUInt32Number Size, cmsUInt32Number Count) {
    FuzzerIOHandler* handler = static_cast<FuzzerIOHandler*>(io->ContextID);
    size_t bytes_to_read = static_cast<size_t>(Size) * Count;
    if (bytes_to_read == 0) return 0;

    // Ensure we don't read beyond the available data in FuzzedDataProvider.
    size_t available_bytes = handler->fdp->remaining_bytes();
    size_t actual_read_bytes = std::min(bytes_to_read, available_bytes);

    // Consume bytes from FuzzedDataProvider and copy to buffer.
    std::vector<uint8_t> data = handler->fdp->ConsumeBytes<uint8_t>(actual_read_bytes);
    if (!data.empty()) {
        memcpy(Buffer, data.data(), actual_read_bytes);
    }

    handler->current_offset += static_cast<cmsUInt32Number>(actual_read_bytes);
    return static_cast<cmsUInt32Number>(actual_read_bytes / Size); // Return number of items read
}

// Seek function for the custom IO handler.
// FuzzedDataProvider is forward-only. Backward seeks are not supported and will return FALSE.
static cmsBool SeekFn(cmsIOHANDLER* io, cmsUInt32Number Offset) {
    FuzzerIOHandler* handler = static_cast<FuzzerIOHandler*>(io->ContextID);
    if (Offset < handler->current_offset) {
        return FALSE; // Cannot seek backward with FuzzedDataProvider.
    }
    
    size_t bytes_to_skip = static_cast<size_t>(Offset) - handler->current_offset;
    handler->fdp->ConsumeBytes<uint8_t>(bytes_to_skip); // Simulate seeking forward by consuming bytes.
    handler->current_offset = Offset;
    return TRUE;
}

// Tell function for the custom IO handler. Returns the current offset.
static cmsUInt32Number TellFn(cmsIOHANDLER* io) {
    FuzzerIOHandler* handler = static_cast<FuzzerIOHandler*>(io->ContextID);
    return handler->current_offset;
}

// Close function for the custom IO handler. No specific cleanup needed for FuzzedDataProvider.
static cmsBool CloseFn(cmsIOHANDLER* io) {
    return TRUE;
}

// Dummy Open function, not directly used by the fuzzer's IO setup.
static cmsIOHANDLER* OpenFn(cmsContext ContextID, const char* FileNameMode, const char* AccessMode) {
    return nullptr;
}

// Dummy ReportError function to suppress lcms errors during fuzzing.
static void ReportErrorFn(cmsContext ContextID, cmsUInt32Number Error, const char* Text) {
    // Suppress errors to avoid excessive output during fuzzing.
}

// Custom deleters for std::unique_ptr to ensure proper lcms resource deallocation.
// This is crucial for memory safety and preventing leaks.

// Deletes a cmsContext.
struct ContextDeleter {
    void operator()(cmsContext ctx) const {
        if (ctx) cmsDeleteContext(ctx);
    }
};

// Closes a cmsHPROFILE.
struct ProfileDeleter {
    void operator()(cmsHPROFILE profile) const {
        if (profile) cmsCloseProfile(profile);
    }
};

// Frees a cmsPipeline.
struct PipelineDeleter {
    void operator()(cmsPipeline* pipeline) const {
        if (pipeline) cmsPipelineFree(pipeline);
    }
};

// Deletes a cmsHTRANSFORM.
struct TransformDeleter {
    void operator()(cmsHTRANSFORM transform) const {
        if (transform) cmsDeleteTransform(transform);
    }
};

// Frees a cmsToneCurve.
struct ToneCurveDeleter {
    void operator()(cmsToneCurve* curve) const {
        if (curve) cmsFreeToneCurve(curve);
    }
};

