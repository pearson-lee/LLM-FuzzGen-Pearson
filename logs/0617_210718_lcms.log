    // This function retrieves information from a profile.
    if (hProfile) { // Only call if a profile was successfully opened.
        cmsInfoType infoType = fdp.ConsumeEnum<cmsInfoType>(); // Fuzz the info type enum.
        std::string locale = fdp.ConsumeRandomLengthString(16);
        std::string country = fdp.ConsumeRandomLengthString(16);

