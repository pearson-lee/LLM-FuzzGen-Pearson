#include <fuzzer/FuzzedDataProvider.h> // Required for FuzzedDataProvider
#include "/src/lcms/include/lcms2.h" // Main lcms2 header
#include "/src/lcms/include/lcms2_plugin.h" // Plugin related definitions
#include "/src/lcms/src/lcms2_internal.h" // Internal definitions for selected APIs

#include <memory> // For std::unique_ptr
#include <vector> // For std::vector
#include <cstring> // For memcpy

// Custom IO handler structure to interface lcms with FuzzedDataProvider.
// This allows lcms functions that expect an cmsIOHANDLER to read from the fuzzer's input.
typedef struct {
    cmsIOHANDLER  iohandler;      // The lcms IO handler structure
    FuzzedDataProvider* fdp;      // Pointer to the FuzzedDataProvider instance
    cmsUInt32Number current_pos;  // Current read position within the fuzzer input
    cmsUInt32Number total_size;   // Total size of the fuzzer input available for this handler
} FuzzIOHandler;

// Read function for the custom IO handler.
// Reads 'Count' items of 'Size' bytes into 'Buffer' from the fuzzer input.
static cmsUInt32Number ReadFn(cmsIOHANDLER* iohandler, void* Buffer, cmsUInt32Number Size, cmsUInt32Number Count) {
    FuzzIOHandler* fih = (FuzzIOHandler*)iohandler->ContextID;
    if (!fih || !fih->fdp) return 0; // Ensure handler is valid

    size_t bytes_to_read = Size * Count;
    // Limit read to available data
    if (fih->current_pos + bytes_to_read > fih->total_size) {
        bytes_to_read = fih->total_size - fih->current_pos;
    }

    if (bytes_to_read == 0) return 0;

    // Consume bytes from FuzzedDataProvider and copy to buffer.
    // This effectively "reads" data from the fuzzer's input stream.
    std::vector<uint8_t> data = fih->fdp->ConsumeBytes<uint8_t>(bytes_to_read);
    if (data.empty()) return 0; // No more data to read

    memcpy(Buffer, data.data(), data.size());
    fih->current_pos += data.size(); // Update current position

    return (cmsUInt32Number)(data.size() / Size); // Return number of items read
}

// Seek function for the custom IO handler.
// Updates the internal current_pos to simulate seeking.
// Note: FuzzedDataProvider does not support true seeking backwards,
// so this primarily updates the internal pointer for sequential reads.
static cmsBool SeekFn(cmsIOHANDLER* iohandler, cmsUInt32Number Offset) {
    FuzzIOHandler* fih = (FuzzIOHandler*)iohandler->ContextID;
    if (!fih) return FALSE;

    // Ensure offset is within bounds
    if (Offset > fih->total_size) return FALSE;

    fih->current_pos = Offset; // Update current position
    return TRUE;
}

// Tell function for the custom IO handler.
// Returns the current read position.
static cmsUInt32Number TellFn(cmsIOHANDLER* iohandler) {
    FuzzIOHandler* fih = (FuzzIOHandler*)iohandler->ContextID;
    if (!fih) return 0;
    return fih->current_pos;
}

// Close function for the custom IO handler.
// No specific cleanup is needed for FuzzedDataProvider or FuzzIOHandler itself,
// as they are managed by the fuzzer framework or stack.
static cmsBool CloseFn(cmsIOHANDLER* iohandler) {
    return TRUE;
}

// Custom deleter for cmsContext to ensure cmsDeleteContext is called.
// This is used with std::unique_ptr for automatic resource management.
struct ContextDeleter {
    void operator()(cmsContext ctx) const {
        if (ctx) {
            cmsDeleteContext(ctx);
        }
    }
};

// Custom deleter for cmsHPROFILE to ensure cmsCloseProfile is called.
struct ProfileDeleter {
    void operator()(cmsHPROFILE profile) const {
        if (profile) {
            cmsCloseProfile(profile);
        }
    }
};

// Custom deleter for cmsPipeline to ensure cmsPipelineFree is called.
struct PipelineDeleter {
    void operator()(cmsPipeline* pipeline) const {
        if (pipeline) {
            cmsPipelineFree(pipeline);
        }
    }
};

// Custom deleter for cmsToneCurve to ensure cmsFreeToneCurve is called.
struct ToneCurveDeleter {
    void operator()(cmsToneCurve* curve) const {
        if (curve) {
            cmsFreeToneCurve(curve);
        }
    }
};

// Custom deleter for cmsHTRANSFORM to ensure cmsDeleteTransform is called.
struct TransformDeleter {
    void operator()(cmsHTRANSFORM transform) const {
        if (transform) {
            cmsDeleteTransform(transform);
        }
    }
};

// Custom deleter for cmsStage to ensure cmsStageFree is called.
struct StageDeleter {
    void operator()(cmsStage* stage) const {
        if (stage) {
            cmsStageFree(stage);
        }
    }
    };

// Entry point for the fuzzer. LLVMFuzzerTestOneInput is called with each new fuzzer input.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // 1. Create a cmsContext: Essential for all lcms operations.
    // Using std::unique_ptr with ContextDeleter ensures it's always freed.
    std::unique_ptr<cmsContext_struct, ContextDeleter> ctx(cmsCreateContext(NULL, NULL));
    if (!ctx) {
        return 0; // If context creation fails, nothing can proceed.
    }

    // 2. Fuzz cmsOpenProfileFromIOhandler2THR:
    // This API is a primary entry point for parsing ICC profiles from an I/O stream.
    // We set up our custom FuzzIOHandler to feed data from FuzzedDataProvider.
    FuzzIOHandler fih;
    fih.iohandler.Read = ReadFn;
    fih.iohandler.Seek = SeekFn;
    fih.iohandler.Tell = TellFn;
    fih.iohandler.Close = CloseFn;
    fih.iohandler.ContextID = &fih; // Link the iohandler back to our FuzzIOHandler instance
    fih.fdp = &fdp;
    fih.current_pos = 0;
    // The entire remaining fuzzer input is treated as the profile data.
    fih.total_size = fdp.remaining_bytes();

    // Randomly determine if the profile should be opened in write mode (though typically it's read).
    cmsBool is_write_mode = fdp.ConsumeBool();

    // Attempt to open the profile. The returned cmsHPROFILE is managed by unique_ptr.
    std::unique_ptr<cmsHPROFILE_struct, ProfileDeleter> profile(
        cmsOpenProfileFromIOhandler2THR(ctx.get(), &fih.iohandler, is_write_mode)
    );

    // 3. Fuzz _cmsDefaultICCintents:
    // This function creates a color processing pipeline based on default ICC intents.
    // It's complex as it involves multiple profiles and various parameters.
    if (profile) { // Only proceed if a profile was successfully opened
        // Generate a random number of profiles to chain (0 to 3 for reasonable complexity).
        cmsUInt32Number num_profiles_for_intent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
        
        // Prepare vectors to hold parameters for the API call.
        std::vector<cmsHPROFILE> profiles_array(num_profiles_for_intent);
        std::vector<cmsUInt32Number> rendering_intents_array(num_profiles_for_intent);
        std::vector<cmsBool> bpc_array(num_profiles_for_intent);
        std::vector<cmsFloat64Number> adaption_states_array(num_profiles_for_intent);

        // Populate the parameter arrays with fuzzed data.
        for (cmsUInt32Number i = 0; i < num_profiles_for_intent; ++i) {
            // Use the already opened 'profile' for simplicity.
            // In a more advanced scenario, multiple profiles could be opened from fuzzed data.
            profiles_array[i] = profile.get();
            rendering_intents_array[i] = fdp.ConsumeIntegral<cmsUInt32Number>();
            bpc_array[i] = fdp.ConsumeBool();
            adaption_states_array[i] = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        }

        cmsUInt32Number flags_intent = fdp.ConsumeIntegral<cmsUInt32Number>();

        // Call _cmsDefaultICCintents and manage the returned cmsPipeline.
        std::unique_ptr<cmsPipeline, PipelineDeleter> pipeline(
            _cmsDefaultICCintents(ctx.get(), num_profiles_for_intent,
                                  rendering_intents_array.data(),
                                  profiles_array.data(),
                                  bpc_array.data(),
                                  adaption_states_array.data(),
                                  flags_intent)
        );
    }

    // 4. Fuzz _cmsBuildKToneCurve:
    // This function builds a tone curve, a fundamental component in color transformations.
    // Fuzzing it exercises the curve generation logic.
    cmsUInt32Number num_segments = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 10); // Random number of segments
    cmsUInt32Number num_channels = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 4); // Random number of channels

    // Prepare parameter vectors.
    std::vector<cmsUInt32Number> curve_rendering_intents(num_segments);
    std::vector<cmsHPROFILE> curve_profiles(num_segments);
    std::vector<cmsBool> curve_bpc(num_segments);
    std::vector<cmsFloat64Number> curve_adaption_states(num_segments);

    // Populate parameter vectors with fuzzed data.
    for (cmsUInt32Number i = 0; i < num_segments; ++i) {
        curve_rendering_intents[i] = fdp.ConsumeIntegral<cmsUInt32Number>();
        // Use the opened profile if available, otherwise nullptr.
        curve_profiles[i] = profile ? profile.get() : nullptr; 
        curve_bpc[i] = fdp.ConsumeBool();
        curve_adaption_states[i] = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
    }

    cmsUInt32Number curve_flags = fdp.ConsumeIntegral<cmsUInt32Number>();

    // Call _cmsBuildKToneCurve and manage the returned cmsToneCurve.
    std::unique_ptr<cmsToneCurve, ToneCurveDeleter> tone_curve(
        _cmsBuildKToneCurve(ctx.get(), num_segments, num_channels,
                            curve_rendering_intents.data(),
                            curve_profiles.data(),
                            curve_bpc.data(),
                            curve_adaption_states.data(),
                            curve_flags)
    );

    // 5. Fuzz _cmsChain2Lab:
    // This function chains profiles to the Lab color space, involving complex transformations.
    cmsUInt32Number num_profiles_chain = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
    cmsUInt32Number input_format = fdp.ConsumeIntegral<cmsUInt32Number>();
    cmsUInt32Number output_format = fdp.ConsumeIntegral<cmsUInt32Number>();

    // Prepare parameter vectors.
    std::vector<cmsUInt32Number> chain_rendering_intents(num_profiles_chain);
    std::vector<cmsHPROFILE> chain_profiles(num_profiles_chain);
    std::vector<cmsBool> chain_bpc(num_profiles_chain);
    std::vector<cmsFloat64Number> chain_adaption_states(num_profiles_chain);

    // Populate parameter vectors with fuzzed data.
    for (cmsUInt32Number i = 0; i < num_profiles_chain; ++i) {
        chain_rendering_intents[i] = fdp.ConsumeIntegral<cmsUInt32Number>();
        chain_profiles[i] = profile ? profile.get() : nullptr;
        chain_bpc[i] = fdp.ConsumeBool();
        chain_adaption_states[i] = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
    }

    cmsUInt32Number chain_flags = fdp.ConsumeIntegral<cmsUInt32Number>();

    // Call _cmsChain2Lab and manage the returned cmsHTRANSFORM.
    std::unique_ptr<cmsHTRANSFORM_struct, TransformDeleter> transform(
        _cmsChain2Lab(ctx.get(), num_profiles_chain, input_format, output_format,
                      chain_rendering_intents.data(),
                      chain_profiles.data(),
                      chain_bpc.data(),
                      chain_adaption_states.data(),
                      chain_flags)
    );

    // 6. Fuzz _cmsStageAllocLabPrelin:
    // This is a simpler allocation function, included to exercise the creation
    // and destruction of a specific internal lcms structure (Lab pre-linearization stage).
    std::unique_ptr<cmsStage, StageDeleter> lab_prelin_stage(
        _cmsStageAllocLabPrelin(ctx.get())
    );

    // All allocated resources (context, profiles, pipelines, tone curves, transforms, stages)
    // are automatically deallocated when their respective unique_ptr objects go out of scope,
    // ensuring memory safety and preventing leaks.
    return 0;
}[0m
