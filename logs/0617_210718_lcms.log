        cmsUInt32Number result = cmsGetProfileInfo(hProfile, infoType, locale.c_str(), country.c_str(), buffer.data(), static_cast<cmsUInt32Number>(buffer.size()));
        (void)result; // Suppress unused variable warning.
    }

    // All std::unique_ptr objects will automatically deallocate resources when they go out of scope,
    // ensuring comprehensive memory safety.
    return 0;
