#include "/src/libtiff/libtiff/tiffiop.h" // For internal structures like TIFF

// Custom I/O context for in-memory TIFF operations
struct FuzzIOContext {
    std::vector<uint8_t> data;
    toff_t current_offset; // To track the current position for read/write/seek
};

// Custom I/O functions for in-memory TIFF operations
// These functions simulate file operations on a std::vector<uint8_t>
static tmsize_t
_fuzz_read_proc(thandle_t fd, void *buf, tmsize_t size)
{
    FuzzIOContext* ctx = static_cast<FuzzIOContext*>(fd);
    toff_t bytes_to_read = size;

    if (ctx->current_offset >= ctx->data.size()) {
        return 0; // End of data
    }

    if (ctx->current_offset + bytes_to_read > ctx->data.size()) {
