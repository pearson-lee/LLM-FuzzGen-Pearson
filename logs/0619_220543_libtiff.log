// Custom I/O functions for in-memory TIFF operations
// These functions simulate file operations on a std::vector<uint8_t>
static tmsize_t
_fuzz_read_proc(thandle_t fd, void *buf, tmsize_t size)
{
    // Cast thandle_t back to our vector pointer
    std::vector<uint8_t>* data_vec = static_cast<std::vector<uint8_t>*>(fd);
    TIFF* tif = static_cast<TIFF*>(data_vec->at(0)); // Assuming TIFF* is stored at index 0 for context
    tmsize_t current_offset = tif->tif_offset; // Use tif_offset for current position

    if (current_offset >= data_vec->size()) {
        return 0; // End of data
    }

    tmsize_t bytes_to_read = size;
    if (current_offset + bytes_to_read > data_vec->size()) {
        bytes_to_read = data_vec->size() - current_offset;
    }

    std::memcpy(buf, data_vec->data() + current_offset, bytes_to_read);
    tif->tif_offset += bytes_to_read; // Update current offset
    return bytes_to_read;
}

static tmsize_t
_fuzz_write_proc(thandle_t fd, void *buf, tmsize_t size)
{
    std::vector<uint8_t>* data_vec = static_cast<std::vector<uint8_t>*>(fd);
    TIFF* tif = static_cast<TIFF*>(data_vec->at(0)); // Assuming TIFF* is stored at index 0 for context
    tmsize_t current_offset = tif->tif_offset; // Use tif_offset for current position

    // Resize vector if necessary to accommodate new data
    if (current_offset + size > data_vec->size()) {
        data_vec->resize(current_offset + size);
    }

    std::memcpy(data_vec->data() + current_offset, buf, size);
    tif->tif_offset += size; // Update current offset
    return size;
}

static toff_t
_fuzz_seek_proc(thandle_t fd, toff_t off, int whence)
{
    std::vector<uint8_t>* data_vec = static_cast<std::vector<uint8_t>*>(fd);
    TIFF* tif = static_cast<TIFF*>(data_vec->at(0)); // Assuming TIFF* is stored at index 0 for context
    toff_t current_offset = tif->tif_offset; // Use tif_offset for current position

    switch (whence) {
        case SEEK_SET:
            current_offset = off;
            break;
        case SEEK_CUR:
            current_offset += off;
            break;
        case SEEK_END:
            current_offset = data_vec->size() + off;
            break;
        default:
            return (toff_t)-1; // Invalid whence
    }

    if (current_offset < 0) {
        current_offset = 0;
    } else if (current_offset > data_vec->size()) {
        // Allow seeking past end for writing, but don't resize yet
        // The actual resize happens in write_proc
    }

    tif->tif_offset = current_offset; // Update current offset
    return current_offset;
}

static int
_fuzz_close_proc(thandle_t fd)
{
    // No explicit memory deallocation needed here, as the vector is managed by unique_ptr in LLVMFuzzerTestOneInput
    (void)fd; // Unused parameter
    return 0;
}

static toff_t
_fuzz_size_proc(thandle_t fd)
{
    std::vector<uint8_t>* data_vec = static_cast<std::vector<uint8_t>*>(fd);
    return data_vec->size();
}

static int
_fuzz_map_proc(thandle_t fd, void **pbase, toff_t *psize)
{
    std::vector<uint8_t>* data_vec = static_cast<std::vector<uint8_t>*>(fd);
    *pbase = data_vec->data();
    *psize = data_vec->size();
    return 0;
}

static void
_fuzz_unmap_proc(thandle_t fd, void *base, toff_t size)
{
    (void)fd; // Unused parameter
    (void)base; // Unused parameter
    (void)size; // Unused parameter
    // No explicit memory deallocation needed here
}

// Custom error handler to suppress stderr output from libtiff
static void
_fuzz_error_handler(const char* module, const char* fmt, va_list ap) {
    // Do nothing to suppress errors
    (void)module;
    (void)fmt;
    (void)ap;
}

// Custom warning handler to suppress stderr output from libtiff
static void
_fuzz_warning_handler(const char* module, const char* fmt, va_list ap) {
    // Do nothing to suppress warnings
    (void)module;
    (void)fmt;
    (void)ap;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Set custom error and warning handlers to suppress output
    TIFFSetErrorHandler(_fuzz_error_handler);
    TIFFSetWarningHandler(_fuzz_warning_handler);

    // Use a unique_ptr to manage the lifetime of the in-memory TIFF data
    // The first element of the vector will temporarily store the TIFF* pointer
    // to allow custom I/O functions to access the TIFF object's internal state (tif_offset).
    // This is a workaround as thandle_t is opaque and doesn't directly provide TIFF*
    auto in_memory_tiff_data = std::make_unique<std::vector<uint8_t>>();
    in_memory_tiff_data->push_back(0); // Placeholder for TIFF*

    // Fuzzing TIFFOpenExt
    std::string filename = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange(0, 256));
    std::string open_mode = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange(1, 10));

    // Fuzz TIFFOpenOptions
    std::unique_ptr<TIFFOpenOptions, decltype(&TIFFOpenOptionsFree)> open_options(
        TIFFOpenOptionsAlloc(), &TIFFOpenOptionsFree);

    if (open_options) {
        // Fuzz various options within TIFFOpenOptions
        if (fdp.ConsumeBool()) {
            TIFFOpenOptionsSetMaxSingleMemAlloc(open_options.get(), fdp.ConsumeIntegral<uint64_t>());
        }
        if (fdp.ConsumeBool()) {
            TIFFOpenOptionsSetMaxCumulatedMemAlloc(open_options.get(), fdp.ConsumeIntegral<uint64_t>());
        }
        if (fdp.ConsumeBool()) {
            TIFFOpenOptionsSetWarnAboutUnknownTags(open_options.get(), fdp.ConsumeBool());
        }
    }

    // Attempt to open the TIFF file in memory
    // We use TIFFClientOpen to provide our custom I/O functions
    TIFF* tif = TIFFClientOpen(filename.c_str(), open_mode.c_str(),
                               static_cast<thandle_t>(in_memory_tiff_data.get()),
                               _fuzz_read_proc, _fuzz_write_proc, _fuzz_seek_proc,
                               _fuzz_close_proc, _fuzz_size_proc, _fuzz_map_proc,
                               _fuzz_unmap_proc);

    // Store the TIFF* pointer in the first element of the vector for custom I/O functions
    if (tif) {
        (*in_memory_tiff_data)[0] = reinterpret_cast<uint8_t>(tif);
    }

    if (tif) {
        // Fuzzing TIFFWriteRawStrip and ZIPEncode
        if (open_mode.find('w') != std::string::npos || open_mode.find('a') != std::string::npos) {
            // Set up compression to ZIP
            TIFFSetField(tif, TIFFTAG_COMPRESSION, COMPRESSION_DEFLATE);
            TIFFSetField(tif, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
            TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, fdp.ConsumeIntegralInRange<uint32_t>(1, 1024));
            TIFFSetField(tif, TIFFTAG_IMAGELENGTH, fdp.ConsumeIntegralInRange<uint32_t>(1, 1024));
            TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, 8);
            TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, 3);
            TIFFSetField(tif, TIFFTAG_ROWSPERSTRIP, fdp.ConsumeIntegralInRange<uint32_t>(1, 100));

            uint32_t strip = fdp.ConsumeIntegral<uint32_t>();
            tmsize_t data_size = fdp.ConsumeIntegralInRange<tmsize_t>(0, 1024 * 10); // Fuzz data size
            std::vector<uint8_t> write_data = fdp.ConsumeBytes<uint8_t>(data_size);

            // Call TIFFWriteRawStrip
            TIFFWriteRawStrip(tif, strip, write_data.data(), write_data.size());

            // Call ZIPEncode (implicitly called by TIFFWriteRawStrip if compression is set)
            // To explicitly call ZIPEncode, we would need to bypass TIFFWriteRawStrip's internal logic
            // and manage the compression stream directly, which is more complex and less representative
            // of typical libtiff usage. The current approach ensures ZIPEncode is exercised when writing
            // compressed data.
        }

        // Fuzzing TIFFReadRawStrip and ZIPDecode
        if (open_mode.find('r') != std::string::npos) {
            uint32_t strip = fdp.ConsumeIntegral<uint32_t>();
            tmsize_t read_size = fdp.ConsumeIntegralInRange<tmsize_t>(0, 1024 * 10); // Fuzz read size
            std::vector<uint8_t> read_buffer(read_size);

            // Call TIFFReadRawStrip
            TIFFReadRawStrip(tif, strip, read_buffer.data(), read_buffer.size());

            // Call ZIPDecode (implicitly called by TIFFReadRawStrip if compression is set)
            // Similar to ZIPEncode, ZIPDecode is exercised when reading compressed data.
        }

        // Clean up TIFF object
        TIFFClose(tif);
    }

    // The unique_ptr for in_memory_tiff_data and open_options will handle deallocation automatically.
    return 0;
}[0m
