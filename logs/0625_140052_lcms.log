// Helper function to safely consume a specified number of bytes from the fuzzer input.
// This prevents out-of-bounds reads and updates the Data pointer and Size accordingly.
static size_t FuzzConsumeBytes(const uint8_t **Data, size_t *Size, size_t NumBytes) {
    if (*Size < NumBytes) {
        NumBytes = *Size; // Adjust NumBytes if less data is available
    }
    size_t consumed = NumBytes;
    *Data += consumed;
    *Size -= consumed;
    return consumed;
}

// Helper function to consume a cmsUInt32Number (unsigned 32-bit integer) from the fuzzer input.
// It reads 4 bytes and copies them into a cmsUInt32Number.
static cmsUInt32Number FuzzConsumeUInt32(const uint8_t **Data, size_t *Size) {
    cmsUInt32Number val = 0;
    if (FuzzConsumeBytes(Data, Size, sizeof(cmsUInt32Number)) == sizeof(cmsUInt32Number)) {
        // Copy the bytes into the value. The Data pointer has already been advanced.
        memcpy(&val, *Data - sizeof(cmsUInt32Number), sizeof(cmsUInt32Number));
    }
    return val;
}

// Helper function to consume a string from the fuzzer input.
// It first consumes one byte to determine the string length (up to MaxLen),
// then reads that many bytes for the string content, and null-terminates it.
// Memory allocated for the string must be freed by the caller.
static char* FuzzConsumeString(const uint8_t **Data, size_t *Size, size_t MaxLen) {
    if (*Size == 0) return NULL;

    // Use a single byte from the fuzzer data to determine the string length.
    // This keeps string lengths manageable and avoids consuming too much data for one string.
    size_t len_indicator_size = sizeof(uint8_t);
    if (*Size < len_indicator_size) {
        return NULL; // Not enough data for the length indicator
    }
    uint8_t len_byte = (*Data)[0];
    FuzzConsumeBytes(Data, Size, len_indicator_size); // Consume the length indicator byte

    // Calculate the actual string length, ensuring it doesn't exceed MaxLen or remaining fuzzer data.
    size_t len = len_byte % (MaxLen + 1);
    if (len > *Size) {
        len = *Size; // Ensure we don't read beyond available fuzzer data
    }

    // Allocate memory for the string plus a null terminator.
    char* str = (char*)malloc(len + 1);
    if (!str) return NULL; // Handle allocation failure

    // Copy the string data and add the null terminator.
    memcpy(str, *Data, len);
    str[len] = '\0';
    FuzzConsumeBytes(Data, Size, len); // Consume the string bytes
    return str;
}


