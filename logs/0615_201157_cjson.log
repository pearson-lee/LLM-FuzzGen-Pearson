fuzz target: 
#include <cstddef>
#include <cstdint>
#include <string>
#include <memory> // For std::unique_ptr
#include <fuzzer/FuzzedDataProvider.h>

// Include the main cJSON header using the project-relative path
#include "/src/cjson/cJSON.h"

// Custom deleter for cJSON objects, to be used with std::unique_ptr
// This ensures that cJSON_Delete is called for cleanup.
struct CJSONDeleter {
    void operator()(cJSON* ptr) const {
        if (ptr) {
            cJSON_Delete(ptr); // API: cJSON_Delete (Resource Management)
        }
    }
};

// Alias for std::unique_ptr with the custom CJSONDeleter.
// This provides RAII (Resource Acquisition Is Initialization) for cJSON objects,
// automatically managing their memory.
using unique_cJSON_ptr = std::unique_ptr<cJSON, CJSONDeleter>;

// Helper function to create various types of cJSON items based on fuzzer input.
// This function helps exercise different cJSON_Create* API functions.
// Inspired by 'CreateFuzzedCjsonItem' from the provided API information.
unique_cJSON_ptr CreateRandomCjsonItem(FuzzedDataProvider& fdp) {
    if (fdp.remaining_bytes() < 1) { // Need at least 1 byte for type selection
        return nullptr;
    }
    // Consume a byte to determine the type of cJSON item to create
    // API: cJSON_CreateNull, cJSON_CreateTrue, cJSON_CreateFalse, cJSON_CreateNumber,
    //      cJSON_CreateString, cJSON_CreateArray, cJSON_CreateObject (Creation APIs)
    uint8_t type = fdp.ConsumeIntegralInRange<uint8_t>(0, 6);
    cJSON* item = nullptr;
    std::string temp_str; // Temporary storage for strings from FuzzedDataProvider

    switch (type) {
        case 0: // Null
            item = cJSON_CreateNull();
            break;
        case 1: // Bool (True)
            item = cJSON_CreateTrue();
            break;
        case 2: // Bool (False)
            item = cJSON_CreateFalse();
            break;
        case 3: // Number
            item = cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>());
            break;
        case 4: // String
            // Consume a string of limited length to avoid excessive memory use
            temp_str = fdp.ConsumeRandomLengthString(128);
            item = cJSON_CreateString(temp_str.c_str());
            break;
        case 5: // Array
            item = cJSON_CreateArray();
            break;
        case 6: // Object
            item = cJSON_CreateObject();
            break;
        default:
            // This case should ideally not be reached with ConsumeIntegralInRange
            item = cJSON_CreateNull(); // Fallback to a safe default
            break;
    }
    return unique_cJSON_ptr(item); // Wrap the raw pointer in a unique_ptr for safety
}

// Main fuzzing entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // 1. Target API: cJSON_Parse (Input Processing)
    // Attempt to parse a JSON string generated from fuzzer data.
    // This tests the robustness of the parser against various inputs.
    std::string json_to_parse = fdp.ConsumeRandomLengthString(1024); // Limit input string size
    unique_cJSON_ptr root_json(cJSON_Parse(json_to_parse.c_str()));
    // root_json will be nullptr if parsing fails, which is a valid scenario to test.

    // 2. Target APIs: cJSON_Create* (via CreateRandomCjsonItem helper)
    // Create a new, random cJSON item.
    unique_cJSON_ptr new_item = CreateRandomCjsonItem(fdp);

    // 3. Target APIs: cJSON_AddItemToObject and cJSON_AddItemToArray (Manipulation APIs)
    // If a new item was successfully created, attempt to add it to either the parsed
    // JSON (if it's an object or array) or to a newly created temporary container.
    // This ensures that item addition logic is exercised.
    if (new_item) { // Proceed only if new_item was successfully created
        bool item_added_somewhere = false;

        // Attempt to add to the parsed root_json if it's a suitable container (object or array)
        // and the fuzzer chooses to do so.
        if (root_json && (cJSON_IsObject(root_json.get()) || cJSON_IsArray(root_json.get())) && fdp.ConsumeBool()) {
            if (cJSON_IsObject(root_json.get())) {
                std::string key = fdp.ConsumeRandomLengthString(32); // Generate a random key
                // cJSON_AddItemToObject takes ownership of the item, so release it from unique_ptr.
                cJSON_AddItemToObject(root_json.get(), key.c_str(), new_item.release());
                item_added_somewhere = true;
            } else if (cJSON_IsArray(root_json.get())) {
                // cJSON_AddItemToArray takes ownership of the item, so release it from unique_ptr.
                cJSON_AddItemToArray(root_json.get(), new_item.release());
                item_added_somewhere = true;
            }
        }

        // If the item wasn't added to root_json (either because root_json was unsuitable,
        // fuzzer chose not to, or new_item is still available), create a new temporary container
        // and add the item there. This ensures AddItemToObject/Array are tested.
        if (!item_added_somewhere && new_item) { // Check new_item again as it might have been released
            unique_cJSON_ptr temp_container;
            if (fdp.ConsumeBool()) { // 50% chance to create an object container
                temp_container.reset(cJSON_CreateObject());
                if (temp_container) {
                    std::string key = fdp.ConsumeRandomLengthString(32);
                    cJSON_AddItemToObject(temp_container.get(), key.c_str(), new_item.release());
                    // temp_container now owns new_item. Its unique_ptr will manage cleanup.
                }
            } else { // 50% chance to create an array container
                temp_container.reset(cJSON_CreateArray());
                if (temp_container) {
                    cJSON_AddItemToArray(temp_container.get(), new_item.release());
                    // temp_container now owns new_item. Its unique_ptr will manage cleanup.
                }
            }
            // If new_item was not added (e.g., temp_container creation failed),
            // its own unique_ptr (if it still holds the pointer) will manage its deletion.
        }
    }
    // If new_item was created but not added to any other cJSON object (i.e., not released),
    // its unique_cJSON_ptr will automatically call cJSON_Delete on it when it goes out of scope.

    // 4. Target API: cJSON_PrintUnformatted (Output Generation)
    // This also indirectly tests internal functions like 'ensure' mentioned in API info.
    // Print the main cJSON structure (parsed and potentially modified).
    if (root_json) {
        // cJSON_PrintUnformatted allocates a string that must be freed using cJSON_free.
        char* printed_json_str = cJSON_PrintUnformatted(root_json.get());
        if (printed_json_str) {
            // The printed string could be used for further checks (e.g., re-parsing, validation)
            // but for this fuzzer, we primarily ensure it's correctly freed to prevent leaks.
            cJSON_free(printed_json_str); // IMPORTANT: Use cJSON_free for memory from cJSON_Print*
        }
    }

    // 5. Target API: cJSON_Delete (Resource Management)
    // Deletion of all cJSON objects (root_json, new_item if not transferred, temp_container)
    // is handled automatically by their respective unique_cJSON_ptr instances
    // when they go out of scope. The CJSONDeleter calls cJSON_Delete.
    // This ensures no memory leaks from cJSON objects created by the fuzzer.

    return 0; // Indicates successful execution of the fuzzer test case
}[0m
