#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <memory> // For std::unique_ptr
#include <fuzzer/FuzzedDataProvider.h>
#include "/src/cjson/cJSON.h" // Main cJSON header
#include <cmath> // For isnan, isinf
#include <climits> // For INT_MAX, INT_MIN


// Custom deleter for cJSON objects to ensure cJSON_Delete is called.
// This is crucial for memory safety and preventing leaks.
struct CJSONDeleter {
    void operator()(cJSON* json) const {
        if (json) {
            cJSON_Delete(json);
        }
    }
};
// Define a unique_ptr type for cJSON objects with the custom deleter.
using unique_cJSON_ptr = std::unique_ptr<cJSON, CJSONDeleter>;

// Helper function to create a fuzzed cJSON item.
// Modified to improve coverage for cJSON_SetNumberHelper's edge cases.
cJSON *CreateFuzzedCjsonItem(FuzzedDataProvider &fdp) {
    // Consume an integral to determine the type of cJSON item to create.
    // The range covers Object, Array, String, Number, Bool, Null, Raw.
    int type_choice = fdp.ConsumeIntegralInRange<int>(0, 6);
    switch (type_choice) {
        case 0: return cJSON_CreateObject();
        case 1: return cJSON_CreateArray();
        // Consume a random length string for string and raw types.
        case 2: return cJSON_CreateString(fdp.ConsumeRandomLengthString(32).c_str());
        case 3: { // Modified to hit cJSON_SetNumberHelper edge cases
            double num_val;
            int choice = fdp.ConsumeIntegralInRange<int>(0, 4);
            if (choice == 0) num_val = static_cast<double>(INT_MAX) + 1.0; // Covers number >= INT_MAX
            else if (choice == 1) num_val = static_cast<double>(INT_MIN) - 1.0; // Covers number <= INT_MIN
            else if (choice == 2) num_val = static_cast<double>(INT_MAX); // Covers exact INT_MAX
            else if (choice == 3) num_val = static_cast<double>(INT_MIN); // Covers exact INT_MIN
            else num_val = fdp.ConsumeFloatingPoint<double>(); // General case
            return cJSON_CreateNumber(num_val);
        }
        // Consume a boolean for bool type.
        case 4: return cJSON_CreateBool(fdp.ConsumeBool());
        case 5: return cJSON_CreateNull();
        case 6: return cJSON_CreateRaw(fdp.ConsumeRandomLengthString(32).c_str());
        default: return nullptr; // Should not happen with the given range.
    }
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a root cJSON object to perform operations on.
    // Using unique_cJSON_ptr ensures automatic deletion and memory safety.
    unique_cJSON_ptr root_item(CreateFuzzedCjsonItem(fdp));
    if (!root_item) {
        // If root_item creation fails, there's nothing to fuzz.
        // This branch (lines 52-53) was previously uncovered.
    }

    // Fuzzing loop: continue as long as there's enough fuzzed data remaining.
    // This allows for multiple operations on the same cJSON structure,
    // increasing the chances of finding state-related bugs.
    while (fdp.remaining_bytes() > 10) { // Ensure enough bytes for at least one action
        // Select one of the target APIs to call.
        // Increased range to include new actions for parsing, printing, getters, etc.
        int action = fdp.ConsumeIntegralInRange<int>(0, 12); // Original: 0-7, New: 0-12

        switch (action) {
            case 0: { // Target API: cJSON_ReplaceItemInObject
                if (root_item && root_item->type == cJSON_Object) {
                    std::string key = fdp.ConsumeRandomLengthString(16);
                    unique_cJSON_ptr new_item(CreateFuzzedCjsonItem(fdp));
                    if (new_item) {
                        if (!cJSON_ReplaceItemInObject(root_item.get(), key.c_str(), new_item.get())) {
                            // Replacement failed, unique_ptr handles deletion.
                        } else {
                            new_item.release(); // Ownership transferred.
                        }
                    }
                }
                break;
            }
            case 1: { // Target API: cJSON_AddItemReferenceToArray
                if (root_item && root_item->type == cJSON_Array) {
                    unique_cJSON_ptr item_to_add(CreateFuzzedCjsonItem(fdp));
                    if (item_to_add) {
                        cJSON_AddItemReferenceToArray(root_item.get(), item_to_add.get());
                    }
                }
                else if (fdp.ConsumeBool()) { // Added call with NULL array
                    unique_cJSON_ptr item_to_add(CreateFuzzedCjsonItem(fdp));
                    if (item_to_add) {
                        cJSON_AddItemReferenceToArray(nullptr, item_to_add.get());
                    }
                }
                break;
            }
            case 2: { // Target API: cJSON_ReplaceItemInArray
                if (root_item && root_item->type == cJSON_Array && cJSON_GetArraySize(root_item.get()) > 0) {
                    int index = fdp.ConsumeIntegralInRange<int>(0, cJSON_GetArraySize(root_item.get()) - 1);
                    unique_cJSON_ptr new_item(CreateFuzzedCjsonItem(fdp));
                    if (new_item) {
                        if (!cJSON_ReplaceItemInArray(root_item.get(), index, new_item.get())) {
                            // Replacement failed.
                        } else {
                            new_item.release(); // Ownership transferred.
                        }
                    }
                }
                break;
            }
            case 3: { // Target API: cJSON_DetachItemFromArray
                if (root_item && root_item->type == cJSON_Array && cJSON_GetArraySize(root_item.get()) > 0) {
                    int index = fdp.ConsumeIntegralInRange<int>(0, cJSON_GetArraySize(root_item.get()) - 1);
                    unique_cJSON_ptr detached_item(cJSON_DetachItemFromArray(root_item.get(), index));
                }
                else if (fdp.ConsumeBool()) { // Added call with negative index
                    unique_cJSON_ptr detached_item(cJSON_DetachItemFromArray(root_item.get(), fdp.ConsumeIntegralInRange<int>(-10, -1)));
                }
                else if (fdp.ConsumeBool()) { // Added call with NULL array
                    unique_cJSON_ptr detached_item(cJSON_DetachItemFromArray(nullptr, 0));
                }
                break;
            }
            case 4: { // Target API: CreateFuzzedCjsonItem
                unique_cJSON_ptr temp_item(CreateFuzzedCjsonItem(fdp));
                break;
            }
            case 5: { // Target API: cJSON_AddStringToObject
                if (root_item && root_item->type == cJSON_Object) {
                    std::string key = fdp.ConsumeRandomLengthString(16);
                    std::string value = fdp.ConsumeRandomLengthString(32);
                    cJSON_AddStringToObject(root_item.get(), key.c_str(), value.c_str());
                }
                else if (fdp.ConsumeBool()) { // Added call with NULL string
                    std::string key = fdp.ConsumeRandomLengthString(16);
                    unique_cJSON_ptr temp_item(cJSON_CreateString(nullptr));
                }
                break;
            }
            case 6: { // Target API: cJSON_GetArraySize
                if (fdp.ConsumeBool()) {
                    cJSON_GetArraySize(nullptr); // Cover NULL input branch
                } else if (root_item && root_item->type == cJSON_Array) {
                    cJSON_GetArraySize(root_item.get());
                } else if (root_item) { // Cover non-array item
                     cJSON_GetArraySize(root_item.get());
                }
                break;
            }
            case 7: { // Target API: cJSON_DetachItemViaPointer
                if (root_item && root_item->type == cJSON_Array && cJSON_GetArraySize(root_item.get()) > 0) {
                    int array_size = cJSON_GetArraySize(root_item.get());
                    if (fdp.ConsumeBool() && array_size > 0) {
                        unique_cJSON_ptr detached_item(cJSON_DetachItemViaPointer(root_item.get(), root_item->child));
                    }
                    else if (fdp.ConsumeBool() && array_size > 1) {
                        unique_cJSON_ptr detached_item(cJSON_DetachItemViaPointer(root_item.get(), root_item->child->next));
                    }
                    else if (fdp.ConsumeBool() && array_size > 0) {
                        cJSON* last_item = root_item->child;
                        while (last_item && last_item->next) { last_item = last_item->next; }
                        if (last_item && last_item != root_item->child) {
                            unique_cJSON_ptr detached_item(cJSON_DetachItemViaPointer(root_item.get(), last_item));
                        }
                    }
                }
                else if (fdp.ConsumeBool()) {
                    unique_cJSON_ptr temp_item(CreateFuzzedCjsonItem(fdp));
                    unique_cJSON_ptr detached_item(cJSON_DetachItemViaPointer(nullptr, temp_item.get()));
                }
                else if (fdp.ConsumeBool()) {
                    unique_cJSON_ptr detached_item(cJSON_DetachItemViaPointer(root_item.get(), nullptr));
                }
                break;
            }
            case 8: { // New Target: Parsing functions (cJSON_Parse, cJSON_GetErrorPtr)
                std::string json_to_parse = fdp.ConsumeRandomLengthString(256);
                // cJSON_Parse returns a new cJSON object that must be deleted.
                unique_cJSON_ptr parsed_item(cJSON_Parse(json_to_parse.c_str()));
                cJSON_GetErrorPtr(); // Call to cover this function, useful after parse attempts.
                // parsed_item is managed by unique_ptr and will be deleted.
                break;
            }
            case 9: { // New Target: Printing functions
                if (root_item) { // Only print if root_item was successfully created
                    int print_choice = fdp.ConsumeIntegralInRange<int>(0, 2);
                    if (print_choice == 0) {
                        // Target cJSON_PrintUnformatted. Returned string must be freed.
                        char *printed_str = cJSON_PrintUnformatted(root_item.get());
                        if (printed_str) {
                            cJSON_free(printed_str); // Memory safety: free string from cJSON.
                        }
                    } else if (print_choice == 1) {
                        // Target cJSON_PrintBuffered. Returned string must be freed.
                        int prebuffer_size = fdp.ConsumeIntegralInRange<int>(-5, 512); // Test negative prebuffer for error paths.
                        bool format = fdp.ConsumeBool();
                        char *buffered_str = cJSON_PrintBuffered(root_item.get(), prebuffer_size, format);
                        if (buffered_str) {
                            cJSON_free(buffered_str); // Memory safety: free string from cJSON.
                        }
                    } else { // print_choice == 2
                        // Target cJSON_PrintPreallocated. Writes to user buffer.
                        size_t buf_size = fdp.ConsumeIntegralInRange<size_t>(1, 512);
                        std::vector<char> prealloc_buf_vec(buf_size); // RAII for buffer.
                        char* prealloc_buf_ptr = prealloc_buf_vec.data();
                        bool format = fdp.ConsumeBool();

                        if (fdp.ConsumeBool()) { // Test error conditions for PrintPreallocated
                            int err_choice = fdp.ConsumeIntegralInRange<int>(0,1);
                            if (err_choice == 0) cJSON_PrintPreallocated(root_item.get(), prealloc_buf_ptr, -1, format); // Negative length.
                            else cJSON_PrintPreallocated(root_item.get(), nullptr, buf_size, format); // Null buffer with positive length.
                        } else {
                            cJSON_PrintPreallocated(root_item.get(), prealloc_buf_ptr, buf_size, format); // Valid call.
                        }
                    }
                }
                // Test printing a NULL item to cover branches in print_value.
                if (fdp.ConsumeBool()) {
                    char *printed_null = cJSON_PrintUnformatted(nullptr);
                    if(printed_null) cJSON_free(printed_null); // Memory safety.
                }
                break;
            }
            case 10: { // New Target: cJSON_Version, Is<Type>, Get<Value>, Get<Item> functions
                cJSON_Version(); // Call to cover cJSON_Version.

                cJSON* items_to_test[] = {root_item.get(), nullptr};
                for (cJSON* current_test_item : items_to_test) { // Test Is<Type> with valid and NULL item.
                    cJSON_IsInvalid(current_test_item); cJSON_IsFalse(current_test_item);
                    cJSON_IsTrue(current_test_item); cJSON_IsBool(current_test_item);
                    cJSON_IsNull(current_test_item); cJSON_IsNumber(current_test_item);
                    cJSON_IsString(current_test_item); cJSON_IsArray(current_test_item);
                    cJSON_IsObject(current_test_item); cJSON_IsRaw(current_test_item);
                }

                if (root_item) { // Test Get<Value> with valid root_item.
                    if (cJSON_IsString(root_item.get())) cJSON_GetStringValue(root_item.get());
                    if (cJSON_IsNumber(root_item.get())) cJSON_GetNumberValue(root_item.get());
                }
                cJSON_GetStringValue(nullptr); // Test Get<Value> with NULL item.
                cJSON_GetNumberValue(nullptr);

                // Test Get<Item> functions
                if (root_item && root_item->type == cJSON_Array) {
                    if (cJSON_GetArraySize(root_item.get()) > 0) {
                        int index = fdp.ConsumeIntegralInRange<int>(0, cJSON_GetArraySize(root_item.get()) - 1);
                        cJSON_GetArrayItem(root_item.get(), index);
                    }
                    cJSON_GetArrayItem(root_item.get(), -1); // Test negative index for cJSON_GetArrayItem.
                } else { // Test with non-array or NULL root_item.
                     cJSON_GetArrayItem(root_item.get(), 0);
                     cJSON_GetArrayItem(nullptr, 0);
                }

                if (root_item && root_item->type == cJSON_Object) {
                    std::string key = fdp.ConsumeRandomLengthString(16);
                    cJSON_GetObjectItem(root_item.get(), key.c_str());
                    cJSON_GetObjectItemCaseSensitive(root_item.get(), key.c_str());
                    cJSON_HasObjectItem(root_item.get(), key.c_str());
                    cJSON_GetObjectItem(root_item.get(), nullptr); // Test with NULL key.
                } else { // Test with non-object or NULL root_item.
                    std::string key = fdp.ConsumeRandomLengthString(16);
                    cJSON_GetObjectItem(root_item.get(), key.c_str());
                    cJSON_GetObjectItem(nullptr, key.c_str());
                }
                break;
            }
            case 11: { // New Target: cJSON_Add<Type>ToObject and similar functions
                if (root_item && root_item->type == cJSON_Object) {
