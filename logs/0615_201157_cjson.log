#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <memory> // For std::unique_ptr
#include <fuzzer/FuzzedDataProvider.h>
#include "/src/cjson/cJSON.h" // Main cJSON header
#include <cmath> // For isnan, isinf
#include <climits> // For INT_MAX, INT_MIN


// Custom deleter for cJSON objects to ensure cJSON_Delete is called.
// This is crucial for memory safety and preventing leaks.
struct CJSONDeleter {
    void operator()(cJSON* json) const {
        if (json) {
            cJSON_Delete(json);
        }
    }
};
// Define a unique_ptr type for cJSON objects with the custom deleter.
using unique_cJSON_ptr = std::unique_ptr<cJSON, CJSONDeleter>;

// Helper function to create a fuzzed cJSON item.
// Modified to improve coverage for cJSON_SetNumberHelper's edge cases.
cJSON *CreateFuzzedCjsonItem(FuzzedDataProvider &fdp) {
    // Consume an integral to determine the type of cJSON item to create.
    // The range covers Object, Array, String, Number, Bool, Null, Raw.
    int type_choice = fdp.ConsumeIntegralInRange<int>(0, 6);
    switch (type_choice) {
        case 0: return cJSON_CreateObject();
        case 1: return cJSON_CreateArray();
        // Consume a random length string for string and raw types.
        case 2: return cJSON_CreateString(fdp.ConsumeRandomLengthString(32).c_str());
        case 3: { // Modified to hit cJSON_SetNumberHelper edge cases
            double num_val;
            int choice = fdp.ConsumeIntegralInRange<int>(0, 4);
            if (choice == 0) num_val = static_cast<double>(INT_MAX) + 1.0; // Covers number >= INT_MAX
            else if (choice == 1) num_val = static_cast<double>(INT_MIN) - 1.0; // Covers number <= INT_MIN
            else if (choice == 2) num_val = static_cast<double>(INT_MAX); // Covers exact INT_MAX
            else if (choice == 3) num_val = static_cast<double>(INT_MIN); // Covers exact INT_MIN
            else num_val = fdp.ConsumeFloatingPoint<double>(); // General case
            return cJSON_CreateNumber(num_val);
        }
        // Consume a boolean for bool type.
        case 4: return cJSON_CreateBool(fdp.ConsumeBool());
        case 5: return cJSON_CreateNull();
        case 6: return cJSON_CreateRaw(fdp.ConsumeRandomLengthString(32).c_str());
        default: return nullptr; // Should not happen with the given range.
    }
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a root cJSON object to perform operations on.
    // Using unique_cJSON_ptr ensures automatic deletion and memory safety.
    unique_cJSON_ptr root_item(CreateFuzzedCjsonItem(fdp));
    if (!root_item) {
        // If root_item creation fails, there's nothing to fuzz.
        // This branch (lines 52-53) was previously uncovered.
    }

    // Fuzzing loop: continue as long as there's enough fuzzed data remaining.
    // This allows for multiple operations on the same cJSON structure,
    // increasing the chances of finding state-related bugs.
    while (fdp.remaining_bytes() > 10) { // Ensure enough bytes for at least one action
        // Select one of the target APIs to call.
        // Increased range to include new actions for parsing, printing, getters, etc.
        int action = fdp.ConsumeIntegralInRange<int>(0, 12); // Original: 0-7, New: 0-12

        switch (action) {
            case 0: { // Target API: cJSON_ReplaceItemInObject
                if (root_item && root_item->type == cJSON_Object) {
                    std::string key = fdp.ConsumeRandomLengthString(16);
                    unique_cJSON_ptr new_item(CreateFuzzedCjsonItem(fdp));
                    if (new_item) {
                        if (!cJSON_ReplaceItemInObject(root_item.get(), key.c_str(), new_item.get())) {
                            // Replacement failed, unique_ptr handles deletion.
                        } else {
                            new_item.release(); // Ownership transferred.
                        }
                    }
                }
                break;
            }
            case 1: { // Target API: cJSON_AddItemToArray (replaces AddItemReferenceToArray for safety)
                      // Changed from cJSON_AddItemReferenceToArray to cJSON_AddItemToArray to fix UAF.
                      // cJSON_AddItemToArray takes ownership, so item_to_add must be released from unique_ptr.
                if (root_item && root_item->type == cJSON_Array) {
                    unique_cJSON_ptr item_to_add(CreateFuzzedCjsonItem(fdp));
                    if (item_to_add) {
                        if (cJSON_AddItemToArray(root_item.get(), item_to_add.get())) {
                             item_to_add.release(); // Ownership transferred to root_item.
                        }
                        // If AddItemToArray fails, item_to_add is automatically deleted by unique_ptr.
                    }
                }
                else if (fdp.ConsumeBool()) { // Test with NULL array
                    unique_cJSON_ptr item_to_add(CreateFuzzedCjsonItem(fdp));
                    if (item_to_add) {
                        // Call AddItemToArray with NULL parent; item_to_add will be cleaned up by unique_ptr
                        // as AddItemToArray will likely fail and not take ownership.
                        cJSON_AddItemToArray(nullptr, item_to_add.get());
                    }
                }
                break;
            }
            case 2: { // Target API: cJSON_ReplaceItemInArray
                if (root_item && root_item->type == cJSON_Array && cJSON_GetArraySize(root_item.get()) > 0) {
                    int index = fdp.ConsumeIntegralInRange<int>(0, cJSON_GetArraySize(root_item.get()) - 1);
                    unique_cJSON_ptr new_item(CreateFuzzedCjsonItem(fdp));
                    if (new_item) {
                        if (!cJSON_ReplaceItemInArray(root_item.get(), index, new_item.get())) {
                            // Replacement failed.
                        } else {
                            new_item.release(); // Ownership transferred.
                        }
                    }
                }
                break;
            }
            case 3: { // Target API: cJSON_DetachItemFromArray
                if (root_item && root_item->type == cJSON_Array && cJSON_GetArraySize(root_item.get()) > 0) {
                    int index = fdp.ConsumeIntegralInRange<int>(0, cJSON_GetArraySize(root_item.get()) - 1);
                    unique_cJSON_ptr detached_item(cJSON_DetachItemFromArray(root_item.get(), index));
                }
                else if (fdp.ConsumeBool()) { // Added call with negative index
                    unique_cJSON_ptr detached_item(cJSON_DetachItemFromArray(root_item.get(), fdp.ConsumeIntegralInRange<int>(-10, -1)));
                }
                else if (fdp.ConsumeBool()) { // Added call with NULL array
                    unique_cJSON_ptr detached_item(cJSON_DetachItemFromArray(nullptr, 0));
                }
                break;
            }
            case 4: { // Target API: CreateFuzzedCjsonItem
                unique_cJSON_ptr temp_item(CreateFuzzedCjsonItem(fdp));
                break;
            }
            case 5: { // Target API: cJSON_AddStringToObject
                if (root_item && root_item->type == cJSON_Object) {
                    std::string key = fdp.ConsumeRandomLengthString(16);
                    std::string value = fdp.ConsumeRandomLengthString(32);
                    cJSON_AddStringToObject(root_item.get(), key.c_str(), value.c_str());
                }
                else if (fdp.ConsumeBool()) { // Added call with NULL string
                    std::string key = fdp.ConsumeRandomLengthString(16);
                    unique_cJSON_ptr temp_item(cJSON_CreateString(nullptr));
                }
                break;
            }
            case 6: { // Target API: cJSON_GetArraySize
                if (fdp.ConsumeBool()) {
                    cJSON_GetArraySize(nullptr); // Cover NULL input branch
