// Alias for std::unique_ptr with the custom CJSONDeleter.
// This is the primary mechanism for memory safety with cJSON objects.
using unique_cJSON_ptr = std::unique_ptr<cJSON, CJSONDeleter>;

// Helper function to wrap a raw cJSON* in a unique_cJSON_ptr.
// This promotes safer memory management by leveraging RAII.
static unique_cJSON_ptr manage_cjson(cJSON* item) {
    return unique_cJSON_ptr(item);
}

// Forward declaration for the recursive helper function
static unique_cJSON_ptr CreateRandomCJSONItem(FuzzedDataProvider& fdp, int depth);

// Enum to determine the type of cJSON item to create.
enum CJSON_Creation_Type {
    TYPE_NULL,
    TYPE_BOOL,
    TYPE_NUMBER,
    TYPE_STRING,
    TYPE_ARRAY,
    TYPE_OBJECT,
    TYPE_RAW,
    kMaxValue = TYPE_RAW // Added for FuzzedDataProvider::ConsumeEnum
};

// Helper function to create a diverse cJSON item (and its children recursively)
// using FuzzedDataProvider. This function aims to exercise various cJSON creation APIs.
static unique_cJSON_ptr CreateRandomCJSONItem(FuzzedDataProvider& fdp, int depth) {
    // Maximum recursion depth to prevent stack overflows or excessively complex objects.
    // Also, reduce complexity if remaining bytes in FDP are few.
    const int max_simple_type_val = 4; // Corresponds to cases 0-4 for simple types
    if (depth <= 0 || fdp.remaining_bytes() < 10) {
        uint8_t simple_type = fdp.ConsumeIntegralInRange<uint8_t>(0, max_simple_type_val);
        switch (simple_type) {
            case 0: return manage_cjson(cJSON_CreateNull());
            case 1: return manage_cjson(cJSON_CreateBool(fdp.ConsumeBool()));
            case 2: return manage_cjson(cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>()));
            case 3: {
                std::string str_val = fdp.ConsumeRandomLengthString(50);
                return manage_cjson(cJSON_CreateString(str_val.c_str()));
            }
            case 4: // Fallback or cJSON_CreateRaw
            default: {
                std::string raw_val = fdp.ConsumeRandomLengthString(30);
                 // cJSON_CreateRaw is useful for testing handling of non-standard JSON values
                return manage_cjson(cJSON_CreateRaw(raw_val.c_str()));
            }
        }
    }

    CJSON_Creation_Type type = fdp.ConsumeEnum<CJSON_Creation_Type>();

    switch (type) {
        case TYPE_NULL:
            return manage_cjson(cJSON_CreateNull());
        case TYPE_BOOL:
            return manage_cjson(cJSON_CreateBool(fdp.ConsumeBool()));
        case TYPE_NUMBER:
            // Generate various numeric types
            if (fdp.ConsumeBool()) {
                return manage_cjson(cJSON_CreateNumber(fdp.ConsumeIntegral<int>()));
            } else {
                return manage_cjson(cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>()));
            }
        case TYPE_STRING: {
            std::string str_val = fdp.ConsumeRandomLengthString(100);
            return manage_cjson(cJSON_CreateString(str_val.c_str()));
        }
        case TYPE_RAW: {
            std::string raw_val = fdp.ConsumeRandomLengthString(50);
            return manage_cjson(cJSON_CreateRaw(raw_val.c_str()));
        }
        case TYPE_ARRAY: {
            unique_cJSON_ptr arr_ptr = manage_cjson(cJSON_CreateArray());
            if (!arr_ptr) return nullptr; // Allocation failed
            cJSON* arr = arr_ptr.get();
            // Limit array size to prevent excessive recursion or large objects.
            int num_items = fdp.ConsumeIntegralInRange<int>(0, fdp.ConsumeBool() ? 3 : 6);
            for (int i = 0; i < num_items; ++i) {
                if (fdp.remaining_bytes() < 5) break; // Stop if not enough data for a meaningful item
                unique_cJSON_ptr item = CreateRandomCJSONItem(fdp, depth - 1);
                if (item) {
                    // cJSON_AddItemToArray takes ownership of the item.
                    // Must .release() the item from unique_ptr to transfer ownership.
                    cJSON_AddItemToArray(arr, item.release());
                } else if (fdp.ConsumeBool()) {
                    // Optionally add a simple type if recursive creation failed or was skipped
                    cJSON_AddItemToArray(arr, cJSON_CreateNull());
                }
            }
            return arr_ptr;
        }
        case TYPE_OBJECT: {
            unique_cJSON_ptr obj_ptr = manage_cjson(cJSON_CreateObject());
            if (!obj_ptr) return nullptr; // Allocation failed
            cJSON* obj = obj_ptr.get();
            int num_items = fdp.ConsumeIntegralInRange<int>(0, fdp.ConsumeBool() ? 3 : 6);
            for (int i = 0; i < num_items; ++i) {
                if (fdp.remaining_bytes() < 10) break; // Stop if not enough data for key + item
                std::string key = fdp.ConsumeRandomLengthString(20);
                // cJSON_AddItemToObjectCS requires a non-empty key.
                if (key.empty()) {
                    if (fdp.ConsumeBool() && num_items > 0) continue; // Skip if key is empty
                    key = fdp.ConsumeRandomLengthString(1) + "k"; // Ensure a small non-empty key
                     if(key.length() == 1 && key[0] == 'k') key = "dk"; // default key
                }

                unique_cJSON_ptr item = CreateRandomCJSONItem(fdp, depth - 1);
                if (item) {
                    // cJSON_AddItemToObjectCS takes ownership of the item.
                    // Must .release() the item from unique_ptr.
                    cJSON_AddItemToObjectCS(obj, key.c_str(), item.release());
                } else if (fdp.ConsumeBool()) {
                    // Optionally add a simple type if recursive creation failed
                     cJSON_AddItemToObjectCS(obj, key.c_str(), cJSON_CreateString("fallback"));
                }
            }
            return obj_ptr;
        }
    }
    // Fallback, should ideally not be reached if enum covers all cases.
    return manage_cjson(cJSON_CreateNull());
}

// Main fuzzing entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Max depth for recursive cJSON creation to control complexity
    const int max_depth = fdp.ConsumeIntegralInRange(2,5);

    // --- Test Case 1: Parsing JSON from fuzzed data ---
    // Consume a portion of data for parsing
    std::string json_to_parse = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, fdp.remaining_bytes() / 2));
    const char* parse_end = nullptr;
    bool require_null_terminated = fdp.ConsumeBool();

    // Attempt to parse the string. cJSON_ParseWithOpts is a versatile parsing function.
    // Memory for parsed_json is managed by unique_cJSON_ptr.
    unique_cJSON_ptr parsed_json = manage_cjson(
        cJSON_ParseWithOpts(json_to_parse.c_str(), &parse_end, require_null_terminated)
    );

    if (parsed_json) {
        // If parsing is successful, test printing functions.
        // These functions allocate a string that must be freed using cJSON_free.

        // Test cJSON_PrintUnformatted (compact JSON output)
        char* printed_unformatted = cJSON_PrintUnformatted(parsed_json.get());
        if (printed_unformatted) {
            cJSON_free(printed_unformatted);
        }

        // Test cJSON_Print (formatted JSON output)
        char* printed_formatted = cJSON_Print(parsed_json.get());
        if (printed_formatted) {
            cJSON_free(printed_formatted);
        }

        // Test modification/access APIs on the parsed object
        if (parsed_json->type == cJSON_Object && cJSON_GetArraySize(parsed_json.get()) > 0) {
            std::string key_to_operate_on;
            bool key_operation_possible = false;

            // Try to get a key from an existing item (e.g., the first child) and copy it.
            if (parsed_json->child && parsed_json->child->string && strlen(parsed_json->child->string) > 0) {
                key_to_operate_on = parsed_json->child->string; // Copy key
                key_operation_possible = true;
            } else {
                // If no valid key from an existing child, generate one.
                // This key might not exist for deletion, but ReplaceItemInObject will add it.
                key_to_operate_on = fdp.ConsumeRandomLengthString(10);
                if (!key_to_operate_on.empty()) {
                    key_operation_possible = true;
                } else {
                    // If FDP provides an empty string, assign a default to ensure operations can proceed
                    // if desired, or skip if an empty key is problematic for the operations.
                    // For this case, let's ensure a non-empty key if we decide to operate.
                    // However, to closely match original intent of `if (key_str && strlen(key_str) > 0)`
                    // we only proceed if key_to_operate_on is non-empty.
                }
            }

            if (key_operation_possible && !key_to_operate_on.empty()) {
                cJSON_DeleteItemFromObject(parsed_json.get(), key_to_operate_on.c_str()); // Frees the item

                unique_cJSON_ptr item_to_replace = CreateRandomCJSONItem(fdp, max_depth - 1);
                if (item_to_replace) {
                    // Use cJSON_ReplaceItemInObject instead of cJSON_ReplaceItemInObjectCS
                    // It takes ownership of item_to_replace.
                    // The old item (if key existed) is freed by cJSON_ReplaceItemInObject.
                    cJSON_ReplaceItemInObject(parsed_json.get(), key_to_operate_on.c_str(), item_to_replace.release());
                }
            }
        } else if (parsed_json->type == cJSON_Array) {
            int array_size = cJSON_GetArraySize(parsed_json.get());
            if (array_size > 0) {
                int index_to_op = fdp.ConsumeIntegralInRange<int>(0, array_size - 1);
                cJSON_DeleteItemFromArray(parsed_json.get(), index_to_op); // Frees the item

                // Check size again as it might have changed
                array_size = cJSON_GetArraySize(parsed_json.get());
                if (array_size > 0) { // Ensure array is still not empty
                    index_to_op = fdp.ConsumeIntegralInRange<int>(0, array_size - 1);
                    unique_cJSON_ptr item_to_replace_arr = CreateRandomCJSONItem(fdp, max_depth -1);
                    if (item_to_replace_arr) {
                        // cJSON_ReplaceItemInArray takes ownership. Old item freed.
                        cJSON_ReplaceItemInArray(parsed_json.get(), index_to_op, item_to_replace_arr.release());
                    }
                }
            }
        }
        // parsed_json is automatically deleted when it goes out of scope via CJSONDeleter.
    }


    // --- Test Case 2: Creating complex cJSON objects programmatically ---
    // Create a cJSON item using the recursive helper.
    // This exercises cJSON_Create* and cJSON_AddItem* functions.
    unique_cJSON_ptr created_json = CreateRandomCJSONItem(fdp, max_depth);

    if (created_json) {
        // Test printing for the programmatically created JSON object.
        char* printed_created_unformatted = cJSON_PrintUnformatted(created_json.get());
        if (printed_created_unformatted) {
            cJSON_free(printed_created_unformatted);
        }

        char* printed_created_formatted = cJSON_Print(created_json.get());
        if (printed_created_formatted) {
            cJSON_free(printed_created_formatted);
        }

        // Test cJSON_Duplicate
        if (fdp.ConsumeBool()) { // Randomly decide to test duplication
            // Test both recursive and non-recursive duplication
            bool recurse_duplicate = fdp.ConsumeBool();
            unique_cJSON_ptr duplicated_json = manage_cjson(cJSON_Duplicate(created_json.get(), recurse_duplicate));
            if (duplicated_json) {
                // Optionally print or inspect the duplicated JSON
                char* printed_duplicated = cJSON_Print(duplicated_json.get());
                if (printed_duplicated) {
                    cJSON_free(printed_duplicated);
                }
                // duplicated_json is managed by unique_ptr and will be auto-deleted.
            }
        }

        // Further test additions to existing created objects/arrays
        if (fdp.ConsumeBool() && created_json->type == cJSON_Object) {
            std::string new_key = fdp.ConsumeRandomLengthString(15);
            if(new_key.empty()) new_key = "new_obj_key";
            unique_cJSON_ptr item_to_add = CreateRandomCJSONItem(fdp, max_depth -1);
            if (item_to_add) {
                // Add item (takes ownership)
                cJSON_AddItemToObjectCS(created_json.get(), new_key.c_str(), item_to_add.release());
            }
        } else if (fdp.ConsumeBool() && created_json->type == cJSON_Array) {
             unique_cJSON_ptr item_to_add_array = CreateRandomCJSONItem(fdp, max_depth -1);
             if (item_to_add_array) {
                 // Add item (takes ownership)
                 cJSON_AddItemToArray(created_json.get(), item_to_add_array.release());
             }
        }
        // created_json is automatically deleted at scope end.
    }

    return 0; // Successful execution
}[0m
