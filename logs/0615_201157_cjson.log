    // This allows for multiple operations on the same cJSON structure,
    // increasing the chances of finding state-related bugs.
    // Ensure enough bytes for at least one action.
    while (fdp.remaining_bytes() > 10) {
        // Select one of the target APIs to call.
        // Increased range to include new actions for parsing, printing, getters, etc.
        int action = fdp.ConsumeIntegralInRange<int>(0, 12); // Original: 0-7, New: 0-12

