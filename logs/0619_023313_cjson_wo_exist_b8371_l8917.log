#include "/src/cjson/cJSON.h"
#include <fuzzer/FuzzedDataProvider.h>
#include <memory>
#include <string>
#include <vector>

// Custom deleter for cJSON objects to ensure proper deallocation
struct CJSONDeleter {
    void operator()(cJSON* item) const {
        cJSON_Delete(item);
    }
};

// Helper function to create a fuzzed cJSON item with limited recursion depth
std::unique_ptr<cJSON, CJSONDeleter> FuzzCJSONItem(FuzzedDataProvider& fdp, int depth = 0) {
    // Limit recursion depth and prevent excessive memory allocation
    if (depth > 3 || fdp.RemainingBytes() < 2) {
        return nullptr;
    }

    cJSON* item = nullptr;
    // Use a range that includes different cJSON types and an option for nested structures
    int type = fdp.ConsumeIntegralInRange<int>(0, 6); // 0:Null, 1:Bool, 2:Number, 3:String, 4:Array, 5:Object, 6:Recursive

    if (type == 0) {
        item = cJSON_CreateNull();
    } else if (type == 1) {
        item = cJSON_CreateBool(fdp.ConsumeBool());
    } else if (type == 2) {
        item = cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>());
    } else if (type == 3) {
        std::string s = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 100));
        item = cJSON_CreateString(s.c_str());
    } else if (type == 4) {
        item = cJSON_CreateArray();
        if (item) {
            int num_elements = fdp.ConsumeIntegralInRange<int>(0, 5);
            for (int i = 0; i < num_elements; ++i) {
                std::unique_ptr<cJSON, CJSONDeleter> child_item = FuzzCJSONItem(fdp, depth + 1);
                if (child_item) {
                    // cJSON_AddItemToArray takes ownership of the item
                    cJSON_AddItemToArray(item, child_item.release());
                }
            }
        }
    } else if (type == 5) {
        item = cJSON_CreateObject();
        if (item) {
            int num_elements = fdp.ConsumeIntegralInRange<int>(0, 5);
            for (int i = 0; i < num_elements; ++i) {
                std::string key = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(1, 20));
                std::unique_ptr<cJSON, CJSONDeleter> child_item = FuzzCJSONItem(fdp, depth + 1);
                if (child_item) {
                    // cJSON_AddItemToObject takes ownership of the item
                    cJSON_AddItemToObject(item, key.c_str(), child_item.release());
                }
            }
        }
    } else if (type == 6) { // Recursive call for nested structure
         item = FuzzCJSONItem(fdp, depth + 1).release();
    }

    return std::unique_ptr<cJSON, CJSONDeleter>(item);
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Initialize cJSON hooks with default memory functions
    cJSON_Hooks hooks;
    cJSON_InitHooks(&hooks);

    // Create a base JSON object to manipulate throughout the fuzzing iteration
    std::unique_ptr<cJSON, CJSONDeleter> root(cJSON_CreateObject());
    if (!root) {
        return 0;
    }

    // Perform a series of operations on the root object based on fuzzer data
    while (fdp.RemainingBytes() > 0) {
        // Select an operation to perform
        int operation = fdp.ConsumeIntegralInRange<int>(0, 4); // 0:AddNumber, 1:AddRaw, 2:AddArray, 3:ReplaceItem, 4:Print

        if (operation == 0) { // Exercise cJSON_AddNumberToObject
            std::string key = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(1, 20));
            double value = fdp.ConsumeFloatingPoint<double>();
            cJSON_AddNumberToObject(root.get(), key.c_str(), value);
        } else if (operation == 1) { // Exercise cJSON_AddRawToObject
            std::string key = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(1, 20));
            std::string raw_value = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 100));
            cJSON_AddRawToObject(root.get(), key.c_str(), raw_value.c_str());
        } else if (operation == 2) { // Exercise cJSON_AddArrayToObject
            std::string key = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(1, 20));
            // Create a fuzzed array to add
            std::unique_ptr<cJSON, CJSONDeleter> array_item = FuzzCJSONItem(fdp);
            if (array_item && cJSON_IsArray(array_item.get())) {
                 // cJSON_AddArrayToObject takes ownership of the array_item
                 cJSON_AddArrayToObject(root.get(), key.c_str(), array_item.release());
            }
        } else if (operation == 3) { // Exercise replace_item_in_object
            std::string key_to_replace = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(1, 20));
            // Create a fuzzed item to replace with
            std::unique_ptr<cJSON, CJSONDeleter> replacement_item = FuzzCJSONItem(fdp);
            bool case_sensitive = fdp.ConsumeBool();
            if (replacement_item) {
                // replace_item_in_object takes ownership of the replacement_item
                // It also deletes the original item if found
                replace_item_in_object(root.get(), key_to_replace.c_str(), replacement_item.release(), case_sensitive);
            }
        } else if (operation == 4) { // Exercise print
            bool format = fdp.ConsumeBool();
            // Print the current state of the root object
            unsigned char* printed_json = print(root.get(), format, &hooks);
            // The 'print' function allocates memory that needs to be freed using the hooks.
            if (printed_json) {
                hooks.deallocate(printed_json);
            }
        }
    }

    // The unique_ptr for 'root' automatically calls CJSONDeleter when it goes out of scope,
    // ensuring the entire JSON structure is deleted and preventing memory leaks.

    return 0;
}[0m
