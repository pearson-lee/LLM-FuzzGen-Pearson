    void operator()(cJSON* item) const {
        if (item) {
            cJSON_Delete(item);
        }
    }
};
using unique_cJSON_ptr = std::unique_ptr<cJSON, CJSONDeleter>;

// Custom deleter for cJSON print buffers (allocated by cJSON_Print* functions)
struct CJSONPrintDeleter {
    void operator()(unsigned char* buffer) const {
        if (buffer) {
            // cJSON uses its internal free function for buffers allocated by print functions
            cJSON_free(buffer);
        }
    }
};
using unique_cJSON_print_ptr = std::unique_ptr<unsigned char, CJSONPrintDeleter>;


extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
