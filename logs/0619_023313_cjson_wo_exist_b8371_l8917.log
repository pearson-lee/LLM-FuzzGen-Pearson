                    switch (item_type) {
                        case 0: item_to_print.reset(cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>())); break;
                        case 1: item_to_print.reset(cJSON_CreateString(fdp.ConsumeRandomLengthString(32).c_str())); break;
                        case 2: item_to_print.reset(cJSON_CreateBool(fdp.ConsumeBool())); break;
                        case 3: item_to_print.reset(cJSON_CreateNull()); break;
                    }
