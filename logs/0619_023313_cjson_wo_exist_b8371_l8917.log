// Define a custom deleter for cJSON objects using std::unique_ptr
// This ensures cJSON_Delete is called automatically when the unique_ptr goes out of scope.
struct CJSONDeleter {
    void operator()(cJSON* item) const {
        if (item) {
            cJSON_Delete(item);
        }
    }
};

// Use unique_ptr with the custom deleter for automatic memory management
using unique_cJSON_ptr = std::unique_ptr<cJSON, CJSONDeleter>;

