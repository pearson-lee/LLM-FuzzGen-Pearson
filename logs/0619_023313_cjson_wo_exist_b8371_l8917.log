#include "/src/cjson/cJSON.h"
#include <fuzzer/FuzzedDataProvider.h>

#include <memory>
#include <string>
#include <vector>

// Custom deleter for cJSON objects to be used with std::unique_ptr
struct CJSONDeleter {
  void operator()(cJSON* obj) const {
    if (obj) {
      cJSON_Delete(obj);
    }
  }
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzedDataProvider fdp(Data, Size);

  // Consume data for cJSON_ParseWithOpts
  std::string json_string = fdp.ConsumeRandomLengthString();
  bool require_null_terminated = fdp.ConsumeBool();

  // Call cJSON_ParseWithOpts
  // The second argument (return_parse_end) is not used in this fuzzer.
  std::unique_ptr<cJSON, CJSONDeleter> parsed_json(
      cJSON_ParseWithOpts(json_string.c_str(), nullptr, require_null_terminated));

  // If parsing was successful, exercise the print function
  if (parsed_json) {
    // Consume data for print options
    bool formatted = fdp.ConsumeBool();

    // Call print. The returned string needs to be freed using cJSON_free.
    unsigned char* printed_string = print(parsed_json.get(), formatted, nullptr);
    if (printed_string) {
      cJSON_free(printed_string);
    }
  }

  // Create a root object to exercise modification functions
  std::unique_ptr<cJSON, CJSONDeleter> root_object(cJSON_CreateObject());

  if (root_object) {
    // Exercise cJSON_CreateNumber and cJSON_AddItemToObject
    double num_val1 = fdp.ConsumeFloatingPoint<double>();
    std::unique_ptr<cJSON, CJSONDeleter> number_item1(cJSON_CreateNumber(num_val1));
    std::string key1 = fdp.ConsumeRandomLengthString();

    // Add the number item to the root object. If successful, release ownership from unique_ptr.
    if (number_item1) {
      if (cJSON_AddItemToObject(root_object.get(), key1.c_str(), number_item1.get())) {
        number_item1.release(); // Ownership transferred to root_object
      }
    }

    // Exercise cJSON_CreateNumber again and add another item
    double num_val2 = fdp.ConsumeFloatingPoint<double>();
    std::unique_ptr<cJSON, CJSONDeleter> number_item2(cJSON_CreateNumber(num_val2));
    std::string key2 = fdp.ConsumeRandomLengthString();

    // Add the second number item to the root object. If successful, release ownership.
    if (number_item2) {
      if (cJSON_AddItemToObject(root_object.get(), key2.c_str(), number_item2.get())) {
        number_item2.release(); // Ownership transferred to root_object
      }
    }

    // Exercise replace_item_in_object
    std::string replace_key = fdp.ConsumeRandomLengthString();
    bool replace_case_sensitive = fdp.ConsumeBool();

    // Create a new item to replace with
    double replace_num_val = fdp.ConsumeFloatingPoint<double>();
    std::unique_ptr<cJSON, CJSONDeleter> replace_item(cJSON_CreateNumber(replace_num_val));

    // Replace the item in the root object. If successful, release ownership.
    if (replace_item) {
      if (replace_item_in_object(root_object.get(), replace_key.c_str(), replace_item.get(), replace_case_sensitive)) {
        replace_item.release(); // Ownership transferred to root_object
      }
    }
  }

  // The unique_ptr for parsed_json and root_object will automatically call cJSON_Delete
  // when they go out of scope, ensuring memory is freed.
  // Items successfully added to root_object are deleted when root_object is deleted.
  // Items not successfully added or replaced are deleted by their unique_ptr.

  return 0;
}[0m
