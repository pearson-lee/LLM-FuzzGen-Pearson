                    unique_cJSON_print_ptr print_buffer(static_cast<unsigned char*>(cJSON_malloc(buffer_len)));

                    if (print_buffer) {
                         cJSON_bool fmt = fdp.ConsumeBool();
                         // Call the buffered print function
                         cJSON_PrintBuffered(item_to_print.get(), reinterpret_cast<char*>(print_buffer.get()), buffer_len, fmt);
                         // print_buffer is automatically freed when it goes out of scope
                    }
                    // item_to_print is automatically deleted here (if created in this case)
                }
                break;
            }
            case 2: { // Exercise cJSON_CreateObject
                // Create a new cJSON object and add it to the list of top-level objects
                unique_cJSON_ptr new_object(cJSON_CreateObject());
                if (new_object) {
                    top_level_objects.push_back(std::move(new_object));
                }
                break;
            }
            case 3: { // Exercise cJSON_AddItemToObject
                // Need an existing object to add to
                if (top_level_objects.empty()) break;

                // Select a random existing object from the list
                size_t parent_index = fdp.ConsumeIntegralInRange<size_t>(0, top_level_objects.size() - 1);
                cJSON* parent_obj = top_level_objects[parent_index].get();

                // Ensure the selected object is actually an object before attempting to add
                if (parent_obj && cJSON_IsObject(parent_obj)) {
                    // Create a child item to add (Number, String, Bool, Null, Array)
                    unique_cJSON_ptr child_item;
                    uint8_t item_type = fdp.ConsumeIntegralInRange<uint8_t>(0, 4);
                    switch (item_type) {
                        case 0: child_item.reset(cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>())); break;
                        case 1: child_item.reset(cJSON_CreateString(fdp.ConsumeRandomLengthString(32).c_str())); break;
                        case 2: child_item.reset(cJSON_CreateBool(fdp.ConsumeBool())); break;
                        case 3: child_item.reset(cJSON_CreateNull()); break;
                        case 4: child_item.reset(cJSON_CreateArray()); break; // Add an array item
                    }

                    if (child_item) {
                        // Consume a string for the key
                        std::string key = fdp.ConsumeRandomLengthString(16);
                        // Call AddItemToObject. cJSON takes ownership of the item on success.
                        cJSON_AddItemToObject(parent_obj, key.c_str(), child_item.get());
                        // Assume ownership is taken if the parent was a valid object. Release unique_ptr ownership.
                        child_item.release();
                    }
