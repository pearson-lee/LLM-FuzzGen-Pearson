extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Use unique_ptr with custom deleters for automatic memory management
    using cJSON_ptr = std::unique_ptr<cJSON, CJSONDeleter>;
    using cJSON_string_ptr = std::unique_ptr<unsigned char, CJSONPrintDeleter>;

    // Consume data for a JSON string to parse
    std::string json_string = fdp.ConsumeRandomLengthString(1024);

    // Consume options for parsing
    bool require_null_terminated = fdp.ConsumeBool();

    // API 1: cJSON_ParseWithOpts
    // Attempt to parse the fuzzer input string.
    // return_parse_end is not strictly needed for basic fuzzing, pass nullptr.
    cJSON_ptr root(cJSON_ParseWithOpts(json_string.c_str(), nullptr, require_null_terminated));

    // We need a cJSON object to call other APIs. If parsing failed,
    // create a simple object based on fuzzer data to continue testing.
    cJSON_ptr item_to_fuzz;
    if (root) {
        // If parsing succeeded, use the parsed object
        item_to_fuzz = std::move(root);
    } else {
        // If parsing failed, create a simple object based on fuzzer data
        int item_type = fdp.ConsumeIntegralInRange<int>(0, 5); // 0:Null, 1:Bool, 2:Number, 3:String, 4:Array, 5:Object
        switch (item_type) {
            case 0: item_to_fuzz.reset(cJSON_CreateNull()); break;
            case 1: item_to_fuzz.reset(cJSON_CreateBool(fdp.ConsumeBool())); break;
            case 2: item_to_fuzz.reset(cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>())); break;
            case 3: item_to_fuzz.reset(cJSON_CreateString(fdp.ConsumeRandomLengthString(64).c_str())); break;
            case 4: item_to_fuzz.reset(cJSON_CreateArray()); break;
            case 5: item_to_fuzz.reset(cJSON_CreateObject()); break;
            default: item_to_fuzz.reset(cJSON_CreateNull()); break;
        }
    }

    // Ensure we have a valid item to proceed
    if (item_to_fuzz) {
        // API 2: cJSON_Print
        // Print the cJSON object. The returned string must be freed.
        // Cast the char* return value to unsigned char* for unique_ptr
        cJSON_string_ptr printed_string(reinterpret_cast<unsigned char*>(cJSON_Print(item_to_fuzz.get())));
        // printed_string will be automatically freed when it goes out of scope

        // API 3: cJSON_PrintBuffered
        // Print the cJSON object to a fuzzer-sized buffer (internally allocated).
        // The returned string must be freed.
        // Signature: CJSON_PUBLIC(char *) cJSON_PrintBuffered(const cJSON *item, int prebuffer, cJSON_bool fmt);
        size_t buffer_size = fdp.ConsumeIntegralInRange<size_t>(0, 1024);
        bool format_buffered = fdp.ConsumeBool();
        // Cast the char* return value to unsigned char* for unique_ptr
        // Cast buffer_size to int and format_buffered to cJSON_bool
        cJSON_string_ptr printed_buffered_string(reinterpret_cast<unsigned char*>(cJSON_PrintBuffered(item_to_fuzz.get(), static_cast<int>(buffer_size), static_cast<cJSON_bool>(format_buffered))));
        // printed_buffered_string will be automatically freed when it goes out of scope

        // API 4: cJSON_Duplicate
        // Duplicate the cJSON object. The duplicated object must be deleted.
        bool recurse_duplicate = fdp.ConsumeBool();
        cJSON_ptr duplicated_item(cJSON_Duplicate(item_to_fuzz.get(), recurse_duplicate));
        // duplicated_item will be automatically deleted when it goes out of scope

        // API 5: replace_item_in_object
        // This API requires the item to be part of an object.
        // Create a temporary object and add a copy of the item to it to test replacement.
        cJSON_ptr temp_obj_for_replace(cJSON_CreateObject());
        if (temp_obj_for_replace) {
            std::string temp_key = "temp_key";
            // Create a copy of item_to_fuzz to add to the temporary object.
            // Duplicating ensures we have a fresh item to add and don't interfere with
            // the ownership of the original item_to_fuzz unique_ptr.
            cJSON_ptr item_copy_for_replace(cJSON_Duplicate(item_to_fuzz.get(), true)); // Deep copy
            if (item_copy_for_replace) {
                 // Add the copied item to the temporary object. AddItemToObject takes ownership.
                 // Release ownership from the unique_ptr as temp_obj_for_replace now owns it.
                cJSON* raw_item_copy_for_replace = item_copy_for_replace.get();
                item_copy_for_replace.release();
                cJSON_AddItemToObject(temp_obj_for_replace.get(), temp_key.c_str(), raw_item_copy_for_replace);

                // Create a new replacement item
                cJSON_ptr replacement_item(cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>()));
                 if (replacement_item) {
                    cJSON* raw_replacement_item = replacement_item.get();
                    replacement_item.release(); // Release ownership

                    bool fuzzed_bool_option = fdp.ConsumeBool();
                    // Call the declared internal function
                    cJSON_bool replaced = replace_item_in_object(temp_obj_for_replace.get(), temp_key.c_str(), raw_replacement_item, static_cast<cJSON_bool>(fuzzed_bool_option));

                    if (!replaced) {
                        // If replacement failed, the function did not take ownership, so we must delete it.
                        cJSON_Delete(raw_replacement_item);
                    }
                    // If replaced is true, raw_replacement_item is now owned by temp_obj_for_replace
                    // and will be deleted when temp_obj_for_replace is deleted.
                }
