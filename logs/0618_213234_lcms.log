fuzz target: 
#include <cstddef>
#include <cstdint>
#include <memory>
#include <string>
#include <vector>

#include "lcms2.h"
#include "lcms2_plugin.h"
#include "lcms2_internal.h"

#include <fuzzer/FuzzedDataProvider.h>

// --- Custom Deleters for RAII ---

struct ContextDeleter {
  void operator()(cmsContext ctx) const {
    if (ctx) {
      cmsDeleteContext(ctx);
    }
  }
};

struct ProfileDeleter {
  void operator()(cmsHPROFILE profile) const {
    if (profile) {
      cmsCloseProfile(profile);
    }
  }
};

struct IOHandlerDeleter {
  void operator()(cmsIOHANDLER* iohandler) const {
    if (iohandler) {
      iohandler->Close(iohandler);
    }
  }
};

struct DictDeleter {
  void operator()(cmsHANDLE dict) const {
    if (dict) {
      cmsDictFree(dict);
    }
  }
};

struct StageDeleter {
  void operator()(cmsStage* stage) const {
    if (stage) {
      cmsStageFree(stage);
    }
  }
};

struct SeqDeleter {
  void operator()(cmsSEQ* seq) const {
    if (seq) {
      cmsFreeProfileSequenceDescription(seq);
    }
  }
};

// --- Helper Function to Create a Type Handler ---

static cmsBool _cmsRegisterTestTag(cmsContext ContextID) {
  return _cmsRegisterTagTypePlugin(ContextID, nullptr) &&
         _cmsRegisterTagPlugin(ContextID, nullptr);
}

// --- Fuzz Target ---

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Create a context with a test tag registered.
  std::unique_ptr<cmsContext_struct, ContextDeleter> context(
      cmsCreateContext(nullptr, nullptr));
  if (!context) {
    return 0;
  }
  _cmsRegisterTestTag(context.get());

  // Create a memory-based IO handler from the fuzzer input.
  std::unique_ptr<cmsIOHANDLER, IOHandlerDeleter> iohandler(
      cmsOpenIOhandlerFromMem(context.get(), const_cast<uint8_t*>(data), size, "r"));
  if (!iohandler) {
    return 0;
  }

  // Get a type handler for the dictionary type.
  cmsTagTypeHandler* dict_handler =
      _cmsGetTagTypeHandler(context.get(), cmsSigDictionaryType);
  if (!dict_handler) {
    return 0;
  }

  // Fuzz Type_Dictionary_Read
  cmsUInt32Number items_read;
  std::unique_ptr<void, DictDeleter> dict_read(
      dict_handler->Read(dict_handler, iohandler.get(), &items_read, size));

  // Fuzz Type_Dictionary_Write
  std::unique_ptr<void, DictDeleter> dict_to_write(
      cmsDictAlloc(context.get()));
  if (dict_to_write) {
    // Add some entries to the dictionary with fuzzed data.
    int num_entries = fdp.ConsumeIntegralInRange<int>(0, 10);
    for (int i = 0; i < num_entries; ++i) {
      std::wstring name = fdp.ConsumeRandomLengthString(100);
      std::wstring value = fdp.ConsumeRandomLengthString(100);
      cmsDictAddEntry(dict_to_write.get(), name.c_str(), value.c_str(),
                      nullptr, nullptr);
    }
    // Create a write IO handler.
    std::vector<uint8_t> write_buffer(fdp.ConsumeIntegralInRange<size_t>(1024, 4096));
    std::unique_ptr<cmsIOHANDLER, IOHandlerDeleter> write_iohandler(
        cmsOpenIOhandlerFromMem(context.get(), write_buffer.data(), write_buffer.size(), "w"));
    if (write_iohandler) {
      dict_handler->Write(dict_handler, write_iohandler.get(),
                          dict_to_write.get(), 1);
    }
  }

  // Get a type handler for the profile sequence ID type.
  cmsTagTypeHandler* seq_handler =
      _cmsGetTagTypeHandler(context.get(), cmsSigProfileSequenceIdType);
  if (seq_handler) {
    // Fuzz Type_ProfileSequenceId_Read
    iohandler->Seek(iohandler.get(), 0);
    std::unique_ptr<void, SeqDeleter> seq_read(
        seq_handler->Read(seq_handler, iohandler.get(), &items_read, size));

    // Fuzz Type_ProfileSequenceId_Write
    std::unique_ptr<cmsSEQ, SeqDeleter> seq_to_write(
        cmsAllocProfileSequenceDescription(context.get(), 1));
    if (seq_to_write) {
      // Create a write IO handler.
      std::vector<uint8_t> write_buffer(fdp.ConsumeIntegralInRange<size_t>(1024, 4096));
      std::unique_ptr<cmsIOHANDLER, IOHandlerDeleter> write_iohandler(
          cmsOpenIOhandlerFromMem(context.get(), write_buffer.data(), write_buffer.size(), "w"));
      if (write_iohandler) {
        seq_handler->Write(seq_handler, write_iohandler.get(),
                           seq_to_write.get(), 1);
      }
    }
  }

  // Fuzz _cmsStageAllocLabPrelin
  std::unique_ptr<cmsStage, StageDeleter> stage(
      _cmsStageAllocLabPrelin(context.get()));

  return 0;
}[0m
