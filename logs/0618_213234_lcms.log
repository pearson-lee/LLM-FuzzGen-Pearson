extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  std::unique_ptr<struct _cmsContext_struct, ContextDeleter> context(
      cmsCreateContext(nullptr, nullptr));
  if (!context) {
    return 0;
  }

  // --- Fuzz Read Path ---
  // Treat the input data as a profile and try to open it.
  // This will exercise the "Read" functions of the tag type handlers.
  std::unique_ptr<struct _cms_iccprofile_struct, ProfileDeleter> profile_read(
      cmsOpenProfileFromMem(data, size));
  if (profile_read) {
    // If the profile is valid, we can try to read specific tags
    // to further exercise their handlers. The returned pointers are managed
    // by the profile and should not be freed.
    cmsReadTag(profile_read.get(), cmsSigMetaTag);
    cmsReadTag(profile_read.get(), cmsSigProfileSequenceIdTag);
  }


  // --- Fuzz Write Path ---
  std::unique_ptr<struct _cms_iccprofile_struct, ProfileDeleter> profile_write(
      cmsCreateProfilePlaceholder(context.get()));
  if (!profile_write) {
    return 0;
  }

  // Fuzz Dictionary writing
  std::unique_ptr<void, DictDeleter> dict(cmsDictAlloc(context.get()));
  if (dict) {
    int num_entries = fdp.ConsumeIntegralInRange<int>(0, 10);
    for (int i = 0; i < num_entries; ++i) {
      std::string name_str = fdp.ConsumeRandomLengthString(100);
      std::wstring name(name_str.begin(), name_str.end());
      std::string value_str = fdp.ConsumeRandomLengthString(100);
      std::wstring value(value_str.begin(), value_str.end());
      cmsDictAddEntry(dict.get(), name.c_str(), value.c_str(), nullptr, nullptr);
    }
    cmsWriteTag(profile_write.get(), cmsSigMetaTag, dict.get());
  }

  // Fuzz Profile Sequence Description writing
  std::unique_ptr<cmsSEQ, SeqDeleter> seq(
      cmsAllocProfileSequenceDescription(context.get(), 1));
  if (seq) {
    seq->seq[0].deviceMfg = fdp.ConsumeIntegral<cmsUInt32Number>();
    seq->seq[0].deviceModel = fdp.ConsumeIntegral<cmsUInt32Number>();
    seq->seq[0].attributes = fdp.ConsumeIntegral<cmsUInt64Number>();
    seq->seq[0].technology = (cmsTechnologySignature)fdp.ConsumeIntegral<cmsUInt32Number>();

    std::string mfg_str = fdp.ConsumeRandomLengthString(50);
    seq->seq[0].Manufacturer = cmsMLUalloc(context.get(), 1);
    if (seq->seq[0].Manufacturer) {
        cmsMLUsetASCII(seq->seq[0].Manufacturer, cmsNoLanguage, cmsNoCountry, mfg_str.c_str());
    }

    std::string model_str = fdp.ConsumeRandomLengthString(50);
    seq->seq[0].Model = cmsMLUalloc(context.get(), 1);
    if (seq->seq[0].Model) {
        cmsMLUsetASCII(seq->seq[0].Model, cmsNoLanguage, cmsNoCountry, model_str.c_str());
    }
    
    cmsWriteTag(profile_write.get(), cmsSigProfileSequenceIdTag, seq.get());
  }

  // After writing tags, save the profile to memory to complete the write cycle.
  char* buffer = nullptr;
  cmsUInt32Number bytes_written = 0;
  if (cmsSaveProfileToMem(profile_write.get(), nullptr, &bytes_written)) {
      buffer = (char*)malloc(bytes_written);
      if (buffer) {
          cmsSaveProfileToMem(profile_write.get(), buffer, &bytes_written);
          free(buffer);
      }
  }

  return 0;
}[0m
