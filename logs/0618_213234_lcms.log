struct ContextDeleter {
  void operator()(cmsContext ctx) const {
    if (ctx) {
      cmsDeleteContext(ctx);
    }
  }
};

struct ProfileDeleter {
  void operator()(cmsHPROFILE profile) const {
    if (profile) {
      cmsCloseProfile(profile);
    }
  }
};

struct DictDeleter {
  void operator()(cmsHANDLE dict) const {
    if (dict) {
      cmsDictFree(dict);
    }
  }
};

struct SeqDeleter {
