extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Create a context with a custom error handler to prevent crashes on invalid
  // input.
  auto context = std::unique_ptr<cmsContext_struct, ContextDeleter>(
      cmsCreateContext(nullptr, nullptr));
  if (!context) {
    return 0;
  }
  cmsSetLogErrorHandler(context.get(), nullptr);

  // Create a memory-based IO handler from the fuzzer input.
  auto io = std::unique_ptr<cmsIOHANDLER, IOHandlerDeleter>(
      cmsOpenIOhandlerFromMem(context.get(), (void *)data, size, "r"));
  if (!io) {
    return 0;
  }

  // Fuzz Type_Dictionary_Read
  cmsUInt32Number nItems_dict = 0;
  auto dict = std::unique_ptr<void, DictDeleter>(Type_Dictionary_Read(
      nullptr, io.get(), &nItems_dict, fdp.ConsumeIntegral<cmsUInt32Number>()));
  io->Seek(io.get(), 0);

  // Fuzz Type_vcgt_Read
  cmsUInt32Number nItems_vcgt = 0;
  auto vcgt = std::unique_ptr<cmsToneCurve *, VcgtDeleter>(
      (cmsToneCurve **)Type_vcgt_Read(nullptr, io.get(), &nItems_vcgt,
                                     fdp.ConsumeIntegral<cmsUInt32Number>()));
  io->Seek(io.get(), 0);

  // Fuzz _cmsStageAllocLabPrelin
  auto stage =
      std::unique_ptr<cmsStage, StageDeleter>(_cmsStageAllocLabPrelin(context.get()));

  // Fuzz Type_LUTB2A_Write
  auto lut_b2a = std::unique_ptr<cmsPipeline, PipelineDeleter>(
      cmsPipelineAlloc(context.get(), 3, 3));
  if (lut_b2a) {
    auto write_io = std::unique_ptr<cmsIOHANDLER, IOHandlerDeleter>(
        cmsOpenIOhandlerFromMem(context.get(), nullptr, 0, "w"));
    if (write_io) {
      Type_LUTB2A_Write(nullptr, write_io.get(), lut_b2a.get(),
                        fdp.ConsumeIntegral<cmsUInt32Number>());
    }
  }

  // Fuzz Type_MPE_Write
  auto mpe = std::unique_ptr<cmsPipeline, PipelineDeleter>(
      cmsPipelineAlloc(context.get(), 3, 3));
  if (mpe) {
    auto write_io = std::unique_ptr<cmsIOHANDLER, IOHandlerDeleter>(
        cmsOpenIOhandlerFromMem(context.get(), nullptr, 0, "w"));
    if (write_io) {
      Type_MPE_Write(nullptr, write_io.get(), mpe.get(),
                     fdp.ConsumeIntegral<cmsUInt32Number>());
    }
  }

  return 0;
}[0m
