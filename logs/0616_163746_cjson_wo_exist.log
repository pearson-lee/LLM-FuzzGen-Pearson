            cJSON_AddStringToObject(obj_for_add.get(), fdp.ConsumeRandomLengthString(16).c_str(), fdp.ConsumeRandomLengthString(32).c_str());
            cJSON_AddObjectToObject(obj_for_add.get(), fdp.ConsumeRandomLengthString(16).c_str());
