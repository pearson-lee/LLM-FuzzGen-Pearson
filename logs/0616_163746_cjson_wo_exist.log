#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <fuzzer/FuzzedDataProvider.h>
#include <memory> // For std::unique_ptr
#include <limits.h> // For INT_MAX, INT_MIN
#include <math.h> // For isnan, isinf

// Include the cJSON header with its full project-relative path
#include "/src/cjson/cJSON.h"

// Custom deleter for cJSON pointers to use with std::unique_ptr
struct CJSONDeleter {
    void operator()(cJSON* obj) const {
        if (obj) {
            cJSON_Delete(obj);
        }
    }
};

// Custom deleter for char* returned by cJSON_Print and similar functions
struct CJSONCharDeleter {
    void operator()(char* ptr) const {
        if (ptr) {
            // cJSON_Print uses global_hooks.allocate, so we should use global_hooks.deallocate
            // Assuming cJSON_free is the public interface for freeing cJSON-allocated memory.
            cJSON_free(ptr);
        }
    }
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create unique_ptr for cJSON objects to ensure automatic memory management
    std::unique_ptr<cJSON, CJSONDeleter> root_object(cJSON_CreateObject());
    std::unique_ptr<cJSON, CJSONDeleter> root_array(cJSON_CreateArray());

    // Ensure root objects are created successfully before proceeding
    if (!root_object || !root_array) {
        return 0; // Not enough memory, or creation failed.
    }

    // Fuzzing cJSON_AddRawToObject (existing)
    {
        std::string name = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 64));
        std::string raw_json = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 256));
        // Store the raw item to test cJSON_IsRaw later
        std::unique_ptr<cJSON, CJSONDeleter> raw_item_added(cJSON_AddRawToObject(root_object.get(), name.c_str(), raw_json.c_str()));
        // If cJSON_AddRawToObject successfully adds the item, root_object takes ownership.
        // Therefore, release ownership from the unique_ptr to prevent double-free.
        if (raw_item_added) { // Check if the item was successfully created and added
            raw_item_added.release();
        }
    }

    // Fuzzing cJSON_AddItemReferenceToObject (existing)
    {
        std::string ref_name = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 64));
        std::unique_ptr<cJSON, CJSONDeleter> item_to_reference(cJSON_CreateString(fdp.ConsumeRandomLengthString(64).c_str()));
        if (item_to_reference) {
            cJSON_AddItemReferenceToObject(root_object.get(), ref_name.c_str(), item_to_reference.get());
            // cJSON_AddItemReferenceToObject creates a reference, it does not take ownership of item_to_reference.
            // So, item_to_reference should be deleted by its unique_ptr. No change needed here.
        }
    }

    // Fuzzing cJSON_ReplaceItemInArray (existing)
    {
        int num_items = fdp.ConsumeIntegralInRange<int>(0, 10);
        for (int i = 0; i < num_items; ++i) {
            std::unique_ptr<cJSON, CJSONDeleter> dummy_item(cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>()));
            if (dummy_item) {
                cJSON_AddItemToArray(root_array.get(), dummy_item.release());
            }
        }
        int which = fdp.ConsumeIntegral<int>();
        std::unique_ptr<cJSON, CJSONDeleter> new_item_replace(cJSON_CreateBool(fdp.ConsumeBool()));
        if (new_item_replace) {
            cJSON* released_item = new_item_replace.release();
            if (!cJSON_ReplaceItemInArray(root_array.get(), which, released_item)) {
                cJSON_Delete(released_item);
            }
        }
    }

    // Fuzzing cJSON_InsertItemInArray (existing)
    {
        int which = fdp.ConsumeIntegral<int>();
        std::unique_ptr<cJSON, CJSONDeleter> new_item_insert(cJSON_CreateString(fdp.ConsumeRandomLengthString(64).c_str()));
        if (new_item_insert) {
            cJSON* released_item = new_item_insert.release();
            if (!cJSON_InsertItemInArray(root_array.get(), which, released_item)) {
                cJSON_Delete(released_item);
            }
        }
    }

    // Fuzzing cJSON_CreateString (existing)
    {
        std::string string_value = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 128));
        std::unique_ptr<cJSON, CJSONDeleter> string_item(cJSON_CreateString(string_value.c_str()));
    }

    // --- New Fuzzing Additions for Coverage Improvement ---

    // Fuzzing cJSON_Parse and cJSON_Print related functions
    {
        std::string json_string = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 1024));
        // Added call to cJSON_Parse to cover parsing logic and related internal functions.
        std::unique_ptr<cJSON, CJSONDeleter> parsed_item(cJSON_Parse(json_string.c_str()));

        // Added calls to cJSON_ParseWithOpts and cJSON_ParseWithLength to cover their specific branches.
        const char* return_parse_end = nullptr;
        std::unique_ptr<cJSON, CJSONDeleter> parsed_item_opts(cJSON_ParseWithOpts(json_string.c_str(), &return_parse_end, fdp.ConsumeBool()));
        std::unique_ptr<cJSON, CJSONDeleter> parsed_item_length(cJSON_ParseWithLength(json_string.c_str(), json_string.length()));

        // Added call to cJSON_GetErrorPtr to cover error reporting.
        cJSON_GetErrorPtr();

        if (parsed_item) {
            // Added calls to cJSON_Print and cJSON_PrintUnformatted to cover printing logic.
            std::unique_ptr<char, CJSONCharDeleter> printed_json(cJSON_Print(parsed_item.get()));
            std::unique_ptr<char, CJSONCharDeleter> printed_unformatted_json(cJSON_PrintUnformatted(parsed_item.get()));

            // Added calls to cJSON_PrintBuffered and cJSON_PrintPreallocated to cover buffered printing.
            int prebuffer_size = fdp.ConsumeIntegralInRange<int>(0, 2048);
            std::unique_ptr<char, CJSONCharDeleter> printed_buffered_json(cJSON_PrintBuffered(parsed_item.get(), prebuffer_size, fdp.ConsumeBool()));

            std::vector<char> preallocated_buffer(fdp.ConsumeIntegralInRange<size_t>(0, 2048));
            if (!preallocated_buffer.empty()) {
                cJSON_PrintPreallocated(parsed_item.get(), preallocated_buffer.data(), preallocated_buffer.size(), fdp.ConsumeBool());
            }
        }
    }

    // Fuzzing cJSON_Get*Value and cJSON_SetValuestring functions
    {
        // Added calls to cJSON_GetStringValue and cJSON_GetNumberValue.
        // Create a string item
        std::string str_val = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 64));
        std::unique_ptr<cJSON, CJSONDeleter> string_item(cJSON_CreateString(str_val.c_str()));
        if (string_item) {
            cJSON_GetStringValue(string_item.get());
            // Added call to cJSON_SetValuestring to cover string modification.
            std::string new_str_val = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 64));
            cJSON_SetValuestring(string_item.get(), new_str_val.c_str());
        }

        // Create a number item
        std::unique_ptr<cJSON, CJSONDeleter> number_item(cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>()));
        if (number_item) {
            cJSON_GetNumberValue(number_item.get());
