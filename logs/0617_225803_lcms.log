// Consume a string (null-terminated from fuzzer data, or up to max_len_hint).
// Result must be freed by the caller. Produces an empty string "" if no data or max_len_hint is 0.
static char* FuzzerConsumeString(FuzzerDataInput* fdi, size_t max_len_hint) {
    size_t remaining_data = (fdi->size > fdi->offset) ? (fdi->size - fdi->offset) : 0;
    size_t actual_max_len = (max_len_hint < remaining_data) ? max_len_hint : remaining_data;

    const char* start_ptr = (const char*)(fdi->data + fdi->offset);
    size_t len = 0;
    for (len = 0; len < actual_max_len; ++len) {
        if (start_ptr[len] == '\0') {
            break;
        }
    }

    char* str = (char*)malloc(len + 1);
    if (!str) { // Malloc failure
        // Attempt to advance offset even if malloc fails, to avoid infinite loops on OOM
        if (len < actual_max_len) fdi->offset += (len + 1);
        else fdi->offset += actual_max_len;
        if (fdi->offset > fdi->size) fdi->offset = fdi->size; // Cap offset
        return NULL; 
    }
    
    memcpy(str, start_ptr, len);
    str[len] = '\0';
    
    if (len < actual_max_len) { // Found null terminator at index len
        fdi->offset += (len + 1);
    } else { // Did not find null terminator, consumed actual_max_len bytes
        fdi->offset += actual_max_len; 
    }
    if (fdi->offset > fdi->size) fdi->offset = fdi->size; // Cap offset

    return str;
}

