        min_val = max_val;
        max_val = temp;
    }
    if (max_val == min_val) return min_val;
    return min_val + (val % (max_val - min_val + 1));
}

// Consume a double
static cmsFloat64Number FuzzerConsumeDouble(FuzzerDataInput* fdi) {
