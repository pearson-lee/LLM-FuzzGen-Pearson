                }
            }

            plugin_fuzzed_ptr->Magic = cmsPluginMagicNumber;
            plugin_fuzzed_ptr->ExpectedVersion = LCMS_VERSION;

            cmsBool plugin_registered = cmsPluginTHR(ctx, plugin_fuzzed_ptr); // Use THR version

            if (!plugin_registered) {
                // If plugin registration failed, lcms won't manage its memory.
                // We must free it ourselves using the same context-aware allocator.
                _cmsFree(ctx, plugin_fuzzed_ptr);
            }
            // If plugin_registered is TRUE, cmsUnregisterPluginsTHR(ctx) will handle the deallocation.
        }
    }

    cmsUnregisterPluginsTHR(ctx); // Use THR version
    cmsDeleteContext(ctx);

    return 0;
}[0m
