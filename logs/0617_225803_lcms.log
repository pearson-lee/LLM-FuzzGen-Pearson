    int num_available_profiles = 0;
    if (hProfileFromData && num_available_profiles < MAX_PROFILES_IN_ARRAY) available_profiles[num_available_profiles++] = hProfileFromData;
    if (srgb_profile && num_available_profiles < MAX_PROFILES_IN_ARRAY) available_profiles[num_available_profiles++] = srgb_profile;
    if (lab_profile && num_available_profiles < MAX_PROFILES_IN_ARRAY) available_profiles[num_available_profiles++] = lab_profile;

    if (hProfileFromData) {
        cmsInfoType info_type_vals[] = {cmsInfoDescription, cmsInfoManufacturer, cmsInfoModel, cmsInfoCopyright};
        cmsInfoType info_type = info_type_vals[consume_u8(&consumer, 0) % (sizeof(info_type_vals)/sizeof(info_type_vals[0]))];
        
        char lang_code[3]; 
