    if (profile_data_ptr && profile_data_size > 0) {
        // Create an IO handler from the fuzzer data
        ioh = cmsOpenIOhandlerFromMem(context_id, (void*)profile_data_ptr, profile_data_size, "r");
        if (ioh) {
            cmsBool write_mode_for_open = consume_bool(&consumer);
            // Attempt to open the profile
            hProfileFromData = cmsOpenProfileFromIOhandler2THR(context_id, ioh, write_mode_for_open);
            // IO handler is closed by cmsCloseProfile if profile is opened, 
            // or needs to be closed manually if cmsOpenProfileFromIOhandler2THR fails but ioh was created.
            // cmsOpenProfileFromIOhandler2THR takes ownership of ioh on success.
            // If it fails and returns NULL, ioh must be closed.
            if (!hProfileFromData) {
                 cmsCloseIOhandler(ioh); // Close ioh if profile opening failed
                 ioh = NULL;
            }
        }
    }
    
    // Create some standard profiles for use in arrays
    cmsHPROFILE srgb_profile = cmsCreate_sRGBProfileTHR(context_id);
    cmsHPROFILE lab_profile = cmsCreateLab4ProfileTHR(context_id, NULL);

    cmsHPROFILE available_profiles[3];
    int num_available_profiles = 0;
    if (hProfileFromData) available_profiles[num_available_profiles++] = hProfileFromData;
    if (srgb_profile && num_available_profiles < 3) available_profiles[num_available_profiles++] = srgb_profile; // check num_available_profiles
    if (lab_profile && num_available_profiles < 3) available_profiles[num_available_profiles++] = lab_profile;


    // 2. cmsGetProfileInfo
    if (hProfileFromData) {
        cmsInfoType info_type_vals[] = {cmsInfoDescription, cmsInfoManufacturer, cmsInfoModel, cmsInfoCopyright};
        cmsInfoType info_type = info_type_vals[consume_u8(&consumer, 0) % (sizeof(info_type_vals)/sizeof(info_type_vals[0]))];
        
        char lang_code[3]; // For 2 chars + null
        char country_code[3]; // For 2 chars + null
        consume_lang_country_code(&consumer, lang_code, sizeof(lang_code));
        consume_lang_country_code(&consumer, country_code, sizeof(country_code));

        wchar_t info_buffer[INFO_BUFFER_WCHARS];
        memset(info_buffer, 0, sizeof(info_buffer));
        cmsGetProfileInfo(hProfileFromData, info_type, lang_code, country_code, info_buffer, INFO_BUFFER_WCHARS);
    }

    // 3. cmsFormatterForPCSOfProfile
    if (hProfileFromData) {
        cmsUInt32Number bytes_formatter = consume_u8(&consumer, 2) == 0 ? 1 : (consume_u8(&consumer, 0) % 2 == 0 ? 2 : 4); // 1, 2 or 4
        cmsBool is_float_formatter = consume_bool(&consumer);
        cmsFormatterForPCSOfProfile(hProfileFromData, bytes_formatter, is_float_formatter);
    }

    // 4. _cmsDefaultICCintents
    cmsUInt32Number n_profiles_for_intents = (consume_u8(&consumer, 0) % MAX_PROFILES_IN_ARRAY) + 1;
    if (num_available_profiles > 0 && n_profiles_for_intents > 0 && n_profiles_for_intents <= MAX_PROFILES_IN_ARRAY) { // check n_profiles_for_intents <= num_available_profiles if it matters
        cmsHPROFILE         hProfiles_intents[MAX_PROFILES_IN_ARRAY];
        cmsUInt32Number     InputProfileTypes_intents[MAX_PROFILES_IN_ARRAY];
        cmsBool             BPC_intents[MAX_PROFILES_IN_ARRAY];
        cmsFloat64Number    AdaptationStates_intents[MAX_PROFILES_IN_ARRAY];

        for (cmsUInt32Number i = 0; i < n_profiles_for_intents; ++i) {
            hProfiles_intents[i] = available_profiles[consume_u8(&consumer, 0) % num_available_profiles];
            InputProfileTypes_intents[i] = consume_u32(&consumer, cmsSigRgbData);
            BPC_intents[i] = consume_bool(&consumer);
            AdaptationStates_intents[i] = consume_double(&consumer, 1.0);
        }
        cmsUInt32Number default_intent = consume_u32(&consumer, INTENT_PERCEPTUAL) % 4; // Common intents 0-3

        cmsPipeline* pipeline = _cmsDefaultICCintents(context_id, n_profiles_for_intents,
