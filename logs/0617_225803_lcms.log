    }

    if (hProfileFromData) {
        cmsUInt32Number bytes_formatter = consume_u8(&consumer, 2) == 0 ? 1 : (consume_u8(&consumer, 0) % 2 == 0 ? 2 : 4); 
        cmsBool is_float_formatter = consume_bool(&consumer);
        cmsFormatterForPCSOfProfile(hProfileFromData, bytes_formatter, is_float_formatter);
    }

    cmsUInt32Number n_profiles_for_intents = (consume_u8(&consumer, 0) % MAX_PROFILES_IN_ARRAY);
    if (n_profiles_for_intents == 0 && num_available_profiles > 0) { 
        n_profiles_for_intents = 1;
    } else if (n_profiles_for_intents > num_available_profiles) { 
        n_profiles_for_intents = num_available_profiles;
    }


    if (num_available_profiles > 0 && n_profiles_for_intents > 0 ) { 
        cmsHPROFILE         hProfiles_intents[MAX_PROFILES_IN_ARRAY];
        cmsUInt32Number     ActualIntents_for_pipeline[MAX_PROFILES_IN_ARRAY]; // Coverage: Corrected type for intents
        cmsBool             BPC_intents[MAX_PROFILES_IN_ARRAY];
        cmsFloat64Number    AdaptationStates_intents[MAX_PROFILES_IN_ARRAY];
        cmsUInt32Number     dwPipelineFlags = 0; // Coverage: Added flags for pipeline creation

        for (cmsUInt32Number i = 0; i < n_profiles_for_intents; ++i) {
            hProfiles_intents[i] = available_profiles[consume_u8(&consumer, 0) % num_available_profiles];
            ActualIntents_for_pipeline[i] = consume_u8(&consumer, 0) % 4; // Coverage: Populate with valid intents (0-3)
            BPC_intents[i] = consume_bool(&consumer);
            AdaptationStates_intents[i] = consume_double(&consumer, 1.0);
        }
        
        // Coverage: Consume flags for _cmsDefaultICCintents
        if (consume_bool(&consumer)) dwPipelineFlags |= cmsFLAGS_BLACKPOINTCOMPENSATION;
        if (consume_bool(&consumer)) dwPipelineFlags |= cmsFLAGS_HIGHRESPRECALC;
        if (consume_bool(&consumer)) dwPipelineFlags |= cmsFLAGS_LOWRESPRECALC;


