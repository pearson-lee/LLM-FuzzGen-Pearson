// Helper function to create a dummy cmsHPROFILE for testing
// Manages its own resources if profile creation involves intermediate objects.
cmsHPROFILE CreateDummyProfile(cmsContext ctx, FuzzedDataProvider& fdp) {
    if (ctx == nullptr) {
        return nullptr;
    }

    cmsHPROFILE profile = nullptr;
    // Choose one of several ways to create a profile
    int choice = fdp.ConsumeIntegralInRange<int>(0, 3);
    switch (choice) {
        case 0:
            // Create a simple placeholder profile
            profile = cmsCreateProfilePlaceholder(ctx);
            break;
        case 1:
            // Create a standard sRGB profile
            profile = cmsCreate_sRGBProfile(ctx);
            break;
        case 2:
            // Create a Lab profile (e.g., D50-based Lab)
            // Using cmsCreateLab4Profile for a 4-channel Lab profile (includes alpha)
            // or cmsCreateLab2Profile for a 2-channel L*a* (no b*) - less common.
            // cmsCreateLab4Profile(NULL) uses default D50 whitepoint.
            profile = cmsCreateLab4Profile(ctx, nullptr); 
            break;
        case 3:
            {
                // Create a Gray profile with a fuzzed gamma
                // Gamma value should be positive.
                cmsToneCurve* gammaCurve = cmsBuildGamma(ctx, fdp.ConsumeFloatingPointInRange<double>(0.1, 3.0));
                if (gammaCurve) {
                    // Use D50 white point for consistency
                    profile = cmsCreateGrayProfile(ctx, cmsD50_xyY(), gammaCurve);
                    // cmsCreateGrayProfile duplicates the curve, so we must free the one we built.
                    cmsFreeToneCurve(ctx, gammaCurve);
                } else {
                    // Fallback if gamma curve creation fails
                    profile = cmsCreateProfilePlaceholder(ctx);
                }
            }
            break;
        default:
            // Default to a placeholder
            profile = cmsCreateProfilePlaceholder(ctx);
            break;
    }
    return profile; // The caller is responsible for calling cmsCloseProfile on this
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a context for lcms operations. This context must be deleted at the end.
    cmsContext ctx = cmsCreateContext(nullptr, nullptr);
    if (!ctx) {
        return 0; // Cannot proceed without a context
    }

    // API 1: _cmsBuildKToneCurve
    // This is an internal API, requires lcms2_internal.h
    // Signature: cmsToneCurve * _cmsBuildKToneCurve(cmsContext ContextID, cmsUInt32Number nGridPoints, 
    //                                              cmsUInt32Number nProfiles, const cmsUInt32Number Tab[], 
    //                                              const cmsHPROFILE hProfiles[], const cmsBool IsStep[], 
    //                                              const cmsFloat64Number Gammas[], cmsUInt32Number Intent)
    if (fdp.remaining_bytes() > 100 && fdp.ConsumeBool()) { 
        cmsUInt32Number nGridPoints = fdp.ConsumeIntegralInRange<cmsUInt32Number>(2, 20); // Must be >= 2
        cmsUInt32Number nProfiles = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 3);   // Must be > 0

        std::vector<cmsUInt32Number> tab(nProfiles);
        std::vector<cmsHPROFILE> hProfilesVec(nProfiles, nullptr); // Initialize with nullptr
        std::vector<cmsBool> isStep(nProfiles);
        std::vector<cmsFloat64Number> gammas(nProfiles);
        bool profiles_ok = true;

        for (cmsUInt32Number i = 0; i < nProfiles; ++i) {
            // Tab elements are indices into hProfiles, so must be < nProfiles
            tab[i] = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, nProfiles - 1);
            
            hProfilesVec[i] = CreateDummyProfile(ctx, fdp);
            if (!hProfilesVec[i]) {
                profiles_ok = false;
                // Clean up already created profiles in this scope before breaking
                for (cmsUInt32Number j = 0; j < i; ++j) {
                    if (hProfilesVec[j]) {
                        cmsCloseProfile(ctx, hProfilesVec[j]);
                        hProfilesVec[j] = nullptr; // Avoid double free in outer loop
                    }
                }
                // Ensure remaining pointers in hProfilesVec are also null
                for (cmsUInt32Number j = i; j < nProfiles; ++j) {
                    hProfilesVec[j] = nullptr;
                }
                break; 
            }
            isStep[i] = fdp.ConsumeBool();
            gammas[i] = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        }

        if (profiles_ok) { // profiles_ok remains true only if all CreateDummyProfile succeeded
            cmsUInt32Number intent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3); // Standard intents
            cmsToneCurve *toneCurve = _cmsBuildKToneCurve(ctx, nGridPoints, nProfiles,
                                                          tab.data(), hProfilesVec.data(),
                                                          isStep.data(), gammas.data(), intent);
            if (toneCurve) {
                // The created toneCurve must be freed
                cmsFreeToneCurve(ctx, toneCurve);
            }
        }
        // Clean up all profiles created for this API call (those not cleaned during error)
        for (cmsHPROFILE hProf : hProfilesVec) {
            if (hProf) cmsCloseProfile(ctx, hProf);
        }
    }

    // API 2: _cmsStageAllocLabPrelin
    // This is an internal API, requires lcms2_internal.h
    // Signature: cmsStage* _cmsStageAllocLabPrelin(cmsContext ContextID)
    if (fdp.ConsumeBool()) {
        cmsStage *stage = _cmsStageAllocLabPrelin(ctx);
        if (stage) {
            // The allocated stage must be freed
            cmsStageFree(ctx, stage);
        }
    }

    // API 3: cmsCreateProofingTransform
    // Signature: cmsHTRANSFORM cmsCreateProofingTransform(cmsContext ContextID, 
    //                                                     cmsHPROFILE InputProfile, cmsUInt32Number InputFormat, 
    //                                                     cmsHPROFILE OutputProfile, cmsUInt32Number OutputFormat, 
    //                                                     cmsHPROFILE ProofingProfile, cmsUInt32Number nIntent, 
    //                                                     cmsUInt32Number ProofingIntent, cmsUInt32Number dwFlags)
    if (fdp.remaining_bytes() > 50 && fdp.ConsumeBool()) {
        cmsHPROFILE hInput = CreateDummyProfile(ctx, fdp);
        cmsHPROFILE hOutput = CreateDummyProfile(ctx, fdp);
        cmsHPROFILE hProof = CreateDummyProfile(ctx, fdp);

        if (hInput && hOutput && hProof) {
            // Select from a list of valid pixel formats
            std::vector<cmsUInt32Number> validFormats = {
                TYPE_GRAY_8, TYPE_GRAY_16, TYPE_RGB_8, TYPE_RGB_16, 
                TYPE_CMYK_8, TYPE_CMYK_16, TYPE_Lab_8, TYPE_Lab_DBL,
                TYPE_GRAYA_8, TYPE_RGBA_8, TYPE_CMYKA_8 // Alpha variants
            };
            cmsUInt32Number inputFormat = validFormats[fdp.ConsumeIntegralInRange<size_t>(0, validFormats.size() - 1)];
            cmsUInt32Number outputFormat = validFormats[fdp.ConsumeIntegralInRange<size_t>(0, validFormats.size() - 1)];
            
            cmsUInt32Number intent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3); // INTENT_PERCEPTUAL, etc.
            cmsUInt32Number proofIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
            
            // Fuzz flags, but mask with known valid flags to increase relevance
            cmsUInt32Number dwFlags = fdp.ConsumeIntegral<cmsUInt32Number>() & 
                                      (cmsFLAGS_BLACKPOINTCOMPENSATION | cmsFLAGS_HIGHRESPRECALC |
                                       cmsFLAGS_LOWRESPRECALC | cmsFLAGS_GAMUTCHECK |
                                       cmsFLAGS_SOFTPROOFING | cmsFLAGS_NOOPTIMIZE | 
                                       cmsFLAGS_NULLTRANSFORM | cmsFLAGS_COPY_ALPHA |
                                       cmsFLAGS_KEEP_SEQUENCE); // Added another valid flag

            cmsHTRANSFORM transform = cmsCreateProofingTransform(ctx, hInput, inputFormat,
                                                                 hOutput, outputFormat,
                                                                 hProof, intent, proofIntent, dwFlags);
            if (transform) {
                // The created transform must be deleted
                cmsDeleteTransform(ctx, transform);
            }
        }
        // Clean up profiles
        if (hInput) cmsCloseProfile(ctx, hInput);
        if (hOutput) cmsCloseProfile(ctx, hOutput);
        if (hProof) cmsCloseProfile(ctx, hProof);
    }

    // API 4: cmsIT8EnumPropertyMulti
    // Signature: cmsUInt32Number cmsIT8EnumPropertyMulti(cmsHANDLE hIT8, 
    //                                                    const char *PropertyName, 
    //                                                    const char ***SubpropertyNames)
    if (fdp.remaining_bytes() > 20 && fdp.ConsumeBool()) {
        cmsHANDLE hIT8 = cmsIT8Alloc(ctx); // Create IT8 handle
        if (hIT8) {
            std::string propertyNameStr = fdp.ConsumeRandomLengthString(30);
            // Optionally use known property names sometimes
            if (fdp.ConsumeBool()) {
                 std::vector<std::string> knownProps = {"NUMBER_OF_FIELDS", "NUMBER_OF_SETS", "ORIGINATOR", "MANUFACTURER", "PROD_DATE", "DESCRIPTOR", "COLORANT_TABLE"};
                 if (!knownProps.empty()) {
                    propertyNameStr = knownProps[fdp.ConsumeIntegralInRange<size_t>(0, knownProps.size()-1)];
                 }
            }

            const char **subpropertyNames = nullptr;
            // cmsIT8EnumPropertyMulti implicitly uses the context from hIT8 for allocations
            /* cmsUInt32Number count = */ cmsIT8EnumPropertyMulti(hIT8, propertyNameStr.c_str(), &subpropertyNames);
            
            if (subpropertyNames) {
                // The list of names is allocated by the engine and must be freed by the user.
                // cmsIT8FreePropertyList is the correct function, it takes a context.
                cmsIT8FreePropertyList(ctx, subpropertyNames);
            }
            // The IT8 handle must be freed
            cmsIT8Free(ctx, hIT8);
        }
    }
    
    // API 5: cmsPlugin
    // Signature: cmsBool cmsPlugin(void* Plugin)
    // This function registers plugins globally.
    // To do this safely with fuzzing, allocate plugin memory with cmsMalloc,
    // so cmsUnregisterPlugins can free it correctly.
    if (fdp.ConsumeBool() && fdp.remaining_bytes() >= 16 ) { // Ensure some data for plugin
        cmsPluginBase* plugin_fuzzed_ptr = (cmsPluginBase*)cmsMalloc(ctx, sizeof(cmsPluginBase));
        if (plugin_fuzzed_ptr) {
            // Initialize with fuzzed data. Consume up to sizeof(cmsPluginBase).
            size_t bytes_to_consume = std::min(fdp.remaining_bytes(), sizeof(cmsPluginBase));
            std::vector<uint8_t> plugin_data_vec = fdp.ConsumeBytes<uint8_t>(bytes_to_consume);
            
            if (!plugin_data_vec.empty()) {
                 memcpy(plugin_fuzzed_ptr, plugin_data_vec.data(), plugin_data_vec.size());
            }
            // Zero out the rest if not fully covered by fuzzed data
            if (bytes_to_consume < sizeof(cmsPluginBase)) {
                memset((uint8_t*)plugin_fuzzed_ptr + bytes_to_consume, 0, sizeof(cmsPluginBase) - bytes_to_consume);
            }

            // Set essential fields to valid values to pass initial checks in cmsPlugin
            plugin_fuzzed_ptr->Magic = cmsPluginMagicNumber;
            plugin_fuzzed_ptr->ExpectedVersion = LCMS_VERSION; 
            // plugin_fuzzed_ptr->Type is fuzzed by memcpy/memset.
            // plugin_fuzzed_ptr->Next is also fuzzed. cmsPlugin prepends to a global list,
            // so the initial value of Next in the passed struct is not critical for linking.

            cmsPlugin(plugin_fuzzed_ptr);
            // This plugin is added to the global list.
            // cmsUnregisterPlugins() called at the end will attempt to free it using _cmsFree.
        }
        // If cmsMalloc fails, plugin_fuzzed_ptr is NULL, and we do nothing, which is safe.
    }

    // Unregister any globally registered plugins via cmsPlugin.
    // This is important to clean up memory allocated by cmsMalloc for plugins
    // and to reset global state for subsequent fuzz inputs if the fuzzer runs in a persistent process.
    cmsUnregisterPlugins();

    // Delete the lcms context, freeing all associated resources.
    cmsDeleteContext(ctx);

    return 0;
}[0m
