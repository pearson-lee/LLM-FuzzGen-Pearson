                } else {
                     cmsUInt32Number output_bytes_per_comp_tr;
                     if (T_BYTES(output_fmt_tr) != 0) output_bytes_per_comp_tr = T_BYTES(output_fmt_tr);
                     else output_bytes_per_comp_tr = T_FLOAT(output_fmt_tr) ? sizeof(cmsFloat32Number) : sizeof(cmsFloat64Number);
                     cmsUInt32Number output_total_comps_tr = T_CHANNELS(output_fmt_tr) + T_EXTRA(output_fmt_tr);
                     size_t output_pixel_stride_tr = output_total_comps_tr * output_bytes_per_comp_tr;

