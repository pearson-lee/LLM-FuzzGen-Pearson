        cmsHPROFILE hOutProfile_tr = available_profiles[consume_u8(&consumer, 0) % num_available_profiles];

        cmsUInt32Number input_fmt_tr;
        cmsUInt32Number output_fmt_tr;
        cmsUInt32Number transform_flags_tr = 0;

        cmsBool use_copy_alpha_tr = consume_bool(&consumer);
        if (use_copy_alpha_tr) {
            transform_flags_tr |= cmsFLAGS_COPY_ALPHA; 
        }

        input_fmt_tr = (consume_bool(&consumer)) ? TYPE_RGBA_8 : TYPE_RGB_8;
        output_fmt_tr = (consume_bool(&consumer)) ? TYPE_RGBA_8 : TYPE_RGB_8;

