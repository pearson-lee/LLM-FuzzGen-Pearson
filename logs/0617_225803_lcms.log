// Helper structure to manage fuzzer input
typedef struct {
    const uint8_t *data;
    size_t size;
    size_t offset;
} FuzzerDataInput;

// Initialize FuzzerDataInput
static void FuzzerDataInit(FuzzerDataInput* fdi, const uint8_t* data, size_t size) {
    fdi->data = data;
    fdi->size = size;
    fdi->offset = 0;
}

// Check if enough data is remaining
static cmsBool FuzzerDataHasBytes(FuzzerDataInput* fdi, size_t num_bytes) {
    return (fdi->offset + num_bytes <= fdi->size && num_bytes > 0); // Ensure num_bytes > 0 to avoid issues with 0-byte checks
}

// Consume a block of bytes. Returns pointer to data, or NULL if not enough.
// The caller should not free this pointer as it points into the original Data.
static const void* FuzzerConsumeBytes(FuzzerDataInput* fdi, size_t num_bytes) {
    if (num_bytes == 0) return NULL; // Consume 0 bytes is a no-op, return NULL to signify no data block
    if (!FuzzerDataHasBytes(fdi, num_bytes)) {
        return NULL;
    }
    const void* ptr = fdi->data + fdi->offset;
    fdi->offset += num_bytes;
    return ptr;
}

// Consume an arbitrary type. Returns 1 on success, 0 on failure.
// If consumption fails, target is zeroed.
static cmsBool FuzzerConsumeType(FuzzerDataInput* fdi, void* target, size_t type_size) {
    if (type_size == 0) return 0; // Cannot consume 0 bytes into a type
    const void* ptr = FuzzerConsumeBytes(fdi, type_size);
    if (ptr) {
        memcpy(target, ptr, type_size);
        return 1;
    }
    memset(target, 0, type_size); // Zero out if consumption failed
    return 0;
}

// Consume a boolean value (0 or 1)
static cmsBool FuzzerConsumeBool(FuzzerDataInput* fdi) {
    uint8_t val;
    if (FuzzerConsumeType(fdi, &val, sizeof(val))) {
        return val % 2;
    }
    return 0; // Default to false
}

// Consume a an unsigned 32-bit integer
static cmsUInt32Number FuzzerConsumeUint32(FuzzerDataInput* fdi) {
    cmsUInt32Number val;
    FuzzerConsumeType(fdi, &val, sizeof(val)); // Defaults to 0 if not enough data
    return val;
}

// Consume a an unsigned 32-bit integer within a specific range (modulo arithmetic)
static cmsUInt32Number FuzzerConsumeUint32InRange(FuzzerDataInput* fdi, cmsUInt32Number min_val, cmsUInt32Number max_val) {
    cmsUInt32Number val = FuzzerConsumeUint32(fdi);
    if (min_val > max_val) { 
        cmsUInt32Number temp = min_val;
        min_val = max_val;
        max_val = temp;
    }
    if (max_val == min_val) return min_val;
    return min_val + (val % (max_val - min_val + 1));
}

// Consume a double
static cmsFloat64Number FuzzerConsumeDouble(FuzzerDataInput* fdi) {
    cmsFloat64Number val;
    if (FuzzerConsumeType(fdi, &val, sizeof(val))) {
        return val;
    }
    return 0.0;
}

// Consume a string (null-terminated from fuzzer data, or up to max_len_hint).
// Result must be freed by the caller. Produces an empty string "" if no data or max_len_hint is 0.
static char* FuzzerConsumeString(FuzzerDataInput* fdi, size_t max_len_hint) {
    size_t remaining_data = (fdi->size > fdi->offset) ? (fdi->size - fdi->offset) : 0;
    size_t actual_max_len = (max_len_hint < remaining_data) ? max_len_hint : remaining_data;

    const char* start_ptr = (const char*)(fdi->data + fdi->offset);
    size_t len = 0;
    for (len = 0; len < actual_max_len; ++len) {
        if (start_ptr[len] == '\0') {
            break;
        }
    }

    char* str = (char*)malloc(len + 1);
    if (!str) { // Malloc failure
        // Attempt to advance offset even if malloc fails, to avoid infinite loops on OOM
        if (len < actual_max_len) fdi->offset += (len + 1);
        else fdi->offset += actual_max_len;
        if (fdi->offset > fdi->size) fdi->offset = fdi->size; // Cap offset
        return NULL; 
    }
    
    memcpy(str, start_ptr, len);
    str[len] = '\0';
    
    if (len < actual_max_len) { // Found null terminator at index len
        fdi->offset += (len + 1);
    } else { // Did not find null terminator, consumed actual_max_len bytes
        fdi->offset += actual_max_len; 
    }
    if (fdi->offset > fdi->size) fdi->offset = fdi->size; // Cap offset

    return str;
}

