        }

        input_fmt_tr = (consume_bool(&consumer)) ? TYPE_RGBA_8 : TYPE_RGB_8;
        output_fmt_tr = (consume_bool(&consumer)) ? TYPE_RGBA_8 : TYPE_RGB_8;

        cmsBool set_same_format_tr = consume_bool(&consumer);
        cmsBool set_different_extra_tr = consume_bool(&consumer);
        cmsBool set_zero_extra_in_tr = consume_bool(&consumer);

        if (use_copy_alpha_tr) { // These conditions are only relevant if COPY_ALPHA is attempted
            if (set_zero_extra_in_tr) { // Target: if (nExtra == 0) in _cmsHandleExtraChannels
                input_fmt_tr = TYPE_RGB_8; 
                if (T_EXTRA(output_fmt_tr) != 0) output_fmt_tr = TYPE_RGB_8;
            } else if (set_different_extra_tr) { // Target: if (nExtra != T_EXTRA(p->OutputFormat))
                input_fmt_tr = TYPE_RGBA_8; 
                output_fmt_tr = TYPE_RGB_8;  
            }
        }
        
        cmsBool in_place_transform_tr = consume_bool(&consumer);
