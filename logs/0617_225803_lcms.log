        cmsCloseProfile(hProfileFromData); // This also closes ioh if it was successfully used
        hProfileFromData = NULL;
    } else if (ioh) {
        // This case handles if ioh was created but cmsOpenProfileFromIOhandler2THR failed
        // and did not take ownership or close ioh.
        cmsCloseIOhandler(ioh);
        ioh = NULL;
    }


    if (srgb_profile) {
        cmsCloseProfile(srgb_profile);
    }
    if (lab_profile) {
        cmsCloseProfile(lab_profile);
    }
    if (context_id) {
        cmsDeleteContext(context_id);
    }

    return 0;
}

