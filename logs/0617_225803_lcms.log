        cmsBool* is_monotonic_array_api4 = NULL;
        if (nProfiles_api4 > 0 && FuzzerDataHasBytes(&fdi, nProfiles_api4 * sizeof(cmsBool))) {
            is_monotonic_array_api4 = (cmsBool*)malloc(nProfiles_api4 * sizeof(cmsBool));
            if (is_monotonic_array_api4) {
                for (cmsUInt32Number i = 0; i < nProfiles_api4; ++i) {
                    is_monotonic_array_api4[i] = FuzzerConsumeBool(&fdi);
                }
            }
        }
        
        cmsFloat64Number* lstar_points_array_api4 = NULL;
        if (nPoints_api4 > 0 && FuzzerDataHasBytes(&fdi, nPoints_api4 * sizeof(cmsFloat64Number))) {
