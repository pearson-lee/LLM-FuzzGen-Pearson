        cmsUInt32Number nProfiles_api4 = FuzzerConsumeUint32InRange(&fdi, 0, MAX_PROFILE_ELEMENTS);

        cmsUInt32Number* gamut_table_api4 = NULL;
        if (nProfiles_api4 > 0) {
            size_t gamut_table_num_elements = nProfiles_api4 * 4; // Example factor for table size.
            if (gamut_table_num_elements > 0 && FuzzerDataHasBytes(&fdi, gamut_table_num_elements * sizeof(cmsUInt32Number))) {
                gamut_table_api4 = (cmsUInt32Number*)malloc(gamut_table_num_elements * sizeof(cmsUInt32Number));
                if (gamut_table_api4) {
