        cmsBool close_profile_for_api2_separately = 0; // CMSFALSE

        if (!profile_for_api2) { // If API 1 failed or created NULL profile
            if (FuzzerConsumeBool(&fdi)) { // Randomly decide to create a placeholder profile.
                 profile_for_api2 = cmsCreateProfilePlaceholder(ctx);
