            if (api1_profile_size > (fdi.size - (fdi.offset))) {
                api1_profile_size = (fdi.size > fdi.offset) ? (fdi.size - fdi.offset) : 0;
            }
        } else { // Not enough data for size, use all remaining data as profile.
            api1_profile_size = (fdi.size > fdi.offset) ? (fdi.size - fdi.offset) : 0;
        }
        
        const void* api1_profile_data = FuzzerConsumeBytes(&fdi, api1_profile_size);
