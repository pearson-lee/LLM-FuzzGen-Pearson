#include <stdint.h>
#include <stddef.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>   // For INFINITY, NAN and isnan
#include <ctype.h>  // For isalnum

// LCMS includes with project-relative paths
#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/include/lcms2_plugin.h" // For _cmsDefaultICCintents
#include "/src/lcms/src/lcms2_internal.h"   // For _cmsChain2Lab

// Helper structure to manage fuzzer data
typedef struct {
    const uint8_t *ptr;
    size_t remaining;
} FuzzDataConsumer;

// Initialize the consumer
static void init_fuzz_data_consumer(FuzzDataConsumer* consumer, const uint8_t* data, size_t size) {
    consumer->ptr = data;
    consumer->remaining = size;
}

// Consume a block of data
static const uint8_t* consume_bytes(FuzzDataConsumer* consumer, size_t count) {
    if (consumer->remaining < count) {
        return NULL;
    }
    const uint8_t* current_ptr = consumer->ptr;
    consumer->ptr += count;
    consumer->remaining -= count;
    return current_ptr;
}

// Consume a single byte (uint8_t)
static uint8_t consume_u8(FuzzDataConsumer* consumer, uint8_t default_val) {
    const uint8_t* byte_ptr = consume_bytes(consumer, sizeof(uint8_t));
    return byte_ptr ? *byte_ptr : default_val;
}

// Consume a boolean
static cmsBool consume_bool(FuzzDataConsumer* consumer) {
    return (consume_u8(consumer, 0) % 2) == 1;
}

// Consume a uint32_t
static cmsUInt32Number consume_u32(FuzzDataConsumer* consumer, cmsUInt32Number default_val) {
    const uint8_t* bytes_ptr = consume_bytes(consumer, sizeof(cmsUInt32Number));
    if (!bytes_ptr) return default_val;
    cmsUInt32Number val;
    memcpy(&val, bytes_ptr, sizeof(cmsUInt32Number));
    return val;
}

// Consume a double, ensuring it's a finite number
static double consume_double(FuzzDataConsumer* consumer, double default_val) {
    const uint8_t* bytes_ptr = consume_bytes(consumer, sizeof(double));
    if (!bytes_ptr) return default_val;
    double val;
    memcpy(&val, bytes_ptr, sizeof(double));
    if (isnan(val) || isinf(val)) {
        return default_val;
    }
    return val;
}

// Consume a short string (e.g., for Lang/Country codes)
// Buffer should be at least 3 chars for lang/country codes like "en", "US" + null.
// Max length consumed is buffer_len - 1.
static void consume_lang_country_code(FuzzDataConsumer* consumer, char* buffer, size_t buffer_len) {
    if (buffer_len == 0) return;
    
    size_t max_consume_len = buffer_len - 1;
    size_t consume_len = consume_u8(consumer, 0) % max_consume_len;
    
    if (consumer->remaining < consume_len) {
        consume_len = consumer->remaining;
    }

    const uint8_t* str_data = consume_bytes(consumer, consume_len);
    if (str_data) {
        memcpy(buffer, str_data, consume_len);
    } else {
        consume_len = 0; 
    }
    
    // Sanitize to be 2 alphabetic characters, or empty if not possible
    if (consume_len >= 2) {
        buffer[0] = isalpha(buffer[0]) ? buffer[0] : 'e';
        buffer[1] = isalpha(buffer[1]) ? buffer[1] : 'n';
        buffer[2] = '\0';
    } else if (consume_len == 1) {
        buffer[0] = isalpha(buffer[0]) ? buffer[0] : 'e';
        buffer[1] = '\0';
    } else {
         buffer[0] = '\0'; // Empty string
    }
}


#define MAX_PROFILE_DATA_SIZE (1024 * 16) // Limit profile data size to 16KB
#define INFO_BUFFER_WCHARS 64
#define MAX_PROFILES_IN_ARRAY 3 // Max profiles in arrays for _cmsDefaultICCintents and _cmsChain2Lab

// Entry point for LibFuzzer
int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzDataConsumer consumer;
    init_fuzz_data_consumer(&consumer, Data, Size);

    // Create a context (required by most lcms functions)
    cmsContext context_id = cmsCreateContext(NULL, NULL);
    if (!context_id) {
        return 0; // Cannot proceed without a context
    }

    cmsHPROFILE hProfileFromData = NULL;
    cmsIOHANDLER* ioh = NULL;

    // 1. cmsOpenProfileFromIOhandler2THR
    // Consume data for the profile
    cmsUInt32Number profile_data_size = consume_u32(&consumer, 0) % MAX_PROFILE_DATA_SIZE;
    if (profile_data_size > consumer.remaining) {
        profile_data_size = consumer.remaining;
    }
    const uint8_t* profile_data_ptr = consume_bytes(&consumer, profile_data_size);

    if (profile_data_ptr && profile_data_size > 0) {
        // Create an IO handler from the fuzzer data
        ioh = cmsOpenIOhandlerFromMem(context_id, (void*)profile_data_ptr, profile_data_size, 'r');
        if (ioh) {
            cmsBool write_mode_for_open = consume_bool(&consumer);
            // Attempt to open the profile
            hProfileFromData = cmsOpenProfileFromIOhandler2THR(context_id, ioh, write_mode_for_open);
            // IO handler is closed by cmsCloseProfile if profile is opened, 
            // or needs to be closed manually if cmsOpenProfileFromIOhandler2THR fails but ioh was created.
            // cmsOpenProfileFromIOhandler2THR takes ownership of ioh on success.
            // If it fails and returns NULL, ioh must be closed.
            if (!hProfileFromData) {
                 cmsCloseIOhandler(ioh); // Close ioh if profile opening failed
                 ioh = NULL;
            }
        }
    }
    
    // Create some standard profiles for use in arrays
    cmsHPROFILE srgb_profile = cmsCreate_sRGBProfileTHR(context_id);
    cmsHPROFILE lab_profile = cmsCreateLab4ProfileTHR(context_id, NULL);

    cmsHPROFILE available_profiles[3];
    int num_available_profiles = 0;
    if (hProfileFromData) available_profiles[num_available_profiles++] = hProfileFromData;
    if (srgb_profile) available_profiles[num_available_profiles++] = srgb_profile;
    if (lab_profile && num_available_profiles < 3) available_profiles[num_available_profiles++] = lab_profile;


    // 2. cmsGetProfileInfo
    if (hProfileFromData) {
        cmsInfoType info_type_vals[] = {cmsInfoDescription, cmsInfoManufacturer, cmsInfoModel, cmsInfoCopyright};
        cmsInfoType info_type = info_type_vals[consume_u8(&consumer, 0) % (sizeof(info_type_vals)/sizeof(info_type_vals[0]))];
        
        char lang_code[3]; // For 2 chars + null
        char country_code[3]; // For 2 chars + null
        consume_lang_country_code(&consumer, lang_code, sizeof(lang_code));
        consume_lang_country_code(&consumer, country_code, sizeof(country_code));

        wchar_t info_buffer[INFO_BUFFER_WCHARS];
        memset(info_buffer, 0, sizeof(info_buffer));
        cmsGetProfileInfo(hProfileFromData, info_type, lang_code, country_code, info_buffer, INFO_BUFFER_WCHARS);
    }

    // 3. cmsFormatterForPCSOfProfile
    if (hProfileFromData) {
        cmsUInt32Number bytes_formatter = consume_u8(&consumer, 2) == 0 ? 1 : (consume_u8(&consumer, 0) % 2 == 0 ? 2 : 4); // 1, 2 or 4
        cmsBool is_float_formatter = consume_bool(&consumer);
        cmsFormatterForPCSOfProfile(hProfileFromData, bytes_formatter, is_float_formatter);
    }

    // 4. _cmsDefaultICCintents
    cmsUInt32Number n_profiles_for_intents = (consume_u8(&consumer, 0) % MAX_PROFILES_IN_ARRAY) + 1;
    if (num_available_profiles > 0 && n_profiles_for_intents > 0 && n_profiles_for_intents <= MAX_PROFILES_IN_ARRAY) {
        cmsHPROFILE         hProfiles_intents[MAX_PROFILES_IN_ARRAY];
        cmsUInt32Number     InputProfileTypes_intents[MAX_PROFILES_IN_ARRAY];
        cmsBool             BPC_intents[MAX_PROFILES_IN_ARRAY];
        cmsFloat64Number    AdaptationStates_intents[MAX_PROFILES_IN_ARRAY];

        for (cmsUInt32Number i = 0; i < n_profiles_for_intents; ++i) {
            hProfiles_intents[i] = available_profiles[consume_u8(&consumer, 0) % num_available_profiles];
            InputProfileTypes_intents[i] = consume_u32(&consumer, cmsSigRgbData);
            BPC_intents[i] = consume_bool(&consumer);
            AdaptationStates_intents[i] = consume_double(&consumer, 1.0);
        }
        cmsUInt32Number default_intent = consume_u32(&consumer, INTENT_PERCEPTUAL) % 4; // Common intents 0-3

        cmsPipeline* pipeline = _cmsDefaultICCintents(context_id, n_profiles_for_intents,
                                                      InputProfileTypes_intents, hProfiles_intents,
                                                      BPC_intents, AdaptationStates_intents, default_intent);
        if (pipeline) {
            cmsPipelineFree(pipeline); // Free the created pipeline
        }
    }

    // 5. _cmsChain2Lab
    cmsUInt32Number n_profiles_for_chain = (consume_u8(&consumer, 0) % MAX_PROFILES_IN_ARRAY) + 1;
    if (num_available_profiles > 0 && n_profiles_for_chain > 0 && n_profiles_for_chain <= MAX_PROFILES_IN_ARRAY) {
        cmsHPROFILE         hProfiles_chain[MAX_PROFILES_IN_ARRAY];
        cmsUInt32Number     Intents_chain[MAX_PROFILES_IN_ARRAY];
        cmsBool             BPC_chain[MAX_PROFILES_IN_ARRAY];
        cmsFloat64Number    AdaptationStates_chain[MAX_PROFILES_IN_ARRAY];

        for (cmsUInt32Number i = 0; i < n_profiles_for_chain; ++i) {
            hProfiles_chain[i] = available_profiles[consume_u8(&consumer, 0) % num_available_profiles];
            Intents_chain[i] = consume_u32(&consumer, INTENT_PERCEPTUAL) % 4;
            BPC_chain[i] = consume_bool(&consumer);
            AdaptationStates_chain[i] = consume_double(&consumer, 1.0);
        }
        cmsUInt32Number input_format_chain = consume_u32(&consumer, TYPE_RGB_8);
        cmsUInt32Number output_format_chain = consume_u32(&consumer, TYPE_Lab_DBL); // Output is Lab
        cmsUInt32Number dw_flags_chain = consume_u32(&consumer, 0);

        cmsHTRANSFORM transform = _cmsChain2Lab(context_id, n_profiles_for_chain,
                                                input_format_chain, output_format_chain,
                                                Intents_chain, hProfiles_chain, BPC_chain,
                                                AdaptationStates_chain, dw_flags_chain);
        if (transform) {
            cmsDeleteTransform(transform); // Free the created transform
        }
    }

    // Cleanup resources
    if (hProfileFromData) {
        cmsCloseProfile(hProfileFromData); // This also closes ioh if it was successfully used
        hProfileFromData = NULL;
    } else if (ioh) {
        // This case handles if ioh was created but cmsOpenProfileFromIOhandler2THR failed
        // and did not take ownership or close ioh.
        cmsCloseIOhandler(ioh);
        ioh = NULL;
    }


    if (srgb_profile) {
        cmsCloseProfile(srgb_profile);
    }
    if (lab_profile) {
        cmsCloseProfile(lab_profile);
    }
    if (context_id) {
        cmsDeleteContext(context_id);
    }

    return 0;
}[0m
