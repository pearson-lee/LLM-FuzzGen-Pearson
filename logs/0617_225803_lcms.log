        }

        cmsUInt32Number intent_tr = consume_u8(&consumer, 0) % 4;

        cmsHTRANSFORM hTransform_tr = cmsCreateTransformTHR(context_id, hInProfile_tr, input_fmt_tr,
                                                           hOutProfile_tr, output_fmt_tr, intent_tr, transform_flags_tr);

        if (hTransform_tr) {
            cmsUInt32Number num_pixels_tr = consume_u8(&consumer, 0) % 9 + 1; 

            #define FUZZ_TRANSFORM_BUFFER_SIZE (cmsMAXCHANNELS * 8 * 10) // Max 16 channels * 8 bytes/comp * 10 pixels
            unsigned char input_buffer_tr[FUZZ_TRANSFORM_BUFFER_SIZE];
            unsigned char output_buffer_tr[FUZZ_TRANSFORM_BUFFER_SIZE]; // Separate output buffer for non-inplace

            cmsUInt32Number input_bytes_per_comp_tr;
            if (T_BYTES(input_fmt_tr) != 0) input_bytes_per_comp_tr = T_BYTES(input_fmt_tr);
            else input_bytes_per_comp_tr = T_FLOAT(input_fmt_tr) ? sizeof(cmsFloat32Number) : sizeof(cmsFloat64Number);
            cmsUInt32Number input_total_comps_tr = T_CHANNELS(input_fmt_tr) + T_EXTRA(input_fmt_tr);
            size_t input_pixel_stride_tr = input_total_comps_tr * input_bytes_per_comp_tr;
            
            if (input_total_comps_tr > 0 && input_bytes_per_comp_tr > 0 && (num_pixels_tr * input_pixel_stride_tr <= FUZZ_TRANSFORM_BUFFER_SIZE)) {
                 for (size_t k = 0; k < num_pixels_tr * input_pixel_stride_tr; ++k) {
