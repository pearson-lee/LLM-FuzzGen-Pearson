// Helper structure to manage fuzzer input
typedef struct {
    const uint8_t *data;
    size_t size;
    size_t offset;
} FuzzerDataInput;

// Initialize FuzzerDataInput
static void FuzzerDataInit(FuzzerDataInput* fdi, const uint8_t* data, size_t size) {
    fdi->data = data;
    fdi->size = size;
    fdi->offset = 0;
}

// Check if enough data is remaining
static cmsBool FuzzerDataHasBytes(FuzzerDataInput* fdi, size_t num_bytes) {
    return (fdi->offset + num_bytes <= fdi->size && num_bytes > 0); 
}

// Consume a block of bytes.
static const void* FuzzerConsumeBytes(FuzzerDataInput* fdi, size_t num_bytes) {
    if (num_bytes == 0) return NULL; 
    if (!FuzzerDataHasBytes(fdi, num_bytes)) {
        return NULL;
    }
    const void* ptr = fdi->data + fdi->offset;
    fdi->offset += num_bytes;
    return ptr;
}

// Consume an arbitrary type.
static cmsBool FuzzerConsumeType(FuzzerDataInput* fdi, void* target, size_t type_size) {
    if (type_size == 0) return 0; 
    const void* ptr = FuzzerConsumeBytes(fdi, type_size);
    if (ptr) {
        memcpy(target, ptr, type_size);
        return 1;
    }
    memset(target, 0, type_size); 
    return 0;
}

// Consume a boolean value
static cmsBool FuzzerConsumeBool(FuzzerDataInput* fdi) {
    uint8_t val;
    if (FuzzerConsumeType(fdi, &val, sizeof(val))) {
        return val % 2;
    }
    return 0; 
}

// Consume an unsigned 32-bit integer
static cmsUInt32Number FuzzerConsumeUint32(FuzzerDataInput* fdi) {
    cmsUInt32Number val;
    FuzzerConsumeType(fdi, &val, sizeof(val)); 
    return val;
}

// Consume an unsigned 32-bit integer within a specific range
static cmsUInt32Number FuzzerConsumeUint32InRange(FuzzerDataInput* fdi, cmsUInt32Number min_val, cmsUInt32Number max_val) {
    cmsUInt32Number val = FuzzerConsumeUint32(fdi);
    if (min_val > max_val) { 
        cmsUInt32Number temp = min_val;
        min_val = max_val;
        max_val = temp;
    }
    if (max_val == min_val) return min_val;
    return min_val + (val % (max_val - min_val + 1));
}

// Consume a double
static cmsFloat64Number FuzzerConsumeDouble(FuzzerDataInput* fdi) {
    cmsFloat64Number val;
    if (FuzzerConsumeType(fdi, &val, sizeof(val))) {
        return val;
    }
    return 0.0;
}

// Consume a string
static char* FuzzerConsumeString(FuzzerDataInput* fdi, size_t max_len_hint) {
    size_t remaining_data = (fdi->size > fdi->offset) ? (fdi->size - fdi->offset) : 0;
    size_t actual_max_len = (max_len_hint < remaining_data) ? max_len_hint : remaining_data;

    const char* start_ptr = (const char*)(fdi->data + fdi->offset);
    size_t len = 0;
    for (len = 0; len < actual_max_len; ++len) {
        if (start_ptr[len] == '\0') {
            break;
        }
    }

    char* str = (char*)malloc(len + 1);
    if (!str) { 
        if (len < actual_max_len) fdi->offset += (len + 1);
        else fdi->offset += actual_max_len;
        if (fdi->offset > fdi->size) fdi->offset = fdi->size; 
        return NULL; 
    }
    
    memcpy(str, start_ptr, len);
    str[len] = '\0';
    
    if (len < actual_max_len) { 
        fdi->offset += (len + 1);
    } else { 
        fdi->offset += actual_max_len; 
    }
    if (fdi->offset > fdi->size) fdi->offset = fdi->size; 

    return str;
}

