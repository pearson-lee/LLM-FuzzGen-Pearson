            if (hProfiles_array_api4) {
                for (cmsUInt32Number i = 0; i < nProfiles_api4; ++i) {
                    if (FuzzerConsumeBool(&fdi)) { // Randomly create placeholder profiles.
                        hProfiles_array_api4[i] = cmsCreateProfilePlaceholder(ctx);
                    }
                }
            }
