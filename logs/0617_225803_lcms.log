#include <stdint.h>
#include <stddef.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>   // For INFINITY, NAN and isnan
#include <ctype.h>  // For isalnum

// LCMS includes with project-relative paths
#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/include/lcms2_plugin.h" // For _cmsDefaultICCintents
#include "/src/lcms/src/lcms2_internal.h"   // For _cmsChain2Lab (though its usage was removed)

// Helper structure to manage fuzzer data
typedef struct {
    const uint8_t *ptr;
    size_t remaining;
} FuzzDataConsumer;

// Initialize the consumer
static void init_fuzz_data_consumer(FuzzDataConsumer* consumer, const uint8_t* data, size_t size) {
    consumer->ptr = data;
    consumer->remaining = size;
}

// Consume a block of data
static const uint8_t* consume_bytes(FuzzDataConsumer* consumer, size_t count) {
    if (consumer->remaining < count) {
        return NULL;
    }
    const uint8_t* current_ptr = consumer->ptr;
    consumer->ptr += count;
    consumer->remaining -= count;
    return current_ptr;
}

// Consume a single byte (uint8_t)
static uint8_t consume_u8(FuzzDataConsumer* consumer, uint8_t default_val) {
    const uint8_t* byte_ptr = consume_bytes(consumer, sizeof(uint8_t));
    return byte_ptr ? *byte_ptr : default_val;
}

// Consume a boolean
static cmsBool consume_bool(FuzzDataConsumer* consumer) {
    return (consume_u8(consumer, 0) % 2) == 1;
}

// Consume a uint32_t
static cmsUInt32Number consume_u32(FuzzDataConsumer* consumer, cmsUInt32Number default_val) {
    const uint8_t* bytes_ptr = consume_bytes(consumer, sizeof(cmsUInt32Number));
    if (!bytes_ptr) return default_val;
    cmsUInt32Number val;
    memcpy(&val, bytes_ptr, sizeof(cmsUInt32Number));
    return val;
}

// Consume a double, ensuring it's a finite number
static double consume_double(FuzzDataConsumer* consumer, double default_val) {
    const uint8_t* bytes_ptr = consume_bytes(consumer, sizeof(double));
    if (!bytes_ptr) return default_val;
    double val;
    memcpy(&val, bytes_ptr, sizeof(double));
    if (isnan(val) || isinf(val)) {
        return default_val;
    }
    return val;
}

// Consume a short string (e.g., for Lang/Country codes)
static void consume_lang_country_code(FuzzDataConsumer* consumer, char* buffer, size_t buffer_len) {
    if (buffer_len == 0) return;
    
    size_t max_consume_len = buffer_len - 1;
    size_t consume_len = consume_u8(consumer, 0) % max_consume_len;
    
    if (consumer->remaining < consume_len) {
        consume_len = consumer->remaining;
    }

    const uint8_t* str_data = consume_bytes(consumer, consume_len);
    if (str_data) {
        memcpy(buffer, str_data, consume_len);
    } else {
        consume_len = 0; 
    }
    
    if (consume_len >= 2) {
        buffer[0] = isalpha(buffer[0]) ? buffer[0] : 'e';
        buffer[1] = isalpha(buffer[1]) ? buffer[1] : 'n';
        buffer[2] = '\0';
    } else if (consume_len == 1) {
        buffer[0] = isalpha(buffer[0]) ? buffer[0] : 'e';
        buffer[1] = '\0';
    } else {
         buffer[0] = '\0'; 
    }
}


#define MAX_PROFILE_DATA_SIZE (1024 * 16) 
#define INFO_BUFFER_WCHARS 64
#define MAX_PROFILES_IN_ARRAY 3 

