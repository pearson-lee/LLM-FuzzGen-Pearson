                     std::vector<std::string> knownProps = {"NUMBER_OF_FIELDS", "NUMBER_OF_SETS", "ORIGINATOR", "MANUFACTURER", "PROD_DATE", "DESCRIPTOR", "COLORANT_TABLE"};
                     if (!knownProps.empty()) {
                        propertyNameStr = knownProps[fdp.ConsumeIntegralInRange<size_t>(0, knownProps.size()-1)];
