// PCS L*a*b* to linear L*a*b* (adaptation state is ignored)
cmsStage* CMSEXPORT _cmsStageAllocLabPrelin(cmsContext ContextID)
{
    cmsStage* LabPrelin;
    cmsToneCurve** Curves;

    Curves = (cmsToneCurve**) _cmsCalloc(ContextID, 3, sizeof(cmsToneCurve*));
    if (Curves == NULL) return NULL;

    Curves[0] = cmsBuildGamma(ContextID, 1.0);    // L*
    Curves[1] = cmsBuildGamma(ContextID, 1.0);    // a*
    Curves[2] = cmsBuildGamma(ContextID, 1.0);    // b*

    // Check for degeneration
    if (Curves[0] == NULL || Curves[1] == NULL || Curves[2] == NULL) {

        if (Curves[0] != NULL) cmsFreeToneCurve(Curves[0]);
        if (Curves[1] != NULL) cmsFreeToneCurve(Curves[1]);
        if (Curves[2] != NULL) cmsFreeToneCurve(Curves[2]);
        _cmsFree(ContextID, Curves);
        return NULL;
    }

    LabPrelin = cmsStageAllocGeneric(ContextID, 3, cmsSigCurveSetElemType, Curves); // cmsStageAllocGeneric takes ownership of Curves
    if (LabPrelin == NULL) { // cmsStageAllocGeneric failed
        cmsFreeToneCurve(Curves[0]);
        cmsFreeToneCurve(Curves[1]);
        cmsFreeToneCurve(Curves[2]);
        _cmsFree(ContextID, Curves); // Free the array itself
        return NULL;
    }
    
    // cmsStageAllocGeneric copies the Curves pointer, and cmsStageFree will free this 'Data' pointer.
    // However, cmsStageFree does NOT free the individual tone curves pointed to by the elements of this array.
    // This is the source of the leak.

    return LabPrelin;
}[0m
