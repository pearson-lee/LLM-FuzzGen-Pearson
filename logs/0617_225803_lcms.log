#include <vector>
#include <string>
#include <algorithm> // For std::min
#include <cstring>   // For memcpy, memset

// Helper function to create a dummy cmsHPROFILE for testing
// Manages its own resources if profile creation involves intermediate objects.
cmsHPROFILE CreateDummyProfile(cmsContext ctx, FuzzedDataProvider& fdp) {
    if (ctx == nullptr) {
        return nullptr;
    }

    cmsHPROFILE profile = nullptr;
    // Choose one of several ways to create a profile
    int choice = fdp.ConsumeIntegralInRange<int>(0, 3);
    switch (choice) {
        case 0:
            // Create a simple placeholder profile
            profile = cmsCreateProfilePlaceholder(ctx);
            break;
        case 1:
            // Create a standard sRGB profile
            profile = cmsCreate_sRGBProfile(); // Removed ctx
            break;
        case 2:
            // Create a Lab profile (e.g., D50-based Lab)
            profile = cmsCreateLab4Profile(nullptr); // Removed ctx
            break;
        case 3:
            {
                // Create a Gray profile with a fuzzed gamma
                // Gamma value should be positive.
                cmsToneCurve* gammaCurve = cmsBuildGamma(ctx, fdp.ConsumeFloatingPointInRange<double>(0.1, 3.0));
                if (gammaCurve) {
                    // Use D50 white point for consistency
                    profile = cmsCreateGrayProfile(cmsD50_xyY(), gammaCurve); // Removed ctx
                    // cmsCreateGrayProfile duplicates the curve, so we must free the one we built.
                    cmsFreeToneCurve(gammaCurve); // Removed ctx
                } else {
                    // Fallback if gamma curve creation fails
                    profile = cmsCreateProfilePlaceholder(ctx);
                }
            }
            break;
        default:
            // Default to a placeholder
            profile = cmsCreateProfilePlaceholder(ctx);
            break;
    }
    return profile; // The caller is responsible for calling cmsCloseProfile on this
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a context for lcms operations. This context must be deleted at the end.
    cmsContext ctx = cmsCreateContext(nullptr, nullptr);
    if (!ctx) {
        return 0; // Cannot proceed without a context
    }

    // API 1: _cmsBuildKToneCurve
    if (fdp.remaining_bytes() > 100 && fdp.ConsumeBool()) {
        cmsUInt32Number nGridPoints = fdp.ConsumeIntegralInRange<cmsUInt32Number>(2, 20); // Must be >= 2
        cmsUInt32Number nProfiles = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, 3);   // Must be > 0

        std::vector<cmsUInt32Number> tab(nProfiles);
        std::vector<cmsHPROFILE> hProfilesVec(nProfiles, nullptr); // Initialize with nullptr
        std::vector<cmsBool> isStep(nProfiles);
        std::vector<cmsFloat64Number> gammas(nProfiles);
        bool profiles_ok = true;

        for (cmsUInt32Number i = 0; i < nProfiles; ++i) {
            tab[i] = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, (nProfiles > 0 ? nProfiles - 1 : 0) ); // Ensure nProfiles-1 is not negative if nProfiles is 0 (though it's 1-3 here)
            
            hProfilesVec[i] = CreateDummyProfile(ctx, fdp);
            if (!hProfilesVec[i]) {
                profiles_ok = false;
                for (cmsUInt32Number j = 0; j < i; ++j) {
                    if (hProfilesVec[j]) {
                        cmsCloseProfile(hProfilesVec[j]); // Removed ctx
                        hProfilesVec[j] = nullptr; 
                    }
                }
                for (cmsUInt32Number j = i; j < nProfiles; ++j) {
                    hProfilesVec[j] = nullptr;
                }
                break; 
            }
            isStep[i] = fdp.ConsumeBool();
            gammas[i] = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        }

        if (profiles_ok) { 
            cmsUInt32Number intent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3); 
            cmsToneCurve *toneCurve = _cmsBuildKToneCurve(ctx, nGridPoints, nProfiles,
                                                          tab.data(), hProfilesVec.data(),
                                                          isStep.data(), gammas.data(), intent);
            if (toneCurve) {
                cmsFreeToneCurve(toneCurve); // Removed ctx
            }
        }
        for (cmsHPROFILE hProf : hProfilesVec) {
            if (hProf) cmsCloseProfile(hProf); // Removed ctx
        }
    }

    // API 2: _cmsStageAllocLabPrelin
    if (fdp.ConsumeBool()) {
        cmsStage *stage = _cmsStageAllocLabPrelin(ctx);
        if (stage) {
            cmsStageFree(stage); // Removed ctx
        }
    }

    // API 3: cmsCreateProofingTransform
    if (fdp.remaining_bytes() > 50 && fdp.ConsumeBool()) {
        cmsHPROFILE hInput = CreateDummyProfile(ctx, fdp);
        cmsHPROFILE hOutput = CreateDummyProfile(ctx, fdp);
        cmsHPROFILE hProof = CreateDummyProfile(ctx, fdp);

        if (hInput && hOutput && hProof) {
            std::vector<cmsUInt32Number> validFormats = {
                TYPE_GRAY_8, TYPE_GRAY_16, TYPE_RGB_8, TYPE_RGB_16, 
                TYPE_CMYK_8, TYPE_CMYK_16, TYPE_Lab_8, TYPE_Lab_DBL,
                TYPE_GRAYA_8, TYPE_RGBA_8, TYPE_CMYKA_8 
            };
            cmsUInt32Number inputFormat = validFormats[fdp.ConsumeIntegralInRange<size_t>(0, validFormats.size() - 1)];
            cmsUInt32Number outputFormat = validFormats[fdp.ConsumeIntegralInRange<size_t>(0, validFormats.size() - 1)];
            
            cmsUInt32Number intent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3); 
            cmsUInt32Number proofIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
            
            cmsUInt32Number dwFlags = fdp.ConsumeIntegral<cmsUInt32Number>() & 
                                      (cmsFLAGS_BLACKPOINTCOMPENSATION | cmsFLAGS_HIGHRESPRECALC |
                                       cmsFLAGS_LOWRESPRECALC | cmsFLAGS_GAMUTCHECK |
                                       cmsFLAGS_SOFTPROOFING | cmsFLAGS_NOOPTIMIZE | 
                                       cmsFLAGS_NULLTRANSFORM | cmsFLAGS_COPY_ALPHA |
                                       cmsFLAGS_KEEP_SEQUENCE); 

            cmsHTRANSFORM transform = cmsCreateProofingTransform(hInput, inputFormat, // Removed ctx
                                                                 hOutput, outputFormat,
                                                                 hProof, intent, proofIntent, dwFlags);
            if (transform) {
                cmsDeleteTransform(transform); // Removed ctx
            }
        }
        if (hInput) cmsCloseProfile(hInput);   // Removed ctx
        if (hOutput) cmsCloseProfile(hOutput); // Removed ctx
        if (hProof) cmsCloseProfile(hProof);   // Removed ctx
    }

    // API 4: cmsIT8EnumPropertyMulti
    if (fdp.remaining_bytes() > 20 && fdp.ConsumeBool()) {
        cmsHANDLE hIT8 = cmsIT8Alloc(ctx); 
        if (hIT8) {
            std::string propertyNameStr = fdp.ConsumeRandomLengthString(30);
            if (fdp.ConsumeBool()) {
                 std::vector<std::string> knownProps = {"NUMBER_OF_FIELDS", "NUMBER_OF_SETS", "ORIGINATOR", "MANUFACTURER", "PROD_DATE", "DESCRIPTOR", "COLORANT_TABLE"};
                 if (!knownProps.empty()) {
                    propertyNameStr = knownProps[fdp.ConsumeIntegralInRange<size_t>(0, knownProps.size()-1)];
                 }
            }

            const char **subpropertyNames = nullptr;
            /* cmsUInt32Number count = */ cmsIT8EnumPropertyMulti(hIT8, propertyNameStr.c_str(), &subpropertyNames);
            
            if (subpropertyNames) {
                // Use _cmsIT8FreePropertyNames from lcms2_internal.h
                _cmsIT8FreePropertyNames(ctx, (char**)subpropertyNames); // Changed function name and cast
            }
            cmsIT8Free(hIT8); // Removed ctx
        }
    }
    
    // API 5: cmsPlugin
    if (fdp.ConsumeBool() && fdp.remaining_bytes() >= sizeof(cmsPluginBase) ) { 
        // Use _cmsMalloc from lcms2_plugin.h (via lcms2_internal.h)
        cmsPluginBase* plugin_fuzzed_ptr = (cmsPluginBase*)_cmsMalloc(ctx, sizeof(cmsPluginBase)); // Changed to _cmsMalloc
        if (plugin_fuzzed_ptr) {
            size_t bytes_to_consume = sizeof(cmsPluginBase); // Consume exact size for plugin
            std::vector<uint8_t> plugin_data_vec = fdp.ConsumeBytes<uint8_t>(bytes_to_consume);
            
            // Ensure plugin_data_vec has enough data, otherwise this might be an issue if ConsumeBytes returns less
            if (plugin_data_vec.size() == sizeof(cmsPluginBase)) {
                 memcpy(plugin_fuzzed_ptr, plugin_data_vec.data(), sizeof(cmsPluginBase));
            } else {
                // If not enough data, zero initialize to avoid using uninitialized fuzzed data partially
                memset(plugin_fuzzed_ptr, 0, sizeof(cmsPluginBase));
            }


            plugin_fuzzed_ptr->Magic = cmsPluginMagicNumber;
            plugin_fuzzed_ptr->ExpectedVersion = LCMS_VERSION; 
            // plugin_fuzzed_ptr->Type is fuzzed.
            // plugin_fuzzed_ptr->Next is fuzzed.

            cmsPlugin(plugin_fuzzed_ptr); // cmsPlugin itself does not take ctx
            // Memory will be freed by cmsUnregisterPlugins using the context stored during plugin registration
        }
    }

    cmsUnregisterPlugins();
    cmsDeleteContext(ctx);

    return 0;
}[0m
