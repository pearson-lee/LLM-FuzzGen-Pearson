            ActualIntents_for_pipeline[i] = k_intent_choices[consume_u8(&consumer, 0) % (sizeof(k_intent_choices)/sizeof(k_intent_choices[0]))];
            BPC_intents[i] = consume_bool(&consumer);
            AdaptationStates_intents[i] = consume_double(&consumer, 1.0);
        }
        
        if (consume_bool(&consumer)) dwPipelineFlags |= cmsFLAGS_BLACKPOINTCOMPENSATION;
        if (consume_bool(&consumer)) dwPipelineFlags |= cmsFLAGS_HIGHRESPRECALC;
        if (consume_bool(&consumer)) dwPipelineFlags |= cmsFLAGS_LOWRESPRECALC;


