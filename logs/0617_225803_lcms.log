#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/src/lcms2_internal.h" // For _cmsMalloc, _cmsFree
#include <fuzzer/FuzzedDataProvider.h>

#include <vector>
#include <string>
#include <algorithm> // For std::min
#include <cstring>   // For memcpy, memset

// Helper function to get the size of a single component for a given format
static size_t GetComponentSize(cmsUInt32Number format) {
    cmsUInt32Number fmt_bytes = T_BYTES(format);
    if (fmt_bytes == 0) { // Means float or double
        if (T_FLOAT(format)) { // Is it float?
            return sizeof(cmsFloat32Number);
        } else { // Otherwise, assume double
            return sizeof(cmsFloat64Number);
        }
    }
    return fmt_bytes; // For 8-bit or 16-bit, T_BYTES is 1 or 2
}

// Helper function to calculate the total pixel size in bytes
static size_t CalculatePixelSize(cmsUInt32Number format) {
    cmsUInt32Number channels = T_CHANNELS(format);
    cmsUInt32Number extra_channels = T_EXTRA(format);
    cmsUInt32Number component_size = GetComponentSize(format);
    // Ensure component_size is not zero to prevent issues with T_TYPE(format) == 0 (unknown type)
    if (component_size == 0 && channels + extra_channels > 0) {
        // This case should ideally not happen with valid formats from validFormats list.
        // Default to a non-zero size to avoid division by zero or zero-size allocations if format is weird.
        return (channels + extra_channels);
    }
    return (channels + extra_channels) * component_size;
}


// Helper function to create a dummy cmsHPROFILE for testing
// Manages its own resources if profile creation involves intermediate objects.
cmsHPROFILE CreateDummyProfile(cmsContext ctx, FuzzedDataProvider& fdp) {
    if (ctx == nullptr) {
        return nullptr;
    }

    cmsHPROFILE profile = nullptr;
    // Choose one of several ways to create a profile
    int choice = fdp.ConsumeIntegralInRange<int>(0, 3);
    switch (choice) {
        case 0:
            // Create a simple placeholder profile
            profile = cmsCreateProfilePlaceholder(ctx);
            break;
        case 1:
            // Create a standard sRGB profile
            profile = cmsCreate_sRGBProfileTHR(ctx); // Use THR version for context
            break;
        case 2:
            // Create a Lab profile (e.g., D50-based Lab)
            profile = cmsCreateLab4ProfileTHR(ctx, nullptr);  // Use THR version for context
            break;
        case 3:
            {
                // Create a Gray profile with a fuzzed gamma
                // Gamma value should be positive.
                cmsToneCurve* gammaCurve = cmsBuildGamma(ctx, fdp.ConsumeFloatingPointInRange<double>(0.1, 3.0));
                if (gammaCurve) {
                    // Use D50 white point for consistency
                    profile = cmsCreateGrayProfileTHR(ctx, cmsD50_xyY(), gammaCurve); // Use THR version
                    cmsFreeToneCurve(gammaCurve);
                } else {
                    // Fallback if gamma curve creation fails
                    profile = cmsCreateProfilePlaceholder(ctx);
                }
            }
            break;
        default:
            // Default to a placeholder
            profile = cmsCreateProfilePlaceholder(ctx);
            break;
    }
    return profile;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    cmsContext ctx = cmsCreateContext(nullptr, nullptr);
    if (!ctx) {
        return 0;
    }

    // API 3: cmsCreateProofingTransform
    if (fdp.remaining_bytes() > 50 && fdp.ConsumeBool()) {
        cmsHPROFILE hInput = CreateDummyProfile(ctx, fdp);
        cmsHPROFILE hOutput = CreateDummyProfile(ctx, fdp);
        cmsHPROFILE hProof = CreateDummyProfile(ctx, fdp);

        if (hInput && hOutput && hProof) {
            std::vector<cmsUInt32Number> validFormats = {
                TYPE_GRAY_8, TYPE_GRAY_16, TYPE_RGB_8, TYPE_RGB_16,
                TYPE_CMYK_8, TYPE_CMYK_16, TYPE_Lab_8, TYPE_Lab_DBL,
                TYPE_GRAYA_8, TYPE_RGBA_8, TYPE_CMYKA_8,
                // Add some float formats for broader testing if _cmsGetFormatterAlpha supports them
                TYPE_RGB_FLT, TYPE_GRAY_FLT, TYPE_RGBA_FLT, TYPE_GRAYA_FLT
            };
            cmsUInt32Number inputFormat = validFormats[fdp.ConsumeIntegralInRange<size_t>(0, validFormats.size() - 1)];
            cmsUInt32Number outputFormat = validFormats[fdp.ConsumeIntegralInRange<size_t>(0, validFormats.size() - 1)];

            cmsUInt32Number intent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
            cmsUInt32Number proofIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);

            cmsUInt32Number dwFlags = fdp.ConsumeIntegral<cmsUInt32Number>() &
                                      (cmsFLAGS_BLACKPOINTCOMPENSATION | cmsFLAGS_HIGHRESPRECALC |
                                       cmsFLAGS_LOWRESPRECALC | cmsFLAGS_GAMUTCHECK |
                                       cmsFLAGS_SOFTPROOFING | cmsFLAGS_NOOPTIMIZE |
                                       cmsFLAGS_NULLTRANSFORM | cmsFLAGS_COPY_ALPHA |
                                       cmsFLAGS_KEEP_SEQUENCE);
            // Ensure cmsFLAGS_COPY_ALPHA is sometimes set to try to get past early returns in _cmsHandleExtraChannels
            if (fdp.ConsumeBool()) {
                dwFlags |= cmsFLAGS_COPY_ALPHA;
            } else {
                dwFlags &= ~cmsFLAGS_COPY_ALPHA;
            }


            cmsHTRANSFORM transform = cmsCreateProofingTransformTHR(ctx, hInput, inputFormat, // Use THR version
                                                                 hOutput, outputFormat,
                                                                 hProof, intent, proofIntent, dwFlags);
            if (transform) {
                // Added cmsDoTransform call to exercise the transform pipeline,
                // specifically targeting _cmsHandleExtraChannels coverage.
                size_t input_pixel_size = CalculatePixelSize(inputFormat);
                size_t output_pixel_size = CalculatePixelSize(outputFormat);

                // Limit buffer sizes to prevent excessive memory allocation.
                if (input_pixel_size > 0 && output_pixel_size > 0 &&
                    input_pixel_size <= 512 && output_pixel_size <= 512) {

                    std::vector<uint8_t> in_buffer_vec(input_pixel_size);
                    std::vector<uint8_t> out_buffer_vec(output_pixel_size);

                    // ConsumeData might fill less than requested, which is fine.
                    fdp.ConsumeData(in_buffer_vec.data(), input_pixel_size);

                    cmsStride stride_info;
                    stride_info.BytesPerLineIn = input_pixel_size; // For 1 pixel
                    stride_info.BytesPerLineOut = output_pixel_size; // For 1 pixel
                    // For chunky formats, BytesPerPlane is component size.
                    // This is used by _cmsHandleExtraChannels via ComputeComponentIncrements.
                    stride_info.BytesPerPlaneIn = GetComponentSize(inputFormat);
                    stride_info.BytesPerPlaneOut = GetComponentSize(outputFormat);

                    cmsDoTransform(transform, in_buffer_vec.data(), out_buffer_vec.data(), 1, 1, &stride_info);
                }
                cmsDeleteTransform(transform);
            }
        }
        if (hInput) cmsCloseProfile(hInput);
        if (hOutput) cmsCloseProfile(hOutput);
        if (hProof) cmsCloseProfile(hProof);
    }

    // API 4: cmsIT8EnumPropertyMulti
    if (fdp.remaining_bytes() > 20 && fdp.ConsumeBool()) {
        cmsHANDLE hIT8 = cmsIT8Alloc(ctx);
        if (hIT8) {
            if (fdp.ConsumeBool()) { // New path to test subproperty enumeration
                std::string mainPropKey = fdp.ConsumeRandomLengthString(10);
                std::string subPropKey = fdp.ConsumeRandomLengthString(10);
                std::string propVal = fdp.ConsumeRandomLengthString(10);

                if (!mainPropKey.empty() && mainPropKey.length() < 30 &&
                    !subPropKey.empty() && subPropKey.length() < 30) {
                    // Added call to cmsIT8SetPropertyMulti to create a property with a subkey.
                    // This aims to cover loops in cmsIT8EnumPropertyMulti that iterate over subproperties.
                    // Memory for these properties is managed by the hIT8 handle.
                    cmsIT8SetPropertyMulti(hIT8, mainPropKey.c_str(), subPropKey.c_str(), propVal.c_str());

                    const char **subpropertyNames = nullptr;
                    /* cmsUInt32Number count = */ cmsIT8EnumPropertyMulti(hIT8, mainPropKey.c_str(), &subpropertyNames);
                    // subpropertyNames is allocated by cmsIT8EnumPropertyMulti using the IT8 handle's context.
                    // It will be freed when cmsIT8Free(hIT8) is called.
