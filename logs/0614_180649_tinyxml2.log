        tinyxml2::XMLConstHandle constHandle_copy(constHandle);
        constHandle = constHandle_copy;

        constHandle.FirstChild();
        constHandle.FirstChildElement(fdp.ConsumeBool() ? "ch_fc_elem" : nullptr);
        constHandle.LastChild();
        constHandle.LastChildElement(fdp.ConsumeBool() ? "ch_lc_elem" : nullptr);
        constHandle.PreviousSibling();
        constHandle.PreviousSiblingElement(fdp.ConsumeBool() ? "ch_ps_elem" : nullptr);
        constHandle.NextSibling();
        constHandle.NextSiblingElement(fdp.ConsumeBool() ? "ch_ns_elem" : nullptr);

        const tinyxml2::XMLNode* cNodeFromHandle = constHandle.ToNode();
