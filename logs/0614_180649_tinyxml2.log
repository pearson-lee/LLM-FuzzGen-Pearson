                            }
                            doc->DeleteNode(add_this_elem); // Clean up add_this_elem as it wasn't used or inserted.
                            add_this_elem = nullptr; // Mark as cleaned up
                        } else if (scenario == 2) {
                            std::unique_ptr<tinyxml2::XMLDocument> temp_doc_for_orphan(new tinyxml2::XMLDocument());
                            tinyxml2::XMLElement* orphan_node = temp_doc_for_orphan->NewElement("orphanNode"); // Belongs to temp_doc_for_orphan
                            if (orphan_node) {
                                // afterThis is an orphan (not child of parent), error condition
                                inserted_node_result = parent->InsertAfterChild(orphan_node, add_this_elem);
                                // orphan_node is not adopted by parent. temp_doc_for_orphan will delete it.
                            }
                        } else if (scenario == 3 && after_this_node) {
                             // Inserting a node after itself is an error condition
                            parent->InsertAfterChild(after_this_node, after_this_node);
                            doc->DeleteNode(add_this_elem); // Clean up add_this_elem as it wasn't used.
                            add_this_elem = nullptr; // Mark as cleaned up
                        } else if (scenario == 4 && after_this_node == parent->LastChild()) {
                            inserted_node_result = parent->InsertAfterChild(after_this_node, add_this_elem);
                        } else { // Default, includes after_this_node not being last child, or other valid cases
                            inserted_node_result = parent->InsertAfterChild(after_this_node, add_this_elem);
                        }


                        if (add_this_elem) { // If add_this_elem was not cleaned up by a specific scenario
                            if (inserted_node_result == add_this_elem) { // Successfully inserted
                                if (fdp.ConsumeBool()) current_element = add_this_elem;
                            } else { // Not inserted or different node inserted, so clean up original add_this_elem
                                doc->DeleteNode(add_this_elem);
