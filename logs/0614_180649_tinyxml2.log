                                                elem2->SetAttribute(attr->Name(), val.c_str());
                                            }
                                         }
                                    } else {
                                        int num_attrs_elem2 = fdp.ConsumeIntegralInRange<int>(0, 2);
                                         for (int k=0; k < num_attrs_elem2; ++k) {
