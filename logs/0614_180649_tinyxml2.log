        handle.FirstChildElement(fdp.ConsumeBool() ? "h_fc_elem" : nullptr);
        handle.LastChild();
        handle.LastChildElement(fdp.ConsumeBool() ? "h_lc_elem" : nullptr);
        handle.PreviousSibling();
        handle.PreviousSiblingElement(fdp.ConsumeBool() ? "h_ps_elem" : nullptr);
