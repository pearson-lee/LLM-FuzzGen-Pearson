                                std::string existing_attr_s_val = fdp.ConsumeRandomLengthString(10);
                                current_element->SetAttribute(existing_attr_s_name.c_str(), existing_attr_s_val.c_str());
                                current_element->QueryStringAttribute(existing_attr_s_name.c_str(), &attr_val_ptr);
                                current_element->DeleteAttribute(existing_attr_s_name.c_str());
