                                case 1: new_node->ToComment(); break; // Target XMLComment::ToComment
                                case 2: new_node->ToText(); break;
                                case 3: new_node->ToDeclaration(); break;
                                case 4: new_node->ToUnknown(); break;   // Target XMLUnknown::ToUnknown
