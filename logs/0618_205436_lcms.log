// Fuzz target entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Create a context with a custom deleter for automatic cleanup.
  std::unique_ptr<struct _cms_Context_struct, ContextDeleter> context(cmsCreateContext(nullptr, nullptr));
  if (!context) {
    return 0;
  }

  // Create an in-memory IO handler for reading and writing data.
  cmsIOHANDLER *io = cmsOpenIOhandlerFromMem(context.get(), (void *)data, size, "r");
  if (!io) {
    return 0;
  }

  // Fuzz cmsDesaturateLab
  cmsCIELab lab;
  lab.L = fdp.ConsumeFloatingPoint<double>();
  lab.a = fdp.ConsumeFloatingPoint<double>();
  lab.b = fdp.ConsumeFloatingPoint<double>();
  double a_sat = fdp.ConsumeFloatingPoint<double>();
  double b_sat = fdp.ConsumeFloatingPoint<double>();
  double a_unsat = fdp.ConsumeFloatingPoint<double>();
  double b_unsat = fdp.ConsumeFloatingPoint<double>();
  cmsDesaturateLab(&lab, a_sat, b_sat, a_unsat, b_unsat);

  // Fuzz Type_Dictionary_Read
  cmsUInt32Number nItems;
  cmsUInt32Number sizeOfTag = fdp.ConsumeIntegral<cmsUInt32Number>();
  void *dict = Type_Dictionary_Read(nullptr, io, &nItems, sizeOfTag);
  if (dict) {
    cmsDictFree((cmsHANDLE)dict);
  }

  // Fuzz Type_MPE_Dup
  cmsStage *stage = _cmsStageAllocLabPrelin(context.get());
  if (stage) {
    void *mpe_dup = Type_MPE_Dup(nullptr, stage, fdp.ConsumeIntegral<cmsUInt32Number>());
    if (mpe_dup) {
      _cmsStageFree(static_cast<cmsStage*>(mpe_dup));
    }
    _cmsStageFree(stage);
  }

  // Fuzz Type_LUT8_Write
  cmsPipeline *lut = cmsPipelineAlloc(context.get(), 3, 3);
  if (lut) {
    cmsIOHANDLER *write_io = cmsOpenIOhandlerFromMem(context.get(), nullptr, 0, "w");
    if (write_io) {
      Type_LUT8_Write(nullptr, write_io, lut, fdp.ConsumeIntegral<cmsUInt32Number>());
      cmsIOhandlerClose(write_io);
    }
    cmsPipelineFree(lut);
  }

  // Fuzz _cmsStageAllocLabPrelin
  cmsStage *prelin_stage = _cmsStageAllocLabPrelin(context.get());
  if (prelin_stage) {
    _cmsStageFree(prelin_stage);
  }

  // Close the IO handler.
  cmsIOhandlerClose(io);

  return 0;
}[0m
