// Custom deleters for smart pointers
struct ContextDeleter {
  void operator()(cmsContext ctx) const {
    if (ctx) {
      cmsDeleteContext(ctx);
    }
  }
};

struct ProfileDeleter {
    void operator()(cmsHPROFILE h) const {
        if (h) {
            cmsCloseProfile(h);
        }
    }
};

struct IOHandlerDeleter {
  void operator()(cmsIOHANDLER* ioh) const {
    if (ioh) {
      cmsCloseIOhandler(ioh);
    }
  }
};

struct MLUDeleter {
  void operator()(cmsMLU* mlu) const {
    if (mlu) {
      cmsMLUfree(mlu);
    }
  }
};

struct SeqDeleter {
  void operator()(cmsSEQ* s) const {
    if (s) {
      cmsFreeProfileSequenceDescription(s);
    }
  }
};

// Fuzz target entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Create a context object.
  std::unique_ptr<std::remove_pointer_t<cmsContext>, ContextDeleter> context(cmsCreateContext(nullptr, nullptr));
  if (!context) {
    return 0;
  }

  // --- Fuzz Reading ---
  {
    // Create a memory-based IO handler with fuzzed data for reading.
    size_t read_io_size = fdp.ConsumeIntegralInRange<size_t>(0, fdp.remaining_bytes());
    auto read_io_data = fdp.ConsumeBytes<uint8_t>(read_io_size);
    std::unique_ptr<cmsIOHANDLER, IOHandlerDeleter> read_io_handler(
        cmsOpenIOhandlerFromMem(context.get(), (void*)read_io_data.data(), read_io_data.size(), "r"));
    
    if (read_io_handler) {
        std::unique_ptr<std::remove_pointer_t<cmsHPROFILE>, ProfileDeleter> profile(cmsOpenProfileFromIOhandlerTHR(context.get(), read_io_handler.get()));
        if(profile) {
            // Fuzz cmsReadTag for Profile Description
            cmsMLU* mlu = (cmsMLU*)cmsReadTag(profile.get(), cmsSigProfileDescriptionTag);
            if (mlu) {
                cmsMLUfree(mlu);
            }

            // Fuzz cmsReadTag for Profile Sequence ID
            cmsSEQ* seq = (cmsSEQ*)cmsReadTag(profile.get(), cmsSigProfileSequenceDescTag);
            if (seq) {
                cmsFreeProfileSequenceDescription(seq);
            }
        }
    }
  }

  // --- Fuzz Writing ---
  {
    // We need a writable profile to test writing tags.
    std::unique_ptr<std::remove_pointer_t<cmsHPROFILE>, ProfileDeleter> profile(cmsCreateProfilePlaceholder(context.get()));
    if (profile) {
        // Fuzz cmsWriteTag for Profile Description
        std::unique_ptr<cmsMLU, MLUDeleter> mlu_write(cmsMLUalloc(context.get(), 1));
        if (mlu_write) {
            std::string text = fdp.ConsumeRandomLengthString(100);
            cmsMLUsetASCII(mlu_write.get(), "en", "US", text.c_str());
            cmsWriteTag(profile.get(), cmsSigProfileDescriptionTag, mlu_write.get());
        }

        // Fuzz cmsWriteTag for Profile Sequence ID
        std::unique_ptr<cmsSEQ, SeqDeleter> seq(cmsAllocProfileSequenceDescription(context.get(), 1));
        if (seq) {
            seq->seq[0].deviceMfg = fdp.ConsumeIntegral<cmsUInt32Number>();
            seq->seq[0].deviceModel = fdp.ConsumeIntegral<cmsUInt32Number>();
            seq->seq[0].attributes = fdp.ConsumeIntegral<cmsUInt64Number>();
            seq->seq[0].technology = (cmsTechnologySignature)fdp.ConsumeIntegral<cmsUInt32Number>();
            
            cmsMLU* mlu_seq = cmsMLUalloc(context.get(), 1);
            if (mlu_seq) {
                std::string text = fdp.ConsumeRandomLengthString(20);
                cmsMLUsetASCII(mlu_seq, "en", "US", text.c_str());
                seq->seq[0].Manufacturer = mlu_seq;
            } else {
                seq->seq[0].Manufacturer = nullptr;
            }
            seq->seq[0].Model = nullptr; 
            
            cmsWriteTag(profile.get(), cmsSigProfileSequenceDescTag, seq.get());
        }

        std::vector<uint8_t> write_buffer(4096); 
        std::unique_ptr<cmsIOHANDLER, IOHandlerDeleter> write_io_handler(
            cmsOpenIOhandlerFromMem(context.get(), write_buffer.data(), write_buffer.size(), "w"));
        if(write_io_handler) {
            cmsSaveProfileToIOhandler(profile.get(), write_io_handler.get());
        }
    }
  }

  // --- Fuzz cmsDesaturateLab (kept from original) ---
  cmsCIELab lab;
  lab.L = fdp.ConsumeFloatingPoint<double>();
  lab.a = fdp.ConsumeFloatingPoint<double>();
  lab.b = fdp.ConsumeFloatingPoint<double>();
  double amax = fdp.ConsumeFloatingPoint<double>();
  double amin = fdp.ConsumeFloatingPoint<double>();
  double bmax = fdp.ConsumeFloatingPoint<double>();
  double bmin = fdp.ConsumeFloatingPoint<double>();
  cmsDesaturateLab(&lab, amax, amin, bmax, bmin);

  return 0;
}[0m
