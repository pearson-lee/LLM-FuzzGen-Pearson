#include <cstddef>
#include <cstdint>
#include <vector>
#include <fuzzer/FuzzedDataProvider.h>
#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/src/lcms2_internal.h"

// Custom deleters for smart pointers
struct ContextDeleter {
  void operator()(cmsContext ctx) const {
    if (ctx) {
      cmsDeleteContext(ctx);
    }
  }
};

struct IOHandlerDeleter {
  void operator()(cmsIOHANDLER* ioh) const {
    if (ioh) {
      cmsCloseIOhandler(ioh);
    }
  }
};

struct DictDeleter {
  void operator()(cmsHPROFILE h) const {
    if (h) {
      cmsDictFree((cmsHANDLE)h);
    }
  }
};

struct SeqDeleter {
  void operator()(cmsSEQ* s) const {
    if (s) {
      cmsFreeProfileSequenceDescription(s);
    }
  }
};

// Fuzz target entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Create a context object.
  std::unique_ptr<void, ContextDeleter> context(cmsCreateContext(nullptr, nullptr));
  if (!context) {
    return 0;
  }

  // Create a memory-based IO handler with fuzzed data.
  const auto io_data = fdp.ConsumeRemainingBytes<uint8_t>();
  std::unique_ptr<cmsIOHANDLER, IOHandlerDeleter> io_handler(
      cmsOpenIOhandlerFromMem(context.get(), (void*)io_data.data(), io_data.size(), "r"));
  if (!io_handler) {
    return 0;
  }

  // Fuzz Type_Dictionary_Read
  _cms_typehandler_struct* dict_handler = _cmsFindTagTypeHandler(cmsSigDictType);
  if (dict_handler) {
    cmsUInt32Number items, size_of_items;
    void* dict = dict_handler->Read(dict_handler, io_handler.get(), &items, &size_of_items);
    if (dict) {
      dict_handler->Free(dict_handler, dict);
    }
  }

  // Fuzz Type_ProfileSequenceId_Read
  // Rewind the IO handler to reuse the fuzzed data.
  cmsIOhandlerRewind(io_handler.get());
  _cms_typehandler_struct* seq_id_handler = _cmsFindTagTypeHandler(cmsSigProfileSeqIdType);
  if (seq_id_handler) {
    cmsUInt32Number items, size_of_items;
    void* seq = seq_id_handler->Read(seq_id_handler, io_handler.get(), &items, &size_of_items);
    if (seq) {
      seq_id_handler->Free(seq_id_handler, seq);
    }
  }

  // Fuzz Type_Dictionary_Write
  if (dict_handler) {
    std::unique_ptr<void, DictDeleter> dict(cmsDictAlloc(context.get()));
    if (dict) {
      // Add some fuzzed entries to the dictionary.
      std::wstring name = fdp.ConsumeRandomLengthStringAsWstring(20);
      std::wstring value = fdp.ConsumeRandomLengthStringAsWstring(20);
      cmsDictAddEntry(dict.get(), name.c_str(), value.c_str(), nullptr, nullptr);
      dict_handler->Write(dict_handler, io_handler.get(), dict.get(), 1);
    }
  }

  // Fuzz Type_ProfileSequenceId_Write
  if (seq_id_handler) {
    std::unique_ptr<cmsSEQ, SeqDeleter> seq(cmsAllocProfileSequenceDescription(context.get(), 1));
    if (seq) {
      // Populate the sequence with fuzzed data.
      seq->seq[0].deviceMfg = fdp.ConsumeIntegral<cmsUInt32Number>();
      seq->seq[0].deviceModel = fdp.ConsumeIntegral<cmsUInt32Number>();
      seq->seq[0].attributes = fdp.ConsumeIntegral<cmsUInt64Number>();
      seq->seq[0].technology = (cmsTechnologySignature)fdp.ConsumeIntegral<cmsUInt32Number>();
      cmsMLU* mlu = cmsMLUalloc(context.get(), 1);
      if (mlu) {
        std::string text = fdp.ConsumeRandomLengthString(20);
        cmsMLUsetASCII(mlu, "en", "US", text.c_str());
        seq->seq[0].Manufacturer = mlu;
      }
      seq_id_handler->Write(seq_id_handler, io_handler.get(), seq.get(), 1);
    }
  }

  // Fuzz cmsDesaturateLab
  cmsCIELab lab;
  lab.L = fdp.ConsumeFloatingPoint<double>();
  lab.a = fdp.ConsumeFloatingPoint<double>();
  lab.b = fdp.ConsumeFloatingPoint<double>();
  double amax = fdp.ConsumeFloatingPoint<double>();
  double amin = fdp.ConsumeFloatingPoint<double>();
  double bmax = fdp.ConsumeFloatingPoint<double>();
  double bmin = fdp.ConsumeFloatingPoint<double>();
  cmsDesaturateLab(&lab, amax, amin, bmax, bmin);

  return 0;
}[0m
