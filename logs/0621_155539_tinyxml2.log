  std::string root_element_name_str = fdp.ConsumeRandomLengthString(32);
  const char* root_element_name = root_element_name_str.empty() ? "root" : root_element_name_str.c_str();
  
  // Create and insert the root element into the document.
  tinyxml2::XMLElement* root = doc.NewElement(root_element_name);
  doc.InsertFirstChild(root);

  // 1. Test tinyxml2::XMLElement::BoolAttribute(const char *, bool)
  //    This function internally calls QueryBoolAttribute, which has branches
  //    for attribute found/not found and valid/invalid boolean string.
  {
    std::string attr_name_str = fdp.ConsumeRandomLengthString(16);
    const char* attr_name = attr_name_str.empty() ? "boolAttr" : attr_name_str.c_str();
    bool default_bool_value = fdp.ConsumeBool();
    bool set_bool_value = fdp.ConsumeBool();

    // Case 1: Attribute exists and is a valid boolean string ("true" or "false").
    // SetAttribute will create or find the attribute and set its value.
    root->SetAttribute(attr_name, set_bool_value);
    root->BoolAttribute(attr_name, default_bool_value);

    // Case 2: Attribute exists but contains a non-boolean string.
    // This tests the conversion failure path within QueryBoolAttribute.
    std::string non_bool_str = fdp.ConsumeRandomLengthString(10);
    if (non_bool_str.empty()) {
        non_bool_str = "not_a_bool"; // Ensure a non-empty, non-boolean string.
    }
    root->SetAttribute(attr_name, non_bool_str.c_str());
    root->BoolAttribute(attr_name, default_bool_value);

    // Case 3: Attribute does not exist.
    // This tests the XML_NO_ATTRIBUTE return path in QueryBoolAttribute.
    std::string non_existent_attr_name_str = fdp.ConsumeRandomLengthString(16);
    const char* non_existent_attr_name = non_existent_attr_name_str.empty() ? "nonExistent" : non_existent_attr_name_str.c_str();
    root->BoolAttribute(non_existent_attr_name, default_bool_value);
  }

  // 2. Test tinyxml2::XMLElement::IntText(int)
  //    This function internally calls QueryIntText, which has branches for
  //    element having/not having text, and text being valid/invalid integer.
  {
    tinyxml2::XMLElement* text_elem = doc.NewElement("textElem");
    root->InsertEndChild(text_elem);

    // Case 1: Element has valid integer text.
    // This should cover the XML_SUCCESS path in QueryIntText.
    std::string int_text = std::to_string(fdp.ConsumeIntegral<int>());
    text_elem->SetText(int_text.c_str());
    text_elem->IntText(fdp.ConsumeIntegral<int>());

    // Case 2: Element has non-integer text.
    // This should cover the XML_CAN_NOT_CONVERT_TEXT path in QueryIntText.
    std::string non_int_text_str = fdp.ConsumeRandomLengthString(20);
    const char* non_int_text = non_int_text_str.empty() ? "hello" : non_int_text_str.c_str();
    text_elem->SetText(non_int_text);
    text_elem->IntText(fdp.ConsumeIntegral<int>());

    // Case 3: Element has no text node.
    // This should cover the XML_NO_TEXT_NODE path in QueryIntText.
    text_elem->DeleteChildren(); // Remove any existing text node.
    text_elem->IntText(fdp.ConsumeIntegral<int>());
  }

  // 3. Test tinyxml2::XMLNode::ChildElementCount(const char *) and ChildElementCount()
  //    These functions count child elements, exercising node traversal loops.
  {
    std::string child_name_1_str = fdp.ConsumeRandomLengthString(10);
    const char* child_name_1 = child_name_1_str.empty() ? "child1" : child_name_1_str.c_str();
    std::string child_name_2_str = fdp.ConsumeRandomLengthString(10);
    const char* child_name_2 = child_name_2_str.empty() ? "child2" : child_name_2_str.c_str();

    // Add a fuzzed number of children with various names to exercise the while loop
    // in ChildElementCount functions (both with and without a name filter).
    for (int i = 0; i < fdp.ConsumeIntegralInRange<int>(0, 5); ++i) {
        root->InsertNewChildElement(child_name_1);
    }
    for (int i = 0; i < fdp.ConsumeIntegralInRange<int>(0, 5); ++i) {
        root->InsertNewChildElement(child_name_2);
    }
    root->InsertNewChildElement("uniqueChild"); // Add one more for diversity.

    root->ChildElementCount(); // Test counting all child elements.
    root->ChildElementCount(child_name_1); // Test counting child elements with a specific existing name.
    root->ChildElementCount("nonExistentChild"); // Test counting child elements with a non-existent name (should return 0).
  }

  // 4. Test tinyxml2::XMLElement::InsertNewChildElement(const char *)
  //    This function creates a new XMLElement and inserts it as a child.
  {
    std::string new_child_name_str = fdp.ConsumeRandomLengthString(32);
    const char* new_child_name = new_child_name_str.empty() ? "newChild" : new_child_name_str.c_str();
    root->InsertNewChildElement(new_child_name);
  }

  // 5. Test tinyxml2::XMLPrinter::PushText(bool)
  //    This function is part of the XML serialization process.
  {
    // Use the custom FuzzXMLPrinter to ensure no actual file I/O occurs.
    FuzzXMLPrinter printer;
    printer.PushText(fdp.ConsumeBool()); // Push a fuzzed boolean value as text.
    printer.PushText(fdp.ConsumeBool()); // Push another fuzzed boolean value.
    
    // Print the entire document to exercise more of XMLPrinter's functionality,
    // including its internal buffer management and various Visit methods.
    doc.Print(&printer);
  }

  // The tinyxml2::XMLDocument 'doc' and FuzzXMLPrinter 'printer' are stack-allocated.
  // Their destructors will be automatically called when they go out of scope,
  // ensuring all dynamically allocated memory managed by them is properly released.
  // This design adheres to the memory safety principle.

  return 0;
}[0m
