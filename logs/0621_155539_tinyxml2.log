// Custom XMLPrinter to avoid writing to actual files during fuzzing and ensure
// its internal buffer is properly managed and cleared.
class FuzzXMLPrinter : public tinyxml2::XMLPrinter {
public:
    // Constructor initializes the base XMLPrinter with a null file pointer,
    // compact mode (no indentation), and no initial indent level.
    FuzzXMLPrinter() : tinyxml2::XMLPrinter(nullptr, false, 0) {}

    // Destructor ensures the internal buffer of the printer is explicitly cleared.
    // The base class destructor will also handle its own cleanup.
    ~FuzzXMLPrinter() {
        ClearBuffer(true); // Clear the buffer and free allocated memory.
    }
};

