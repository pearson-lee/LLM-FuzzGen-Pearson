    // This function creates a new XMLComment node and inserts it as a child.
    // We aim to cover the success path of insertion.
    if (fdp.remaining_bytes() > 0) {
        std::string comment_text = fdp.ConsumeRandomLengthString(100);
        tinyxml2::XMLElement* root_element = doc->NewElement("Root");
        doc->InsertFirstChild(root_element); // Add a root element to insert comments into

        if (root_element) {
            // Attempt to insert a new comment
            tinyxml2::XMLComment* new_comment = root_element->InsertNewComment(comment_text.c_str());
            // The return value of InsertNewComment is checked internally,
            // but we can assert its existence if the insertion was expected to succeed.
            // No explicit check needed here for fuzzing, as we just want to exercise the path.
        }
    }

    // 2. Fuzz tinyxml2::XMLText::ShallowEqual(const XMLNode *)
    // This function compares two XMLText nodes for shallow equality (value).
    // We need to test cases where they are equal, not equal, and comparing with non-XMLText nodes.
    if (fdp.remaining_bytes() > 0) {
        std::string text1_value = fdp.ConsumeRandomLengthString(50);
        std::string text2_value = fdp.ConsumeRandomLengthString(50);

        tinyxml2::XMLText* text1 = doc->NewText(text1_value.c_str());
        tinyxml2::XMLText* text2 = doc->NewText(text2_value.c_str());

        if (text1 && text2) {
            // Case 1: Compare two XMLText nodes with potentially different values
            text1->ShallowEqual(text2);

            // Case 2: Compare an XMLText node with itself (should be equal)
            text1->ShallowEqual(text1);

            // Case 3: Compare an XMLText node with a non-XMLText node (should be false)
            tinyxml2::XMLElement* element_node = doc->NewElement("TestElement");
            if (element_node) {
                text1->ShallowEqual(element_node);
            }
        }
    }

    // 3. Fuzz tinyxml2::XMLElement::ShallowEqual(const XMLNode *)
    // This function compares two XMLElement nodes for shallow equality (name and attributes).
    // We need to test various combinations of names and attributes.
    if (fdp.remaining_bytes() > 0) {
        std::string element1_name = fdp.ConsumeRandomLengthString(20);
        std::string element2_name = fdp.ConsumeRandomLengthString(20);

        tinyxml2::XMLElement* element1 = doc->NewElement(element1_name.c_str());
        tinyxml2::XMLElement* element2 = doc->NewElement(element2_name.c_str());

        if (element1 && element2) {
            // Case 1: Elements with potentially different names and no attributes
            element1->ShallowEqual(element2);

            // Case 2: Elements with same name, no attributes
            tinyxml2::XMLElement* element3 = doc->NewElement(element1_name.c_str());
            if (element3) {
                element1->ShallowEqual(element3);
            }

            // Case 3: Elements with attributes - same names, same values
            std::string attr_name1 = fdp.ConsumeRandomLengthString(10);
            std::string attr_value1 = fdp.ConsumeRandomLengthString(10);
            element1->SetAttribute(attr_name1.c_str(), attr_value1.c_str());
            element2->SetAttribute(attr_name1.c_str(), attr_value1.c_str());
            element1->ShallowEqual(element2);

            // Case 4: Elements with attributes - same names, different values
            std::string attr_name2 = fdp.ConsumeRandomLengthString(10);
            std::string attr_value2_a = fdp.ConsumeRandomLengthString(10);
            std::string attr_value2_b = fdp.ConsumeRandomLengthString(10);
            element1->SetAttribute(attr_name2.c_str(), attr_value2_a.c_str());
            element2->SetAttribute(attr_name2.c_str(), attr_value2_b.c_str());
            element1->ShallowEqual(element2);

            // Case 5: Elements with different number of attributes
            std::string attr_name3 = fdp.ConsumeRandomLengthString(10);
            std::string attr_value3 = fdp.ConsumeRandomLengthString(10);
            element1->SetAttribute(attr_name3.c_str(), attr_value3.c_str()); // element1 now has more attributes
            element1->ShallowEqual(element2);

            // Case 6: Compare an XMLElement with a non-XMLElement node
            tinyxml2::XMLText* text_node = doc->NewText("SomeText");
            if (text_node) {
                element1->ShallowEqual(text_node);
            }
        }
    }

    // 4. Fuzz tinyxml2::XMLPrinter::PushText(float)
    // This function prints a float value to the XML output.
    if (fdp.remaining_bytes() > 0) {
        std::unique_ptr<tinyxml2::XMLPrinter> printer_float = std::make_unique<tinyxml2::XMLPrinter>();
        float float_value = fdp.ConsumeFloatingPoint<float>();
        printer_float->PushText(float_value);
        // Accessing CStr() or CStrSize() can also trigger more code paths within XMLPrinter
        printer_float->CStr();
        printer_float->CStrSize();
    }

    // 5. Fuzz tinyxml2::XMLPrinter::PushAttribute(const char *, unsigned int)
    // This function adds an attribute with an unsigned int value to the current element being printed.
    if (fdp.remaining_bytes() > 0) {
        std::unique_ptr<tinyxml2::XMLPrinter> printer_attr = std::make_unique<tinyxml2::XMLPrinter>();
        std::string attr_name = fdp.ConsumeRandomLengthString(30);
        unsigned int attr_value = fdp.ConsumeIntegral<unsigned int>();

        // To push an attribute, an element must be open.
        printer_attr->OpenElement("TestAttrElement");
        printer_attr->PushAttribute(attr_name.c_str(), attr_value);
        printer_attr->CloseElement(); // Close the element to finalize it
        printer_attr->CStr();
        printer_attr->CStrSize();
    }

    // Optional: Parse the document to exercise parsing logic, which might interact
    // with the created nodes and attributes.
    if (doc->RootElement()) {
        std::unique_ptr<tinyxml2::XMLPrinter> printer_doc = std::make_unique<tinyxml2::XMLPrinter>();
        doc->Print(printer_doc.get());
        std::string xml_string = printer_doc->CStr();

        // Parse the generated XML string
        std::unique_ptr<tinyxml2::XMLDocument> parsed_doc = std::make_unique<tinyxml2::XMLDocument>();
        parsed_doc->Parse(xml_string.c_str());

        // Use a visitor to traverse the parsed document, further exercising nodes' Accept methods.
        FuzzVisitor visitor;
        parsed_doc->Accept(&visitor);
    }

    // All memory allocated by tinyxml2::XMLDocument and tinyxml2::XMLPrinter
    // is automatically freed when their unique_ptr goes out of scope.

    return 0;
}[0m
