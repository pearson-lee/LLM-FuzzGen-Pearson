// Fuzz target entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size == 0) {
    return 0;
  }

  FuzzedDataProvider fdp(data, size);

  // Use a stringstream for in-memory TIFF data handling
  std::stringstream out_stream(std::ios_base::in | std::ios_base::out | std::ios_base::binary);

  // ::tiffosOpen is defined in tiffio.cxx and allows using C++ streams
  // This targets TIFFStreamOpen and related stream handling functions
  TIFF *tif_out = TIFFStreamOpen("fuzzer_write", static_cast<std::ostream*>(&out_stream));
  if (!tif_out) {
    return 0;
  }

  // Define image parameters, fuzzed to explore different configurations
  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  uint16_t samples_per_pixel = fdp.PickValueInArray<uint16_t>({1, 3, 4});
  uint16_t bits_per_sample = fdp.PickValueInArray<uint16_t>({8, 16});
  
  // Change #1: Add more compression types to improve coverage in various
  // compression-specific files like tif_luv.c, tif_pixarlog.c, tif_thunderscan.c,
  // and tif_jpeg.c.
  const uint16_t compression = fdp.PickValueInArray<uint16_t>({
      COMPRESSION_NONE,       COMPRESSION_PACKBITS,
      COMPRESSION_LZW,        COMPRESSION_ADOBE_DEFLATE,
      COMPRESSION_THUNDERSCAN,COMPRESSION_JPEG,
      COMPRESSION_SGILOG,     COMPRESSION_SGILOG24,
      COMPRESSION_PIXARLOG
  });

  // Change #2: For Thunderscan compression, specific parameters are required.
  // This change enables coverage of the Thunderscan codec in tif_thunder.c.
  if (compression == COMPRESSION_THUNDERSCAN) {
    samples_per_pixel = 1;
    bits_per_sample = 1;
  }

  // Change #3: Add PHOTOMETRIC_YCBCR to improve coverage of YCbCr conversion
  // routines in tif_getimage.c and tif_color.c.
  uint16_t photometric;
  if (samples_per_pixel == 1) {
    photometric = PHOTOMETRIC_MINISBLACK;
  } else if (samples_per_pixel == 3) {
    photometric = fdp.PickValueInArray<uint16_t>({PHOTOMETRIC_RGB, PHOTOMETRIC_YCBCR});
  } else { // samples_per_pixel == 4
    photometric = PHOTOMETRIC_SEPARATED;
  }
  
  const uint16_t planar_config = fdp.PickValueInArray<uint16_t>({PLANARCONFIG_CONTIG, PLANARCONFIG_SEPARATE});

  // Set TIFF fields to create a valid directory structure
  TIFFSetField(tif_out, TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(tif_out, TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(tif_out, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
  TIFFSetField(tif_out, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
  TIFFSetField(tif_out, TIFFTAG_ORIENTATION, ORIENTATION_TOPLEFT);
  TIFFSetField(tif_out, TIFFTAG_PLANARCONFIG, planar_config);
  TIFFSetField(tif_out, TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(tif_out, TIFFTAG_COMPRESSION, compression);

  // Change #4: Set YCbCr subsampling if needed, which is required for YCbCr
  // photometric and exercises more code paths in tif_jpeg.c and tif_color.c.
  if (photometric == PHOTOMETRIC_YCBCR) {
    uint16_t subsampling_h = fdp.PickValueInArray<uint16_t>({1, 2, 4});
    uint16_t subsampling_v = fdp.PickValueInArray<uint16_t>({1, 2, 4});
    TIFFSetField(tif_out, TIFFTAG_YCBCRSUBSAMPLING, subsampling_h, subsampling_v);
  }

  // Write scanline data to the in-memory TIFF
  // This is a primary target, exercising TIFFWriteScanline and potentially
  // low-coverage functions it calls, like TIFFAppendToStrip.
  tsize_t scanline_size = TIFFScanlineSize(tif_out);
  if (scanline_size > 0) {
    std::vector<uint8_t> line_buf = fdp.ConsumeBytes<uint8_t>(scanline_size);
    if (line_buf.size() == scanline_size) {
      for (uint32_t row = 0; row < height; ++row) {
        TIFFWriteScanline(tif_out, line_buf.data(), row, 0);
      }
    }
  }

  // Change #5: Write a second directory to improve coverage for multi-directory
  // TIFF handling in functions like TIFFWriteDirectory and TIFFSetDirectory.
  if (fdp.ConsumeBool()) {
    TIFFWriteDirectory(tif_out); // Finalize the first directory
    const uint32_t width2 = fdp.ConsumeIntegralInRange<uint32_t>(1, 256);
    const uint32_t height2 = fdp.ConsumeIntegralInRange<uint32_t>(1, 256);
    TIFFSetField(tif_out, TIFFTAG_IMAGEWIDTH, width2);
    TIFFSetField(tif_out, TIFFTAG_IMAGELENGTH, height2);
    TIFFSetField(tif_out, TIFFTAG_SAMPLESPERPIXEL, (uint16_t)1);
    TIFFSetField(tif_out, TIFFTAG_BITSPERSAMPLE, (uint16_t)8);
    TIFFSetField(tif_out, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
    TIFFSetField(tif_out, TIFFTAG_PHOTOMETRIC, PHOTOMETRIC_MINISBLACK);
    TIFFSetField(tif_out, TIFFTAG_COMPRESSION, COMPRESSION_NONE);
    tsize_t scanline_size2 = TIFFScanlineSize(tif_out);
    if (scanline_size2 > 0) {
      std::vector<uint8_t> line_buf2 = fdp.ConsumeBytes<uint8_t>(scanline_size2);
      if (line_buf2.size() == scanline_size2) {
        for (uint32_t row = 0; row < height2; ++row) {
          TIFFWriteScanline(tif_out, line_buf2.data(), row, 0);
        }
      }
    }
  }

  // Close the TIFF handle to ensure all data is flushed to the stream
  TIFFClose(tif_out);

  // Get the generated TIFF data from the output stream
  std::string tiff_data = out_stream.str();
  if (tiff_data.empty()) {
    return 0;
  }

  // Prepare an input stream for reading the generated TIFF data
  std::stringstream in_stream(tiff_data);

  // Open the in-memory TIFF data for reading
  TIFF *tif_in = TIFFStreamOpen("fuzzer_read", static_cast<std::istream*>(&in_stream));
  if (!tif_in) {
    return 0;
  }

  // Change #6: Navigate to a random directory if multiple exist to improve
  // coverage in directory reading functions.
  if (fdp.ConsumeBool()) {
      tdir_t dir_count = TIFFNumberOfDirectories(tif_in);
      if (dir_count > 1) {
          TIFFSetDirectory(tif_in, fdp.ConsumeIntegralInRange<tdir_t>(0, dir_count - 1));
      }
  }

  // Change #7: Call TIFFPrintDirectory to improve coverage in tif_print.c,
  // which was previously uncovered.
  if (fdp.ConsumeBool()) {
      TIFFPrintDirectory(tif_in, stdout, 0);
  }

