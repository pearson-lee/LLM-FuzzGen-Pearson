  TIFFSetField(tif_out, TIFFTAG_PLANARCONFIG, planar_config);
  TIFFSetField(tif_out, TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(tif_out, TIFFTAG_COMPRESSION, compression);

