#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <sstream>
#include <string>
#include <vector>

#include "fuzzer/FuzzedDataProvider.h"
#include "/src/libtiff/libtiff/tiffio.h"

// Dummy error and warning handlers to prevent libtiff from printing to stderr,
// which can slow down fuzzing.
static void dummy_error_handler(const char *, const char *, va_list) {}
static void dummy_warning_handler(const char *, const char *, va_list) {}

// Custom stream implementation for libtiff
static tmsize_t read_from_stream(thandle_t handle, void *buffer, tmsize_t size) {
  std::istream *stream = static_cast<std::istream *>(handle);
  stream->read(static_cast<char *>(buffer), size);
  return stream->gcount();
}

static tmsize_t write_to_stream(thandle_t handle, void *buffer, tmsize_t size) {
  std::ostream *stream = static_cast<std::ostream *>(handle);
  stream->write(static_cast<const char *>(buffer), size);
  return size;
}

static toff_t seek_in_stream(thandle_t handle, toff_t offset, int whence) {
  std::istream *stream = static_cast<std::istream *>(handle);
  std::ios_base::seekdir dir;
  switch (whence) {
  case SEEK_SET:
    dir = std::ios_base::beg;
    break;
  case SEEK_CUR:
    dir = std::ios_base::cur;
    break;
  case SEEK_END:
    dir = std::ios_base::end;
    break;
  default:
    return static_cast<toff_t>(-1);
  }
  stream->seekg(offset, dir);
  return stream->tellg();
}

static int close_stream(thandle_t) { return 0; }

static toff_t get_stream_size(thandle_t handle) {
  std::istream *stream = static_cast<std::istream *>(handle);
  toff_t current_pos = stream->tellg();
  stream->seekg(0, std::ios_base::end);
  toff_t size = stream->tellg();
  stream->seekg(current_pos, std::ios_base::beg);
  return size;
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 20) {
    return 0;
  }

  FuzzedDataProvider fdp(data, size);

  // Set custom error handlers to suppress console output.
  TIFFSetErrorHandler(dummy_error_handler);
  TIFFSetWarningHandler(dummy_warning_handler);

  // Use a stringstream for in-memory TIFF writing, which is ideal for fuzzing.
  std::stringstream ss;

  // Open the TIFF stream for writing using TIFFClientOpen.
  TIFF *tif_write = TIFFClientOpen(
      "fuzzer.tif", "w", &ss, read_from_stream, write_to_stream,
      seek_in_stream, close_stream, get_stream_size, nullptr, nullptr);
  if (!tif_write) {
    return 0;
  }

  // Define image properties using fuzzed data to explore different configurations.
  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 400);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 400);
  const uint16_t samples_per_pixel = fdp.PickValueInArray<uint16_t>({1, 3, 4});
  const uint16_t bits_per_sample = fdp.PickValueInArray<uint16_t>({8, 16});
  const uint16_t compression = fdp.PickValueInArray<uint16_t>(
      {COMPRESSION_NONE, COMPRESSION_LZW, COMPRESSION_PACKBITS,
       COMPRESSION_DEFLATE});
  const uint16_t photometric =
      (samples_per_pixel == 1) ? PHOTOMETRIC_MINISBLACK : PHOTOMETRIC_RGB;

  // Set mandatory TIFF fields. This exercises TIFFSetField and its callees
  // (_TIFFVSetField), which have complex logic for different tag types.
  TIFFSetField(tif_write, TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(tif_write, TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(tif_write, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
  TIFFSetField(tif_write, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
  TIFFSetField(tif_write, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
  TIFFSetField(tif_write, TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(tif_write, TIFFTAG_COMPRESSION, compression);

  // Set optional fields to explore more code paths in directory writing.
  std::string software_str = fdp.ConsumeRandomLengthString(100);
  TIFFSetField(tif_write, TIFFTAG_SOFTWARE, software_str.c_str());

  // Calculate buffer size for one scanline.
  tsize_t scanline_size = TIFFScanlineSize(tif_write);
  if (scanline_size <= 0) {
    TIFFClose(tif_write);
    return 0;
  }

  // Allocate a buffer for one scanline.
  std::vector<uint8_t> scanline_buf(scanline_size);

  // Write image data scanline by scanline, targeting TIFFWriteScanline and
  // the underlying compression codecs.
  for (uint32_t row = 0; row < height; ++row) {
    if (fdp.remaining_bytes() < scanline_size) {
      break;
    }
    fdp.ConsumeData(scanline_buf.data(), scanline_size);
    if (TIFFWriteScanline(tif_write, scanline_buf.data(), row, 0) < 0) {
      break;
    }
  }

  // TIFFClose handles flushing data, writing the directory, and cleaning up.
  // This is a critical part that exercises file finalization logic.
  TIFFClose(tif_write);

  // --- Reading Phase ---

  // Get the generated TIFF data from the stringstream.
  std::string tiff_data = ss.str();
  if (tiff_data.empty()) {
    return 0;
  }

  // Use an istringstream to read the in-memory TIFF data.
  std::istringstream ss_read(tiff_data);

  // Open the TIFF for reading to test the parsing and decoding logic.
  TIFF *tif_read = TIFFClientOpen(
      "fuzzer.tif", "r", &ss_read, read_from_stream, write_to_stream,
      seek_in_stream, close_stream, get_stream_size, nullptr, nullptr);
  if (!tif_read) {
    return 0;
  }

  // Read the data back to exercise reading and decompression paths.
  tsize_t read_scanline_size = TIFFScanlineSize(tif_read);
  if (read_scanline_size > 0) {
    std::vector<uint8_t> read_buf(read_scanline_size);
    uint32_t read_height = 0;
    TIFFGetField(tif_read, TIFFTAG_IMAGELENGTH, &read_height);
    for (uint32_t row = 0; row < read_height; ++row) {
      if (TIFFReadScanline(tif_read, read_buf.data(), row, 0) < 0) {
        break;
      }
    }
  }

  // Clean up the reading TIFF handle. All resources are released here.
  TIFFClose(tif_read);

  return 0;
}[0m
