#include <cstdint>
#include <sstream>
#include <vector>

#include "fuzzer/FuzzedDataProvider.h"
#include "libtiff/libtiff/tiffio.h"
#include "libtiff/libtiff/tiffio.hxx"

// Fuzz target entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Use a stringstream for in-memory TIFF data handling.
  // This avoids filesystem I/O and exercises the C++ stream interface.
  std::stringstream stream;

  // --- WRITE PHASE ---
  // Open the stream for writing. TIFFStreamOpen is a good target as the
  // underlying stream functions in tif_stream.cxx have low coverage.
  TIFF *write_tiff = TIFFStreamOpen("MemTIFFWrite", &stream);
  if (!write_tiff) {
    return 0;
  }

  // Generate randomized image parameters to create diverse TIFF files.
  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint16_t spp = fdp.PickValueInArray<uint16_t>({1, 3, 4}); // Samples per pixel
  const uint16_t bps = fdp.PickValueInArray<uint16_t>({8, 16});  // Bits per sample
  const uint16_t compression = fdp.PickValueInArray<uint16_t>(
      {COMPRESSION_NONE, COMPRESSION_PACKBITS, COMPRESSION_LZW,
       COMPRESSION_DEFLATE, COMPRESSION_ADOBE_DEFLATE});
  const uint16_t planarconfig =
      fdp.PickValueInArray<uint16_t>({PLANARCONFIG_CONTIG, PLANARCONFIG_SEPARATE});
  uint16_t photometric = (spp >= 3) ? PHOTOMETRIC_RGB : PHOTOMETRIC_MINISBLACK;

  // Set core TIFF fields.
  TIFFSetField(write_tiff, TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(write_tiff, TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(write_tiff, TIFFTAG_SAMPLESPERPIXEL, spp);
  TIFFSetField(write_tiff, TIFFTAG_BITSPERSAMPLE, bps);
  TIFFSetField(write_tiff, TIFFTAG_ORIENTATION, ORIENTATION_TOPLEFT);
  TIFFSetField(write_tiff, TIFFTAG_PLANARCONFIG, planarconfig);
  TIFFSetField(write_tiff, TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(write_tiff, TIFFTAG_COMPRESSION, compression);
  TIFFSetField(write_tiff, TIFFTAG_ROWSPERSTRIP, height); // Single strip

  // Write scanline data to the in-memory TIFF.
  const tsize_t scanline_size = TIFFScanlineSize(write_tiff);
  if (scanline_size > 0) {
    std::vector<uint8_t> scanline_buf = fdp.ConsumeBytes<uint8_t>(scanline_size);
    scanline_buf.resize(scanline_size, 0); // Ensure buffer is full size.
    for (uint32_t row = 0; row < height; ++row) {
      if (TIFFWriteScanline(write_tiff, scanline_buf.data(), row, 0) < 0) {
        break;
      }
    }
  }

  // Create a second directory to test directory manipulation.
  TIFFWriteDirectory(write_tiff);
  TIFFSetField(write_tiff, TIFFTAG_IMAGEWIDTH, 1);
  TIFFSetField(write_tiff, TIFFTAG_IMAGELENGTH, 1);
  TIFFSetField(write_tiff, TIFFTAG_SUBFILETYPE, FILETYPE_REDUCEDIMAGE);

  // Target TIFFUnlinkDirectory, which has low coverage (64%).
  // We attempt to unlink the second directory (index 1).
  TIFFUnlinkDirectory(write_tiff, 1);

  // Safely close the TIFF handle, flushing all written data to the stream.
  TIFFClose(write_tiff);

  // --- READ PHASE ---
  // Rewind the stream to the beginning to read the data back.
  stream.seekg(0);
  stream.clear();

  // Open the stream for reading.
  TIFF *read_tiff = TIFFStreamOpen("MemTIFFRead", &stream);
  if (!read_tiff) {
    return 0;
  }

  uint32_t read_width = 0, read_height = 0;
  TIFFGetField(read_tiff, TIFFTAG_IMAGEWIDTH, &read_width);
  TIFFGetField(read_tiff, TIFFTAG_IMAGELENGTH, &read_height);

  // Target TIFFReadRGBAImage, a high-level function with 0% coverage that
  // exercises a lot of the image reading, conversion, and decompression logic.
  if (read_width > 0 && read_height > 0) {
    // Sanity check to prevent excessive memory allocation.
    if (read_width > 4096 || read_height > 4096) {
      TIFFClose(read_tiff);
      return 0;
    }
    // TIFFReadRGBAImage allocates memory for the raster, which must be freed.
    uint32_t *raster =
        (uint32_t *)_TIFFmalloc(read_width * read_height * sizeof(uint32_t));
    if (raster) {
      // The last argument (0) means do not stop on errors.
      TIFFReadRGBAImage(read_tiff, read_width, read_height, raster, 0);
      // Free the memory allocated by the library.
      _TIFFfree(raster);
    }
  }

  // Safely close the read handle.
  TIFFClose(read_tiff);

  return 0;
}[0m
