                    // This avoids the negative-size-param bug when -1 is passed.
                    TIFFReadEncodedStrip(read_tif, strip_to_read, strip_buf, strip_size);
                    _TIFFfree(strip_buf);
                }
            }
        }
    }

    TIFFClose(read_tif);

    return 0;
}[0m
