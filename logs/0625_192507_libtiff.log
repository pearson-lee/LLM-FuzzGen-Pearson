                    TIFFReadRGBAImage(tif_r, img_width, img_height, raster, 0);
                    _TIFFfree(raster);
                }
            }
            TIFFRGBAImageEnd(&img);
        }
    }

    TIFFClose(tif_r);
  }

  // Clean up the temporary file.
  unlink(kTempTiffFile);

  return 0;
