  if (TIFFWriteDirectory(tif.get()) != 1) {
    // This can fail, but we continue to try reading what was written.
  } else {
    // If the first directory was successful, try to write a second one.
    SetRandomFields(tif.get(), fdp);
    TIFFWriteDirectory(tif.get());
  }

  // The write part is done, close the handle.
  tif.reset();

  // --- Start of Reading Phase ---
  // Added to exercise reading APIs, which were previously uncovered.
  // Rewind the stream to the beginning to read the data we just wrote.
  tiff_stream.seekg(0);

  // Open the stream for reading.
  TiffUniquePtr tif_read(TIFFStreamOpen("fuzz_tiff_read", static_cast<std::istream *>(&tiff_stream)));
  if (!tif_read) {
    return 0;
  }

  // Added to cover TIFFSetDirectory and multi-directory reading logic.
  // Loop through all directories in the TIFF file.
  do {
    uint32_t w = 0, h = 0;
    char emsg[1024] = {0};

    // Added to cover TIFFRGBAImageOK and related functions in tif_getimage.c
    if (TIFFRGBAImageOK(tif_read.get(), emsg)) {
      TIFFGetField(tif_read.get(), TIFFTAG_IMAGEWIDTH, &w);
      TIFFGetField(tif_read.get(), TIFFTAG_IMAGELENGTH, &h);
      if (w > 0 && h > 0) {
        // Allocate a buffer for one scanline.
        // Using std::vector ensures memory is freed automatically.
        std::vector<uint32_t> raster(w);
        // Added to cover TIFFReadRGBAStrip in tif_getimage.c
        TIFFReadRGBAStrip(tif_read.get(), 0, raster.data());
      }
    }
  } while (TIFFReadDirectory(tif_read.get()));

  return 0;
