    TIFF* read_tif = TIFFClientOpen("fuzz_read", "r",
                                    reinterpret_cast<thandle_t>(&fuzz_data),
                                    readProc, writeProc, seekProc, closeProc,
                                    sizeProc, mapProc, unmapProc);

    if (!read_tif) {
