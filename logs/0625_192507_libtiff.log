  // before creating another directory (like GPS). This flushes all data.
  if (!TIFFWriteDirectory(tif)) {
      TIFFClose(tif);
      return 0;
  }

  // Conditionally create and write a GPS directory.
  if (fdp.ConsumeBool()) {
    if (TIFFCreateGPSDirectory(tif)) {
