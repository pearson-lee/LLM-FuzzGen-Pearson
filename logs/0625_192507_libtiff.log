#include "tiffio.hxx"

// Custom deleter for the TIFF handle to ensure TIFFClose is always called.
struct TiffCloser {
  void operator()(TIFF* tiff) const {
    if (tiff) {
      TIFFClose(tiff);
    }
  }
};

// Define a unique_ptr type for TIFF handles for automatic resource management.
using TiffUniquePtr = std::unique_ptr<TIFF, TiffCloser>;

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  if (size < 100) {
    return 0;
  }
  FuzzedDataProvider fdp(data, size);

  // Use a stringstream for in-memory TIFF file operations.
  std::stringstream tiff_stream;

  // Create a TIFF handle associated with the in-memory stream.
  // The TiffUniquePtr ensures TIFFClose is called automatically.
  TiffUniquePtr tiff(TIFFStreamOpen("fuzz.tif", &tiff_stream));
  if (!tiff) {
    return 0;
  }

  // Define image properties using fuzzer data.
  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 500);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 500);
  const uint16_t samples_per_pixel = 3;
  const uint16_t bits_per_sample = 8;
  const uint16_t photometric = PHOTOMETRIC_LOGLUV;
  const uint16_t compression = COMPRESSION_PIXARLOG;
  const uint16_t planar_config = PLANARCONFIG_CONTIG;

  // Set TIFF fields. This targets low-coverage areas, especially
  // in the PixarLog codec setup.
  TIFFSetField(tiff.get(), TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(tiff.get(), TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(tiff.get(), TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
  TIFFSetField(tiff.get(), TIFFTAG_BITSPERSAMPLE, bits_per_sample);
  TIFFSetField(tiff.get(), TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(tiff.get(), TIFFTAG_PLANARCONFIG, planar_config);
  TIFFSetField(tiff.get(), TIFFTAG_COMPRESSION, compression);

  // Set predictor and rowsperstrip, which are often required by codecs.
  TIFFSetField(tiff.get(), TIFFTAG_PREDICTOR, PREDICTOR_NONE);
  TIFFSetField(tiff.get(), TIFFTAG_ROWSPERSTRIP, height);

  // Calculate the size of one scanline.
  tmsize_t scanline_size = TIFFScanlineSize(tiff.get());
  if (scanline_size <= 0) {
    return 0;
  }

  // Allocate a buffer for one scanline.
  std::vector<uint8_t> scanline_buf(scanline_size);

  // Write image data scanline by scanline.
  // This exercises the encoding logic of the selected codec (PixarLog).
  for (uint32_t row = 0; row < height; ++row) {
    // Fill the buffer with fuzzer data.
    fdp.ConsumeData(scanline_buf.data(), scanline_size);
    if (TIFFWriteScanline(tiff.get(), scanline_buf.data(), row, 0) < 0) {
      // If writing fails, stop and let the smart pointer clean up.
      return 0;
    }
  }

  // After writing, attempt to rewrite the directory.
  // This function has very low coverage and is a primary target.
  TIFFRewriteDirectory(tiff.get());

  return 0;
}[0m
