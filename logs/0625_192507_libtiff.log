#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <algorithm>
#include <cstring>
#include <fuzzer/FuzzedDataProvider.h>

// Core TIFF library header
#include "/work/include/tiffio.h"

// Custom data structure to manage an in-memory buffer for TIFF data.
struct TiffBuffer {
    std::vector<uint8_t> buffer;
    tmsize_t position = 0;
};

// Read callback for TIFFClientOpen.
tmsize_t readProc(thandle_t handle, void* data, tmsize_t size) {
    TiffBuffer* tiff_buffer = reinterpret_cast<TiffBuffer*>(handle);
    tmsize_t remaining = tiff_buffer->buffer.size() - tiff_buffer->position;
    tmsize_t bytes_to_read = std::min(size, remaining);
    if (bytes_to_read > 0) {
        memcpy(data, tiff_buffer->buffer.data() + tiff_buffer->position, bytes_to_read);
        tiff_buffer->position += bytes_to_read;
    }
    return bytes_to_read;
}

// Write callback for TIFFClientOpen.
tmsize_t writeProc(thandle_t handle, void* data, tmsize_t size) {
    TiffBuffer* tiff_buffer = reinterpret_cast<TiffBuffer*>(handle);
    if (tiff_buffer->position + size > tiff_buffer->buffer.size()) {
        tiff_buffer->buffer.resize(tiff_buffer->position + size);
    }
    memcpy(tiff_buffer->buffer.data() + tiff_buffer->position, data, size);
    tiff_buffer->position += size;
    return size;
}

// Seek callback for TIFFClientOpen.
toff_t seekProc(thandle_t handle, toff_t offset, int whence) {
    TiffBuffer* tiff_buffer = reinterpret_cast<TiffBuffer*>(handle);
    toff_t new_pos = -1;

    if (whence == SEEK_SET) {
        new_pos = offset;
    } else if (whence == SEEK_CUR) {
        new_pos = tiff_buffer->position + offset;
    } else if (whence == SEEK_END) {
        new_pos = tiff_buffer->buffer.size() + offset;
    }

    if (new_pos >= 0) {
        tiff_buffer->position = new_pos;
        return tiff_buffer->position;
    }
    return -1;
}

// Close callback (noop for memory buffer).
int closeProc(thandle_t) {
    return 0;
}

// Size callback for TIFFClientOpen.
toff_t sizeProc(thandle_t handle) {
    TiffBuffer* tiff_buffer = reinterpret_cast<TiffBuffer*>(handle);
    return tiff_buffer->buffer.size();
}


// Fuzzer entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint16_t samples_per_pixel = fdp.PickValueInArray<uint16_t>({1, 3, 4});
  const uint16_t bits_per_sample = 8;
  const uint16_t photometric = (samples_per_pixel == 1) ? PHOTOMETRIC_MINISBLACK : PHOTOMETRIC_RGB;

  TiffBuffer tiff_buffer;

  TIFF *tiff = TIFFClientOpen("fuzz_tiff", "w",
                            reinterpret_cast<thandle_t>(&tiff_buffer),
                            readProc, writeProc, seekProc, closeProc, sizeProc,
                            nullptr, nullptr);
  if (!tiff) {
    return 0;
  }

  TIFFSetField(tiff, TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(tiff, TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(tiff, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
  TIFFSetField(tiff, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
  TIFFSetField(tiff, TIFFTAG_ORIENTATION, ORIENTATION_TOPLEFT);
  TIFFSetField(tiff, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
  TIFFSetField(tiff, TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(tiff, TIFFTAG_COMPRESSION, COMPRESSION_NONE);

  tmsize_t scanline_size = TIFFScanlineSize(tiff);
  if (scanline_size <= 0) {
    TIFFClose(tiff);
    return 0;
  }
  std::vector<uint8_t> scanline_buf(scanline_size);

  for (uint32_t row = 0; row < height; ++row) {
    if (fdp.remaining_bytes() > scanline_buf.size()) {
      fdp.ConsumeData(&scanline_buf[0], scanline_buf.size());
    }
    if (TIFFWriteScanline(tiff, scanline_buf.data(), row, 0) < 0) {
      break;
    }
  }

  if (TIFFWriteDirectory(tiff)) {
      TIFFSetField(tiff, TIFFTAG_IMAGEWIDTH, width / 2 + 1);
      TIFFSetField(tiff, TIFFTAG_IMAGELENGTH, height / 2 + 1);
      TIFFSetField(tiff, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
      TIFFSetField(tiff, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
      TIFFSetField(tiff, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
      TIFFSetField(tiff, TIFFTAG_PHOTOMETRIC, photometric);
      TIFFSetField(tiff, TIFFTAG_COMPRESSION, COMPRESSION_NONE);
      TIFFWriteDirectory(tiff);

      TIFFSetDirectory(tiff, 0);
  }

  TIFFClose(tiff);

  // Reset buffer position for reading.
  tiff_buffer.position = 0;
  
  tiff = TIFFClientOpen("fuzz_tiff_read", "r",
                      reinterpret_cast<thandle_t>(&tiff_buffer),
                      readProc, writeProc, seekProc, closeProc, sizeProc,
                      nullptr, nullptr);
  if (!tiff) {
    return 0;
  }

  for (uint32_t row = 0; row < height; ++row) {
    if (TIFFReadScanline(tiff, scanline_buf.data(), row, 0) < 0) {
      break;
    }
  }

  TIFFClose(tiff);

  return 0;
}[0m
