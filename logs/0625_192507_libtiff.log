// Helper to suppress libtiff errors/warnings from printing to stderr,
// which can be noisy and slow down fuzzing.
static void quietHandler(const char*, const char*, va_list) {}

// The main fuzzing entry point.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    // Require a minimum amount of data to proceed.
    if (Size < 256) {
        return 0;
    }
    FuzzedDataProvider fdp(Data, Size);

    // Set custom error and warning handlers to prevent libtiff from exiting
    // or printing to stderr.
    TIFFSetErrorHandler(quietHandler);
    TIFFSetWarningHandler(quietHandler);

    // Use a stringstream for in-memory TIFF creation and processing.
    std::stringstream tiff_stream;

    // --- Write Phase: Create an in-memory TIFF ---
    TIFF* tif_write = TIFFStreamOpen("MemTIFFWrite", &tiff_stream);
    if (!tif_write) {
        return 0;
    }

    // Define image properties using fuzzed data.
    const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
    const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
    const uint16_t samples_per_pixel = fdp.PickValueInArray<uint16_t>({1, 3, 4});
    const uint16_t bits_per_sample = 8;
    uint16_t photometric = (samples_per_pixel == 1) ? PHOTOMETRIC_MINISBLACK : PHOTOMETRIC_RGB;

    // Set fundamental TIFF tags.
    TIFFSetField(tif_write, TIFFTAG_IMAGEWIDTH, width);
    TIFFSetField(tif_write, TIFFTAG_IMAGELENGTH, height);
    TIFFSetField(tif_write, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
    TIFFSetField(tif_write, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
    TIFFSetField(tif_write, TIFFTAG_ORIENTATION, ORIENTATION_TOPLEFT);
    TIFFSetField(tif_write, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
    TIFFSetField(tif_write, TIFFTAG_PHOTOMETRIC, photometric);
    TIFFSetField(tif_write, TIFFTAG_COMPRESSION, COMPRESSION_NONE);

    // Randomly decide whether to use a tiled or stripped layout.
    if (fdp.ConsumeBool()) {
        TIFFSetField(tif_write, TIFFTAG_TILEWIDTH, fdp.ConsumeIntegralInRange<uint32_t>(16, 256));
        TIFFSetField(tif_write, TIFFTAG_TILELENGTH, fdp.ConsumeIntegralInRange<uint32_t>(16, 256));
    } else {
        TIFFSetField(tif_write, TIFFTAG_ROWSPERSTRIP, fdp.ConsumeIntegralInRange<uint32_t>(1, height));
    }

    // Write fuzzed pixel data one scanline at a time.
    tmsize_t line_size = TIFFScanlineSize(tif_write);
    if (line_size > 0 && line_size < fdp.remaining_bytes()) {
        std::vector<uint8_t> scanline_buf = fdp.ConsumeBytes<uint8_t>(line_size);
        for (uint32_t row = 0; row < height; ++row) {
            // Replenish the buffer with new fuzzed data if available.
            if (fdp.remaining_bytes() >= static_cast<size_t>(line_size)) {
                scanline_buf = fdp.ConsumeBytes<uint8_t>(line_size);
            }
            if (scanline_buf.size() == static_cast<size_t>(line_size)) {
                TIFFWriteScanline(tif_write, scanline_buf.data(), row, 0);
            }
        }
    }
    // TIFFClose flushes the directory and all data to the stream.
    TIFFClose(tif_write);

    // --- Read Phase: Read the in-memory TIFF and exercise target APIs ---
    tiff_stream.seekg(0);
    TIFF* tif_read = TIFFStreamOpen("MemTIFFRead", &tiff_stream);
    if (!tif_read) {
        return 0;
    }

    // Allocate a raster buffer to hold the RGBA image data.
    // Memory is allocated using libtiff's internal malloc for consistency.
    uint32_t* raster = (uint32_t*)_TIFFmalloc(width * height * sizeof(uint32_t));
    if (!raster) {
        TIFFClose(tif_read);
        return 0;
    }

    // Target 1: TIFFReadRGBAImageOriented
    // This is a high-level function that will trigger many underlying read operations.
    int stop_on_error = fdp.ConsumeBool();
    TIFFReadRGBAImageOriented(tif_read, width, height, raster, ORIENTATION_TOPLEFT, stop_on_error);

    // Target 2 & 3: TIFFReadRGBAStripExt / TIFFReadRGBATileExt
    // These functions have 0% coverage and are critical to test.
    if (TIFFIsTiled(tif_read)) {
        uint32_t tile_width, tile_height;
        TIFFGetField(tif_read, TIFFTAG_TILEWIDTH, &tile_width);
        TIFFGetField(tif_read, TIFFTAG_TILELENGTH, &tile_height);
        if (tile_width > 0 && tile_height > 0) {
            for (uint32_t y = 0; y < height; y += tile_height) {
                for (uint32_t x = 0; x < width; x += tile_width) {
                    TIFFReadRGBATileExt(tif_read, x, y, raster, stop_on_error);
                }
            }
        }
    } else {
        uint32_t rows_per_strip = 0;
        TIFFGetField(tif_read, TIFFTAG_ROWSPERSTRIP, &rows_per_strip);
        if (rows_per_strip > 0) {
            for (uint32_t row = 0; row < height; row += rows_per_strip) {
                TIFFReadRGBAStripExt(tif_read, row, raster, stop_on_error);
            }
        }
    }

    // --- Cleanup ---
    // Free the raster buffer and close the TIFF handle to prevent memory leaks.
    _TIFFfree(raster);
    TIFFClose(tif_read);

    return 0;
}[0m
