// Entry point for the fuzzer
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzedDataProvider fdp(Data, Size);

  // Use a stringstream for in-memory TIFF writing. This targets the
  // TIFFStreamOpen and related I/O functions in tif_stream.cxx which have
  // some low-coverage areas.
  std::stringstream ostream;

  // Open the TIFF handle using the C++ stream interface.
  // We must static_cast to resolve the ambiguity between istream and ostream.
  TIFF *tif = TIFFStreamOpen("fuzzer.tif", static_cast<std::ostream *>(&ostream));
  if (!tif) {
    return 0;
  }

  // Define basic image parameters, driven by the fuzzer.
  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);

  TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(tif, TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(tif, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);

  // Conditionally test the LogLuv codec, which has very low coverage.
  if (fdp.ConsumeBool()) {
    // This path specifically targets the LogLuv codec functions in tif_luv.c,
    // such as LogLuvEncodeStrip (0% coverage) and LogLuvVSetField (low
    // coverage).
    TIFFSetField(tif, TIFFTAG_COMPRESSION, COMPRESSION_SGILOG);
    TIFFSetField(tif, TIFFTAG_PHOTOMETRIC, PHOTOMETRIC_LOGLUV);
    TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, 32);
    TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, 3);
    TIFFSetField(tif, TIFFTAG_SGILOGDATAFMT, SGILOGDATAFMT_FLOAT);
  } else {
    // Test other common configurations as a baseline.
    TIFFSetField(tif, TIFFTAG_COMPRESSION, COMPRESSION_PACKBITS);
    TIFFSetField(tif, TIFFTAG_PHOTOMETRIC, PHOTOMETRIC_RGB);
    TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, 8);
    TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, 3);
  }

  // Set the strip size. TIFFDefaultStripSize is a safe default.
  TIFFSetField(tif, TIFFTAG_ROWSPERSTRIP, TIFFDefaultStripSize(tif, 0));

  // Write image data one scanline at a time.
  tsize_t scanline_size = TIFFScanlineSize(tif);
  if (scanline_size > 0 && scanline_size < Size) {
    std::vector<uint8_t> scanline_buf(scanline_size);
    for (uint32_t row = 0; row < height; ++row) {
      // Fill buffer with fuzzer data if available to introduce variation.
      if (fdp.remaining_bytes() >= scanline_buf.size()) {
        fdp.ConsumeData(scanline_buf.data(), scanline_buf.size());
      }
      // Always write the scanline, even if new data was not available.
      // This ensures the image is written completely, preventing a crash
      // in TIFFClose when handling partially written strips.
      if (TIFFWriteScanline(tif, scanline_buf.data(), row, 0) < 0) {
        break; // Stop if writing fails
      }
    }
  }

  // Conditionally create a GPS directory to target the
  // TIFFCreateGPSDirectory function, which has 0% coverage.
  if (fdp.ConsumeBool()) {
    TIFFCreateGPSDirectory(tif);
    // Set a tag to make the directory non-empty.
    const uint8_t gps_version[] = {2, 2, 0, 0};
    TIFFSetField(tif, GPSTAG_VERSIONID, gps_version);
    // The directory will be written by TIFFClose.
  }

  // Close the TIFF handle. This flushes all written data and cleans up memory.
  TIFFClose(tif);

  return 0;
}[0m
