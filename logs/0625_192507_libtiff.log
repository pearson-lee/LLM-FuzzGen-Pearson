        }
    }
    
    TIFFPrintDirectory(tiff_read, stdout, 0);

    uint64_t exif_offset = 0;
    if (TIFFGetField(tiff_read, TIFFTAG_EXIFIFD, &exif_offset) == 1 && exif_offset > 0) {
