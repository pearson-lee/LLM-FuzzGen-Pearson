#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <sstream>
#include <string>
#include <vector>

#include "fuzzer/FuzzedDataProvider.h"
#include "tiffio.h"

// Custom stream implementation for in-memory fuzzing
struct TiffStream {
  std::stringstream stream;
};

static tmsize_t read_proc(thandle_t handle, void *data, tmsize_t size) {
  TiffStream *ts = reinterpret_cast<TiffStream *>(handle);
  ts->stream.read(static_cast<char *>(data), size);
  return ts->stream.gcount();
}

static tmsize_t write_proc(thandle_t handle, void *data, tmsize_t size) {
  TiffStream *ts = reinterpret_cast<TiffStream *>(handle);
  ts->stream.write(static_cast<char *>(data), size);
  return size;
}

static toff_t seek_proc(thandle_t handle, toff_t offset, int whence) {
  TiffStream *ts = reinterpret_cast<TiffStream *>(handle);
  if (whence == SEEK_SET) {
    ts->stream.seekg(offset, std::ios_base::beg);
    ts->stream.seekp(offset, std::ios_base::beg);
  } else if (whence == SEEK_CUR) {
    ts->stream.seekg(offset, std::ios_base::cur);
    ts->stream.seekp(offset, std::ios_base::cur);
  } else if (whence == SEEK_END) {
    ts->stream.seekg(offset, std::ios_base::end);
    ts->stream.seekp(offset, std::ios_base::end);
  }
  return ts->stream.tellg();
}

static int close_proc(thandle_t) { return 0; }

static toff_t size_proc(thandle_t handle) {
  TiffStream *ts = reinterpret_cast<TiffStream *>(handle);
  auto original_pos = ts->stream.tellg();
  ts->stream.seekg(0, std::ios_base::end);
  auto size = ts->stream.tellg();
  ts->stream.seekg(original_pos, std::ios_base::beg);
  return size;
}

static int map_proc(thandle_t, void **, toff_t *) { return 0; }

static void unmap_proc(thandle_t, void *, toff_t) {}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 100) {
    return 0;
  }

  FuzzedDataProvider fdp(data, size);

  TiffStream tiff_stream;

  // Create an in-memory TIFF for writing
  TIFF *tif_write = TIFFClientOpen("fuzz_write", "w",
                                   reinterpret_cast<thandle_t>(&tiff_stream),
                                   read_proc, write_proc, seek_proc, close_proc,
                                   size_proc, map_proc, unmap_proc);
  if (!tif_write) {
    return 0;
  }

  // Define image properties using fuzzer data
  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint16_t samples_per_pixel = fdp.PickValueInArray<uint16_t>({1, 3, 4});
  const uint16_t bits_per_sample = fdp.PickValueInArray<uint16_t>({8, 16});
  const uint16_t compression = fdp.PickValueInArray<uint16_t>(
      {COMPRESSION_NONE, COMPRESSION_PACKBITS, COMPRESSION_LZW});
  const uint16_t photometric =
      (samples_per_pixel == 1) ? PHOTOMETRIC_MINISBLACK : PHOTOMETRIC_RGB;

  // Set mandatory TIFF fields
  TIFFSetField(tif_write, TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(tif_write, TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(tif_write, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
  TIFFSetField(tif_write, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
  TIFFSetField(tif_write, TIFFTAG_ORIENTATION, ORIENTATION_TOPLEFT);
  TIFFSetField(tif_write, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
  TIFFSetField(tif_write, TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(tif_write, TIFFTAG_COMPRESSION, compression);

  // Write scanline data
  tmsize_t scanline_size = TIFFScanlineSize(tif_write);
  if (scanline_size > 0) {
    std::vector<uint8_t> scanline_buf(scanline_size);
    for (uint32_t row = 0; row < height; ++row) {
      if (fdp.remaining_bytes() < scanline_size) {
        break;
      }
      auto line_data = fdp.ConsumeBytes<uint8_t>(scanline_size);
      // Use fuzzer data if available, otherwise use the pre-filled buffer
      uint8_t *data_to_write =
          (line_data.size() == scanline_size)
              ? line_data.data()
              : scanline_buf.data();
      if (TIFFWriteScanline(tif_write, data_to_write, row, 0) < 0) {
        break;
      }
    }
  }

  // Write the directory and close the write handle
  TIFFWriteDirectory(tif_write);
  TIFFClose(tif_write);

  // Rewind the stream to the beginning for reading
  tiff_stream.stream.seekg(0);

  // Open the in-memory TIFF for reading
  TIFF *tif_read = TIFFClientOpen(
      "fuzz_read", "r", reinterpret_cast<thandle_t>(&tiff_stream), read_proc,
      write_proc, seek_proc, close_proc, size_proc, map_proc, unmap_proc);

  if (tif_read) {
    uint32_t read_width, read_height;
    TIFFGetField(tif_read, TIFFTAG_IMAGEWIDTH, &read_width);
    TIFFGetField(tif_read, TIFFTAG_IMAGELENGTH, &read_height);

    // Allocate buffer for reading the entire image
    tmsize_t raster_size = read_width * read_height * 4;
    if (raster_size > 0 && raster_size < 10000000) { // Avoid huge allocations
      uint32_t *raster = (uint32_t *)_TIFFmalloc(raster_size);
      if (raster) {
        // Attempt to read the image data using TIFFReadRGBAStrip
        TIFFReadRGBAStrip(tif_read, 0, raster);
        _TIFFfree(raster);
      }
    }
    TIFFClose(tif_read);
  }

  return 0;
}[0m
