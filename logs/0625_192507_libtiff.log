    for (uint32_t row = 0; row < height; ++row) {
      TIFFReadScanline(tif_read, read_buf.data(), row, 0);
    }
  }

  // Final cleanup: ensure the read handle is closed to free resources.
  TIFFClose(tif_read);

  return 0;
