#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>
#include <fuzzer/FuzzedDataProvider.h>
#include "tiffio.h"

// Helper to suppress libtiff errors and warnings, which are not useful for fuzzing.
void DummyHandler(const char*, const char*, va_list) {}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
    FuzzedDataProvider fdp(data, size);

    // Suppress error messages from libtiff to keep the fuzzer output clean.
    TIFFSetErrorHandler(DummyHandler);
    TIFFSetWarningHandler(DummyHandler);

    char filename[] = "/tmp/fuzz.tif";

    // --- Strip-based Image Phase ---
    // Open a temporary file for writing a striped TIFF.
    TIFF* tif_write_strip = TIFFOpen(filename, "w");
    if (!tif_write_strip) {
        return 0;
    }

    // Set basic TIFF fields using fuzzed data to create diverse image configurations.
    const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
    const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
    const uint16_t bps = fdp.PickValueInArray<uint16_t>({1, 2, 4, 8, 16});
    const uint16_t spp = fdp.ConsumeIntegralInRange<uint16_t>(1, 4);
    const uint16_t planarconfig = fdp.PickValueInArray<uint16_t>({PLANARCONFIG_CONTIG, PLANARCONFIG_SEPARATE});
    const uint16_t photometric = fdp.PickValueInArray<uint16_t>({PHOTOMETRIC_MINISWHITE, PHOTOMETRIC_MINISBLACK, PHOTOMETRIC_RGB, PHOTOMETRIC_PALETTE, PHOTOMETRIC_MASK, PHOTOMETRIC_SEPARATED, PHOTOMETRIC_YCBCR, PHOTOMETRIC_CIELAB});
    const uint16_t compression = fdp.PickValueInArray<uint16_t>({COMPRESSION_NONE, COMPRESSION_LZW, COMPRESSION_PACKBITS, COMPRESSION_JPEG, COMPRESSION_DEFLATE});
    uint32_t rowsperstrip = fdp.ConsumeIntegralInRange<uint32_t>(1, height);

    TIFFSetField(tif_write_strip, TIFFTAG_IMAGEWIDTH, width);
    TIFFSetField(tif_write_strip, TIFFTAG_IMAGELENGTH, height);
    TIFFSetField(tif_write_strip, TIFFTAG_BITSPERSAMPLE, bps);
    TIFFSetField(tif_write_strip, TIFFTAG_SAMPLESPERPIXEL, spp);
    TIFFSetField(tif_write_strip, TIFFTAG_PLANARCONFIG, planarconfig);
    TIFFSetField(tif_write_strip, TIFFTAG_PHOTOMETRIC, photometric);
    TIFFSetField(tif_write_strip, TIFFTAG_COMPRESSION, compression);
    TIFFSetField(tif_write_strip, TIFFTAG_ROWSPERSTRIP, rowsperstrip);

    // Write some scanlines to the striped TIFF using TIFFWriteScanline.
    tmsize_t scanline_size = TIFFScanlineSize(tif_write_strip);
    if (scanline_size > 0 && scanline_size < size) {
        std::vector<uint8_t> scanline_buf(scanline_size);
        if (fdp.remaining_bytes() > scanline_size) {
            fdp.ConsumeData(scanline_buf.data(), scanline_size);
        }
        for (int i = 0; i < fdp.ConsumeIntegralInRange(1, 3); ++i) {
            uint32_t row = fdp.ConsumeIntegralInRange<uint32_t>(0, height -1);
            TIFFWriteScanline(tif_write_strip, scanline_buf.data(), row, 0);
        }
    }

    // Exercise TIFFPrintDirectory with various flags. Output is sent to /dev/null.
    FILE* dev_null = fopen("/dev/null", "w");
    if (dev_null) {
        TIFFPrintDirectory(tif_write_strip, dev_null, fdp.ConsumeIntegral<uint32_t>());
        fclose(dev_null);
    }

    // Exercise TIFFCreateGPSDirectory.
    if (fdp.ConsumeBool()) {
        TIFFCreateGPSDirectory(tif_write_strip);
    }

    TIFFWriteDirectory(tif_write_strip);
    TIFFClose(tif_write_strip);

    // Re-open the striped TIFF for reading.
    TIFF* tif_read_strip = TIFFOpen(filename, "r");
    if (tif_read_strip) {
        uint32_t read_width, read_height, rps;
        TIFFGetField(tif_read_strip, TIFFTAG_IMAGEWIDTH, &read_width);
        TIFFGetField(tif_read_strip, TIFFTAG_IMAGELENGTH, &read_height);
        TIFFGetFieldDefaulted(tif_read_strip, TIFFTAG_ROWSPERSTRIP, &rps);
        if (rps > 0 && read_width > 0 && read_height > 0) {
            uint32_t buffer_size = read_width * rps;
            // Avoid large allocations.
            if (buffer_size > 0 && buffer_size < 1000000) {
                uint32_t* raster = (uint32_t*)_TIFFmalloc(buffer_size * sizeof(uint32_t));
                if (raster) {
                    uint32_t row_to_read = 0;
                    if (read_height > rps) {
                        row_to_read = fdp.ConsumeIntegralInRange<uint32_t>(0, (read_height - 1) / rps) * rps;
                    }
                    // Exercise TIFFReadRGBAStripExt.
                    TIFFReadRGBAStripExt(tif_read_strip, row_to_read, raster, fdp.ConsumeBool());
                    _TIFFfree(raster);
                }
            }
        }
        TIFFClose(tif_read_strip);
    }

    // --- Tiled Image Phase ---
    // Overwrite the file with a tiled TIFF.
    TIFF* tif_write_tile = TIFFOpen(filename, "w");
    if (!tif_write_tile) {
        unlink(filename);
        return 0;
    }

    uint32_t tile_width = fdp.ConsumeIntegralInRange<uint32_t>(16, 256);
    uint32_t tile_height = fdp.ConsumeIntegralInRange<uint32_t>(16, 256);
    tile_width = (tile_width / 16) * 16;
    tile_height = (tile_height / 16) * 16;
    if (tile_width == 0) tile_width = 16;
    if (tile_height == 0) tile_height = 16;

    TIFFSetField(tif_write_tile, TIFFTAG_IMAGEWIDTH, width);
    TIFFSetField(tif_write_tile, TIFFTAG_IMAGELENGTH, height);
    TIFFSetField(tif_write_tile, TIFFTAG_BITSPERSAMPLE, 8);
    TIFFSetField(tif_write_tile, TIFFTAG_SAMPLESPERPIXEL, 4);
    TIFFSetField(tif_write_tile, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
    TIFFSetField(tif_write_tile, TIFFTAG_PHOTOMETRIC, PHOTOMETRIC_RGB);
    TIFFSetField(tif_write_tile, TIFFTAG_TILEWIDTH, tile_width);
    TIFFSetField(tif_write_tile, TIFFTAG_TILELENGTH, tile_height);

    TIFFClose(tif_write_tile);

    // Re-open the tiled TIFF for reading.
    TIFF* tif_read_tile = TIFFOpen(filename, "r");
    if (tif_read_tile) {
        uint32_t read_width, read_height, tw, th;
        TIFFGetField(tif_read_tile, TIFFTAG_IMAGEWIDTH, &read_width);
        TIFFGetField(tif_read_tile, TIFFTAG_IMAGELENGTH, &read_height);
        TIFFGetField(tif_read_tile, TIFFTAG_TILEWIDTH, &tw);
        TIFFGetField(tif_read_tile, TIFFTAG_TILELENGTH, &th);

        if (tw > 0 && th > 0 && read_width > 0 && read_height > 0) {
            uint32_t buffer_size = tw * th;
            if (buffer_size > 0 && buffer_size < 1000000) {
                uint32_t* raster = (uint32_t*)_TIFFmalloc(buffer_size * sizeof(uint32_t));
                if (raster) {
                    uint32_t col_to_read = 0;
                    uint32_t row_to_read = 0;
                    if (read_width > tw) {
                        col_to_read = fdp.ConsumeIntegralInRange<uint32_t>(0, (read_width - 1) / tw) * tw;
                    }
                    if (read_height > th) {
                        row_to_read = fdp.ConsumeIntegralInRange<uint32_t>(0, (read_height - 1) / th) * th;
                    }
                    // Exercise TIFFReadRGBATileExt.
                    TIFFReadRGBATileExt(tif_read_tile, col_to_read, row_to_read, raster, fdp.ConsumeBool());
                    _TIFFfree(raster);
                }
            }
        }
        TIFFClose(tif_read_tile);
    }

    // Clean up the temporary file.
    unlink(filename);

    return 0;
}[0m
