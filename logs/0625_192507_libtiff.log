#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <iostream>
#include <memory>
#include <sstream>
#include <vector>

#include "fuzzer/FuzzedDataProvider.h"
#include "tiffio.h"

// TIFF stream callback for reading from an std::stringstream
static tmsize_t read_from_stream(thandle_t handle, void *buffer, tmsize_t size) {
  std::stringstream *ss = reinterpret_cast<std::stringstream *>(handle);
  ss->read(static_cast<char *>(buffer), size);
  return ss->gcount();
}

// TIFF stream callback for writing to an std::stringstream
static tmsize_t write_to_stream(thandle_t handle, void *buffer, tmsize_t size) {
  std::stringstream *ss = reinterpret_cast<std::stringstream *>(handle);
  ss->write(static_cast<char *>(buffer), size);
  return size;
}

// TIFF stream callback for seeking within an std::stringstream
static toff_t seek_in_stream(thandle_t handle, toff_t offset, int whence) {
  std::stringstream *ss = reinterpret_cast<std::stringstream *>(handle);
  std::ios_base::seekdir dir;
  switch (whence) {
  case SEEK_SET:
    dir = std::ios_base::beg;
    break;
  case SEEK_CUR:
    dir = std::ios_base::cur;
    break;
  case SEEK_END:
    dir = std::ios_base::end;
    break;
  default:
    return static_cast<toff_t>(-1);
  }

  ss->seekg(offset, dir);
  if (ss->fail()) {
    ss->clear(); // Clear failure flags
    ss->seekg(offset, dir);
  }
  ss->seekp(offset, dir);
  if (ss->fail()) {
    ss->clear(); // Clear failure flags
    ss->seekp(offset, dir);
  }

  return ss->tellg();
}

// TIFF stream callback for closing (no-op for stringstream)
static int close_stream(thandle_t) { return 0; }

// TIFF stream callback for getting the size of the stringstream
static toff_t size_of_stream(thandle_t handle) {
  std::stringstream *ss = reinterpret_cast<std::stringstream *>(handle);
  std::streampos original_pos = ss->tellg();
  ss->seekg(0, std::ios::end);
  toff_t size = ss->tellg();
  ss->seekg(original_pos);
  return size;
}

// Dummy map/unmap functions required by TIFFClientOpen
static int map_file(thandle_t, void **, toff_t *) { return 0; }
static void unmap_file(thandle_t, void *, toff_t) {}

// Suppress error and warning messages from libtiff
static void quiet_handler(const char *, const char *, va_list) {}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 100) {
    return 0;
  }

  FuzzedDataProvider fdp(data, size);
  std::stringstream tiff_stream;

  TIFFSetErrorHandler(quiet_handler);
  TIFFSetWarningHandler(quiet_handler);

  // Open a TIFF stream for writing
  TIFF *tiff_write = TIFFClientOpen("fuzz_write", "w", reinterpret_cast<thandle_t>(&tiff_stream), read_from_stream, write_to_stream, seek_in_stream, close_stream, size_of_stream, map_file, unmap_file);
  if (!tiff_write) {
    return 0;
  }

  // Define image properties using fuzzer data
  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint16_t samples_per_pixel = fdp.PickValueInArray<uint16_t>({1, 3, 4});
  const uint16_t bits_per_sample = fdp.PickValueInArray<uint16_t>({8, 16});
  const uint16_t photometric = (samples_per_pixel == 1) ? PHOTOMETRIC_MINISBLACK : PHOTOMETRIC_RGB;
  const uint16_t compression = fdp.PickValueInArray<uint16_t>({COMPRESSION_NONE, COMPRESSION_PACKBITS, COMPRESSION_LZW});
  const uint32_t rows_per_strip = fdp.ConsumeIntegralInRange<uint32_t>(1, height);

  // Set TIFF fields required for a basic image
  TIFFSetField(tiff_write, TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(tiff_write, TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(tiff_write, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
  TIFFSetField(tiff_write, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
  TIFFSetField(tiff_write, TIFFTAG_ORIENTATION, ORIENTATION_TOPLEFT);
  TIFFSetField(tiff_write, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
  TIFFSetField(tiff_write, TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(tiff_write, TIFFTAG_COMPRESSION, compression);
  TIFFSetField(tiff_write, TIFFTAG_ROWSPERSTRIP, rows_per_strip);

  // Write scanline data
  tmsize_t scanline_size = TIFFScanlineSize(tiff_write);
  if (scanline_size > 0) {
    std::vector<uint8_t> scanline_buf = fdp.ConsumeBytes<uint8_t>(scanline_size);
    if (scanline_buf.size() == scanline_size) {
      for (uint32_t row = 0; row < height; ++row) {
        TIFFWriteScanline(tiff_write, scanline_buf.data(), row, 0);
      }
    }
  }

  // Write a custom directory to exercise this uncovered function
  uint64_t dir_offset = 0;
  TIFFWriteCustomDirectory(tiff_write, &dir_offset);

  // Close the write handle, which flushes all data to the stringstream
  TIFFClose(tiff_write);

  // --- Reading Phase ---
  // Rewind the stream to the beginning to read the data we just wrote
  tiff_stream.seekg(0);

  TIFF *tiff_read = TIFFClientOpen("fuzz_read", "r", reinterpret_cast<thandle_t>(&tiff_stream), read_from_stream, write_to_stream, seek_in_stream, close_stream, size_of_stream, map_file, unmap_file);
  if (!tiff_read) {
    return 0;
  }

  // Attempt to read the RGBA image, exercising read paths
  uint32_t read_width, read_height;
  TIFFGetField(tiff_read, TIFFTAG_IMAGEWIDTH, &read_width);
  TIFFGetField(tiff_read, TIFFTAG_IMAGELENGTH, &read_height);

  if (read_width > 0 && read_height > 0) {
    // Prevent enormous allocations
    if (read_width > 8192 || read_height > 8192) {
        TIFFClose(tiff_read);
        return 0;
    }
    size_t raster_size = read_width * read_height * 4;
    if (raster_size > 0) {
      uint32_t *raster = (uint32_t *)_TIFFmalloc(raster_size);
      if (raster) {
        // Use TIFFReadRGBAImageOriented to handle different orientations
        TIFFReadRGBAImageOriented(tiff_read, read_width, read_height, raster, ORIENTATION_TOPLEFT, 0);
        _TIFFfree(raster);
      }
    }
  }

  // Safely close the read handle to free all associated resources
  TIFFClose(tiff_read);

  return 0;
}[0m
