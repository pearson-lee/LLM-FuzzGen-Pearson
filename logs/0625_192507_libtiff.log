// Dummy error and warning handlers to prevent libtiff from printing to stderr,
// which can slow down fuzzing.
void fuzz_error_handler(const char* module, const char* fmt, va_list ap) {
    // no-op
}
void fuzz_warning_handler(const char* module, const char* fmt, va_list ap) {
    // no-op
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    FuzzedDataProvider fdp(data, size);

    // Set custom error and warning handlers to suppress console output.
    TIFFSetErrorHandler(fuzz_error_handler);
    TIFFSetWarningHandler(fuzz_warning_handler);

    // Use a stringstream for in-memory TIFF creation to avoid filesystem I/O.
    std::ostringstream out_stream;
    // The name "fuzz_write" is arbitrary for stream-based operations.
    TIFF *tif_write = TIFFStreamOpen("fuzz_write", &out_stream);
    if (!tif_write) {
        return 0;
    }

    // === Stage 1: Write a TIFF to the in-memory stream ===
    
    // Define image properties using the fuzzer for variety.
    const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
    const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
    const uint16_t bits_per_sample = fdp.PickValueInArray<uint16_t>({1, 2, 4, 8, 16});
    const uint16_t samples_per_pixel = fdp.ConsumeIntegralInRange<uint16_t>(1, 4);
    uint16_t compression = fdp.PickValueInArray<uint16_t>({
        COMPRESSION_NONE, 
        COMPRESSION_LZW, 
        COMPRESSION_PACKBITS, 
        COMPRESSION_SGILOG // Target: LogLuvEncodeStrip
    });
    uint16_t photometric = fdp.PickValueInArray<uint16_t>({
        PHOTOMETRIC_MINISWHITE, 
        PHOTOMETRIC_MINISBLACK, 
        PHOTOMETRIC_RGB,
    });
    // The LogLuv codec requires a specific photometric interpretation.
    if (compression == COMPRESSION_SGILOG) {
        photometric = PHOTOMETRIC_LOGLUV;
    }

    // Set core TIFF fields.
    TIFFSetField(tif_write, TIFFTAG_IMAGEWIDTH, width);
    TIFFSetField(tif_write, TIFFTAG_IMAGELENGTH, height);
    TIFFSetField(tif_write, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
    TIFFSetField(tif_write, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
    TIFFSetField(tif_write, TIFFTAG_COMPRESSION, compression);
    TIFFSetField(tif_write, TIFFTAG_PHOTOMETRIC, photometric);
    TIFFSetField(tif_write, TIFFTAG_PLANARCONFIG, fdp.PickValueInArray<uint16_t>({PLANARCONFIG_CONTIG, PLANARCONFIG_SEPARATE}));
    
    // Randomly decide whether to write a tiled or stripped image to cover both paths.
    if (fdp.ConsumeBool()) {
        TIFFSetField(tif_write, TIFFTAG_TILEWIDTH, fdp.ConsumeIntegralInRange<uint32_t>(16, 256));
        TIFFSetField(tif_write, TIFFTAG_TILELENGTH, fdp.ConsumeIntegralInRange<uint32_t>(16, 256));
    } else {
        TIFFSetField(tif_write, TIFFTAG_ROWSPERSTRIP, fdp.ConsumeIntegralInRange<uint32_t>(1, height));
    }

    // Write image data one scanline at a time.
    // This will internally call the appropriate encoder, like LogLuvEncodeStrip.
    tmsize_t scanline_size = TIFFScanlineSize(tif_write);
    if (scanline_size > 0 && scanline_size < size) {
        std::vector<uint8_t> scanline_buf(scanline_size);
        for (uint32_t row = 0; row < height; ++row) {
            if (fdp.remaining_bytes() > scanline_buf.size()) {
                fdp.ConsumeData(scanline_buf.data(), scanline_buf.size());
            }
            // Target: TIFFWriteScanline
            TIFFWriteScanline(tif_write, scanline_buf.data(), row, 0);
        }
    }

    // Target: TIFFCreateGPSDirectory. This tests metadata handling.
    TIFFCreateGPSDirectory(tif_write);
    TIFFWriteDirectory(tif_write);

    // Finalize and close the write stream, flushing all data to the stringstream.
    // This also frees all memory associated with the TIFF write handle.
    TIFFClose(tif_write);

    std::string tiff_data = out_stream.str();
    if (tiff_data.empty()) {
        return 0;
    }

    // === Stage 2: Read the generated TIFF from the in-memory stream ===

    std::istringstream in_stream(tiff_data);
    TIFF *tif_read = TIFFStreamOpen("fuzz_read", &in_stream);
    if (!tif_read) {
