#include "tiffio.h"
#include "tiffio.hxx"
#include <fuzzer/FuzzedDataProvider.h>
#include <sstream>
#include <vector>
#include <cstdint>
#include <memory>

// RAII wrapper for the TIFF structure to ensure resources are released.
// The destructor calls TIFFClose, which is crucial for flushing writes
// and freeing memory.
class TiffHandle {
public:
