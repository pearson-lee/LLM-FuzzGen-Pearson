static void quietHandler(const char *, const char *, va_list) {}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  if (Size == 0) {
    return 0;
  }
  FuzzedDataProvider fdp(Data, Size);

  // Set custom error and warning handlers to suppress console output.
  TIFFSetErrorHandler(quietHandler);
  TIFFSetWarningHandler(quietHandler);

  // Use a stringstream for in-memory TIFF processing, avoiding slow file I/O.
  std::stringstream stream;

  // 1. Open a TIFF image for writing using TIFFStreamOpen.
  // The mode ("w" for classic, "w8" for BigTIFF) is chosen by the fuzzer.
  const char *mode = fdp.PickValueInArray({"w", "w8"});
  TIFF *tif_write = TIFFStreamOpen("MemTIFF", &stream, mode);
  if (!tif_write) {
    return 0;
  }

  // 2. Configure the TIFF directory using TIFFSetField with fuzzer-driven values.
  // This explores a wide range of image configurations.
  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint16_t bps = fdp.PickValueInArray<uint16_t>({1, 2, 4, 8, 16});
  const uint16_t spp = fdp.ConsumeIntegralInRange<uint16_t>(1, 4);
  const uint16_t compression = fdp.PickValueInArray<uint16_t>(
      {COMPRESSION_NONE, COMPRESSION_PACKBITS, COMPRESSION_LZW,
       COMPRESSION_DEFLATE, COMPRESSION_ADOBE_DEFLATE});
  uint16_t photometric =
      (spp >= 3) ? PHOTOMETRIC_RGB : PHOTOMETRIC_MINISBLACK;

  TIFFSetField(tif_write, TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(tif_write, TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(tif_write, TIFFTAG_BITSPERSAMPLE, bps);
  TIFFSetField(tif_write, TIFFTAG_SAMPLESPERPIXEL, spp);
  TIFFSetField(tif_write, TIFFTAG_COMPRESSION, compression);
  TIFFSetField(tif_write, TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(tif_write, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
  TIFFSetField(tif_write, TIFFTAG_ROWSPERSTRIP,
               fdp.ConsumeIntegralInRange<uint32_t>(1, height));

  // 3. Write image data using TIFFWriteScanline.
  // This exercises the core writing and compression logic.
  tmsize_t scanline_size = TIFFScanlineSize(tif_write);
  if (scanline_size > 0) {
    std::vector<uint8_t> scanline_buf =
        fdp.ConsumeBytes<uint8_t>(scanline_size);
    if (scanline_buf.size() == scanline_size) {
      for (uint32_t row = 0; row < height; ++row) {
        TIFFWriteScanline(tif_write, scanline_buf.data(), row, 0);
      }
    }
  }

  // Safely close the TIFF handle, which flushes all written data to the stream.
  TIFFClose(tif_write);

  // Rewind the stream to read the TIFF data we just wrote.
  stream.seekg(0);

  // Open the in-memory TIFF for reading.
  TIFF *tif_read = TIFFStreamOpen("MemTIFF", &stream, "r");
  if (!tif_read) {
    return 0;
  }

  // 4. Exercise the directory printing logic using TIFFPrintDirectory.
  // This function has very low coverage and is a good target.
  // We pass a flag to prevent it from printing sample values.
  TIFFPrintDirectory(tif_read, stdout, TIFFPRINT_NOSAMPLES);

  // 5. Read the image data back using TIFFReadScanline.
  // This tests the decompression and reading pathways.
  tmsize_t read_scanline_size = TIFFScanlineSize(tif_read);
  if (read_scanline_size > 0) {
    // The vector's memory is automatically managed, preventing leaks.
