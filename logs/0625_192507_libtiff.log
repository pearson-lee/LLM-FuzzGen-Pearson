#include <cstdint>
#include <vector>
#include <sstream>

#include "fuzzer/FuzzedDataProvider.h"
#include "tiffio.h"
#include "tiffio.hxx"

// Dummy error and warning handlers to prevent libtiff from printing to stderr,
// which can slow down fuzzing and is generally discouraged.
static void dummy_error_handler(const char*, const char*, va_list) {}
static void dummy_warning_handler(const char*, const char*, va_list) {}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  // Require a minimum amount of data to avoid trivial cases.
  if (size < 100) {
    return 0;
  }

  FuzzedDataProvider fdp(data, size);

  // Set custom error handlers to suppress console output.
  TIFFSetErrorHandler(dummy_error_handler);
  TIFFSetWarningHandler(dummy_warning_handler);

  // Use a stringstream for in-memory TIFF data, which is ideal for fuzzing.
  std::stringstream tiff_stream;

  // --- Phase 1: Write a TIFF image to the in-memory stream ---
  // Use TIFFStreamOpen to work with the C++ iostream interface.
  TIFF* write_tif = TIFFStreamOpen("mem_write.tif", &tiff_stream);
  if (!write_tif) {
    return 0;
  }

  // Define image properties, fuzzed to explore different configurations.
  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 256);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 256);
  const uint16_t samples_per_pixel = fdp.PickValueInArray<uint16_t>({1, 3, 4});
  const uint16_t bits_per_sample = 8;
  const uint16_t photometric = (samples_per_pixel == 1) ? PHOTOMETRIC_MINISBLACK : PHOTOMETRIC_RGB;
  const uint16_t planar_config = PLANARCONFIG_CONTIG;
  // Fuzzing the compression type is critical for exploring different codecs.
  const uint16_t compression = fdp.PickValueInArray<uint16_t>({
      COMPRESSION_NONE, 
      COMPRESSION_LZW, 
      COMPRESSION_PACKBITS, 
      COMPRESSION_DEFLATE, 
      COMPRESSION_ADOBE_DEFLATE
  });
  const uint32_t rows_per_strip = fdp.ConsumeIntegralInRange<uint32_t>(1, height);

  // Set mandatory TIFF fields using the fuzzed parameters.
  TIFFSetField(write_tif, TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(write_tif, TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(write_tif, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
  TIFFSetField(write_tif, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
  TIFFSetField(write_tif, TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(write_tif, TIFFTAG_PLANARCONFIG, planar_config);
  TIFFSetField(write_tif, TIFFTAG_COMPRESSION, compression);
  TIFFSetField(write_tif, TIFFTAG_ROWSPERSTRIP, rows_per_strip);

  // Write image data strip by strip.
  tmsize_t strip_size = TIFFStripSize(write_tif);
  if (strip_size > 0) {
    std::vector<uint8_t> strip_buf = fdp.ConsumeRemainingBytes<uint8_t>();
    // Ensure the buffer is large enough for the strip.
    if (strip_buf.size() < strip_size) {
        strip_buf.resize(strip_size, 0);
    }
    
    for (uint32_t strip = 0; strip < TIFFNumberOfStrips(write_tif); ++strip) {
      // Use TIFFWriteEncodedStrip to test strip writing logic.
      if (TIFFWriteEncodedStrip(write_tif, strip, strip_buf.data(), strip_size) < 0) {
        break;
      }
    }
  }

  // Close the write handle, which flushes all data to the stringstream.
  TIFFClose(write_tif);

  // --- Phase 2: Read the TIFF image back from the stream ---
  std::string tiff_data = tiff_stream.str();
  if (tiff_data.empty()) {
    return 0;
  }

  // Rewind the stream to be read from the beginning.
  tiff_stream.seekg(0);

  TIFF* read_tif = TIFFStreamOpen("mem_read.tif", &tiff_stream);
  if (!read_tif) {
    return 0;
  }

  uint32_t read_width = 0, read_height = 0;
  TIFFGetField(read_tif, TIFFTAG_IMAGEWIDTH, &read_width);
  TIFFGetField(read_tif, TIFFTAG_IMAGELENGTH, &read_height);

  // Check for valid dimensions to avoid excessive memory allocation.
  if (read_width > 0 && read_height > 0 && read_width <= 1024 && read_height <= 1024) {
    uint64_t npixels = (uint64_t)read_width * read_height;
    // Use _TIFFmalloc and _TIFFfree as recommended by libtiff for memory management.
    uint32_t* raster = (uint32_t*)_TIFFmalloc(npixels * sizeof(uint32_t));
    if (raster) {
      // Use TIFFReadRGBAImage to test the high-level reading interface.
      // This function handles different compression schemes and data arrangements.
      // The stop_on_error flag is set to 1 to prevent libtiff from exiting.
      TIFFReadRGBAImage(read_tif, read_width, read_height, raster, 1);
      
      // Also specifically test TIFFReadRGBAStripExt, which has 0% coverage.
      // We read the first row into the beginning of the same raster buffer.
      TIFFReadRGBAStripExt(read_tif, 0, raster, 1);

      // Free the allocated raster buffer to prevent memory leaks.
      _TIFFfree(raster);
    }
  }

  // Close the read handle and release associated resources.
  TIFFClose(read_tif);

  return 0;
}[0m
