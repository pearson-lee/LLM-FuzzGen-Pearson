#include <fuzzer/FuzzedDataProvider.h>
#include <cstdint>
#include <memory>
#include <sstream>
#include <vector>

// Include libtiff headers with full paths as required
#include "/src/libtiff/libtiff/tiffio.h"
#include "/src/libtiff/libtiff/tiffiop.h"

// Custom deleter for TIFF pointers to ensure TIFFClose is always called.
// This is crucial for resource management and preventing memory leaks.
struct TiffDeleter {
  void operator()(TIFF* tif) {
    if (tif) {
      TIFFClose(tif);
    }
  }
};

using TiffUniquePtr = std::unique_ptr<TIFF, TiffDeleter>;

extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  FuzzedDataProvider fdp(data, size);
  if (size < 100) {
    return 0;
  }

  // Use a stringstream for in-memory TIFF data, avoiding file I/O.
  std::stringstream tiff_stream;

  // Scope for the writing process.
  {
    // Create a TIFF handle for writing to the in-memory stream.
    // The TiffUniquePtr ensures TIFFClose is called upon leaving the scope.
    TiffUniquePtr tif_write = TiffUniquePtr(TIFFStreamOpen("mem_write.tif", &tiff_stream));
    if (!tif_write) {
      return 0;
    }

    // Create 1 to 3 directories to test multi-page TIFF handling.
    int num_directories = fdp.ConsumeIntegralInRange<int>(1, 3);
    for (int i = 0; i < num_directories; ++i) {
      // Fuzz basic image parameters.
      uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
      uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
      uint16_t samples_per_pixel = fdp.PickValueInArray<uint16_t>({1, 3, 4});
      uint16_t bits_per_sample = fdp.PickValueInArray<uint16_t>({8, 16});
      uint16_t compression = fdp.PickValueInArray<uint16_t>({COMPRESSION_NONE, COMPRESSION_LZW, COMPRESSION_PACKBITS, COMPRESSION_DEFLATE});
      uint16_t photometric = (samples_per_pixel == 1) ? PHOTOMETRIC_MINISBLACK : PHOTOMETRIC_RGB;
      uint32_t tile_width = fdp.ConsumeIntegralInRange<uint32_t>(16, 128);
      uint32_t tile_height = fdp.ConsumeIntegralInRange<uint32_t>(16, 128);

      // Set the required fields for a tiled TIFF.
      TIFFSetField(tif_write.get(), TIFFTAG_IMAGEWIDTH, width);
      TIFFSetField(tif_write.get(), TIFFTAG_IMAGELENGTH, height);
      TIFFSetField(tif_write.get(), TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
      TIFFSetField(tif_write.get(), TIFFTAG_BITSPERSAMPLE, bits_per_sample);
      TIFFSetField(tif_write.get(), TIFFTAG_COMPRESSION, compression);
      TIFFSetField(tif_write.get(), TIFFTAG_PHOTOMETRIC, photometric);
      TIFFSetField(tif_write.get(), TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
      TIFFSetField(tif_write.get(), TIFFTAG_TILEWIDTH, tile_width);
      TIFFSetField(tif_write.get(), TIFFTAG_TILELENGTH, tile_height);

      // Write tile data.
      tmsize_t tile_size = TIFFTileSize(tif_write.get());
      if (tile_size > 0 && fdp.remaining_bytes() > tile_size) {
        std::vector<uint8_t> tile_buf = fdp.ConsumeBytes<uint8_t>(tile_size);
        // Call TIFFWriteEncodedTile to exercise its logic.
        TIFFWriteEncodedTile(tif_write.get(), 0, tile_buf.data(), tile_size);
      }

      // Finalize the current directory to allow for another one to be created.
      TIFFWriteDirectory(tif_write.get());
    }
  }

  std::string tiff_data = tiff_stream.str();
  if (tiff_data.empty()) {
    return 0;
  }

  // Scope for the reading process.
  tiff_stream.seekg(0);
  // Create a TIFF handle for reading from the generated in-memory data.
  TiffUniquePtr tif_read = TiffUniquePtr(TIFFStreamOpen("mem_read.tif", &tiff_stream));
  if (!tif_read) {
    return 0;
  }

  // Exercise TIFFSetDirectory, which has low coverage.
  tdir_t num_dirs = TIFFNumberOfDirectories(tif_read.get());
  if (num_dirs > 0) {
    tdir_t dir_to_set = fdp.ConsumeIntegralInRange<tdir_t>(0, num_dirs - 1);
    TIFFSetDirectory(tif_read.get(), dir_to_set);
  }

  // Exercise TIFFReadCustomDirectory, which has 0% coverage.
  const TIFFFieldArray* field_array = _TIFFGetFields();
  if (field_array) {
    toff_t custom_dir_offset = fdp.ConsumeIntegral<toff_t>();
    TIFFReadCustomDirectory(tif_read.get(), custom_dir_offset, field_array);
  }

  // Exercise TIFFReadRGBATile, which has 0% coverage.
  uint32_t read_width, read_height;
  TIFFGetField(tif_read.get(), TIFFTAG_IMAGEWIDTH, &read_width);
  TIFFGetField(tif_read.get(), TIFFTAG_IMAGELENGTH, &read_height);
  if (read_width > 0 && read_height > 0) {
    // Allocate buffer for the raster using the library's allocator.
    uint32_t* raster = (uint32_t*)_TIFFmalloc(read_width * read_height * sizeof(uint32_t));
    if (raster) {
      // Attempt to read a tile.
      TIFFReadRGBATile(tif_read.get(), 0, 0, raster);
      // Free the buffer with the corresponding library function.
      _TIFFfree(raster);
    }
  }

  return 0;
}[0m
