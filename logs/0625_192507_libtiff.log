#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <sstream>
#include <vector>

#include "fuzzer/FuzzedDataProvider.h"
#include "tiffio.h"
#include "tiffio.hxx"

// Fuzzer entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < 100) {
    return 0;
  }
  FuzzedDataProvider fdp(data, size);

  // Use a stringstream for in-memory TIFF handling
  std::stringstream tiff_stream;

  // Define image parameters using the fuzzer
  const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
  const uint16_t samples_per_pixel = fdp.PickValueInArray<uint16_t>({1, 3, 4});
  const uint16_t bits_per_sample = fdp.PickValueInArray<uint16_t>({8, 16});
  const uint16_t compression = fdp.PickValueInArray<uint16_t>(
      {COMPRESSION_NONE, COMPRESSION_PACKBITS, COMPRESSION_LZW});
  const uint16_t photometric =
      (samples_per_pixel == 1)
          ? PHOTOMETRIC_MINISBLACK
          : fdp.PickValueInArray<uint16_t>({PHOTOMETRIC_RGB, PHOTOMETRIC_YCBCR});

  // RAII handle for the TIFF object
  TIFF *tiff_write = nullptr;

  // --- Start Writing Phase ---
  // Use TIFFStreamOpen to write to the in-memory stringstream
  tiff_write = TIFFStreamOpen("MemTIFFWrite", &tiff_stream);
  if (!tiff_write) {
    return 0;
  }

  // Set mandatory TIFF fields
  TIFFSetField(tiff_write, TIFFTAG_IMAGEWIDTH, width);
  TIFFSetField(tiff_write, TIFFTAG_IMAGELENGTH, height);
  TIFFSetField(tiff_write, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
  TIFFSetField(tiff_write, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
  TIFFSetField(tiff_write, TIFFTAG_ORIENTATION, ORIENTATION_TOPLEFT);
  TIFFSetField(tiff_write, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
  TIFFSetField(tiff_write, TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(tiff_write, TIFFTAG_COMPRESSION, compression);

  // Allocate a buffer for one scanline
  tmsize_t scanline_size = TIFFScanlineSize(tiff_write);
  if (scanline_size <= 0) {
    TIFFClose(tiff_write);
    return 0;
  }
  std::vector<uint8_t> scanline_buf(scanline_size);

  // Write scanlines for the first image directory
  for (uint32_t row = 0; row < height; ++row) {
    if (fdp.remaining_bytes() > scanline_buf.size()) {
      fdp.ConsumeData(scanline_buf.data(), scanline_buf.size());
    }
    if (TIFFWriteScanline(tiff_write, scanline_buf.data(), row, 0) < 0) {
      break; 
    }
  }

  // Create a second directory to test multi-image TIFF support
  TIFFWriteDirectory(tiff_write);
  const uint32_t width2 = fdp.ConsumeIntegralInRange<uint32_t>(1, 128);
  const uint32_t height2 = fdp.ConsumeIntegralInRange<uint32_t>(1, 128);
  TIFFSetField(tiff_write, TIFFTAG_IMAGEWIDTH, width2);
  TIFFSetField(tiff_write, TIFFTAG_IMAGELENGTH, height2);
  TIFFSetField(tiff_write, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
  TIFFSetField(tiff_write, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
  TIFFSetField(tiff_write, TIFFTAG_ORIENTATION, ORIENTATION_TOPLEFT);
  TIFFSetField(tiff_write, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
  TIFFSetField(tiff_write, TIFFTAG_PHOTOMETRIC, photometric);
  TIFFSetField(tiff_write, TIFFTAG_COMPRESSION, compression);

  // Write scanlines for the second directory
  scanline_size = TIFFScanlineSize(tiff_write);
  if (scanline_size > 0) {
    scanline_buf.resize(scanline_size);
    for (uint32_t row = 0; row < height2; ++row) {
      if (fdp.remaining_bytes() > scanline_buf.size()) {
        fdp.ConsumeData(scanline_buf.data(), scanline_buf.size());
      }
      if (TIFFWriteScanline(tiff_write, scanline_buf.data(), row, 0) < 0) {
        break;
      }
    }
  }

  // Close the write handle, flushing all data to the stringstream
  TIFFClose(tiff_write);
  // --- End Writing Phase ---

  // Get the generated TIFF data
  std::string tiff_data = tiff_stream.str();
  if (tiff_data.empty()) {
    return 0;
  }

  // --- Start Reading Phase ---
  // Re-initialize the stringstream for reading
  tiff_stream.str(tiff_data);
  tiff_stream.seekg(0);

  // Use TIFFStreamOpen to read from the in-memory data
  TIFF *tiff_read = TIFFStreamOpen("MemTIFFRead", &tiff_stream);
  if (!tiff_read) {
    return 0;
  }

  do {
    uint32_t w, h;
    TIFFGetField(tiff_read, TIFFTAG_IMAGEWIDTH, &w);
    TIFFGetField(tiff_read, TIFFTAG_IMAGELENGTH, &h);
    if (w > 0 && h > 0) {
      // Check for potential integer overflow before allocating memory
      if (w > (1 << 20) || h > (1 << 20)) {
          break;
      }
      size_t raster_size = static_cast<size_t>(w) * h * 4;
      if (raster_size > 0 && raster_size < 100000000) { // Limit allocation
        // Allocate buffer for the entire image
        uint32_t *raster = (uint32_t *)_TIFFmalloc(raster_size);
        if (raster) {
          // Attempt to read the image data, exercising the RGBA reading logic
          TIFFReadRGBAImage(tiff_read, w, h, raster, 0);
          _TIFFfree(raster);
        }
      }
    }
  } while (TIFFReadDirectory(tiff_read)); // Move to the next directory

  // Close the read handle and release resources
  TIFFClose(tiff_read);
  // --- End Reading Phase ---

  return 0;
}[0m
