  tmsize_t scanline_size = TIFFScanlineSize(tif_write);
  if (scanline_size > 0) {
    std::vector<uint8_t> scanline_buf(scanline_size);
    for (uint32_t row = 0; row < height; ++row) {
      if (fdp.remaining_bytes() < scanline_size) {
