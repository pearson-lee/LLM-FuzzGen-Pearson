#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <sstream>
#include <vector>
#include <unistd.h>
#include <fcntl.h>

#include "tiffio.h"
#include "tiffio.hxx"
#include <fuzzer/FuzzedDataProvider.h>

// Suppress libtiff error/warning messages to avoid polluting fuzzer output.
void TiffErrorHandler(const char*, const char*, va_list) {}

// This fuzz target creates a TIFF in memory, prints its directory,
// and then reads it back to exercise a wide range of libtiff functionality.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    if (size < 100) {
        return 0;
    }

    // Set custom error and warning handlers.
    TIFFSetErrorHandler(TiffErrorHandler);
    TIFFSetWarningHandler(TiffErrorHandler);

    FuzzedDataProvider fdp(data, size);

    // Use a stringstream for in-memory TIFF data, avoiding filesystem I/O.
    std::stringstream tiff_stream;

    // --- Phase 1: Write a TIFF file to the in-memory stream ---
    // TIFFStreamOpen allows using C++ iostreams with libtiff.
    TIFF *tiff_write = TIFFStreamOpen("fuzzer_write", &tiff_stream);
    if (!tiff_write) {
        return 0;
    }

    // Define image properties using fuzzer data to explore different configurations.
    const uint32_t width = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
    const uint32_t height = fdp.ConsumeIntegralInRange<uint32_t>(1, 512);
    const uint16_t bits_per_sample = fdp.PickValueInArray<uint16_t>({1, 2, 4, 8, 16});
    const uint16_t samples_per_pixel = fdp.PickValueInArray<uint16_t>({1, 3, 4});
    const uint16_t compression = fdp.PickValueInArray<uint16_t>({
        COMPRESSION_NONE,
        COMPRESSION_LZW,
        COMPRESSION_PACKBITS,
        COMPRESSION_DEFLATE,
    });
    const uint16_t photometric = (samples_per_pixel > 1) ? PHOTOMETRIC_RGB : PHOTOMETRIC_MINISBLACK;

    // Set mandatory TIFF fields using TIFFSetField.
    TIFFSetField(tiff_write, TIFFTAG_IMAGEWIDTH, width);
    TIFFSetField(tiff_write, TIFFTAG_IMAGELENGTH, height);
    TIFFSetField(tiff_write, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
    TIFFSetField(tiff_write, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
    TIFFSetField(tiff_write, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
    TIFFSetField(tiff_write, TIFFTAG_COMPRESSION, compression);
    TIFFSetField(tiff_write, TIFFTAG_PHOTOMETRIC, photometric);
    TIFFSetField(tiff_write, TIFFTAG_ROWSPERSTRIP, height); // One strip for simplicity.

    // Write scanline data using TIFFWriteScanline.
    tmsize_t scanline_size = TIFFScanlineSize(tiff_write);
    if (scanline_size > 0) {
        // Use std::vector for automatic memory management of the scanline buffer.
        std::vector<uint8_t> scanline_buf(scanline_size);
        for (uint32_t row = 0; row < height; ++row) {
            if (fdp.remaining_bytes() >= scanline_buf.size()) {
                fdp.ConsumeData(scanline_buf.data(), scanline_buf.size());
            }
            if (TIFFWriteScanline(tiff_write, scanline_buf.data(), row, 0) < 0) {
                break; 
            }
        }
    }

    // TIFFClose flushes all data to the stream and frees the TIFF handle.
    TIFFClose(tiff_write);

    // --- Phase 2: Print directory info from the generated TIFF ---
    // Rewind the stream to read the TIFF data we just wrote.
    tiff_stream.seekg(0);

    TIFF *tiff_print = TIFFStreamOpen("fuzzer_print", &tiff_stream);
    if (!tiff_print) {
        return 0;
    }

    // Redirect stdout to /dev/null to exercise TIFFPrintDirectory without
    // generating massive logs, which would slow down the fuzzer.
    int stdout_fd = dup(STDOUT_FILENO);
    int dev_null_fd = open("/dev/null", O_WRONLY);
