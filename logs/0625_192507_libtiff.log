  const uint16_t photometric = fdp.PickValueInArray<uint16_t>({
      PHOTOMETRIC_MINISBLACK, PHOTOMETRIC_MINISWHITE, PHOTOMETRIC_RGB,
      PHOTOMETRIC_PALETTE, PHOTOMETRIC_LOGL, PHOTOMETRIC_LOGLUV
  });


