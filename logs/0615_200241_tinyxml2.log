        if (!created_elements.empty()) {
            // Pick a random existing element as a parent
            parent_element = created_elements[fdp.ConsumeIntegralInRange<size_t>(0, created_elements.size() - 1)];
        } else if (root_element) {
             parent_element = root_element; // Fallback to root if created_elements is somehow empty
