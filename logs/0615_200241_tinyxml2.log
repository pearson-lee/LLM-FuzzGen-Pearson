#include "/src/tinyxml2/tinyxml2.h"
#include <fuzzer/FuzzedDataProvider.h>
#include <string>
#include <vector>

// Use the tinyxml2 namespace to make the code cleaner.
using namespace tinyxml2;

// Helper function to get a somewhat random element from the document.
// It might return the root, a child, or nullptr if the document is empty or has no elements.
XMLElement* GetRandomElement(FuzzedDataProvider& fdp, XMLDocument& doc) {
    XMLElement* current_element = doc.RootElement();
    if (!current_element) {
        return nullptr;
    }

    // Navigate a bit to find a potentially different element.
    // Max depth of navigation attempts.
    int nav_attempts = fdp.ConsumeIntegralInRange<int>(0, 3);
    for (int i = 0; i < nav_attempts; ++i) {
        uint8_t choice = fdp.ConsumeIntegralInRange<uint8_t>(0, 2);
        XMLElement* next = nullptr;
        if (choice == 0) { // Try first child
            next = current_element->FirstChildElement();
        } else if (choice == 1) { // Try next sibling
            next = current_element->NextSiblingElement();
        } else { // Try parent element
            XMLNode* parent_node = current_element->Parent();
            if (parent_node) {
                // ToElement() will be nullptr if parent is not an XMLElement (e.g., XMLDocument itself)
                next = parent_node->ToElement(); 
            }
        }

        if (next) {
            current_element = next;
        } else {
            // If no suitable element found in this direction, try another path or stop.
            if (fdp.ConsumeBool()) break; 
        }
    }
    return current_element;
}


extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    FuzzedDataProvider fdp(data, size);

    // Define some limits for generated strings to prevent excessive memory use or performance issues.
    const size_t MAX_NAME_LEN = 32;
    const size_t MAX_VALUE_LEN = 128;
    const size_t MAX_INITIAL_XML_LEN = 2048; // Cap for initial XML string length

    // XMLDocument is the main container. Its destructor will automatically clean up 
    // all nodes (XMLElements, XMLTexts, etc.) that it owns, ensuring no memory leaks from document content.
    XMLDocument doc;

    // Consume a portion of data for parsing.
    // Using ConsumeBytesAsString as XML can contain arbitrary byte sequences, not just valid UTF-8.
    size_t xml_data_len = fdp.ConsumeIntegralInRange<size_t>(0, size / 2);
    if (xml_data_len > MAX_INITIAL_XML_LEN) {
        xml_data_len = MAX_INITIAL_XML_LEN;
    }
    std::string xml_data_str = fdp.ConsumeBytesAsString(xml_data_len);

    // API 1: XMLDocument::Parse(). This attempts to parse the provided XML string.
    // Errors are handled internally by tinyxml2; the fuzzer's goal is to find crashes or hangs.
    doc.Parse(xml_data_str.c_str(), xml_data_str.length());

    // Ensure there's a root element for subsequent operations.
    // If parsing failed or the XML was empty, create a default root.
    if (!doc.RootElement()) {
        std::string root_name = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(1, MAX_NAME_LEN));
        // Fallback if random string is empty (though range [1, MAX_NAME_LEN] should prevent it)
        if (root_name.empty()) root_name = "defaultRoot";
        
        // API 2 (variant): XMLDocument::NewElement()
        XMLElement* new_root = doc.NewElement(root_name.c_str());
        if (new_root) {
            // InsertFirstChild makes the document own new_root.
            doc.InsertFirstChild(new_root);
        } else {
            // If NewElement fails (e.g., due to internal limits or simulated OOM by tinyxml2),
            // there's not much more to do with this document.
            return 0;
        }
    }

    // Perform a series of randomized operations on the document.
    int num_operations = fdp.ConsumeIntegralInRange<int>(1, 15); 
    for (int i = 0; i < num_operations; ++i) {
        // Get an element to operate on. It might be null if the doc is/becomes empty.
        XMLElement* target_element = GetRandomElement(fdp, doc);
        if (!target_element) { // If no element to operate on, try to use RootElement or skip.
            target_element = doc.RootElement();
            if(!target_element) continue; // Skip if still no root (e.g. if root was deleted)
        }

        uint8_t operation_choice = fdp.ConsumeIntegralInRange<uint8_t>(0, 5);

        switch (operation_choice) {
            case 0: { // NewElement and InsertEndChild
                std::string element_name = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(1, MAX_NAME_LEN));
                if (element_name.empty()) element_name = "elem"; // Fallback

                // API 2: XMLDocument::NewElement
                // Create a new element. It's initially not part of the document tree.
                XMLElement* new_elem = doc.NewElement(element_name.c_str());
                if (new_elem) {
                    // API 3: XMLNode::InsertEndChild
                    // Add the new element to the target_element.
                    // target_element (and ultimately the document) now owns new_elem.
                    target_element->InsertEndChild(new_elem);
                }
                break;
            }
            case 1: { // FindOrCreateAttribute and set its value
                std::string attr_name = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(1, MAX_NAME_LEN));
                if (attr_name.empty()) attr_name = "attr"; // Fallback

                // API 4: XMLElement::FindOrCreateAttribute
                // This finds an existing attribute or creates a new one if not found.
                // The attribute is owned by target_element.
                XMLAttribute* attr = target_element->FindOrCreateAttribute(attr_name.c_str());
                if (attr) {
                    // Set attribute value using various types to exercise different SetValue overloads.
                    uint8_t val_type = fdp.ConsumeIntegralInRange<uint8_t>(0, 5);
                    switch (val_type) {
                        case 0: attr->SetValue(fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, MAX_VALUE_LEN)).c_str()); break;
                        case 1: attr->SetValue(fdp.ConsumeIntegral<int>()); break;
                        case 2: attr->SetValue(fdp.ConsumeIntegral<unsigned int>()); break;
                        case 3: attr->SetValue(fdp.ConsumeFloatingPoint<double>()); break;
                        case 4: attr->SetValue(fdp.ConsumeFloatingPoint<float>()); break;
                        case 5: attr->SetValue(fdp.ConsumeBool()); break;
                    }
                }
                break;
            }
            case 2: { // Query attribute or text (exercises various Get/Query functions)
                if (fdp.ConsumeBool() && target_element->FirstAttribute()) { // Query attribute
                    const XMLAttribute* first_attr = target_element->FirstAttribute();
                    // Use the name of an existing attribute for querying.
                    std::string attr_name_query = first_attr->Name(); 
                    if (!attr_name_query.empty()) {
                        int iVal; target_element->QueryIntAttribute(attr_name_query.c_str(), &iVal);
                        double dVal; target_element->QueryDoubleAttribute(attr_name_query.c_str(), &dVal);
                        bool bVal; target_element->QueryBoolAttribute(attr_name_query.c_str(), &bVal);
                        (void)target_element->Attribute(attr_name_query.c_str()); // Get const char* value
                    }
                } else { // Query text
                    int iText; target_element->QueryIntText(&iText);
                    (void)target_element->GetText(); // Get const char* text
                }
                break;
            }
            case 3: { // Delete a child or attribute
                if (fdp.ConsumeBool()) { // Delete child node
                    XMLNode* child_to_delete = target_element->FirstChild();
                    if (child_to_delete) {
                        // DeleteChild removes the child from the tree and deallocates it and its descendants.
                        target_element->DeleteChild(child_to_delete);
                    }
                } else { // Delete attribute
                    const XMLAttribute* attr_to_delete = target_element->FirstAttribute();
                    if (attr_to_delete) {
                        // DeleteAttribute by name. The attribute object is deallocated.
                        std::string attr_name_del = attr_to_delete->Name();
                        if (!attr_name_del.empty()) {
                           target_element->DeleteAttribute(attr_name_del.c_str());
                        }
                    }
                }
                break;
            }
            case 4: { // DeleteChildren
                // Deletes all children of target_element. Memory is handled by tinyxml2.
                target_element->DeleteChildren();
                break;
            }
            case 5: { // DeepClone a node
                // Create a temporary document for the cloned node.
                // XMLDocument manages its own memory pool for nodes.
                XMLDocument temp_doc_for_clone;
                XMLNode* cloned_node = target_element->DeepClone(&temp_doc_for_clone);
                if (cloned_node) {
                    // The cloned_node is created using temp_doc_for_clone's allocator.
                    // To be managed by temp_doc_for_clone, it needs to be inserted into it.
                    temp_doc_for_clone.InsertFirstChild(cloned_node);
                    // temp_doc_for_clone and its contents (including cloned_node)
                    // will be cleaned up when temp_doc_for_clone goes out of scope (RAII).
                }
                break;
            }
        }
    }

    // API 5: XMLDocument::Print (using XMLPrinter)
    // XMLPrinter can write to a FILE* or use an internal buffer.
    // Using an internal buffer is safer for fuzzing (no filesystem access needed).
    // The printer manages its own buffer, which is freed on its destruction.
    XMLPrinter printer(nullptr, fdp.ConsumeBool(), fdp.ConsumeIntegralInRange<int>(0, 4)); // (file, compact, depth)
    doc.Print(&printer);
    // The printed string can be accessed via printer.CStr(), but we don't need to use it for fuzzing.

    // All memory allocated by tinyxml2 (nodes, attributes) and associated with 'doc'
    // will be freed when 'doc' goes out of scope, due to XMLDocument's destructor
    // calling its Clear() method. Similarly for 'temp_doc_for_clone'.
    return 0;
}[0m
