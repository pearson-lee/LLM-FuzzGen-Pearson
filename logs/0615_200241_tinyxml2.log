    // If no root element exists (or if we decide to create a new one), create and add one.
    if (!root_element || fdp.ConsumeBool()) {
        std::string root_name = fdp.ConsumeRandomLengthString(K_MAX_STRING_LENGTH / 2);
        if (root_name.empty()) {
            root_name = "fuzz_root"; // Ensure a valid name
        }
        // API 1: tinyxml2::XMLDocument::NewElement
        tinyxml2::XMLElement* new_root = doc->NewElement(root_name.c_str());
        if (new_root) {
            // Clear existing children if replacing root, or just insert if no root.
            // XMLDocument itself is a node, can use InsertEndChild.
            // API 2: tinyxml2::XMLNode::InsertEndChild
            doc->DeleteChildren(); // Clear any existing content if we are setting a new root this way
            doc->InsertEndChild(new_root);
            root_element = new_root; // Update root_element to the new root
        }
    }

    if (root_element) {
        created_elements.push_back(root_element);
    }

    // Create and manipulate a number of new elements.
    int num_elements_to_add = fdp.ConsumeIntegralInRange<int>(0, K_MAX_ELEMENTS_TO_CREATE);
    for (int i = 0; i < num_elements_to_add; ++i) {
        tinyxml2::XMLElement* parent_element = nullptr;
        if (!created_elements.empty()) {
            // Pick a random existing element as a parent
            parent_element = created_elements[fdp.ConsumeIntegralInRange<size_t>(0, created_elements.size() - 1)];
        } else if (root_element) {
             parent_element = root_element; // Fallback to root if created_elements is somehow empty
        } else {
            // If there's no root_element and no created_elements, we can't add more.
            // This might happen if initial root creation failed.
            break;
        }

        std::string element_name = fdp.ConsumeRandomLengthString(K_MAX_STRING_LENGTH / 2);
        if (element_name.empty()) {
            element_name = "fuzz_elem"; // Ensure a valid name
        }

        // API 1: tinyxml2::XMLDocument::NewElement (via doc)
        tinyxml2::XMLElement* new_element = doc->NewElement(element_name.c_str());
        if (!new_element) {
            continue; // Failed to create the element
        }

        // Set some attributes on the new element.
        int num_attributes = fdp.ConsumeIntegralInRange<int>(0, K_MAX_ATTRIBUTES_PER_ELEMENT);
        for (int j = 0; j < num_attributes; ++j) {
