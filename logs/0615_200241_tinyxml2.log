// Using namespace for brevity in the fuzzer.
// This is acceptable in a .cpp file for a fuzz target.
using namespace tinyxml2;

// Target APIs:
// 1. XMLDocument::Parse(const char* xml, size_t nBytes) - For parsing XML input.
// 2. XMLElement* XMLDocument::NewElement(const char* name) - For creating new elements.
// 3. XMLNode* XMLNode::InsertEndChild(XMLNode* addThis) - For adding nodes to the DOM.
// 4. void XMLElement::SetAttribute(const char* name, const char* value) - For setting attributes.
// 5. void XMLDocument::Print(XMLPrinter* streamer) const - For serializing the DOM.

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzedDataProvider fdp(Data, Size);

  // XMLDocument is the main container for the XML tree.
