        // API 1: tinyxml2::XMLDocument::NewElement (via doc)
        tinyxml2::XMLElement* new_element = doc->NewElement(element_name.c_str());
        if (!new_element) {
            continue; // Failed to create the element
        }

        // Set some attributes on the new element.
        int num_attributes = fdp.ConsumeIntegralInRange<int>(0, K_MAX_ATTRIBUTES_PER_ELEMENT);
        for (int j = 0; j < num_attributes; ++j) {
            std::string attr_name = fdp.ConsumeRandomLengthString(K_MAX_STRING_LENGTH / 2);
            if (attr_name.empty()) {
                attr_name = "fuzz_attr"; // Ensure a valid name
            }
            float attr_float_val = fdp.ConsumeFloatingPoint<float>();
            // API 3: void tinyxml2::XMLElement::SetAttribute(const char* name, float value)
            new_element->SetAttribute(attr_name.c_str(), attr_float_val);
        }

        // Optionally set some text content for the element.
        if (fdp.ConsumeBool()) {
