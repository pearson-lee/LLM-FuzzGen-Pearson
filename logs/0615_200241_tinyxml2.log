#include "/src/tinyxml2/tinyxml2.h"
#include <fuzzer/FuzzedDataProvider.h>
#include <string>
#include <vector> 
#include <cctype> // For isalpha, isalnum

// Use the tinyxml2 namespace for convenience
using namespace tinyxml2;

// Helper function to generate somewhat valid XML names from fuzzer data.
// XML names should start with a letter or '_', followed by letters, digits, '_', '-', '.'.
std::string GenerateValidXmlName(FuzzedDataProvider& fdp, const char* default_prefix_if_empty) {
    std::string name = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 20)); // Max 20 chars for names
    
    if (name.empty()) {
        return std::string(default_prefix_if_empty) + "DefaultName";
    }

    // Ensure the first character is a letter or underscore.
    // If not, prepend an underscore to make it valid, preserving the rest of the string.
    if (!isalpha(static_cast<unsigned char>(name[0])) && name[0] != '_') {
        name = "_" + name; 
    }
    // At this point, 'name' is non-empty and its first character is either originally valid or an underscore.

    // Sanitize subsequent characters (or all characters if prepended).
    // Iterate from the second character if the first was valid, or from the new first if prepended.
    // For simplicity, iterate all from index 1, as index 0 is now fine.
    for (size_t i = 1; i < name.length(); ++i) {
        if (!isalnum(static_cast<unsigned char>(name[i])) && 
            name[i] != '_' && 
            name[i] != '-' && 
            name[i] != '.') {
            name[i] = '_'; // Replace invalid character with an underscore
        }
    }
    return name;
}


extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // 1. Create an XMLDocument. 
    // This object will manage the memory of all XML nodes (elements, text, etc.) created through it.
    // This is a key part of tinyxml2's memory management: XMLDocument owns its nodes.
    XMLDocument doc;

    // Create a root element. All valid XML documents need one.
    std::string root_name_str = GenerateValidXmlName(fdp, "root");
    XMLElement* rootElement = doc.NewElement(root_name_str.c_str());
    
    // If root element creation fails (e.g., out of memory), exit.
    if (!rootElement) {
        return 0;
    }
    // Add the root element to the document. The document now owns it.
    doc.InsertEndChild(rootElement);

    XMLElement* currentElement = rootElement;
    int max_depth = fdp.ConsumeIntegralInRange<int>(3, 7); // Max depth for element nesting
    int current_depth = 0;

    // Perform a series of operations to build and interact with the XML document.
    int num_operations = fdp.ConsumeIntegralInRange<int>(1, 30); 

    for (int i = 0; i < num_operations; ++i) {
        // Randomly choose an API to target.
        uint8_t api_selector = fdp.ConsumeIntegralInRange<uint8_t>(0, 5);

        // Ensure currentElement is valid; fallback to root if something went wrong.
        if (!currentElement) { 
            currentElement = rootElement; 
            current_depth = 0;
            if (!currentElement) break; // Should not happen if rootElement was created
        }

        switch (api_selector) {
            case 0: { // Target: XMLDocument::NewElement & XMLElement::InsertEndChild (DOM Creation)
                if (current_depth < max_depth) {
                    std::string elementNameStr = GenerateValidXmlName(fdp, "elem");
                    XMLElement* newElem = doc.NewElement(elementNameStr.c_str()); // Created by doc
                    if (newElem) {
                        // Insert the new element as a child of the current element.
                        // The current element (and by extension, the document) now owns newElem.
                        currentElement->InsertEndChild(newElem);
                        // Optionally, descend into the new element for subsequent operations.
                        if (fdp.ConsumeBool()) {
                            currentElement = newElem;
                            current_depth++;
                        }
                    }
                }
                break;
            }
            case 1: { // Target: XMLElement::SetAttribute (Attribute Manipulation)
                std::string attrNameStr = GenerateValidXmlName(fdp, "attr");
                
                // Set an integer attribute
                currentElement->SetAttribute(attrNameStr.c_str(), fdp.ConsumeIntegral<int>());

                // Set a string attribute (potentially with a different name)
                std::string strAttrNameStr = GenerateValidXmlName(fdp, "strAttr");
                std::string strAttrValue = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 50));
                currentElement->SetAttribute(strAttrNameStr.c_str(), strAttrValue.c_str());
                break;
            }
            case 2: { // Target: XMLElement::InsertNewText (Text Content Creation)
                std::string textContent = fdp.ConsumeRandomLengthString(fdp.ConsumeIntegralInRange<size_t>(0, 100));
                // InsertNewText creates an XMLText node and adds it as a child to currentElement.
                // currentElement (and thus the document) owns the new XMLText node.
                currentElement->InsertNewText(textContent.c_str());
                break;
            }
            case 3: { // Target: XMLElement::QueryBoolText (Content Querying & Conversion)
                bool boolValue;
                // QueryBoolText attempts to parse the text of currentElement's first child XMLText node.
                /* XMLError error_code = */ currentElement->QueryBoolText(&boolValue);
                // The call itself exercises the code; the result isn't critical for fuzzing coverage here.
                break;
            }
            case 4: { // Target: XMLDocument::Print (Serialization)
                // XMLPrinter can print to a FILE* or to its internal string buffer (if FILE* is nullptr).
                // We use the string printing capability.
                // The XMLPrinter is stack-allocated, so its resources (like its internal buffer)
                // are managed automatically when it goes out of scope.
                XMLPrinter printer(nullptr, fdp.ConsumeBool()); // Second arg is 'compact' mode.
                
                doc.Print(&printer); // Print the entire document to the printer's buffer.
                // const char* outputXml = printer.CStr(); // Access the printed string (optional)
                // (void)outputXml; // Mark as unused if not needed further.
                break;
            }
            case 5: { // Navigate up the tree to vary the target of operations
                if (currentElement != rootElement && currentElement->Parent() && currentElement->Parent()->ToElement()) {
                     currentElement = currentElement->Parent()->ToElement();
                     current_depth--;
                }
                break;
            }
        }
    }

    // Memory Management:
    // All XML nodes (XMLElement, XMLText, etc.) created via 'doc.NewElement()' or
    // methods like 'XMLElement::InsertNewText()' are associated with the 'doc' (XMLDocument instance).
    // When 'doc' goes out of scope at the end of this function, its destructor is called.
    // This destructor is responsible for deallocating all the XML nodes it owns,
    // preventing memory leaks. This is a standard RAII (Resource Acquisition Is Initialization) pattern.
    return 0;
