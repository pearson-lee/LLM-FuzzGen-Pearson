extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a base context. Using nullptr for userData for simplicity.
    cmsContext baseContext = cmsCreateContext(nullptr, nullptr);
    if (!baseContext) {
        return 0; // Cannot proceed without a context
    }

    cmsContext duplicatedContext = nullptr;
    cmsContext ctxToUse = baseContext;

    // 1. Fuzz cmsDupContext
    if (fdp.ConsumeBool()) {
        // The second argument to cmsDupContext is user data for the new context's plugins.
        // Passing nullptr is fine if not specifically testing plugin user data interactions.
        duplicatedContext = cmsDupContext(baseContext, nullptr);
        if (duplicatedContext) {
            ctxToUse = duplicatedContext; // Use the duplicated context for subsequent operations
        }
    }

    std::vector<ProfileWrapper> profiles; // Store created profiles

    // 2. Fuzz cmsOpenProfileFromIOhandler2THR
    if (fdp.ConsumeBool()) {
        // Consume data for the profile content. Min size 10 for some basic fuzzing.
        size_t profileDataSize = fdp.ConsumeIntegralInRange<size_t>(10, fdp.remaining_bytes() / 3);
        if (profileDataSize > 0 && fdp.remaining_bytes() >= profileDataSize) {
            std::vector<uint8_t> profileDataVec = fdp.ConsumeBytes<uint8_t>(profileDataSize);
            
            // cmsOpenIOhandlerFromMem requires a non-const buffer pointer for its internal state,
            // but does not modify the content if opened in read mode 'r'.
            // The buffer (profileDataVec.data()) must remain valid for the lifetime of the IOhandler.
            IOHandlerWrapper io(cmsOpenIOhandlerFromMem(ctxToUse, profileDataVec.data(), profileDataVec.size(), 'r'));
            if (io.get()) {
                // The third argument to cmsOpenProfileFromIOhandler2THR is a cmsBool (used as a flag).
                cmsBool useAsIs = fdp.ConsumeBool();
                cmsHPROFILE hProfile = cmsOpenProfileFromIOhandler2THR(ctxToUse, io.get(), useAsIs);
                if (hProfile) {
                    profiles.emplace_back(hProfile); // ProfileWrapper takes ownership
                }
            }
            // IOHandlerWrapper and profileDataVec are destructed here, which is correct as
            // cmsOpenProfileFromIOhandler2THR should have read data synchronously.
        }
    }

    // 3. Fuzz cmsCreateRGBProfileTHR
    if (fdp.ConsumeBool()) {
        cmsCIExyY whitePoint;
        whitePoint.x = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        whitePoint.y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        whitePoint.Y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();

        cmsCIExyYTRIPLE primaries;
        primaries.Red.x = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Red.y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Red.Y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Green.x = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Green.y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Green.Y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Blue.x = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Blue.y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();
        primaries.Blue.Y = fdp.ConsumeFloatingPoint<cmsFloat64Number>();

        std::vector<ToneCurveWrapper> toneCurves; // RAII for tone curves
        const cmsToneCurve* gamutTable[3] = {nullptr, nullptr, nullptr};

        for (int i = 0; i < 3; ++i) {
            if (fdp.ConsumeBool()) { // Decide whether to create this curve
                if (fdp.ConsumeBool()) { // Choose between gamma or tabulated curve
                    double gamma = fdp.ConsumeFloatingPointInRange<double>(0.1, 4.0);
                    toneCurves.emplace_back(cmsBuildGamma(ctxToUse, gamma));
                } else {
                    cmsUInt32Number nEntries = fdp.ConsumeIntegralInRange<cmsUInt32Number>(2, 64); // Smaller max for performance
                    std::vector<cmsFloat32Number> table(nEntries);
                    for (cmsUInt32Number j = 0; j < nEntries; ++j) {
                        table[j] = fdp.ConsumeFloatingPointInRange<float>(0.0f, 1.0f);
                    }
                    toneCurves.emplace_back(cmsBuildTabulatedToneCurve(ctxToUse, nEntries, table.data()));
                }
                if (!toneCurves.empty() && toneCurves.back().get()) {
                    gamutTable[i] = toneCurves.back().get();
                }
            }
        }
        
        cmsHPROFILE hProfile = cmsCreateRGBProfileTHR(ctxToUse, &whitePoint, &primaries, gamutTable);
        if (hProfile) {
            profiles.emplace_back(hProfile); // ProfileWrapper takes ownership
        }
        // toneCurves vector and its ToneCurveWrappers are destructed here, freeing curves.
        // cmsCreateRGBProfileTHR duplicates curves internally if needed.
    }
    
    // Ensure there's at least one profile for subsequent APIs
    if (profiles.empty()) {
        cmsHPROFILE srgbProfile = cmsCreate_sRGBProfileTHR(ctxToUse);
        if (srgbProfile) {
            profiles.emplace_back(srgbProfile);
        }
    }

    if (profiles.empty()) { // If still no profiles, cannot test dependent APIs
        if (duplicatedContext) cmsDeleteContext(duplicatedContext);
        cmsDeleteContext(baseContext);
        return 0;
    }

    // 4. Fuzz cmsCreateProofingTransformTHR
    if (fdp.ConsumeBool()) {
        cmsHPROFILE hInput = profiles[fdp.ConsumeIntegralInRange<size_t>(0, profiles.size() - 1)].get();
        cmsHPROFILE hOutput = profiles[fdp.ConsumeIntegralInRange<size_t>(0, profiles.size() - 1)].get();
        cmsHPROFILE hProofing = profiles[fdp.ConsumeIntegralInRange<size_t>(0, profiles.size() - 1)].get();

        cmsUInt32Number inputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
        cmsUInt32Number outputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
        // Intents are typically 0-3. Fuzzing with wider range might be useful.
        cmsUInt32Number intent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 10); 
        cmsUInt32Number proofingIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 10);
        cmsUInt32Number dwFlags = fdp.ConsumeIntegral<cmsUInt32Number>();

        TransformWrapper transform(cmsCreateProofingTransformTHR(ctxToUse, hInput, inputFormat, hOutput, outputFormat, hProofing, intent, proofingIntent, dwFlags));
        // TransformWrapper manages the transform's lifecycle.
    }

    // 5. Fuzz _cmsDefaultICCintents
    if (fdp.ConsumeBool()) {
        cmsUInt32Number nProfilesForIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(1, std::min((size_t)5, profiles.size()));
        
        std::vector<cmsUInt32Number> intentsArr(nProfilesForIntent);
        std::vector<cmsHPROFILE> hProfilesArr(nProfilesForIntent);
        std::vector<cmsBool> bpcArr(nProfilesForIntent);
        std::vector<cmsFloat64Number> adaptationStatesArr(nProfilesForIntent);

        for (cmsUInt32Number i = 0; i < nProfilesForIntent; ++i) {
            intentsArr[i] = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 10); // Intents 0-3 are standard
            hProfilesArr[i] = profiles[fdp.ConsumeIntegralInRange<size_t>(0, profiles.size() - 1)].get();
            bpcArr[i] = fdp.ConsumeBool();
            adaptationStatesArr[i] = fdp.ConsumeFloatingPointInRange<cmsFloat64Number>(0.0, 1.0);
        }
        cmsUInt32Number dwFlagsIntent = fdp.ConsumeIntegral<cmsUInt32Number>();

        PipelineWrapper pipeline(_cmsDefaultICCintents(ctxToUse, nProfilesForIntent, intentsArr.data(), hProfilesArr.data(), bpcArr.data(), adaptationStatesArr.data(), dwFlagsIntent));
        // PipelineWrapper manages the pipeline's lifecycle.
    }

    // Cleanup:
    // ProfileWrappers in 'profiles' vector will be destructed, closing profiles.
    // Other wrappers (TransformWrapper, PipelineWrapper, ToneCurveWrapper, IOHandlerWrapper) handle their resources.
    if (duplicatedContext) {
        cmsDeleteContext(duplicatedContext); // Manages memory for duplicated context
    }
    cmsDeleteContext(baseContext); // Manages memory for base context

    return 0;
}[0m
