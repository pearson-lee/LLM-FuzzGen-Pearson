// Helper RAII wrapper for cmsHPROFILE
struct ProfileWrapper {
    cmsHPROFILE profile = nullptr;
    ProfileWrapper(cmsHPROFILE p) : profile(p) {}
    ~ProfileWrapper() {
        if (profile) {
            cmsCloseProfile(profile); // Manages memory for profiles
        }
    }
    ProfileWrapper(const ProfileWrapper&) = delete;
    ProfileWrapper& operator=(const ProfileWrapper&) = delete;
    ProfileWrapper(ProfileWrapper&& other) noexcept : profile(other.profile) {
        other.profile = nullptr;
    }
    ProfileWrapper& operator=(ProfileWrapper&& other) noexcept {
        if (this != &other) {
            if (profile) cmsCloseProfile(profile);
            profile = other.profile;
            other.profile = nullptr;
        }
        return *this;
    }
    cmsHPROFILE get() const { return profile; }
};

