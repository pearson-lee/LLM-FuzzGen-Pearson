#include <stdint.h>
#include <stddef.h>
#include <stdlib.h>
#include <string.h>

#include "pcap/pcap.h"

// Dummy callback handler for pcap_dispatch
void dummy_handler(u_char *user, const struct pcap_pkthdr *h, const u_char *bytes) {
    // Do nothing
}

int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    if (Size < 10) {
        return 0;
    }

    char errbuf[PCAP_ERRBUF_SIZE];
    pcap_t *p;

    // Use a portion of the input for the device name.
    // Ensure it's null-terminated.
    size_t dev_name_len = (Data[0] % 32) + 1;
    if (Size < dev_name_len + 2) {
        return 0;
    }
    char *dev_name = (char *)malloc(dev_name_len + 1);
    if (!dev_name) {
        return 0;
    }
    memcpy(dev_name, Data + 1, dev_name_len);
    dev_name[dev_name_len] = '\0';
    const uint8_t *remaining_data = Data + 1 + dev_name_len;
    size_t remaining_size = Size - 1 - dev_name_len;

    if (remaining_size < 8) {
        free(dev_name);
        return 0;
    }

    // Create a pcap handle for a live capture.
    // This will likely fail to find the device, but it exercises the creation path.
    p = pcap_create(dev_name, errbuf);
    if (p == NULL) {
        free(dev_name);
        return 0;
    }

    // Consume data to set various options on the handle before activation.
    // This allows the fuzzer to explore different configuration-dependent code paths.
    int snaplen = (remaining_data[0] << 8) | remaining_data[1];
    int promisc = remaining_data[2] % 2;
    int timeout = (remaining_data[3] << 8) | remaining_data[4];
    
    pcap_set_snaplen(p, snaplen);
    pcap_set_promisc(p, promisc);
    pcap_set_timeout(p, timeout);

    // Activate the handle. This is a primary target, as it calls into
    // the complex, low-coverage pcap_activate_linux() function.
    // We expect this to fail because the device is not real, but in doing so,
    // it will exercise the extensive error-handling pathways.
    int ret = pcap_activate(p);

    if (ret == 0) {
        // If activation somehow succeeds, proceed to test other APIs.
        
        // Use the rest of the data for a filter string.
        if (remaining_size > 8) {
            char *filter_str = (char *)malloc(remaining_size - 7);
            if (filter_str) {
                memcpy(filter_str, remaining_data + 8, remaining_size - 8);
                filter_str[remaining_size - 8] = '\0';

                struct bpf_program fp;
                // Test filter compilation.
                if (pcap_compile(p, &fp, filter_str, 1, PCAP_NETMASK_UNKNOWN) == 0) {
                    // Test setting the filter, which targets pcap_setfilter_linux().
                    pcap_setfilter(p, &fp);
                    pcap_freecode(&fp);
                }
                free(filter_str);
            }
        }

        // Test packet dispatching.
        pcap_dispatch(p, 1, dummy_handler, NULL);

        // Test packet injection, targeting pcap_inject_linux().
        // Use some of the remaining data as packet data to inject.
        if (remaining_size > 10) {
            pcap_inject(p, remaining_data, 10);
        }
    }

    // Crucial cleanup step to prevent memory leaks.
    pcap_close(p);
    free(dev_name);

    return 0;
}[0m
