        if (!p) {
            fclose(pcap_file);
        }
        // The file still exists on disk, so we must remove it.
        unlink(temp_pcap_file_name);
    }
    free(filter_string);
    // This should have been freed already, but as a safeguard.
    if (tstamp_types) {
        pcap_free_tstamp_types(tstamp_types);
    }

    return 0;
