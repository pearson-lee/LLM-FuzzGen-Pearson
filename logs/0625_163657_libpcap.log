fuzz target: 
#include <pcap.h>
#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <net/if.h>
#include <sys/ioctl.h>
#include <unistd.h>
#include <stdio.h>

// Dummy handler for pcap_dispatch
void dummy_handler(u_char *user, const struct pcap_pkthdr *h, const u_char *bytes) {
  // Do nothing
}

// Main fuzzing function
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  // --- Environment Check ---
  // Live capture fuzzing requires a network interface. We use the "dummy"
  // kernel module to create a safe, virtual interface for this purpose.
  // This check ensures the required "dummy0" interface exists.
  int sock = socket(AF_INET, SOCK_DGRAM, 0);
  if (sock < 0) {
    // Cannot create socket, cannot check for interface
    return 0;
  }
  struct ifreq ifr;
  memset(&ifr, 0, sizeof(ifr));
  strncpy(ifr.ifr_name, "dummy0", IFNAMSIZ - 1);
  int ioctl_ret = ioctl(sock, SIOCGIFFLAGS, &ifr);
  close(sock);

  if (ioctl_ret != 0) {
    // The "dummy0" interface does not exist.
    // To enable this fuzzer, please run the following commands:
    // sudo modprobe dummy
    // sudo ip link set name dummy0 up
    fprintf(stderr, "ERROR: The 'dummy0' network interface is not available.\n");
    fprintf(stderr, "Please create it by running: sudo modprobe dummy && sudo ip link set name dummy0 up\n");
    // We exit with a specific code to signal the environment issue.
    // Fuzzing frameworks can be configured to handle this.
    exit(77); 
  }

  // --- Fuzzer Setup ---
  if (size < 10) {
    return 0; // Need at least a few bytes to do anything interesting
  }

  char errbuf[PCAP_ERRBUF_SIZE];
  pcap_t *p;
  struct bpf_program fp;

  // Use a portion of the data for a filter string
  const size_t filter_len = size > 256 ? 256 : size;
  char *filter_str = (char *)malloc(filter_len + 1);
  if (!filter_str) {
    return 0;
  }
  memcpy(filter_str, data, filter_len);
  filter_str[filter_len] = '\0';
  const uint8_t *remaining_data = data + filter_len;
  const size_t remaining_size = size - filter_len;

  // --- API Calls ---
  // 1. Create a pcap handle for live capture on the dummy interface.
  // This is a key function with 0% coverage in the report.
  p = pcap_create("dummy0", errbuf);
  if (p == NULL) {
    free(filter_str);
    return 0;
  }

  // 2. Set various options on the handle using fuzzed data.
  if (remaining_size > 4) {
    pcap_set_snaplen(p, *(int*)remaining_data);
    pcap_set_promisc(p, remaining_data[0] % 2);
    pcap_set_timeout(p, remaining_data[1]);
  }

  // 3. Activate the handle. This is another critical uncovered function.
  if (pcap_activate(p) != 0) {
    pcap_close(p);
    free(filter_str);
    return 0;
  }

  // 4. Compile and set a BPF filter from fuzzed data.
  // This tests the filter compilation and application logic on a live handle.
  if (pcap_compile(p, &fp, filter_str, 1, PCAP_NETMASK_UNKNOWN) == 0) {
    pcap_setfilter(p, &fp);
    pcap_freecode(&fp);
  }

  // 5. Inject a packet (using remaining fuzzed data).
  // This tests the packet injection path for the linux backend.
  if (remaining_size > 0) {
    pcap_inject(p, remaining_data, remaining_size);
  }

  // 6. Read packets. This will exercise the linux-specific read functions.
  pcap_dispatch(p, 5, dummy_handler, NULL);

  // 7. Get capture statistics.
  struct pcap_stat ps;
  pcap_stats(p, &ps);

  // --- Cleanup ---
  // 8. Close the handle to free all associated resources.
  pcap_close(p);
  free(filter_str);

  return 0;
}[0m
