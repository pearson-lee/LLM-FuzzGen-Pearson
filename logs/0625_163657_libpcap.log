        "len > 100",
        "len < 50",
        "ether broadcast",
        "ip multicast",
        "mpls",
        "pppoes",
        "portrange 10-20",
        "ifindex 5",
        "inbound",
        "outbound",
        "llc",
        "pppoed",
        "geneve",
        "ip[0] > 10",
        "ip[0] & 0xf != 0",
        "type mgt",
        "dir nodstods",
        "decnet host 1.2",
        "radio",
        "lane"
    };
    const int num_filters = sizeof(filters) / sizeof(filters[0]);
    
    char *filter_string = NULL;
    size_t filter_len = 0;

    if (choice % (num_filters + 1) < num_filters) {
        filter_string = strdup(filters[choice % num_filters]);
        if (!filter_string) {
            return 0;
        }
    } else {
        if (size == 0) {
            filter_string = strdup("");
            if (!filter_string) return 0;
        } else {
            filter_len = size / 2;
            filter_string = (char *)malloc(filter_len + 1);
