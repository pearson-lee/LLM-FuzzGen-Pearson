        pcap_freecode(&program);
    }

    // Added compilation of complex filters to improve gencode.c coverage.
    // A byte from the input selects a known-good filter string.
    const char *complex_filters[] = {"vlan", "mpls", "pppoes", "multicast", "tcp portrange 1-1024"};
    const char *selected_filter = complex_filters[filter_selector % (sizeof(complex_filters)/sizeof(complex_filters[0]))];
