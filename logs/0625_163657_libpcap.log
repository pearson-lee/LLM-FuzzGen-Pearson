#include <pcap.h>
#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

// Dummy handler for pcap_dispatch
void dummy_handler(u_char *user, const struct pcap_pkthdr *h, const u_char *bytes) {
  // Do nothing
}

// Main fuzzing function
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  char errbuf[PCAP_ERRBUF_SIZE];
  pcap_if_t *alldevs = NULL;
  char *dev_name = NULL;

  // --- Environment Setup ---
  // Find an available network interface to use for live capture. This is more
  // robust than depending on a hardcoded "dummy0" interface.
  if (pcap_findalldevs(&alldevs, errbuf) == -1 || alldevs == NULL) {
    // No interfaces found, cannot proceed with live capture fuzzing.
    return 0;
  }
  dev_name = alldevs->name; // Use the first interface found

  // --- Fuzzer Setup ---
  if (size < 10) {
    pcap_freealldevs(alldevs);
    return 0; // Need at least a few bytes to do anything interesting
  }

  pcap_t *p = NULL;
  struct bpf_program fp;

  // Use a portion of the data for a filter string
  const size_t filter_len = size > 256 ? 256 : size;
  char *filter_str = (char *)malloc(filter_len + 1);
  if (!filter_str) {
    pcap_freealldevs(alldevs);
    return 0;
  }
  memcpy(filter_str, data, filter_len);
  filter_str[filter_len] = '\0';
  const uint8_t *remaining_data = data + filter_len;
  const size_t remaining_size = size - filter_len;

  // --- API Calls ---
  // 1. Create a pcap handle for live capture on the found interface.
  p = pcap_create(dev_name, errbuf);
  if (p == NULL) {
    free(filter_str);
    pcap_freealldevs(alldevs);
    return 0;
  }

  // 2. Set various options on the handle using fuzzed data.
  if (remaining_size > 4) {
    pcap_set_snaplen(p, *(int*)remaining_data);
    pcap_set_promisc(p, remaining_data[0] % 2);
    pcap_set_timeout(p, remaining_data[1]);
  }

  // 3. Activate the handle.
  if (pcap_activate(p) != 0) {
    pcap_close(p);
    free(filter_str);
    pcap_freealldevs(alldevs);
    return 0;
  }

  // 4. Compile and set a BPF filter from fuzzed data.
  if (pcap_compile(p, &fp, filter_str, 1, PCAP_NETMASK_UNKNOWN) == 0) {
    if (pcap_setfilter(p, &fp) != 0) {
      // pcap_setfilter failed, so we are responsible for freeing the BPF code.
      pcap_freecode(&fp);
    }
    // If pcap_setfilter succeeded, pcap_close() will free the filter.
  }

  // 5. Inject a packet (using remaining fuzzed data).
  if (remaining_size > 0) {
    pcap_inject(p, remaining_data, remaining_size);
  }

  // 6. Read packets.
  pcap_dispatch(p, 5, dummy_handler, NULL);

  // 7. Get capture statistics.
  struct pcap_stat ps;
  pcap_stats(p, &ps);

  // --- Cleanup ---
  // 8. Close the handle to free all associated resources.
  pcap_close(p);
  free(filter_str);
  pcap_freealldevs(alldevs);

  return 0;
}[0m
