    }

cleanup:
    // --- Resource Management ---
    // Meticulously clean up all allocated resources in reverse order of creation
    // to prevent memory and resource leaks.
    if (dumper) {
        // pcap_dump_close also closes the FILE * passed to pcap_dump_fopen.
        pcap_dump_close(dumper);
    } else if (dump_file) {
