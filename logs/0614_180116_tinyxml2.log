#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <memory> // For std::unique_ptr

// Include the main tinyxml2 header, as specified in the API information.
#include "/src/tinyxml2/tinyxml2.h"
// Include FuzzedDataProvider for generating diverse inputs.
#include <fuzzer/FuzzedDataProvider.h>

// Define a maximum depth for XML tree generation to prevent excessive recursion
// and potential stack overflows during fuzzing, ensuring controlled complexity.
constexpr int MAX_XML_DEPTH = 5;

/**
 * @brief Recursively fuzzes an XML element, its attributes, text, and children.
 *
 * This function exercises the following tinyxml2 APIs:
 * - `tinyxml2::XMLElement::SetText(const char *)`: Sets the text content of an element.
 * - `tinyxml2::XMLElement::SetAttribute(const char *, const char *)`: Sets attributes for an element.
 * - `tinyxml2::XMLDocument::NewElement(const char *)`: Creates new XML elements.
 * - `tinyxml2::XMLNode::InsertEndChild(XMLNode *)`: Adds new child nodes to an element.
 * - `tinyxml2::XMLNode::DeepClone(XMLDocument *)`: Performs a deep copy of an XML node.
 *
 * @param fdp FuzzedDataProvider instance for generating fuzzed data.
 * @param element The current XMLElement to fuzz.
 * @param doc The XMLDocument that owns the elements (for creating new elements).
 * @param depth Current recursion depth, used to limit tree complexity.
 */
void FuzzXMLElement(FuzzedDataProvider& fdp, tinyxml2::XMLElement* element, tinyxml2::XMLDocument* doc, int depth) {
    // Base case for recursion: stop if element is null or max depth is reached.
    if (!element || depth > MAX_XML_DEPTH) {
        return;
    }

    // Fuzz setting element text: randomly decide to set text and generate its content.
    // This covers various text inputs, including empty, short, and long strings.
    if (fdp.ConsumeBool()) {
        element->SetText(fdp.ConsumeRandomLengthString(1024).c_str());
    }

    // Fuzz setting attributes: randomly decide how many attributes to add and their content.
    // This tests attribute name and value handling, including edge cases for string lengths.
    size_t num_attributes = fdp.ConsumeIntegralInRange<size_t>(0, 5);
    for (size_t i = 0; i < num_attributes; ++i) {
        std::string attr_name = fdp.ConsumeRandomLengthString(64);
        std::string attr_value = fdp.ConsumeRandomLengthString(256);
        element->SetAttribute(attr_name.c_str(), attr_value.c_str());
    }

    // Fuzz creating and adding child elements: randomly decide how many children to add.
    // This exercises `NewElement` and `InsertEndChild`, building up the XML tree structure.
    size_t num_children = fdp.ConsumeIntegralInRange<size_t>(0, 3);
    for (size_t i = 0; i < num_children; ++i) {
        std::string child_name = fdp.ConsumeRandomLengthString(64);
        tinyxml2::XMLElement* child_element = doc->NewElement(child_name.c_str());
        if (child_element) {
            element->InsertEndChild(child_element);
            // Recursively fuzz the newly created child element to build deeper structures.
            FuzzXMLElement(fdp, child_element, doc, depth + 1);
        }
    }

    // Fuzz deep cloning of the element: randomly decide to clone the current element.
    // This tests the deep copy mechanism and associated memory allocation/deallocation.
    // A `std::unique_ptr` is used to manage the lifetime of the temporary `XMLDocument`
    // that owns the cloned node, ensuring memory safety.
    if (fdp.ConsumeBool()) {
        std::unique_ptr<tinyxml2::XMLDocument> cloned_doc = std::make_unique<tinyxml2::XMLDocument>();
        tinyxml2::XMLNode* cloned_node = element->DeepClone(cloned_doc.get());
        // The `cloned_node` is owned by `cloned_doc`. When `cloned_doc` goes out of scope,
        // its destructor will correctly deallocate `cloned_node` and any of its children.
    }
}

/**
 * @brief Main fuzzer entry point.
 *
 * This function serves as the fuzzer's entry point, taking raw fuzzer input
 * and using it to exercise selected tinyxml2 APIs.
 *
 * @param Data Pointer to the raw fuzzer input data.
 * @param Size Size of the raw fuzzer input data.
 * @return 0 to indicate successful execution.
 */
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // API 1: tinyxml2::XMLDocument::Parse
    // Consume all remaining fuzzer input as a string to be parsed as XML.
    // This is a primary entry point for fuzzing XML parsing logic.
    std::string xml_input = fdp.ConsumeRemainingBytesAsString();
    tinyxml2::XMLDocument doc;
    doc.Parse(xml_input.c_str(), xml_input.length());

    // API 2, 3, 4: tinyxml2::XMLDocument::NewElement, tinyxml2::XMLElement::SetText, tinyxml2::XMLElement::SetAttribute
    // These APIs are primarily exercised through the `FuzzXMLElement` helper function.
    // We randomly decide to create new elements and add them to the document,
    // then recursively fuzz them to set text, attributes, and create children.
    if (fdp.ConsumeBool()) { // Randomly decide whether to add new elements
        size_t num_new_elements = fdp.ConsumeIntegralInRange<size_t>(0, 10);
        for (size_t i = 0; i < num_new_elements; ++i) {
            std::string element_name = fdp.ConsumeRandomLengthString(64);
            tinyxml2::XMLElement* new_element = doc.NewElement(element_name.c_str());
            if (new_element) {
                // Add the new element to the document's root if it exists, otherwise directly to the document.
                tinyxml2::XMLElement* root = doc.RootElement();
                if (root) {
                    root->InsertEndChild(new_element);
                } else {
                    doc.InsertEndChild(new_element);
                }
                // Fuzz the newly created element and its potential children.
                FuzzXMLElement(fdp, new_element, &doc, 0);
            }
        }
    }

    // API 5: tinyxml2::XMLNode::DeepClone
    // This API is already covered within `FuzzXMLElement` for individual nodes.
    // Additionally, we can attempt to deep clone the entire root element if it exists.
    if (doc.RootElement() && fdp.ConsumeBool()) {
        std::unique_ptr<tinyxml2::XMLDocument> cloned_doc = std::make_unique<tinyxml2::XMLDocument>();
        tinyxml2::XMLNode* cloned_root = doc.RootElement()->DeepClone(cloned_doc.get());
        // The `cloned_root` is owned by `cloned_doc`, ensuring proper deallocation.
    }

    // Exercise tinyxml2::XMLDocument::Print(XMLPrinter *)
    // This implicitly tests the `XMLPrinter`'s visitor methods like `VisitEnter`,
    // by attempting to print the (potentially fuzzed) XML document.
    if (fdp.ConsumeBool()) {
        tinyxml2::XMLPrinter printer;
        doc.Print(&printer);
        // The `XMLPrinter` manages its own internal buffer; no explicit cleanup is needed here.
    }

    // Memory Management:
    // All `tinyxml2::XMLDocument` objects (e.g., `doc` and `cloned_doc`) are either
    // stack-allocated or managed by `std::unique_ptr`. Their destructors automatically
    // handle the deallocation of all associated XML nodes and internal memory pools.
    // This design ensures comprehensive memory safety and prevents leaks.
    // No manual `new`/`delete` or `malloc`/`free` calls are required for tinyxml2 objects.

    return 0; // Indicate successful fuzzer execution.
}[0m
