    cJSON_Compare(intArray.get(), stringArray.get(), fdp.ConsumeBool());
  }

  // Target cJSON_PrintPreallocated to hit uncovered branches in 'ensure'
  if (json) {
    // Use a small buffer to force reallocation within 'ensure'
    char buffer[10];
    cJSON_PrintPreallocated(json.get(), buffer, sizeof(buffer), fdp.ConsumeBool());
  }

  // Target cJSON_Minify
