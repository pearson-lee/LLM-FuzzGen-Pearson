// Fuzz target entry point.
// This fuzz target is designed to exercise the printing and object manipulation
// functions of the cJSON library, with a focus on low-coverage areas.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a cJSON object by parsing a string from the fuzzer input.
    // This provides a complex, realistic object to work with.
    std::string json_str = fdp.ConsumeRandomLengthString(1024);
    cJSON *json = cJSON_Parse(json_str.c_str());

    if (json) {
        // Call cJSON_Print and cJSON_PrintUnformatted to exercise the main printing logic.
        // The allocated memory is immediately freed to prevent leaks.
        char *printed_json = cJSON_Print(json);
        if (printed_json) {
            free(printed_json);
        }

        char *printed_unformatted_json = cJSON_PrintUnformatted(json);
        if (printed_unformatted_json) {
            free(printed_unformatted_json);
        }

        // Exercise cJSON_PrintBuffered with a fuzzed format flag.
        // This targets a specific printing function with previously low coverage.
        char buffer[1024];
        cJSON_PrintBuffered(json, sizeof(buffer), fdp.ConsumeBool());

        // Create a raw cJSON item with a NULL valuestring. This is intended to
        // trigger a specific uncovered branch within the print_value function.
        cJSON *raw_item = cJSON_CreateRaw(NULL);
        if (raw_item) {
            std::string key = fdp.ConsumeRandomLengthString(16);
            cJSON_AddItemToObject(json, key.c_str(), raw_item);
        }

        // Create a cJSON item with an invalid type to hit the default case in print_value.
        // This helps ensure that the fuzzer explores error-handling paths.
        cJSON *invalid_item = cJSON_CreateObject();
        if (invalid_item) {
            invalid_item->type = fdp.ConsumeIntegralInRange<int>(-10, -1); // Assign an invalid type
            std::string key = fdp.ConsumeRandomLengthString(16);
            cJSON_AddItemToObject(json, key.c_str(), invalid_item);
        }

        // Exercise cJSON_ReplaceItemInObject by either replacing an existing item
        // or adding a new one, based on fuzzer input.
        std::string key_to_replace = fdp.ConsumeRandomLengthString(16);
        if (cJSON_HasObjectItem(json, key_to_replace.c_str())) {
            cJSON_ReplaceItemInObject(json, key_to_replace.c_str(), cJSON_CreateString("new_value"));
        } else {
            cJSON_AddItemToObject(json, key_to_replace.c_str(), cJSON_CreateString("new_value"));
        }

        // All cJSON objects added to 'json' are freed when cJSON_Delete is called on the parent.
        cJSON_Delete(json);
    }

    // Create a new JSON object from scratch and populate it with various types
    // to ensure broad coverage of object creation and printing.
    cJSON *new_json = cJSON_CreateObject();
    if (new_json) {
        cJSON_AddItemToObject(new_json, "name", cJSON_CreateString(fdp.ConsumeRandomLengthString(10).c_str()));
        cJSON_AddItemToObject(new_json, "age", cJSON_CreateNumber(fdp.ConsumeIntegral<int>()));
        cJSON_AddItemToObject(new_json, "is_student", cJSON_CreateBool(fdp.ConsumeBool()));

        // Create and populate an array, then add it to the main object.
        cJSON *array = cJSON_CreateArray();
        if (array) {
            cJSON_AddItemToArray(array, cJSON_CreateNumber(fdp.ConsumeIntegral<int>()));
            cJSON_AddItemToArray(array, cJSON_CreateString(fdp.ConsumeRandomLengthString(10).c_str()));
            cJSON_AddItemToObject(new_json, "array", array);
        }

        // Print the newly created object and free the resulting string.
        char *printed_new_json = cJSON_Print(new_json);
        if (printed_new_json) {
            free(printed_new_json);
        }
        // Clean up the new_json object and all its children.
        cJSON_Delete(new_json);
    }

    return 0;
}[0m
