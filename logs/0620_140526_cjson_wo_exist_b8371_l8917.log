#include "/src/cjson/cJSON.h"
#include <fuzzer/FuzzedDataProvider.h>
#include <string>
#include <vector>

// Helper function to create a random cJSON object.
// This helps in generating diverse and nested JSON structures.
cJSON* create_random_json(FuzzedDataProvider& fdp, int depth) {
    // Limit recursion depth to prevent stack overflow.
    if (depth > 5) {
        return cJSON_CreateNull();
    }

    // Consume a byte to decide the type of JSON value to create.
    uint8_t type = fdp.ConsumeIntegralInRange<uint8_t>(0, 6);
    switch (type) {
        case 0:
            return cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>());
        case 1:
            return cJSON_CreateString(fdp.ConsumeRandomLengthString(100).c_str());
        case 2:
            return cJSON_CreateBool(fdp.ConsumeBool());
        case 3: {
            cJSON* arr = cJSON_CreateArray();
            if (!arr) return nullptr;
            int num_items = fdp.ConsumeIntegralInRange<int>(0, 5);
            for (int i = 0; i < num_items; ++i) {
                cJSON_AddItemToArray(arr, create_random_json(fdp, depth + 1));
            }
            return arr;
        }
        case 4: {
            cJSON* obj = cJSON_CreateObject();
            if (!obj) return nullptr;
            int num_items = fdp.ConsumeIntegralInRange<int>(0, 5);
            for (int i = 0; i < num_items; ++i) {
                std::string key = fdp.ConsumeRandomLengthString(20);
                cJSON_AddItemToObject(obj, key.c_str(), create_random_json(fdp, depth + 1));
            }
            return obj;
        }
        case 5:
            return cJSON_CreateRaw(fdp.ConsumeRandomLengthString(50).c_str());
        case 6:
        default:
            return cJSON_CreateNull();
    }
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    FuzzedDataProvider fdp(data, size);

    // Create two random JSON objects for testing.
    cJSON *json1 = create_random_json(fdp, 0);
    cJSON *json2 = create_random_json(fdp, 0);

    // 1. Exercise cJSON_Compare
    // Compare the two generated JSON objects.
    if (json1 && json2) {
        cJSON_Compare(json1, json2, fdp.ConsumeBool());
    }

    // 2. Exercise cJSON_Duplicate
    // Duplicate the first JSON object.
    if (json1) {
        cJSON *dup = cJSON_Duplicate(json1, fdp.ConsumeBool());
        // IMPORTANT: The duplicated object must be freed to avoid memory leaks.
        cJSON_Delete(dup);
    }

    // 3. Exercise cJSON_PrintPreallocated to target the 'ensure' function.
    // This function has low coverage. By providing a small buffer, we can
    // force reallocations and exercise more code paths in 'ensure'.
    if (json1) {
        // Allocate a small buffer.
        size_t buffer_size = fdp.ConsumeIntegralInRange<size_t>(1, 1024);
        char* buffer = (char*)malloc(buffer_size);
        if (buffer) {
            // This will likely fail if the buffer is too small, which is a valid test case.
            cJSON_PrintPreallocated(json1, buffer, buffer_size, fdp.ConsumeBool());
            // IMPORTANT: The buffer allocated with malloc must be freed.
            free(buffer);
        }
    }

    // 4. Exercise cJSON_CreateStringArray
    // Create an array of strings from fuzzer data.
    const int max_strings = 10;
    std::vector<std::string> str_storage;
    std::vector<const char*> c_str_vec;
    int count = fdp.ConsumeIntegralInRange(0, max_strings);
    str_storage.reserve(count);
    c_str_vec.reserve(count);
    for (int i = 0; i < count; i++) {
        str_storage.push_back(fdp.ConsumeRandomLengthString(20));
        c_str_vec.push_back(str_storage.back().c_str());
    }
    cJSON *string_array = cJSON_CreateStringArray(c_str_vec.data(), count);
    // IMPORTANT: The created array must be deleted.
    cJSON_Delete(string_array);

    // 5. Exercise cJSON_AddRawToObject
    // This function has low coverage.
    cJSON *raw_obj = cJSON_CreateObject();
    if (raw_obj) {
        std::string raw_string = fdp.ConsumeRandomLengthString(50);
        // Add a raw JSON string to the object.
        cJSON_AddRawToObject(raw_obj, "raw_data", raw_string.c_str());
        // IMPORTANT: The object must be deleted.
        cJSON_Delete(raw_obj);
    }


    // Final cleanup of the main JSON objects.
    // This is crucial to prevent memory leaks.
    cJSON_Delete(json1);
    cJSON_Delete(json2);

    return 0;
}[0m
