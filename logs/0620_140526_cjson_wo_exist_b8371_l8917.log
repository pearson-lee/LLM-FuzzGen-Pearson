#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <fuzzer/FuzzedDataProvider.h>
#include "/src/cjson/cJSON.h"

// Deleter for unique_ptr to automatically call cJSON_Delete
struct cJSONDeleter {
    void operator()(cJSON* ptr) const {
        cJSON_Delete(ptr);
    }
};

// Deleter for unique_ptr to automatically call cJSON_free
struct cJSONFreeDeleter {
    void operator()(void* ptr) const {
        cJSON_free(ptr);
    }
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a root object to attach other items to.
    // Using unique_ptr for automatic memory management.
    std::unique_ptr<cJSON, cJSONDeleter> root(cJSON_CreateObject());
    if (!root) {
        return 0;
    }

    // Target cJSON_CreateIntArray.
    // This helps test allocation and array creation logic.
    const int count = fdp.ConsumeIntegralInRange<int>(0, 100);
    std::vector<int> numbers(count);
    for (int i = 0; i < count; i++) {
        numbers[i] = fdp.ConsumeIntegral<int>();
    }
    cJSON_AddItemToObject(root.get(), "intArray", cJSON_CreateIntArray(numbers.data(), count));

    // Target print_number by creating a number with a fuzzed double.
    // This will exercise edge cases in number printing.
    double d = fdp.ConsumeFloatingPoint<double>();
    cJSON_AddItemToObject(root.get(), "number", cJSON_CreateNumber(d));

    // Target cJSON_CreateBool to cover its branches.
    cJSON_AddItemToObject(root.get(), "boolean", cJSON_CreateBool(fdp.ConsumeBool()));

    // Add a string to the object.
    std::string str_val = fdp.ConsumeRandomLengthString(50);
    cJSON_AddItemToObject(root.get(), "string", cJSON_CreateString(str_val.c_str()));

    // Use cJSON_PrintBuffered to exercise the 'ensure' function's reallocation logic.
    // A small prebuffer size is more likely to trigger reallocations.
    int prebuffer = fdp.ConsumeIntegralInRange<int>(0, 128);
    std::unique_ptr<char, cJSONFreeDeleter> printed_buffered(cJSON_PrintBuffered(root.get(), prebuffer, fdp.ConsumeBool()));

    // Use cJSON_Print to test the default printing mechanism.
    std::unique_ptr<char, cJSONFreeDeleter> printed_unformatted(cJSON_PrintUnformatted(root.get()));

    return 0;
}[0m
