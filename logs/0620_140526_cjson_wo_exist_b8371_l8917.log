#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <fuzzer/FuzzedDataProvider.h>
#include "/src/cjson/cJSON.h"

// Custom memory allocation functions to be used with cJSON_InitHooks
static void *custom_malloc(size_t size) {
    return malloc(size);
}

static void custom_free(void *ptr) {
    free(ptr);
}

// Fuzz target entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Initialize cJSON with custom memory hooks to improve coverage of allocation code paths.
    cJSON_Hooks hooks;
    hooks.malloc_fn = custom_malloc;
    hooks.free_fn = custom_free;
    cJSON_InitHooks(&hooks);

    // Create a root JSON object.
    cJSON *root = cJSON_CreateObject();
    if (!root) {
        return 0;
    }

    // Consume data to create a variety of JSON elements, increasing coverage.
    // Add a boolean value.
    cJSON_AddItemToObject(root, "boolean", cJSON_CreateBool(fdp.ConsumeBool()));

    // Add a number.
    cJSON_AddItemToObject(root, "number", cJSON_CreateNumber(fdp.ConsumeFloatingPoint<double>()));

    // Create and add a string array.
    const size_t string_count = fdp.ConsumeIntegralInRange<size_t>(1, 5);
    std::vector<const char*> string_pointers;
    std::vector<std::string> strings;
    for (size_t i = 0; i < string_count; ++i) {
        strings.push_back(fdp.ConsumeRandomLengthString(100));
        string_pointers.push_back(strings.back().c_str());
    }
    cJSON* string_array = cJSON_CreateStringArray(string_pointers.data(), string_pointers.size());
    if (string_array) {
        cJSON_AddItemToObject(root, "string_array", string_array);
    }

    // Create an integer array.
    const size_t int_count = fdp.ConsumeIntegralInRange<size_t>(1, 5);
    std::vector<int> ints;
    for (size_t i = 0; i < int_count; ++i) {
        ints.push_back(fdp.ConsumeIntegral<int>());
    }
    cJSON* int_array = cJSON_CreateIntArray(ints.data(), ints.size());
    if (int_array) {
        cJSON_AddItemToObject(root, "int_array", int_array);
    }

    // Use cJSON_PrintBuffered with a small prebuffer to exercise the 'ensure' function's reallocation logic.
    // A small buffer is more likely to trigger reallocations.
    int prebuffer = fdp.ConsumeIntegralInRange<int>(0, 10);
    char *printed_json = cJSON_PrintBuffered(root, prebuffer, fdp.ConsumeBool());
    if (printed_json) {
        // Free the buffer allocated by cJSON_PrintBuffered.
        cJSON_free(printed_json);
    }

    // Clean up the root cJSON object and all its children.
    cJSON_Delete(root);

    // Reset to default hooks for subsequent fuzzing iterations.
    cJSON_InitHooks(NULL);

    return 0;
}[0m
