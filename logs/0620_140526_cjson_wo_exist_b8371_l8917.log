      cJSON_SetValuestring(json, new_val.c_str());
    }

    // Test cJSON_AddRawToObject
    cJSON *obj = cJSON_CreateObject();
    if (obj) {
      std::string raw_str = fdp.ConsumeRandomLengthString(100);
      cJSON_AddRawToObject(obj, "raw", raw_str.c_str());
      cJSON_Delete(obj);
