static void *failing_malloc(size_t size) {
  if (malloc_should_fail) {
    return nullptr;
  }
  return malloc(size);
}

// Custom memory allocation hooks
static cJSON_Hooks hooks = {failing_malloc, free};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Randomly decide whether allocations should fail
  malloc_should_fail = fdp.ConsumeBool();
  cJSON_InitHooks(&hooks);

  // Create a root JSON object
  cJSON *root = cJSON_CreateObject();
  if (!root) {
    return 0;
  }

  // Consume data to create a variety of JSON structures
  const int num_items = fdp.ConsumeIntegralInRange<int>(1, 10);
  for (int i = 0; i < num_items; ++i) {
    // Add different types of items to the root object
    switch (fdp.ConsumeIntegralInRange<int>(0, 5)) {
    case 0:
      cJSON_AddNumberToObject(root, fdp.ConsumeRandomLengthString(10).c_str(),
                              fdp.ConsumeIntegral<int>());
      break;
    case 1:
      cJSON_AddStringToObject(root, fdp.ConsumeRandomLengthString(10).c_str(),
                              fdp.ConsumeRandomLengthString(20).c_str());
      break;
    case 2:
      cJSON_AddBoolToObject(root, fdp.ConsumeRandomLengthString(10).c_str(),
                            fdp.ConsumeBool());
      break;
    case 3: {
      cJSON *array = cJSON_CreateArray();
      if (array) {
        cJSON_AddItemToObject(root, fdp.ConsumeRandomLengthString(10).c_str(),
                              array);
        // Add items to the array
        const int num_array_items = fdp.ConsumeIntegralInRange<int>(1, 5);
        for (int j = 0; j < num_array_items; ++j) {
          cJSON_AddItemToArray(
              array, cJSON_CreateString(
                         fdp.ConsumeRandomLengthString(10).c_str()));
        }
      }
      break;
    }
    case 4: {
      cJSON *nested_obj = cJSON_CreateObject();
      if (nested_obj) {
        cJSON_AddItemToObject(root, fdp.ConsumeRandomLengthString(10).c_str(),
                              nested_obj);
        cJSON_AddNumberToObject(nested_obj,
                                fdp.ConsumeRandomLengthString(10).c_str(),
                                fdp.ConsumeIntegral<int>());
      }
      break;
    }
    case 5:
      cJSON_AddNullToObject(root, fdp.ConsumeRandomLengthString(10).c_str());
      break;
    }
  }

  // Use a small buffer to force reallocations in cJSON_PrintBuffered,
  // which will exercise the 'ensure' function.
  char *printed_json = cJSON_PrintBuffered(root, 1, fdp.ConsumeBool());
  if (printed_json) {
    free(printed_json);
  }

  // Clean up the root object and all its children
  cJSON_Delete(root);

  return 0;
}[0m
