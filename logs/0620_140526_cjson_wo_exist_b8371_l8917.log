    // Test cJSON_PrintPreallocated
    // Create a buffer with a size determined by the fuzzer.
    size_t buf_size = fdp.ConsumeIntegralInRange<size_t>(10, 2000);
    std::vector<char> buf(buf_size);
    cJSON_PrintPreallocated(json, buf.data(), (int)buf.size(), fdp.ConsumeBool());

    cJSON_Delete(json);
  }

