  if (json == nullptr) {
    // If parsing fails, create a new object to continue fuzzing.
    json.reset(cJSON_CreateObject());
  }

  // Target cJSON_CreateIntArray
  int count = fdp.ConsumeIntegralInRange<int>(0, 10);
  std::vector<int> numbers(count);
  for (int i = 0; i < count; i++) {
    numbers[i] = fdp.ConsumeIntegral<int>();
  }
  cJSON_ptr intArray(cJSON_CreateIntArray(numbers.data(), count));

  // Target cJSON_CreateStringArray
  int str_count = fdp.ConsumeIntegralInRange<int>(0, 10);
  std::vector<std::string> str_vector;
  std::vector<const char*> strings;
  for (int i = 0; i < str_count; i++) {
    str_vector.push_back(fdp.ConsumeRandomLengthString(100));
    strings.push_back(str_vector.back().c_str());
  }
  cJSON_ptr stringArray(cJSON_CreateStringArray(strings.data(), str_count));

  // Target cJSON_Compare
