  }
  cJSON_AddItemToObject(root, "stringArray", cJSON_CreateStringArray(strings.data(), string_count));

  // Create a second JSON object for comparison
  cJSON *root2 = cJSON_Duplicate(root, true);
  if (root2) {
    // Compare the two JSON objects
    cJSON_Compare(root, root2, fdp.ConsumeBool());
    // Clean up the second JSON object
    cJSON_Delete(root2);
  }

  // Print the JSON object to a string
  char *printed_json = cJSON_Print(root);
  if (printed_json) {
    // Free the printed string
    free(printed_json);
  }

  // Clean up the root JSON object
  cJSON_Delete(root);

  return 0;
}[0m
