#include "/src/cjson/cJSON.h"
#include <fuzzer/FuzzedDataProvider.h>
#include <string>
#include <vector>

// Custom deleter for cJSON objects to ensure proper memory management with unique_ptr.
struct cJSONDeleter {
  void operator()(cJSON *ptr) const {
    if (ptr) {
      cJSON_Delete(ptr);
    }
  }
};

using cJSONUniquePtr = std::unique_ptr<cJSON, cJSONDeleter>;

// Custom deleter for strings allocated by cJSON_Print to ensure proper memory management.
struct cJSONStringDeleter {
  void operator()(char *ptr) const {
    if (ptr) {
      cJSON_free(ptr);
    }
  }
};

using cJSONStringUniquePtr = std::unique_ptr<char, cJSONStringDeleter>;

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Create a top-level JSON object.
  cJSONUniquePtr root(cJSON_CreateObject());
  if (!root) {
    return 0;
  }

  // Create and add a string array to the root object.
  const size_t string_count = fdp.ConsumeIntegralInRange<size_t>(0, 10);
  std::vector<std::string> strings;
  for (size_t i = 0; i < string_count; ++i) {
    strings.push_back(fdp.ConsumeRandomLengthString(100));
  }
  std::vector<const char *> c_strings;
  for (const auto &s : strings) {
    c_strings.push_back(s.c_str());
  }
  cJSON_AddItemToObject(root.get(), "string_array", cJSON_CreateStringArray(c_strings.data(), c_strings.size()));

  // Create and add a double array to the root object.
  const size_t double_count = fdp.ConsumeIntegralInRange<size_t>(0, 10);
  std::vector<double> doubles;
  for (size_t i = 0; i < double_count; ++i) {
    doubles.push_back(fdp.ConsumeFloatingPoint<double>());
  }
  cJSON_AddItemToObject(root.get(), "double_array", cJSON_CreateDoubleArray(doubles.data(), doubles.size()));

  // Create and add a nested object to the root object.
  cJSONUniquePtr nested_object(cJSON_CreateObject());
  if (nested_object) {
    cJSON_AddStringToObject(nested_object.get(), "nested_string", fdp.ConsumeRandomLengthString(100).c_str());
    cJSON_AddNumberToObject(nested_object.get(), "nested_number", fdp.ConsumeIntegral<int>());
    cJSON_AddItemToObject(root.get(), "nested_object", nested_object.release());
  }

  // Duplicate the root object. The second parameter controls recursion.
  cJSONUniquePtr duplicate(cJSON_Duplicate(root.get(), fdp.ConsumeBool()));
  if (duplicate) {
    // Compare the original and duplicated objects. The third parameter controls case sensitivity.
    cJSON_Compare(root.get(), duplicate.get(), fdp.ConsumeBool());

    // Print the duplicated object to a string, which is then freed by the unique_ptr.
    cJSONStringUniquePtr printed_duplicate(cJSON_PrintUnformatted(duplicate.get()));
  }

  // Print the original object to a string, which is then freed by the unique_ptr.
  cJSONStringUniquePtr printed_root(cJSON_PrintUnformatted(root.get()));

  return 0;
}[0m
