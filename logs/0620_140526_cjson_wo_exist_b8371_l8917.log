#include <fuzzer/FuzzedDataProvider.h>
#include <string>
#include <vector>

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Create a random JSON object
  std::string json_str = fdp.ConsumeRandomLengthString(1000);
  cJSON *json = cJSON_Parse(json_str.c_str());

  if (json) {
    // Test cJSON_Duplicate
    cJSON *json_dup = cJSON_Duplicate(json, fdp.ConsumeBool());
    if (json_dup) {
      cJSON_Delete(json_dup);
    }

    // Test cJSON_Compare
    std::string another_json_str = fdp.ConsumeRandomLengthString(1000);
    cJSON *another_json = cJSON_Parse(another_json_str.c_str());
    if (another_json) {
      cJSON_Compare(json, another_json, fdp.ConsumeBool());
      cJSON_Delete(another_json);
    }

    // Test cJSON_SetValuestring
    if (cJSON_IsString(json)) {
