#include "/src/cjson/cJSON.h"
#include <fuzzer/FuzzedDataProvider.h>
#include <string>
#include <memory>
#include <cstddef>

// A global flag to determine if our custom malloc should fail.
static bool g_should_malloc_fail = false;

// A custom malloc function that can be made to fail.
static void* failing_malloc(size_t size) {
  if (g_should_malloc_fail) {
    return nullptr;
  }
  return malloc(size);
}

// A custom free function.
static void failing_free(void* ptr) { free(ptr); }

// Entry point for the fuzzer.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
  FuzzedDataProvider fdp(data, size);

  // Setup custom memory allocation hooks for cJSON.
  cJSON_Hooks hooks;
  hooks.malloc_fn = failing_malloc;
  hooks.free_fn = failing_free;

  // Use the fuzzer data to decide whether to make allocations fail.
  g_should_malloc_fail = fdp.ConsumeBool();
  cJSON_InitHooks(&hooks);

  // Create a cJSON object to test with.
  cJSON* root = cJSON_CreateObject();
  if (!root) {
    // If creation fails (e.g., due to our failing malloc), reset hooks and exit.
    cJSON_InitHooks(nullptr);
    return 0;
  }

  // Add a string item to the object using data from the fuzzer.
  const std::string key = fdp.ConsumeRandomLengthString(16);
  const std::string value = fdp.ConsumeRandomLengthString(128);
  cJSON_AddItemToObject(root, key.c_str(), cJSON_CreateString(value.c_str()));

  // Determine parameters for cJSON_PrintBuffered from fuzzer data.
  const int prebuffer = fdp.ConsumeIntegralInRange<int>(-10, 1024);
  const bool format = fdp.ConsumeBool();

  // Call cJSON_PrintBuffered to exercise the printing and buffer management logic.
  // The returned buffer must be freed using our custom deallocator.
  char* printed_json = cJSON_PrintBuffered(root, prebuffer, format);
  if (printed_json != nullptr) {
    // IMPORTANT: Use the same deallocator as provided in the hooks.
    hooks.free_fn(printed_json);
  }

  // Clean up the cJSON object.
  cJSON_Delete(root);

  // Reset the cJSON hooks to default to avoid side effects.
  cJSON_InitHooks(nullptr);

  return 0;
}[0m
