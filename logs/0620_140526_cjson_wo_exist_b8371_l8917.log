struct cJSON_Deleter {
    void operator()(cJSON* ptr) const {
        cJSON_Delete(ptr);
    }
};

using cJSON_ptr = std::unique_ptr<cJSON, cJSON_Deleter>;

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create a JSON array and object to be used in the test.
    cJSON_ptr root_array(cJSON_CreateArray());
    cJSON_ptr root_object(cJSON_CreateObject());

    // Create a random number of integers and add them to an array.
    int count = fdp.ConsumeIntegralInRange<int>(0, 10);
    std::vector<int> numbers;
    for (int i = 0; i < count; ++i) {
        numbers.push_back(fdp.ConsumeIntegral<int>());
    }
    cJSON_ptr int_array(cJSON_CreateIntArray(numbers.data(), count));

    // Add the integer array to the root array.
    if (int_array) {
        cJSON_AddItemToArray(root_array.get(), int_array.release());
    }

    // Create a string and add it to the root object.
    std::string key = fdp.ConsumeRandomLengthString(10);
    std::string value = fdp.ConsumeRandomLengthString(20);
    cJSON_AddStringToObject(root_object.get(), key.c_str(), value.c_str());

    // Compare the two JSON objects.
    cJSON_Compare(root_array.get(), root_object.get(), fdp.ConsumeBool());

    // Create a new JSON object and set its value using cJSON_SetValuestring.
    cJSON_ptr item_to_set = cJSON_CreateString(fdp.ConsumeRandomLengthString(10).c_str());
    if (item_to_set) {
        cJSON_SetValuestring(item_to_set.get(), fdp.ConsumeRandomLengthString(10).c_str());
    }

    // Insert the new item into the root array at a random position.
    if (item_to_set) {
        cJSON_InsertItemInArray(root_array.get(), fdp.ConsumeIntegralInRange<int>(0, cJSON_GetArraySize(root_array.get())), item_to_set.release());
    }

    // Test edge cases for cJSON_AddItemToArray to improve branch coverage.
    cJSON_ptr item1 = cJSON_CreateString("item1");
    cJSON_AddItemToArray(root_array.get(), item1.get()); 
    cJSON_AddItemToArray(root_array.get(), NULL);
    cJSON_AddItemToArray(NULL, item1.get());
    cJSON_AddItemToArray(root_array.get(), root_array.get());
    cJSON_Delete(item1.release());

    return 0;
}[0m
