// Custom deleter for cJSON objects to be used with std::unique_ptr for RAII.
struct cJSONDeleter {
    void operator()(cJSON *obj) const {
        cJSON_Delete(obj);
    }
};

using cJSON_ptr = std::unique_ptr<cJSON, cJSONDeleter>;

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
