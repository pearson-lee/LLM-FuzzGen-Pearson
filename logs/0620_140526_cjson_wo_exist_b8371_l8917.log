  std::vector<char> minify_buffer(string_to_minify.begin(), string_to_minify.end());
  minify_buffer.push_back('\0');
  cJSON_Minify(minify_buffer.data());

  // All cJSON objects are automatically deallocated by unique_ptr.

  return 0;
}[0m
