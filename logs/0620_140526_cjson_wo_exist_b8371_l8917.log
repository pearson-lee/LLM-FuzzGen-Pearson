#include <cstddef>
#include <cstdint>
#include <string>
#include <fuzzer/FuzzedDataProvider.h>
#include "/src/cjson/cJSON.h"

// A custom malloc function that can be made to fail.
// This helps in testing error handling paths in cJSON.
void *failing_malloc(size_t size) {
  if (size > 1024 * 1024) { // Fail for large allocations
    return nullptr;
  }
  return malloc(size);
}

// Fuzz target entry point.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzedDataProvider fdp(Data, Size);

  // Decide whether to use custom memory hooks.
  if (fdp.ConsumeBool()) {
    cJSON_Hooks hooks;
    hooks.malloc_fn = failing_malloc;
    hooks.free_fn = free;
    cJSON_InitHooks(&hooks);
  } else {
    cJSON_InitHooks(nullptr); // Reset to default hooks.
  }

  // Consume data for parsing.
  std::string json_string = fdp.ConsumeRandomLengthString(1024);

  // Test cJSON_ParseWithOpts with potentially invalid and valid JSON.
  // The case study showed a null check that was not covered.
  // This call will cover that branch.
  cJSON *json_null = cJSON_ParseWithOpts(nullptr, nullptr, fdp.ConsumeBool());
  if (json_null) {
    cJSON_Delete(json_null);
  }

  // Parse the fuzzer-generated string.
  cJSON *json = cJSON_ParseWithOpts(json_string.c_str(), nullptr, fdp.ConsumeBool());

  if (json) {
    // Create a new string item and add it to the parsed JSON object if it's an object.
    if (cJSON_IsObject(json)) {
      std::string key = fdp.ConsumeRandomLengthString(16);
      std::string value = fdp.ConsumeRandomLengthString(64);
      cJSON_AddItemToObject(json, key.c_str(), cJSON_CreateString(value.c_str()));
    }

    // Print the JSON to a buffer. This exercises the printing functions.
    char *printed_json = cJSON_PrintUnformatted(json);
    if (printed_json) {
      // The memory for printed_json is allocated by cJSON_PrintUnformatted
      // and must be freed using the configured free function.
      cJSON_free(printed_json);
    }

    // Clean up the parsed JSON object.
    cJSON_Delete(json);
  }

  // Create a standalone cJSON string object.
  std::string random_string = fdp.ConsumeRandomLengthString(128);
  cJSON *string_item = cJSON_CreateString(random_string.c_str());
  if (string_item) {
    // Clean up the standalone string item.
    cJSON_Delete(string_item);
  }

