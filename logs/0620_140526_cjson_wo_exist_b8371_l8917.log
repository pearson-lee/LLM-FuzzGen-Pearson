  FuzzedDataProvider fdp(Data, Size);

  // Create a JSON object
  cJSON *root = cJSON_CreateObject();
  if (!root) {
    return 0;
  }

  // Create and add an integer array to the object
  const int int_count = fdp.ConsumeIntegralInRange<int>(0, 10);
  std::vector<int> ints(int_count);
  for (int i = 0; i < int_count; ++i) {
    ints[i] = fdp.ConsumeIntegral<int>();
  }
  cJSON_AddItemToObject(root, "intArray", cJSON_CreateIntArray(ints.data(), int_count));

  // Create and add a float array to the object
  const int float_count = fdp.ConsumeIntegralInRange<int>(0, 10);
  std::vector<float> floats(float_count);
  for (int i = 0; i < float_count; ++i) {
    floats[i] = fdp.ConsumeFloatingPoint<float>();
  }
  cJSON_AddItemToObject(root, "floatArray", cJSON_CreateFloatArray(floats.data(), float_count));

