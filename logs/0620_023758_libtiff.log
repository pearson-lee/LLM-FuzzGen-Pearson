    // Only 'r', 'w', 'a', and '+' are generally recognized.
    if (mode.empty()) {
        mode = "r"; // Default to read mode if empty
    } else {
        std::string valid_mode_chars = "rwa+";
        for (char &c : mode) {
            if (valid_mode_chars.find(c) == std::string::npos) {
                c = 'r'; // Replace invalid characters with a default valid one
            }
        }
    }

    // Create a temporary file on disk. TIFFOpenExt uses standard file I/O
    // functions like `open()`, which require a real file path.
    FILE *temp_file = fopen(filename.c_str(), "wb");
    if (!temp_file) {
        // If file creation fails (e.g., due to invalid path characters or permissions),
        // gracefully exit for this input.
        return 0;
    }
