// Custom error and warning handlers. These are crucial for fuzzing as they prevent
// libtiff from exiting the process on internal errors or warnings, allowing the fuzzer
// to continue exploring more code paths.
static void customErrorHandler(const char *module, const char *fmt, va_list ap) {
  // Do nothing. Suppress error messages to prevent fuzzer from exiting.
}

static void customWarningHandler(const char *module, const char *fmt, va_list ap) {
  // Do nothing. Suppress warning messages.
}

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzedDataProvider fdp(Data, Size);

  // Set custom error and warning handlers. This overrides libtiff's default handlers
  // which might call exit() or abort() on certain conditions, stopping the fuzzer prematurely.
  TIFFSetErrorHandler(customErrorHandler);
  TIFFSetWarningHandler(customWarningHandler);

  // Generate a random filename for the TIFF file. This ensures each fuzzing iteration
  // operates on a unique file, preventing interference between runs.
  std::string filename = fdp.ConsumeRandomLengthString(16) + ".tiff";

  // Generate a mode string for TIFFOpenExt. This exercises various file opening scenarios.
  // Modes include "r" (read), "w" (write), "a" (append), with optional "+" for read/write
  // and "8" for BigTIFF format.
  std::string mode;
  const std::array<char, 3> modes_options = {'r', 'w', 'a'};
  mode += modes_options[fdp.ConsumeIntegralInRange<size_t>(0, modes_options.size() - 1)]; // Base mode: read, write, or append
  if (fdp.ConsumeBool()) {
    mode += "+"; // Add read/write capability
  }
  if (fdp.ConsumeBool()) {
    mode += "8"; // Request BigTIFF format
  }

  // Generate TIFFOpenOptions using FuzzedDataProvider.
  // TIFFOpenOptionsAlloc allocates memory for options, and TIFFOpenOptionsFree deallocates it.
  // std::unique_ptr with a custom deleter ensures proper memory management (RAII).
  std::unique_ptr<TIFFOpenOptions, decltype(&TIFFOpenOptionsFree)> open_options(
      TIFFOpenOptionsAlloc(), TIFFOpenOptionsFree);

  if (open_options) {
    // Fuzz various options within TIFFOpenOptions to explore different configuration paths.
    if (fdp.ConsumeBool()) {
      TIFFOpenOptionsSetMaxSingleMemAlloc(open_options.get(), fdp.ConsumeIntegral<uint64_t>());
    }
    if (fdp.ConsumeBool()) {
      TIFFOpenOptionsSetMaxCumulatedMemAlloc(open_options.get(), fdp.ConsumeIntegral<uint64_t>());
    }
    if (fdp.ConsumeBool()) {
      TIFFOpenOptionsSetWarnAboutUnknownTags(open_options.get(), fdp.ConsumeBool());
    }
  }

  // Create a temporary file and potentially write some initial data.
  // This is crucial for 'r' and 'r+' modes to have content to read from.
  // For 'w' and 'w+' modes, the file will be truncated or created.
  // For 'a' and 'a+' modes, it will append or create.
  std::ofstream ofs(filename, std::ios::binary);
  if (ofs.is_open()) {
    std::vector<uint8_t> initial_data = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange(0, 4096));
    ofs.write(reinterpret_cast<const char*>(initial_data.data()), initial_data.size());
    ofs.close();
  }

  // Call TIFFOpenExt to open the TIFF file. This is the first primary target API.
  // It attempts to open a TIFF file with fuzzed parameters, testing file system interactions
  // and initial TIFF structure parsing.
  TIFF* tif = TIFFOpenExt(filename.c_str(), mode.c_str(), open_options.get());

  // Proceed only if the TIFF file was successfully opened.
  if (tif) {
    // Set essential TIFF tags. These are crucial for many subsequent TIFF operations
    // and help in creating a more "valid" TIFF structure for fuzzing, increasing the
    // chances of reaching deeper code paths in other APIs.
    TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, fdp.ConsumeIntegralInRange<uint32_t>(1, 1024));
    TIFFSetField(tif, TIFFTAG_IMAGELENGTH, fdp.ConsumeIntegralInRange<uint32_t>(1, 1024));
    const std::array<uint16_t, 3> bits_per_sample_options = {1, 8, 16};
    TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, bits_per_sample_options[fdp.ConsumeIntegralInRange<size_t>(0, bits_per_sample_options.size() - 1)]);
    TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, fdp.ConsumeIntegralInRange<uint16_t>(1, 4));
    TIFFSetField(tif, TIFFTAG_ROWSPERSTRIP, fdp.ConsumeIntegralInRange<uint32_t>(1, 1024));
    const std::array<uint16_t, 2> planar_config_options = {PLANARCONFIG_CONTIG, PLANARCONFIG_SEPARATE};
    TIFFSetField(tif, TIFFTAG_PLANARCONFIG, planar_config_options[fdp.ConsumeIntegralInRange<size_t>(0, planar_config_options.size() - 1)]);
    const std::array<uint16_t, 2> photometric_options = {PHOTOMETRIC_MINISWHITE, PHOTOMETRIC_RGB};
    TIFFSetField(tif, TIFFTAG_PHOTOMETRIC, photometric_options[fdp.ConsumeIntegralInRange<size_t>(0, photometric_options.size() - 1)]);

    uint32_t num_strips = TIFFNumberOfStrips(tif);

    // Fuzzing TIFFWriteRawStrip: Writes raw, uncompressed data to a strip.
    // This tests low-level data writing and strip management.
    if (fdp.ConsumeBool() && num_strips > 0) {
      uint32_t strip = fdp.ConsumeIntegralInRange<uint32_t>(0, num_strips - 1); // Fuzz a valid strip number
      tmsize_t size = fdp.ConsumeIntegralInRange<tmsize_t>(0, 4096); // Fuzz data size
      std::vector<uint8_t> write_buffer = fdp.ConsumeBytes<uint8_t>(size);
      TIFFWriteRawStrip(tif, strip, write_buffer.data(), write_buffer.size());
    }

    // Fuzzing TIFFReadRawStrip: Reads raw, uncompressed data from a strip.
    // This tests low-level data reading and strip management.
    if (fdp.ConsumeBool() && num_strips > 0) {
      uint32_t strip = fdp.ConsumeIntegralInRange<uint32_t>(0, num_strips - 1); // Fuzz a valid strip number
      tmsize_t size = fdp.ConsumeIntegralInRange<tmsize_t>(0, 4096); // Fuzz buffer size
      std::vector<uint8_t> read_buffer(size);
      TIFFReadRawStrip(tif, strip, read_buffer.data(), read_buffer.size());
    }

    // Fuzzing TIFFWriteEncodedStrip with ZIP compression.
    // This exercises the compression pipeline within libtiff using a public API.
    if (fdp.ConsumeBool() && num_strips > 0) {
      TIFFSetField(tif, TIFFTAG_COMPRESSION, COMPRESSION_DEFLATE); // Set ZIP compression

      uint32_t strip = fdp.ConsumeIntegralInRange<uint32_t>(0, num_strips - 1);
      tmsize_t size = fdp.ConsumeIntegralInRange<tmsize_t>(0, 4096);
      std::vector<uint8_t> encode_buffer = fdp.ConsumeBytes<uint8_t>(size);

      // Attempt to write an encoded strip using ZIP compression.
      TIFFWriteEncodedStrip(tif, strip, encode_buffer.data(), encode_buffer.size());
    }

    // Fuzzing TIFFCheckpointDirectory: Tests directory writing and management.
    // This function is crucial for ensuring directory information is correctly written
    // and updated within the TIFF file structure.
    if (fdp.ConsumeBool()) {
      TIFFCheckpointDirectory(tif);
    }

    // Close the TIFF file. This is critical for memory safety and proper file finalization.
    // It flushes any pending writes and frees all resources associated with the TIFF handle.
    TIFFClose(tif);
  }

  // Clean up the temporary file created at the beginning of the fuzzer.
  // This ensures no leftover files on the filesystem after each fuzzing iteration.
  remove(filename.c_str());

  return 0;
