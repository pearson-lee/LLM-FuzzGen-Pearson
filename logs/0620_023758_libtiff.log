#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <fuzzer/FuzzedDataProvider.h>
#include "/src/libtiff/libtiff/tiffio.h" // Main libtiff header for TIFF API functions

// Dummy error handler to prevent libtiff from exiting on errors.
// This is crucial for fuzzing to allow continuous execution and discovery of more bugs.
static void dummy_error_handler(TIFF* tif, const char* module, const char* fmt, va_list ap) {
  (void)tif;    // Unused parameter
  (void)module; // Unused parameter
  (void)fmt;    // Unused parameter
  (void)ap;     // Unused parameter
}

// Dummy warning handler to prevent libtiff from exiting on warnings.
// Similar to the error handler, this ensures the fuzzer can continue.
static void dummy_warning_handler(TIFF* tif, const char* module, const char* fmt, va_list ap) {
  (void)tif;    // Unused parameter
  (void)module; // Unused parameter
  (void)fmt;    // Unused parameter
  (void)ap;     // Unused parameter
}

// Structure to simulate a file in memory. This will serve as the clientdata
// for TIFFClientOpenExt, allowing the fuzzer to control the "file" content.
struct FuzzedFile {
  std::vector<uint8_t> data; // The content of our simulated file
  tmsize_t offset;           // Current read/write offset within the data
};

// Custom read procedure for TIFFClientOpenExt.
// It reads data from the FuzzedFile's data vector.
static tmsize_t fuzzed_read_proc(thandle_t fd, void* buf, tmsize_t size) {
  FuzzedFile* f = static_cast<FuzzedFile*>(fd);
  tmsize_t bytes_to_read = size;
  // Ensure we don't read beyond the end of the simulated file data.
  if (f->offset + bytes_to_read > f->data.size()) {
    bytes_to_read = f->data.size() - f->offset;
  }
  // Copy data from our simulated file to the provided buffer.
  memcpy(buf, f->data.data() + f->offset, bytes_to_read);
  f->offset += bytes_to_read; // Advance the offset
  return bytes_to_read;
}

// Custom write procedure for TIFFClientOpenExt.
// It writes data into the FuzzedFile's data vector, expanding it if necessary.
static tmsize_t fuzzed_write_proc(thandle_t fd, void* buf, tmsize_t size) {
  FuzzedFile* f = static_cast<FuzzedFile*>(fd);
  // Resize the data vector if the write operation goes beyond its current size.
  if (f->offset + size > f->data.size()) {
    f->data.resize(f->offset + size);
  }
  // Copy data from the provided buffer to our simulated file.
  memcpy(f->data.data() + f->offset, buf, size);
  f->offset += size; // Advance the offset
  return size;
}

// Custom seek procedure for TIFFClientOpenExt.
// It adjusts the FuzzedFile's offset based on the whence parameter.
static toff_t fuzzed_seek_proc(thandle_t fd, toff_t off, int whence) {
  FuzzedFile* f = static_cast<FuzzedFile*>(fd);
  toff_t new_offset = f->offset;
  switch (whence) {
    case SEEK_SET: // Seek from the beginning of the file
      new_offset = off;
      break;
    case SEEK_CUR: // Seek from the current position
      new_offset = f->offset + off;
      break;
    case SEEK_END: // Seek from the end of the file
      new_offset = f->data.size() + off;
      break;
    default:
      return (toff_t)-1; // Invalid whence value
  }
  // Validate the new offset to ensure it's within bounds.
  if (new_offset < 0 || new_offset > f->data.size()) {
    return (toff_t)-1; // Invalid seek operation
  }
  f->offset = new_offset; // Update the offset
  return new_offset;
}

// Custom close procedure for TIFFClientOpenExt.
// In this in-memory setup, no explicit closing is needed as memory is managed by the fuzzer.
static int fuzzed_close_proc(thandle_t fd) {
  (void)fd; // Unused parameter
  return 0;
}

// Custom size procedure for TIFFClientOpenExt.
// Returns the current size of the simulated file data.
static toff_t fuzzed_size_proc(thandle_t fd) {
  FuzzedFile* f = static_cast<FuzzedFile*>(fd);
  return f->data.size();
}

// Custom map procedure for TIFFClientOpenExt.
// Provides direct access to the underlying data buffer.
static int fuzzed_map_proc(thandle_t fd, void** pbase, toff_t* psize) {
  FuzzedFile* f = static_cast<FuzzedFile*>(fd);
  *pbase = f->data.data(); // Pointer to the start of the data
  *psize = f->data.size(); // Size of the data
  return 1; // Success
}

// Custom unmap procedure for TIFFClientOpenExt.
// No explicit unmapping is needed for in-memory data.
static void fuzzed_unmap_proc(thandle_t fd, void* base, toff_t size) {
  (void)fd;   // Unused parameter
  (void)base; // Unused parameter
  (void)size; // Unused parameter
}

// Entry point for the fuzzer. LLVMFuzzerTestOneInput is called with fuzzed data.
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzedDataProvider fdp(Data, Size);

  // Set custom error and warning handlers to prevent crashes and allow continuous fuzzing.
  TIFFSetErrorHandler(dummy_error_handler);
  TIFFSetWarningHandler(dummy_warning_handler);

  // 1. Fuzz TIFFOpenOptions: Allocate and initialize with fuzzed values.
  // This exercises the configuration options for opening TIFF files.
  TIFFOpenOptions* opts = TIFFOpenOptionsAlloc();
  if (opts) {
    // Fuzz various memory allocation limits and warning settings.
    opts->max_single_mem_alloc = fdp.ConsumeIntegral<tmsize_t>();
    opts->max_cumulated_mem_alloc = fdp.ConsumeIntegral<tmsize_t>();
    opts->warn_about_unknown_tags = fdp.ConsumeBool();
  }

  // Prepare the in-memory "file" content from the fuzzer's input.
  // This ensures that diverse and potentially malformed data is fed to libtiff.
  FuzzedFile fuzzed_file;
  fuzzed_file.data = fdp.ConsumeRemainingBytes<uint8_t>();
  fuzzed_file.offset = 0;

  // Fuzz the file name and mode strings for TIFFClientOpenExt.
  // These strings can influence how libtiff interprets the file.
  std::string name = fdp.ConsumeRandomLengthString(100);
  std::string mode = fdp.ConsumeRandomLengthString(10);

  // 2. Call TIFFClientOpenExt: Attempt to open a TIFF "file" from the fuzzed in-memory data.
  // This is a critical entry point for libtiff, and fuzzing it thoroughly can uncover many issues.
  TIFF* tif = TIFFClientOpenExt(name.c_str(), mode.c_str(), &fuzzed_file,
                                fuzzed_read_proc, fuzzed_write_proc,
                                fuzzed_seek_proc, fuzzed_close_proc,
                                fuzzed_size_proc, fuzzed_map_proc,
                                fuzzed_unmap_proc, opts);

  // Proceed with other API calls only if the TIFF file was successfully opened.
  if (tif) {
    // 3. Fuzz TIFFCheckpointDirectory: Exercises the directory writing and checkpointing logic.
    // This function is often called during the process of writing TIFF files.
    TIFFCheckpointDirectory(tif);

    // 4. Fuzz TIFFWriteRawStrip: Writes raw strip data to the TIFF file.
    // This tests the raw data writing capabilities of libtiff.
    uint32_t strip_write = fdp.ConsumeIntegral<uint32_t>(); // Fuzz the strip number
    tmsize_t write_size = fdp.ConsumeIntegralInRange<tmsize_t>(0, 1024); // Fuzz the size of data to write
    std::vector<uint8_t> write_data = fdp.ConsumeBytes<uint8_t>(write_size); // Fuzz the actual data
    TIFFWriteRawStrip(tif, strip_write, write_data.data(), write_data.size());

    // 5. Fuzz TIFFReadRawStrip: Reads raw strip data from the TIFF file.
    // This tests the raw data reading capabilities, which can be sensitive to malformed inputs.
    uint32_t strip_read = fdp.ConsumeIntegral<uint32_t>(); // Fuzz the strip number
    tmsize_t read_size = fdp.ConsumeIntegralInRange<tmsize_t>(0, 1024); // Fuzz the size of data to read
    std::vector<uint8_t> read_buffer(read_size); // Buffer to store the read data
    TIFFReadRawStrip(tif, strip_read, read_buffer.data(), read_buffer.size());

    // 6. Fuzz ZIPEncode: Exercises the ZIP compression encoding.
    // This targets a specific compression algorithm, exploring its encoding paths.
    uint16_t samples_per_pixel = fdp.ConsumeIntegral<uint16_t>(); // Fuzz samples per pixel
    tmsize_t zip_encode_size = fdp.ConsumeIntegralInRange<tmsize_t>(0, 1024); // Fuzz data size for encoding
    std::vector<uint8_t> zip_encode_data = fdp.ConsumeBytes<uint8_t>(zip_encode_size); // Fuzz the data to encode
    ZIPEncode(tif, zip_encode_data.data(), zip_encode_data.size(), samples_per_pixel);

    // Clean up: Close the TIFF file to release resources.
    // This is crucial for memory safety and preventing resource leaks.
    TIFFClose(tif);
  }

  // Clean up: Free the TIFFOpenOptions structure.
  // Ensures all allocated resources are properly deallocated.
  if (opts) {
    TIFFOpenOptionsFree(opts);
  }

  return 0;
}[0m
