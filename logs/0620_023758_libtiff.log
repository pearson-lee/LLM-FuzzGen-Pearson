extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzedDataProvider fdp(Data, Size);

  // Set custom error and warning handlers globally to suppress libtiff output.
  // This is a common practice in fuzzing to focus on crashes/bugs rather than warnings.
  TIFFSetErrorHandler(custom_error_handler);
  TIFFSetWarningHandler(custom_warning_handler);

  // Generate a unique temporary file name for TIFF operations.
  // mkstemp creates and opens a unique temporary file, returning a file descriptor.
  // We close the descriptor immediately as TIFFOpenExt will open it again.
  char filename[] = "/tmp/libtiff_fuzz_XXXXXX.tiff";
  int fd = mkstemp(filename);
  if (fd == -1) {
    // If we can't create a temporary file, there's no point in proceeding.
    // This is an infrastructure issue, not a bug in libtiff.
    return 0;
  }
  close(fd); // Close the file descriptor; TIFFOpenExt will handle opening the file.

  // Fuzz the file opening mode.
  // "w" for write, "a" for append. Adding "8" enables BigTIFF support.
  std::string mode_str = fdp.ConsumeBool() ? "w" : "a";
  if (fdp.ConsumeBool()) {
      mode_str += "8"; // Optionally enable BigTIFF mode
  }

  // Allocate and configure TIFFOpenOptions to explore different initialization paths.
  // This exercises TIFFOpenOptionsAlloc and its setter functions.
  TIFFOpenOptions *opts = TIFFOpenOptionsAlloc();
  if (opts) {
    // Fuzz various options within TIFFOpenOptions.
    // Use ConsumeIntegralInRange to generate bounded values for memory allocation limits.
    if (fdp.ConsumeBool()) {
      TIFFOpenOptionsSetMaxSingleMemAlloc(opts, fdp.ConsumeIntegralInRange<tmsize_t>(0, 1024 * 1024));
    }
    if (fdp.ConsumeBool()) {
      TIFFOpenOptionsSetMaxCumulatedMemAlloc(opts, fdp.ConsumeIntegralInRange<tmsize_t>(0, 1024 * 1024 * 10));
    }
    // Fuzz whether to warn about unknown tags.
    TIFFOpenOptionsSetWarnAboutUnknownTags(opts, fdp.ConsumeBool());

    // Set custom error and warning handlers for the options as well, ensuring consistent suppression.
    TIFFOpenOptionsSetErrorHandlerExtR(opts, custom_error_handler, nullptr);
    TIFFOpenOptionsSetWarningHandlerExtR(opts, custom_warning_handler, nullptr);
  }

  // Call TIFFOpenExt: This is one of the primary API functions being fuzzed.
  // It attempts to open or create a TIFF file with fuzzed parameters.
  TIFF *tif = TIFFOpenExt(filename, mode_str.c_str(), opts);

  if (tif) {
    // If the TIFF file was successfully opened, proceed to set various TIFF tags.
    // Setting these tags is crucial for TIFFWriteRawStrip to operate correctly
    // and to exercise more code paths within libtiff's internal state management.
    // Fuzzing these values helps uncover issues related to image dimensions,
    // sample properties, and compression.
    uint32_t image_width = fdp.ConsumeIntegralInRange<uint32_t>(1, 2048);
    uint32_t image_length = fdp.ConsumeIntegralInRange<uint32_t>(1, 2048);
    uint16_t bits_per_sample = fdp.ConsumeIntegralInRange<uint16_t>(1, 16);
    uint16_t samples_per_pixel = fdp.ConsumeIntegralInRange<uint16_t>(1, 4);
    // rows_per_strip should not be 0, and ideally less than or equal to image_length.
    uint32_t rows_per_strip = fdp.ConsumeIntegralInRange<uint32_t>(1, image_length);
    // Select a compression scheme to test different compression code paths.
    uint16_t compression = fdp.PickValueInArray<uint16_t>({COMPRESSION_NONE, COMPRESSION_LZW, COMPRESSION_DEFLATE});

    TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, image_width);
    TIFFSetField(tif, TIFFTAG_IMAGELENGTH, image_length);
    TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, bits_per_sample);
    TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, samples_per_pixel);
    TIFFSetField(tif, TIFFTAG_ROWSPERSTRIP, rows_per_strip);
    TIFFSetField(tif, TIFFTAG_COMPRESSION, compression);
    // PLANARCONFIG_CONTIG is a common configuration for raw strip writing.
    TIFFSetField(tif, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);

    // Call TIFFWriteRawStrip: This API writes raw, uncompressed data to a strip.
    // Fuzzing the strip number and data size explores boundary conditions and
    // potential overflows/underflows in internal buffer management.
    uint32_t strip_number = fdp.ConsumeIntegralInRange<uint32_t>(0, 10); // Fuzz a few strip numbers
    tmsize_t data_size = fdp.ConsumeIntegralInRange<tmsize_t>(0, 1024 * 10); // Max 10KB of raw data
    // ConsumeBytes creates a vector and fills it with fuzzer data.
    // The vector automatically manages its memory.
    std::vector<uint8_t> raw_data = fdp.ConsumeBytes<uint8_t>(data_size);

    // Ensure we have enough fuzzer data for the requested size.
    if (raw_data.size() == data_size) {
        TIFFWriteRawStrip(tif, strip_number, raw_data.data(), data_size);
    }

    // Call TIFFCheckpointDirectory: This API flushes pending directory writes.
    // It's important for exercising the directory writing logic and ensuring
    // file consistency, potentially uncovering issues in metadata handling.
    TIFFCheckpointDirectory(tif);

    // Close the TIFF handle: This is crucial for proper resource management.
    // TIFFClose flushes any remaining data and frees associated memory.
    TIFFClose(tif);
  }

  // Free TIFFOpenOptions if it was successfully allocated.
  // This ensures that memory allocated by TIFFOpenOptionsAlloc is released,
  // preventing memory leaks.
  if (opts) {
    TIFFOpenOptionsFree(opts);
  }

  // Delete the temporary file created at the beginning of the fuzzer.
  // This cleans up disk resources.
  unlink(filename);

  return 0;
}[0m
