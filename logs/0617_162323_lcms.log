// Helper to calculate pixel size in bytes for a given LCMS format type
// Based on T_CHANNELS, T_EXTRA, T_BYTES, T_FLOAT macros from lcms2.h
size_t CalculatePixelSize(cmsUInt32Number format) {
    cmsUInt32Number num_color_chans = (format >> 3) & 0x7;
    cmsUInt32Number num_extra_chans = (format >> 10) & 0x3;
    cmsUInt32Number total_chans = num_color_chans + num_extra_chans;
    cmsUInt32Number bytes_per_chan_val = (format >> 7) & 0x7;
    cmsUInt32Number is_float = (format >> 12) & 0x1;

    size_t component_size;
    if (bytes_per_chan_val == 0) { // Float, half or double
        if (is_float) { // TYPE_FLOAT
            component_size = sizeof(cmsFloat32Number);
        } else { // Could be TYPE_HALF_FLT or TYPE_DOUBLE.
                 // For simplicity here, assume double if not float, as half_float types are not in alpha_formats.
                 // A more robust solution would inspect format more closely for specific half_float types.
            component_size = sizeof(cmsFloat64Number); // This is correct for TYPE_Lab_DBL, TYPE_XYZ_DBL
                                                       // but would be incorrect for TYPE_HALF_FLT (should be 2)
        }
    } else {
        component_size = bytes_per_chan_val;
    }
    if (total_chans == 0 && component_size == 0 && bytes_per_chan_val !=0) return 0; // Avoid multiplication by zero if format is invalid
                                                                                    // but allow BYTES_SH(0) for float types
    if (total_chans > 16) total_chans = 16; // Safety cap
    return total_chans * component_size;
}


