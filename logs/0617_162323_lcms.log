#include "/src/lcms/include/lcms2.h"
#include "/src/lcms/include/lcms2_plugin.h" // For _cmsMalloc, _cmsFree, _cmsMallocZero
#include <fuzzer/FuzzedDataProvider.h>
#include <vector>
#include <cstdint>
#include <cstddef>
#include <cstdio>  // For FILE, fmemopen, fclose
#include <cstring> // For memcpy
#include <utility> // For std::move

// Structure to hold data for our custom memory-based IO handler (C-style for _cmsMalloc)
struct CProfileMemIO {
    uint8_t* data_buffer_ptr;    // Points to copied profile data
    size_t data_buffer_size;     // Size of the copied data
    size_t offset;               // Current read offset
    // cmsContext context_id;    // Context used for allocations, available from iohandler->ContextID
};

// Read callback for the custom IO handler
static cmsUInt32Number ReadCProfileData(cmsIOHANDLER* iohandler, void* Ptr, cmsUInt32Number Size, cmsUInt32Number Count) {
    CProfileMemIO* pio = (CProfileMemIO*)iohandler->stream;
    if (!pio || Size == 0) return 0; // Avoid division by zero if Size is 0

    size_t bytes_to_read = static_cast<size_t>(Size) * Count;
    if (bytes_to_read == 0 && Count > 0) return Count; // Read 0 bytes successfully for Count items
    if (bytes_to_read == 0) return 0;


    size_t remaining_bytes = pio->data_buffer_size - pio->offset;

    if (bytes_to_read > remaining_bytes) {
        bytes_to_read = remaining_bytes;
    }
    if (bytes_to_read == 0) return 0;

    memcpy(Ptr, pio->data_buffer_ptr + pio->offset, bytes_to_read);
    pio->offset += bytes_to_read;
    
    return static_cast<cmsUInt32Number>(bytes_to_read / Size); // Number of items read
}

// Seek callback for the custom IO handler
static cmsBool SeekCProfileData(cmsIOHANDLER* iohandler, cmsUInt32Number offset) {
    CProfileMemIO* pio = (CProfileMemIO*)iohandler->stream;
    if (!pio || offset > pio->data_buffer_size) return FALSE;
    pio->offset = offset;
    return TRUE;
}

// Tell callback for the custom IO handler
static cmsUInt32Number TellCProfileData(cmsIOHANDLER* iohandler) {
    CProfileMemIO* pio = (CProfileMemIO*)iohandler->stream;
    if (!pio) return static_cast<cmsUInt32Number>(-1); // Error
    return static_cast<cmsUInt32Number>(pio->offset);
}

// Close callback for the custom IO handler. This is responsible for freeing resources.
static cmsBool CloseCProfileDataHandler(cmsIOHANDLER* iohandler) {
    cmsContext ctx = iohandler->ContextID; // Get context from iohandler
    CProfileMemIO* pio = (CProfileMemIO*)iohandler->stream;

    if (pio) {
        if (pio->data_buffer_ptr) {
            _cmsFree(ctx, pio->data_buffer_ptr); // Free the copied data buffer
        }
        _cmsFree(ctx, pio); // Free the CProfileMemIO struct
    }
    _cmsFree(ctx, iohandler); // Free the cmsIOHANDLER struct itself
    return TRUE;
}

// Helper function to create a profile from fuzzer bytes using a custom IO handler
// This uses cmsOpenProfileFromIOhandlerTHR.
static cmsHPROFILE CreateProfileUsingIOHandler(FuzzedDataProvider& fdp, cmsContext ctx) {
    if (!ctx) return nullptr;

    // Consume a chunk of data for the profile
    std::vector<uint8_t> profile_data_vec = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(32, 2048)); // Min 32 bytes for some basic structure
    if (profile_data_vec.empty()) return nullptr;

    // Allocate cmsIOHANDLER structure using lcms memory management
    cmsIOHANDLER* io = (cmsIOHANDLER*)_cmsMallocZero(ctx, sizeof(cmsIOHANDLER));
    if (!io) return nullptr;

    // Allocate our custom stream data structure
    CProfileMemIO* cpio_data = (CProfileMemIO*)_cmsMallocZero(ctx, sizeof(CProfileMemIO));
    if (!cpio_data) {
        _cmsFree(ctx, io);
        return nullptr;
    }

    // Copy fuzzer data into a buffer managed by CProfileMemIO
    cpio_data->data_buffer_ptr = (uint8_t*)_cmsMalloc(ctx, profile_data_vec.size());
    if (!cpio_data->data_buffer_ptr) {
        _cmsFree(ctx, cpio_data);
        _cmsFree(ctx, io);
        return nullptr;
    }
    memcpy(cpio_data->data_buffer_ptr, profile_data_vec.data(), profile_data_vec.size());
    cpio_data->data_buffer_size = profile_data_vec.size();
    cpio_data->offset = 0;
    // cpio_data->context_id = ctx; // Not strictly needed as ctx is in iohandler

    // Setup the IO handler
    io->ContextID = ctx;
    io->stream = cpio_data; // Our custom data
    io->Read = ReadCProfileData;
    io->Seek = SeekCProfileData;
    io->Tell = TellCProfileData;
    io->Write = nullptr; // This handler is for reading
    io->Close = CloseCProfileDataHandler; // Our custom close function
    io->reportedSize = static_cast<cmsUInt32Number>(cpio_data->data_buffer_size);

    // Open the profile using the custom IO handler.
    // lcms will call io->Close on error or when cmsCloseProfile is called.
    cmsHPROFILE hProfile = cmsOpenProfileFromIOhandlerTHR(ctx, io);
    
    // If hProfile is NULL, lcms should have called io->Close, which frees io and cpio_data.
    // If hProfile is valid, cmsCloseProfile will eventually call io->Close.
    return hProfile;
}


extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
    FuzzedDataProvider fdp(Data, Size);

    // Create an lcms context
    cmsContext ctx = cmsCreateContext(nullptr, nullptr);
    if (!ctx) {
        return 0;
    }

    // API 1: cmsOpenProfileFromStreamTHR
    // Create a profile from fuzzer data using a memory stream (FILE*)
    cmsHPROFILE hProfile1_stream = nullptr;
    std::vector<uint8_t> stream_profile_data = fdp.ConsumeBytes<uint8_t>(fdp.ConsumeIntegralInRange<size_t>(32, 2048));
    if (!stream_profile_data.empty()) {
        // Use fmemopen to create a FILE* from the fuzzer data in memory
        // fmemopen is POSIX.1-2008. Ensure fuzzing environment supports it.
        FILE* mem_file = fmemopen(const_cast<uint8_t*>(stream_profile_data.data()), stream_profile_data.size(), "rb");
        if (mem_file) {
            // Attempt to open the profile from the memory stream
            // The mode "rb" is a C string for "read binary".
            hProfile1_stream = cmsOpenProfileFromStreamTHR(ctx, mem_file, "rb");
            // fclose must be called after cmsOpenProfileFromStreamTHR, as lcms might read from it during the call.
            fclose(mem_file);
        }
    }

    // API 2: cmsDetectTAC
    if (hProfile1_stream) {
        // Detect Total Area Coverage. Return value is double, just call for coverage.
        cmsDetectTAC(hProfile1_stream);
    }

    // API 3: cmsSmoothToneCurve & API 4: cmsJoinToneCurve
    // Create a base tone curve (e.g., gamma curve)
    cmsToneCurve* tc1 = cmsBuildGamma(ctx, fdp.ConsumeFloatingPointInRange<double>(0.1, 3.5));
    if (tc1) {
        // Smooth the tone curve
        cmsSmoothToneCurve(tc1, fdp.ConsumeFloatingPointInRange<double>(0.0, 1.0));

        // Create a second tone curve
        cmsToneCurve* tc2 = cmsBuildGamma(ctx, fdp.ConsumeFloatingPointInRange<double>(0.1, 3.5));
        if (tc2) {
            // Join the two tone curves
            cmsUInt32Number nPoints = fdp.ConsumeIntegralInRange<cmsUInt32Number>(2, 256); // Number of points for the joined curve
            cmsToneCurve* joinedTC = cmsJoinToneCurve(ctx, tc1, tc2, nPoints);
            if (joinedTC) {
                cmsFreeToneCurve(joinedTC); // Free the joined curve
            }
            cmsFreeToneCurve(tc2); // Free the second curve
        }
        cmsFreeToneCurve(tc1); // Free the first curve
    }

    // For cmsCreateProofingTransformTHR, we need more profiles.
    // Create them using our helper that internally uses cmsOpenProfileFromIOhandlerTHR.
    cmsHPROFILE hProfile2_io = CreateProfileUsingIOHandler(fdp, ctx);
    cmsHPROFILE hProfile3_io_proof = CreateProfileUsingIOHandler(fdp, ctx);

    // API 5: cmsCreateProofingTransformTHR
    // Ensure all required profiles are valid. hProfile1_stream might be one of them.
    cmsHPROFILE input_profile_for_transform = hProfile1_stream ? hProfile1_stream : CreateProfileUsingIOHandler(fdp, ctx); // Use stream profile or a new one
    cmsHPROFILE output_profile_for_transform = hProfile2_io ? hProfile2_io : CreateProfileUsingIOHandler(fdp, ctx);
    cmsHPROFILE proof_profile_for_transform = hProfile3_io_proof ? hProfile3_io_proof : CreateProfileUsingIOHandler(fdp, ctx);
    
    bool own_input_profile = (!hProfile1_stream && input_profile_for_transform);
    bool own_output_profile = (!hProfile2_io && output_profile_for_transform);
    bool own_proof_profile = (!hProfile3_io_proof && proof_profile_for_transform);


    if (input_profile_for_transform && output_profile_for_transform && proof_profile_for_transform) {
        cmsUInt32Number inputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
        cmsUInt32Number outputFormat = fdp.ConsumeIntegral<cmsUInt32Number>();
        // For proofing intent and transform intent, 0-3 are typical (perceptual, rel colorimetric, sat, abs colorimetric)
        cmsUInt32Number proofingIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
        cmsUInt32Number transformIntent = fdp.ConsumeIntegralInRange<cmsUInt32Number>(0, 3);
        cmsUInt32Number dwFlags = fdp.ConsumeIntegral<cmsUInt32Number>(); // Various flags like cmsFLAGS_GAMUTCHECK etc.

        cmsHTRANSFORM hTransform = cmsCreateProofingTransformTHR(
            ctx,
            input_profile_for_transform,
            inputFormat,
            output_profile_for_transform,
            outputFormat,
            proof_profile_for_transform,
            proofingIntent,
            transformIntent,
            dwFlags
        );

        if (hTransform) {
            cmsDeleteTransform(hTransform); // Free the transform object
        }
    }

    // Clean up profiles created specifically for the transform if they were not from earlier variables
    if (own_input_profile && input_profile_for_transform) cmsCloseProfile(input_profile_for_transform);
    if (own_output_profile && output_profile_for_transform) cmsCloseProfile(output_profile_for_transform);
    if (own_proof_profile && proof_profile_for_transform) cmsCloseProfile(proof_profile_for_transform);


    // Clean up initially created profiles
    if (hProfile1_stream) {
        cmsCloseProfile(hProfile1_stream);
    }
    if (hProfile2_io) {
        cmsCloseProfile(hProfile2_io);
    }
    if (hProfile3_io_proof) {
        cmsCloseProfile(hProfile3_io_proof);
    }

    // Delete the lcms context
    cmsDeleteContext(ctx);

    return 0;
}[0m
