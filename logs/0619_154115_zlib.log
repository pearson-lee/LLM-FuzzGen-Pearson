#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <zlib.h>

#define MIN_SIZE 8

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size < MIN_SIZE) {
    return 0;
  }

  // Create a temporary file path
  char filename[256];
  sprintf(filename, "/tmp/fuzz-XXXXXX");
  int fd = mkstemp(filename);
  if (fd == -1) {
    return 0;
  }
  close(fd);

  // Open the file for writing
  gzFile file = gzopen64(filename, "wb");
  if (file == NULL) {
    unlink(filename);
    return 0;
  }

  // Extract parameters from the fuzzing data
  int level = data[0] % 10;
  int strategy = data[1] % 5;
  int flush = data[2] % 5;
  size_t write_size = data[3];
  const uint8_t *write_data = &data[4];
  size_t remaining_size = size - 4;

  if (write_size > remaining_size) {
    write_size = remaining_size;
  }

  // Set compression parameters
  gzsetparams(file, level, strategy);

  // Write data to the file
  gzfwrite(write_data, 1, write_size, file);

  // Write a string to the file
  gzputs(file, (const char *)write_data);

  // Flush the file
  gzflush(file, flush);

  // Close the file
  gzclose(file);

  // Clean up the temporary file
  unlink(filename);

  return 0;
}[0m
