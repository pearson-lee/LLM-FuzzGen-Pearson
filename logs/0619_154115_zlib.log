#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>

// Include the main zlib header with its full path.
#include "/src/zlib/zlib.h"

// Define a minimum input size to ensure there's enough data to work with.
#define MIN_INPUT_SIZE 16

// This fuzz target focuses on the gz* file writing APIs from gzwrite.c,
// many of which have 0% coverage. The goal is to exercise file writing,
// parameter setting, and flushing in various combinations.
// The selected APIs are:
// 1. gzsetparams: To test different compression levels and strategies.
// 2. gzputc: To write single characters.
// 3. gzputs: To write strings.
// 4. gzfwrite: To write blocks of data.
// 5. gzflush: To test different flushing behaviors.
int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    if (size < MIN_INPUT_SIZE) {
        return 0;
    }

    // Create a temporary file to be used with gzdopen.
    // tmpfile() creates a unique temporary file that is automatically
    // deleted when it is closed or the program terminates. This is a safe
    // way to handle temporary file resources.
    FILE *tmp = tmpfile();
    if (!tmp) {
        return 0;
    }

    // Get the file descriptor from the FILE stream.
    int fd = fileno(tmp);
    if (fd == -1) {
        fclose(tmp);
        return 0;
    }

    // Use gzdopen to create a gzFile from the file descriptor for writing.
    // "wb" specifies write mode and binary mode.
    // gzdopen allocates memory for the gzFile state, which must be freed by gzclose.
    gzFile file = gzdopen(fd, "wb");
    if (file == NULL) {
        // If gzdopen fails, it does not take ownership of the fd,
        // so we must close the original FILE stream to clean up.
        fclose(tmp);
        return 0;
    }

    size_t offset = 0;

    // Use the first two bytes of fuzzer input to set compression parameters.
    // This exercises the gzsetparams function with varied inputs.
    int level = data[offset++] % 10;    // Valid levels are 0-9
    int strategy = data[offset++] % 5; // Valid strategies are 0-4
    gzsetparams(file, level, strategy);

    // Loop through the remaining input data, using it to drive different API calls.
    while (offset < size) {
        // Use one byte as a selector to determine which API to call.
        uint8_t selector = data[offset++];
        switch (selector % 4) {
        case 0: // Call gzputc
            if (offset < size) {
                gzputc(file, data[offset++]);
            }
            break;

        case 1: // Call gzputs
            if (offset < size) {
                // gzputs requires a null-terminated string. The fuzzer input is raw
                // data, so we find the length of a potential string and copy it to a
                // null-terminated buffer.
                size_t str_len = 0;
                while (offset + str_len < size && data[offset + str_len] != '\0') {
                    str_len++;
                }

                // Allocate memory for the string plus a null terminator.
                char *str_buf = (char *)malloc(str_len + 1);
                if (str_buf) {
                    memcpy(str_buf, data + offset, str_len);
                    str_buf[str_len] = '\0'; // Ensure null termination.
                    gzputs(file, str_buf);
                    // Free the allocated memory to prevent leaks.
                    free(str_buf);
                }
                offset += str_len;
                // Skip the null terminator if we found one in the input.
                if (offset < size && data[offset] == '\0') {
                    offset++;
                }
            }
            break;

        case 2: // Call gzfwrite
            if (offset < size) {
                // Use a portion of the remaining data for a block write.
                size_t write_size = (size - offset) / 2;
                if (write_size > 0) {
                    gzfwrite(data + offset, 1, write_size, file);
                    offset += write_size;
                }
            }
            break;

        case 3: // Call gzflush
            if (offset < size) {
                // Use one byte to select the flush strategy.
                int flush_type = data[offset++] % 6;
                int flush_param = Z_NO_FLUSH;
                switch (flush_type) {
                    case 0: flush_param = Z_NO_FLUSH; break;
                    case 1: flush_param = Z_PARTIAL_FLUSH; break;
                    case 2: flush_param = Z_SYNC_FLUSH; break;
                    case 3: flush_param = Z_FULL_FLUSH; break;
                    case 4: flush_param = Z_FINISH; break;
                    case 5: flush_param = Z_BLOCK; break;
                }
                gzflush(file, flush_param);
            }
            break;
        }
    }

    // Close the gzFile. This is a critical step. It flushes any remaining
    // buffered data, finalizes the gzip stream, frees the memory allocated
    // by gzdopen, and closes the underlying file descriptor.
    gzclose(file);

    return 0;
}[0m
