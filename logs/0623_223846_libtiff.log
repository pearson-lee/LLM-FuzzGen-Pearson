  TIFFVGetMethod vgetparent;
  TIFFVSetMethod vsetparent;
  TIFFPrintMethod printdir;
  TIFFStripMethod defsparent;
  TIFFTileMethod deftparent;
  void *jpegtables;
  uint32_t jpegtables_length;
  int jpegquality;
  int jpegcolormode;
  int jpegtablesmode;
  int ycbcrsampling_fetched;
  int max_allowed_scan_number;
  int has_warned_about_progressive_mode;
} JPEGOtherSettings;

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
  if (size == 0) {
    return 0;
  }
  FuzzedDataProvider fdp(data, size);

  // Open the TIFF file from the fuzzer input
  TIFF *tif = TIFFClientOpen(
      "fuzz.tif", "r", reinterpret_cast<thandle_t>(&fdp), _tiffReadProc,
      _tiffWriteProc, _tiffSeekProc, _tiffCloseProc, _tiffSizeProc, _tiffMapProc,
      _tiffUnmapProc);

  if (tif) {
    // Exercise TIFFReadCustomDirectory, TIFFReadEXIFDirectory, and
    // TIFFReadGPSDirectory
    toff_t offset = fdp.ConsumeIntegral<toff_t>();
    TIFFReadCustomDirectory(tif, offset, &exif_fields);
    TIFFReadEXIFDirectory(tif, offset);
    TIFFReadGPSDirectory(tif, offset);

    // Exercise TIFFReInitJPEG_12
    JPEGOtherSettings jpeg_other_settings;
    jpeg_other_settings.h_sampling_factor = fdp.ConsumeIntegral<int>();
    jpeg_other_settings.v_sampling_factor = fdp.ConsumeIntegral<int>();
    jpeg_other_settings.quant_tbl_count = fdp.ConsumeIntegral<int>();
    jpeg_other_settings.huff_ac_tbl_count = fdp.ConsumeIntegral<int>();
    jpeg_other_settings.huff_dc_tbl_count = fdp.ConsumeIntegral<int>();
    TIFFReInitJPEG_12(tif, &jpeg_other_settings,
                      fdp.ConsumeIntegral<int>(),
                      fdp.ConsumeIntegral<int>());

    // Exercise TIFFForceStrileArrayWriting
    TIFFForceStrileArrayWriting(tif);

    // Clean up resources
    TIFFClose(tif);
  }

  return 0;
}[0m
