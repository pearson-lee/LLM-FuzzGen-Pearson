    } while (fdp.ConsumeBool() && TIFFWriteDirectory(tif_write));

    // Write the last configured directory to finalize it before other operations.
    // This prevents a double-write scenario with TIFFWriteCustomDirectory/TIFFClose.
    TIFFWriteDirectory(tif_write);

