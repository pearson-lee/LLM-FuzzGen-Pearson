    {65000, 1, 1, TIFF_LONG, FIELD_CUSTOM, 1, 0, "CustomTag1"},
    {65001, -1, -1, TIFF_ASCII, FIELD_CUSTOM, 1, 0, "CustomTag2"}};
static const TIFFFieldArray customFieldArray = {
    tfiatCustom, 0, 2, const_cast<TIFFFieldInfo *>(customFieldInfo)};

// Fuzz target entry point
extern "C" int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
