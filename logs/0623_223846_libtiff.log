// Custom memory-based I/O functions for libtiff
struct TiffInfo {
  uint8_t *data;
  size_t size;
  size_t offset;
};

static tmsize_t read_proc(thandle_t handle, void *buf, tmsize_t size) {
  TiffInfo *info = reinterpret_cast<TiffInfo *>(handle);
  if (info->offset + size > info->size) {
