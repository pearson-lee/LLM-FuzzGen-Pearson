        if (fdp.ConsumeBool() && bits_per_sample > 0 && bits_per_sample <= 12) {
            uint16_t n_entries = 1 << bits_per_sample;
            std::vector<uint16_t> tf1(n_entries);
            for(uint16_t i = 0; i < n_entries; i++) tf1[i] = fdp.ConsumeIntegral<uint16_t>();

            if (samples_per_pixel > 1) {
