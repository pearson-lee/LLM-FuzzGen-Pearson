        TIFFSetField(tif_write, TIFFTAG_PHOTOMETRIC, photometric);
        TIFFSetField(tif_write, TIFFTAG_PLANARCONFIG, fdp.PickValueInArray<uint16_t>({PLANARCONFIG_CONTIG, PLANARCONFIG_SEPARATE}));

