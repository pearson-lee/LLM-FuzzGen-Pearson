                COMPRESSION_NONE,
                COMPRESSION_LZW,
                COMPRESSION_PACKBITS,
                COMPRESSION_DEFLATE,
                COMPRESSION_ADOBE_DEFLATE,
                COMPRESSION_JPEG,
                COMPRESSION_OJPEG,
                COMPRESSION_SGILOG,
                COMPRESSION_SGILOG24,
            });
        }
        TIFFSetField(tif_write, TIFFTAG_COMPRESSION, compression);

