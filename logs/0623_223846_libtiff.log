        if (compression == COMPRESSION_LZW || compression == COMPRESSION_DEFLATE) {
            uint16_t predictor = fdp.ConsumeIntegralInRange<uint16_t>(1, 3);
            TIFFSetField(tif_write, TIFFTAG_PREDICTOR, predictor);
            // Set sampleformat to float to cover floating point predictor functions in tif_predict.c
            if (predictor == PREDICTOR_FLOATINGPOINT) {
