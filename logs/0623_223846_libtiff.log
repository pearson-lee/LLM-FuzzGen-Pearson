    if (w > 0 && h > 0 && w < 2048 && h < 2048) {
      uint32_t *raster = (uint32_t *)_TIFFmalloc(w * h * sizeof(uint32_t));
      if (raster) {
        TIFFReadRGBAImage(tif, w, h, raster, 0);
        _TIFFfree(raster);
