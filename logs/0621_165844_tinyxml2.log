      tinyxml2::XMLText* cloned_text = static_cast<tinyxml2::XMLText*>(text_element->ShallowClone(doc.get()));
      if (cloned_text) {
          (void)text_element->ShallowEqual(cloned_text);
          // FIX: Removed doc->DeleteNode(cloned_text) as the document owns the cloned node.
      }
  }

  // Added to cover XMLComment::ShallowClone and ShallowEqual.
  tinyxml2::XMLComment* comment_node = doc->NewComment(fdp.ConsumeRandomLengthString(32).c_str());
  if (comment_node) {
      // FIX: Added static_cast as ShallowClone returns XMLNode*
      tinyxml2::XMLComment* cloned_comment = static_cast<tinyxml2::XMLComment*>(comment_node->ShallowClone(doc.get()));
      if (cloned_comment) {
          (void)comment_node->ShallowEqual(cloned_comment);
          // FIX: Removed doc->DeleteNode(cloned_comment) as the document owns the cloned node.
      }
  }

  // Added to cover XMLDeclaration::ShallowClone and ShallowEqual.
  tinyxml2::XMLDeclaration* decl_node = doc->NewDeclaration(fdp.ConsumeRandomLengthString(32).c_str());
  if (decl_node) {
      // FIX: Added static_cast as ShallowClone returns XMLNode*
      tinyxml2::XMLDeclaration* cloned_decl = static_cast<tinyxml2::XMLDeclaration*>(decl_node->ShallowClone(doc.get()));
      if (cloned_decl) {
          (void)decl_node->ShallowEqual(cloned_decl);
          // FIX: Removed doc->DeleteNode(cloned_decl) as the document owns the cloned node.
      }
  }

  // Added to cover XMLUnknown::ShallowClone and ShallowEqual.
  tinyxml2::XMLUnknown* unknown_node = doc->NewUnknown(fdp.ConsumeRandomLengthString(32).c_str());
  if (unknown_node) {
