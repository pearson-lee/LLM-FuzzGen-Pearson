  std::unique_ptr<tinyxml2::XMLDocument> cloned_doc(new tinyxml2::XMLDocument());
  doc->ShallowClone(cloned_doc.get());
  (void)doc->ShallowEqual(cloned_doc.get());

  // Added to cover XMLNode::DeepClone.
  // Create a small, controlled element for deep cloning to prevent stack overflow from deep recursion.
  tinyxml2::XMLElement* controlled_deep_clone_source = doc->NewElement("ControlledDeepCloneSource");
  if (controlled_deep_clone_source) {
      // Add a couple of children to ensure some recursion in DeepClone
      tinyxml2::XMLElement* child1_dc = doc->NewElement("Child1DC");
      controlled_deep_clone_source->InsertEndChild(child1_dc);
      tinyxml2::XMLElement* child2_dc = doc->NewElement("Child2DC");
      child1_dc->InsertEndChild(child2_dc); // Grandchild

      tinyxml2::XMLNode* cloned_node = controlled_deep_clone_source->DeepClone(doc.get());
      // FIX: Removed doc->DeleteNode(cloned_node) as the document owns the cloned node.
      // The unique_ptr 'doc' will automatically delete all its associated nodes.
  }

