#include <cstddef>
#include <cstdint>
#include <string>
#include <vector>
#include <memory> // Required for std::unique_ptr
#include <fuzzer/FuzzedDataProvider.h>

// Include the tinyxml2 header with its full project-relative path
#include "/src/tinyxml2/tinyxml2.h"

// Define a constant for buffer size, as used in tinyxml2's internal ToStr functions
#ifndef BUF_SIZE
#define BUF_SIZE 256
#endif

// Custom XMLVisitor to cover the virtual functions in tinyxml2::XMLVisitor.
// These functions are called when an XMLDocument is traversed using the Accept method.
class MyVisitor : public tinyxml2::XMLVisitor {
public:
    bool VisitEnter(const tinyxml2::XMLDocument& /*doc*/) override { return true; }
    bool VisitExit(const tinyxml2::XMLDocument& /*doc*/) override { return true; }
    bool VisitEnter(const tinyxml2::XMLElement& /*element*/, const tinyxml2::XMLAttribute* /*firstAttribute*/) override { return true; }
    bool VisitExit(const tinyxml2::XMLElement& /*element*/) override { return true; }
    bool Visit(const tinyxml2::XMLDeclaration& /*declaration*/) override { return true; }
    bool Visit(const tinyxml2::XMLText& /*text*/) override { return true; }
    bool Visit(const tinyxml2::XMLComment& /*comment*/) override { return true; }
    bool Visit(const tinyxml2::XMLUnknown& /*unknown*/) override { return true; }
};

extern "C" int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size) {
  FuzzedDataProvider fdp(Data, Size);

  // Use a unique_ptr for XMLDocument to ensure proper memory management (RAII)
  // The XMLDocument manages the memory of nodes created through its New* methods.
  std::unique_ptr<tinyxml2::XMLDocument> doc(new tinyxml2::XMLDocument());

  // Fuzzing tinyxml2::XMLElement::InsertNewChildElement(const char *)
  // This function creates a new element and inserts it as a child.
  // We need a root element to insert children into.
  std::string root_element_name = fdp.ConsumeRandomLengthString(32);
  tinyxml2::XMLElement* root_element = doc->NewElement(root_element_name.c_str());
  doc->InsertFirstChild(root_element);

  if (root_element) {
    std::string child_element_name = fdp.ConsumeRandomLengthString(32);
    // Call the target function
    tinyxml2::XMLElement* new_child = root_element->InsertNewChildElement(child_element_name.c_str());
    (void)new_child; // Suppress unused variable warning if not used further
  }

  // Fuzzing tinyxml2::XMLElement::QueryIntText(int *)
  // This function attempts to parse the text content of an element as an integer.
  // We need an element and set its text content.
  std::string text_element_name = fdp.ConsumeRandomLengthString(32);
  tinyxml2::XMLElement* text_element = doc->NewElement(text_element_name.c_str());
  if (root_element) {
    root_element->InsertEndChild(text_element);
  } else {
    doc->InsertFirstChild(text_element);
  }

  if (text_element) {
    // Generate text that is sometimes a valid integer, sometimes not.
    if (fdp.ConsumeBool()) {
      text_element->SetText(fdp.ConsumeIntegral<int>()); // Valid integer
    } else {
      text_element->SetText(fdp.ConsumeRandomLengthString(64).c_str()); // Random string, potentially invalid integer
    }
    int int_value = 0;
    // Call the target function
    doc->ClearError(); // Clear any previous errors before calling
    tinyxml2::XMLError error = text_element->QueryIntText(&int_value);
    (void)error; // Suppress unused variable warning
  }

  // Fuzzing tinyxml2::XMLElement::BoolAttribute(const char *, bool)
  // This function retrieves a boolean attribute, using a default value if not found.
  std::string attr_element_name = fdp.ConsumeRandomLengthString(32);
  tinyxml2::XMLElement* attr_element = doc->NewElement(attr_element_name.c_str());
  if (root_element) {
    root_element->InsertEndChild(attr_element);
  } else {
    doc->InsertFirstChild(attr_element);
  }

  if (attr_element) {
    std::string attribute_name = fdp.ConsumeRandomLengthString(32);
    bool default_bool_value = fdp.ConsumeBool();

    // Sometimes set the attribute, sometimes don't, to cover both branches in QueryBoolAttribute
    if (fdp.ConsumeBool()) {
      attr_element->SetAttribute(attribute_name.c_str(), fdp.ConsumeBool());
    }

    // Call the target function
    bool retrieved_bool = attr_element->BoolAttribute(attribute_name.c_str(), default_bool_value);
    (void)retrieved_bool; // Suppress unused variable warning
  }

  // Fuzzing tinyxml2::XMLPrinter::PushAttribute(const char *, bool)
  // This function adds a boolean attribute to the current element being printed.
  // XMLPrinter manages its own buffer, which is cleared on destruction.
  tinyxml2::XMLPrinter printer;

  std::string printer_element_name = fdp.ConsumeRandomLengthString(32);
  printer.OpenElement(printer_element_name.c_str());

  std::string printer_attr_name = fdp.ConsumeRandomLengthString(32);
  bool printer_attr_value = fdp.ConsumeBool();
  // Call the target function
  printer.PushAttribute(printer_attr_name.c_str(), printer_attr_value);

  // Added calls to other PushAttribute overloads to improve coverage.
  printer.PushAttribute(fdp.ConsumeRandomLengthString(32).c_str(), fdp.ConsumeIntegral<int>());
  printer.PushAttribute(fdp.ConsumeRandomLengthString(32).c_str(), fdp.ConsumeIntegral<unsigned int>());
  printer.PushAttribute(fdp.ConsumeRandomLengthString(32).c_str(), fdp.ConsumeIntegral<long>());
  printer.PushAttribute(fdp.ConsumeRandomLengthString(32).c_str(), fdp.ConsumeIntegral<unsigned long>());
  printer.PushAttribute(fdp.ConsumeRandomLengthString(32).c_str(), fdp.ConsumeFloatingPoint<double>());
  printer.PushAttribute(fdp.ConsumeRandomLengthString(32).c_str(), fdp.ConsumeFloatingPoint<float>());

  // Added calls to PushText overloads to improve coverage.
  printer.PushText(fdp.ConsumeRandomLengthString(64).c_str(), fdp.ConsumeBool());
  printer.PushText(fdp.ConsumeIntegral<long>());
  printer.PushText(fdp.ConsumeIntegral<unsigned long>());
  printer.PushText(fdp.ConsumeIntegral<int>());
  printer.PushText(fdp.ConsumeIntegral<unsigned int>());
  printer.PushText(fdp.ConsumeBool());
  printer.PushText(fdp.ConsumeFloatingPoint<float>());
  printer.PushText(fdp.ConsumeFloatingPoint<double>());

  // Added calls to PushComment, PushDeclaration, PushUnknown to improve coverage.
  printer.PushComment(fdp.ConsumeRandomLengthString(64).c_str());
  printer.PushDeclaration(fdp.ConsumeRandomLengthString(64).c_str());
  printer.PushUnknown(fdp.ConsumeRandomLengthString(64).c_str());

  printer.CloseElement();
  (void)printer.CStr(); // Access CStr to ensure the buffer is finalized, if needed.

  // Fuzzing tinyxml2::XMLNode::ChildElementCount(const char *)
  // This function counts child elements with a specific name.
  std::string count_element_name = fdp.ConsumeRandomLengthString(32);
  tinyxml2::XMLElement* count_parent_element = doc->NewElement(count_element_name.c_str());
  if (root_element) {
    root_element->InsertEndChild(count_parent_element);
  } else {
    doc->InsertFirstChild(count_parent_element);
  }

  if (count_parent_element) {
    std::string target_child_name = fdp.ConsumeRandomLengthString(32);
    // Add a varying number of children, some matching the target name, some not.
    size_t num_children = fdp.ConsumeIntegralInRange<size_t>(0, 10);
    for (size_t i = 0; i < num_children; ++i) {
      std::string child_name;
      if (fdp.ConsumeBool()) {
        child_name = target_child_name; // Matching name
      } else {
        child_name = fdp.ConsumeRandomLengthString(32); // Non-matching name
      }
      tinyxml2::XMLElement* child = doc->NewElement(child_name.c_str());
      count_parent_element->InsertEndChild(child);
    }

    // Call the target function
    int count = count_parent_element->ChildElementCount(target_child_name.c_str());
    (void)count; // Suppress unused variable warning
  }

  // --- New additions for coverage based on analysis of the coverage report ---

  // Added to cover various XMLVisitor::Visit* methods.
  MyVisitor visitor;
  doc->Accept(&visitor);

  // Added to cover XMLElement::InsertNewComment, InsertNewText, InsertNewDeclaration, InsertNewUnknown.
  if (root_element) {
    root_element->InsertNewComment(fdp.ConsumeRandomLengthString(64).c_str());
    root_element->InsertNewText(fdp.ConsumeRandomLengthString(64).c_str());
    root_element->InsertNewDeclaration(fdp.ConsumeRandomLengthString(64).c_str());
    root_element->InsertNewUnknown(fdp.ConsumeRandomLengthString(64).c_str());
  }

  // Added to cover XMLDocument error reporting functions by parsing invalid XML.
  std::string invalid_xml = fdp.ConsumeRandomLengthString(128);
  doc->Parse(invalid_xml.c_str(), invalid_xml.length());
  (void)doc->ErrorStr();
  doc->PrintError();
  (void)doc->ErrorName();

  // Added to cover XMLNode::LinkEndChild.
  if (root_element) {
      tinyxml2::XMLElement* link_child = doc->NewElement(fdp.ConsumeRandomLengthString(32).c_str());
      root_element->LinkEndChild(link_child); // link_child is owned by doc, so no manual delete needed here.
  }

  // Added to cover XMLNode::ChildElementCount() (no argument version).
  if (count_parent_element) {
      (void)count_parent_element->ChildElementCount();
  }

  // Added to cover XMLNode::GetLineNum() and XMLAttribute::GetLineNum().
  (void)doc->GetLineNum();
  if (root_element) {
      (void)root_element->GetLineNum();
  }
  if (attr_element && attr_element->FirstAttribute()) {
      (void)attr_element->FirstAttribute()->GetLineNum();
  }

  // Added to cover XMLNode::Parent().
  if (root_element && root_element->Parent()) {
      (void)root_element->Parent();
  }

  // Added to cover XMLNode::NoChildren().
  if (root_element) {
      (void)root_element->NoChildren();
  }

  // Added to cover XMLNode::LastChild() const.
  if (root_element) {
      (void)root_element->LastChild();
  }

  // Added to cover XMLNode::PreviousSibling() and PreviousSiblingElement().
  if (root_element && root_element->FirstChild()) {
      tinyxml2::XMLNode* sibling = root_element->FirstChild()->NextSibling();
      if (sibling) {
          (void)sibling->PreviousSibling();
          (void)sibling->PreviousSiblingElement(fdp.ConsumeRandomLengthString(32).c_str());
      }
  }

  // Added to cover XMLNode::NextSibling().
  if (root_element && root_element->FirstChild()) {
      (void)root_element->FirstChild()->NextSibling();
  }

  // Added to cover XMLNode::SetUserData and GetUserData.
  if (root_element) {
      void* user_data = reinterpret_cast<void*>(fdp.ConsumeIntegral<uintptr_t>());
      root_element->SetUserData(user_data);
      (void)root_element->GetUserData();
  }

  // Added to cover various XMLAttribute::*Value() const functions.
  if (attr_element) {
      std::string attribute_name_for_values = fdp.ConsumeRandomLengthString(32);
      // Set an attribute with a known value type to ensure the Query*Value functions can succeed.
      if (fdp.ConsumeBool()) {
          attr_element->SetAttribute(attribute_name_for_values.c_str(), fdp.ConsumeIntegral<int>());
      } else {
          attr_element->SetAttribute(attribute_name_for_values.c_str(), fdp.ConsumeRandomLengthString(64).c_str());
      }

      // FIX: Changed type to const tinyxml2::XMLAttribute*
      const tinyxml2::XMLAttribute* attribute = attr_element->FindAttribute(attribute_name_for_values.c_str());
      if (attribute) {
          int int_val; unsigned int uint_val; long long_val; unsigned long ulong_val;
          bool bool_val; double double_val; float float_val;

          attribute->QueryIntValue(&int_val);
          attribute->QueryUnsignedValue(&uint_val);
          attribute->QueryInt64Value(&long_val);
          attribute->QueryUnsigned64Value(&ulong_val);
          attribute->QueryBoolValue(&bool_val);
          attribute->QueryDoubleValue(&double_val);
          attribute->QueryFloatValue(&float_val);

          (void)attribute->IntValue();
          (void)attribute->UnsignedValue();
          (void)attribute->Int64Value();
          (void)attribute->Unsigned64Value();
          (void)attribute->BoolValue();
          (void)attribute->DoubleValue();
          (void)attribute->FloatValue();
      }
  }

  // Added to cover various XMLElement::Query*Attribute and XMLElement::*Attribute functions.
  if (attr_element) {
      std::string attribute_name_for_queries = fdp.ConsumeRandomLengthString(32);
      // Ensure some attributes are set to hit the 'found' path.
      if (fdp.ConsumeBool()) {
          attr_element->SetAttribute(attribute_name_for_queries.c_str(), fdp.ConsumeIntegral<int>());
      } else {
          attr_element->SetAttribute(attribute_name_for_queries.c_str(), fdp.ConsumeRandomLengthString(64).c_str());
      }

      int int_val; unsigned int uint_val; long long_val; unsigned long ulong_val;
      bool bool_val; double double_val; float float_val; const char* string_val;

      attr_element->QueryIntAttribute(attribute_name_for_queries.c_str(), &int_val);
      attr_element->QueryUnsignedAttribute(attribute_name_for_queries.c_str(), &uint_val);
      attr_element->QueryInt64Attribute(attribute_name_for_queries.c_str(), &long_val);
      attr_element->QueryUnsigned64Attribute(attribute_name_for_queries.c_str(), &ulong_val);
      attr_element->QueryBoolAttribute(attribute_name_for_queries.c_str(), &bool_val);
      attr_element->QueryDoubleAttribute(attribute_name_for_queries.c_str(), &double_val);
      attr_element->QueryFloatAttribute(attribute_name_for_queries.c_str(), &float_val);
      attr_element->QueryStringAttribute(attribute_name_for_queries.c_str(), &string_val);

      (void)attr_element->IntAttribute(attribute_name_for_queries.c_str(), fdp.ConsumeIntegral<int>());
      (void)attr_element->UnsignedAttribute(attribute_name_for_queries.c_str(), fdp.ConsumeIntegral<unsigned int>());
      (void)attr_element->Int64Attribute(attribute_name_for_queries.c_str(), fdp.ConsumeIntegral<long>());
      (void)attr_element->Unsigned64Attribute(attribute_name_for_queries.c_str(), fdp.ConsumeIntegral<unsigned long>());
      (void)attr_element->BoolAttribute(attribute_name_for_queries.c_str(), fdp.ConsumeBool());
      (void)attr_element->DoubleAttribute(attribute_name_for_queries.c_str(), fdp.ConsumeFloatingPoint<double>());
      (void)attr_element->FloatAttribute(attribute_name_for_queries.c_str(), fdp.ConsumeFloatingPoint<float>());
  }

  // Added to cover various XMLElement::Query*Text and XMLElement::*Text functions.
  if (text_element) {
      // Ensure text is set to a numeric value sometimes to hit conversion paths.
      if (fdp.ConsumeBool()) {
          text_element->SetText(fdp.ConsumeIntegral<int>());
      } else {
          text_element->SetText(fdp.ConsumeRandomLengthString(64).c_str());
      }

      unsigned int uint_val; long long_val; unsigned long ulong_val;
      bool bool_val; double double_val; float float_val;

      text_element->QueryUnsignedText(&uint_val);
      text_element->QueryInt64Text(&long_val);
      text_element->QueryUnsigned64Text(&ulong_val);
      text_element->QueryBoolText(&bool_val);
      text_element->QueryDoubleText(&double_val);
      text_element->QueryFloatText(&float_val);

      (void)text_element->UnsignedText(fdp.ConsumeIntegral<unsigned int>());
      (void)text_element->Int64Text(fdp.ConsumeIntegral<long>());
      (void)text_element->Unsigned64Text(fdp.ConsumeIntegral<unsigned long>());
      (void)text_element->BoolText(fdp.ConsumeBool());
      (void)text_element->DoubleText(fdp.ConsumeFloatingPoint<double>());
      (void)text_element->FloatText(fdp.ConsumeFloatingPoint<float>());
  }

  // Added to cover XMLDocument::SetBOM(bool).
  doc->SetBOM(fdp.ConsumeBool());

  // Added to cover XMLDocument::RootElement() and RootElement() const.
  (void)doc->RootElement();
  (void)((const tinyxml2::XMLDocument*)doc.get())->RootElement();

  // Added to cover XMLDocument::ErrorID() and ErrorLineNum().
  (void)doc->ErrorID();
  (void)doc->ErrorLineNum();

