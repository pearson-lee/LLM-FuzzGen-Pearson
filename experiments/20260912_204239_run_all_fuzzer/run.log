        char *printed_unformatted = cJSON_PrintUnformatted(root);
        if (printed_unformatted) {
            free(printed_unformatted);
        }

        char *printed_buffered = cJSON_PrintBuffered(root, fdp.ConsumeIntegralInRange<int>(0, 1024), fdp.ConsumeBool());
